#!/bin/sh
set -eu

start() {
	# Clear stale owner markers before the composed Raptor service starts.
	rm -f /run/prudynt-dlink-media.ready /run/prudynt.pid
	/etc/init.d/F01datetime start

	mkdir -p /dev/shm
	if ! awk '$2 == "/dev/shm" && $3 == "tmpfs" { found=1 } END { exit(found ? 0 : 1) }' /proc/mounts; then
		mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /dev/shm
	fi
	chmod 1777 /dev/shm

	# Release clean cache pages before the T31 media modules request
	# contiguous order-6 and order-5 allocations.
	sync
	echo 3 >/proc/sys/vm/drop_caches
}

case "${1:-}" in
	start) start ;;
	stop) true ;;
	*) exit 1 ;;
esac

