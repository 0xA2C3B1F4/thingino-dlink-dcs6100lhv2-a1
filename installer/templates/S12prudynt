#!/bin/sh
set -u

PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH
unset LD_LIBRARY_PATH LD_PRELOAD LD_AUDIT LD_DEBUG LD_DEBUG_OUTPUT \
	LD_PROFILE LD_USE_LOAD_BIAS LD_ORIGIN_PATH LD_SHOW_AUXV

ROOT=/opt/dlink-media/closure
NATIVE_ROOT=$ROOT/native
RUNTIME=/opt/dlink-media/runtime
READY=/run/prudynt-dlink-media.ready
NATIVE_READY=/run/dlink-media-native.ready
GLIBC_READY=/run/dlink-media-glibc.ready
PIDFILE=/run/prudynt.pid
STATE=/run/dlink-media.state
NATIVE_LOG=/run/prudynt-native.log
FINAL_LOG=/run/prudynt.log
NATIVE_MOUNTED=0

alive() {
	[ -s "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

record() {
	printf '%s\n' "$1" >>"$STATE"
}

stop_final() {
	[ -s "$PIDFILE" ] || return 0
	pid=$(cat "$PIDFILE")
	kill -TERM "$pid" 2>/dev/null || true
	i=0
	while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 50 ]; do
		usleep 100000
		i=$((i + 1))
	done
	if kill -0 "$pid" 2>/dev/null; then
		kill -KILL "$pid" 2>/dev/null || true
		usleep 500000
	fi
	if kill -0 "$pid" 2>/dev/null; then
		return 1
	fi
	rm -f "$PIDFILE"
}

fail() {
	reason=$1
	record "failure=$reason"
	printf 'D-Link two-stage media failed: %s\n' "$reason" >&2
	if [ "$NATIVE_MOUNTED" -eq 1 ]; then
		stop_native || cleanup_native_mounts || true
	else
		stop_final || true
	fi
	return 1
}

wait_ready() {
	phase=$1
	marker=$2
	i=0
	while [ "$i" -lt 300 ]; do
		alive || return 1
		if [ "$(cat "$READY" 2>/dev/null || true)" = 1080p-started ]; then
			printf '%s\n' 1080p-started >"$marker"
			record "${phase}=1080p-started"
			return 0
		fi
		usleep 100000
		i=$((i + 1))
	done
	return 1
}

prepare_imp_runtime() {
	/sbin/mdev -s || return 1
	mkdir -p /dev/shm || return 1
	chmod 1777 /dev/shm || return 1
}

cleanup_native_mounts() {
	status=0
	for name in run sys proc dev; do
		umount "$NATIVE_ROOT/$name" 2>/dev/null || status=1
	done
	NATIVE_MOUNTED=0
	return "$status"
}

mount_native_runtime() {
	cleanup_native_mounts >/dev/null 2>&1 || true
	for name in dev proc sys run; do
		if ! mount -o bind "/$name" "$NATIVE_ROOT/$name"; then
			cleanup_native_mounts >/dev/null 2>&1 || true
			return 1
		fi
	done
	NATIVE_MOUNTED=1
}

start_native() {
	mount_native_runtime || return 1
	rm -f "$READY"
	chroot "$NATIVE_ROOT" /etc/init.d/S31prudynt start >"$NATIVE_LOG" 2>&1
}

stop_native() {
	[ "$NATIVE_MOUNTED" -eq 1 ] || return 1
	pid=$(cat "$PIDFILE" 2>/dev/null || true)
	chroot "$NATIVE_ROOT" /etc/init.d/S31prudynt stop >>"$NATIVE_LOG" 2>&1 || true
	if [ -n "$pid" ]; then
		i=0
		while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 50 ]; do
			usleep 100000
			i=$((i + 1))
		done
		kill -0 "$pid" 2>/dev/null && return 1
	fi
	rm -f "$PIDFILE"
	cleanup_native_mounts
}

start_glibc() {
	cp "$RUNTIME/glibc.prudynt.json" /etc/prudynt.json || return 1
	chmod 0600 /etc/prudynt.json || return 1
	echo 3 >/proc/sys/vm/drop_caches || return 1
	rm -f "$READY"
	"$ROOT/glibc/lib/ld.so.1" \
		--library-path "$ROOT/glibc/lib" \
		"$ROOT/glibc/bin/prudynt" >"$FINAL_LOG" 2>&1 &
	printf '%s\n' "$!" >"$PIDFILE"
}

start() {
	if alive && [ "$(cat "$NATIVE_READY" 2>/dev/null || true)" = 1080p-started ] &&
		[ "$(cat "$GLIBC_READY" 2>/dev/null || true)" = 1080p-started ]; then
		return 0
	fi
	stop_final || true
	cleanup_native_mounts >/dev/null 2>&1 || true
	rm -f "$READY" "$NATIVE_READY" "$GLIBC_READY" "$PIDFILE" \
		"$STATE" "$NATIVE_LOG" "$FINAL_LOG"
	: >"$STATE"
	prepare_imp_runtime || { fail imp_runtime; return 1; }
	start_native || { fail native_start; return 1; }
	wait_ready native "$NATIVE_READY" || { fail native_1080p; return 1; }
	stop_native || { fail native_teardown; return 1; }
	record native_teardown=complete
	start_glibc || { fail glibc_start; return 1; }
	wait_ready glibc "$GLIBC_READY" || { fail glibc_1080p; return 1; }
	record result=two-stage-closure-ready
	printf '%s\n' 'D-Link media native: 1080p-started'
	printf '%s\n' 'D-Link media glibc: 1080p-started'
}

stop() {
	if [ "$NATIVE_MOUNTED" -eq 1 ]; then
		stop_native || cleanup_native_mounts || true
	else
		stop_final || true
	fi
	rm -f "$READY" "$NATIVE_READY" "$GLIBC_READY" "$STATE"
}

case "${1:-}" in
	start) start ;;
	stop) stop ;;
	restart) stop; sleep 2; start ;;
	*) exit 1 ;;
esac
