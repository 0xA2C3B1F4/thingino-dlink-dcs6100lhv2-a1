-    double raw_min = min->value.number.real;
-    double raw_max = max->value.number.real;
-    if (raw_max <= raw_min)
-        return;
-
-    double raw_value = value->value.number.real;
-
-    out->present = 1;
-    out->value = (float) raw_value;
-    out->min = (float) raw_min;
-    out->max = (float) raw_max;
-}
