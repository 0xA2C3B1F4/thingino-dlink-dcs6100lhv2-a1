diff --git a/src/control_imaging_bridge.c b/src/control_imaging_bridge.c
new file mode 100644
index 0000000000000000000000000000000000000000..697a6c50490bd32137e73e1e490536a714d20cdd
--- /dev/null
+++ b/src/control_imaging_bridge.c
@@ -0,0 +1,451 @@
+#include "control_imaging_bridge.h"
+#include "onvif_control_token.h"
+
+#include "log.h"
+
+#include <arpa/inet.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <unistd.h>
+
+#ifndef CONTROL_CONFIG_PATH
+#define CONTROL_CONFIG_PATH "/etc/thingino.json"
+#endif
+#ifndef CONTROL_ADDRESS
+#define CONTROL_ADDRESS INADDR_LOOPBACK
+#endif
+#ifndef CONTROL_PORT
+#define CONTROL_PORT 1998
+#endif
+
+#define CONFIG_LIMIT (64 * 1024)
+#define RESPONSE_LIMIT (32 * (1024))
+#define IO_TIMEOUT_SECONDS 2
+
+static int write_all(int fd, const void *buffer, size_t length)
+{
+    const unsigned char *input = buffer;
+    size_t used = 0;
+
+    while (used < length) {
+        ssize_t count = write(fd, input + used, length - used);
+        if (count > 0) {
+            used += (size_t)count;
+            continue;
+        }
+        if (count < 0 && errno == EINTR)
+            continue;
+        return -1;
+    }
+    return 0;
+}
+
+static bool extract_control_token(char token[65])
+{
+    return onvif_control_token(CONTROL_CONFIG_PATH, token);
+}
+
+static int control_request_path(const char *method, const char *path, const char *body,
+                           char response[RESPONSE_LIMIT + 1])
+{
+    struct sockaddr_in address = {
+        .sin_family = AF_INET,
+        .sin_port = htons(CONTROL_PORT),
+        .sin_addr.s_addr = htonl(CONTROL_ADDRESS),
+    };
+    struct timeval timeout = {.tv_sec = IO_TIMEOUT_SECONDS, .tv_usec = 0};
+    char token[65];
+    char request[1024];
+    size_t body_length = body ? strlen(body) : 0;
+    size_t used = 0;
+    int request_length;
+    int fd;
+
+    if (!extract_control_token(token))
+        return -1;
+    request_length = snprintf(request, sizeof(request),
+        "%s %s HTTP/1.1\r\nHost: 127.0.0.1:%d\r\n"
+        "Authorization: Bearer %s\r\nContent-Type: application/json\r\n"
+        "Content-Length: %zu\r\nConnection: close\r\n\r\n%s",
+        method, path, CONTROL_PORT, token, body_length, body ? body : "");
+    memset(token, 0, sizeof(token));
+    if (request_length < 0 || (size_t)request_length >= sizeof(request))
+        return -1;
+    fd = socket(AF_INET, SOCK_STREAM, 0);
+    if (fd < 0)
+        return -1;
+    if (fcntl(fd, F_SETFD, FD_CLOEXEC)) {
+        close(fd);
+        return -1;
+    }
+    setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout));
+    setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout));
+    if (connect(fd, (struct sockaddr *)&address, sizeof(address)) ||
+        write_all(fd, request, (size_t)request_length)) {
+        close(fd);
+        return -1;
+    }
+    memset(request, 0, sizeof(request));
+    while (used < RESPONSE_LIMIT) {
+        ssize_t count = read(fd, response + used, RESPONSE_LIMIT - used);
+        if (count > 0) {
+            used += (size_t)count;
+            continue;
+        }
+        if (count < 0 && errno == EINTR)
+            continue;
+        if (count < 0) {
+            close(fd);
+            return -1;
+        }
+        break;
+    }
+    close(fd);
+    if (!used || used == RESPONSE_LIMIT)
+        return -1;
+    response[used] = '\0';
+    if (strncmp(response, "HTTP/1.1 200 ", 13))
+        return -1;
+    char *body_start = strstr(response, "\r\n\r\n");
+    if (!body_start)
+        return -1;
+    body_start += 4;
+    memmove(response, body_start, used - (size_t)(body_start - response) + 1);
+    return 0;
+}
+
+static int control_request(const char *method, const char *body,
+                           char response[RESPONSE_LIMIT + 1])
+{
+    return control_request_path(method, "/api/v1/imaging", body, response);
+}
+
+static const char *skip_space(const char *cursor, const char *end)
+{
+    while (cursor < end && (*cursor == ' ' || *cursor == '\t' ||
+           *cursor == '\r' || *cursor == '\n'))
+        cursor++;
+    return cursor;
+}
+
+static int named_value(const char *object, const char *object_end,
+                       const char *name, const char **value)
+{
+    const char *cursor;
+    size_t name_length;
+    int depth = 0;
+
+    if (!object || object >= object_end || *object != '{')
+        return -1;
+    name_length = strlen(name);
+    for (cursor = object; cursor < object_end; cursor++) {
+        if (*cursor == '{') {
+            depth++;
+            continue;
+        }
+        if (*cursor == '}') {
+            depth--;
+            continue;
+        }
+        if (*cursor != '"')
+            continue;
+        const char *start = ++cursor;
+        bool escaped = false;
+        while (cursor < object_end) {
+            if (escaped)
+                escaped = false;
+            else if (*cursor == '\\')
+                escaped = true;
+            else if (*cursor == '"')
+                break;
+            cursor++;
+        }
+        if (cursor >= object_end)
+            return -1;
+        if (depth == 1 && !escaped && (size_t)(cursor - start) == name_length &&
+            !memcmp(start, name, name_length)) {
+            const char *after = skip_space(cursor + 1, object_end);
+            if (after >= object_end || *after != ':')
+                return -1;
+            *value = skip_space(after + 1, object_end);
+            return *value < object_end ? 0 : -1;
+        }
+    }
+    return -1;
+}
+
+static int named_object(const char *object, const char *object_end,
+                        const char *name, const char **start, const char **end)
+{
+    const char *cursor;
+    int depth = 0;
+    bool quoted = false;
+    bool escaped = false;
+
+    if (named_value(object, object_end, name, &cursor) || *cursor != '{')
+        return -1;
+    *start = cursor;
+    for (; cursor < object_end; cursor++) {
+        if (quoted) {
+            if (escaped)
+                escaped = false;
+            else if (*cursor == '\\')
+                escaped = true;
+            else if (*cursor == '"')
+                quoted = false;
+            continue;
+        }
+        if (*cursor == '"')
+            quoted = true;
+        else if (*cursor == '{')
+            depth++;
+        else if (*cursor == '}' && --depth == 0) {
+            *end = cursor + 1;
+            return 0;
+        }
+    }
+    return -1;
+}
+
+static int named_bool(const char *object, const char *end, const char *name,
+                      bool *result)
+{
+    const char *value;
+    if (named_value(object, end, name, &value))
+        return -1;
+    const char *tail;
+    if ((size_t)(end - value) >= 4 && !memcmp(value, "true", 4) &&
+        (tail = skip_space(value + 4, end)) < end && strchr(",}", *tail)) {
+        *result = true;
+        return 0;
+    }
+    if ((size_t)(end - value) >= 5 && !memcmp(value, "false", 5) &&
+        (tail = skip_space(value + 5, end)) < end && strchr(",}", *tail)) {
+        *result = false;
+        return 0;
+    }
+    return -1;
+}
+
+static int named_string(const char *object, const char *end, const char *name,
+                        const char *expected)
+{
+    const char *value;
+    size_t length = strlen(expected);
+    if (named_value(object, end, name, &value) || value >= end || *value != '"' ||
+        (size_t)(end - value) < length + 2 || memcmp(value + 1, expected, length) ||
+        value[length + 1] != '"')
+        return -1;
+    const char *tail = skip_space(value + length + 2, end);
+    if (tail >= end || !strchr(",}", *tail))
+        return -1;
+    return 0;
+}
+
+static int named_number(const char *object, const char *end, const char *name,
+                        float *result)
+{
+    const char *value;
+    char *tail;
+    double parsed;
+
+    if (named_value(object, end, name, &value))
+        return -1;
+    errno = 0;
+    parsed = strtod(value, &tail);
+    if (errno || tail == value || tail > end || parsed != parsed ||
+        parsed < 0.0 || parsed > 255.0)
+        return -1;
+    tail = (char *)skip_space(tail, end);
+    if (tail < end && *tail != ',' && *tail != '}')
+        return -1;
+    *result = (float)parsed;
+    return 0;
+}
+
+static control_imaging_field_t *lookup_field(control_imaging_state_t *state,
+                                             const char *name)
+{
+    if (!strcmp(name, "brightness"))
+        return &state->brightness;
+    if (!strcmp(name, "contrast"))
+        return &state->contrast;
+    if (!strcmp(name, "saturation"))
+        return &state->saturation;
+    if (!strcmp(name, "sharpness"))
+        return &state->sharpness;
+    return NULL;
+}
+
+static int parse_state(const char *json, control_imaging_state_t *state)
+{
+    const char *json_end = json + strlen(json);
+    const char *root = skip_space(json, json_end);
+    const char *message;
+    const char *message_end;
+    const char *fields;
+    const char *fields_end;
+
+    float code;
+    memset(state, 0, sizeof(*state));
+    if (root >= json_end || *root != '{' ||
+        named_number(root, json_end, "code", &code) || code != 200.0f ||
+        named_string(root, json_end, "result", "success") ||
+        named_object(root, json_end, "message", &message, &message_end) ||
+        named_object(message, message_end, "fields", &fields, &fields_end))
+        return -1;
+    const char *const names[] = {"brightness", "contrast", "saturation", "sharpness"};
+    for (size_t i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+        const char *field;
+        const char *field_end;
+        bool supported;
+        bool available;
+        control_imaging_field_t *target = lookup_field(state, names[i]);
+        if (named_object(fields, fields_end, names[i], &field, &field_end) ||
+            named_bool(field, field_end, "supported", &supported) ||
+            named_bool(field, field_end, "available", &available))
+            return -1;
+        if (available && !supported)
+            return -1;
+        if (!supported || !available)
+            continue;
+        if (named_number(field, field_end, "min", &target->min) ||
+            named_number(field, field_end, "max", &target->max) ||
+            named_number(field, field_end, "value", &target->value) ||
+            target->max <= target->min || target->value < target->min ||
+            target->value > target->max ||
+            target->min != (float)(unsigned int)target->min ||
+            target->max != (float)(unsigned int)target->max ||
+            target->value != (float)(unsigned int)target->value)
+            return -1;
+        target->present = 1;
+    }
+    return 0;
+}
+
+int control_rtsp_uri(unsigned int stream, const char *address, char *uri, size_t size)
+{
+    char response[RESPONSE_LIMIT + 1];
+    char endpoint[65];
+    struct in_addr checked_address;
+    const char *root, *end, *rtsp, *rtsp_end, *streams, *streams_end;
+    const char *channel, *channel_end, *value, *tail;
+    unsigned int port = 0;
+    size_t length = 0;
+    bool available, enabled;
+    if (uri && size) uri[0] = '\0';
+    if (!uri || !size || stream > 1 || !address ||
+        inet_pton(AF_INET, address, &checked_address) != 1 ||
+        control_request_path("GET", "/api/v1/runtime/media", NULL, response))
+        return -1;
+    end = response + strlen(response);
+    root = skip_space(response, end);
+    if (named_object(root, end, "rtsp", &rtsp, &rtsp_end) ||
+        named_value(rtsp, rtsp_end, "port", &value)) return -1;
+    tail = value;
+    while (tail < rtsp_end && *tail >= '0' && *tail <= '9') {
+        if (port > 6553) return -1;
+        port = port * 10 + (unsigned int)(*tail++ - '0');
+    }
+    if (tail == value || !port || port > 65535) return -1;
+    tail = skip_space(tail, rtsp_end);
+    if (tail >= rtsp_end || !strchr(",}", *tail) ||
+        named_object(root, end, "streams", &streams, &streams_end) ||
+        named_object(streams, streams_end, stream ? "ch1" : "ch0", &channel, &channel_end) ||
+        named_bool(channel, channel_end, "available", &available) || !available ||
+        named_bool(channel, channel_end, "enabled", &enabled) || !enabled ||
+        named_value(channel, channel_end, "rtsp_endpoint", &value) || *value++ != '"')
+        return -1;
+    while (value < channel_end && *value != '"') {
+        unsigned char c = (unsigned char)*value++;
+        if (length == sizeof(endpoint) - 1 ||
+            !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+              (c >= '0' && c <= '9') || c == '_' || c == '-' || c == '.')) return -1;
+        endpoint[length++] = (char)c;
+    }
+    if (!length || value >= channel_end || *value++ != '"') return -1;
+    tail = skip_space(value, channel_end);
+    if (tail >= channel_end || !strchr(",}", *tail)) return -1;
+    endpoint[length] = '\0';
+    if (!strcmp(endpoint, ".") || !strcmp(endpoint, "..")) return -1;
+    int count = snprintf(uri, size, "rtsp://%s:%u/%s", address, port, endpoint);
+    if (count < 0 || (size_t)count >= size) { uri[0] = '\0'; return -1; }
+    return 0;
+}
+
+int control_snapshot_uri(unsigned stream, const char *address, char *uri, size_t size)
+{
+    struct in_addr parsed;
+    if (!uri || !size) return -1;
+    uri[0] = '\0';
+    if (stream > 1 || !address || inet_pton(AF_INET, address, &parsed) != 1) return -1;
+    int count = snprintf(uri, size, "https://%s/onvif/image%s.cgi", address, stream ? "1" : "");
+    if (count < 0 || (size_t)count >= size) { uri[0] = '\0'; return -1; }
+    return 0;
+}
+
+int control_load_imaging_state(control_imaging_state_t *state)
+{
+    char response[RESPONSE_LIMIT + 1];
+    if (!state || control_request("GET", NULL, response) || parse_state(response, state)) {
+        log_error("control imaging bridge: unable to read checked imaging state");
+        return -1;
+    }
+    return 0;
+}
+
+int control_apply_imaging_changes(const control_imaging_command_t *commands,
+                                  size_t command_count)
+{
+    control_imaging_state_t before;
+    control_imaging_state_t after;
+    char body[256];
+    char response[RESPONSE_LIMIT + 1];
+    size_t used = 1;
+
+    if (!commands || !command_count || command_count > 4 ||
+        control_load_imaging_state(&before))
+        return -1;
+    body[0] = '{';
+    for (size_t i = 0; i < command_count; i++) {
+        control_imaging_field_t *field = lookup_field(&before, commands[i].key);
+        float normalized = commands[i].normalized_value;
+        unsigned int actual;
+        int count;
+        if (!field || !field->present || normalized != normalized ||
+            normalized < 0.0f || normalized > 1.0f)
+            return -1;
+        actual = (unsigned int)(field->min + normalized * (field->max - field->min) + 0.5f);
+        count = snprintf(body + used, sizeof(body) - used, "%s\"%s\":%u",
+                         i ? "," : "", commands[i].key, actual);
+        if (count < 0 || (size_t)count >= sizeof(body) - used)
+            return -1;
+        used += (size_t)count;
+    }
+    if (used + 2 > sizeof(body))
+        return -1;
+    body[used++] = '}';
+    body[used] = '\0';
+    if (control_request("POST", body, response) || parse_state(response, &after) ||
+        control_load_imaging_state(&after))
+        return -1;
+    for (size_t i = 0; i < command_count; i++) {
+        control_imaging_field_t *field = lookup_field(&after, commands[i].key);
+        unsigned int expected = (unsigned int)(
+            lookup_field(&before, commands[i].key)->min + commands[i].normalized_value *
+            (lookup_field(&before, commands[i].key)->max -
+             lookup_field(&before, commands[i].key)->min) + 0.5f);
+        control_imaging_field_t *prior = lookup_field(&before, commands[i].key);
+        if (!field || !field->present || !prior ||
+            field->min != prior->min || field->max != prior->max ||
+            field->value != (float)expected)
+            return -1;
+    }
+    return 0;
+}
