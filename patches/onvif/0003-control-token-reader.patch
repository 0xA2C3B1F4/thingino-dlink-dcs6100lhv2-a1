+#ifndef ONVIF_CONTROL_TOKEN_H
+#define ONVIF_CONTROL_TOKEN_H
+#include <stdbool.h>
+
+#define ONVIF_CONTROL_TOKEN_LENGTH 64
+#define ONVIF_CONTROL_TOKEN_BUFFER (ONVIF_CONTROL_TOKEN_LENGTH + 1)
+
+/* Reads root.control.token from a bounded, regular JSON configuration file. */
+bool onvif_control_token(const char *path, char token[65]);
+#endif
diff --git a/src/onvif_control_token.c b/src/onvif_control_token.c
new file mode 100644
--- /dev/null
+++ b/src/onvif_control_token.c
@@ -0,0 +1,534 @@
+#include "onvif_control_token.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+enum {
+    CONFIG_LIMIT = 64 * 1024,
+    JSON_DEPTH_LIMIT = 32,
+};
+
+typedef struct {
+    const unsigned char *data;
+    size_t size;
+    size_t position;
+} json_parser;
+
+static void wipe(void *data, size_t size)
+{
+    volatile unsigned char *bytes = data;
+    while (size--)
+        *bytes++ = 0;
+}
+
+static void skip_whitespace(json_parser *parser)
+{
+    while (parser->position < parser->size) {
+        unsigned char byte = parser->data[parser->position];
+        if (byte != ' ' && byte != '\t' && byte != '\r' && byte != '\n')
+            break;
+        parser->position++;
+    }
+}
+
+static int hex_digit(unsigned char byte)
+{
+    if (byte >= '0' && byte <= '9')
+        return byte - '0';
+    if (byte >= 'a' && byte <= 'f')
+        return byte - 'a' + 10;
+    if (byte >= 'A' && byte <= 'F')
+        return byte - 'A' + 10;
+    return -1;
+}
+
+static bool consume_utf8(json_parser *parser, unsigned char first)
+{
+    size_t tail;
+    unsigned char second;
+
+    if (first >= 0xc2 && first <= 0xdf) {
+        tail = 1;
+    } else if (first >= 0xe0 && first <= 0xef) {
+        tail = 2;
+    } else if (first >= 0xf0 && first <= 0xf4) {
+        tail = 3;
+    } else {
+        return false;
+    }
+    if (parser->position + tail > parser->size)
+        return false;
+    second = parser->data[parser->position];
+    if (second < 0x80 || second > 0xbf)
+        return false;
+    if ((first == 0xe0 && second < 0xa0) ||
+        (first == 0xed && second > 0x9f) ||
+        (first == 0xf0 && second < 0x90) ||
+        (first == 0xf4 && second > 0x8f))
+        return false;
+    for (size_t index = 1; index < tail; index++) {
+        unsigned char byte = parser->data[parser->position + index];
+        if (byte < 0x80 || byte > 0xbf)
+            return false;
+    }
+    parser->position += tail;
+    return true;
+}
+
+static void append_string_byte(char *output, size_t capacity, size_t *used,
+                               bool *overflow, unsigned char byte)
+{
+    if (output && capacity) {
+        if (*used < capacity)
+            output[*used] = (char)byte;
+        else
+            *overflow = true;
+    }
+    if (*used == (size_t)-1)
+        *overflow = true;
+    else
+        (*used)++;
+}
+
+/* Decode enough of a JSON string to identify ASCII keys and the token. */
+static bool parse_string(json_parser *parser, char *output, size_t capacity,
+                         size_t *length, bool *overflow, bool *non_ascii)
+{
+    size_t used = 0;
+    bool too_long = false;
+    bool has_non_ascii = false;
+
+    if (parser->position >= parser->size ||
+        parser->data[parser->position++] != '"')
+        return false;
+    while (parser->position < parser->size) {
+        unsigned char byte = parser->data[parser->position++];
+        if (byte == '"') {
+            if (output && capacity) {
+                if (used < capacity)
+                    output[used] = '\0';
+                else
+                    output[capacity - 1] = '\0';
+            }
+            if (length)
+                *length = used;
+            if (overflow)
+                *overflow = too_long;
+            if (non_ascii)
+                *non_ascii = has_non_ascii;
+            return true;
+        }
+        if (byte < 0x20)
+            return false;
+        if (byte >= 0x80) {
+            if (!consume_utf8(parser, byte))
+                return false;
+            has_non_ascii = true;
+            append_string_byte(output, capacity, &used, &too_long, 0x80);
+            continue;
+        }
+        if (byte != '\\') {
+            append_string_byte(output, capacity, &used, &too_long, byte);
+            continue;
+        }
+        if (parser->position >= parser->size)
+            return false;
+        byte = parser->data[parser->position++];
+        switch (byte) {
+        case '"':
+        case '\\':
+        case '/':
+            append_string_byte(output, capacity, &used, &too_long, byte);
+            break;
+        case 'b':
+            append_string_byte(output, capacity, &used, &too_long, '\b');
+            break;
+        case 'f':
+            append_string_byte(output, capacity, &used, &too_long, '\f');
+            break;
+        case 'n':
+            append_string_byte(output, capacity, &used, &too_long, '\n');
+            break;
+        case 'r':
+            append_string_byte(output, capacity, &used, &too_long, '\r');
+            break;
+        case 't':
+            append_string_byte(output, capacity, &used, &too_long, '\t');
+            break;
+        case 'u': {
+            unsigned value = 0;
+            if (parser->size - parser->position < 4)
+                return false;
+            for (unsigned index = 0; index < 4; index++) {
+                int digit = hex_digit(parser->data[parser->position++]);
+                if (digit < 0)
+                    return false;
+                value = (value << 4) | (unsigned)digit;
+            }
+            if (value <= 0x7f) {
+                append_string_byte(output, capacity, &used, &too_long,
+                                   (unsigned char)value);
+            } else {
+                has_non_ascii = true;
+                append_string_byte(output, capacity, &used, &too_long, 0x80);
+            }
+            break;
+        }
+        default:
+            return false;
+        }
+    }
+    return false;
+}
+
+static bool key_is(const char *key, size_t length, bool overflow,
+                   bool non_ascii, const char *expected)
+{
+    size_t expected_length = strlen(expected);
+    return !overflow && !non_ascii && length == expected_length &&
+           memcmp(key, expected, expected_length) == 0;
+}
+
+static bool parse_number(json_parser *parser)
+{
+    if (parser->position < parser->size &&
+        parser->data[parser->position] == '-')
+        parser->position++;
+    if (parser->position >= parser->size)
+        return false;
+    if (parser->data[parser->position] == '0') {
+        parser->position++;
+        if (parser->position < parser->size &&
+            parser->data[parser->position] >= '0' &&
+            parser->data[parser->position] <= '9')
+            return false;
+    } else {
+        if (parser->data[parser->position] < '1' ||
+            parser->data[parser->position] > '9')
+            return false;
+        do {
+            parser->position++;
+        } while (parser->position < parser->size &&
+                 parser->data[parser->position] >= '0' &&
+                 parser->data[parser->position] <= '9');
+    }
+    if (parser->position < parser->size &&
+        parser->data[parser->position] == '.') {
+        parser->position++;
+        if (parser->position >= parser->size ||
+            parser->data[parser->position] < '0' ||
+            parser->data[parser->position] > '9')
+            return false;
+        do {
+            parser->position++;
+        } while (parser->position < parser->size &&
+                 parser->data[parser->position] >= '0' &&
+                 parser->data[parser->position] <= '9');
+    }
+    if (parser->position < parser->size &&
+        (parser->data[parser->position] == 'e' ||
+         parser->data[parser->position] == 'E')) {
+        parser->position++;
+        if (parser->position < parser->size &&
+            (parser->data[parser->position] == '+' ||
+             parser->data[parser->position] == '-'))
+            parser->position++;
+        if (parser->position >= parser->size ||
+            parser->data[parser->position] < '0' ||
+            parser->data[parser->position] > '9')
+            return false;
+        do {
+            parser->position++;
+        } while (parser->position < parser->size &&
+                 parser->data[parser->position] >= '0' &&
+                 parser->data[parser->position] <= '9');
+    }
+    return true;
+}
+
+static bool literal(json_parser *parser, const char *text)
+{
+    size_t length = strlen(text);
+    if (parser->size - parser->position < length ||
+        memcmp(parser->data + parser->position, text, length) != 0)
+        return false;
+    parser->position += length;
+    return true;
+}
+
+static bool parse_value(json_parser *parser, unsigned depth);
+
+static bool parse_array(json_parser *parser, unsigned depth)
+{
+    if (depth > JSON_DEPTH_LIMIT || parser->position >= parser->size ||
+        parser->data[parser->position++] != '[')
+        return false;
+    skip_whitespace(parser);
+    if (parser->position < parser->size &&
+        parser->data[parser->position] == ']') {
+        parser->position++;
+        return true;
+    }
+    for (;;) {
+        if (!parse_value(parser, depth + 1))
+            return false;
+        skip_whitespace(parser);
+        if (parser->position >= parser->size)
+            return false;
+        if (parser->data[parser->position] == ']') {
+            parser->position++;
+            return true;
+        }
+        if (parser->data[parser->position++] != ',')
+            return false;
+        skip_whitespace(parser);
+    }
+}
+
+static bool parse_object(json_parser *parser, unsigned depth)
+{
+    if (depth > JSON_DEPTH_LIMIT || parser->position >= parser->size ||
+        parser->data[parser->position++] != '{')
+        return false;
+    skip_whitespace(parser);
+    if (parser->position < parser->size &&
+        parser->data[parser->position] == '}') {
+        parser->position++;
+        return true;
+    }
+    for (;;) {
+        if (!parse_string(parser, NULL, 0, NULL, NULL, NULL))
+            return false;
+        skip_whitespace(parser);
+        if (parser->position >= parser->size ||
+            parser->data[parser->position++] != ':')
+            return false;
+        if (!parse_value(parser, depth + 1))
+            return false;
+        skip_whitespace(parser);
+        if (parser->position >= parser->size)
+            return false;
+        if (parser->data[parser->position] == '}') {
+            parser->position++;
+            return true;
+        }
+        if (parser->data[parser->position++] != ',')
+            return false;
+        skip_whitespace(parser);
+    }
+}
+
+static bool parse_value(json_parser *parser, unsigned depth)
+{
+    skip_whitespace(parser);
+    if (parser->position >= parser->size)
+        return false;
+    switch (parser->data[parser->position]) {
+    case '{':
+        return parse_object(parser, depth);
+    case '[':
+        return parse_array(parser, depth);
+    case '"':
+        return parse_string(parser, NULL, 0, NULL, NULL, NULL);
+    case 't':
+        return literal(parser, "true");
+    case 'f':
+        return literal(parser, "false");
+    case 'n':
+        return literal(parser, "null");
+    default:
+        if (parser->data[parser->position] == '-' ||
+            (parser->data[parser->position] >= '0' &&
+             parser->data[parser->position] <= '9'))
+            return parse_number(parser);
+        return false;
+    }
+}
+
+static bool parse_token_value(json_parser *parser, char token[65])
+{
+    size_t length = 0;
+    bool overflow = false;
+    bool non_ascii = false;
+
+    skip_whitespace(parser);
+    if (!parse_string(parser, token, 65, &length, &overflow, &non_ascii) ||
+        overflow || non_ascii || length != ONVIF_CONTROL_TOKEN_LENGTH)
+        return false;
+    for (size_t index = 0; index < ONVIF_CONTROL_TOKEN_LENGTH; index++)
+        if (hex_digit((unsigned char)token[index]) < 0)
+            return false;
+    token[ONVIF_CONTROL_TOKEN_LENGTH] = '\0';
+    return true;
+}
+
+static bool parse_control_object(json_parser *parser, unsigned depth,
+                                 char token[65])
+{
+    bool seen_token = false;
+
+    skip_whitespace(parser);
+    if (depth > JSON_DEPTH_LIMIT || parser->position >= parser->size ||
+        parser->data[parser->position++] != '{')
+        return false;
+    skip_whitespace(parser);
+    if (parser->position < parser->size &&
+        parser->data[parser->position] == '}') {
+        parser->position++;
+        return false;
+    }
+    for (;;) {
+        char key[8] = {0};
+        size_t length = 0;
+        bool overflow = false;
+        bool non_ascii = false;
+        if (!parse_string(parser, key, sizeof(key), &length, &overflow,
+                          &non_ascii))
+            return false;
+        bool is_token = key_is(key, length, overflow, non_ascii, "token");
+        if (is_token && seen_token)
+            return false;
+        skip_whitespace(parser);
+        if (parser->position >= parser->size ||
+            parser->data[parser->position++] != ':')
+            return false;
+        if (is_token) {
+            if (!parse_token_value(parser, token))
+                return false;
+            seen_token = true;
+        } else if (!parse_value(parser, depth + 1)) {
+            return false;
+        }
+        skip_whitespace(parser);
+        if (parser->position >= parser->size)
+            return false;
+        if (parser->data[parser->position] == '}') {
+            parser->position++;
+            return seen_token;
+        }
+        if (parser->data[parser->position++] != ',')
+            return false;
+        skip_whitespace(parser);
+    }
+}
+
+static bool parse_root(json_parser *parser, char token[65])
+{
+    bool seen_control = false;
+
+    skip_whitespace(parser);
+    if (parser->position >= parser->size ||
+        parser->data[parser->position++] != '{')
+        return false;
+    skip_whitespace(parser);
+    if (parser->position < parser->size &&
+        parser->data[parser->position] == '}') {
+        parser->position++;
+        return false;
+    }
+    for (;;) {
+        char key[8] = {0};
+        size_t length = 0;
+        bool overflow = false;
+        bool non_ascii = false;
+        if (!parse_string(parser, key, sizeof(key), &length, &overflow,
+                          &non_ascii))
+            return false;
+        bool is_control = key_is(key, length, overflow, non_ascii, "control");
+        if (is_control && seen_control)
+            return false;
+        skip_whitespace(parser);
+        if (parser->position >= parser->size ||
+            parser->data[parser->position++] != ':')
+            return false;
+        if (is_control) {
+            if (!parse_control_object(parser, 1, token))
+                return false;
+            seen_control = true;
+        } else if (!parse_value(parser, 1)) {
+            return false;
+        }
+        skip_whitespace(parser);
+        if (parser->position >= parser->size)
+            return false;
+        if (parser->data[parser->position] == '}') {
+            parser->position++;
+            return seen_control;
+        }
+        if (parser->data[parser->position++] != ',')
+            return false;
+        skip_whitespace(parser);
+    }
+}
+
+bool onvif_control_token(const char *path, char token[65])
+{
+    int descriptor = -1;
+    unsigned char *config = NULL;
+    char candidate[65] = {0};
+    bool ok = false;
+    struct stat before;
+    struct stat after;
+    size_t used = 0;
+
+    if (!token)
+        return false;
+    wipe(token, 65);
+    if (!path)
+        goto done;
+    descriptor = open(path, O_RDONLY | O_NOFOLLOW | O_CLOEXEC | O_NONBLOCK);
+    if (descriptor < 0 || fstat(descriptor, &before) < 0 ||
+        !S_ISREG(before.st_mode) || before.st_size < 0 ||
+        before.st_size > CONFIG_LIMIT)
+        goto done;
+    config = malloc((size_t)CONFIG_LIMIT + 1);
+    if (!config)
+        goto done;
+    for (;;) {
+        ssize_t count = read(descriptor, config + used,
+                             (size_t)CONFIG_LIMIT + 1 - used);
+        if (count > 0) {
+            used += (size_t)count;
+            if (used > CONFIG_LIMIT)
+                goto done;
+            continue;
+        }
+        if (count == 0)
+            break;
+        if (errno == EINTR)
+            continue;
+        goto done;
+    }
+    if (fstat(descriptor, &after) < 0 || !S_ISREG(after.st_mode) ||
+        after.st_size != (off_t)used)
+        goto done;
+    for (size_t index = 0; index < used; index++)
+        if (config[index] == 0)
+            goto done;
+    {
+        json_parser parser = {config, used, 0};
+        if (!parse_root(&parser, candidate))
+            goto done;
+        skip_whitespace(&parser);
+        if (parser.position != parser.size)
+            goto done;
+    }
+    memcpy(token, candidate, 65);
+    ok = true;
+done:
+    if (descriptor >= 0)
+        close(descriptor);
+    if (config) {
+        wipe(config, (size_t)CONFIG_LIMIT + 1);
+        free(config);
+    }
+    wipe(candidate, sizeof(candidate));
+    if (!ok)
+        wipe(token, 65);
+    return ok;
+}
