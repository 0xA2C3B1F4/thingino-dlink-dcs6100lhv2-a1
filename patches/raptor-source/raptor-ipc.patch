+static int64_t monotonic_ms(void)
+{
+    struct timespec now;
+    if (clock_gettime(CLOCK_MONOTONIC, &now) < 0)
+        return -errno;
+    return (int64_t)now.tv_sec * 1000 + now.tv_nsec / 1000000;
+}
+
+static int remaining_ms(int64_t deadline_ms)
+{
+    int64_t now_ms = monotonic_ms();
+    if (now_ms < 0)
+        return (int)now_ms;
+    if (now_ms >= deadline_ms)
+        return -ETIMEDOUT;
+
+    int64_t remaining = deadline_ms - now_ms;
+    return remaining > INT_MAX ? INT_MAX : (int)remaining;
+}
+
+static int wait_fd(int fd, short events, int64_t deadline_ms)
+{
+    for (;;) {
+        int timeout = remaining_ms(deadline_ms);
+        if (timeout < 0)
+            return timeout;
+
+        struct pollfd pfd = {.fd = fd, .events = events};
+        int ret = poll(&pfd, 1, timeout);
+        if (ret > 0)
+            return 0;
+        if (ret == 0)
+            return -ETIMEDOUT;
+        if (errno != EINTR)
+            return -errno;
+    }
+}
+
+static int connect_deadline(int fd, const struct sockaddr_un *addr, int64_t deadline_ms)
+{
+    int flags = fcntl(fd, F_GETFL, 0);
+    if (flags < 0)
+        return -errno;
+    if (fcntl(fd, F_SETFL, flags | O_NONBLOCK) < 0)
+        return -errno;
+
+    for (;;) {
+        int ret = connect(fd, (const struct sockaddr *)addr, sizeof(*addr));
+        if (ret == 0 || errno == EISCONN)
+            return 0;
+
+        int connect_error = errno;
+        if (connect_error == EINTR)
+            continue;
+        if (connect_error == EAGAIN) {
+            /* Linux AF_UNIX reports a full accept queue as EAGAIN. POLLOUT
+             * may remain asserted for that state, so use a short bounded
+             * retry delay instead of spinning. */
+            int timeout = remaining_ms(deadline_ms);
+            if (timeout < 0)
+                return timeout;
+            if (timeout > 10)
+                timeout = 10;
+            ret = poll(NULL, 0, timeout);
+            if (ret < 0 && errno != EINTR)
+                return -errno;
+            continue;
+        }
+        if (connect_error != EINPROGRESS && connect_error != EALREADY)
+            return -connect_error;
+
+        ret = wait_fd(fd, POLLOUT, deadline_ms);
+        if (ret < 0)
+            return ret;
+
+        int socket_error = 0;
+        socklen_t error_len = sizeof(socket_error);
+        if (getsockopt(fd, SOL_SOCKET, SO_ERROR, &socket_error, &error_len) < 0)
+            return -errno;
+        if (socket_error != 0)
+            return -socket_error;
+
+        struct sockaddr_un peer;
+        socklen_t peer_len = sizeof(peer);
+        if (getpeername(fd, (struct sockaddr *)&peer, &peer_len) == 0)
+            return 0;
+        if (errno != ENOTCONN)
+            return -errno;
+    }
+}
+
+static int write_exact_deadline(int fd, const void *buf, size_t count, int64_t deadline_ms)
+{
+    const uint8_t *p = buf;
+    size_t remaining = count;
+
+    while (remaining > 0) {
+        int ret = wait_fd(fd, POLLOUT, deadline_ms);
+        if (ret < 0)
+            return ret;
+
+        ssize_t n = write(fd, p, remaining);
+        if (n > 0) {
+            p += n;
+            remaining -= (size_t)n;
+            continue;
+        }
+        if (n == 0)
+            return -EPIPE;
+        if (errno != EINTR && errno != EAGAIN && errno != EWOULDBLOCK)
+            return -errno;
+    }
+
+    return 0;
+}
+
+static int read_exact_deadline(int fd, void *buf, size_t count, int64_t deadline_ms)
+{
+    uint8_t *p = buf;
+    size_t remaining = count;
+
+    while (remaining > 0) {
+        int ret = wait_fd(fd, POLLIN, deadline_ms);
+        if (ret < 0)
+            return ret;
+
+        ssize_t n = read(fd, p, remaining);
+        if (n > 0) {
+            p += n;
+            remaining -= (size_t)n;
+            continue;
+        }
+        if (n == 0)
+            return -ECONNRESET;
+        if (errno != EINTR && errno != EAGAIN && errno != EWOULDBLOCK)
+            return -errno;
+    }
+
+    return 0;
+}
+
+static int write_message_deadline(int fd, const char *buf, size_t len, int64_t deadline_ms)
+{
+    if (len > RSS_CTRL_MAX_MSG)
+        return -EMSGSIZE;
+
+    uint8_t len_buf[2] = {(uint8_t)(len >> 8), (uint8_t)(len & 0xFF)};
+    int ret = write_exact_deadline(fd, len_buf, sizeof(len_buf), deadline_ms);
+    if (ret < 0)
+        return ret;
+    return write_exact_deadline(fd, buf, len, deadline_ms);
+}
+
+static int read_message_deadline(int fd, char **out_buf, int64_t deadline_ms)
+{
+    uint8_t len_buf[2];
+    int ret = read_exact_deadline(fd, len_buf, sizeof(len_buf), deadline_ms);
+    if (ret < 0)
+        return ret;
+
+    uint16_t msg_len = ((uint16_t)len_buf[0] << 8) | len_buf[1];
+    if (msg_len == 0) {
+        *out_buf = NULL;
+        return 0;
+    }
+
+    char *buf = malloc((size_t)msg_len + 1);
+    if (!buf)
+        return -ENOMEM;
+
+    ret = read_exact_deadline(fd, buf, msg_len, deadline_ms);
+    if (ret < 0) {
+        free(buf);
+        return ret;
+    }
+
+    buf[msg_len] = '\0';
+    *out_buf = buf;
+    return msg_len;
+}
