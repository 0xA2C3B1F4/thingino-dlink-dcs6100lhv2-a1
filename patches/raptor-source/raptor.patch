diff --git a/tests/test_rsd_timestamp.c b/tests/test_rsd_timestamp.c
new file mode 100644
index 0000000000000000000000000000000000000000..c5c6fd83a247211b1be1eea5494b69e7bcdfd31e
--- /dev/null
+++ b/tests/test_rsd_timestamp.c
@@ -0,0 +1,94 @@
+#include "greatest.h"
+
+#include "../rsd/rsd_timestamp.h"
+
+TEST rsd_timestamp_accepts_forward_progress(void)
+{
+	ASSERT_EQ(1200, rsd_client_timestamp_monotonic(1200, 1000, true, 320));
+	PASS();
+}
+
+TEST rsd_timestamp_repairs_rebase_regression(void)
+{
+	/* Matches the device failure shape: a queue recovery rebased audio from
+	 * 11.5M ticks back near the original RTP-Info timestamp. */
+	ASSERT_EQ(11511632, rsd_client_timestamp_monotonic(60480, 11511312, true, 320));
+	PASS();
+}
+
+TEST rsd_timestamp_advances_duplicate(void)
+{
+	ASSERT_EQ(1320, rsd_client_timestamp_monotonic(1000, 1000, true, 320));
+	PASS();
+}
+
+TEST rsd_timestamp_allows_rtp_wrap(void)
+{
+	ASSERT_EQ(0x00000040, rsd_client_timestamp_monotonic(0x00000040, 0xfffffff0, true, 320));
+	PASS();
+}
+
+TEST rsd_timestamp_accepts_initial_candidate(void)
+{
+	ASSERT_EQ(77, rsd_client_timestamp_monotonic(77, 999, false, 320));
+	PASS();
+}
+
+TEST rsd_timestamp_converts_nonnegative_media_delta(void)
+{
+	uint32_t rtp = 0;
+	ASSERT(rsd_media_timestamp_to_rtp(1066667, 1000000, &rtp));
+	ASSERT_EQ(6000, rtp);
+	PASS();
+}
+
+TEST rsd_timestamp_rejects_negative_media_delta_before_unsigned_cast(void)
+{
+	uint32_t rtp = 1234;
+	ASSERT_FALSE(rsd_media_timestamp_to_rtp(999999, 1000000, &rtp));
+	ASSERT_EQ(1234, rtp);
+	PASS();
+}
+
+TEST rsd_timestamp_maps_imp_epoch_to_monotonic(void)
+{
+	/* Device shape: IMP has run 498s while Linux has run 1277s. */
+	const int64_t media_us = 498000000;
+	const int64_t monotonic_us = 1277000000;
+	const int64_t wall_us = 1800000000000000;
+	const int64_t media_to_wall_us = wall_us - monotonic_us + (monotonic_us - media_us);
+	ASSERT_EQ(monotonic_us,
+		  rsd_media_capture_monotonic(media_us, media_to_wall_us, wall_us,
+					       monotonic_us));
+	PASS();
+}
+
+TEST rsd_capture_timestamp_follows_repaired_rtp_delta(void)
+{
+	/* The candidate repeats, but the repaired 15 fps RTP clock advances by
+	 * 6000 ticks.  The SR capture reference must advance with it. */
+	ASSERT_EQ(1277066667,
+		  rsd_capture_timestamp_after_rtp_repair(1277000000, 7000, 1000));
+	PASS();
+}
+
+TEST rsd_capture_timestamp_uses_wrap_aware_rtp_delta(void)
+{
+	ASSERT_EQ(2000889,
+		  rsd_capture_timestamp_after_rtp_repair(2000000, 0x00000040, 0xfffffff0));
+	PASS();
+}
+
+SUITE(rsd_timestamp_suite)
+{
+	RUN_TEST(rsd_timestamp_accepts_forward_progress);
+	RUN_TEST(rsd_timestamp_repairs_rebase_regression);
+	RUN_TEST(rsd_timestamp_advances_duplicate);
+	RUN_TEST(rsd_timestamp_allows_rtp_wrap);
+	RUN_TEST(rsd_timestamp_accepts_initial_candidate);
+	RUN_TEST(rsd_timestamp_converts_nonnegative_media_delta);
+	RUN_TEST(rsd_timestamp_rejects_negative_media_delta_before_unsigned_cast);
+	RUN_TEST(rsd_timestamp_maps_imp_epoch_to_monotonic);
+	RUN_TEST(rsd_capture_timestamp_follows_repaired_rtp_delta);
+	RUN_TEST(rsd_capture_timestamp_uses_wrap_aware_rtp_delta);
+}
diff --git a/tests/test_storage.c b/tests/test_storage.c
index 326446f5a62dcfa80cafa6d3c5b939bface2ff40..76e6a1afbdf04ee8994953ce1adfea0a25184c29 100644
--- a/tests/test_storage.c
+++ b/tests/test_storage.c
@@ -1,12 +1,24 @@
 #include "greatest.h"
 #include "../rmr/rmr_storage.h"
+#include "../rmr/rmr_writer.h"
 
+#include <errno.h>
+#include <fcntl.h>
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
 #include <sys/stat.h>
+#include <time.h>
 #include <unistd.h>
 
+static int64_t monotonic_us(void)
+{
+	struct timespec ts;
+	if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0)
+		return -1;
+	return (int64_t)ts.tv_sec * 1000000 + ts.tv_nsec / 1000;
+}
+
 static bool same_dev_as_root(const char *path)
 {
 	struct stat a, b;
@@ -73,9 +85,80 @@ TEST storage_refuses_rootfs_autocreate(void)
 	PASS();
 }
 
+TEST storage_close_is_bounded_and_finishes_in_worker(void)
+{
+	const char *tmp = getenv("TMPDIR");
+	if (!tmp || !*tmp)
+		tmp = "/tmp";
+	char path[320];
+	snprintf(path, sizeof(path), "%s/rmr_close_test_XXXXXX", tmp);
+	int fd = mkstemp(path);
+	ASSERT(fd >= 0);
+	ASSERT_EQ(4, write(fd, "test", 4));
+
+	int64_t started = monotonic_us();
+	ASSERT(started >= 0);
+	rmr_storage_close_segment(fd);
+	ASSERT(monotonic_us() - started < 500000);
+
+	int attempts = 0;
+	while (fcntl(fd, F_GETFD) >= 0 && attempts++ < 200)
+		usleep(10000);
+	errno = 0;
+	ASSERT_EQ(-1, fcntl(fd, F_GETFD));
+	ASSERT_EQ(EBADF, errno);
+	unlink(path);
+	PASS();
+}
+
+TEST storage_writer_queues_and_closes_off_thread(void)
+{
+	const char *tmp = getenv("TMPDIR");
+	if (!tmp || !*tmp)
+		tmp = "/tmp";
+	char path[320];
+	snprintf(path, sizeof(path), "%s/rmr_writer_test_XXXXXX", tmp);
+	int fd = mkstemp(path);
+	ASSERT(fd >= 0);
+
+	rmr_writer_t *writer = rmr_writer_create(fd, 1024, false, 1);
+	ASSERT(writer);
+	ASSERT_EQ(0, rmr_writer_submit(writer, "test", 4));
+	ASSERT_EQ(-1, rmr_writer_submit(writer, path, 1025));
+	size_t queued = 0;
+	size_t limit = 0;
+	bool failed = true;
+	rmr_writer_status(writer, &queued, &limit, &failed);
+	ASSERT_EQ(1024, limit);
+	ASSERT_FALSE(failed);
+
+	int64_t started = monotonic_us();
+	ASSERT(started >= 0);
+	rmr_writer_finish(writer);
+	ASSERT(monotonic_us() - started < 500000);
+
+	int attempts = 0;
+	while (fcntl(fd, F_GETFD) >= 0 && attempts++ < 200)
+		usleep(10000);
+	errno = 0;
+	ASSERT_EQ(-1, fcntl(fd, F_GETFD));
+	ASSERT_EQ(EBADF, errno);
+
+	fd = open(path, O_RDONLY);
+	ASSERT(fd >= 0);
+	char data[4];
+	ASSERT_EQ(4, read(fd, data, sizeof(data)));
+	ASSERT_MEM_EQ("test", data, sizeof(data));
+	close(fd);
+	unlink(path);
+	PASS();
+}
+
 SUITE(storage_suite)
 {
 	RUN_TEST(storage_available_existing_dir);
 	RUN_TEST(storage_autocreate_on_mounted_fs);
 	RUN_TEST(storage_refuses_rootfs_autocreate);
+	RUN_TEST(storage_close_is_bounded_and_finishes_in_worker);
+	RUN_TEST(storage_writer_queues_and_closes_off_thread);
 }
