diff --git a/rmr/rmr_writer.c b/rmr/rmr_writer.c
new file mode 100644
index 0000000000000000000000000000000000000000..c8ef7681ce2a8068dc4715a3d4d3ec2f65ea7d9a
--- /dev/null
+++ b/rmr/rmr_writer.c
@@ -0,0 +1,244 @@
+#include "rmr_writer.h"
+
+#include <rss_common.h>
+
+#include <errno.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#define RMR_WRITERS_MAX 3
+
+typedef struct rmr_write_chunk {
+	struct rmr_write_chunk *next;
+	uint32_t len;
+	uint8_t data[];
+} rmr_write_chunk_t;
+
+struct rmr_writer {
+	int fd;
+	size_t queue_limit;
+	size_t queued_bytes;
+	rmr_write_chunk_t *head;
+	rmr_write_chunk_t *tail;
+	pthread_mutex_t lock;
+	pthread_cond_t cond;
+	bool closing;
+	bool failed;
+	bool sync_on_close;
+	size_t sync_interval_bytes;
+	size_t bytes_since_sync;
+};
+
+static atomic_int active_writers;
+
+static int write_all(int fd, const uint8_t *data, uint32_t len)
+{
+	uint32_t remaining = len;
+	while (remaining > 0) {
+		ssize_t n = write(fd, data, remaining);
+		if (n > 0) {
+			data += n;
+			remaining -= (uint32_t)n;
+			continue;
+		}
+		if (n < 0 && errno == EINTR)
+			continue;
+		return -1;
+	}
+	return 0;
+}
+
+static void free_queue(rmr_writer_t *writer)
+{
+	while (writer->head) {
+		rmr_write_chunk_t *chunk = writer->head;
+		writer->head = chunk->next;
+		free(chunk);
+	}
+	writer->tail = NULL;
+	writer->queued_bytes = 0;
+}
+
+static void *writer_thread(void *arg)
+{
+	rmr_writer_t *writer = arg;
+
+	for (;;) {
+		pthread_mutex_lock(&writer->lock);
+		while (!writer->head && !writer->closing)
+			pthread_cond_wait(&writer->cond, &writer->lock);
+		if (!writer->head && writer->closing) {
+			pthread_mutex_unlock(&writer->lock);
+			break;
+		}
+
+		rmr_write_chunk_t *chunk = writer->head;
+		writer->head = chunk->next;
+		if (!writer->head)
+			writer->tail = NULL;
+		writer->queued_bytes -= chunk->len;
+		pthread_mutex_unlock(&writer->lock);
+
+		if (write_all(writer->fd, chunk->data, chunk->len) != 0) {
+			RSS_ERROR("recorder writer failed: %s", strerror(errno));
+			pthread_mutex_lock(&writer->lock);
+			writer->failed = true;
+			free_queue(writer);
+			pthread_mutex_unlock(&writer->lock);
+		} else if (writer->sync_interval_bytes > 0) {
+			writer->bytes_since_sync += chunk->len;
+			if (writer->bytes_since_sync >= writer->sync_interval_bytes) {
+				if (fdatasync(writer->fd) != 0) {
+					RSS_ERROR("recorder periodic fdatasync failed: %s",
+						  strerror(errno));
+					pthread_mutex_lock(&writer->lock);
+					writer->failed = true;
+					free_queue(writer);
+					pthread_mutex_unlock(&writer->lock);
+				}
+				writer->bytes_since_sync = 0;
+			}
+		}
+		free(chunk);
+	}
+
+	if (!writer->failed && writer->sync_on_close && fdatasync(writer->fd) != 0)
+		RSS_WARN("recorder fdatasync failed: %s", strerror(errno));
+	close(writer->fd);
+	pthread_cond_destroy(&writer->cond);
+	pthread_mutex_destroy(&writer->lock);
+	free(writer);
+	atomic_fetch_sub_explicit(&active_writers, 1, memory_order_release);
+	return NULL;
+}
+
+rmr_writer_t *rmr_writer_create(int fd, size_t queue_limit, bool sync_on_close,
+				size_t sync_interval_bytes)
+{
+	if (fd < 0 || queue_limit == 0) {
+		errno = EINVAL;
+		return NULL;
+	}
+
+	int active = atomic_load_explicit(&active_writers, memory_order_acquire);
+	while (active < RMR_WRITERS_MAX) {
+		if (atomic_compare_exchange_weak_explicit(&active_writers, &active, active + 1,
+						  memory_order_acq_rel, memory_order_acquire))
+			break;
+	}
+	if (active >= RMR_WRITERS_MAX) {
+		errno = EBUSY;
+		return NULL;
+	}
+
+	rmr_writer_t *writer = calloc(1, sizeof(*writer));
+	if (!writer)
+		goto fail_active;
+	writer->fd = fd;
+	writer->queue_limit = queue_limit;
+	writer->sync_on_close = sync_on_close;
+	writer->sync_interval_bytes = sync_interval_bytes;
+	if (pthread_mutex_init(&writer->lock, NULL) != 0)
+		goto fail_writer;
+	if (pthread_cond_init(&writer->cond, NULL) != 0)
+		goto fail_mutex;
+
+	pthread_attr_t attr;
+	pthread_t thread;
+	if (pthread_attr_init(&attr) != 0)
+		goto fail_cond;
+	pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+	pthread_attr_setstacksize(&attr, 128 * 1024);
+	int ret = pthread_create(&thread, &attr, writer_thread, writer);
+	pthread_attr_destroy(&attr);
+	if (ret != 0) {
+		errno = ret;
+		goto fail_cond;
+	}
+	return writer;
+
+fail_cond:
+	pthread_cond_destroy(&writer->cond);
+fail_mutex:
+	pthread_mutex_destroy(&writer->lock);
+fail_writer:
+	free(writer);
+fail_active:
+	atomic_fetch_sub_explicit(&active_writers, 1, memory_order_release);
+	return NULL;
+}
+
+int rmr_writer_submit(rmr_writer_t *writer, const void *data, uint32_t len)
+{
+	if (!writer || (!data && len > 0)) {
+		errno = EINVAL;
+		return -1;
+	}
+	if (len == 0)
+		return 0;
+	if (len > writer->queue_limit) {
+		errno = EAGAIN;
+		return -1;
+	}
+#if SIZE_MAX <= UINT32_MAX
+	if (len > SIZE_MAX - sizeof(rmr_write_chunk_t)) {
+		errno = EOVERFLOW;
+		return -1;
+	}
+#endif
+
+	rmr_write_chunk_t *chunk = malloc(sizeof(*chunk) + len);
+	if (!chunk)
+		return -1;
+	chunk->next = NULL;
+	chunk->len = len;
+	memcpy(chunk->data, data, len);
+
+	pthread_mutex_lock(&writer->lock);
+	if (writer->closing || writer->failed || writer->queued_bytes > writer->queue_limit ||
+	    len > writer->queue_limit - writer->queued_bytes) {
+		pthread_mutex_unlock(&writer->lock);
+		free(chunk);
+		errno = EAGAIN;
+		return -1;
+	}
+	if (writer->tail)
+		writer->tail->next = chunk;
+	else
+		writer->head = chunk;
+	writer->tail = chunk;
+	writer->queued_bytes += len;
+	pthread_cond_signal(&writer->cond);
+	pthread_mutex_unlock(&writer->lock);
+	return 0;
+}
+
+void rmr_writer_status(rmr_writer_t *writer, size_t *queued_bytes, size_t *queue_limit,
+		       bool *failed)
+{
+	if (!writer)
+		return;
+	pthread_mutex_lock(&writer->lock);
+	if (queued_bytes)
+		*queued_bytes = writer->queued_bytes;
+	if (queue_limit)
+		*queue_limit = writer->queue_limit;
+	if (failed)
+		*failed = writer->failed;
+	pthread_mutex_unlock(&writer->lock);
+}
+
+void rmr_writer_finish(rmr_writer_t *writer)
+{
+	if (!writer)
+		return;
+	pthread_mutex_lock(&writer->lock);
+	writer->closing = true;
+	pthread_cond_signal(&writer->cond);
+	pthread_mutex_unlock(&writer->lock);
+}
