@@ -0,0 +1,23 @@
+#ifndef RMR_WRITER_H
+#define RMR_WRITER_H
+
+#include <stddef.h>
+#include <stdbool.h>
+#include <stdint.h>
+
+typedef struct rmr_writer rmr_writer_t;
+
+/* Takes ownership of fd on success.  At most three writers may be live. */
+rmr_writer_t *rmr_writer_create(int fd, size_t queue_limit, bool sync_on_close,
+				size_t sync_interval_bytes);
+
+/* Copies one bounded chunk for the storage worker. */
+int rmr_writer_submit(rmr_writer_t *writer, const void *data, uint32_t len);
+
+void rmr_writer_status(rmr_writer_t *writer, size_t *queued_bytes, size_t *queue_limit,
+		       bool *failed);
+
+/* Returns immediately.  The detached worker drains and closes the file. */
+void rmr_writer_finish(rmr_writer_t *writer);
+
+#endif
