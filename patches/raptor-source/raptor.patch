diff --git a/rsd/rsd_timestamp.h b/rsd/rsd_timestamp.h
new file mode 100644
index 0000000000000000000000000000000000000000..3ad97294f2cd120f71c4c2a2cb6c7914dd082013
--- /dev/null
+++ b/rsd/rsd_timestamp.h
@@ -0,0 +1,54 @@
+#ifndef RSD_TIMESTAMP_H
+#define RSD_TIMESTAMP_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/* Keep a per-client RTP timeline moving forward across ring reconnects and
+ * bounded-send-queue recovery.  Signed subtraction is the conventional RTP
+ * wrap-aware ordering test as long as successive frames differ by < 2^31. */
+static inline uint32_t rsd_client_timestamp_monotonic(uint32_t candidate, uint32_t previous,
+						      bool has_previous, uint32_t frame_duration)
+{
+	if (has_previous && (int32_t)(candidate - previous) <= 0)
+		return previous + frame_duration;
+	return candidate;
+}
+
+/* Convert an IMP media timestamp to the 90 kHz RTP epoch without turning a
+ * real backward step into a huge unsigned jump. */
+static inline bool rsd_media_timestamp_to_rtp(int64_t media_us, int64_t epoch_us,
+					      uint32_t *rtp_timestamp)
+{
+	int64_t delta_us = media_us - epoch_us;
+	if (delta_us < 0)
+		return false;
+	*rtp_timestamp = (uint32_t)((uint64_t)delta_us * 90000ULL / 1000000ULL);
+	return true;
+}
+
+/* RVD's IMP media clock starts at IMP_System_Init, not at Linux boot.  The
+ * ring's UTC mapping is media_to_wall_us; subtracting the current
+ * wall-to-monotonic offset puts the capture instant on CLOCK_MONOTONIC for
+ * Compy's RTCP sender-report projection. */
+static inline int64_t rsd_media_capture_monotonic(int64_t media_us, int64_t media_to_wall_us,
+						 int64_t wall_now_us, int64_t monotonic_now_us)
+{
+	return media_us + media_to_wall_us - (wall_now_us - monotonic_now_us);
+}
+
+/* Keep the capture-clock reference coherent with the RTP timeline after the
+ * RTP timestamp has been repaired.  Some IMP channels occasionally repeat a
+ * media timestamp.  RSD advances RTP by one frame in that case; handing Compy
+ * the original repeated capture instant would make the next RTCP sender report
+ * describe two different clocks.  After the first mapped sample, advance the
+ * capture reference by the exact wrap-aware RTP delta instead. */
+static inline int64_t rsd_capture_timestamp_after_rtp_repair(int64_t previous_capture,
+						    uint32_t rtp_timestamp,
+						    uint32_t previous_rtp_timestamp)
+{
+	uint32_t delta = rtp_timestamp - previous_rtp_timestamp;
+	return previous_capture + (int64_t)(((uint64_t)delta * 1000000ULL + 45000ULL) / 90000ULL);
+}
+
+#endif
