diff --git a/package/prudynt-t/files/S31prudynt b/package/prudynt-t/files/S31prudynt
--- a/package/prudynt-t/files/S31prudynt
+++ b/package/prudynt-t/files/S31prudynt
@@ -5,6 +5,7 @@ export PATH
 
 DAEMON="/usr/bin/prudynt"
 PIDFILE="/run/prudynt.pid"
+READY="/run/prudynt-dlink-media.ready"
 HEARTBEAT_INIT="/etc/init.d/S99heartbeat"
 
 load_timezone() {
@@ -43,7 +44,25 @@ is_alive() {
 }
 
 start_daemon() {
-	start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON"
+	if ! is_alive; then
+		rm -f "$PIDFILE" "$READY"
+		start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON" || return 1
+	fi
+
+	i=0
+	while [ "$i" -lt 150 ]; do
+		if is_alive && [ "$(cat "$READY" 2>/dev/null || true)" = 1080p-started ]; then
+			return 0
+		fi
+		is_alive || break
+		usleep 100000
+		i=$((i + 1))
+	done
+
+	# A detached start only proves that fork succeeded. Retire a process that
+	# died or never completed media initialization before retrying it.
+	stop_daemon
+	return 1
 }
 
 stop_daemon() {
@@ -63,12 +82,20 @@ stop_daemon() {
 start() {
 	echo -c 15 "Starting Prudynt"
 	load_timezone
-	start_daemon
-	status=$?
-	if [ "$status" -eq 0 ]; then
-		restart_heartbeat
-	fi
-	return "$status"
+	attempt=1
+	while [ "$attempt" -le 3 ]; do
+		if start_daemon; then
+			restart_heartbeat
+			return 0
+		fi
+		if [ "$attempt" -lt 3 ]; then
+			echo -c 15 "Prudynt media startup failed (attempt $attempt), retrying..."
+			sleep 2
+		fi
+		attempt=$((attempt + 1))
+	done
+	echo -c 15 "Prudynt failed to reach media-ready after 3 attempts"
+	return 1
 }
 
 stop() {
@@ -106,18 +133,7 @@ case "$1" in
 	restart)
 		stop || true
 		sleep 2
-		# Retry start up to 3 times if the first attempt fails.
-		r=0
-		while [ $r -lt 3 ]; do
-			if start; then
-				exit 0
-			fi
-			r=$((r + 1))
-			echo -c 15 "Prudynt start failed (attempt $r), retrying..."
-			sleep 2
-		done
-		echo -c 15 "Prudynt failed to start after 3 attempts"
-		exit 1
+		start
 		;;
 	*)
 		echo "Usage: $0 {start|stop|restart}"
