diff --git a/package/thingino-onvif/files/S94onvif-httpd b/package/thingino-onvif/files/S94onvif-httpd
new file mode 100644
index 00000000..cff38efe
--- /dev/null
+++ b/package/thingino-onvif/files/S94onvif-httpd
@@ -0,0 +1,64 @@
+#!/bin/sh
+set -u
+
+DAEMON=/usr/sbin/onvif-httpd
+PIDFILE=/run/onvif-httpd.pid
+WORKDIR=/usr/share/onvif
+PORT=1999
+
+owned_pid() {
+	pid=$1
+	case "$pid" in ''|*[!0-9]*) return 1 ;; esac
+	[ -r "/proc/$pid/exe" ] || return 1
+	[ "$(readlink "/proc/$pid/exe" 2>/dev/null)" = "$DAEMON" ]
+}
+
+listening() {
+	hex_port=$(printf '%04X' "$PORT") || return 1
+	awk -v endpoint="0100007F:$hex_port" \
+		'$2 == endpoint && $4 == "0A" { found = 1 } END { exit !found }' \
+		/proc/net/tcp
+}
+
+start() {
+	[ -x "$DAEMON" ] || return 1
+	[ -d "$WORKDIR" ] || return 1
+	if [ -s "$PIDFILE" ]; then
+		IFS= read -r pid <"$PIDFILE" || return 1
+		owned_pid "$pid" && return 0
+	fi
+	rm -f "$PIDFILE"
+	cd "$WORKDIR" || return 1
+	start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON" || return 1
+	i=0
+	while [ "$i" -lt 50 ]; do
+		if IFS= read -r pid <"$PIDFILE" && owned_pid "$pid" && listening; then
+			return 0
+		fi
+		usleep 100000
+		i=$((i + 1))
+	done
+	return 1
+}
+
+stop() {
+	[ -s "$PIDFILE" ] || return 0
+	IFS= read -r pid <"$PIDFILE" || return 1
+	if owned_pid "$pid"; then
+		kill "$pid" || return 1
+		i=0
+		while owned_pid "$pid" && [ "$i" -lt 50 ]; do
+			usleep 100000
+			i=$((i + 1))
+		done
+	fi
+	owned_pid "$pid" && return 1
+	rm -f "$PIDFILE"
+}
+
+case "${1:-}" in
+	start) start ;;
+	stop) stop ;;
+	restart) stop && start ;;
+	*) echo "Usage: $0 {start|stop|restart}" >&2; exit 1 ;;
+esac
