--- a/package/thingino-daynightd/files/S06ircut
+++ b/package/thingino-daynightd/files/S06ircut
@@ -3,9 +3,18 @@
 start() {
 	echo -c 15 "Initializing IR-CUT"
 
-	ircut off >/dev/null 2>&1
+	# DCS-6100LHV2 A1 uses a two-wire latching IR-cut motor. Initialize
+	# both directions and leave the daylight filter engaged. Runtime
+	# transitions are performed by Thingino Control, not helper commands.
+	printf 0 > /sys/class/gpio/gpio50/value
+	printf 1 > /sys/class/gpio/gpio49/value
+	usleep 100000
+	printf 0 > /sys/class/gpio/gpio49/value
 	sleep 0.5
-	ircut on >/dev/null 2>&1
+	printf 0 > /sys/class/gpio/gpio49/value
+	printf 1 > /sys/class/gpio/gpio50/value
+	usleep 100000
+	printf 0 > /sys/class/gpio/gpio50/value
 }
 
