 # Determine libc name based on variables
 ifeq ($(BR2_TOOLCHAIN_USES_GLIBC),y)
 	SDK_LIBC_NAME := glibc
@@ -13,6 +23,31 @@
 else
 	SDK_LIBC_NAME := uclibc
 endif
 
+ifeq ($(CAMERA),dlink_dcs6100lhv2_a1_t31n_os02g10_rtl8188fu)
+define DCS6100_VALIDATE_CAMERA_VENDOR_SITE
+	test "$$(find $(@D)/files -mindepth 1 -maxdepth 1 | wc -l)" -eq 3
+	test "$$(wc -c < $(@D)/files/libimp.so)" -eq 1146852
+	test "$$(wc -c < $(@D)/files/libalog.so)" -eq 36044
+	test "$$(wc -c < $(@D)/files/libsysutils.so)" -eq 30020
+	printf '%s  %s\n' \
+		14b18d23964f18b63cef3a32ca7a6dc7ae8ee6ebb001c646ffa0ace72c2273fe $(@D)/files/libimp.so \
+		40fd7eb9237772f705a92e9792325f07f0fe022479923f8dc67653cc11450ea1 $(@D)/files/libalog.so \
+		befca6166d2e25b749cc9fff4798332f42a2d997b00d4aee713358d803353b79 $(@D)/files/libsysutils.so \
+		| sha256sum -c -
+	test -f "$(DCS6100_AUDIOPROCESS_LINK_FILE)"
+	test ! -L "$(DCS6100_AUDIOPROCESS_LINK_FILE)"
+	audio_size="$$(wc -c < "$(DCS6100_AUDIOPROCESS_LINK_FILE)")"; \
+	audio_sha="$$(sha256sum "$(DCS6100_AUDIOPROCESS_LINK_FILE)")"; \
+	audio_sha="$${audio_sha%% *}"; \
+	case "$$audio_size:$$audio_sha" in \
+		75168:f892759f47e0296ea175bf4247f661a11381037bafec7800326298d73d0a7273) ;; \
+		697757:0f03bee6156b3a570c4af8cc199a53b1302fb4450570a53222107ff498a3ae72) ;; \
+		*) exit 1 ;; \
+	esac
+endef
+INGENIC_LIB_PRE_CONFIGURE_HOOKS += DCS6100_VALIDATE_CAMERA_VENDOR_SITE
+endif
+
 # Determine GCC version based on variables
 ifneq ($(filter t10 t20 t21 t30,$(SOC_FAMILY)),)
