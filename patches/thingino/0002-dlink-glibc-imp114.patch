+# The public ingenic-lib archive is not fetched or packaged for this profile.
+INGENIC_LIB_SITE_METHOD = local
+INGENIC_LIB_SITE = $(DCS6100_VENDOR_BUNDLE_DIR)
+INGENIC_LIB_LICENSE = Proprietary-camera-local
+INGENIC_LIB_LICENSE_FILES =
+INGENIC_LIB_REDISTRIBUTE = NO
+endif
