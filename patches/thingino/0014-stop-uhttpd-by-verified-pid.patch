+	if [ "$(readlink "/proc/$pid/exe" 2>/dev/null)" != "/usr/bin/uhttpd" ]; then
+		echo "Refusing to stop an unverified PID: $pid"
+		return 1
 	fi
+
+	kill -TERM "$pid" 2>/dev/null || return 1
+	local waits=0
+	while kill -0 "$pid" 2>/dev/null && [ "$waits" -lt 50 ]; do
+		sleep 0.1
+		waits=$((waits + 1))
