+	local pid
+	pid=$(cat "$PIDFILE")
+	case "$pid" in
+		'' | *[!0-9]*)
+			echo "Invalid uhttpd PID file"
+			return 1
+			;;
+	esac
+
+	if ! kill -0 "$pid" 2>/dev/null; then
