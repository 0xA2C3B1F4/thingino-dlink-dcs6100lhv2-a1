diff --git a/Makefile b/Makefile
index 523a66a..36a7750 100644
--- a/Makefile
+++ b/Makefile
@@ -187,8 +187,9 @@ LDFLAGS     := $(LDFLAGS_SYSROOT) -lpthread -lrt -latomic
 
 # MIPS page size: Ingenic SoCs use 4KB pages but the toolchain defaults to
 # 64KB max-page-size. Mismatched alignment causes SIGBUS on musl/uclibc.
-LDFLAGS_HAL += -Wl,-z,max-page-size=0x1000 -Wl,--gc-sections -Wl,--as-needed -Wl,-rpath,/usr/lib $(if $(DEBUG),,-flto)
-LDFLAGS     += -Wl,-z,max-page-size=0x1000 -Wl,--gc-sections -Wl,--as-needed -Wl,-rpath,/usr/lib $(if $(DEBUG),,-flto)
+RUNTIME_RPATH := -Wl,-rpath,/usr/lib
+LDFLAGS_HAL += -Wl,-z,max-page-size=0x1000 -Wl,--gc-sections -Wl,--as-needed $(RUNTIME_RPATH) $(if $(DEBUG),,-flto)
+LDFLAGS     += -Wl,-z,max-page-size=0x1000 -Wl,--gc-sections -Wl,--as-needed $(RUNTIME_RPATH) $(if $(DEBUG),,-flto)
 # rpath-link for local builds (finding .so at link time)
 LDFLAGS_HAL += -Wl,-rpath-link,$(CURDIR)/$(IPC_DIR) -Wl,-rpath-link,$(CURDIR)/$(COMMON_DIR)
 LDFLAGS     += -Wl,-rpath-link,$(CURDIR)/$(IPC_DIR) -Wl,-rpath-link,$(CURDIR)/$(COMMON_DIR)
@@ -297,7 +298,7 @@ rwd: $(LIB_IPC_FILE) $(LIB_COMMON_FILE) $(LIB_COMPY_FILE) $(RSS_TLS_OBJ) $(RSS_BU
 	@echo "  BUILD   rwd"
 	$(Q)$(MAKE) -C rwd CC="$(CC)" CFLAGS="$(CFLAGS) $(COMPY_CFLAGS) -DMBEDTLS_ALLOW_PRIVATE_ACCESS -DRSS_HAS_TLS" \
 		LIBS="$(LIB_IPC) $(LIB_COMMON) $(LIB_COMPY) $(RSS_TLS_OBJ) $(RSS_BUILD_LIBS)" \
-		LDFLAGS="$(LDFLAGS) $(LDFLAGS_TLS) $(LDFLAGS_OPUS) $(LDFLAGS_AAC_DEC)" WEBTORRENT=$(WEBTORRENT) Q="$(Q)"
+		LDFLAGS="$(filter-out $(RUNTIME_RPATH),$(LDFLAGS)) $(LDFLAGS_TLS) $(LDFLAGS_OPUS) $(LDFLAGS_AAC_DEC)" WEBTORRENT=$(WEBTORRENT) Q="$(Q)"
 
 rwc: $(LIB_IPC_FILE) $(LIB_COMMON_FILE) $(RSS_BUILD_OBJ)
 	@echo "  BUILD   rwc"
diff --git a/rwd/rwd_dtls.c b/rwd/rwd_dtls.c
index fba9e37..c6e8d74 100644
--- a/rwd/rwd_dtls.c
+++ b/rwd/rwd_dtls.c
@@ -19,6 +19,7 @@
 
 #include <mbedtls/error.h>
 #include <mbedtls/md.h>
+#include <mbedtls/platform.h>
 
 #ifndef MBEDTLS_SSL_DTLS_SRTP
 #error "RWD requires mbedTLS compiled with MBEDTLS_SSL_DTLS_SRTP support"
@@ -96,6 +97,9 @@ int rwd_dtls_init(rwd_dtls_ctx_t *ctx, const char *cert_path, const char *key_pa
 	int ret;
 	char errbuf[128];
 
+	/* Linux 3.10 camera kernels can leave /dev/random starved indefinitely. */
+	mbedtls_platform_dev_random = "/dev/urandom";
+
 	memset(ctx, 0, sizeof(*ctx));
 
 	mbedtls_ssl_config_init(&ctx->conf);
diff --git a/rwd/rwd_main.c b/rwd/rwd_main.c
index 333375d..5e50ea2 100644
--- a/rwd/rwd_main.c
+++ b/rwd/rwd_main.c
