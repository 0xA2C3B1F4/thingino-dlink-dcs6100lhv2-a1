diff --git a/rwd/rwd_media.c b/rwd/rwd_media.c
index 79c1fca..150576d 100644
--- a/rwd/rwd_media.c
+++ b/rwd/rwd_media.c
@@ -550,6 +550,10 @@ void *rwd_video_reader_thread(void *arg)
 	}
 	if (!srv->video_rings[0])
 		return NULL;
+	for (int s = 0; s < RWD_STREAM_COUNT; s++) {
+		if (srv->video_rings[s])
+			rss_ring_acquire(srv->video_rings[s]);
+	}
 
 	/* Initialize per-stream state */
 	for (int s = 0; s < RWD_STREAM_COUNT; s++) {
@@ -585,6 +589,7 @@ void *rwd_video_reader_thread(void *arg)
 			if (!srv->video_rings[s] && srv->video_bufs[s]) {
 				srv->video_rings[s] = rss_ring_open(ring_names[s]);
 				if (srv->video_rings[s]) {
+					rss_ring_acquire(srv->video_rings[s]);
 					{
 						char vname[24];
 						snprintf(vname, sizeof(vname), "video[%d]", s);
@@ -598,6 +603,7 @@ void *rwd_video_reader_thread(void *arg)
 					if (ds > srv->video_buf_sizes[s]) {
 						uint8_t *new_buf = malloc(ds);
 						if (!new_buf) {
+							rss_ring_release(srv->video_rings[s]);
 							rss_ring_close(srv->video_rings[s]);
 							srv->video_rings[s] = NULL;
 							srv->video_buf_sizes[s] = 0;
@@ -672,6 +678,7 @@ void *rwd_video_reader_thread(void *arg)
 				if (idle[s] >= 40) { /* ~2s at 50ms timeout */
 					RSS_DEBUG("media: video[%d] idle, closing ring (%s)", s,
 						  ring_names[s]);
+					rss_ring_release(srv->video_rings[s]);
 					rss_ring_close(srv->video_rings[s]);
 					srv->video_rings[s] = NULL;
 					idle[s] = 0;
