diff --git a/rwd/rwd_main.c b/rwd/rwd_main.c
index 47fa00a..333375d 100644
--- a/rwd/rwd_main.c
+++ b/rwd/rwd_main.c
@@ -187,6 +187,26 @@ static int create_udp_socket(int port)
 
 /* ── Create listening TCP socket for HTTP ── */
 
-static int create_http_socket(int port)
+static int create_http_socket(int port, bool loopback_only)
 {
+	if (loopback_only) {
+		int loopback_fd = socket(AF_INET, SOCK_STREAM, 0);
+		if (loopback_fd < 0)
+			return -1;
+		int reuse = 1;
+		setsockopt(loopback_fd, SOL_SOCKET, SO_REUSEADDR, &reuse, sizeof(reuse));
+		struct sockaddr_in loopback = {
+			.sin_family = AF_INET,
+			.sin_port = htons(port),
+			.sin_addr.s_addr = htonl(INADDR_LOOPBACK),
+		};
+		if (bind(loopback_fd, (struct sockaddr *)&loopback, sizeof(loopback)) < 0 ||
+		    listen(loopback_fd, 8) < 0) {
+			close(loopback_fd);
+			return -1;
+		}
+		fcntl(loopback_fd, F_SETFL, fcntl(loopback_fd, F_GETFL) | O_NONBLOCK);
+		return loopback_fd;
+	}
+
 	int fd = socket(AF_INET6, SOCK_STREAM, 0);
@@ -563,8 +563,11 @@ static void rwd_run(rwd_server_t *srv)
 	pthread_attr_setstacksize(&tattr, 128 * 1024);
 
 	pthread_t video_tid, audio_tid;
+	bool audio_started = false;
 	pthread_create(&video_tid, &tattr, rwd_video_reader_thread, srv);
-	pthread_create(&audio_tid, &tattr, rwd_audio_reader_thread, srv);
+	if (!srv->video_only &&
+	    pthread_create(&audio_tid, &tattr, rwd_audio_reader_thread, srv) == 0)
+		audio_started = true;
 	pthread_attr_destroy(&tattr);
 
 	uint8_t udp_buf[RWD_UDP_BUF_SIZE];
@@ -637,7 +640,8 @@ static void rwd_run(rwd_server_t *srv)
 	/* Shutdown — wake reader threads so they see *running == false */
 	pthread_cond_broadcast(&srv->clients_cond);
 	pthread_join(video_tid, NULL);
-	pthread_join(audio_tid, NULL);
+	if (audio_started)
+		pthread_join(audio_tid, NULL);
 
 	/* Cleanup all clients */
 	pthread_mutex_lock(&srv->clients_lock);
@@ -693,6 +717,9 @@ int main(int argc, char **argv)
 		srv.max_clients = 1;
 	if (srv.max_clients > RWD_MAX_CLIENTS)
 		srv.max_clients = RWD_MAX_CLIENTS;
+	srv.video_only = rss_config_get_bool(dctx.cfg, "webrtc", "video_only", false);
+	srv.signaling_loopback =
+		rss_config_get_bool(dctx.cfg, "webrtc", "signaling_loopback", false);
 	const char *audio_mode_str = rss_config_get_str(dctx.cfg, "webrtc", "audio_mode", "opus");
 	if (strcmp(audio_mode_str, "auto") == 0)
 		srv.audio_mode = RWD_AUDIO_MODE_AUTO;
@@ -795,11 +822,13 @@ int main(int argc, char **argv)
-	srv.http_fd = create_http_socket(srv.http_port);
+	srv.http_fd = create_http_socket(srv.http_port, srv.signaling_loopback);
 	if (srv.http_fd < 0) {
 		RSS_FATAL("failed to bind HTTP port %d: %s", srv.http_port, strerror(errno));
 		goto cleanup;
 	}
 	RSS_INFO("HTTP listening on port %d (GET /webrtc, POST /whip)", srv.http_port);
-	RSS_DEBUG("  max_clients=%d audio=%s opus_complexity=%d opus_bitrate=%d", srv.max_clients,
-		  audio_mode_str, srv.opus_complexity, srv.opus_bitrate);
+	RSS_DEBUG("  max_clients=%d video_only=%s signaling_loopback=%s audio=%s opus_complexity=%d opus_bitrate=%d",
+		  srv.max_clients, srv.video_only ? "true" : "false",
+		  srv.signaling_loopback ? "true" : "false", audio_mode_str,
+		  srv.opus_complexity, srv.opus_bitrate);
 
 	/* WebTorrent external sharing (optional) */
 #ifdef RAPTOR_WEBTORRENT
