diff --git a/src/RecorderStartPolicy.hpp b/src/RecorderStartPolicy.hpp
new file mode 100644
index 0000000..87e57b1
--- /dev/null
+++ b/src/RecorderStartPolicy.hpp
@@ -0,0 +1,13 @@
+#pragma once
+
+#include <cstddef>
+
+template <class Frames>
+std::size_t firstKeyframeIndex(const Frames &frames) {
+  for (std::size_t index = 0; index < frames.size(); ++index) {
+    if (frames[index].is_keyframe) {
+      return index;
+    }
+  }
+  return frames.size();
+}
