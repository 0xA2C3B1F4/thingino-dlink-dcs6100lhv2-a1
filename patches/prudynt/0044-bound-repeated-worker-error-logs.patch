diff --git a/src/RepeatedFailureGate.hpp b/src/RepeatedFailureGate.hpp
new file mode 100644
index 0000000..77dad7f
--- /dev/null
+++ b/src/RepeatedFailureGate.hpp
@@ -0,0 +1,67 @@
+#ifndef REPEATEDFAILUREGATE_HPP
+#define REPEATEDFAILUREGATE_HPP
+
+#include <cstdint>
+#include <limits>
+
+enum class RepeatedFailureAction {
+  None,
+  FirstFailure,
+  Recovered,
+};
+
+struct RepeatedFailureObservation {
+  RepeatedFailureAction action{RepeatedFailureAction::None};
+  uint16_t suppressed{0};
+};
+
+// Bounds logging for one fixed failure category. A continuous failure episode
+// emits its first error only; recovery may emit one summary. State is fixed
+// size and the suppressed counter saturates instead of wrapping.
+class RepeatedFailureGate {
+public:
+  RepeatedFailureObservation observe(bool failed) {
+    if (failed) {
+      if (!failing_) {
+        failing_ = true;
+        suppressed_ = 0;
+        return {RepeatedFailureAction::FirstFailure, 0};
+      }
+      if (suppressed_ < std::numeric_limits<uint16_t>::max()) {
+        ++suppressed_;
+      }
+      return {};
+    }
+
+    if (!failing_) {
+      return {};
+    }
+    RepeatedFailureObservation result{RepeatedFailureAction::Recovered,
+                                      suppressed_};
+    failing_ = false;
+    suppressed_ = 0;
+    return result;
+  }
+
+  bool failing() const { return failing_; }
+  uint16_t suppressed() const { return suppressed_; }
+
+private:
+  bool failing_{false};
+  uint16_t suppressed_{0};
+};
+
+template <typename FirstFailureCallback, typename RecoveryCallback>
+inline void observeRepeatedFailure(RepeatedFailureGate &gate, bool failed,
+                                   FirstFailureCallback first_failure,
+                                   RecoveryCallback recovery) {
+  auto observation = gate.observe(failed);
+  if (observation.action == RepeatedFailureAction::FirstFailure) {
+    first_failure();
+  } else if (observation.action == RepeatedFailureAction::Recovered &&
+             observation.suppressed > 0) {
+    recovery(observation.suppressed);
+  }
+}
+
+#endif // REPEATEDFAILUREGATE_HPP
