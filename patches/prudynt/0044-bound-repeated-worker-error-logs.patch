diff --git a/tests/test_repeated_failure_gate.cpp b/tests/test_repeated_failure_gate.cpp
new file mode 100644
index 0000000..1402cca
--- /dev/null
+++ b/tests/test_repeated_failure_gate.cpp
@@ -0,0 +1,34 @@
+#include "RepeatedFailureGate.hpp"
+
+#include <cassert>
+#include <cstdint>
+#include <limits>
+
+int main() {
+  RepeatedFailureGate gate;
+  auto first = gate.observe(true);
+  assert(first.action == RepeatedFailureAction::FirstFailure);
+  assert(first.suppressed == 0);
+
+  auto repeated = gate.observe(true);
+  assert(repeated.action == RepeatedFailureAction::None);
+  assert(gate.suppressed() == 1);
+
+  auto recovered = gate.observe(false);
+  assert(recovered.action == RepeatedFailureAction::Recovered);
+  assert(recovered.suppressed == 1);
+  assert(!gate.failing());
+
+  assert(gate.observe(false).action == RepeatedFailureAction::None);
+  assert(gate.observe(true).action == RepeatedFailureAction::FirstFailure);
+  for (uint32_t i = 0;
+       i < static_cast<uint32_t>(std::numeric_limits<uint16_t>::max()) + 8;
+       ++i) {
+    gate.observe(true);
+  }
+  assert(gate.suppressed() == std::numeric_limits<uint16_t>::max());
+  recovered = gate.observe(false);
+  assert(recovered.action == RepeatedFailureAction::Recovered);
+  assert(recovered.suppressed == std::numeric_limits<uint16_t>::max());
+  return 0;
+}
