+static void test_recorder_timestamp_preserves_low_fps_and_rebases_jumps() {
+  constexpr int64_t nominal_step_us = 1000000LL / 15;
+  constexpr int64_t actual_step_us = 1000000LL / 7;
+  int64_t timestamp_us = 1000000;
+  const int64_t segment_base_us = timestamp_us;
+  for (int frame = 1; frame < 420; ++frame) {
+    int64_t candidate = timestamp_us + actual_step_us;
+    timestamp_us = normalizeRecorderFrameTimestamp(
+        candidate, timestamp_us, nominal_step_us);
+  }
+  int64_t duration_ms = (timestamp_us - segment_base_us) / 1000;
+  assert(duration_ms > 59000 && duration_ms < 61000);
+
+  int64_t rebased = normalizeRecorderFrameTimestamp(
+      timestamp_us + 84000000LL, timestamp_us, nominal_step_us);
+  assert(rebased == timestamp_us + nominal_step_us);
+}
