@@ -0,0 +1,41 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+
+class RecorderGenerationTracker {
+public:
+  bool observe(bool active, uint64_t generation) {
+    if (!active || generation == 0) {
+      seen_generation_ = 0;
+      return false;
+    }
+    if (generation == seen_generation_) return false;
+    seen_generation_ = generation;
+    return true;
+  }
+
+  uint64_t generation() const { return seen_generation_; }
+
+private:
+  uint64_t seen_generation_{0};
+};
+
+inline int64_t normalizeRecorderFrameTimestamp(int64_t candidate_us,
+                                               int64_t previous_us,
+                                               int64_t nominal_step_us) {
+  nominal_step_us = std::max<int64_t>(nominal_step_us, 1000);
+  if (previous_us <= 0) {
+    return candidate_us > 0 ? candidate_us : nominal_step_us;
+  }
+  if (candidate_us <= previous_us) return previous_us + nominal_step_us;
+
+  // Preserve real low-FPS and load gaps. Collapse only a clear encoder clock
+  // domain jump so it cannot stretch one MP4 segment by minutes or hours.
+  const int64_t discontinuity_us =
+      std::max<int64_t>(5000000LL, nominal_step_us * 100);
+  if (candidate_us - previous_us > discontinuity_us) {
+    return previous_us + nominal_step_us;
+  }
+  return candidate_us;
+}

