+static void test_recorder_generation_resets_without_inactive_gap() {
+  RecorderGenerationTracker tracker;
+  assert(tracker.observe(true, 1));
+  assert(tracker.generation() == 1);
+  assert(!tracker.observe(true, 1));
+  // Loop rotation can stop and start entirely between two worker samples.
