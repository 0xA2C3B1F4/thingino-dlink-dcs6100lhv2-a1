diff --git a/src/JpegFramePolicy.hpp b/src/JpegFramePolicy.hpp
new file mode 100644
index 0000000..ab3dd85
--- /dev/null
+++ b/src/JpegFramePolicy.hpp
@@ -0,0 +1,86 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+struct JpegFrameInfo {
+  std::uint16_t width{0};
+  std::uint16_t height{0};
+};
+
+constexpr std::size_t kMaxJpegFrameBytes = 8U * 1024U * 1024U;
+
+inline bool isJpegStartOfFrameMarker(std::uint8_t marker) {
+  return (marker >= 0xc0U && marker <= 0xc3U) ||
+         (marker >= 0xc5U && marker <= 0xc7U) ||
+         (marker >= 0xc9U && marker <= 0xcbU) ||
+         (marker >= 0xcdU && marker <= 0xcfU);
+}
+
+// Validate the framing emitted by the JPEG encoder before publishing it to
+// HTTP/IPC consumers. Entropy-coded scan data is opaque here; the encoder owns
+// JPEG decoding correctness, while this policy rejects truncated buffers,
+// malformed marker lengths, missing dimensions, and cross-channel frames.
+inline bool inspectJpegFrame(const unsigned char *data, std::size_t size,
+                             JpegFrameInfo &info) {
+  info = {};
+  if (!data || size < 8U || size > kMaxJpegFrameBytes || data[0] != 0xffU ||
+      data[1] != 0xd8U || data[size - 2U] != 0xffU ||
+      data[size - 1U] != 0xd9U) {
+    return false;
+  }
+
+  bool have_dimensions = false;
+  std::size_t offset = 2U;
+  while (offset + 1U < size) {
+    if (data[offset] != 0xffU)
+      return false;
+    while (offset < size && data[offset] == 0xffU)
+      ++offset;
+    if (offset >= size)
+      return false;
+
+    const std::uint8_t marker = data[offset++];
+    if (marker == 0xd9U)
+      return have_dimensions && offset == size;
+    if (marker == 0xd8U || marker == 0x00U)
+      return false;
+    if (marker == 0x01U || (marker >= 0xd0U && marker <= 0xd7U))
+      continue;
+    if (offset + 2U > size)
+      return false;
+
+    const std::size_t segment_size =
+        (static_cast<std::size_t>(data[offset]) << 8U) |
+        static_cast<std::size_t>(data[offset + 1U]);
+    if (segment_size < 2U || segment_size > size - offset)
+      return false;
+
+    if (isJpegStartOfFrameMarker(marker)) {
+      if (segment_size < 8U || have_dimensions)
+        return false;
+      info.height = static_cast<std::uint16_t>(
+          (static_cast<std::uint16_t>(data[offset + 3U]) << 8U) |
+          static_cast<std::uint16_t>(data[offset + 4U]));
+      info.width = static_cast<std::uint16_t>(
+          (static_cast<std::uint16_t>(data[offset + 5U]) << 8U) |
+          static_cast<std::uint16_t>(data[offset + 6U]));
+      have_dimensions = info.width != 0U && info.height != 0U;
+      if (!have_dimensions)
+        return false;
+    }
+
+    offset += segment_size;
+    if (marker == 0xdaU)
+      return have_dimensions;
+  }
+  return false;
+}
+
+inline bool jpegFrameMatches(const unsigned char *data, std::size_t size,
+                             unsigned expected_width,
+                             unsigned expected_height) {
+  JpegFrameInfo info;
+  return inspectJpegFrame(data, size, info) && info.width == expected_width &&
+         info.height == expected_height;
+}
