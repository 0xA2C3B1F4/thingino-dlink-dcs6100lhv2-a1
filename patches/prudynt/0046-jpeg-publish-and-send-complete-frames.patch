+static std::vector<unsigned char> minimal_jpeg(std::uint16_t width,
+                                               std::uint16_t height) {
+  return {
+      0xff, 0xd8,
+      0xff, 0xc0, 0x00, 0x0b, 0x08,
+      static_cast<unsigned char>(height >> 8),
+      static_cast<unsigned char>(height & 0xff),
+      static_cast<unsigned char>(width >> 8),
+      static_cast<unsigned char>(width & 0xff),
+      0x01, 0x01, 0x11, 0x00,
+      0xff, 0xda, 0x00, 0x08, 0x01, 0x01, 0x00, 0x00, 0x3f, 0x00,
+      0x00, 0xff, 0xd9,
+  };
+}
+
+static void test_jpeg_frame_policy_rejects_partial_and_wrong_frames() {
+  auto frame = minimal_jpeg(1920, 1080);
+  JpegFrameInfo info;
+  assert(inspectJpegFrame(frame.data(), frame.size(), info));
+  assert(info.width == 1920);
+  assert(info.height == 1080);
+  assert(jpegFrameMatches(frame.data(), frame.size(), 1920, 1080));
+  assert(!jpegFrameMatches(frame.data(), frame.size(), 640, 360));
+
+  auto missing_eoi = frame;
+  missing_eoi.resize(missing_eoi.size() - 2);
+  assert(!jpegFrameMatches(missing_eoi.data(), missing_eoi.size(), 1920,
+                           1080));
+
+  auto malformed_segment = frame;
+  malformed_segment[4] = 0x7f;
+  malformed_segment[5] = 0xff;
+  assert(!jpegFrameMatches(malformed_segment.data(), malformed_segment.size(),
+                           1920, 1080));
+}
