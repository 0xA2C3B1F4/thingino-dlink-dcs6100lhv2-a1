+bool createPrivacyCover(int ch) {
+  std::lock_guard<std::mutex> hardware_lock(global_osd_hardware_mutex);
+  auto &vs = global_video[ch];
+  if (!vs || !privacyChannelRequired(ch) ||
+      !vs->osd_ready.load(std::memory_order_acquire)) {
+    return false;
+  }
+  if (vs->privacy_osd_handle >= 0) return true;
+
+  int sw = vs->stream ? vs->stream->width : 1920;
+  int sh = vs->stream ? vs->stream->height : 1080;
+  if (sw <= 0) sw = 1920;
+  if (sh <= 0) sh = 1080;
+
+  int encGrp = vs->encChn;
+  IMPOSDRgnAttr rgnAttr{};
+  rgnAttr.type = OSD_REG_COVER;
+  rgnAttr.rect.p0.x = 0;
+  rgnAttr.rect.p0.y = 0;
+  rgnAttr.rect.p1.x = sw - 1;
+  rgnAttr.rect.p1.y = sh - 1;
+#if defined(PLATFORM_T31) || defined(PLATFORM_T40) || defined(PLATFORM_T41) || \
+    defined(PLATFORM_T23) || defined(PLATFORM_T32) || defined(PLATFORM_T33) || \
+    defined(PLATFORM_C100)
+  rgnAttr.fmt = PIX_FMT_BGRA;
+#else
+  rgnAttr.fmt = PIX_FMT_MONOWHITE;
+#endif
+  rgnAttr.data.coverData.color = hal::osd::black_cover_color();
+
+  IMPRgnHandle handle = IMP_OSD_CreateRgn(&rgnAttr);
+  if (handle == INVHANDLE) {
+    LOG_ERROR("VideoPrivacyControl: IMP_OSD_CreateRgn failed for ch" << ch);
+    return false;
+  }
+
+  IMPOSDGrpRgnAttr grpAttr{};
+  grpAttr.show = 1;
+  grpAttr.layer = 1;
+  int ret = IMP_OSD_RegisterRgn(handle, encGrp, &grpAttr);
+  if (ret != 0) {
+    LOG_ERROR("VideoPrivacyControl: IMP_OSD_RegisterRgn failed for ch"
+              << ch << " ret=" << ret);
+    IMP_OSD_DestroyRgn(handle);
+    return false;
+  }
+  ret = IMP_OSD_SetGrpRgnAttr(handle, encGrp, &grpAttr);
+  if (ret != 0) {
+    LOG_ERROR("VideoPrivacyControl: IMP_OSD_SetGrpRgnAttr failed for ch"
+              << ch << " ret=" << ret);
+    if (IMP_OSD_UnRegisterRgn(handle, encGrp) != 0) {
+      vs->privacy_osd_handle = static_cast<int>(handle);
+      vs->privacy_requested.store(true, std::memory_order_release);
+      (void)write_privacy_state_file();
+      return false;
+    }
+    IMP_OSD_DestroyRgn(handle);
+    return false;
+  }
+  ret = IMP_OSD_Start(encGrp);
+  if (ret != 0) {
+    LOG_ERROR("VideoPrivacyControl: IMP_OSD_Start(" << encGrp
+              << ") failed ret=" << ret);
+    if (IMP_OSD_UnRegisterRgn(handle, encGrp) != 0) {
+      vs->privacy_osd_handle = static_cast<int>(handle);
+      vs->privacy_requested.store(true, std::memory_order_release);
+      (void)write_privacy_state_file();
+      return false;
+    }
+    IMP_OSD_DestroyRgn(handle);
+    return false;
+  }
+
+  vs->privacy_osd_handle = static_cast<int>(handle);
+  LOG_INFO("VideoPrivacyControl: OSD cover enabled on ch" << ch << " ("
+           << sw << "x" << sh << ")");
+  return true;
+}
