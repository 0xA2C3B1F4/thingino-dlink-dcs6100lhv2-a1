diff --git a/tests/fake_rss_ipc.c b/tests/fake_rss_ipc.c
new file mode 100644
index 0000000..cd7cabc
--- /dev/null
+++ b/tests/fake_rss_ipc.c
@@ -0,0 +1,62 @@
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+struct fake_ring {
+  uint32_t readers;
+  int idr;
+  uint32_t stream;
+  uint32_t last_length;
+  int64_t last_timestamp;
+  uint8_t last_key;
+};
+
+static struct fake_ring rings[2];
+
+void *rss_ring_create(const char *name, uint32_t slots, uint32_t bytes) {
+  int index = strcmp(name, "main") == 0 ? 0 : strcmp(name, "sub") == 0 ? 1 : -1;
+  uint32_t expected = index == 0 ? 2U * 1024U * 1024U : 512U * 1024U;
+  if (index < 0 || slots != 32 || bytes != expected)
+    return NULL;
+  memset(&rings[index], 0, sizeof(rings[index]));
+  rings[index].readers = 1;
+  return &rings[index];
+}
+
+void rss_ring_destroy(void *value) { (void)value; }
+
+void rss_ring_set_stream_info(void *value, uint32_t stream, uint32_t codec,
+                              uint32_t width, uint32_t height, uint32_t fps_num,
+                              uint32_t fps_den, uint8_t profile, uint8_t level) {
+  struct fake_ring *ring = value;
+  ring->stream = stream;
+  (void)codec; (void)width; (void)height;
+  (void)fps_num; (void)fps_den; (void)profile; (void)level;
+}
+
+int rss_ring_publish(void *value, const uint8_t *data, uint32_t length,
+                     int64_t timestamp, uint16_t nal_type, uint8_t key) {
+  struct fake_ring *ring = value;
+  (void)data; (void)nal_type;
+  ring->last_length = length;
+  ring->last_timestamp = timestamp;
+  ring->last_key = key;
+  return 0;
+}
+
+int rss_ring_check_idr(void *value) {
+  struct fake_ring *r = value;
+  int result = r->idr;
+  r->idr = 0;
+  return result;
+}
+
+uint32_t rss_ring_reader_count(void *value) {
+  return ((struct fake_ring *)value)->readers;
+}
+
+void fake_rss_request_idr(uint32_t stream) { rings[stream].idr = 1; }
+uint32_t fake_rss_stream(uint32_t stream) { return rings[stream].stream; }
+uint32_t fake_rss_last_length(uint32_t stream) { return rings[stream].last_length; }
+int64_t fake_rss_last_timestamp(uint32_t stream) { return rings[stream].last_timestamp; }
+uint8_t fake_rss_last_key(uint32_t stream) { return rings[stream].last_key; }
diff --git a/tests/test_raptor_ring_publisher.cpp b/tests/test_raptor_ring_publisher.cpp
new file mode 100644
index 0000000..faf5b7d
--- /dev/null
+++ b/tests/test_raptor_ring_publisher.cpp
@@ -0,0 +1,57 @@
+#include "RaptorRingPublisher.hpp"
+
+#include <cassert>
+#include <cstdint>
+#include <cstdlib>
+#include <dlfcn.h>
+
+template <typename T> static T load(void *handle, const char *name) {
+  T value = reinterpret_cast<T>(dlsym(handle, name));
+  assert(value);
+  return value;
+}
+
+int main(int argc, char **argv) {
+  assert(argc == 2);
+  assert(setenv("PRUDYNT_RAPTOR_RING", "1", 1) == 0);
+  assert(setenv("PRUDYNT_RAPTOR_IPC_LIBRARY", argv[1], 1) == 0);
+  void *fake = dlopen(argv[1], RTLD_NOW | RTLD_LOCAL);
+  assert(fake);
+
+  auto request_idr = load<void (*)(uint32_t)>(fake, "fake_rss_request_idr");
+  auto stream_id = load<uint32_t (*)(uint32_t)>(fake, "fake_rss_stream");
+  auto last_length = load<uint32_t (*)(uint32_t)>(fake, "fake_rss_last_length");
+  auto last_timestamp =
+      load<int64_t (*)(uint32_t)>(fake, "fake_rss_last_timestamp");
+  auto last_key = load<uint8_t (*)(uint32_t)>(fake, "fake_rss_last_key");
+
+  {
+    RaptorRingPublisher publisher(0, 1920, 1080, 15);
+    RaptorRingPublisher sub(1, 640, 360, 15);
+    RaptorRingPublisher unsupported(2, 320, 180, 15);
+    assert(publisher.enabled());
+    assert(sub.enabled());
+    assert(!unsupported.enabled());
+    assert(publisher.hasReaders());
+    assert(sub.hasReaders());
+    const uint8_t annex_b[] = {0, 0, 0, 1, 0x65, 1, 2, 3};
+    const uint8_t sub_annex_b[] = {0, 0, 0, 1, 0x41, 4, 5};
+    assert(publisher.publish(annex_b, sizeof(annex_b), 1234567, true));
+    assert(sub.publish(sub_annex_b, sizeof(sub_annex_b), 2234567, false));
+    assert(stream_id(0) == 0);
+    assert(stream_id(1) == 1);
+    assert(last_length(0) == sizeof(annex_b));
+    assert(last_timestamp(0) == 1234567);
+    assert(last_key(0) == 1);
+    assert(last_length(1) == sizeof(sub_annex_b));
+    assert(last_timestamp(1) == 2234567);
+    assert(last_key(1) == 0);
+    request_idr(1);
+    assert(sub.takeIdrRequest());
+    assert(!sub.takeIdrRequest());
+    assert(!publisher.takeIdrRequest());
+  }
+
+  dlclose(fake);
+  return 0;
+}
