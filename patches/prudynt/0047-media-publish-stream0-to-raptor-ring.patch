diff --git a/src/RaptorRingPublisher.hpp b/src/RaptorRingPublisher.hpp
new file mode 100644
index 0000000..aa78a9d
--- /dev/null
+++ b/src/RaptorRingPublisher.hpp
@@ -0,0 +1,106 @@
+#pragma once
+
+#include <cstdint>
+#include <cstdlib>
+#include <dlfcn.h>
+
+class RaptorRingPublisher {
+public:
+  RaptorRingPublisher(int channel, int width, int height, int fps)
+      : channel_(channel) {
+    const char *enabled = std::getenv("PRUDYNT_RAPTOR_RING");
+    if ((channel != 0 && channel != 1) || !enabled || enabled[0] != '1' ||
+        enabled[1] != '\0')
+      return;
+
+    const char *library = std::getenv("PRUDYNT_RAPTOR_IPC_LIBRARY");
+    if (!library || !library[0])
+      library = "librss_ipc.so";
+    library_ = dlopen(library, RTLD_NOW | RTLD_LOCAL);
+    if (!library_)
+      return;
+
+    create_ = symbol<CreateFn>("rss_ring_create");
+    destroy_ = symbol<DestroyFn>("rss_ring_destroy");
+    set_info_ = symbol<SetInfoFn>("rss_ring_set_stream_info");
+    publish_ = symbol<PublishFn>("rss_ring_publish");
+    check_idr_ = symbol<CheckIdrFn>("rss_ring_check_idr");
+    reader_count_ = symbol<ReaderCountFn>("rss_ring_reader_count");
+    if (!create_ || !destroy_ || !set_info_ || !publish_ || !check_idr_ ||
+        !reader_count_) {
+      closeLibrary();
+      return;
+    }
+
+    const char *ring_name = channel == 0 ? "main" : "sub";
+    const uint32_t ring_bytes =
+        channel == 0 ? 2U * 1024U * 1024U : 512U * 1024U;
+    ring_ = create_(ring_name, 32, ring_bytes);
+    if (!ring_) {
+      closeLibrary();
+      return;
+    }
+    set_info_(ring_, static_cast<uint32_t>(channel), 0,
+              static_cast<uint32_t>(width),
+              static_cast<uint32_t>(height), static_cast<uint32_t>(fps), 1,
+              100, 41);
+  }
+
+  RaptorRingPublisher(const RaptorRingPublisher &) = delete;
+  RaptorRingPublisher &operator=(const RaptorRingPublisher &) = delete;
+
+  ~RaptorRingPublisher() {
+    if (ring_ && destroy_)
+      destroy_(ring_);
+    ring_ = nullptr;
+    closeLibrary();
+  }
+
+  bool enabled() const { return ring_ != nullptr; }
+
+  bool hasReaders() const {
+    return ring_ && reader_count_ && reader_count_(ring_) > 0;
+  }
+
+  bool takeIdrRequest() const {
+    return ring_ && check_idr_ && check_idr_(ring_) == 1;
+  }
+
+  bool publish(const uint8_t *data, uint32_t length, int64_t timestamp_us,
+               bool keyframe) const {
+    return ring_ && publish_ && data && length > 0 &&
+           publish_(ring_, data, length, timestamp_us, 0, keyframe ? 1 : 0) ==
+               0;
+  }
+
+private:
+  struct Ring;
+  using CreateFn = Ring *(*)(const char *, uint32_t, uint32_t);
+  using DestroyFn = void (*)(Ring *);
+  using SetInfoFn = void (*)(Ring *, uint32_t, uint32_t, uint32_t, uint32_t,
+                             uint32_t, uint32_t, uint8_t, uint8_t);
+  using PublishFn = int (*)(Ring *, const uint8_t *, uint32_t, int64_t,
+                            uint16_t, uint8_t);
+  using CheckIdrFn = int (*)(Ring *);
+  using ReaderCountFn = uint32_t (*)(Ring *);
+
+  template <typename T> T symbol(const char *name) {
+    return reinterpret_cast<T>(dlsym(library_, name));
+  }
+
+  void closeLibrary() {
+    if (library_)
+      dlclose(library_);
+    library_ = nullptr;
+  }
+
+  int channel_{-1};
+  void *library_{nullptr};
+  Ring *ring_{nullptr};
+  CreateFn create_{nullptr};
+  DestroyFn destroy_{nullptr};
+  SetInfoFn set_info_{nullptr};
+  PublishFn publish_{nullptr};
+  CheckIdrFn check_idr_{nullptr};
+  ReaderCountFn reader_count_{nullptr};
+};
