+static void test_http_client_admission_is_bounded_and_reusable() {
+  HTTPClientAdmission admission;
+  for (unsigned index = 0; index < HTTPClientAdmission::limit; ++index)
+    assert(admission.tryAcquire());
+  assert(admission.active() == HTTPClientAdmission::limit);
+  assert(!admission.tryAcquire());
+
+  admission.release();
+  assert(admission.active() == HTTPClientAdmission::limit - 1);
+  assert(admission.tryAcquire());
+  assert(admission.active() == HTTPClientAdmission::limit);
+
+  for (unsigned index = 0; index < HTTPClientAdmission::limit; ++index)
+    admission.release();
+  assert(admission.active() == 0);
+  assert(HTTPClientAdmission::stack_size == 256U * 1024U);
+}
