+      ::close(cfd);
+    }
+  }
+}
+
+bool HTTPMJPEG::start_client_thread(int cfd) {
+  if (!client_threads_.tryAcquire())
+    return false;
+
+  std::unique_ptr<ClientThreadContext> context(
+      new (std::nothrow) ClientThreadContext{this, cfd});
+  if (!context) {
+    client_threads_.release();
+    return false;
+  }
+
+  pthread_attr_t attributes;
+  int error = pthread_attr_init(&attributes);
+  const bool attributes_initialized = error == 0;
+  if (error == 0)
+    error = pthread_attr_setdetachstate(&attributes, PTHREAD_CREATE_DETACHED);
+  if (error == 0)
+    error = pthread_attr_setstacksize(&attributes,
+                                     HTTPClientAdmission::stack_size);
+
+  pthread_t thread;
+  if (error == 0) {
+    error = pthread_create(&thread, &attributes,
+                           &HTTPMJPEG::client_thread_entry, context.get());
+  }
+  if (error == 0)
+    context.release();
+  if (attributes_initialized && pthread_attr_destroy(&attributes) != 0 &&
+      error == 0)
+    LOG_WARN("HTTPMJPEG: pthread attributes could not be destroyed");
+  if (error != 0) {
+    client_threads_.release();
+    LOG_WARN("HTTPMJPEG: pthread_create failed: " << strerror(error));
+    return false;
+  }
+  return true;
+}
+
+void *HTTPMJPEG::client_thread_entry(void *raw_context) {
+  std::unique_ptr<ClientThreadContext> context(
+      static_cast<ClientThreadContext *>(raw_context));
+  HTTPMJPEG *owner = context->owner;
+  const int fd = context->fd;
+  struct AdmissionRelease {
+    HTTPClientAdmission &admission;
+    ~AdmissionRelease() { admission.release(); }
+  } release{owner->client_threads_};
+
+  try {
+    owner->handle_client(fd);
+  } catch (const std::exception &error) {
+    LOG_ERROR("HTTPMJPEG: client handler failed: " << error.what());
+    ::shutdown(fd, SHUT_RDWR);
+    ::close(fd);
+  } catch (...) {
+    LOG_ERROR("HTTPMJPEG: client handler failed with an unknown exception");
+    ::shutdown(fd, SHUT_RDWR);
+    ::close(fd);
   }
+  return nullptr;
 }
 
 void HTTPMJPEG::handle_client(int cfd) {
