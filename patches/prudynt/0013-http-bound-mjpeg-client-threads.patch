new file mode 100644
index 0000000..6197df4
--- /dev/null
+++ b/src/HTTPClientAdmission.hpp
@@ -0,0 +1,30 @@
+#pragma once
+
+#include <atomic>
+
+class HTTPClientAdmission {
+public:
+  static constexpr unsigned limit = 8;
+  static constexpr unsigned stack_size = 256U * 1024U;
+
+  bool tryAcquire() {
+    unsigned active = active_.load(std::memory_order_relaxed);
+    while (active < limit) {
+      if (active_.compare_exchange_weak(active, active + 1,
+                                        std::memory_order_acquire,
+                                        std::memory_order_relaxed)) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  void release() { active_.fetch_sub(1, std::memory_order_release); }
+
+  unsigned active() const {
+    return active_.load(std::memory_order_acquire);
+  }
+
+private:
+  std::atomic<unsigned> active_{0};
+};
