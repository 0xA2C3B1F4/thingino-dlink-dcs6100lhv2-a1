diff --git a/src/WorkerUtils.hpp b/src/WorkerUtils.hpp
index 80d4055..0febb96 100644
--- a/src/WorkerUtils.hpp
+++ b/src/WorkerUtils.hpp
@@ -9,6 +9,16 @@ struct StartHelper {
   int encChn;
   binary_semaphore_compat has_started{0};
   std::atomic<bool> success{false};
+  std::atomic<bool> reported{false};
+
+  void report(bool started_successfully) {
+    success.store(started_successfully, std::memory_order_release);
+    bool expected = false;
+    if (reported.compare_exchange_strong(expected, true,
+                                         std::memory_order_acq_rel)) {
+      has_started.release();
+    }
+  }
 };
 
