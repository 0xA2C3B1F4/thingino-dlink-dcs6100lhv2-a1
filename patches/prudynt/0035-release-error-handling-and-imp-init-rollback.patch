diff --git a/src/IMPSystemLifecycle.hpp b/src/IMPSystemLifecycle.hpp
new file mode 100644
index 0000000..f83e844
--- /dev/null
+++ b/src/IMPSystemLifecycle.hpp
@@ -0,0 +1,51 @@
+#pragma once
+
+#include <array>
+#include <cstddef>
+
+enum class IMPSystemStage : std::size_t {
+  IspOpen = 0,
+  SensorAdded,
+  SensorEnabled,
+  SystemInitialized,
+  TuningEnabled,
+  Count,
+};
+
+class IMPSystemLifecycle {
+public:
+  void mark(IMPSystemStage stage) noexcept {
+    active_[static_cast<std::size_t>(stage)] = true;
+  }
+
+  bool active(IMPSystemStage stage) const noexcept {
+    return active_[static_cast<std::size_t>(stage)];
+  }
+
+  bool empty() const noexcept {
+    for (bool stage_active : active_) {
+      if (stage_active) return false;
+    }
+    return true;
+  }
+
+  template <typename StopStage> int teardown(StopStage &&stop_stage) {
+    int first_failure = 0;
+    for (std::size_t index = active_.size(); index > 0; --index) {
+      const std::size_t stage_index = index - 1;
+      if (!active_[stage_index]) continue;
+
+      const int ret = stop_stage(static_cast<IMPSystemStage>(stage_index));
+      if (ret != 0 && first_failure == 0) first_failure = ret;
+
+      // Teardown is best effort and single pass. Later vendor operations may
+      // invalidate an earlier stage even if its explicit stop returned an
+      // error, so never retry a stale state transition from a destructor.
+      active_[stage_index] = false;
+    }
+    return first_failure;
+  }
+
+private:
+  std::array<bool, static_cast<std::size_t>(IMPSystemStage::Count)> active_{};
+};
