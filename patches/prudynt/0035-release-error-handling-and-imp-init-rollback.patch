diff --git a/tests/test_release_error_handling.cpp b/tests/test_release_error_handling.cpp
new file mode 100644
index 0000000..33c1370
--- /dev/null
+++ b/tests/test_release_error_handling.cpp
@@ -0,0 +1,92 @@
+#include "IMPSystemLifecycle.hpp"
+#include "Logger.hpp"
+
+#include <cassert>
+#include <string>
+#include <vector>
+
+namespace {
+std::vector<Logger::Level> logged_levels;
+int condition_evaluations = 0;
+
+int evaluated(int value) {
+  ++condition_evaluations;
+  return value;
+}
+
+int fatal_operation(int value) {
+  LOG_DEBUG_OR_ERROR_AND_EXIT(evaluated(value), "fatal operation");
+  return 0;
+}
+} // namespace
+
+Logger::Level Logger::level = Logger::INFO;
+std::mutex Logger::log_mtx;
+
+void Logger::log(Level level, std::string, LogMsg) {
+  logged_levels.push_back(level);
+}
+
+int main() {
+  // This test intentionally compiles without ENABLE_LOG_DEBUG: errors and
+  // fail-closed returns must still be present in the production configuration.
+  condition_evaluations = 0;
+  logged_levels.clear();
+  LOG_DEBUG_OR_ERROR(evaluated(0), "successful operation");
+  assert(condition_evaluations == 1);
+  assert(logged_levels.empty());
+
+  LOG_DEBUG_OR_ERROR(evaluated(-3), "failed operation");
+  assert(condition_evaluations == 2);
+  assert(logged_levels.size() == 1);
+  assert(logged_levels.back() == Logger::ERROR);
+
+  assert(fatal_operation(0) == 0);
+  assert(fatal_operation(-7) == -7);
+  assert(condition_evaluations == 4);
+  assert(logged_levels.size() == 2);
+  assert(logged_levels.back() == Logger::ERROR);
+
+  IMPSystemLifecycle lifecycle;
+  lifecycle.mark(IMPSystemStage::IspOpen);
+  lifecycle.mark(IMPSystemStage::SensorAdded);
+  lifecycle.mark(IMPSystemStage::SensorEnabled);
+  lifecycle.mark(IMPSystemStage::SystemInitialized);
+  lifecycle.mark(IMPSystemStage::TuningEnabled);
+
+  std::vector<IMPSystemStage> order;
+  const int cleanup_ret = lifecycle.teardown([&](IMPSystemStage stage) {
+    order.push_back(stage);
+    return stage == IMPSystemStage::SystemInitialized ? -11 : 0;
+  });
+  assert(cleanup_ret == -11);
+  assert((order == std::vector<IMPSystemStage>{
+                       IMPSystemStage::TuningEnabled,
+                       IMPSystemStage::SystemInitialized,
+                       IMPSystemStage::SensorEnabled,
+                       IMPSystemStage::SensorAdded,
+                       IMPSystemStage::IspOpen}));
+  assert(lifecycle.empty());
+
+  // Every partial initialization prefix tears down only completed stages and
+  // always in reverse order.
+  constexpr std::size_t stage_count =
+      static_cast<std::size_t>(IMPSystemStage::Count);
+  for (std::size_t completed = 0; completed <= stage_count; ++completed) {
+    IMPSystemLifecycle partial;
+    for (std::size_t index = 0; index < completed; ++index) {
+      partial.mark(static_cast<IMPSystemStage>(index));
+    }
+    order.clear();
+    assert(partial.teardown([&](IMPSystemStage stage) {
+             order.push_back(stage);
+             return 0;
+           }) == 0);
+    assert(order.size() == completed);
+    for (std::size_t index = 0; index < completed; ++index) {
+      assert(order[index] ==
+             static_cast<IMPSystemStage>(completed - index - 1));
+    }
+    assert(partial.empty());
+  }
+}
