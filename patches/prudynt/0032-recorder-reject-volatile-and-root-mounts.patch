diff --git a/src/RecorderMountPolicy.hpp b/src/RecorderMountPolicy.hpp
new file mode 100644
index 0000000..9ec8152
--- /dev/null
+++ b/src/RecorderMountPolicy.hpp
@@ -0,0 +1,27 @@
+#pragma once
+
+#include <string_view>
+
+inline bool recorderMountPathAllowed(std::string_view mount_point) {
+  constexpr std::string_view mnt = "/mnt";
+  constexpr std::string_view media = "/media";
+  return mount_point == mnt || mount_point == media ||
+         (mount_point.size() > mnt.size() &&
+          mount_point.compare(0, mnt.size(), mnt) == 0 &&
+          mount_point[mnt.size()] == '/') ||
+         (mount_point.size() > media.size() &&
+          mount_point.compare(0, media.size(), media) == 0 &&
+          mount_point[media.size()] == '/');
+}
+
+inline bool recorderMountFilesystemAllowed(std::string_view fs_type) {
+  return fs_type == "vfat" || fs_type == "exfat" || fs_type == "ext2" ||
+         fs_type == "ext3" || fs_type == "ext4" || fs_type == "f2fs" ||
+         fs_type == "nfs" || fs_type == "nfs4" || fs_type == "cifs";
+}
+
+inline bool recorderMountAllowed(std::string_view mount_point,
+                                 std::string_view fs_type, bool read_write) {
+  return read_write && recorderMountPathAllowed(mount_point) &&
+         recorderMountFilesystemAllowed(fs_type);
+}
