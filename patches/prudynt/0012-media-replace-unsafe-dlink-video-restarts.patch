+#if defined(DCS_DLINK_MEDIA_READY)
+[[noreturn]] void replace_dlink_media_process(int argc, const char *argv[]) {
+  std::vector<char *> exec_argv;
+  exec_argv.reserve(static_cast<size_t>(argc) + 1);
+  for (int i = 0; i < argc; ++i) {
+    exec_argv.push_back(const_cast<char *>(argv[i]));
+  }
+  exec_argv.push_back(nullptr);
+
+  // JsonAPI publishes restart flags before its local response is flushed.
+  // Control reads that small response on loopback, so a bounded deferral keeps
+  // the successful request intact before exec replaces all worker threads.
+  std::this_thread::sleep_for(std::chrono::milliseconds(250));
+
+  long open_max = sysconf(_SC_OPEN_MAX);
+  if (open_max < 0 || open_max > 65536) {
+    open_max = 1024;
+  }
+  for (int fd = STDERR_FILENO + 1; fd < open_max; ++fd) {
+    int flags = fcntl(fd, F_GETFD);
+    if (flags >= 0) {
+      (void)fcntl(fd, F_SETFD, flags | FD_CLOEXEC);
+    }
+  }
+
+  LOG_INFO("D-Link media restart: replacing process without SDK teardown");
+  execv("/proc/self/exe", exec_argv.data());
+  LOG_ERROR("D-Link media restart: execv failed: " << strerror(errno));
+  _exit(127);
+}
+#endif
