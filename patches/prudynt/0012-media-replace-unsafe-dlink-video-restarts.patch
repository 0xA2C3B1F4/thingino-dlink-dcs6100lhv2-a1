diff --git a/src/DLinkMediaProcessPolicy.hpp b/src/DLinkMediaProcessPolicy.hpp
new file mode 100644
index 0000000..73d47ac
--- /dev/null
+++ b/src/DLinkMediaProcessPolicy.hpp
@@ -0,0 +1,18 @@
+#ifndef DLINK_MEDIA_PROCESS_POLICY_HPP
+#define DLINK_MEDIA_PROCESS_POLICY_HPP
+
+enum class DLinkMediaProcessAction { Continue, Replace, Exit };
+
+inline constexpr DLinkMediaProcessAction
+dlinkMediaProcessAction(bool shutting_down, bool restart_video,
+                        bool restart_audio) {
+  if (shutting_down) {
+    return DLinkMediaProcessAction::Exit;
+  }
+  if (restart_video || restart_audio) {
+    return DLinkMediaProcessAction::Replace;
+  }
+  return DLinkMediaProcessAction::Continue;
+}
+
+#endif // DLINK_MEDIA_PROCESS_POLICY_HPP
