new file mode 100644
index 0000000..515fb73
--- /dev/null
+++ b/src/StreamRuntimePolicy.hpp
@@ -0,0 +1,22 @@
+#ifndef STREAM_RUNTIME_POLICY_HPP
+#define STREAM_RUNTIME_POLICY_HPP
+
+#include <algorithm>
+
+inline int normalizeVideoFps(int configured_fps, int sensor_min_fps,
+                             int sensor_max_fps) {
+  if (sensor_max_fps <= 0) {
+    return configured_fps;
+  }
+
+  int normalized = configured_fps;
+  if (normalized <= 0 || normalized > sensor_max_fps) {
+    normalized = sensor_max_fps;
+  }
+  if (sensor_min_fps > 0 && normalized < sensor_min_fps) {
+    normalized = std::min(sensor_min_fps, sensor_max_fps);
+  }
+  return normalized;
+}
+
+#endif // STREAM_RUNTIME_POLICY_HPP
