@@ -0,0 +1,42 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+// A per-client video tap may retain at most this many encoded payload bytes.
+// The element limit remains as a second guard against tiny-NAL metadata growth.
+inline constexpr size_t RTSP_VIDEO_TAP_MAX_BYTES = 512 * 1024;
+
+// Tracks queue evictions and blocks inter-frame recovery until a new random
+// access frame arrives. The RTSP layer prepends cached codec configuration when
+// the gate opens again.
+class FrameRecoveryGate {
+public:
+  void reset(uint64_t eviction_count = 0) {
+    observed_evictions_ = eviction_count;
+    waiting_for_random_access_ = false;
+  }
+
+  bool observe(uint64_t eviction_count) {
+    if (eviction_count == observed_evictions_)
+      return false;
+    observed_evictions_ = eviction_count;
+    waiting_for_random_access_ = true;
+    return true;
+  }
+
+  bool accept(bool is_random_access, bool is_frame_start = true) {
+    if (!waiting_for_random_access_)
+      return true;
+    if (!is_random_access || !is_frame_start)
+      return false;
+    waiting_for_random_access_ = false;
+    return true;
+  }
+
+  bool waiting() const { return waiting_for_random_access_; }
+
+private:
+  uint64_t observed_evictions_{0};
+  bool waiting_for_random_access_{false};
+};
