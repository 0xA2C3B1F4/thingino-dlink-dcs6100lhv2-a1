diff --git a/tests/run_host_tests.sh b/tests/run_host_tests.sh
new file mode 100755
index 0000000..b525e7c
--- /dev/null
+++ b/tests/run_host_tests.sh
@@ -0,0 +1,12 @@
+#!/bin/sh
+set -eu
+
+: "${TMPDIR:?TMPDIR must point to writable temporary storage}"
+
+repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
+test_bin=$(mktemp "${TMPDIR%/}/prudynt-media-queue.XXXXXX")
+trap 'rm -f "$test_bin"' EXIT HUP INT TERM
+
+${CXX:-c++} -std=c++20 -Wall -Wextra -Werror -pthread \
+  -I"$repo_dir/src" "$repo_dir/tests/test_media_queue.cpp" -o "$test_bin"
+"$test_bin"
diff --git a/tests/test_media_queue.cpp b/tests/test_media_queue.cpp
new file mode 100644
index 0000000..fa0a9a1
--- /dev/null
+++ b/tests/test_media_queue.cpp
@@ -0,0 +1,176 @@
+// Build and run with tests/run_host_tests.sh.
+
+#include "FrameRecoveryGate.hpp"
+#include "MsgChannel.hpp"
+#include "SharedPayload.hpp"
+
+#include <cassert>
+#include <cstdint>
+#include <iostream>
+#include <memory>
+#include <set>
+#include <vector>
+
+struct TestNal {
+  SharedPayload data;
+  bool is_frame_start{false};
+  bool is_frame_end{false};
+  bool is_random_access{false};
+  uint32_t frame_id{0};
+};
+
+static TestNal nal(uint32_t frame_id, size_t bytes, bool start, bool end,
+                   bool random_access = false) {
+  std::vector<uint8_t> payload(bytes, static_cast<uint8_t>(frame_id));
+  return TestNal{SharedPayload(std::move(payload)), start, end, random_access,
+                 frame_id};
+}
+
+static void test_shared_payload_fanout() {
+  SharedPayload original(std::vector<uint8_t>(64 * 1024, 0x5a));
+  SharedPayload general = original;
+  SharedPayload tap_a = original;
+  SharedPayload tap_b = original;
+
+  assert(original.storageIdentity() == general.storageIdentity());
+  assert(original.storageIdentity() == tap_a.storageIdentity());
+  assert(original.storageIdentity() == tap_b.storageIdentity());
+  assert(original.useCount() == 4);
+  assert(tap_b[123] == 0x5a);
+}
+
+static void test_exact_byte_boundary() {
+  MsgChannel<TestNal> queue(800, 128);
+  assert(queue.write(nal(1, 64, true, false)));
+  assert(queue.write(nal(1, 64, false, true)));
+  assert(queue.bytes() == 128);
+  assert(queue.evictionCount() == 0);
+
+  assert(!queue.write(nal(2, 64, true, false)));
+  assert(queue.bytes() == 64);
+  assert(queue.evictionCount() == 1);
+  assert(queue.write(nal(2, 64, false, true)));
+  assert(queue.bytes() == 128);
+}
+
+static void test_whole_frame_eviction() {
+  MsgChannel<TestNal> queue(800, 180);
+  for (uint32_t frame = 1; frame <= 8; ++frame) {
+    queue.write(nal(frame, 40, true, false, frame == 1 || frame == 6));
+    queue.write(nal(frame, 40, false, false));
+    queue.write(nal(frame, 40, false, true));
+  }
+
+  assert(queue.bytes() <= 180);
+  assert(queue.evictionCount() > 0);
+
+  std::vector<TestNal> remaining;
+  TestNal item;
+  while (queue.read(&item))
+    remaining.push_back(std::move(item));
+  assert(!remaining.empty());
+
+  std::set<uint32_t> seen;
+  for (const auto &entry : remaining)
+    seen.insert(entry.frame_id);
+  for (uint32_t frame : seen) {
+    bool have_start = false;
+    bool have_end = false;
+    for (const auto &entry : remaining) {
+      if (entry.frame_id != frame)
+        continue;
+      have_start |= entry.is_frame_start;
+      have_end |= entry.is_frame_end;
+    }
+    assert(have_start && have_end);
+  }
+}
+
+static void test_oversized_incomplete_frame_is_discarded() {
+  MsgChannel<TestNal> queue(800, 100);
+  assert(queue.write(nal(1, 60, true, false)));
+  assert(!queue.write(nal(1, 60, false, false)));
+  assert(!queue.write(nal(1, 20, false, true)));
+  assert(queue.size() == 0);
+
+  assert(queue.write(nal(2, 40, true, false, true)));
+  assert(queue.write(nal(2, 40, false, true, true)));
+  assert(queue.size() == 2);
+}
+
+static void test_idr_recovery_after_eviction() {
+  MsgChannel<TestNal> queue(800, 180);
+  FrameRecoveryGate recovery;
+  recovery.reset(queue.evictionCount());
+
+  for (uint32_t frame = 1; frame <= 8; ++frame) {
+    bool idr = frame == 1 || frame == 6;
+    queue.write(nal(frame, 60, true, true, idr));
+  }
+
+  assert(recovery.observe(queue.evictionCount()));
+  std::vector<uint32_t> accepted;
+  TestNal item;
+  while (queue.read(&item)) {
+    if (recovery.accept(item.is_random_access))
+      accepted.push_back(item.frame_id);
+  }
+  assert(!accepted.empty());
+  assert(accepted.front() == 6);
+  assert(!recovery.waiting());
+}
+
+static void test_disconnect_releases_only_its_queue() {
+  SharedPayload payload(std::vector<uint8_t>(32 * 1024, 0x33));
+  auto client_a = std::make_unique<MsgChannel<TestNal>>(800, 64 * 1024);
+  auto client_b = std::make_unique<MsgChannel<TestNal>>(800, 64 * 1024);
+  TestNal frame{payload, true, true, true, 1};
+  assert(client_a->write(frame));
+  assert(client_b->write(frame));
+  assert(payload.useCount() == 4);
+
+  client_a->clear();
+  assert(payload.useCount() == 3);
+  assert(client_b->size() == 1);
+  client_a.reset();
+  assert(client_b->size() == 1);
+  client_b.reset();
+  assert(payload.useCount() == 2);
+}
+
+static void test_parallel_slow_clients_stay_bounded() {
+  MsgChannel<TestNal> client_a(800, RTSP_VIDEO_TAP_MAX_BYTES);
+  MsgChannel<TestNal> client_b(800, RTSP_VIDEO_TAP_MAX_BYTES);
+
+  for (uint32_t frame = 1; frame <= 40; ++frame) {
+    SharedPayload payload(std::vector<uint8_t>(32 * 1024,
+                                               static_cast<uint8_t>(frame)));
+    TestNal item{payload, true, true, frame % 10 == 0, frame};
+    client_a.write(item);
+    client_b.write(item);
+  }
+
+  assert(client_a.bytes() <= RTSP_VIDEO_TAP_MAX_BYTES);
+  assert(client_b.bytes() <= RTSP_VIDEO_TAP_MAX_BYTES);
+  assert(client_a.evictionCount() > 0);
+  assert(client_b.evictionCount() > 0);
+
+  TestNal a;
+  TestNal b;
+  while (client_a.read(&a) && client_b.read(&b)) {
+    assert(a.frame_id == b.frame_id);
+    assert(a.data.storageIdentity() == b.data.storageIdentity());
+  }
+}
+
+int main() {
+  test_shared_payload_fanout();
+  test_exact_byte_boundary();
+  test_whole_frame_eviction();
+  test_oversized_incomplete_frame_is_discarded();
+  test_idr_recovery_after_eviction();
+  test_disconnect_releases_only_its_queue();
+  test_parallel_slow_clients_stay_bounded();
+  std::cout << "media queue host tests passed\n";
+  return 0;
+}
