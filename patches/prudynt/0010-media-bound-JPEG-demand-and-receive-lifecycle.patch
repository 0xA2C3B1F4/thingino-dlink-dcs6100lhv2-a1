new file mode 100644
index 0000000..47b9f9c
--- /dev/null
+++ b/src/EncoderReceivePolicy.hpp
@@ -0,0 +1,47 @@
+#pragma once
+
+struct VideoReceiveDemand {
+  bool callback{false};
+  bool rtsp{false};
+  bool jpeg{false};
+  bool bootstrap{false};
+  bool forced{false};
+  bool prebuffer{false};
+};
+
+inline bool videoReceiveDemandActive(const VideoReceiveDemand &demand) {
+  return demand.callback || demand.rtsp || demand.jpeg || demand.bootstrap ||
+         demand.forced || demand.prebuffer;
+}
+
+// Track an IMP encoder receive state separately from its worker's polling
+// state. A failed transition leaves the known state unchanged.
+class EncoderReceiveLifecycle {
+public:
+  explicit EncoderReceiveLifecycle(bool receiving = true)
+      : receiving_(receiving) {
+  }
+
+  bool receiving() const {
+    return receiving_;
+  }
+
+  bool shouldStop(bool demand_active) const {
+    return receiving_ && !demand_active;
+  }
+
+  bool shouldStart(bool demand_active) const {
+    return !receiving_ && demand_active;
+  }
+
+  void stopped() {
+    receiving_ = false;
+  }
+
+  void started() {
+    receiving_ = true;
+  }
+
+private:
+  bool receiving_;
+};
