+static void test_video_receive_demand_and_transition_policy() {
+  VideoReceiveDemand idle;
+  assert(!videoReceiveDemandActive(idle));
+
+  EncoderReceiveLifecycle lifecycle;
+  assert(lifecycle.receiving());
+  assert(lifecycle.shouldStop(videoReceiveDemandActive(idle)));
+  lifecycle.stopped();
+  assert(!lifecycle.receiving());
+  assert(!lifecycle.shouldStop(videoReceiveDemandActive(idle)));
+
+  VideoReceiveDemand demand;
+  demand.jpeg = true;
+  assert(videoReceiveDemandActive(demand));
+  assert(lifecycle.shouldStart(videoReceiveDemandActive(demand)));
+
+  // A failed Start leaves the lifecycle stopped until the caller records a
+  // successful transition.
+  assert(lifecycle.shouldStart(videoReceiveDemandActive(demand)));
+  lifecycle.started();
+  assert(lifecycle.receiving());
+  assert(!lifecycle.shouldStart(videoReceiveDemandActive(demand)));
+
+  demand = {};
+  demand.rtsp = true;
+  assert(!lifecycle.shouldStop(videoReceiveDemandActive(demand)));
+  demand = {};
+  demand.bootstrap = true;
+  assert(!lifecycle.shouldStop(videoReceiveDemandActive(demand)));
+  demand = {};
+  demand.forced = true;
+  assert(!lifecycle.shouldStop(videoReceiveDemandActive(demand)));
+  demand = {};
+  demand.prebuffer = true;
+  assert(!lifecycle.shouldStop(videoReceiveDemandActive(demand)));
+
+}
