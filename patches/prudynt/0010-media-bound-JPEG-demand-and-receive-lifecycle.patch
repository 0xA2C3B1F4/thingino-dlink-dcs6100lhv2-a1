--- /dev/null
+++ b/src/MJPEGRequestPolicy.hpp
@@ -0,0 +1,8 @@
+#pragma once
+
+// JPEG encoder state is shared by every HTTP client. A request may choose its
+// own send cadence, but it must not resize or retune the shared encoder.
+inline bool mjpegSharedEncoderMutationRequested(int quality, int width,
+                                                int height) {
+  return quality >= 0 || width >= 0 || height >= 0;
+}
diff --git a/src/SocketPeer.hpp b/src/SocketPeer.hpp
new file mode 100644
index 0000000..ccdf0cf
--- /dev/null
+++ b/src/SocketPeer.hpp
@@ -0,0 +1,22 @@
+#pragma once
+
+#include <cerrno>
+#include <sys/socket.h>
+
+// Check for a received FIN/RST without consuming request data or blocking.
+// This lets a streaming producer stop even when it has no payload to write,
+// which is otherwise the only point where a disconnected peer is noticed.
+inline bool socketPeerClosed(int fd) {
+  char byte;
+  for (;;) {
+    ssize_t result =
+        ::recv(fd, &byte, sizeof(byte), MSG_PEEK | MSG_DONTWAIT);
+    if (result > 0)
+      return false;
+    if (result == 0)
+      return true;
+    if (errno == EINTR)
+      continue;
+    return errno != EAGAIN && errno != EWOULDBLOCK;
+  }
+}
