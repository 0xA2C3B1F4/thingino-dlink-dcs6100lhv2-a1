+static void test_socket_peer_disconnect_detection() {
+  int sockets[2] = {-1, -1};
+  assert(socketpair(AF_UNIX, SOCK_STREAM, 0, sockets) == 0);
+  assert(!socketPeerClosed(sockets[0]));
+
+  const char byte = 'x';
+  assert(send(sockets[1], &byte, sizeof(byte), 0) == 1);
+  assert(!socketPeerClosed(sockets[0]));
+  char received = 0;
+  assert(recv(sockets[0], &received, sizeof(received), 0) == 1);
+  assert(received == byte);
+
+  close(sockets[1]);
+  sockets[1] = -1;
+  assert(socketPeerClosed(sockets[0]));
+  close(sockets[0]);
+}
