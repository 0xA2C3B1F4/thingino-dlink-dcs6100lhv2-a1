+static void test_media_metrics_track_jpeg_lifecycle_per_channel() {
+  MediaRuntimeMetrics metrics;
+  metrics.setJpegWorkerRunning(1, true);
+  metrics.setJpegActive(1, true);
+  metrics.setJpegSourceLeased(1, true);
+  metrics.recordJpegReceiveStart(1, true);
+  assert(metrics.jpeg_worker_running[1].load() == 1);
+  assert(metrics.jpeg_active[1].load() == 1);
+  assert(metrics.jpeg_receiving[1].load() == 1);
+  assert(metrics.jpeg_source_leased[1].load() == 1);
+  assert(metrics.jpeg_receive_starts_total[1].load() == 1);
+
+  metrics.recordJpegReceiveStop(1, false);
+  assert(metrics.jpeg_receiving[1].load() == 1);
+  assert(metrics.jpeg_receive_stop_failures_total[1].load() == 1);
+  metrics.recordJpegReceiveStop(1, true);
+  metrics.setJpegSourceLeased(1, false);
+  assert(metrics.jpeg_receiving[1].load() == 0);
+  assert(metrics.jpeg_receive_stops_total[1].load() == 1);
+
+  metrics.recordJpegReceiveStart(1, false);
+  metrics.recordJpegSourceTimeout(1);
+  assert(metrics.jpeg_receive_start_failures_total[1].load() == 1);
+  assert(metrics.jpeg_source_timeouts_total[1].load() == 1);
+
+  metrics.clearJpegRuntimeState(1);
+  assert(metrics.jpeg_worker_running[1].load() == 0);
+  assert(metrics.jpeg_active[1].load() == 0);
+  assert(metrics.jpeg_receiving[1].load() == 0);
+  assert(metrics.jpeg_source_leased[1].load() == 0);
+  assert(metrics.jpeg_worker_running[0].load() == 0);
+}
