diff --git a/src/MotionEventOutput.cpp b/src/MotionEventOutput.cpp
new file mode 100644
index 0000000..f8944f0
--- /dev/null
+++ b/src/MotionEventOutput.cpp
@@ -0,0 +1,131 @@
+#include "MotionEventOutput.hpp"
+
+#include <cerrno>
+#include <cstdio>
+#include <cstring>
+#include <fcntl.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <time.h>
+#include <unistd.h>
+
+namespace {
+constexpr std::size_t kMaxMessageBytes = 512;
+}
+
+MotionEventOutput::MotionEventOutput(std::string socketPath)
+    : socketPath_(std::move(socketPath)) {}
+
+MotionEventOutput::~MotionEventOutput() {
+  if (socketFd_ >= 0) {
+    ::close(socketFd_);
+  }
+}
+
+void MotionEventOutput::startSession(bool initialGrace) {
+  monitoringSinceMs_ = monotonicMilliseconds();
+  initialGrace_ = initialGrace;
+  sequence_ = 0;
+}
+
+std::uint64_t MotionEventOutput::monotonicMilliseconds() {
+  struct timespec now {};
+  if (::clock_gettime(CLOCK_MONOTONIC, &now) != 0) {
+    return 0;
+  }
+  return static_cast<std::uint64_t>(now.tv_sec) * 1000ULL +
+         static_cast<std::uint64_t>(now.tv_nsec / 1000000L);
+}
+
+const char *MotionEventOutput::stateName(MotionObservationState state) {
+  switch (state) {
+  case MotionObservationState::Monitoring:
+    return "monitoring";
+  case MotionObservationState::Detected:
+    return "detected";
+  case MotionObservationState::Clear:
+    return "clear";
+  case MotionObservationState::Suppressed:
+    return "suppressed";
+  case MotionObservationState::Stopped:
+    return "stopped";
+  }
+  return "stopped";
+}
+
+bool MotionEventOutput::ensureSocket() {
+  if (socketFd_ >= 0) {
+    return true;
+  }
+#ifdef SOCK_NONBLOCK
+  socketFd_ = ::socket(AF_UNIX, SOCK_DGRAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+  if (socketFd_ < 0 && (errno == EINVAL || errno == EPROTONOSUPPORT)) {
+    socketFd_ = ::socket(AF_UNIX, SOCK_DGRAM, 0);
+  }
+#else
+  socketFd_ = ::socket(AF_UNIX, SOCK_DGRAM, 0);
+#endif
+  if (socketFd_ < 0) {
+    return false;
+  }
+  int flags = ::fcntl(socketFd_, F_GETFL, 0);
+  int descriptorFlags = ::fcntl(socketFd_, F_GETFD, 0);
+  if (flags < 0 || descriptorFlags < 0 ||
+      ::fcntl(socketFd_, F_SETFL, flags | O_NONBLOCK) != 0 ||
+      ::fcntl(socketFd_, F_SETFD, descriptorFlags | FD_CLOEXEC) != 0) {
+    ::close(socketFd_);
+    socketFd_ = -1;
+    return false;
+  }
+  return true;
+}
+
+MotionEventSendResult MotionEventOutput::send(MotionObservationState state,
+                                               int channel,
+                                               std::uint64_t roiMask) {
+  if (monitoringSinceMs_ == 0) {
+    startSession();
+  }
+  if (socketPath_.empty() || socketPath_.size() >= sizeof(sockaddr_un::sun_path) ||
+      channel < 0 || channel > 1 || !ensureSocket()) {
+    droppedCount_++;
+    return MotionEventSendResult::Dropped;
+  }
+
+  const std::uint64_t nowMs = monotonicMilliseconds();
+  const std::uint64_t nextSequence = sequence_ + 1;
+  char message[kMaxMessageBytes];
+  int length = std::snprintf(
+      message, sizeof(message),
+      "{\"version\":1,\"event\":\"motion\",\"state\":\"%s\",\"channel\":%d,"
+      "\"monotonic_ms\":%llu,\"monitoring_since_ms\":%llu,\"sequence\":%llu,"
+      "\"producer_pid\":%ld,\"roi_mask\":%llu,\"initial_grace\":%s}",
+      stateName(state), channel, static_cast<unsigned long long>(nowMs),
+      static_cast<unsigned long long>(monitoringSinceMs_),
+      static_cast<unsigned long long>(nextSequence), static_cast<long>(::getpid()),
+      static_cast<unsigned long long>(roiMask), initialGrace_ ? "true" : "false");
+  if (length <= 0 || static_cast<std::size_t>(length) >= sizeof(message)) {
+    droppedCount_++;
+    return MotionEventSendResult::Dropped;
+  }
+
+  struct sockaddr_un destination {};
+  destination.sun_family = AF_UNIX;
+  std::memcpy(destination.sun_path, socketPath_.c_str(), socketPath_.size() + 1);
+  ssize_t written = ::sendto(
+      socketFd_, message, static_cast<std::size_t>(length),
+#ifdef MSG_NOSIGNAL
+      MSG_DONTWAIT | MSG_NOSIGNAL,
+#else
+      MSG_DONTWAIT,
+#endif
+      reinterpret_cast<const struct sockaddr *>(&destination),
+      sizeof(destination));
+  if (written != length) {
+    droppedCount_++;
+    return MotionEventSendResult::Dropped;
+  }
+  sequence_ = nextSequence;
+  sentCount_++;
+  return MotionEventSendResult::Sent;
+}
diff --git a/src/MotionEventOutput.hpp b/src/MotionEventOutput.hpp
new file mode 100644
index 0000000..0112e9d
--- /dev/null
+++ b/src/MotionEventOutput.hpp
@@ -0,0 +1,50 @@
+#ifndef MotionEventOutput_hpp
+#define MotionEventOutput_hpp
+
+#include <cstdint>
+#include <string>
+
+enum class MotionObservationState {
+  Monitoring,
+  Detected,
+  Clear,
+  Suppressed,
+  Stopped,
+};
+
+enum class MotionEventSendResult {
+  Sent,
+  Dropped,
+};
+
+class MotionEventOutput {
+public:
+  explicit MotionEventOutput(
+      std::string socketPath = "/run/thingino-control/motion.sock");
+  ~MotionEventOutput();
+
+  MotionEventOutput(const MotionEventOutput &) = delete;
+  MotionEventOutput &operator=(const MotionEventOutput &) = delete;
+
+  void startSession(bool initialGrace = true);
+  MotionEventSendResult send(MotionObservationState state, int channel,
+                             std::uint64_t roiMask);
+
+  std::uint64_t sentCount() const { return sentCount_; }
+  std::uint64_t droppedCount() const { return droppedCount_; }
+
+private:
+  static std::uint64_t monotonicMilliseconds();
+  static const char *stateName(MotionObservationState state);
+  bool ensureSocket();
+
+  std::string socketPath_;
+  int socketFd_{-1};
+  std::uint64_t monitoringSinceMs_{0};
+  bool initialGrace_{true};
+  std::uint64_t sequence_{0};
+  std::uint64_t sentCount_{0};
+  std::uint64_t droppedCount_{0};
+};
+
+#endif
