diff --git a/tests/test_motion_event_output.cpp b/tests/test_motion_event_output.cpp
new file mode 100644
index 0000000..88fd279
--- /dev/null
+++ b/tests/test_motion_event_output.cpp
@@ -0,0 +1,72 @@
+#include "MotionEventOutput.hpp"
+
+#include <cassert>
+#include <chrono>
+#include <cstring>
+#include <filesystem>
+#include <iostream>
+#include <string>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+namespace fs = std::filesystem;
+
+std::string receiveMessage(int receiver) {
+  char buffer[513] = {};
+  ssize_t length = ::recv(receiver, buffer, sizeof(buffer) - 1, 0);
+  assert(length > 0);
+  return std::string(buffer, static_cast<std::size_t>(length));
+}
+
+int main() {
+  const char *tmpdir = std::getenv("TMPDIR");
+  assert(tmpdir != nullptr && tmpdir[0] != '\0');
+  fs::path root = fs::path(tmpdir) /
+                  ("prudynt-motion-event-" + std::to_string(::getpid()));
+  fs::create_directories(root);
+  fs::path socketPath = root / "motion.sock";
+
+  int receiver = ::socket(AF_UNIX, SOCK_DGRAM, 0);
+  assert(receiver >= 0);
+  struct timeval timeout {1, 0};
+  assert(::setsockopt(receiver, SOL_SOCKET, SO_RCVTIMEO, &timeout,
+                      sizeof(timeout)) == 0);
+  struct sockaddr_un address {};
+  address.sun_family = AF_UNIX;
+  assert(socketPath.string().size() < sizeof(address.sun_path));
+  std::memcpy(address.sun_path, socketPath.c_str(), socketPath.string().size() + 1);
+  assert(::bind(receiver, reinterpret_cast<struct sockaddr *>(&address),
+                sizeof(address)) == 0);
+
+  MotionEventOutput output(socketPath.string());
+  output.startSession();
+  assert(output.send(MotionObservationState::Monitoring, 0, 0) ==
+         MotionEventSendResult::Sent);
+  assert(output.send(MotionObservationState::Detected, 0, 3) ==
+         MotionEventSendResult::Sent);
+  std::string monitoring = receiveMessage(receiver);
+  std::string detected = receiveMessage(receiver);
+  assert(monitoring.find("\"version\":1") != std::string::npos);
+  assert(monitoring.find("\"state\":\"monitoring\"") != std::string::npos);
+  assert(detected.find("\"state\":\"detected\"") != std::string::npos);
+  assert(detected.find("\"roi_mask\":3") != std::string::npos);
+  assert(detected.size() <= 512);
+  assert(output.sentCount() == 2);
+  assert(output.droppedCount() == 0);
+
+  ::close(receiver);
+  ::unlink(socketPath.c_str());
+  fs::path absent = root / "absent.sock";
+  MotionEventOutput missing(absent.string());
+  auto started = std::chrono::steady_clock::now();
+  assert(missing.send(MotionObservationState::Clear, 0, 0) ==
+         MotionEventSendResult::Dropped);
+  assert(std::chrono::steady_clock::now() - started <
+         std::chrono::milliseconds(50));
+  assert(missing.droppedCount() == 1);
+
+  fs::remove_all(root);
+  std::cout << "motion event output tests passed\n";
+  return 0;
+}
