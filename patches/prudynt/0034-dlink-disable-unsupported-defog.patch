diff --git a/tests/test_dlink_isp_capability.cpp b/tests/test_dlink_isp_capability.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test_dlink_isp_capability.cpp
@@ -0,0 +1,15 @@
+#include "DLinkISPCapabilityPolicy.hpp"
+
+#include <cassert>
+#include <iostream>
+
+int main() {
+  static_assert(DLinkISPCapabilityPolicy::supportsDefog(true, false));
+  static_assert(!DLinkISPCapabilityPolicy::supportsDefog(true, true));
+  static_assert(!DLinkISPCapabilityPolicy::supportsDefog(false, false));
+
+  assert(DLinkISPCapabilityPolicy::supportsDefog(true, false));
+  assert(!DLinkISPCapabilityPolicy::supportsDefog(true, true));
+  assert(!DLinkISPCapabilityPolicy::supportsDefog(false, false));
+  std::cout << "D-Link ISP capability policy tests passed\n";
+}
