diff --git a/src/DLinkISPCapabilityPolicy.hpp b/src/DLinkISPCapabilityPolicy.hpp
new file mode 100644
--- /dev/null
+++ b/src/DLinkISPCapabilityPolicy.hpp
@@ -0,0 +1,10 @@
+#pragma once
+
+namespace DLinkISPCapabilityPolicy {
+
+constexpr bool supportsDefog(bool generic_platform_support,
+                             bool dlink_os02g10_runtime) noexcept {
+  return generic_platform_support && !dlink_os02g10_runtime;
+}
+
+} // namespace DLinkISPCapabilityPolicy
