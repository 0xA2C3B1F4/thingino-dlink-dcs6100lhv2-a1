new file mode 100644
index 0000000..be588d4
--- /dev/null
+++ b/src/IPCRequestFrame.hpp
@@ -0,0 +1,40 @@
+#pragma once
+
+#include <cstddef>
+#include <string_view>
+
+enum class FramedJsonStatus { NotFramed, Valid, Invalid };
+
+struct FramedJsonRequest {
+  FramedJsonStatus status{FramedJsonStatus::NotFramed};
+  std::string_view payload;
+};
+
+inline FramedJsonRequest decodeFramedJson(std::string_view request,
+                                          std::size_t payload_limit) {
+  constexpr std::string_view prefix = "PRUDYNT/1 JSON ";
+  if (request.substr(0, prefix.size()) != prefix) {
+    return {};
+  }
+  const std::size_t newline = request.find('\n', prefix.size());
+  if (newline == std::string_view::npos || newline == prefix.size()) {
+    return {FramedJsonStatus::Invalid, {}};
+  }
+  std::size_t length = 0;
+  for (char value : request.substr(prefix.size(), newline - prefix.size())) {
+    if (value < '0' || value > '9') {
+      return {FramedJsonStatus::Invalid, {}};
+    }
+    const std::size_t digit = static_cast<std::size_t>(value - '0');
+    if (length > payload_limit / 10 ||
+        (length == payload_limit / 10 && digit > payload_limit % 10)) {
+      return {FramedJsonStatus::Invalid, {}};
+    }
+    length = length * 10 + digit;
+  }
+  if (length == 0 || length > payload_limit ||
+      request.size() - newline - 1 != length) {
+    return {FramedJsonStatus::Invalid, {}};
+  }
+  return {FramedJsonStatus::Valid, request.substr(newline + 1, length)};
+}
