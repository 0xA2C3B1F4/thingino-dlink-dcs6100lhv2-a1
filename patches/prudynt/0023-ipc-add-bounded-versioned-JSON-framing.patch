+static void test_versioned_json_frame_is_exact_and_bounded() {
+  const std::string request = "PRUDYNT/1 JSON 7\n{\"x\":1}";
+  const auto valid = decodeFramedJson(request, 64);
+  assert(valid.status == FramedJsonStatus::Valid);
+  assert(valid.payload == "{\"x\":1}");
+  assert(decodeFramedJson("{\"x\":1}", 64).status ==
+         FramedJsonStatus::NotFramed);
+  assert(decodeFramedJson("PRUDYNT/1 JSON 8\n{\"x\":1}", 64).status ==
+         FramedJsonStatus::Invalid);
+  assert(decodeFramedJson("PRUDYNT/1 JSON 65\n{}", 64).status ==
+         FramedJsonStatus::Invalid);
+}
