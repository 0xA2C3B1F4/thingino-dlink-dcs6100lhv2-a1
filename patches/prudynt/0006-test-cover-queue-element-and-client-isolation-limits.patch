+static void test_slow_client_does_not_block_fast_client() {
+  MsgChannel<TestNal> slow(800, RTSP_VIDEO_TAP_MAX_BYTES);
+  MsgChannel<TestNal> fast(800, RTSP_VIDEO_TAP_MAX_BYTES);
+
+  for (uint32_t frame = 1; frame <= 40; ++frame) {
+    SharedPayload payload(std::vector<uint8_t>(32 * 1024,
+                                               static_cast<uint8_t>(frame)));
+    TestNal item{payload, true, true, frame % 10 == 0, frame};
+    slow.write(item);
+    assert(fast.write(item));
+
+    TestNal delivered;
+    assert(fast.read(&delivered));
+    assert(delivered.frame_id == frame);
+    assert(delivered.data.storageIdentity() == payload.storageIdentity());
+  }
+
+  assert(fast.size() == 0);
+  assert(fast.evictionCount() == 0);
+  assert(slow.bytes() <= RTSP_VIDEO_TAP_MAX_BYTES);
+  assert(slow.evictionCount() > 0);
+}
