+static void test_recovery_requires_idr_frame_start() {
+  FrameRecoveryGate recovery;
+  recovery.reset(0);
+  assert(recovery.observe(1));
+  assert(!recovery.accept(true, false));
+  assert(recovery.waiting());
+  assert(recovery.accept(true, true));
+  assert(!recovery.waiting());
+}
+
+static void test_read_reports_current_eviction_epoch() {
+  MsgChannel<TestNal> queue(2);
+  assert(queue.write(nal(1, 1, true, true)));
+  assert(queue.write(nal(2, 1, true, true)));
+  assert(!queue.write(nal(3, 1, true, true)));
+
+  uint64_t read_evictions = 0;
+  TestNal item;
+  assert(queue.read(&item, &read_evictions));
+  assert(read_evictions == queue.evictionCount());
+  assert(item.frame_id == 2);
+}
+
+static void test_write_wait_honors_byte_limit() {
+  MsgChannel<TestNal> queue(800, 64);
+  assert(!queue.write_wait(nal(1, 65, true, true)));
+  assert(queue.write_wait(nal(2, 64, true, true)));
+  assert(queue.bytes() == 64);
+}
