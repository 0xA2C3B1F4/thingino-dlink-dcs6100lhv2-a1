diff --git a/src/MP4ControlSocket.cpp b/src/MP4ControlSocket.cpp
index 74379b1..742271f 100644
--- a/src/MP4ControlSocket.cpp
+++ b/src/MP4ControlSocket.cpp
@@ -1243,6 +1243,10 @@ void start_loop_for_channel(const RecordingLoopParams &params) {
 }
 
 bool handle_loop_start(const StartCommandOptions &options) {
+  if (recorder_shutdown_requested.load(std::memory_order_acquire)) {
+    LOG_WARN("MP4ControlSocket: refusing loop start during shutdown");
+    return false;
+  }
   bool ok = false;
   auto params = build_loop_params(options, &ok);
   if (!ok) {
@@ -1274,6 +1278,43 @@ void MP4ControlSocket::retireFailedRecording(int channel,
   stop_recording_locked(channel);
 }
 
+bool MP4ControlSocket::startLoop(int channel, int duration_seconds) {
+  if (channel < 0 || channel >= NUM_VIDEO_CHANNELS || duration_seconds < 0 ||
+      duration_seconds > 86400) {
+    return false;
+  }
+  StartCommandOptions options;
+  options.channel = channel;
+  options.channelProvided = true;
+  options.loop = true;
+  if (duration_seconds > 0) {
+    options.duration_s = duration_seconds;
+    options.durationProvided = true;
+  }
+  return handle_loop_start(options);
+}
+
+bool MP4ControlSocket::stop(int channel) {
+  if (channel == -1) {
+    stop_all_loops();
+    cancel_all_stop_timers();
+    stop_all_recordings();
+    return true;
+  }
+  if (channel < 0 || channel >= NUM_VIDEO_CHANNELS) {
+    return false;
+  }
+  stop_loop_for_channel(channel);
+  cancel_stop_timer(channel);
+  stop_recording(channel);
+  return true;
+}
+
+bool MP4ControlSocket::active(int channel) {
+  return channel >= 0 && channel < NUM_VIDEO_CHANNELS &&
+         global_mp4_recorders[channel].isActive();
+}
+
 void MP4ControlSocket::stopAll() {
   recorder_shutdown_requested.store(true, std::memory_order_release);
   stop_all_loops();
