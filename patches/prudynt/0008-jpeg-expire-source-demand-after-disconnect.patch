+#pragma once
+
+#include <cstdint>
+
+inline bool jpegRequestDeadlineActive(uint32_t now_ms, uint32_t deadline_ms) {
+  return static_cast<int32_t>(deadline_ms - now_ms) > 0;
+}
+
+inline bool jpegSourceDemandActive(bool request_active, int idle_fps) {
+  return request_active || idle_fps > 0;
+}
