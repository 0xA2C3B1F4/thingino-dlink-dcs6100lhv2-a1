new file mode 100644
index 0000000..601449f
--- /dev/null
+++ b/src/PrivacyCoverPlan.hpp
@@ -0,0 +1,23 @@
+#pragma once
+
+struct PrivacyCoverRegion {
+  int top;
+  int bottom;
+  int layer;
+  float scale;
+  int alpha;
+};
+
+// The T31 main encoder needs two opaque horizontal regions on distinct
+// layers 6 and 7. Preserve the proven 100-line split and registration order;
+// merely halving the frame on lower layers still leaks the main image.
+inline bool planPrivacyCoverRegion(int height, int count, int region,
+                                   PrivacyCoverRegion &out) {
+  if ((count != 1 && count != 2) || height < (count == 2 ? 4 : 1) ||
+      region < 0 || region >= count) return false;
+  const int split = count == 2 ? (height > 100 ? 100 : (height / 2) & ~1) : height;
+  out = {region == 0 ? 0 : split,
+         region + 1 == count ? height - 1 : split - 1,
+         count == 2 ? region + 6 : 1, 1.0f, 255};
+  return true;
+}
