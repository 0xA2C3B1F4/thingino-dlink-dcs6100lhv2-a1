diff --git a/src/MotionLifecycle.hpp b/src/MotionLifecycle.hpp
new file mode 100644
index 0000000..2149139
--- /dev/null
+++ b/src/MotionLifecycle.hpp
@@ -0,0 +1,51 @@
+#pragma once
+
+#include <array>
+#include <cstddef>
+
+enum class MotionStage : std::size_t {
+  GroupCreated = 0,
+  InterfaceCreated,
+  ChannelCreated,
+  ChannelRegistered,
+  Bound,
+  Receiving,
+  Count,
+};
+
+class MotionLifecycle {
+public:
+  void mark(MotionStage stage) noexcept {
+    active_[static_cast<std::size_t>(stage)] = true;
+  }
+
+  bool active(MotionStage stage) const noexcept {
+    return active_[static_cast<std::size_t>(stage)];
+  }
+
+  bool empty() const noexcept {
+    for (bool stage_active : active_) {
+      if (stage_active) return false;
+    }
+    return true;
+  }
+
+  template <typename StopStage> int teardown(StopStage &&stop_stage) {
+    for (std::size_t index = active_.size(); index > 0; --index) {
+      const std::size_t stage_index = index - 1;
+      if (!active_[stage_index]) continue;
+
+      const int ret = stop_stage(static_cast<MotionStage>(stage_index));
+      if (ret != 0) {
+        // Keep this stage and all of its prerequisites active. A later retry
+        // can then resume without operating on already-destroyed dependencies.
+        return ret;
+      }
+      active_[stage_index] = false;
+    }
+    return 0;
+  }
+
+private:
+  std::array<bool, static_cast<std::size_t>(MotionStage::Count)> active_{};
+};
