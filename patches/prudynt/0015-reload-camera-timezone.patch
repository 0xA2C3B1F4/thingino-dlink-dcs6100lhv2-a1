diff --git a/src/main.cpp b/src/main.cpp
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -156,6 +156,39 @@ void release_instance_lock() {
 }
 
 #if defined(DCS_DLINK_MEDIA_READY)
+std::string reload_dlink_timezone() {
+  constexpr size_t kTimezoneLimit = 256;
+  char value[kTimezoneLimit] = {};
+  FILE *file = std::fopen("/etc/TZ", "r");
+  if (!file)
+    return {};
+
+  if (!std::fgets(value, sizeof(value), file)) {
+    value[0] = '\0';
+  }
+  std::fclose(file);
+  value[strcspn(value, "\r\n")] = '\0';
+  return value;
+}
+
+std::vector<char *> dlink_timezone_environment(
+    std::vector<std::string> &environment, const std::string &timezone) {
+  extern char **environ;
+  for (char **entry = environ; entry && *entry; ++entry) {
+    if (std::strncmp(*entry, "TZ=", 3) != 0)
+      environment.emplace_back(*entry);
+  }
+  if (!timezone.empty())
+    environment.emplace_back("TZ=" + timezone);
+
+  std::vector<char *> environment_argv;
+  environment_argv.reserve(environment.size() + 1);
+  for (std::string &entry : environment)
+    environment_argv.push_back(entry.data());
+  environment_argv.push_back(nullptr);
+  return environment_argv;
+}
+
 [[noreturn]] void replace_dlink_media_process(int argc, const char *argv[]) {
   std::vector<char *> exec_argv;
   exec_argv.reserve(static_cast<size_t>(argc) + 1);
@@ -183,5 +216,13 @@ void replace_dlink_media_process(int argc, const char *argv[]) {
+  // A process replacement inherits the old environment. Reload the
+  // camera-local timezone before exec so /etc/TZ changes take effect on the
+  // existing Prudynt restart path without a camera reboot. Do not mutate
+  // the live process environment: OSD workers may still call localtime()
+  // until execve replaces the process.
+  std::vector<std::string> exec_environment;
+  std::vector<char *> environment_argv =
+      dlink_timezone_environment(exec_environment, reload_dlink_timezone());
   LOG_INFO("D-Link media restart: replacing process without SDK teardown");
-  execv("/proc/self/exe", exec_argv.data());
+  execve("/proc/self/exe", exec_argv.data(), environment_argv.data());
-  LOG_ERROR("D-Link media restart: execv failed: " << strerror(errno));
+  LOG_ERROR("D-Link media restart: execve failed: " << strerror(errno));
   _exit(127);
 }
