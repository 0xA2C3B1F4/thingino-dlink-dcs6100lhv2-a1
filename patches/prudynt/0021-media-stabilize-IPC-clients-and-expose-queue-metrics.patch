diff --git a/src/MediaRuntimeMetrics.hpp b/src/MediaRuntimeMetrics.hpp
new file mode 100644
index 0000000..07fc745
--- /dev/null
+++ b/src/MediaRuntimeMetrics.hpp
@@ -0,0 +1,40 @@
+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+
+class MediaRuntimeMetrics {
+public:
+  void observeRtspQueueBytes(std::size_t bytes) {
+    rtsp_queue_bytes.store(bytes, std::memory_order_relaxed);
+    std::uint64_t high =
+        rtsp_queue_high_water_bytes.load(std::memory_order_relaxed);
+    while (high < bytes &&
+           !rtsp_queue_high_water_bytes.compare_exchange_weak(
+               high, bytes, std::memory_order_relaxed,
+               std::memory_order_relaxed)) {
+    }
+  }
+
+  void recordRtspQueueDrop() {
+    rtsp_queue_drops_total.fetch_add(1, std::memory_order_relaxed);
+  }
+
+  void recordRtspRecovery() {
+    rtsp_recoveries_total.fetch_add(1, std::memory_order_relaxed);
+  }
+
+  std::atomic<std::uint64_t> rtsp_queue_bytes{0};
+  std::atomic<std::uint64_t> rtsp_queue_high_water_bytes{0};
+  std::atomic<std::uint64_t> rtsp_queue_drops_total{0};
+  std::atomic<std::uint64_t> rtsp_recoveries_total{0};
+  std::atomic<unsigned> ipc_mjpeg_clients{0};
+  std::atomic<unsigned> http_client_threads{0};
+  std::atomic<std::uint64_t> mjpeg_rejections_total{0};
+};
+
+inline MediaRuntimeMetrics &mediaRuntimeMetrics() {
+  static MediaRuntimeMetrics metrics;
+  return metrics;
+}
