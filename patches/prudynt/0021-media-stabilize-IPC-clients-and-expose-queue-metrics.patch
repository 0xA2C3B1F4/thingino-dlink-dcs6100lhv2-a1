+static void test_client_counter_lease_releases_once() {
+  std::atomic<unsigned> clients{0};
+  {
+    auto first = ClientCounterLease::acquire(clients, 1);
+    assert(first);
+    assert(clients.load() == 1);
+    auto rejected = ClientCounterLease::acquire(clients, 1);
+    assert(!rejected);
+    assert(clients.load() == 1);
+  }
+  assert(clients.load() == 0);
+}
+
+static void test_media_metrics_track_queue_high_water() {
+  MediaRuntimeMetrics metrics;
+  metrics.observeRtspQueueBytes(128);
+  metrics.observeRtspQueueBytes(64);
+  metrics.recordRtspQueueDrop();
+  metrics.recordRtspRecovery();
+  assert(metrics.rtsp_queue_bytes.load() == 64);
+  assert(metrics.rtsp_queue_high_water_bytes.load() == 128);
+  assert(metrics.rtsp_queue_drops_total.load() == 1);
+  assert(metrics.rtsp_recoveries_total.load() == 1);
+}
