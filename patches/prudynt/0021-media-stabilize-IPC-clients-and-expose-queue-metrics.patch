diff --git a/src/ClientCounterLease.hpp b/src/ClientCounterLease.hpp
new file mode 100644
index 0000000..175c152
--- /dev/null
+++ b/src/ClientCounterLease.hpp
@@ -0,0 +1,41 @@
+#pragma once
+
+#include <atomic>
+
+class ClientCounterLease {
+public:
+  static ClientCounterLease acquire(std::atomic<unsigned> &counter,
+                                    unsigned limit) {
+    unsigned active = counter.load(std::memory_order_relaxed);
+    while (active < limit) {
+      if (counter.compare_exchange_weak(active, active + 1,
+                                        std::memory_order_acquire,
+                                        std::memory_order_relaxed)) {
+        return ClientCounterLease(counter, true);
+      }
+    }
+    return ClientCounterLease(counter, false);
+  }
+
+  ClientCounterLease(ClientCounterLease &&other) noexcept
+      : counter_(other.counter_), acquired_(other.acquired_) {
+    other.acquired_ = false;
+  }
+
+  ~ClientCounterLease() {
+    if (acquired_) {
+      counter_.fetch_sub(1, std::memory_order_release);
+    }
+  }
+
+  ClientCounterLease(const ClientCounterLease &) = delete;
+  ClientCounterLease &operator=(const ClientCounterLease &) = delete;
+  explicit operator bool() const { return acquired_; }
+
+private:
+  ClientCounterLease(std::atomic<unsigned> &counter, bool acquired)
+      : counter_(counter), acquired_(acquired) {}
+
+  std::atomic<unsigned> &counter_;
+  bool acquired_{false};
+};
