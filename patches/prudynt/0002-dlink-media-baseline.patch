diff --git a/src/HTTPMJPEG.cpp b/src/HTTPMJPEG.cpp
--- a/src/HTTPMJPEG.cpp
+++ b/src/HTTPMJPEG.cpp
@@ -403,6 +403,81 @@ void HTTPMJPEG::handle_client(int cfd) {
     return;
   }
 
+  // Serve one JPEG from the in-memory encoder buffer.  The public ingress
+  // authenticates this route through Thingino Control before opening this
+  // loopback request, so media bytes do not occupy a Control worker or require
+  // a temporary file.
+  if (mjpeg_enabled_ && path == "/snapshot") {
+    sockaddr_in peer{};
+    socklen_t peer_len = sizeof(peer);
+    if (::getpeername(cfd, reinterpret_cast<sockaddr *>(&peer), &peer_len) != 0 ||
+        peer.sin_family != AF_INET ||
+        ntohl(peer.sin_addr.s_addr) != INADDR_LOOPBACK) {
+      send_response(403, "text/plain", "loopback ingress required\n");
+      ::close(cfd);
+      return;
+    }
+
+    if (method != "GET") {
+      send_response(405, "text/plain", "method not allowed\n");
+      ::close(cfd);
+      return;
+    }
+
+    int snapshot_ch = -1;
+    if (qs == "ch=0")
+      snapshot_ch = 0;
+    else if (qs == "ch=1")
+      snapshot_ch = 1;
+    if (snapshot_ch < 0 || snapshot_ch >= NUM_JPEG_CHANNELS ||
+        !global_jpeg[snapshot_ch]) {
+      send_response(400, "text/plain", "bad channel\n");
+      ::close(cfd);
+      return;
+    }
+    if (!JPEGWorker::ensure_running(snapshot_ch)) {
+      send_response(503, "text/plain", "jpeg unavailable\n");
+      ::close(cfd);
+      return;
+    }
+
+    std::vector<unsigned char> image;
+    if (is_privacy_active_for_jpeg(snapshot_ch)) {
+      image = privacy_placeholder_jpeg();
+    } else {
+      global_jpeg[snapshot_ch]->request();
+      for (int wait_ms = 1000; wait_ms > 0 && image.empty(); wait_ms -= 5) {
+        if (!get_snapshot_ch_local_http(snapshot_ch, image)) {
+          global_jpeg[snapshot_ch]->request();
+          std::this_thread::sleep_for(milliseconds(5));
+        }
+      }
+    }
+    if (image.empty()) {
+      send_response(503, "text/plain", "jpeg unavailable\n");
+      ::close(cfd);
+      return;
+    }
+
+    timeval send_timeout{};
+    send_timeout.tv_sec = 2;
+    ::setsockopt(cfd, SOL_SOCKET, SO_SNDTIMEO, &send_timeout,
+                 sizeof(send_timeout));
+    char hdr[512];
+    int n = snprintf(
+        hdr, sizeof(hdr),
+        "HTTP/1.0 200 OK\r\nContent-Type: image/jpeg\r\nContent-Disposition: "
+        "attachment; filename=\"snapshot-ch%d.jpg\"\r\nCache-Control: no-store\r\n"
+        "Content-Length: %zu\r\nConnection: close\r\n\r\n",
+        snapshot_ch, image.size());
+    if (n > 0 && n < static_cast<int>(sizeof(hdr))) {
+      write_full(cfd, hdr, static_cast<size_t>(n));
+      write_full(cfd, image.data(), image.size());
+    }
+    ::close(cfd);
+    return;
+  }
+
