diff --git a/src/MotionGeometryPolicy.hpp b/src/MotionGeometryPolicy.hpp
new file mode 100644
index 0000000..0ad4396
--- /dev/null
+++ b/src/MotionGeometryPolicy.hpp
@@ -0,0 +1,45 @@
+#pragma once
+
+#include <algorithm>
+
+struct MotionGeometry {
+  int width;
+  int height;
+  int roi_0_x;
+  int roi_0_y;
+  int roi_1_x;
+  int roi_1_y;
+  int roi_count;
+};
+
+inline bool normalizeMotionGeometry(MotionGeometry &geometry,
+                                    int encoder_width, int encoder_height,
+                                    int max_roi_count, int auto_value) {
+  if (encoder_width < 2 || encoder_height < 2 || max_roi_count < 1)
+    return false;
+
+  auto normalize_dimension = [&](int value, int encoder_value) {
+    if (value == auto_value || value <= 0)
+      return encoder_value;
+    return std::min(value, encoder_value);
+  };
+  geometry.width = normalize_dimension(geometry.width, encoder_width);
+  geometry.height = normalize_dimension(geometry.height, encoder_height);
+  if (geometry.width < 2 || geometry.height < 2)
+    return false;
+
+  geometry.roi_0_x = std::clamp(geometry.roi_0_x, 0, geometry.width - 2);
+  geometry.roi_0_y = std::clamp(geometry.roi_0_y, 0, geometry.height - 2);
+
+  auto normalize_end = [&](int value, int start, int limit) {
+    if (value == auto_value || value <= start)
+      return limit - 1;
+    return std::clamp(value, start + 1, limit - 1);
+  };
+  geometry.roi_1_x =
+      normalize_end(geometry.roi_1_x, geometry.roi_0_x, geometry.width);
+  geometry.roi_1_y =
+      normalize_end(geometry.roi_1_y, geometry.roi_0_y, geometry.height);
+  geometry.roi_count = std::clamp(geometry.roi_count, 1, max_roi_count);
+  return true;
+}
diff --git a/tests/test_motion_geometry.cpp b/tests/test_motion_geometry.cpp
new file mode 100644
index 0000000..882bbfc
--- /dev/null
+++ b/tests/test_motion_geometry.cpp
@@ -0,0 +1,41 @@
+#include "MotionGeometryPolicy.hpp"
+
+#include <cassert>
+
+int main() {
+  constexpr int kAuto = 16384;
+  constexpr int kMaxRois = 52;
+
+  MotionGeometry auto_geometry{0, 0, 0, 0, 0, 0, 1};
+  assert(normalizeMotionGeometry(auto_geometry, 1920, 1080, kMaxRois,
+                                 kAuto));
+  assert(auto_geometry.width == 1920);
+  assert(auto_geometry.height == 1080);
+  assert(auto_geometry.roi_0_x == 0);
+  assert(auto_geometry.roi_0_y == 0);
+  assert(auto_geometry.roi_1_x == 1919);
+  assert(auto_geometry.roi_1_y == 1079);
+
+  MotionGeometry partial_reload{1920, 0, 0, 0, 0, 0, 0};
+  assert(normalizeMotionGeometry(partial_reload, 1920, 1080, kMaxRois,
+                                 kAuto));
+  assert(partial_reload.height == 1080);
+  assert(partial_reload.roi_1_x > partial_reload.roi_0_x);
+  assert(partial_reload.roi_1_y > partial_reload.roi_0_y);
+  assert(partial_reload.roi_count == 1);
+
+  MotionGeometry oversized{4096, 4096, 4096, 4096, 4096, 4096, 100};
+  assert(normalizeMotionGeometry(oversized, 640, 360, kMaxRois, kAuto));
+  assert(oversized.width == 640);
+  assert(oversized.height == 360);
+  assert(oversized.roi_0_x == 638);
+  assert(oversized.roi_0_y == 358);
+  assert(oversized.roi_1_x == 639);
+  assert(oversized.roi_1_y == 359);
+  assert(oversized.roi_count == kMaxRois);
+
+  MotionGeometry invalid{0, 0, 0, 0, 0, 0, 1};
+  assert(!normalizeMotionGeometry(invalid, 1, 1080, kMaxRois, kAuto));
+  assert(!normalizeMotionGeometry(invalid, 1920, 0, kMaxRois, kAuto));
+  return 0;
+}
