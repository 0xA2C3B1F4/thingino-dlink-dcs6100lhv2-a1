+MotionRuntimeConfig CFG::motionRuntimeConfig() const {
+  std::lock_guard<std::mutex> lock(configMutex);
+  MotionRuntimeConfig snapshot{
+      motion.monitor_stream,
+      motion.cooldown_time_s,
+      motion.motor_settle_ms,
+      motion.init_time_s,
+      motion.ivs_polling_timeout_ms,
+      motion.sensitivity,
+      motion.skip_frame_count,
+      motion.frame_width,
+      motion.frame_height,
+      motion.roi_0_x,
+      motion.roi_0_y,
+      motion.roi_1_x,
+      motion.roi_1_y,
+      motion.roi_count,
+      false,
+      0,
+      osd.burnin.enabled,
+      osd.burnin.scale,
+      osd.burnin.format ? osd.burnin.format : "",
+  };
+
+  const _stream *stream = nullptr;
+  switch (snapshot.monitor_stream) {
+  case 0:
+    stream = &stream0;
+    break;
+  case 1:
+    stream = &stream1;
+    break;
+  case 2:
+    stream = &stream2;
+    break;
+  case 3:
+    stream = &stream3;
+    break;
+  default:
+    break;
+  }
+  if (stream) {
+    snapshot.monitor_stream_enabled = stream->enabled;
+    snapshot.monitor_stream_rotation = stream->rotation;
+  }
+  return snapshot;
+}
