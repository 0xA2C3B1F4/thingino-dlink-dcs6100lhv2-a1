diff --git a/src/SharedPayload.hpp b/src/SharedPayload.hpp
new file mode 100644
index 0000000..03a536c
--- /dev/null
+++ b/src/SharedPayload.hpp
@@ -0,0 +1,55 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <utility>
+#include <vector>
+
+// Immutable byte storage shared by every consumer of one encoded NAL unit.
+// Constructing from a vector moves or copies the bytes once. Copying this
+// wrapper only increments the shared ownership count.
+class SharedPayload {
+public:
+  using Storage = std::vector<uint8_t>;
+  using const_iterator = Storage::const_iterator;
+
+  SharedPayload() = default;
+  SharedPayload(const Storage &bytes)
+      : storage_(std::make_shared<const Storage>(bytes)) {}
+  SharedPayload(Storage &&bytes)
+      : storage_(std::make_shared<const Storage>(std::move(bytes))) {}
+
+  SharedPayload &operator=(const Storage &bytes) {
+    storage_ = std::make_shared<const Storage>(bytes);
+    return *this;
+  }
+
+  SharedPayload &operator=(Storage &&bytes) {
+    storage_ = std::make_shared<const Storage>(std::move(bytes));
+    return *this;
+  }
+
+  const uint8_t *data() const { return storage_ ? storage_->data() : nullptr; }
+  size_t size() const { return storage_ ? storage_->size() : 0; }
+  bool empty() const { return size() == 0; }
+
+  const uint8_t &operator[](size_t index) const { return (*storage_)[index]; }
+  const_iterator begin() const {
+    return storage_ ? storage_->begin() : emptyStorage().begin();
+  }
+  const_iterator end() const {
+    return storage_ ? storage_->end() : emptyStorage().end();
+  }
+
+  const void *storageIdentity() const { return storage_.get(); }
+  long useCount() const { return storage_.use_count(); }
+
+private:
+  static const Storage &emptyStorage() {
+    static const Storage empty;
+    return empty;
+  }
+
+  std::shared_ptr<const Storage> storage_;
+};
