diff --git a/src/JpegIdlePolicy.hpp b/src/JpegIdlePolicy.hpp
new file mode 100644
index 0000000..0d70927
--- /dev/null
+++ b/src/JpegIdlePolicy.hpp
@@ -0,0 +1,8 @@
+#pragma once
+
+// Preserve an explicit zero-idle policy unless the legacy snapshot-file
+// refresher needs a minimal producer.
+inline int jpegIdleFpsPolicy(int configured_idle_fps, int jpeg_refresh) {
+  return configured_idle_fps <= 0 && jpeg_refresh > 0 ? 1
+                                                      : configured_idle_fps;
+}
