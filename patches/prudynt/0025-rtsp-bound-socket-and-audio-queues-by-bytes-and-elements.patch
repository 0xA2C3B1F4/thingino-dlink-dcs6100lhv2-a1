new file mode 100644
index 0000000..320491a
--- /dev/null
+++ b/src/SocketQueuePolicy.hpp
@@ -0,0 +1,15 @@
+#pragma once
+
+#include <cstddef>
+
+constexpr std::size_t kRtspSocketQueueMaxElements = 1024;
+constexpr std::size_t kRtspSocketQueueMaxBytes = 1024 * 1024;
+constexpr std::size_t kRtspAudioTapMaxBytes = 256 * 1024;
+
+inline bool rtspSocketQueueCanAppend(std::size_t elements,
+                                     std::size_t bytes,
+                                     std::size_t append_bytes) {
+  return elements < kRtspSocketQueueMaxElements &&
+         append_bytes <= kRtspSocketQueueMaxBytes &&
+         bytes <= kRtspSocketQueueMaxBytes - append_bytes;
+}
