+static void test_rtsp_socket_queue_has_element_and_byte_limits() {
+  assert(rtspSocketQueueCanAppend(0, 0, 1500));
+  assert(!rtspSocketQueueCanAppend(kRtspSocketQueueMaxElements, 0, 1));
+  assert(!rtspSocketQueueCanAppend(0, kRtspSocketQueueMaxBytes, 1));
+  assert(!rtspSocketQueueCanAppend(0, 0, kRtspSocketQueueMaxBytes + 1));
+  struct Payload {
+    std::vector<unsigned char> data;
+  };
+  MsgChannel<Payload> audio(3, 8);
+  Payload frame;
+  frame.data.assign(6, 0);
+  assert(audio.write(frame));
+  frame.data.assign(6, 0);
+  assert(!audio.write(frame));
+  assert(audio.bytes() <= 8);
+}
