+/* Required privacy participants are configured services or services with an
+ * existing socket. A missing required service is a failure, not a skip. */
+int rvd_privacy_participant(rvd_state_t *st, const char *section,
+                               const char *socket, const char *command)
+{
+    int required = rvd_privacy_required(st, section, socket);
+    if (required < 0) return RSS_ERR;
+    if (!required) return 1;
+	char response[512];
+	int ret = rss_ctrl_send_command(socket, command, response, sizeof(response), 250);
+	if (ret <= 0)
+		return RSS_ERR;
+	cJSON *reply = cJSON_Parse(response);
+	const cJSON *status = cJSON_GetObjectItemCaseSensitive(reply, "status");
+	bool ok = cJSON_IsString(status) && strcmp(status->valuestring, "ok") == 0;
+	cJSON_Delete(reply);
+	return ok ? RSS_OK : RSS_ERR;
+}
