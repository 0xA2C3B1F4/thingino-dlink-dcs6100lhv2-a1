+	daemon_cleanup_calls = 0;
+	policy_set_calls = 0;
+	isp_set_calls = 0;
+	common_read_calls = 0;
+	photo_reset_calls = 0;
+	sun_poll_calls = 0;
+	schedule_poll_calls = 0;
+}
+
+static void run_daemon(bool enabled, bool demand, const char *trigger, const char *mode,
+		       bool paused, bool sun, bool schedule)
+{
+	char *argv[] = {"ric", NULL};
+	configured_enabled = enabled;
+	demand_gain = demand;
+	configured_trigger = trigger;
+	configured_mode = mode;
+	configured_initial_mode = enabled ? "default" : "night";
+	configured_paused = paused;
+	configured_sun = sun;
+	configured_schedule = schedule;
+	exercise_disabled_controls = !enabled;
+	reset_counts();
+	assert(ric_main_entry(1, argv) == 0);
+	assert(control_listen_calls == 1 && control_destroy_calls == 1);
+	assert(adc_cleanup_calls == 1 && config_free_calls == 1 && daemon_cleanup_calls == 1);
+	assert(policy_set_calls == 0 && isp_set_calls == 0);
+	assert(common_read_calls == (enabled ? 0 : 1));
+	if (!enabled)
+		assert(photo_reset_calls == 0 && sun_poll_calls == 0 &&
+		       schedule_poll_calls == 0);
+}
+
+int main(void)
+{
+	static const struct {
+		const char *trigger;
+		const char *mode;
+		bool paused;
+		bool sun;
+		bool schedule;
+	} disabled_cases[] = {
+		{"adc", "auto", false, true, false},
+		{"photo", "auto", false, false, true},
+		{"gain", "night", false, false, false},
+		{"luma", "auto", true, false, false},
+	};
+	for (size_t i = 0; i < sizeof(disabled_cases) / sizeof(disabled_cases[0]); ++i) {
+		for (int demand = 0; demand <= 1; ++demand) {
+			run_daemon(false, demand != 0, disabled_cases[i].trigger,
+				   disabled_cases[i].mode, disabled_cases[i].paused,
+				   disabled_cases[i].sun, disabled_cases[i].schedule);
+			assert(gpio_init_calls == 0 && adc_start_calls == 0 && startup_calls == 0);
+			assert(rvd_ready_calls == 0 && gain_demand_calls == 1);
+			assert(gain_observations == demand && policy_observations == 0);
+		}
+	}
+
+	run_daemon(true, true, "luma", "auto", false, false, false);
+	assert(gpio_init_calls == 1 && adc_start_calls == 0 && startup_calls == 1);
+	assert(rvd_ready_calls == 1 && gain_demand_calls == 0);
+	assert(gain_observations == 0 && policy_observations == 1);
+
+	puts("ric disabled gain control-plane lifecycle passed");
+	return 0;
+}
