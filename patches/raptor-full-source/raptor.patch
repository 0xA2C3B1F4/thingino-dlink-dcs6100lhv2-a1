index 0000000000000000000000000000000000000000..048b79958aa72fbd84fd45ec18784d956d247274
--- /dev/null
+++ b/ric/ric_settings.c
@@ -0,0 +1,1026 @@
+/* Persistent policy settings with checked GPIO operations and ISP readback.
+ * GPIO values confirm drive state, not the physical latching filter position. */
+#include "ric.h"
+#include <string.h>
+#include <limits.h>
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+
+static int threshold_values(const ric_config_t *c, const char **trigger,
+                            const char **keys, int *values)
+{
+    switch (c->trigger) {
+    case RIC_TRIGGER_LUMA:
+        *trigger = "luma";
+        keys[0] = "night_luma";
+        keys[1] = "night_gain";
+        keys[2] = "day_gain_pct";
+        values[0] = c->night_luma;
+        values[1] = c->night_gain;
+        values[2] = c->day_gain_pct;
+        return 3;
+    case RIC_TRIGGER_GAIN:
+        *trigger = "gain";
+        keys[0] = "day_threshold";
+        keys[1] = "night_threshold";
+        values[0] = c->day_threshold;
+        values[1] = c->night_threshold;
+        return 2;
+    case RIC_TRIGGER_ADC:
+        *trigger = "adc";
+        keys[0] = "adc_night";
+        keys[1] = "adc_day";
+        values[0] = c->adc_night;
+        values[1] = c->adc_day;
+        return 2;
+    case RIC_TRIGGER_PHOTO:
+        *trigger = "photo";
+        keys[0] = "photo_ev_day";
+        keys[1] = "photo_ev_night";
+        keys[2] = "photo_ev_deep";
+        if (c->photo.ev_day > INT_MAX || c->photo.ev_night > INT_MAX || c->photo.ev_deep > INT_MAX)
+            return 0;
+        values[0] = (int)c->photo.ev_day;
+        values[1] = (int)c->photo.ev_night;
+        values[2] = (int)c->photo.ev_deep;
+        return 3;
+    default:
+        *trigger = "unsupported";
+        return 0;
+    }
+}
+
+static bool thresholds_valid(ric_trigger_t trigger, const int *values)
+{
+    if (trigger == RIC_TRIGGER_LUMA)
+        return values[0] >= 0 && values[0] <= 255 && values[1] >= 0 &&
+            values[2] >= 1 && values[2] <= 100;
+    if (trigger == RIC_TRIGGER_GAIN || trigger == RIC_TRIGGER_ADC)
+        return values[0] >= 0 && values[0] < values[1];
+    if (trigger == RIC_TRIGGER_PHOTO)
+        return values[0] >= 0 && values[0] < values[1] && values[1] < values[2];
+    return false;
+}
+
+static cJSON *threshold_observation(ric_state_t *st)
+{
+    const char *trigger, *keys[3];
+    int values[3];
+    int count = threshold_values(&st->settings, &trigger, keys, values);
+    bool supported = count != 0;
+    bool available = st->settings.enabled && supported &&
+        thresholds_valid(st->settings.trigger, values);
+    cJSON *root = cJSON_CreateObject();
+    cJSON_AddStringToObject(root, "trigger", trigger);
+    cJSON_AddBoolToObject(root, "supported", supported);
+    cJSON_AddBoolToObject(root, "available", available);
+    if (available) {
+        cJSON *settings = cJSON_AddObjectToObject(root, "values");
+        for (int i = 0; i < count; ++i)
+            cJSON_AddNumberToObject(settings, keys[i], values[i]);
+    } else {
+        cJSON_AddNullToObject(root, "values");
+    }
+    return root;
+}
+
+int ric_set_thresholds(ric_state_t *st, const char *json, char *response, int size)
+{
+    const char *trigger, *keys[3];
+    int values[3];
+    int count = threshold_values(&st->settings, &trigger, keys, values);
+    cJSON *root = cJSON_ParseWithOpts(json, NULL, true);
+    const cJSON *cmd = cJSON_GetObjectItemCaseSensitive(root, "cmd");
+    const cJSON *requested = cJSON_GetObjectItemCaseSensitive(root, "trigger");
+    const cJSON *settings = cJSON_GetObjectItemCaseSensitive(root, "values");
+    bool valid = st->settings.enabled && count != 0 &&
+        strcmp(rss_config_get_str(st->cfg, "ircut", "trigger", "luma"), trigger) == 0 &&
+        cJSON_IsObject(root) &&
+        cJSON_GetArraySize(root) == 3 && cJSON_IsString(cmd) &&
+        strcmp(cmd->valuestring, "set-daynight-thresholds") == 0 &&
+        cJSON_IsString(requested) && strcmp(requested->valuestring, trigger) == 0 &&
+        cJSON_IsObject(settings) && cJSON_GetArraySize(settings) == count;
+    for (int i = 0; valid && i < count; ++i) {
+        const cJSON *value = cJSON_GetObjectItemCaseSensitive(settings, keys[i]);
+        valid = cJSON_IsNumber(value) && value->valuedouble >= 0 &&
+            value->valuedouble <= INT_MAX && value->valuedouble == (int)value->valuedouble;
+        if (valid)
+            values[i] = (int)value->valuedouble;
+    }
+    cJSON_Delete(root);
+    if (!valid || !thresholds_valid(st->settings.trigger, values))
+        return rss_ctrl_resp_error(response, size, "invalid thresholds for active trigger");
+    for (int i = 0; i < count; ++i)
+        rss_config_set_int(st->cfg, "ircut", keys[i], values[i]);
+    for (int i = 0; i < count; ++i) {
+        if (rss_config_get_int(st->cfg, "ircut", keys[i], -1) != values[i])
+            return rss_ctrl_resp_error(response, size, "threshold cache update failed");
+    }
+    if (st->settings.trigger == RIC_TRIGGER_LUMA) {
+        st->settings.night_luma = values[0];
+        st->settings.night_gain = values[1];
+        st->settings.day_gain_pct = values[2];
+    } else if (st->settings.trigger == RIC_TRIGGER_GAIN) {
+        st->settings.day_threshold = values[0];
+        st->settings.night_threshold = values[1];
+    } else if (st->settings.trigger == RIC_TRIGGER_ADC) {
+        st->settings.adc_night = values[0];
+        st->settings.adc_day = values[1];
+    } else {
+        st->settings.photo.ev_day = (uint32_t)values[0];
+        st->settings.photo.ev_night = (uint32_t)values[1];
+        st->settings.photo.ev_deep = (uint32_t)values[2];
+        ric_photo_reset(&st->photo, st->current_mode == RIC_MODE_NIGHT ?
+            PHOTO_PHASE_DAY_DETECT : PHOTO_PHASE_NIGHT_DETECT);
+    }
+    st->day_count = 0;
+    st->night_count = 0;
+    st->day_condition_since_us = 0;
+    st->night_condition_since_us = 0;
+    return rss_ctrl_resp_ok(response, size);
+}
+
+static const char *mode_name(ric_opmode_t mode)
+{
+    return mode == RIC_AUTO ? "auto" : mode == RIC_FORCE_DAY ? "day" : "night";
+}
+
+const char *ric_initial_mode_name(ric_initial_mode_t mode)
+{
+    return mode == RIC_INITIAL_DAY ? "day" :
+        mode == RIC_INITIAL_NIGHT ? "night" : "default";
+}
+
+bool ric_initial_mode_parse(const char *name, ric_initial_mode_t *mode)
+{
+    if (!name || !mode)
+        return false;
+    if (strcmp(name, "default") == 0)
+        *mode = RIC_INITIAL_DEFAULT;
+    else if (strcmp(name, "day") == 0)
+        *mode = RIC_INITIAL_DAY;
+    else if (strcmp(name, "night") == 0)
+        *mode = RIC_INITIAL_NIGHT;
+    else
+        return false;
+    return true;
+}
+
+ric_mode_t ric_startup_target(const ric_config_t *settings)
+{
+    if (settings->opmode == RIC_FORCE_NIGHT)
+        return RIC_MODE_NIGHT;
+    if (settings->opmode == RIC_FORCE_DAY)
+        return RIC_MODE_DAY;
+    return settings->initial_mode == RIC_INITIAL_NIGHT ?
+        RIC_MODE_NIGHT : RIC_MODE_DAY;
+}
+
+bool ric_apply_startup(ric_state_t *st, time_t now)
+{
+    st->boot_initial_mode = st->settings.initial_mode;
+    st->current_mode = (ric_mode_t)-1;
+    st->mode_confirmed = false;
+    ric_mode_t target = ric_startup_target(&st->settings);
+    if (!(st->settings.opmode == RIC_AUTO ?
+          ric_apply_automatic_mode(st, target) : ric_apply_mode(st, target)))
+        return false;
+    if (st->settings.trigger == RIC_TRIGGER_PHOTO)
+        ric_photo_reset(&st->photo, target == RIC_MODE_NIGHT ?
+            PHOTO_PHASE_DAY_DETECT : PHOTO_PHASE_NIGHT_DETECT);
+    if (st->settings.opmode == RIC_AUTO && st->settings.automation_paused)
+        return true;
+    if (st->settings.opmode == RIC_AUTO && st->settings.sun_enabled)
+        return ric_sun_poll(st, now);
+    if (st->settings.opmode == RIC_AUTO && st->settings.schedule_enabled)
+        return ric_schedule_poll(st, now);
+    return true;
+}
+
+int ric_set_initial_mode(ric_state_t *st, const char *json, char *response, int size)
+{
+    cJSON *root = cJSON_ParseWithOpts(json, NULL, true);
+    const cJSON *cmd = cJSON_GetObjectItemCaseSensitive(root, "cmd");
+    const cJSON *value = cJSON_GetObjectItemCaseSensitive(root, "value");
+    ric_initial_mode_t requested;
+    bool valid = cJSON_IsObject(root) && cJSON_GetArraySize(root) == 2 &&
+        cJSON_IsString(cmd) && strcmp(cmd->valuestring, "set-daynight-initial-mode") == 0 &&
+        cJSON_IsString(value) && ric_initial_mode_parse(value->valuestring, &requested);
+    cJSON_Delete(root);
+    if (!valid)
+        return rss_ctrl_resp_error(response, size, "expected default, day or night initial mode");
+
+    const char *name = ric_initial_mode_name(requested);
+    rss_config_set_str(st->cfg, "ircut", "initial_mode", name);
+    if (strcmp(rss_config_get_str(st->cfg, "ircut", "initial_mode", ""), name) != 0)
+        return rss_ctrl_resp_error(response, size, "day/night initial mode cache failed");
+    /* This setting belongs to the next process start. Do not touch GPIO, ISP,
+     * current mode, or the boot policy already active in this process. */
+    st->settings.initial_mode = requested;
+    return rss_ctrl_resp_ok(response, size);
+}
+
+static bool poll_interval_valid(int poll_interval_ms)
+{
+    return poll_interval_ms >= 50 && poll_interval_ms <= 10000;
+}
+
+static bool transition_delay_valid(int transition_delay_s)
+{
+    return transition_delay_s >= 1 && transition_delay_s <= 300;
+}
+
+static bool confirmation_count_valid(int count)
+{
+    return count >= 1 && count <= 255;
+}
+
+static const char *loglevel_name(rss_log_level_t level)
+{
+    static const char *names[] = {"fatal", "error", "warn", "info", "debug", "trace"};
+    return level >= RSS_LOG_FATAL && level <= RSS_LOG_TRACE ? names[level] : "unknown";
+}
+
+static bool loglevel_parse(const char *name, rss_log_level_t *level)
+{
+    if (!name || !level)
+        return false;
+    for (int value = RSS_LOG_FATAL; value <= RSS_LOG_TRACE; ++value) {
+        if (strcmp(name, loglevel_name((rss_log_level_t)value)) == 0) {
+            *level = (rss_log_level_t)value;
+            return true;
+        }
+    }
+    return false;
+}
+
+static void reset_detection_evidence(ric_state_t *st)
+{
+    st->day_count = 0;
+    st->night_count = 0;
+    st->day_condition_since_us = 0;
+    st->night_condition_since_us = 0;
+    st->cooldown_remaining = 0;
+    if (st->settings.trigger == RIC_TRIGGER_PHOTO)
+        ric_photo_reset(&st->photo, st->current_mode == RIC_MODE_NIGHT ?
+            PHOTO_PHASE_DAY_DETECT : PHOTO_PHASE_NIGHT_DETECT);
+}
+
+static bool sun_values_valid(double latitude, double longitude, int sunrise_offset,
+                             int sunset_offset)
+{
+    return isfinite(latitude) && latitude >= -90.0 && latitude <= 90.0 &&
+        isfinite(longitude) && longitude >= -180.0 && longitude <= 180.0 &&
+        sunrise_offset >= -1440 && sunrise_offset <= 1440 &&
+        sunset_offset >= -1440 && sunset_offset <= 1440;
+}
+
+static bool parse_config_double(rss_config_t *cfg, const char *key, double *value)
+{
+    const char *text = rss_config_get_str(cfg, "ircut", key, NULL);
+    if (!text)
+        return false;
+    char *end = NULL;
+    double parsed = strtod(text, &end);
+    if (!end || end == text || *end != '\0' || !isfinite(parsed))
+        return false;
+    *value = parsed;
+    return true;
+}
+
+static int year_days(int year)
+{
+    return year % 4 == 0 && (year % 100 != 0 || year % 400 == 0) ? 366 : 365;
+}
+
+static ric_sun_condition_t solar_events_utc(int year, int yday, double latitude,
+                                             double longitude, double *sunrise,
+                                             double *sunset, double *solar_midnight)
+{
+    /* NOAA's fractional-year equations estimate equation of time and solar
+     * declination, then use a 90.833-degree zenith for sunrise and sunset. This
+     * is the short approximation in the cited paper, not NOAA's separate
+     * Meeus-based calculator, so no calculator accuracy claim is borrowed for
+     * these estimates. Near a polar boundary its daily classification is also
+     * an estimate rather than an observed horizon crossing.
+     * https://gml.noaa.gov/grad/solcalc/solareqns.PDF */
+    const double pi = 3.14159265358979323846;
+    double gamma = 2.0 * pi * yday / year_days(year);
+    double equation = 229.18 * (0.000075 + 0.001868 * cos(gamma) -
+        0.032077 * sin(gamma) - 0.014615 * cos(2.0 * gamma) -
+        0.040849 * sin(2.0 * gamma));
+    double declination = 0.006918 - 0.399912 * cos(gamma) +
+        0.070257 * sin(gamma) - 0.006758 * cos(2.0 * gamma) +
+        0.000907 * sin(2.0 * gamma) - 0.002697 * cos(3.0 * gamma) +
+        0.00148 * sin(3.0 * gamma);
+    double solar_noon = 720.0 - 4.0 * longitude - equation;
+    *solar_midnight = solar_noon - 720.0;
+    double lat = latitude * pi / 180.0;
+    double argument = cos(90.833 * pi / 180.0) / (cos(lat) * cos(declination)) -
+        tan(lat) * tan(declination);
+    if (!isfinite(argument)) {
+        double noon_cos_zenith = sin(lat) * sin(declination) +
+            cos(lat) * cos(declination);
+        return noon_cos_zenith > cos(90.833 * pi / 180.0) ?
+            RIC_SUN_POLAR_DAY : RIC_SUN_POLAR_NIGHT;
+    }
+    if (argument < -1.0)
+        return RIC_SUN_POLAR_DAY;
+    if (argument > 1.0)
+        return RIC_SUN_POLAR_NIGHT;
+    double hour_angle = acos(argument) * 180.0 / pi;
+    *sunrise = solar_noon - 4.0 * hour_angle;
+    *sunset = solar_noon + 4.0 * hour_angle;
+    return RIC_SUN_NORMAL;
+}
+
+static bool add_sun_transition(ric_state_t *st, time_t when, ric_mode_t mode)
+{
+    if (st->sun_transition_count >= RIC_SUN_TRANSITIONS)
+        return false;
+    st->sun_transitions[st->sun_transition_count] = when;
+    st->sun_transition_modes[st->sun_transition_count++] = mode;
+    return true;
+}
+
+static bool rebuild_sun_cache(ric_state_t *st, time_t now, const struct tm *utc)
+{
+    time_t midnight = now - utc->tm_hour * 3600 - utc->tm_min * 60 - utc->tm_sec;
+    st->sun_transition_count = 0;
+    st->sun_condition = RIC_SUN_NORMAL;
+    st->sun_base_target_known = false;
+    struct tm prior_date;
+    time_t prior_noon = midnight - 4 * 86400 + 43200;
+    if (!gmtime_r(&prior_noon, &prior_date))
+        return false;
+    double unused_sunrise = 0.0, unused_sunset = 0.0, unused_midnight = 0.0;
+    ric_sun_condition_t prior_condition = solar_events_utc(prior_date.tm_year + 1900,
+        prior_date.tm_yday, st->settings.sun_latitude, st->settings.sun_longitude,
+        &unused_sunrise, &unused_sunset, &unused_midnight);
+    if (prior_condition == RIC_SUN_POLAR_DAY || prior_condition == RIC_SUN_POLAR_NIGHT) {
+        st->sun_base_target_known = true;
+        st->sun_base_target = prior_condition == RIC_SUN_POLAR_DAY ?
+            RIC_MODE_DAY : RIC_MODE_NIGHT;
+    }
+    for (int day = -3; day <= 3; ++day) {
+        time_t noon = midnight + (time_t)day * 86400 + 43200;
+        struct tm date;
+        if (!gmtime_r(&noon, &date))
+            return false;
+        double sunrise = 0.0, sunset = 0.0, solar_midnight = 0.0;
+        ric_sun_condition_t condition = solar_events_utc(date.tm_year + 1900,
+            date.tm_yday, st->settings.sun_latitude, st->settings.sun_longitude,
+            &sunrise, &sunset, &solar_midnight);
+        if (day == 0)
+            st->sun_condition = condition;
+        time_t date_midnight = midnight + (time_t)day * 86400;
+        if (condition == RIC_SUN_NORMAL) {
+            if (!add_sun_transition(st, date_midnight + (time_t)llround(sunrise * 60.0) +
+                    st->settings.sun_sunrise_offset * 60, RIC_MODE_DAY) ||
+                !add_sun_transition(st, date_midnight + (time_t)llround(sunset * 60.0) +
+                    st->settings.sun_sunset_offset * 60, RIC_MODE_NIGHT))
+                return false;
+        } else if (condition != prior_condition) {
+            /* A no-event season still needs a deterministic owner. Enter it at
+             * the estimated local solar-day boundary. Reassert once after the
+             * maximum positive offset window so a shifted neighboring event is
+             * honored chronologically but cannot own the whole polar season. */
+            time_t boundary = date_midnight + (time_t)llround(solar_midnight * 60.0);
+            ric_mode_t polar_target = condition == RIC_SUN_POLAR_DAY ?
+                RIC_MODE_DAY : RIC_MODE_NIGHT;
+            if (!add_sun_transition(st, boundary, polar_target) ||
+                !add_sun_transition(st, boundary + 86400, polar_target))
+                return false;
+        }
+        prior_condition = condition;
+    }
+    st->sun_cache_year = utc->tm_year;
+    st->sun_cache_yday = utc->tm_yday;
+    st->sun_cache_latitude = st->settings.sun_latitude;
+    st->sun_cache_longitude = st->settings.sun_longitude;
+    st->sun_cache_sunrise_offset = st->settings.sun_sunrise_offset;
+    st->sun_cache_sunset_offset = st->settings.sun_sunset_offset;
+    st->sun_cache_valid = true;
+    return true;
+}
+
+bool ric_sun_target_at(ric_state_t *st, time_t now, ric_mode_t *target)
+{
+    /* An unset RTC commonly reports the Unix epoch. Fail closed until the clock
+     * reaches a plausible date instead of applying a fabricated solar state. */
+    if (now < (time_t)1577836800 || !sun_values_valid(st->settings.sun_latitude,
+            st->settings.sun_longitude, st->settings.sun_sunrise_offset,
+            st->settings.sun_sunset_offset))
+        return false;
+    struct tm utc;
+    if (!gmtime_r(&now, &utc))
+        return false;
+    if (!st->sun_cache_valid || st->sun_cache_year != utc.tm_year ||
+        st->sun_cache_yday != utc.tm_yday ||
+        st->sun_cache_latitude != st->settings.sun_latitude ||
+        st->sun_cache_longitude != st->settings.sun_longitude ||
+        st->sun_cache_sunrise_offset != st->settings.sun_sunrise_offset ||
+        st->sun_cache_sunset_offset != st->settings.sun_sunset_offset) {
+        if (!rebuild_sun_cache(st, now, &utc))
+            return false;
+    }
+    bool found = st->sun_base_target_known;
+    time_t latest = 0;
+    if (found)
+        *target = st->sun_base_target;
+    for (int i = 0; i < st->sun_transition_count; ++i) {
+        if (st->sun_transitions[i] <= now && (!found || st->sun_transitions[i] >= latest)) {
+            latest = st->sun_transitions[i];
+            *target = st->sun_transition_modes[i];
+            found = true;
+        }
+    }
+    return found;
+}
+
+bool ric_sun_poll(ric_state_t *st, time_t now)
+{
+    if (st->settings.opmode != RIC_AUTO || st->settings.automation_paused ||
+        !st->settings.sun_enabled) {
+        st->sun_target_known = false;
+        st->sun_application_ok = true;
+        return true;
+    }
+    ric_mode_t target;
+    if (!ric_sun_target_at(st, now, &target)) {
+        st->sun_target_known = false;
+        st->sun_application_ok = false;
+        return false;
+    }
+    st->sun_target = target;
+    st->sun_target_known = true;
+    st->sun_application_ok = st->current_mode == target && st->mode_confirmed ? true :
+        ric_apply_automatic_mode(st, target);
+    return st->sun_application_ok;
+}
+
+bool ric_schedule_parse_time(const char *value, int *minute)
+{
+    int hour, minutes;
+    if (!value || strlen(value) != 5 || value[2] != ':' ||
+        value[0] < '0' || value[0] > '9' || value[1] < '0' || value[1] > '9' ||
+        value[3] < '0' || value[3] > '9' || value[4] < '0' || value[4] > '9' ||
+        sscanf(value, "%d:%d", &hour, &minutes) != 2 ||
+        hour < 0 || hour > 23 || minutes < 0 || minutes > 59)
+        return false;
+    *minute = hour * 60 + minutes;
+    return true;
+}
+
+static bool schedule_format_time(int minute, char output[6])
+{
+    if (minute < 0 || minute >= 24 * 60)
+        return false;
+    int hour = minute / 60;
+    int remaining = minute % 60;
+    output[0] = (char)('0' + hour / 10);
+    output[1] = (char)('0' + hour % 10);
+    output[2] = ':';
+    output[3] = (char)('0' + remaining / 10);
+    output[4] = (char)('0' + remaining % 10);
+    output[5] = '\0';
+    return true;
+}
+
+bool ric_schedule_day_at(int start_minute, int stop_minute, int minute)
+{
+    if (start_minute == stop_minute)
+        return true;
+    if (start_minute < stop_minute)
+        return minute >= start_minute && minute < stop_minute;
+    return minute >= start_minute || minute < stop_minute;
+}
+
+bool ric_schedule_apply_minute(ric_state_t *st, int minute)
+{
+    if (st->settings.opmode != RIC_AUTO || st->settings.automation_paused ||
+        !st->settings.schedule_enabled ||
+        st->settings.sun_enabled) {
+        st->schedule_target_known = false;
+        st->schedule_application_ok = true;
+        return true;
+    }
+    ric_mode_t target = ric_schedule_day_at(st->settings.schedule_start_minute,
+        st->settings.schedule_stop_minute, minute) ? RIC_MODE_DAY : RIC_MODE_NIGHT;
+    st->schedule_target = target;
+    st->schedule_target_known = true;
+    if (st->current_mode != target || !st->mode_confirmed)
+        st->schedule_application_ok = ric_apply_automatic_mode(st, target);
+    else
+        st->schedule_application_ok = true;
+    return st->schedule_application_ok;
+}
+
+bool ric_schedule_poll(ric_state_t *st, time_t now)
+{
+    struct tm local;
+    if (now == (time_t)-1 || !localtime_r(&now, &local)) {
+        st->schedule_target_known = false;
+        st->schedule_application_ok = false;
+        return false;
+    }
+    return ric_schedule_apply_minute(st, local.tm_hour * 60 + local.tm_min);
+}
+
+int ric_get_settings(ric_state_t *st, char *response, int size)
+{
+    char start[6], stop[6];
+    if (!schedule_format_time(st->settings.schedule_start_minute, start) ||
+        !schedule_format_time(st->settings.schedule_stop_minute, stop))
+        return rss_ctrl_resp_error(response, size, "day/night schedule state invalid");
+    ric_mode_t isp_mode = RIC_MODE_DAY;
+    bool isp_available = st->settings.enabled && ric_get_isp_mode(&isp_mode);
+    bool available = st->settings.enabled &&
+        ric_verify_mode_readback(st, isp_available, isp_mode);
+    cJSON *root = cJSON_CreateObject();
+    cJSON_AddStringToObject(root, "status", "ok");
+    cJSON_AddStringToObject(root, "persistence", "checked-io");
+    cJSON_AddItemToObject(root, "thresholds", threshold_observation(st));
+    cJSON_AddBoolToObject(root, "supported", true);
+    cJSON_AddBoolToObject(root, "service_enabled", st->settings.enabled);
+    cJSON_AddBoolToObject(root, "available", available);
+    if (!st->settings.enabled)
+        cJSON_AddStringToObject(root, "reason", "disabled");
+    cJSON_AddStringToObject(root, "mode", mode_name(st->settings.opmode));
+    cJSON_AddBoolToObject(root, "ir850_at_night", st->settings.ir850_enabled);
+    cJSON *automation = cJSON_AddObjectToObject(root, "automation");
+    cJSON_AddBoolToObject(automation, "supported", true);
+    cJSON_AddBoolToObject(automation, "available", st->settings.enabled);
+    cJSON_AddBoolToObject(automation, "paused", st->settings.automation_paused);
+    cJSON *outputs = cJSON_AddObjectToObject(root, "automatic_outputs");
+    cJSON_AddBoolToObject(outputs, "supported", true);
+    cJSON_AddBoolToObject(outputs, "available", st->settings.enabled);
+    cJSON_AddBoolToObject(outputs, "color", st->settings.auto_color);
+    cJSON_AddBoolToObject(outputs, "ircut", st->settings.auto_ircut);
+    const char *color_owner = !st->settings.enabled ? "disabled" :
+        st->settings.opmode == RIC_AUTO && !st->settings.automation_paused &&
+        st->settings.auto_color ? "automatic" : "manual";
+    const char *ircut_owner = !st->settings.enabled ? "disabled" :
+        st->settings.opmode == RIC_AUTO && !st->settings.automation_paused &&
+        st->settings.auto_ircut ? "automatic" : "manual";
+    cJSON_AddStringToObject(outputs, "color_owner", color_owner);
+    cJSON_AddStringToObject(outputs, "ircut_owner", ircut_owner);
+    if (isp_available)
+        cJSON_AddStringToObject(outputs, "color_state",
+            isp_mode == RIC_MODE_DAY ? "day" : "night");
+    else
+        cJSON_AddNullToObject(outputs, "color_state");
+    if (st->settings.enabled && st->filter_state_known)
+        cJSON_AddStringToObject(outputs, "ircut_commanded_state",
+            st->filter_day ? "day" : "night");
+    else
+        cJSON_AddNullToObject(outputs, "ircut_commanded_state");
+    cJSON *confirmation = cJSON_AddObjectToObject(root, "confirmation");
+    bool confirmation_supported = st->settings.trigger != RIC_TRIGGER_PHOTO;
+    bool confirmation_available = st->settings.enabled && confirmation_supported &&
+        confirmation_count_valid(st->settings.day_confirm_count) &&
+        confirmation_count_valid(st->settings.night_confirm_count);
+    cJSON_AddBoolToObject(confirmation, "supported", confirmation_supported);
+    cJSON_AddBoolToObject(confirmation, "available", confirmation_available);
+    if (confirmation_available) {
+        cJSON *confirmation_values = cJSON_AddObjectToObject(confirmation, "values");
+        cJSON_AddNumberToObject(confirmation_values, "day", st->settings.day_confirm_count);
+        cJSON_AddNumberToObject(confirmation_values, "night", st->settings.night_confirm_count);
+    } else {
+        cJSON_AddNullToObject(confirmation, "values");
+    }
+    cJSON *loglevel = cJSON_AddObjectToObject(root, "loglevel");
+    cJSON_AddBoolToObject(loglevel, "supported", true);
+    cJSON_AddBoolToObject(loglevel, "available", st->settings.enabled &&
+        rss_log_get_level() == st->settings.loglevel);
+    cJSON_AddStringToObject(loglevel, "value", loglevel_name(rss_log_get_level()));
+    cJSON *startup = cJSON_AddObjectToObject(root, "startup");
+    cJSON_AddBoolToObject(startup, "supported", true);
+    cJSON_AddBoolToObject(startup, "available", st->settings.enabled);
+    cJSON_AddStringToObject(startup, "configured",
+        ric_initial_mode_name(st->settings.initial_mode));
+    cJSON_AddStringToObject(startup, "boot_active",
+        ric_initial_mode_name(st->boot_initial_mode));
+    cJSON *schedule = cJSON_AddObjectToObject(root, "schedule");
+    cJSON_AddBoolToObject(schedule, "supported", true);
+    cJSON_AddBoolToObject(schedule, "available", st->settings.enabled);
+    cJSON *schedule_values = cJSON_AddObjectToObject(schedule, "values");
+    cJSON_AddBoolToObject(schedule_values, "enabled", st->settings.schedule_enabled);
+    cJSON_AddStringToObject(schedule_values, "start_at", start);
+    cJSON_AddStringToObject(schedule_values, "stop_at", stop);
+    bool schedule_active = st->settings.enabled && st->settings.opmode == RIC_AUTO &&
+        !st->settings.automation_paused && st->settings.schedule_enabled &&
+        !st->settings.sun_enabled;
+    cJSON_AddBoolToObject(schedule, "active", schedule_active);
+    if (schedule_active && st->schedule_target_known)
+        cJSON_AddStringToObject(schedule, "target",
+            st->schedule_target == RIC_MODE_DAY ? "day" : "night");
+    else
+        cJSON_AddNullToObject(schedule, "target");
+    cJSON_AddBoolToObject(schedule, "application_ok", !schedule_active ||
+        (st->schedule_target_known && st->schedule_application_ok && available &&
+         st->current_mode == st->schedule_target));
+    cJSON *sun = cJSON_AddObjectToObject(root, "sun");
+    cJSON_AddBoolToObject(sun, "supported", true);
+    cJSON_AddBoolToObject(sun, "available", st->settings.enabled);
+    cJSON *sun_values = cJSON_AddObjectToObject(sun, "values");
+    cJSON_AddBoolToObject(sun_values, "enabled", st->settings.sun_enabled);
+    cJSON_AddNumberToObject(sun_values, "latitude", st->settings.sun_latitude);
+    cJSON_AddNumberToObject(sun_values, "longitude", st->settings.sun_longitude);
+    cJSON_AddNumberToObject(sun_values, "sunrise_offset", st->settings.sun_sunrise_offset);
+    cJSON_AddNumberToObject(sun_values, "sunset_offset", st->settings.sun_sunset_offset);
+    bool sun_active = st->settings.enabled && st->settings.opmode == RIC_AUTO &&
+        !st->settings.automation_paused && st->settings.sun_enabled;
+    cJSON_AddBoolToObject(sun, "active", sun_active);
+    if (sun_active && st->sun_target_known)
+        cJSON_AddStringToObject(sun, "target", st->sun_target == RIC_MODE_DAY ? "day" : "night");
+    else
+        cJSON_AddNullToObject(sun, "target");
+    cJSON_AddBoolToObject(sun, "application_ok", !sun_active ||
+        (st->sun_target_known && st->sun_application_ok && available &&
+         st->current_mode == st->sun_target));
+    if (!sun_active || !st->sun_target_known)
+        cJSON_AddNullToObject(sun, "condition");
+    else if (st->sun_condition == RIC_SUN_POLAR_DAY)
+        cJSON_AddStringToObject(sun, "condition", "polar_day");
+    else if (st->sun_condition == RIC_SUN_POLAR_NIGHT)
+        cJSON_AddStringToObject(sun, "condition", "polar_night");
+    else
+        cJSON_AddStringToObject(sun, "condition", "normal");
+    cJSON *timing = cJSON_AddObjectToObject(root, "timing");
+    bool transition_supported = st->settings.trigger != RIC_TRIGGER_PHOTO;
+    bool timing_available = st->settings.enabled &&
+        poll_interval_valid(st->settings.poll_interval_ms) &&
+        (!transition_supported || transition_delay_valid(st->settings.hysteresis_sec));
+    cJSON_AddBoolToObject(timing, "supported", true);
+    cJSON_AddBoolToObject(timing, "available", timing_available);
+    cJSON_AddBoolToObject(timing, "transition_delay_supported", transition_supported);
+    if (timing_available) {
+        cJSON *values = cJSON_AddObjectToObject(timing, "values");
+        cJSON_AddNumberToObject(values, "sample_interval_ms", st->settings.poll_interval_ms);
+        if (transition_supported)
+            cJSON_AddNumberToObject(values, "transition_delay_s", st->settings.hysteresis_sec);
+        else
+            cJSON_AddNullToObject(values, "transition_delay_s");
+    } else {
+        cJSON_AddNullToObject(timing, "values");
+    }
+    if (available)
+        cJSON_AddStringToObject(root, "state", st->current_mode == RIC_MODE_DAY ? "day" : "night");
+    else
+        cJSON_AddNullToObject(root, "state");
+    return rss_ctrl_resp_json(response, size, root);
+}
+
+int ric_set_settings(ric_state_t *st, const char *json, char *response, int size)
+{
+    cJSON *root = cJSON_ParseWithOpts(json, NULL, true);
+    cJSON *cmd = cJSON_GetObjectItemCaseSensitive(root, "cmd");
+    cJSON *mode = cJSON_GetObjectItemCaseSensitive(root, "mode");
+    cJSON *timing = cJSON_GetObjectItemCaseSensitive(root, "timing");
+    cJSON *schedule = cJSON_GetObjectItemCaseSensitive(root, "schedule");
+    cJSON *sun = cJSON_GetObjectItemCaseSensitive(root, "sun");
+    cJSON *ir850 = cJSON_GetObjectItemCaseSensitive(root, "ir850_at_night");
+    cJSON *automation = cJSON_GetObjectItemCaseSensitive(root, "automation");
+    cJSON *outputs = cJSON_GetObjectItemCaseSensitive(root, "automatic_outputs");
+    cJSON *confirmation = cJSON_GetObjectItemCaseSensitive(root, "confirmation");
+    cJSON *loglevel = cJSON_GetObjectItemCaseSensitive(root, "loglevel");
+    int poll_interval_ms = st->settings.poll_interval_ms;
+    int hysteresis_sec = st->settings.hysteresis_sec;
+    bool set_poll = false, set_delay = false;
+    bool has_timing = timing != NULL;
+    bool has_schedule = schedule != NULL;
+    bool has_sun = sun != NULL;
+    bool has_ir850 = ir850 != NULL;
+    bool has_automation = automation != NULL;
+    bool has_outputs = outputs != NULL;
+    bool has_confirmation = confirmation != NULL;
+    bool has_loglevel = loglevel != NULL;
+    bool automation_paused = st->settings.automation_paused;
+    bool auto_color = st->settings.auto_color;
+    bool auto_ircut = st->settings.auto_ircut;
+    int day_confirm_count = st->settings.day_confirm_count;
+    int night_confirm_count = st->settings.night_confirm_count;
+    rss_log_level_t requested_loglevel = st->settings.loglevel;
+    bool ir850_enabled = st->settings.ir850_enabled;
+    bool schedule_enabled = st->settings.schedule_enabled;
+    int schedule_start = st->settings.schedule_start_minute;
+    int schedule_stop = st->settings.schedule_stop_minute;
+    bool sun_enabled = st->settings.sun_enabled;
+    double sun_latitude = st->settings.sun_latitude;
+    double sun_longitude = st->settings.sun_longitude;
+    int sun_sunrise_offset = st->settings.sun_sunrise_offset;
+    int sun_sunset_offset = st->settings.sun_sunset_offset;
+    bool valid = cJSON_IsObject(root) &&
+        cJSON_GetArraySize(root) == 2 + (int)has_timing + (int)has_schedule + (int)has_sun +
+            (int)has_ir850 + (int)has_automation + (int)has_outputs +
+            (int)has_confirmation + (int)has_loglevel &&
+        cJSON_IsString(cmd) && strcmp(cmd->valuestring, "set-daynight-settings") == 0 &&
+        cJSON_IsString(mode);
+    if (valid && has_ir850) {
+        valid = cJSON_IsBool(ir850);
+        if (valid)
+            ir850_enabled = cJSON_IsTrue(ir850);
+    }
+    if (valid && has_automation) {
+        const cJSON *paused = cJSON_GetObjectItemCaseSensitive(automation, "paused");
+        valid = cJSON_IsObject(automation) && cJSON_GetArraySize(automation) == 1 &&
+            cJSON_IsBool(paused);
+        if (valid)
+            automation_paused = cJSON_IsTrue(paused);
+    }
+    if (valid && has_outputs) {
+        const cJSON *color = cJSON_GetObjectItemCaseSensitive(outputs, "color");
+        const cJSON *ircut = cJSON_GetObjectItemCaseSensitive(outputs, "ircut");
+        valid = cJSON_IsObject(outputs) && cJSON_GetArraySize(outputs) == 2 &&
+            cJSON_IsBool(color) && cJSON_IsBool(ircut);
+        if (valid) {
+            auto_color = cJSON_IsTrue(color);
+            auto_ircut = cJSON_IsTrue(ircut);
+        }
+    }
+    if (valid && has_confirmation) {
+        const cJSON *day = cJSON_GetObjectItemCaseSensitive(confirmation, "day");
+        const cJSON *night = cJSON_GetObjectItemCaseSensitive(confirmation, "night");
+        valid = st->settings.trigger != RIC_TRIGGER_PHOTO && cJSON_IsObject(confirmation) &&
+            cJSON_GetArraySize(confirmation) == 2 && cJSON_IsNumber(day) &&
+            day->valuedouble == day->valueint && cJSON_IsNumber(night) &&
+            night->valuedouble == night->valueint && confirmation_count_valid(day->valueint) &&
+            confirmation_count_valid(night->valueint);
+        if (valid) {
+            day_confirm_count = day->valueint;
+            night_confirm_count = night->valueint;
+        }
+    }
+    if (valid && has_loglevel)
+        valid = cJSON_IsString(loglevel) && loglevel_parse(loglevel->valuestring,
+            &requested_loglevel);
+    if (valid && has_timing) {
+        const cJSON *poll = cJSON_GetObjectItemCaseSensitive(timing, "sample_interval_ms");
+        const cJSON *delay = cJSON_GetObjectItemCaseSensitive(timing, "transition_delay_s");
+        int count = cJSON_GetArraySize(timing);
+        set_poll = poll != NULL;
+        set_delay = delay != NULL;
+        valid = cJSON_IsObject(timing) && count >= 1 && count <= 2 &&
+            count == (int)set_poll + (int)set_delay &&
+            (!set_poll || (cJSON_IsNumber(poll) && poll->valuedouble == poll->valueint)) &&
+            (!set_delay || (cJSON_IsNumber(delay) && delay->valuedouble == delay->valueint));
+        if (valid && set_poll)
+            poll_interval_ms = poll->valueint;
+        if (valid && set_delay)
+            hysteresis_sec = delay->valueint;
+        valid = valid && poll_interval_valid(poll_interval_ms) &&
+            (!set_delay || (st->settings.trigger != RIC_TRIGGER_PHOTO &&
+                            transition_delay_valid(hysteresis_sec)));
+    }
+    if (valid && has_schedule) {
+        const cJSON *enabled = cJSON_GetObjectItemCaseSensitive(schedule, "enabled");
+        const cJSON *start_at = cJSON_GetObjectItemCaseSensitive(schedule, "start_at");
+        const cJSON *stop_at = cJSON_GetObjectItemCaseSensitive(schedule, "stop_at");
+        valid = cJSON_IsObject(schedule) && cJSON_GetArraySize(schedule) == 3 &&
+            cJSON_IsBool(enabled) && cJSON_IsString(start_at) && cJSON_IsString(stop_at) &&
+            ric_schedule_parse_time(start_at->valuestring, &schedule_start) &&
+            ric_schedule_parse_time(stop_at->valuestring, &schedule_stop);
+        if (valid)
+            schedule_enabled = cJSON_IsTrue(enabled);
+    }
+    if (valid && has_sun) {
+        const cJSON *enabled = cJSON_GetObjectItemCaseSensitive(sun, "enabled");
+        const cJSON *latitude = cJSON_GetObjectItemCaseSensitive(sun, "latitude");
+        const cJSON *longitude = cJSON_GetObjectItemCaseSensitive(sun, "longitude");
+        const cJSON *sunrise_offset = cJSON_GetObjectItemCaseSensitive(sun, "sunrise_offset");
+        const cJSON *sunset_offset = cJSON_GetObjectItemCaseSensitive(sun, "sunset_offset");
+        valid = cJSON_IsObject(sun) && cJSON_GetArraySize(sun) == 5 &&
+            cJSON_IsBool(enabled) && cJSON_IsNumber(latitude) && cJSON_IsNumber(longitude) &&
+            cJSON_IsNumber(sunrise_offset) && cJSON_IsNumber(sunset_offset) &&
+            isfinite(latitude->valuedouble) && isfinite(longitude->valuedouble) &&
+            sunrise_offset->valuedouble == sunrise_offset->valueint &&
+            sunset_offset->valuedouble == sunset_offset->valueint;
+        if (valid) {
+            sun_enabled = cJSON_IsTrue(enabled);
+            sun_latitude = latitude->valuedouble;
+            sun_longitude = longitude->valuedouble;
+            sun_sunrise_offset = sunrise_offset->valueint;
+            sun_sunset_offset = sunset_offset->valueint;
+            valid = sun_values_valid(sun_latitude, sun_longitude, sun_sunrise_offset,
+                sun_sunset_offset);
+        }
+    }
+    valid = valid && !(schedule_enabled && sun_enabled);
+    ric_opmode_t desired = RIC_AUTO;
+    if (valid) {
+        if (strcmp(mode->valuestring, "day") == 0)
+            desired = RIC_FORCE_DAY;
+        else if (strcmp(mode->valuestring, "night") == 0)
+            desired = RIC_FORCE_NIGHT;
+        else if (strcmp(mode->valuestring, "auto") != 0)
+            valid = false;
+    }
+    cJSON_Delete(root);
+    if (!valid)
+        return rss_ctrl_resp_error(response, size, "expected auto, day or night mode");
+    char start[6], stop[6];
+    if (has_schedule && (!schedule_format_time(schedule_start, start) ||
+        !schedule_format_time(schedule_stop, stop)))
+        return rss_ctrl_resp_error(response, size, "day/night schedule state invalid");
+    bool paused_auto = desired == RIC_AUTO &&
+        (st->settings.automation_paused || (has_automation && automation_paused));
+    bool preserve_preview = has_ir850 && desired == st->settings.opmode &&
+        st->mode_confirmed && ric_verify_mode(st);
+    if (preserve_preview || paused_auto) {
+        const char *name = mode_name(desired);
+        rss_config_set_str(st->cfg, "ircut", "mode", name);
+        if (strcmp(rss_config_get_str(st->cfg, "ircut", "mode", ""), name) != 0)
+            return rss_ctrl_resp_error(response, size, "day/night policy cache failed");
+        st->settings.opmode = desired;
+    } else if (!ric_set_policy(st, desired)) {
+        return rss_ctrl_resp_error(response, size, "day/night application or cache failed");
+    }
+    if (has_ir850) {
+        bool previous = st->settings.ir850_enabled;
+        rss_config_set_bool(st->cfg, "ircut", "ir850", ir850_enabled);
+        if (rss_config_get_bool(st->cfg, "ircut", "ir850", !ir850_enabled) != ir850_enabled ||
+            !ric_set_ir850_at_night(st, ir850_enabled)) {
+            rss_config_set_bool(st->cfg, "ircut", "ir850", previous);
+            if (rss_config_get_bool(st->cfg, "ircut", "ir850", !previous) != previous)
+                st->mode_confirmed = false;
+            return rss_ctrl_resp_error(response, size, "day/night ir850 policy application or cache failed");
+        }
+    }
+    bool pause_changed = has_automation &&
+        automation_paused != st->settings.automation_paused;
+    if (has_automation) {
+        rss_config_set_bool(st->cfg, "ircut", "automation_paused", automation_paused);
+        if (rss_config_get_bool(st->cfg, "ircut", "automation_paused", !automation_paused) !=
+            automation_paused)
+            return rss_ctrl_resp_error(response, size, "day/night automation cache failed");
+        st->settings.automation_paused = automation_paused;
+    }
+    if (has_outputs) {
+        rss_config_set_bool(st->cfg, "ircut", "auto_color", auto_color);
+        rss_config_set_bool(st->cfg, "ircut", "auto_ircut", auto_ircut);
+        if (rss_config_get_bool(st->cfg, "ircut", "auto_color", !auto_color) != auto_color ||
+            rss_config_get_bool(st->cfg, "ircut", "auto_ircut", !auto_ircut) != auto_ircut)
+            return rss_ctrl_resp_error(response, size, "day/night automatic output cache failed");
+        st->settings.auto_color = auto_color;
+        st->settings.auto_ircut = auto_ircut;
+        /* A confirmation made under narrower automatic ownership cannot prove
+         * an output that has just rejoined the automatic policy. */
+        if (!ric_verify_mode(st))
+            st->mode_confirmed = false;
+    }
+    if (has_confirmation) {
+        rss_config_set_int(st->cfg, "ircut", "day_confirm_count", day_confirm_count);
+        rss_config_set_int(st->cfg, "ircut", "night_confirm_count", night_confirm_count);
+        if (rss_config_get_int(st->cfg, "ircut", "day_confirm_count", -1) != day_confirm_count ||
+            rss_config_get_int(st->cfg, "ircut", "night_confirm_count", -1) != night_confirm_count)
+            return rss_ctrl_resp_error(response, size, "day/night confirmation cache failed");
+        st->settings.day_confirm_count = day_confirm_count;
+        st->settings.night_confirm_count = night_confirm_count;
+    }
+    if (has_loglevel) {
+        const char *name = loglevel_name(requested_loglevel);
+        rss_config_set_str(st->cfg, "ircut", "loglevel", name);
+        if (strcmp(rss_config_get_str(st->cfg, "ircut", "loglevel", ""), name) != 0)
+            return rss_ctrl_resp_error(response, size, "RIC log level cache failed");
+        st->settings.loglevel = requested_loglevel;
+        rss_log_set_level(requested_loglevel);
+        if (rss_log_get_level() != requested_loglevel)
+            return rss_ctrl_resp_error(response, size, "RIC log level application failed");
+    }
+    bool automatic_owner_before_update = st->settings.opmode == RIC_AUTO &&
+        (st->settings.schedule_enabled || st->settings.sun_enabled);
+    if (has_timing) {
+        if (set_poll)
+            rss_config_set_int(st->cfg, "ircut", "poll_interval_ms", poll_interval_ms);
+        if (set_delay)
+            rss_config_set_int(st->cfg, "ircut", "hysteresis_sec", hysteresis_sec);
+        if ((set_poll && rss_config_get_int(st->cfg, "ircut", "poll_interval_ms", -1) != poll_interval_ms) ||
+            (set_delay && rss_config_get_int(st->cfg, "ircut", "hysteresis_sec", -1) != hysteresis_sec))
+            return rss_ctrl_resp_error(response, size, "day/night timing cache failed");
+        st->settings.poll_interval_ms = poll_interval_ms;
+        st->settings.hysteresis_sec = hysteresis_sec;
+        st->day_count = 0;
+        st->night_count = 0;
+        st->day_condition_since_us = 0;
+        st->night_condition_since_us = 0;
+    }
+    if (has_schedule) {
+        rss_config_set_bool(st->cfg, "ircut", "schedule_enabled", schedule_enabled);
+        rss_config_set_str(st->cfg, "ircut", "schedule_start", start);
+        rss_config_set_str(st->cfg, "ircut", "schedule_stop", stop);
+        if (rss_config_get_bool(st->cfg, "ircut", "schedule_enabled", !schedule_enabled) != schedule_enabled ||
+            strcmp(rss_config_get_str(st->cfg, "ircut", "schedule_start", ""), start) != 0 ||
+            strcmp(rss_config_get_str(st->cfg, "ircut", "schedule_stop", ""), stop) != 0)
+            return rss_ctrl_resp_error(response, size, "day/night schedule cache failed");
+        st->settings.schedule_enabled = schedule_enabled;
+        st->settings.schedule_start_minute = schedule_start;
+        st->settings.schedule_stop_minute = schedule_stop;
+    }
+    if (has_sun) {
+        /* Seventeen significant digits round-trip an IEEE-754 double. Even a
+         * signed subnormal with a three-digit exponent fits in 25 bytes, so the
+         * 32-byte coordinate buffers leave room for the terminator. */
+        char latitude[32], longitude[32];
+        int latitude_length = snprintf(latitude, sizeof(latitude), "%.17g", sun_latitude);
+        int longitude_length = snprintf(longitude, sizeof(longitude), "%.17g", sun_longitude);
+        if (latitude_length < 0 || latitude_length >= (int)sizeof(latitude) ||
+            longitude_length < 0 || longitude_length >= (int)sizeof(longitude))
+            return rss_ctrl_resp_error(response, size, "day/night solar coordinate encoding failed");
+        rss_config_set_bool(st->cfg, "ircut", "sun_enabled", sun_enabled);
+        rss_config_set_str(st->cfg, "ircut", "sun_latitude", latitude);
+        rss_config_set_str(st->cfg, "ircut", "sun_longitude", longitude);
+        rss_config_set_int(st->cfg, "ircut", "sunrise_offset", sun_sunrise_offset);
+        rss_config_set_int(st->cfg, "ircut", "sunset_offset", sun_sunset_offset);
+        double cached_latitude = 0.0, cached_longitude = 0.0;
+        if (rss_config_get_bool(st->cfg, "ircut", "sun_enabled", !sun_enabled) != sun_enabled ||
+            !parse_config_double(st->cfg, "sun_latitude", &cached_latitude) ||
+            !parse_config_double(st->cfg, "sun_longitude", &cached_longitude) ||
+            cached_latitude != sun_latitude || cached_longitude != sun_longitude ||
+            rss_config_get_int(st->cfg, "ircut", "sunrise_offset", INT_MIN) != sun_sunrise_offset ||
+            rss_config_get_int(st->cfg, "ircut", "sunset_offset", INT_MIN) != sun_sunset_offset)
+            return rss_ctrl_resp_error(response, size, "day/night solar cache failed");
+        st->settings.sun_enabled = sun_enabled;
+        st->settings.sun_latitude = sun_latitude;
+        st->settings.sun_longitude = sun_longitude;
+        st->settings.sun_sunrise_offset = sun_sunrise_offset;
+        st->settings.sun_sunset_offset = sun_sunset_offset;
+        st->sun_cache_valid = false;
+    }
+    bool automatic_owner_after_update = st->settings.opmode == RIC_AUTO &&
+        (st->settings.schedule_enabled || st->settings.sun_enabled);
+    if (automatic_owner_after_update != automatic_owner_before_update || has_schedule || has_sun ||
+        pause_changed || has_outputs || has_confirmation) {
+        reset_detection_evidence(st);
+        st->schedule_target_known = false;
+        st->schedule_application_ok = !st->settings.schedule_enabled;
+        st->sun_target_known = false;
+        st->sun_application_ok = !st->settings.sun_enabled;
+    }
+    if (st->settings.opmode == RIC_AUTO && st->settings.automation_paused) {
+        /* Manual mode and output commands remain available while paused. */
+    } else if (st->settings.opmode == RIC_AUTO && st->settings.sun_enabled) {
+        if (!ric_sun_poll(st, time(NULL)))
+            return rss_ctrl_resp_error(response, size, "day/night solar application failed");
+    } else if (st->settings.opmode == RIC_AUTO && st->settings.schedule_enabled) {
+        if (!ric_schedule_poll(st, time(NULL)))
+            return rss_ctrl_resp_error(response, size, "day/night schedule application failed");
+    } else if (st->settings.opmode == RIC_AUTO && (has_outputs || pause_changed)) {
+        if (!ric_verify_mode(st) && !ric_apply_automatic_mode(st, st->current_mode))
+            return rss_ctrl_resp_error(response, size,
+                "day/night automatic output application failed");
+    } else {
+        ric_schedule_apply_minute(st, 0);
+    }
+    return rss_ctrl_resp_ok(response, size);
+}
+
+
+bool ric_set_policy(ric_state_t *st, ric_opmode_t desired)
+{
+    if (desired != RIC_AUTO && desired != RIC_FORCE_DAY && desired != RIC_FORCE_NIGHT)
+        return false;
+    bool automatic_owner_was_active = st->settings.opmode == RIC_AUTO &&
+        (st->settings.schedule_enabled || st->settings.sun_enabled);
+    if (desired == RIC_AUTO && st->settings.automation_paused) {
+        st->settings.opmode = desired;
+        reset_detection_evidence(st);
+        st->schedule_target_known = false;
+        st->sun_target_known = false;
+        rss_config_set_str(st->cfg, "ircut", "mode", "auto");
+        return strcmp(rss_config_get_str(st->cfg, "ircut", "mode", ""), "auto") == 0;
+    }
+    ric_mode_t target = desired == RIC_FORCE_NIGHT ? RIC_MODE_NIGHT : RIC_MODE_DAY;
+    if (desired == RIC_AUTO && st->current_mode == RIC_MODE_NIGHT)
+        target = RIC_MODE_NIGHT;
+    /* Equal policy still needs fresh output and ISP checks. Repair its cache
+     * below without actuating a filter whose current state was verified. */
+    bool confirmed = !st->filter_manual && !st->ir850_manual &&
+        desired == st->settings.opmode && st->current_mode == target &&
+        ric_verify_mode(st);
+    if (!confirmed) {
+        st->mode_confirmed = false;
+        if (!(desired == RIC_AUTO ? ric_apply_automatic_mode(st, target) :
+              ric_apply_mode(st, target)))
+            return false;
+    }
+    if (!confirmed && desired == RIC_AUTO && st->settings.trigger == RIC_TRIGGER_PHOTO)
+        ric_photo_reset(&st->photo, target == RIC_MODE_NIGHT ? PHOTO_PHASE_DAY_DETECT : PHOTO_PHASE_NIGHT_DETECT);
+    st->settings.opmode = desired;
+    bool automatic_owner_is_active = st->settings.opmode == RIC_AUTO &&
+        (st->settings.schedule_enabled || st->settings.sun_enabled);
+    if (automatic_owner_is_active != automatic_owner_was_active) {
+        reset_detection_evidence(st);
+        st->schedule_target_known = false;
+        st->schedule_application_ok = !st->settings.schedule_enabled;
+        st->sun_target_known = false;
+        st->sun_application_ok = !st->settings.sun_enabled;
+    }
+    const char *name = mode_name(desired);
+    rss_config_set_str(st->cfg, "ircut", "mode", name);
+    if (strcmp(rss_config_get_str(st->cfg, "ircut", "mode", ""), name) != 0)
+        return false;
+    return true;
+}
