+int rvd_osd_apply_snapshot(rvd_state_t *st, const char *json, char *resp, int size)
+{
+    struct snapshot {
+        int stream;
+        const char *name;
+        uint32_t width, height, hash;
+        rvd_osd_region_t *region;
+        const uint8_t *bitmap;
+    } snapshots[32];
+    cJSON *root = cJSON_ParseWithOpts(json, NULL, true);
+    cJSON *command = cJSON_GetObjectItemCaseSensitive(root, "cmd");
+    cJSON *id = cJSON_GetObjectItemCaseSensitive(root, "id");
+    cJSON *regions = cJSON_GetObjectItemCaseSensitive(root, "regions");
+    int count = cJSON_GetArraySize(regions);
+    bool check_only = cJSON_IsString(command) && strcmp(command->valuestring, "osd-check-snapshot") == 0;
+    bool valid = cJSON_IsObject(root) && cJSON_GetArraySize(root) == 3 &&
+        cJSON_IsString(command) && (check_only || strcmp(command->valuestring, "osd-apply-snapshot") == 0) &&
+        cJSON_IsString(id) && strlen(id->valuestring) > 0 && strlen(id->valuestring) < sizeof(st->osd_apply_id) &&
+        cJSON_IsArray(regions) && count > 0 && count <= 32;
+    if (valid) {
+        for (const char *p = id->valuestring; *p; ++p) {
+            if (!((*p >= '0' && *p <= '9') || (*p >= 'a' && *p <= 'f')))
+                valid = false;
+        }
+    }
+    size_t total = 0;
+    for (int i = 0; valid && i < count; ++i) {
+        cJSON *entry = cJSON_GetArrayItem(regions, i);
+        cJSON *stream = cJSON_GetObjectItemCaseSensitive(entry, "stream");
+        cJSON *name = cJSON_GetObjectItemCaseSensitive(entry, "name");
+        cJSON *width = cJSON_GetObjectItemCaseSensitive(entry, "width");
+        cJSON *height = cJSON_GetObjectItemCaseSensitive(entry, "height");
+        cJSON *hash = cJSON_GetObjectItemCaseSensitive(entry, "hash");
+        valid = cJSON_IsObject(entry) && cJSON_GetArraySize(entry) == 5 &&
+            cJSON_IsNumber(stream) && stream->valuedouble == stream->valueint &&
+            stream->valueint >= 0 && stream->valueint < 2 &&
+            cJSON_IsString(name) && name->valuestring[0] && strlen(name->valuestring) < RVD_OSD_NAME_LEN &&
+            strcmp(name->valuestring, "privacy") != 0 && strcmp(name->valuestring, "detect") != 0 &&
+            cJSON_IsNumber(width) && width->valuedouble == width->valueint && width->valueint > 0 && width->valueint <= 4096 &&
+            cJSON_IsNumber(height) && height->valuedouble == height->valueint && height->valueint > 0 && height->valueint <= 4096 &&
+            cJSON_IsNumber(hash) && hash->valuedouble >= 0 && hash->valuedouble <= UINT32_MAX &&
+            hash->valuedouble == (double)(uint32_t)hash->valuedouble;
+        if (!valid)
+            break;
+        snapshots[i] = (struct snapshot){.stream = stream->valueint, .name = name->valuestring,
+            .width = (uint32_t)width->valueint, .height = (uint32_t)height->valueint,
+            .hash = (uint32_t)hash->valuedouble};
+        total += (size_t)snapshots[i].width * snapshots[i].height * 4;
+        if (total > 512 * 1024)
+            valid = false;
+        for (int j = 0; j < i; ++j) {
+            if (snapshots[j].stream == snapshots[i].stream && strcmp(snapshots[j].name, snapshots[i].name) == 0)
+                valid = false;
+        }
+    }
+    if (!valid || !st->osd_enabled || !atomic_load(&st->pipeline_ready)) {
+        cJSON_Delete(root);
+        return rss_ctrl_resp_error(resp, size, "invalid or unavailable OSD snapshot");
+    }
+    if (pthread_mutex_lock(&st->osd_lock) != 0) {
+        cJSON_Delete(root);
+        return rss_ctrl_resp_error(resp, size, "OSD owner lock failed");
+    }
+    /* Preflight every region before any SDK call. ROD may resume publishing
+     * after its IPC timeout, so SHM hashes alone cannot establish acceptance. */
+    for (int i = 0; valid && i < count; ++i) {
+        struct snapshot *item = &snapshots[i];
+        int s = item->stream;
+        char section[16];
+        snprintf(section, sizeof(section), "stream%d", s);
+        if (s >= st->stream_count || st->streams[s].is_jpeg ||
+            strcmp(st->streams[s].cfg_sect, section) != 0) {
+            valid = false;
+            break;
+        }
+        rvd_osd_region_t *reg = rvd_osd_find_region(st, s, item->name);
+        /* Merged virtual regions need separate composition acceptance. */
+        if (!reg || !reg->active || reg->hal_handle < 0 || !reg->shm || !reg->local_buf ||
+            reg->width != item->width || reg->height != item->height) {
+            valid = false;
+            break;
+        }
+        uint32_t width = 0, height = 0;
+        item->bitmap = rss_osd_get_active_buffer(reg->shm, &width, &height);
+        item->region = reg;
+        if (!item->bitmap || width != item->width || height != item->height ||
+            osd_snapshot_hash(item->bitmap, (size_t)width * height * 4) != item->hash)
+            valid = false;
+    }
+    if (valid && !check_only) {
+        st->osd_apply_id[0] = '\0';
+        atomic_store(&st->osd_apply_failed, true);
+        /* Freeze and validate every local copy before the first SDK submit.
+         * The OSD lock protects these buffers from other RVD updates. A timed
+         * out ROD may change SHM during copying; only the copied bytes count. */
+        for (int i = 0; valid && i < count; ++i) {
+            struct snapshot *item = &snapshots[i];
+            size_t bytes = (size_t)item->width * item->height * 4;
+            memcpy(item->region->local_buf, item->bitmap, bytes);
+            if (osd_snapshot_hash(item->region->local_buf, bytes) != item->hash)
+                valid = false;
+        }
+        for (int i = 0; valid && i < count; ++i) {
+            struct snapshot *item = &snapshots[i];
+            rvd_osd_region_t *reg = item->region;
+            int s = item->stream;
+            int ret = push_region(st, s, reg);
+            if (ret == RSS_OK) {
+                ret = STREAM_ISP_OSD(st, s)
+                    ? RSS_HAL_CALL(st->ops, isp_osd_show_region, st->hal_ctx,
+                                   st->streams[s].sensor_idx, reg->hal_handle, 1)
+                    : RSS_HAL_CALL(st->ops, osd_show_region, st->hal_ctx,
+                                   reg->hal_handle, st->streams[s].chn, 1, reg->layer + 1);
+            }
+            if (ret != RSS_OK) {
+                valid = false;
+                break;
+            }
+            reg->shown = true;
+        }
+        if (valid) {
+            rss_strlcpy(st->osd_apply_id, id->valuestring, sizeof(st->osd_apply_id));
+            atomic_store(&st->osd_apply_failed, false);
+        }
+    }
+    pthread_mutex_unlock(&st->osd_lock);
+    cJSON_Delete(root);
+    return valid ? rss_ctrl_resp_ok(resp, size) :
+        rss_ctrl_resp_error(resp, size, "OSD snapshot apply was not confirmed");
+}
+
+
+int rvd_privacy_load(rvd_state_t *st)
+{
+    bool enabled = true;
+    if (rss_config_privacy(st->cfg, &enabled) != 0)
+        return RSS_ERR_INVAL;
+    for (int i = 0; i < RVD_MAX_STREAMS; ++i)
+        st->privacy_requested[i] = enabled;
+    return RSS_OK;
+}
+
+int rvd_privacy_prepare_stream(rvd_state_t *st, int stream)
+{
+    if (stream < 0 || stream >= st->stream_count)
+        return RSS_ERR_INVAL;
+    if (pthread_mutex_lock(&st->osd_lock) != 0)
+        return RSS_ERR;
+    int parent = stream;
+    if (st->streams[stream].is_jpeg) {
+        parent = -1;
+        for (int i = 0; i < st->stream_count; ++i) {
+            if (!st->streams[i].is_jpeg && st->streams[i].fs_chn == st->streams[stream].fs_chn) {
+                parent = i;
+                break;
+            }
+        }
+    }
+    int result = RSS_OK;
+    if (parent < 0) {
+        result = RSS_ERR;
+    } else if (st->privacy_requested[parent]) {
+        if (!st->osd_enabled || !st->privacy_target_ready[parent]) {
+            result = RSS_ERR_NOTSUP;
+        } else if (parent != stream) {
+            if (!st->privacy[parent] || st->privacy_error[parent])
+                result = RSS_ERR;
+        } else {
+            result = set_privacy_stream(st, parent, true);
+        }
+        st->privacy_error[parent] = result != RSS_OK;
+    } else if (parent == stream && st->privacy[parent]) {
+        result = set_privacy_stream(st, parent, false);
+        st->privacy_error[parent] = result != RSS_OK;
+    }
+    pthread_mutex_unlock(&st->osd_lock);
+    return result;
 }
