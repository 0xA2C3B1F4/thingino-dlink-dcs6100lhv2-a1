+	echo "usage: $0 RAPTOR_COMMON_SOURCE" >&2
+	exit 2
+fi
+: "${TMPDIR:?TMPDIR must name a writable scratch directory}"
+
+common=$1
+test_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+raptor_dir=$(CDPATH= cd -- "$test_dir/.." && pwd)
+scratch=$(mktemp -d "$TMPDIR/rod-metadata.XXXXXX")
+trap 'find "$scratch" -depth -delete' EXIT HUP INT TERM
+
+"${CC:-cc}" -std=c11 -D_GNU_SOURCE -Wall -Wextra -Werror \
+	-I"$raptor_dir/rod" -I"$common/include" \
+	"$test_dir/test_rod_metadata.c" "$raptor_dir/rod/rod_metadata.c" \
+	"$raptor_dir/osd_metadata_snapshot.c" "$common/src/rss_sei.c" \
+	-o "$scratch/test_rod_metadata"
+"$scratch/test_rod_metadata"
diff --git a/tests/test_audio_levels.c b/tests/test_audio_levels.c
new file mode 100644
index 0000000000000000000000000000000000000000..d283fb41b16d692f1fdf948b0318ec9333cc6bb8
--- /dev/null
+++ b/tests/test_audio_levels.c
@@ -0,0 +1,86 @@
+#include <assert.h>
+#include <stdbool.h>
+#include "rad_level.h"
+#include <rss_common.h>
+
+static int actual, set_error, get_error, set_calls, get_calls;
+static bool mismatch;
+static int expected_dev;
+static int set_level(void *ctx, int value)
+{
+    (void)ctx;
+    ++set_calls;
+    if (!set_error && !mismatch) actual = value;
+    return set_error;
+}
+static int get_level(void *ctx, int *value)
+{
+    (void)ctx;
+    ++get_calls;
+    if (!get_error) *value = actual;
+    return get_error;
+}
+static int ai_set(void *ctx, int dev, int chn, int value)
+{
+    assert(dev == expected_dev && chn == 0);
+    return set_level(ctx, value);
+}
+static int ai_get(void *ctx, int dev, int chn, int *value)
+{
+    assert(dev == expected_dev && chn == 0);
+    return get_level(ctx, value);
+}
+int main(void)
+{
+    rss_hal_ops_t ops = {
+        .audio_set_volume = ai_set, .audio_get_volume = ai_get,
+        .audio_set_gain = ai_set, .audio_get_gain = ai_get,
+        .ao_set_volume = set_level, .ao_get_volume = get_level,
+        .ao_set_gain = set_level, .ao_get_gain = get_level,
+    };
+    for (expected_dev = 0; expected_dev < 2; ++expected_dev) {
+    for (int output = 0; output < 2; ++output) {
+        for (int gain = 0; gain < 2; ++gain) {
+            for (int mode = 0; mode < 4; ++mode) {
+                actual = 0;
+                set_calls = get_calls = 0;
+                set_error = mode == 1 ? RSS_ERR_IO : 0;
+                get_error = mode == 2 ? RSS_ERR_IO : 0;
+                mismatch = mode == 3;
+                int result = rad_apply_level(&ops, NULL, output, gain, expected_dev, 20);
+                assert((result == RSS_OK) == (mode == 0));
+                assert(set_calls == 1);
+                assert(get_calls == (mode == 1 ? 0 : 1));
+            }
+            set_calls = get_calls = 0;
+            assert(rad_apply_level(&ops, NULL, output, gain, expected_dev, gain ? 32 : 121) != RSS_OK);
+            assert(rad_apply_level(&ops, NULL, output, gain, expected_dev, gain ? -1 : -31) != RSS_OK);
+            assert(set_calls == 0 && get_calls == 0);
+        }
+    }
+    }
+    expected_dev = 0;
+    actual = 22;
+    get_error = RSS_ERR_IO;
+    char response[4096];
+    assert(rad_audio_levels(&ops, NULL, expected_dev, true, true, response, sizeof(response)) > 0);
+    cJSON *json = cJSON_Parse(response);
+    cJSON *fields = cJSON_GetObjectItemCaseSensitive(json, "fields");
+    cJSON *field = cJSON_GetObjectItemCaseSensitive(fields, "mic_vol");
+    assert(cJSON_IsNull(cJSON_GetObjectItemCaseSensitive(field, "value")));
+    assert(cJSON_IsFalse(cJSON_GetObjectItemCaseSensitive(field, "available")));
+    cJSON_Delete(json);
+    get_error = 0;
+    assert(rad_audio_levels(&ops, NULL, expected_dev, true, false, response, sizeof(response)) > 0);
+    json = cJSON_Parse(response);
+    fields = cJSON_GetObjectItemCaseSensitive(json, "fields");
+    field = cJSON_GetObjectItemCaseSensitive(fields, "mic_vol");
+    assert(cJSON_GetObjectItemCaseSensitive(field, "value")->valueint == 22);
+    field = cJSON_GetObjectItemCaseSensitive(fields, "spk_vol");
+    assert(cJSON_IsNull(cJSON_GetObjectItemCaseSensitive(field, "value")));
+    assert(cJSON_IsFalse(cJSON_GetObjectItemCaseSensitive(field, "available")));
+    cJSON_Delete(json);
+    rss_hal_ops_t absent = {0};
+    assert(rad_apply_level(&absent, NULL, false, false, 1, 20) == RSS_ERR_NOTSUP);
+    return 0;
+}
