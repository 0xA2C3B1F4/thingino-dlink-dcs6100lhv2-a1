+static void test_gain_observation_rejects_inexact_responses(ric_state_t *st)
+{
+    static const struct {
+        const char *response;
+        int reported_length;
+    } invalid_responses[] = {
+        {"", -1},
+        /* Sender reports the response filled the 512-byte receive buffer. */
+        {"{\"status\":\"ok\",\"total_gain\":7", 511},
+        /* Returned length must describe the complete NUL-terminated response. */
+        {"{\"status\":\"ok\",\"total_gain\":7,\"ae_luma\":1}", 1},
+        {"{\"status\":\"ok\",\"total_gain\":7,\"ae_luma\":1}junk", -1},
+        {"{\"status\":\"ok\",\"total_gain\":7,\"ae_luma\":1}{}", -1},
+        {"{\"status\":\"ok\",\"total_gain\":\"7\",\"ae_luma\":1}", -1},
+        {"{\"status\":\"ok\",\"ae_luma\":1}", -1},
+        {"{\"status\":\"ok\",\"total_gain\":7}", -1},
+    };
+    uint32_t accepted_gain = st->observed_gain;
+    int64_t accepted_time = st->gain_observed_us;
+    unsigned pushes = gain_pushes;
+    ric_mode_t mode = st->current_mode;
+    st->settings.opmode = RIC_AUTO;
+    st->settings.automation_paused = false;
+    st->settings.sun_enabled = false;
+    st->settings.schedule_enabled = false;
+    st->settings.trigger = RIC_TRIGGER_LUMA;
+    for (size_t i = 0; i < sizeof(invalid_responses) / sizeof(invalid_responses[0]); ++i) {
+        exposure_response_override = invalid_responses[i].response;
+        exposure_return_override = invalid_responses[i].reported_length;
+        st->day_condition_since_us = test_now_us;
+        st->night_condition_since_us = test_now_us;
+        st->day_count = 2;
+        st->night_count = 2;
+        test_now_us += 1000000;
+        assert(!ric_observe_exposure(st, true));
+        assert(st->observed_gain == accepted_gain &&
+               st->gain_observed_us == accepted_time && gain_pushes == pushes);
+        assert(st->current_mode == mode);
+        assert(st->day_condition_since_us == 0 && st->night_condition_since_us == 0 &&
+               st->day_count == 0 && st->night_count == 0);
+    }
+    exposure_response_override = NULL;
+    exposure_return_override = -1;
+}
