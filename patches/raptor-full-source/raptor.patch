+	uint8_t dpc = 0, drc = 0, hld = 0, blc = 0, dfg = 0;
+	int hf = 0, vf = 0, ae = 0;
+	uint32_t again = 0, dgain = 0;
+	if (RSS_HAL_CALL(st->ops, isp_get_brightness, st->hal_ctx, &bri) != RSS_OK)
+		return rss_ctrl_resp_error(resp, resp_size, "ISP readback failed");
+	if (RSS_HAL_CALL(st->ops, isp_get_contrast, st->hal_ctx, &con) != RSS_OK)
+		return rss_ctrl_resp_error(resp, resp_size, "ISP readback failed");
+	if (RSS_HAL_CALL(st->ops, isp_get_saturation, st->hal_ctx, &sat) != RSS_OK)
+		return rss_ctrl_resp_error(resp, resp_size, "ISP readback failed");
+	if (RSS_HAL_CALL(st->ops, isp_get_sharpness, st->hal_ctx, &shp) != RSS_OK)
+		return rss_ctrl_resp_error(resp, resp_size, "ISP readback failed");
+	if (RSS_HAL_CALL(st->ops, isp_get_hue, st->hal_ctx, &hue) != RSS_OK)
+		return rss_ctrl_resp_error(resp, resp_size, "ISP readback failed");
+	if (RSS_HAL_CALL(st->ops, isp_get_sinter_strength, st->hal_ctx, &sin) != RSS_OK)
+		return rss_ctrl_resp_error(resp, resp_size, "ISP readback failed");
+	if (RSS_HAL_CALL(st->ops, isp_get_temper_strength, st->hal_ctx, &tem) != RSS_OK)
+		return rss_ctrl_resp_error(resp, resp_size, "ISP readback failed");
+	if (RSS_HAL_CALL(st->ops, isp_get_hvflip, st->hal_ctx, &hf, &vf) != RSS_OK)
+		return rss_ctrl_resp_error(resp, resp_size, "ISP readback failed");
+	if (RSS_HAL_CALL(st->ops, isp_get_ae_comp, st->hal_ctx, &ae) != RSS_OK)
+		return rss_ctrl_resp_error(resp, resp_size, "ISP readback failed");
+	if (RSS_HAL_CALL(st->ops, isp_get_max_again, st->hal_ctx, &again) != RSS_OK)
+		return rss_ctrl_resp_error(resp, resp_size, "ISP readback failed");
+	if (RSS_HAL_CALL(st->ops, isp_get_max_dgain, st->hal_ctx, &dgain) != RSS_OK)
+		return rss_ctrl_resp_error(resp, resp_size, "ISP readback failed");
+	if (RSS_HAL_CALL(st->ops, isp_get_dpc_strength, st->hal_ctx, &dpc) != RSS_OK)
+		return rss_ctrl_resp_error(resp, resp_size, "ISP readback failed");
+	if (RSS_HAL_CALL(st->ops, isp_get_drc_strength, st->hal_ctx, &drc) != RSS_OK)
+		return rss_ctrl_resp_error(resp, resp_size, "ISP readback failed");
+	if (RSS_HAL_CALL(st->ops, isp_get_highlight_depress, st->hal_ctx, &hld) != RSS_OK)
+		return rss_ctrl_resp_error(resp, resp_size, "ISP readback failed");
+	if (RSS_HAL_CALL(st->ops, isp_get_backlight_comp, st->hal_ctx, &blc) != RSS_OK)
+		return rss_ctrl_resp_error(resp, resp_size, "ISP readback failed");
+	if (RSS_HAL_CALL(st->ops, isp_get_defog_strength, st->hal_ctx, &dfg) != RSS_OK)
+		return rss_ctrl_resp_error(resp, resp_size, "ISP readback failed");
+	rss_wb_config_t wb = {0};
+	if (RSS_HAL_CALL(st->ops, isp_get_wb, st->hal_ctx, &wb) != RSS_OK)
+		return rss_ctrl_resp_error(resp, resp_size, "ISP readback failed");
+	cJSON *r = cJSON_CreateObject();
+	cJSON_AddStringToObject(r, "status", "ok");
+	cJSON_AddNumberToObject(r, "brightness", (double)bri);
+	cJSON_AddNumberToObject(r, "contrast", (double)con);
+	cJSON_AddNumberToObject(r, "saturation", (double)sat);
+	cJSON_AddNumberToObject(r, "sharpness", (double)shp);
+	cJSON_AddNumberToObject(r, "hue", (double)hue);
+	cJSON_AddNumberToObject(r, "sinter", (double)sin);
+	cJSON_AddNumberToObject(r, "temper", (double)tem);
+	cJSON_AddNumberToObject(r, "hflip", (double)hf);
+	cJSON_AddNumberToObject(r, "vflip", (double)vf);
+	cJSON_AddNumberToObject(r, "ae_comp", (double)ae);
+	cJSON_AddNumberToObject(r, "max_again", (double)again);
+	cJSON_AddNumberToObject(r, "max_dgain", (double)dgain);
+	cJSON_AddNumberToObject(r, "dpc_strength", (double)dpc);
+	cJSON_AddNumberToObject(r, "drc_strength", (double)drc);
+	cJSON_AddNumberToObject(r, "highlight_depress", (double)hld);
+	cJSON_AddNumberToObject(r, "backlight_comp", (double)blc);
+	cJSON_AddNumberToObject(r, "defog_strength", (double)dfg);
+	cJSON_AddStringToObject(r, "wb_mode", wb.mode == RSS_WB_MANUAL ? "manual" : "auto");
+	cJSON_AddNumberToObject(r, "wb_r", (double)wb.r_gain);
+	cJSON_AddNumberToObject(r, "wb_g", (double)wb.g_gain);
+	cJSON_AddNumberToObject(r, "wb_b", (double)wb.b_gain);
+	return rss_ctrl_resp_json(resp, resp_size, r);
+}
+
+#define IMAGE_FIELD_COUNT 15
+#define IMAGE_EXTRA_START 11
+#define IMAGE_EXPOSURE_INDEX 11
+#define IMAGE_HFLIP_INDEX 12
+#define IMAGE_VFLIP_INDEX 13
+#define IMAGE_ANTIFLICKER_INDEX 14
+#define IMAGE_SINTER_INDEX 8
+static const char *image_names[IMAGE_FIELD_COUNT] = {"brightness", "contrast", "saturation",
+    "sharpness", "backlight", "wide_dynamic_range", "tone", "defog", "noise_reduction",
+    "hue", "dpc_strength", "exposure_compensation", "hflip", "vflip", "anti_flicker"};
+static const char *image_config_names[IMAGE_FIELD_COUNT] = {"brightness", "contrast", "saturation",
+    "sharpness", "backlight_comp", "drc_strength", "highlight_depress", "defog_strength",
+    "sinter", "hue", "dpc_strength", "ae_comp", "hflip", "vflip", "antiflicker"};
+static const int image_maximum[IMAGE_FIELD_COUNT] = {
+    255, 255, 255, 255, 10, 255, 255, 255, 255, 255, 255, 255, 1, 1, 2};
+static const int image_defaults[IMAGE_FIELD_COUNT] = {
+    128, 128, 128, 128, 0, 128, 0, 128, 128, 128, 128, 128, 0, 0, 2};
+
+static const char *image_config_section(int index)
+{
+    return index == IMAGE_ANTIFLICKER_INDEX ? "sensor" : "image";
+}
+
+#define WB_MODE_MAX 9
+#define WB_MANUAL 1
+#define WB_GAIN_MAX 1024
+#define WB_GAIN_DEFAULT 128
+
+typedef struct {
+    bool present;
+    int mode;
+    int rgain;
+    int bgain;
+} image_wb_values_t;
+
+static bool image_wb_supported(rvd_state_t *st)
+{
+    return st && st->ops && st->ops->isp_set_wb && st->ops->isp_get_wb;
+}
+
+static int image_wb_read(rvd_state_t *st, rss_wb_config_t *wb)
+{
+    if (!image_wb_supported(st) || !wb) return RSS_ERR_NOTSUP;
+    int ret = st->ops->isp_get_wb(st->hal_ctx, wb);
+    if (ret != RSS_OK) return ret;
+    int mode = (int)wb->mode;
+    if (mode < 0 || mode > WB_MODE_MAX ||
+        (mode == WB_MANUAL && (wb->r_gain > WB_GAIN_MAX || wb->b_gain > WB_GAIN_MAX)))
+        return RSS_ERR;
+    return RSS_OK;
+}
+
+static int image_wb_config_value(rvd_state_t *st, const char *name, int fallback,
+                                 int maximum, int *value)
+{
+    const char *text = rss_config_get_str(st->cfg, "image", name, NULL);
+    if (!text) {
+        *value = fallback;
+        return RSS_OK;
+    }
+    size_t length = strlen(text);
+    if (!length || length > 4) return RSS_ERR_INVAL;
+    int parsed = 0;
+    for (size_t i = 0; i < length; ++i) {
+        if (text[i] < '0' || text[i] > '9') return RSS_ERR_INVAL;
+        parsed = parsed * 10 + text[i] - '0';
+    }
+    if (parsed > maximum) return RSS_ERR_INVAL;
+    *value = parsed;
+    return RSS_OK;
+}
+
+static int image_wb_apply(rvd_state_t *st, const image_wb_values_t *values)
+{
+    rss_wb_config_t before = {0}, after = {0};
+    if (!values || !values->present || image_wb_read(st, &before) != RSS_OK)
+        return RSS_ERR_NOTSUP;
+    int configured_r = 0, configured_b = 0;
+    if (image_wb_config_value(st, "wb_rgain", WB_GAIN_DEFAULT, WB_GAIN_MAX, &configured_r) != RSS_OK ||
+        image_wb_config_value(st, "wb_bgain", WB_GAIN_DEFAULT, WB_GAIN_MAX, &configured_b) != RSS_OK)
+        return RSS_ERR_INVAL;
+    if (values->mode != WB_MANUAL &&
+        (values->rgain != configured_r || values->bgain != configured_b))
+        return RSS_ERR_INVAL;
+    bool changed = (int)before.mode != values->mode ||
+        (values->mode == WB_MANUAL &&
+         (before.r_gain != values->rgain || before.b_gain != values->bgain));
+    if (changed) {
+        rss_wb_config_t requested = {
+            .mode = (rss_wb_mode_t)values->mode,
+            .r_gain = (uint16_t)values->rgain,
+            .b_gain = (uint16_t)values->bgain,
+        };
+        if (st->ops->isp_set_wb(st->hal_ctx, &requested) != RSS_OK) return RSS_ERR;
+    }
+    if (image_wb_read(st, &after) != RSS_OK || (int)after.mode != values->mode ||
+        (values->mode == WB_MANUAL &&
+         (after.r_gain != values->rgain || after.b_gain != values->bgain)))
+        return RSS_ERR;
+    rss_config_set_int(st->cfg, "image", "core_wb_mode", values->mode);
+    rss_config_set_int(st->cfg, "image", "wb_rgain", values->rgain);
+    rss_config_set_int(st->cfg, "image", "wb_bgain", values->bgain);
+    return rss_config_get_int(st->cfg, "image", "core_wb_mode", -1) == values->mode &&
+        rss_config_get_int(st->cfg, "image", "wb_rgain", -1) == values->rgain &&
+        rss_config_get_int(st->cfg, "image", "wb_bgain", -1) == values->bgain ? RSS_OK : RSS_ERR;
+}
+
+static bool image_wb_parse(cJSON *field, image_wb_values_t *values)
+{
+    if (!cJSON_IsObject(field) || cJSON_GetArraySize(field) != 3) return false;
+    unsigned seen = 0;
+    cJSON *item;
+    cJSON_ArrayForEach(item, field) {
+        int bit = item->string && strcmp(item->string, "mode") == 0 ? 1 :
+            item->string && strcmp(item->string, "rgain") == 0 ? 2 :
+            item->string && strcmp(item->string, "bgain") == 0 ? 4 : 0;
+        if (!bit || (seen & bit) || !cJSON_IsNumber(item) ||
+            item->valuedouble != item->valueint) return false;
+        int maximum = bit == 1 ? WB_MODE_MAX : WB_GAIN_MAX;
+        if (item->valueint < 0 || item->valueint > maximum) return false;
+        if (bit == 1) values->mode = item->valueint;
+        if (bit == 2) values->rgain = item->valueint;
+        if (bit == 4) values->bgain = item->valueint;
+        seen |= bit;
+    }
+    values->present = seen == 7;
+    return values->present;
+}
+
+/* These HAL getters use int outputs rather than the byte-valued ISP controls. */
+static bool image_extra_getter(rvd_state_t *st, int index)
+{
+    if (index == IMAGE_ANTIFLICKER_INDEX)
+        return st->ops->isp_get_antiflicker != NULL;
+    if (index == IMAGE_EXPOSURE_INDEX)
+        return st->ops->isp_get_ae_comp != NULL;
+    return (index == IMAGE_HFLIP_INDEX || index == IMAGE_VFLIP_INDEX) &&
+        st->ops->isp_get_hvflip != NULL;
+}
+
+static int image_get_extra(rvd_state_t *st, int index, uint8_t *value)
+{
+    if (!image_extra_getter(st, index))
+        return RSS_ERR_NOTSUP;
+    int observed = 0, other = 0;
+    int ret;
+    if (index == IMAGE_ANTIFLICKER_INDEX) {
+        rss_antiflicker_t mode = RSS_ANTIFLICKER_OFF;
+        ret = st->ops->isp_get_antiflicker(st->hal_ctx, &mode);
+        observed = (int)mode;
+    } else if (index == IMAGE_EXPOSURE_INDEX) {
+        ret = st->ops->isp_get_ae_comp(st->hal_ctx, &observed);
+    } else {
+        int horizontal = 0, vertical = 0;
+        ret = st->ops->isp_get_hvflip(st->hal_ctx, &horizontal, &vertical);
+        observed = index == IMAGE_HFLIP_INDEX ? horizontal : vertical;
+        other = index == IMAGE_HFLIP_INDEX ? vertical : horizontal;
+    }
+    if (ret != RSS_OK)
+        return ret;
+    if (observed < 0 || observed > image_maximum[index] || other < 0 || other > 1)
+        return RSS_ERR;
+    *value = (uint8_t)observed;
+    return RSS_OK;
+}
+
+static bool image_setter_supported(rvd_state_t *st, int index, int (**set)(void *, int))
+{
+    if (index == IMAGE_ANTIFLICKER_INDEX)
+        return st->ops->isp_set_antiflicker != NULL;
+    return set[index] != NULL;
+}
+
+static int image_set_value(rvd_state_t *st, int index, int value, int (**set)(void *, int))
+{
+    if (index == IMAGE_ANTIFLICKER_INDEX)
+        return st->ops->isp_set_antiflicker(st->hal_ctx, (rss_antiflicker_t)value);
+    return set[index](st->hal_ctx, value);
+}
+
+int rvd_get_imaging(rvd_state_t *st, char *resp, int size)
+{
+    int (*set[])(void *, int) = {st->ops->isp_set_brightness,
+        st->ops->isp_set_contrast, st->ops->isp_set_saturation,
+        st->ops->isp_set_sharpness, st->ops->isp_set_backlight_comp,
+        st->ops->isp_set_drc_strength, st->ops->isp_set_highlight_depress,
+        st->ops->isp_set_defog_strength, st->ops->isp_set_sinter_strength,
+        st->ops->isp_set_hue, st->ops->isp_set_dpc_strength,
+        st->ops->isp_set_ae_comp, st->ops->isp_set_hflip, st->ops->isp_set_vflip};
+    int (*get[])(void *, uint8_t *) = {st->ops->isp_get_brightness,
+        st->ops->isp_get_contrast, st->ops->isp_get_saturation,
+        st->ops->isp_get_sharpness, st->ops->isp_get_backlight_comp,
+        st->ops->isp_get_drc_strength, st->ops->isp_get_highlight_depress,
+        st->ops->isp_get_defog_strength, st->ops->isp_get_sinter_strength,
+        st->ops->isp_get_hue, st->ops->isp_get_dpc_strength};
+    cJSON *root = cJSON_CreateObject();
+    cJSON_AddStringToObject(root, "status", "ok");
+    cJSON_AddStringToObject(root, "persistence", "checked-config");
+    cJSON *values = cJSON_AddObjectToObject(root, "fields");
+    for (size_t i = 0; i < IMAGE_FIELD_COUNT; i++) {
+        uint8_t observed = 0;
+        bool has_getter = i < IMAGE_EXTRA_START ? get[i] != NULL : image_extra_getter(st, i);
+        int get_ret = i < IMAGE_EXTRA_START
+            ? (get[i] ? get[i](st->hal_ctx, &observed) : RSS_ERR_NOTSUP)
+            : image_get_extra(st, i, &observed);
+        int configured = rss_config_get_int(st->cfg, image_config_section((int)i), image_config_names[i],
+            image_defaults[i]);
+        bool configured_valid = configured >= 0 && configured <= image_maximum[i];
+        bool setter_config = i == IMAGE_SINTER_INDEX && set[i] && has_getter &&
+            get_ret == RSS_ERR_NOTSUP;
+        bool supported = image_setter_supported(st, (int)i, set) && has_getter &&
+            (get_ret != RSS_ERR_NOTSUP || setter_config);
+        bool available = supported && ((get_ret == RSS_OK && observed <= image_maximum[i]) ||
+            (setter_config && configured_valid && st->sinter_config_acknowledged &&
+             st->sinter_config_value == configured));
+        cJSON *field = cJSON_AddObjectToObject(values, image_names[i]);
+        cJSON_AddBoolToObject(field, "supported", supported);
+        cJSON_AddBoolToObject(field, "available", available);
+        cJSON_AddNumberToObject(field, "min", 0);
+        cJSON_AddNumberToObject(field, "max", image_maximum[i]);
+        cJSON_AddStringToObject(field, "verification", !supported ? "unsupported" :
+            setter_config ? "sdk-setter-config" : "sdk-readback");
+        if (get_ret == RSS_OK && observed <= image_maximum[i])
+            cJSON_AddNumberToObject(field, "observed_value", observed);
+        else
+            cJSON_AddNullToObject(field, "observed_value");
+        if (configured_valid)
+            cJSON_AddNumberToObject(field, "configured_value", configured);
+        else
+            cJSON_AddNullToObject(field, "configured_value");
+        if (available)
+            cJSON_AddNumberToObject(field, "value", setter_config ? configured : observed);
+        else cJSON_AddNullToObject(field, "value");
+    }
+    cJSON *white_balance = cJSON_AddObjectToObject(root, "white_balance");
+    bool wb_supported = image_wb_supported(st);
+    rss_wb_config_t wb = {0};
+    int wb_ret = wb_supported ? image_wb_read(st, &wb) : RSS_ERR_NOTSUP;
+    int configured_mode = 0, configured_r = 0, configured_b = 0;
+    bool configured_valid =
+        image_wb_config_value(st, "core_wb_mode", 0, WB_MODE_MAX, &configured_mode) == RSS_OK &&
+        image_wb_config_value(st, "wb_rgain", WB_GAIN_DEFAULT, WB_GAIN_MAX, &configured_r) == RSS_OK &&
+        image_wb_config_value(st, "wb_bgain", WB_GAIN_DEFAULT, WB_GAIN_MAX, &configured_b) == RSS_OK;
+    bool wb_available = wb_supported && wb_ret == RSS_OK;
+    bool gains_effective = wb_available && (int)wb.mode == WB_MANUAL;
+    cJSON_AddBoolToObject(white_balance, "supported", wb_supported);
+    cJSON_AddBoolToObject(white_balance, "available", wb_available);
+    cJSON_AddStringToObject(white_balance, "verification",
+        wb_supported ? "sdk-readback" : "unsupported");
+    cJSON_AddNumberToObject(white_balance, "mode_min", 0);
+    cJSON_AddNumberToObject(white_balance, "mode_max", WB_MODE_MAX);
+    cJSON_AddNumberToObject(white_balance, "gain_min", 0);
+    cJSON_AddNumberToObject(white_balance, "gain_max", WB_GAIN_MAX);
+    if (wb_available) cJSON_AddNumberToObject(white_balance, "mode", (int)wb.mode);
+    else cJSON_AddNullToObject(white_balance, "mode");
+    cJSON_AddBoolToObject(white_balance, "gains_effective", gains_effective);
+    if (gains_effective) {
+        cJSON_AddNumberToObject(white_balance, "rgain", wb.r_gain);
+        cJSON_AddNumberToObject(white_balance, "bgain", wb.b_gain);
+    } else {
+        cJSON_AddNullToObject(white_balance, "rgain");
+        cJSON_AddNullToObject(white_balance, "bgain");
+    }
+    if (configured_valid) {
+        cJSON_AddNumberToObject(white_balance, "configured_mode", configured_mode);
+        cJSON_AddNumberToObject(white_balance, "configured_rgain", configured_r);
+        cJSON_AddNumberToObject(white_balance, "configured_bgain", configured_b);
+    } else {
+        cJSON_AddNullToObject(white_balance, "configured_mode");
+        cJSON_AddNullToObject(white_balance, "configured_rgain");
+        cJSON_AddNullToObject(white_balance, "configured_bgain");
+    }
+    return rss_ctrl_resp_json(resp, size, root);
+}
+
+int rvd_privacy_required(rvd_state_t *st, const char *section, const char *socket)
+{
+    struct stat info;
+    if (lstat(socket, &info) == 0) return 1;
+    if (errno != ENOENT) return RSS_ERR;
+    return rss_config_get_bool(st->cfg, section, "enabled", true) ? 1 : 0;
+}
+
+static int apply_image_values(rvd_state_t *st, const int values[IMAGE_FIELD_COUNT], unsigned mask)
+{
+    if (!st || !st->ops || !st->cfg) return RSS_ERR_INVAL;
+    int (*set[])(void *, int) = {st->ops->isp_set_brightness, st->ops->isp_set_contrast,
+        st->ops->isp_set_saturation, st->ops->isp_set_sharpness,
+        st->ops->isp_set_backlight_comp, st->ops->isp_set_drc_strength,
+        st->ops->isp_set_highlight_depress, st->ops->isp_set_defog_strength,
+        st->ops->isp_set_sinter_strength, st->ops->isp_set_hue, st->ops->isp_set_dpc_strength,
+        st->ops->isp_set_ae_comp, st->ops->isp_set_hflip, st->ops->isp_set_vflip};
+    int (*get[])(void *, uint8_t *) = {st->ops->isp_get_brightness, st->ops->isp_get_contrast,
+        st->ops->isp_get_saturation, st->ops->isp_get_sharpness,
+        st->ops->isp_get_backlight_comp, st->ops->isp_get_drc_strength,
+        st->ops->isp_get_highlight_depress, st->ops->isp_get_defog_strength,
+        st->ops->isp_get_sinter_strength, st->ops->isp_get_hue, st->ops->isp_get_dpc_strength};
+    uint8_t before[IMAGE_FIELD_COUNT] = {0};
+    bool setter_config[IMAGE_FIELD_COUNT] = {false};
+    /* Preflight the entire request before any setter or cache mutation. */
+    for (int i = 0; i < IMAGE_FIELD_COUNT; ++i) {
+        if (!(mask & (1u << i))) continue;
+        if (values[i] < 0 || values[i] > image_maximum[i]) return RSS_ERR_INVAL;
+        bool has_getter = i < IMAGE_EXTRA_START ? get[i] != NULL : image_extra_getter(st, i);
+        if (!image_setter_supported(st, i, set) || !has_getter) return RSS_ERR_NOTSUP;
+        int ret = i < IMAGE_EXTRA_START ? get[i](st->hal_ctx, &before[i]) :
+            image_get_extra(st, i, &before[i]);
+        if (i == IMAGE_SINTER_INDEX && ret == RSS_ERR_NOTSUP)
+            setter_config[i] = true;
+        else if (ret != RSS_OK) {
+            RSS_ERROR("image %s: preflight getter failed: %d", image_names[i], ret);
+            return ret;
+        }
+    }
+    for (int i = 0; i < IMAGE_FIELD_COUNT; ++i) {
+        if (!(mask & (1u << i))) continue;
+        if (setter_config[i] || before[i] != values[i]) {
+            if (setter_config[i])
+                st->sinter_config_acknowledged = false;
+            int ret = image_set_value(st, i, values[i], set);
+            if (ret != RSS_OK) {
+                RSS_ERROR("image %s: setter failed: %d (requested %d)",
+                    image_names[i], ret, values[i]);
+                return ret;
+            }
+        }
+        if (!setter_config[i]) {
+            uint8_t observed = 0;
+            int ret = i < IMAGE_EXTRA_START ? get[i](st->hal_ctx, &observed) :
+                image_get_extra(st, i, &observed);
+            if (ret != RSS_OK) {
+                RSS_ERROR("image %s: readback getter failed: %d", image_names[i], ret);
+                return ret;
+            }
+            if (observed != values[i]) {
+                RSS_ERROR("image %s: readback mismatch (requested %d, observed %u)",
+                    image_names[i], values[i], (unsigned)observed);
+                return RSS_ERR;
+            }
+        }
+        const char *section = image_config_section(i);
+        rss_config_set_int(st->cfg, section, image_config_names[i], values[i]);
+        char expected[4];
+        snprintf(expected, sizeof(expected), "%d", values[i]);
+        if (strcmp(rss_config_get_str(st->cfg, section, image_config_names[i], ""), expected) != 0) {
+            RSS_ERROR("image %s: configuration cache update failed", image_names[i]);
+            return RSS_ERR;
+        }
+        if (setter_config[i]) {
+            st->sinter_config_acknowledged = true;
+            st->sinter_config_value = values[i];
+        }
+    }
+    return RSS_OK;
+}
+
+int rvd_set_imaging(rvd_state_t *st, const char *json, char *resp, int size)
+{
+    cJSON *root = cJSON_ParseWithOpts(json, NULL, true);
+    cJSON *fields = cJSON_GetObjectItemCaseSensitive(root, "values");
+    int values[IMAGE_FIELD_COUNT] = {0};
+    unsigned mask = 0;
+    image_wb_values_t wb = {0};
+    cJSON *command = cJSON_GetObjectItemCaseSensitive(root, "cmd");
+    bool valid = cJSON_IsObject(root) && cJSON_GetArraySize(root) == 2 &&
+        cJSON_IsString(command) && strcmp(command->valuestring, "set-imaging") == 0 &&
+        cJSON_IsObject(fields);
+    cJSON *field;
+    cJSON_ArrayForEach(field, fields) {
+        if (field->string && strcmp(field->string, "white_balance") == 0) {
+            if (wb.present || !image_wb_parse(field, &wb)) valid = false;
+            continue;
+        }
+        int index = -1;
+        for (int i = 0; i < IMAGE_FIELD_COUNT; ++i) {
+            if (field->string && strcmp(field->string, image_names[i]) == 0) index = i;
+        }
+        if (index < 0 || (mask & (1u << index)) || !cJSON_IsNumber(field) ||
+            field->valuedouble != field->valueint || field->valueint < 0 ||
+            field->valueint > image_maximum[index]) {
+            valid = false;
+            break;
+        }
+        mask |= 1u << index;
+        values[index] = field->valueint;
+    }
+    cJSON_Delete(root);
+    if (!valid || (!mask && !wb.present))
+        return rss_ctrl_resp_error(resp, size, "need supported bounded image values");
+    if (wb.present) {
+        rss_wb_config_t before = {0};
+        int configured_r = 0, configured_b = 0;
+        valid = image_wb_read(st, &before) == RSS_OK &&
+            image_wb_config_value(st, "wb_rgain", WB_GAIN_DEFAULT, WB_GAIN_MAX,
+                                  &configured_r) == RSS_OK &&
+            image_wb_config_value(st, "wb_bgain", WB_GAIN_DEFAULT, WB_GAIN_MAX,
+                                  &configured_b) == RSS_OK &&
+            (wb.mode == WB_MANUAL || (wb.rgain == configured_r && wb.bgain == configured_b));
+        if (!valid)
+            return rss_ctrl_resp_error(resp, size, "white balance preflight failed");
+    }
+    int ret = apply_image_values(st, values, mask);
+    if (ret == RSS_OK && wb.present) ret = image_wb_apply(st, &wb);
+    return ret == RSS_OK ? rss_ctrl_resp_ok(resp, size) :
+        rss_ctrl_resp_error(resp, size, "image apply or readback failed");
+}
+
+int rvd_restore_imaging(rvd_state_t *st)
+{
+    if (!st || !st->ops || !st->cfg) return RSS_ERR_INVAL;
+    st->sinter_config_acknowledged = false;
+    int (*set[])(void *, int) = {st->ops->isp_set_brightness, st->ops->isp_set_contrast,
+        st->ops->isp_set_saturation, st->ops->isp_set_sharpness,
+        st->ops->isp_set_backlight_comp, st->ops->isp_set_drc_strength,
+        st->ops->isp_set_highlight_depress, st->ops->isp_set_defog_strength,
+        st->ops->isp_set_sinter_strength, st->ops->isp_set_hue, st->ops->isp_set_dpc_strength,
+        st->ops->isp_set_ae_comp, st->ops->isp_set_hflip, st->ops->isp_set_vflip};
+    int (*get[])(void *, uint8_t *) = {st->ops->isp_get_brightness, st->ops->isp_get_contrast,
+        st->ops->isp_get_saturation, st->ops->isp_get_sharpness,
+        st->ops->isp_get_backlight_comp, st->ops->isp_get_drc_strength,
+        st->ops->isp_get_highlight_depress, st->ops->isp_get_defog_strength,
+        st->ops->isp_get_sinter_strength, st->ops->isp_get_hue, st->ops->isp_get_dpc_strength};
+    int values[IMAGE_FIELD_COUNT];
+    unsigned mask = 0;
+    for (int i = 0; i < IMAGE_FIELD_COUNT; ++i) {
+        char fallback[4];
+        snprintf(fallback, sizeof(fallback), "%d", image_defaults[i]);
+        const char *configured = rss_config_get_str(st->cfg, image_config_section(i),
+            image_config_names[i], NULL);
+        bool supported = image_setter_supported(st, i, set) &&
+            (i < IMAGE_EXTRA_START ? get[i] != NULL : image_extra_getter(st, i));
+        /* An optional HAL entry does not prove sensor/SDK readback support.
+         * Retain sensor defaults for absent optional settings. Sinter has
+         * an explicit setter-acknowledged default because the T31 SDK has
+         * no getter; keep that existing initialization and acknowledgement. */
+        if (i >= 4 && !configured && (i != IMAGE_SINTER_INDEX || !supported))
+            continue;
+        /* Saved values still require the complete setter/readback pair. */
+        if (!supported) return RSS_ERR_NOTSUP;
+        const char *text = configured ? configured : fallback;
+        size_t length = strlen(text);
+        if (!length || length > 3) return RSS_ERR_INVAL;
+        int value = 0;
+        for (size_t n = 0; n < length; ++n) {
+            if (text[n] < '0' || text[n] > '9') return RSS_ERR_INVAL;
+            value = value * 10 + text[n] - '0';
+        }
+        if (value > image_maximum[i]) return RSS_ERR_INVAL;
+        values[i] = value;
+        mask |= 1u << i;
+    }
+    int ret = apply_image_values(st, values, mask);
+    bool wb_configured = rss_config_get_str(st->cfg, "image", "core_wb_mode", NULL) ||
+        rss_config_get_str(st->cfg, "image", "wb_rgain", NULL) ||
+        rss_config_get_str(st->cfg, "image", "wb_bgain", NULL);
+    if (ret != RSS_OK || !wb_configured) return ret;
+    if (!image_wb_supported(st)) return RSS_ERR_NOTSUP;
+    image_wb_values_t wb = {.present = true};
+    if (image_wb_config_value(st, "core_wb_mode", 0, WB_MODE_MAX, &wb.mode) != RSS_OK ||
+        image_wb_config_value(st, "wb_rgain", WB_GAIN_DEFAULT, WB_GAIN_MAX, &wb.rgain) != RSS_OK ||
+        image_wb_config_value(st, "wb_bgain", WB_GAIN_DEFAULT, WB_GAIN_MAX, &wb.bgain) != RSS_OK)
+        return RSS_ERR_INVAL;
+    ret = image_wb_apply(st, &wb);
+    if (ret != RSS_OK)
+        RSS_ERROR("image white_balance: restore failed: %d", ret);
+    return ret;
+}
+
+
+/* Only the standard move algorithm uses this HAL parameter structure. */
+static bool motion_sensitivity_supported(rvd_state_t *st)
+{
+    return st->ops && st->ops->ivs_get_param && st->ops->ivs_set_param &&
+        !st->ivs_jzdl && !st->ivs_persondet && !st->ivs_base_move && st->stream_count >= 2;
+}
+
+static bool motion_parameters(rvd_state_t *st, rss_ivs_move_param_t *mp)
+{
+    if (!motion_sensitivity_supported(st) || !atomic_load(&st->ivs_active) ||
+        !st->ivs_receiving || !st->ivs_tid || !st->ivs_channel_created ||
+        RSS_HAL_CALL(st->ops, ivs_get_param, st->hal_ctx, st->ivs_chn, mp) != RSS_OK)
+        return false;
+    if (mp->width <= 0 || mp->height <= 0 || mp->roi_count < 1 || mp->roi_count > RSS_IVS_MAX_ROI ||
+        mp->skip_frame_count < 0 || mp->skip_frame_count > 65535)
+        return false;
+    for (int i = 0; i < mp->roi_count; ++i) {
+        if (mp->sense[i] < 0 || mp->sense[i] > 4)
+            return false;
+    }
+    return true;
+}
+
+int rvd_set_motion_sensitivity(rvd_state_t *st, const char *json, char *resp, int size)
+{
+    cJSON *root = cJSON_ParseWithOpts(json, NULL, true);
+    cJSON *cmd = cJSON_GetObjectItemCaseSensitive(root, "cmd");
+    cJSON *value = cJSON_GetObjectItemCaseSensitive(root, "sensitivity");
+    bool valid = cJSON_IsObject(root) && cJSON_GetArraySize(root) == 2 &&
+        cJSON_IsString(cmd) && strcmp(cmd->valuestring, "set-motion-sensitivity") == 0 &&
+        cJSON_IsNumber(value) && value->valuedouble == value->valueint &&
+        value->valueint >= 0 && value->valueint <= 4;
+    int sensitivity = valid ? value->valueint : -1;
+    cJSON_Delete(root);
+    if (!valid)
+        return rss_ctrl_resp_error(resp, size, "expected sensitivity integer 0..4");
+    rss_ivs_move_param_t before = {0}, after = {0};
+    rvd_ivs_lock_sdk();
+    valid = motion_parameters(st, &before);
+    if (valid) {
+        bool changed = false;
+        for (int i = 0; i < before.roi_count; ++i) {
+            changed |= before.sense[i] != sensitivity;
+            before.sense[i] = sensitivity;
+        }
+        if (changed)
+            valid = RSS_HAL_CALL(st->ops, ivs_set_param, st->hal_ctx, st->ivs_chn, &before) == RSS_OK;
+        if (valid)
+            valid = motion_parameters(st, &after) && before.roi_count == after.roi_count &&
+                before.width == after.width && before.height == after.height &&
+                before.skip_frame_count == after.skip_frame_count;
+        for (int i = 0; valid && i < before.roi_count; ++i) {
+            valid = after.sense[i] == sensitivity &&
+                before.roi[i].p0_x == after.roi[i].p0_x && before.roi[i].p0_y == after.roi[i].p0_y &&
+                before.roi[i].p1_x == after.roi[i].p1_x && before.roi[i].p1_y == after.roi[i].p1_y;
+        }
+    }
+    rvd_ivs_unlock_sdk();
+    if (!valid)
+        return rss_ctrl_resp_error(resp, size, "motion sensitivity apply or SDK readback failed");
+    rss_config_set_int(st->cfg, "motion", "sensitivity", sensitivity);
+    if (rss_config_get_int(st->cfg, "motion", "sensitivity", -1) != sensitivity)
+        return rss_ctrl_resp_error(resp, size, "motion sensitivity cache failed");
+    return rss_ctrl_resp_ok(resp, size);
+}
+
+int rvd_set_motion_skip_frames(rvd_state_t *st, const char *json, char *resp, int size)
+{
+    cJSON *root = cJSON_ParseWithOpts(json, NULL, true);
+    cJSON *cmd = cJSON_GetObjectItemCaseSensitive(root, "cmd");
+    cJSON *value = cJSON_GetObjectItemCaseSensitive(root, "skip_frame_count");
+    bool valid = cJSON_IsObject(root) && cJSON_GetArraySize(root) == 2 &&
+        cJSON_IsString(cmd) && strcmp(cmd->valuestring, "set-motion-skip-frames") == 0 &&
+        cJSON_IsNumber(value) && value->valuedouble == value->valueint &&
+        value->valueint >= 0 && value->valueint <= 65535;
+    int skip_frames = valid ? value->valueint : -1;
+    cJSON_Delete(root);
+    if (!valid)
+        return rss_ctrl_resp_error(resp, size, "expected skip_frame_count integer 0..65535");
+
+    rss_ivs_move_param_t before = {0}, after = {0};
+    rvd_ivs_lock_sdk();
+    valid = motion_parameters(st, &before);
+    if (valid) {
+        bool changed = before.skip_frame_count != skip_frames;
+        before.skip_frame_count = skip_frames;
+        if (changed)
+            valid = RSS_HAL_CALL(st->ops, ivs_set_param, st->hal_ctx, st->ivs_chn, &before) == RSS_OK;
+        if (valid)
+            valid = motion_parameters(st, &after) && before.roi_count == after.roi_count &&
+                before.width == after.width && before.height == after.height &&
+                after.skip_frame_count == skip_frames;
+        for (int i = 0; valid && i < before.roi_count; ++i) {
+            valid = before.sense[i] == after.sense[i] &&
+                before.roi[i].p0_x == after.roi[i].p0_x && before.roi[i].p0_y == after.roi[i].p0_y &&
+                before.roi[i].p1_x == after.roi[i].p1_x && before.roi[i].p1_y == after.roi[i].p1_y;
+        }
+    }
+    rvd_ivs_unlock_sdk();
+    if (!valid)
+        return rss_ctrl_resp_error(resp, size, "motion skip-frame apply or SDK readback failed");
+    rss_config_set_int(st->cfg, "motion", "skip_frames", skip_frames);
+    if (rss_config_get_int(st->cfg, "motion", "skip_frames", -1) != skip_frames)
+        return rss_ctrl_resp_error(resp, size, "motion skip-frame cache failed");
+    return rss_ctrl_resp_ok(resp, size);
+}
+
+int rvd_set_motion_lifecycle(rvd_state_t *st, const char *json, char *resp, int size)
+{
+    static const char *names[] = {
+        "debounce_time", "cooldown_time", "init_time", "min_time", "post_time"
+    };
+    static const int maximum[] = {65535, 60, 65535, 65535, 65535};
+    int values[5] = {0};
+    cJSON *root = cJSON_ParseWithOpts(json, NULL, true);
+    cJSON *cmd = cJSON_GetObjectItemCaseSensitive(root, "cmd");
+    bool valid = cJSON_IsObject(root) && cJSON_GetArraySize(root) == 6 &&
+        cJSON_IsString(cmd) && strcmp(cmd->valuestring, "set-motion-lifecycle") == 0;
+    for (size_t i = 0; valid && i < sizeof(names) / sizeof(names[0]); ++i) {
+        cJSON *value = cJSON_GetObjectItemCaseSensitive(root, names[i]);
+        valid = cJSON_IsNumber(value) && value->valuedouble == value->valueint &&
+            value->valueint >= 0 && value->valueint <= maximum[i];
+        if (valid)
+            values[i] = value->valueint;
+    }
+    cJSON_Delete(root);
+    if (!valid)
+        return rss_ctrl_resp_error(resp, size, "expected complete bounded motion lifecycle settings");
+    for (size_t i = 0; i < sizeof(names) / sizeof(names[0]); ++i)
+        rss_config_set_int(st->cfg, "motion", names[i], values[i]);
+    for (size_t i = 0; i < sizeof(names) / sizeof(names[0]); ++i) {
+        if (rss_config_get_int(st->cfg, "motion", names[i], -1) != values[i])
+            return rss_ctrl_resp_error(resp, size, "motion lifecycle cache failed");
+    }
+    return rss_ctrl_resp_ok(resp, size);
+}
+
+void rvd_reset_motion_results(rvd_state_t *st)
+{
+    if (!st->ivs_lock_initialized)
+        return;
+    pthread_mutex_lock(&st->ivs_det_lock);
+    st->ivs_result_epoch++;
+    st->ivs_result_sequence = 0;
+    st->ivs_result_raw_motion = false;
+    st->ivs_result_timestamp = 0;
+    pthread_mutex_unlock(&st->ivs_det_lock);
+}
+
+void rvd_publish_motion_result(rvd_state_t *st, bool raw_motion, int64_t timestamp)
+{
+    if (!st->ivs_lock_initialized)
+        return;
+    pthread_mutex_lock(&st->ivs_det_lock);
+    st->ivs_result_sequence++;
+    st->ivs_result_raw_motion = raw_motion;
+    st->ivs_result_timestamp = timestamp;
+    pthread_mutex_unlock(&st->ivs_det_lock);
+}
+
+bool rvd_snapshot_motion_result(rvd_state_t *st, uint64_t *epoch, uint64_t *sequence,
+                                bool *raw_motion, int64_t *timestamp)
+{
+    if (!st->ivs_lock_initialized)
+        return false;
+    pthread_mutex_lock(&st->ivs_det_lock);
+    *epoch = st->ivs_result_epoch;
+    *sequence = st->ivs_result_sequence;
+    *raw_motion = st->ivs_result_raw_motion;
+    *timestamp = st->ivs_result_timestamp;
+    pthread_mutex_unlock(&st->ivs_det_lock);
+    return *sequence > 0;
+}
+
+/* T31 1.1.4 documents 0..51 regions despite its 52-element storage.
+ * This API exposes one explicit rectangle; existing multi-ROI state is read-only. */
+static bool motion_roi_parameters(rvd_state_t *st, rss_ivs_move_param_t *mp)
+{
+    bool active = atomic_load(&st->ivs_active);
+    if (!motion_sensitivity_supported(st) || !st->ivs_channel_created ||
+        active != st->ivs_receiving || active != (st->ivs_tid != 0) ||
+        RSS_HAL_CALL(st->ops, ivs_get_param, st->hal_ctx, st->ivs_chn, mp) != RSS_OK)
+        return false;
+    if (mp->width < 2 || mp->height < 2 || mp->width > 16384 || mp->height > 16384 ||
+        mp->width != (int)st->streams[1].enc_cfg.width ||
+        mp->height != (int)st->streams[1].enc_cfg.height || mp->roi_count < 1 || mp->roi_count > 51)
+        return false;
+    for (int i = 0; i < mp->roi_count; ++i) {
+        const rss_rect_t *roi = &mp->roi[i];
+        if (mp->sense[i] < 0 || mp->sense[i] > 4 || mp->sense[i] != mp->sense[0] ||
+            roi->p0_x < 0 || roi->p0_y < 0 || roi->p0_x >= roi->p1_x || roi->p0_y >= roi->p1_y ||
+            roi->p1_x >= mp->width || roi->p1_y >= mp->height)
+            return false;
+    }
+    return true;
+}
+
+static void motion_roi_status(rvd_state_t *st, cJSON *root, bool sdk_readable)
+{
+    rss_ivs_move_param_t mp = {0};
+    bool available = sdk_readable && motion_roi_parameters(st, &mp);
+    cJSON *roi = cJSON_AddObjectToObject(root, "roi");
+    cJSON_AddStringToObject(roi, "contract", "single-region-v1");
+    cJSON_AddBoolToObject(roi, "supported", motion_sensitivity_supported(st));
+    cJSON_AddBoolToObject(roi, "available", available);
+    cJSON_AddBoolToObject(roi, "applied", available && !st->ivs_roi_uncertain);
+    if (available) {
+        cJSON_AddNumberToObject(roi, "frame_width", mp.width);
+        cJSON_AddNumberToObject(roi, "frame_height", mp.height);
+        cJSON_AddNumberToObject(roi, "count", mp.roi_count);
+    } else {
+        cJSON_AddNullToObject(roi, "frame_width");
+        cJSON_AddNullToObject(roi, "frame_height");
+        cJSON_AddNullToObject(roi, "count");
+    }
+    if (available && mp.roi_count == 1) {
+        cJSON *single = cJSON_AddObjectToObject(roi, "single");
+        cJSON_AddNumberToObject(single, "roi_0_x", mp.roi[0].p0_x);
+        cJSON_AddNumberToObject(single, "roi_0_y", mp.roi[0].p0_y);
+        cJSON_AddNumberToObject(single, "roi_1_x", mp.roi[0].p1_x + 1);
+        cJSON_AddNumberToObject(single, "roi_1_y", mp.roi[0].p1_y + 1);
+    } else {
+        cJSON_AddNullToObject(roi, "single");
+    }
+}
+
+static bool same_single_roi(const rss_ivs_move_param_t *a, const rss_ivs_move_param_t *b)
+{
+    return a->roi_count == 1 && b->roi_count == 1 && a->width == b->width &&
+        a->height == b->height && a->skip_frame_count == b->skip_frame_count &&
+        a->sense[0] == b->sense[0] && a->roi[0].p0_x == b->roi[0].p0_x &&
+        a->roi[0].p0_y == b->roi[0].p0_y && a->roi[0].p1_x == b->roi[0].p1_x &&
+        a->roi[0].p1_y == b->roi[0].p1_y;
+}
+
+int rvd_set_motion_roi(rvd_state_t *st, const char *json, char *resp, int size)
+{
+    static const char *keys[] = {"frame_width", "frame_height", "roi_0_x", "roi_0_y",
+                                "roi_1_x", "roi_1_y", "roi_count"};
+    int values[7] = {0};
+    cJSON *request = cJSON_ParseWithOpts(json, NULL, true);
+    cJSON *command = cJSON_GetObjectItemCaseSensitive(request, "cmd");
+    bool valid = cJSON_IsObject(request) && cJSON_GetArraySize(request) == 8 &&
+        cJSON_IsString(command) && strcmp(command->valuestring, "set-motion-roi") == 0;
+    for (int i = 0; valid && i < 7; ++i) {
+        cJSON *value = cJSON_GetObjectItemCaseSensitive(request, keys[i]);
+        valid = cJSON_IsNumber(value) && value->valuedouble == value->valueint &&
+            value->valueint >= 0 && value->valueint <= 16384;
+        if (valid)
+            values[i] = value->valueint;
+    }
+    cJSON_Delete(request);
+    if (!valid || values[6] != 1 || values[0] < 2 || values[1] < 2 ||
+        values[4] - values[2] < 2 || values[5] - values[3] < 2 ||
+        values[4] > values[0] || values[5] > values[1])
+        return rss_ctrl_resp_error(resp, size, "need one complete bounded ROI with exclusive end edges");
+    if (rvd_stream_geometry_pending(st))
+        return rss_ctrl_resp_error(resp, size,
+            "motion ROI unavailable while saved stream geometry awaits full stack restart");
+
+    rss_ivs_move_param_t before = {0}, desired = {0}, after = {0};
+    rvd_ivs_lock_sdk();
+    valid = motion_roi_parameters(st, &before) && before.width == values[0] && before.height == values[1];
+    desired = before;
+    desired.roi_count = 1;
+    desired.roi[0] = (rss_rect_t){values[2], values[3], values[4] - 1, values[5] - 1};
+    bool unchanged = valid && !st->ivs_roi_uncertain && same_single_roi(&before, &desired);
+    rvd_ivs_unlock_sdk();
+    if (!valid)
+        return rss_ctrl_resp_error(resp, size, "ROI SDK state or frame geometry unavailable");
+
+    if (!unchanged) {
+        /* Join the poller and stop receive, retaining the SDK channel/interface.
+         * Control explicitly resumes only after this complete setter succeeds. */
+        if (rvd_ivs_set_enabled(st, false) != RSS_OK || atomic_load(&st->ivs_active) ||
+            st->ivs_receiving || st->ivs_tid)
+            return rss_ctrl_resp_error(resp, size, "ROI pause failed; explicitly retry stopping motion");
+        rvd_ivs_lock_sdk();
+        st->ivs_roi_uncertain = true;
+        valid = RSS_HAL_CALL(st->ops, ivs_set_param, st->hal_ctx, st->ivs_chn, &desired) == RSS_OK &&
+            motion_roi_parameters(st, &after) && same_single_roi(&desired, &after);
+        if (valid) {
+            st->ivs_grid_x = st->ivs_grid_y = 0;
+            st->ivs_roi_count = 1;
+            atomic_store(&st->ivs_motion, false);
+            atomic_store(&st->ivs_motion_ts, 0);
+            if (st->ivs_lock_initialized) {
+                pthread_mutex_lock(&st->ivs_det_lock);
+                st->ivs_detections.count = 0;
+                pthread_mutex_unlock(&st->ivs_det_lock);
+            }
+            st->ivs_roi_uncertain = false;
+        }
+        rvd_ivs_unlock_sdk();
+    } else {
+        rvd_ivs_lock_sdk();
+        valid = motion_roi_parameters(st, &after) && same_single_roi(&desired, &after);
+        rvd_ivs_unlock_sdk();
+    }
+    if (!valid)
+        return rss_ctrl_resp_error(resp, size, "ROI update unconfirmed; explicit ROI retry required");
+
+    char tuple[64];
+    snprintf(tuple, sizeof(tuple), "%d,%d,%d,%d", values[2], values[3], values[4] - 1, values[5] - 1);
+    rss_config_set_str(st->cfg, "motion", "roi0", tuple);
+    rss_config_set_int(st->cfg, "motion", "roi_count", 1);
+    if (strcmp(rss_config_get_str(st->cfg, "motion", "roi0", ""), tuple) != 0 ||
+        rss_config_get_int(st->cfg, "motion", "roi_count", -1) != 1)
+        return rss_ctrl_resp_error(resp, size, "ROI cache update failed");
+    return rss_ctrl_resp_ok(resp, size);
+}
+
+int rvd_get_motion_config(rvd_state_t *st, char *resp, int size)
+{
+    bool active = atomic_load(&st->ivs_active);
+    bool worker = st->ivs_tid != 0;
+    bool supported = !st->ivs_jzdl && st->stream_count >= 2;
+    bool available = supported && active == st->ivs_receiving && active == worker;
+    bool configured = rss_config_get_bool(st->cfg, "motion", "enabled", false);
+    cJSON *root = cJSON_CreateObject();
+    cJSON_AddStringToObject(root, "status", "ok");
+    cJSON_AddStringToObject(root, "persistence", "checked-config");
+    cJSON_AddBoolToObject(root, "supported", supported);
+    cJSON_AddBoolToObject(root, "available", available);
+    cJSON_AddBoolToObject(root, "configured_enabled", configured);
+    cJSON_AddBoolToObject(root, "active", active);
+    cJSON_AddBoolToObject(root, "receiving", st->ivs_receiving);
+    cJSON_AddBoolToObject(root, "worker", worker);
+    cJSON *lifecycle = cJSON_AddObjectToObject(root, "lifecycle");
+    cJSON_AddNumberToObject(lifecycle, "debounce_time",
+        rss_config_get_int(st->cfg, "motion", "debounce_time", 0));
+    cJSON_AddNumberToObject(lifecycle, "cooldown_time",
+        rss_config_get_int(st->cfg, "motion", "cooldown_time", 5));
+    cJSON_AddNumberToObject(lifecycle, "init_time",
+        rss_config_get_int(st->cfg, "motion", "init_time", 5));
+    cJSON_AddNumberToObject(lifecycle, "min_time",
+        rss_config_get_int(st->cfg, "motion", "min_time", 1));
+    cJSON_AddNumberToObject(lifecycle, "post_time",
+        rss_config_get_int(st->cfg, "motion", "post_time", 0));
+    rss_ivs_move_param_t mp = {0};
+    bool sdk_readable = rvd_ivs_lock_sdk_read(RVD_IVS_READ_LOCK_TIMEOUT_MS);
+    bool sense_supported = motion_sensitivity_supported(st);
+    bool sense_available = sdk_readable && motion_parameters(st, &mp);
+    for (int i = 1; sense_available && i < mp.roi_count; ++i)
+        sense_available = mp.sense[i] == mp.sense[0];
+    cJSON *sense = cJSON_AddObjectToObject(root, "sensitivity");
+    cJSON_AddBoolToObject(sense, "supported", sense_supported);
+    cJSON_AddBoolToObject(sense, "available", sense_available);
+    cJSON_AddNumberToObject(sense, "min", 0);
+    cJSON_AddNumberToObject(sense, "max", 4);
+    if (sense_available)
+        cJSON_AddNumberToObject(sense, "value", mp.sense[0]);
+    else
+        cJSON_AddNullToObject(sense, "value");
+    cJSON *skip = cJSON_AddObjectToObject(root, "skip_frames");
+    cJSON_AddBoolToObject(skip, "supported", sense_supported);
+    cJSON_AddBoolToObject(skip, "available", sdk_readable && motion_parameters(st, &mp));
+    cJSON_AddNumberToObject(skip, "min", 0);
+    cJSON_AddNumberToObject(skip, "max", 65535);
+    if (cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(skip, "available")))
+        cJSON_AddNumberToObject(skip, "value", mp.skip_frame_count);
+    else
+        cJSON_AddNullToObject(skip, "value");
+    motion_roi_status(st, root, sdk_readable);
+    if (sdk_readable)
+        rvd_ivs_unlock_sdk();
+    return rss_ctrl_resp_json(resp, size, root);
+}
+
+int rvd_set_motion_config(rvd_state_t *st, const char *json, char *resp, int size)
+{
+    cJSON *root = cJSON_ParseWithOpts(json, NULL, true);
+    cJSON *command = cJSON_GetObjectItemCaseSensitive(root, "cmd");
+    cJSON *value = cJSON_GetObjectItemCaseSensitive(root, "enabled");
+    bool valid = cJSON_IsObject(root) && cJSON_GetArraySize(root) == 2 &&
+        cJSON_IsString(command) && strcmp(command->valuestring, "set-motion-config") == 0 &&
+        cJSON_IsBool(value);
+    bool enabled = cJSON_IsTrue(value);
+    cJSON_Delete(root);
+    if (!valid)
+        return rss_ctrl_resp_error(resp, size, "expected enabled boolean");
+    if (enabled && !rss_config_get_bool(st->cfg, "stream1", "enabled", true))
+        return rss_ctrl_resp_error(resp, size,
+            "motion requires the configured substream");
+    if (st->ivs_jzdl || st->stream_count < 2)
+        return rss_ctrl_resp_error(resp, size, "motion configuration is unsupported");
+    if (rvd_ivs_set_enabled(st, enabled) != RSS_OK ||
+        atomic_load(&st->ivs_active) != enabled || st->ivs_receiving != enabled ||
+        (st->ivs_tid != 0) != enabled)
+        return rss_ctrl_resp_error(resp, size, "motion transition or owner readback failed");
+    rss_config_set_bool(st->cfg, "motion", "enabled", enabled);
+    if (strcmp(rss_config_get_str(st->cfg, "motion", "enabled", ""), enabled ? "true" : "false") != 0)
+        return rss_ctrl_resp_error(resp, size, "motion configuration cache failed");
+    return rss_ctrl_resp_ok(resp, size);
+}
+
+/* GOP limits are application representation policy, not an SDK range claim. */
+static bool gop_codec(const rvd_stream_t *s)
+{
+    return !s->is_jpeg && (s->enc_cfg.codec == RSS_CODEC_H264 ||
+        s->enc_cfg.codec == RSS_CODEC_H265);
+}
+
+int rvd_stream_gop_prepare(rvd_state_t *st, rvd_stream_t *s)
+{
+    s->gop_checked = false;
+    if (!gop_codec(s)) return RSS_OK;
+    const char *raw = rss_config_get_str(st->cfg, s->cfg_sect, "gop", NULL);
+    uint32_t value = s->enc_cfg.gop_length;
+    if (raw) {
+        size_t len = strlen(raw);
+        if (!len || len > 5) return RSS_ERR_INVAL;
+        value = 0;
+        for (size_t i = 0; i < len; i++) {
+            if (raw[i] < '0' || raw[i] > '9') return RSS_ERR_INVAL;
+            value = value * 10 + (unsigned)(raw[i] - '0');
+        }
+    }
+    if (!value || value > 65535 || !st->ops->enc_get_gop_attr ||
+        !st->ops->enc_get_gop_mode) return RSS_ERR_INVAL;
+    s->enc_cfg.gop_length = value;
+    return RSS_OK;
+}
+
+int rvd_stream_gop_verify(rvd_state_t *st, rvd_stream_t *s)
+{
+    if (!gop_codec(s)) return RSS_OK;
+    s->gop_checked = false;
+    uint32_t value = 0;
+    rss_gop_mode_t mode = RSS_GOP_DEFAULT;
+    if (RSS_HAL_CALL(st->ops, enc_get_gop_attr, st->hal_ctx, s->chn, &value) != RSS_OK ||
+        RSS_HAL_CALL(st->ops, enc_get_gop_mode, st->hal_ctx, s->chn, &mode) != RSS_OK ||
+        value != s->enc_cfg.gop_length || mode != s->enc_cfg.gop_mode ||
+        !value || value > 65535) return RSS_ERR;
+    s->gop_checked = true;
+    return RSS_OK;
+}
+
+static int gop_owner(rvd_state_t *st, int id)
+{
+    const char *section = id == 0 ? "stream0" : "stream1";
+    int found = -1;
+    for (int i = 0; i < st->stream_count; i++) {
+        rvd_stream_t *s = &st->streams[i];
+        if (!s->is_jpeg && s->sensor_idx == 0 && strcmp(s->cfg_sect, section) == 0) {
+            if (found >= 0) return -1;
+            found = i;
+        }
+    }
+    return found;
+}
+
+static bool section_uses_distinct_smart(rss_config_t *cfg, const char *section,
+                                        bool optional)
+{
+    if (optional && !rss_config_get_bool(cfg, section, "enabled", true))
+        return false;
+    return strcasecmp(rss_config_get_str(cfg, section, "rc_mode", "cbr"), "smart") == 0;
+}
+
+bool rvd_stream_smart_config_valid(rss_config_t *cfg, const rss_hal_caps_t *caps)
+{
+    if (!cfg || (caps && caps->has_smart_rc))
+        return cfg != NULL;
+    if (section_uses_distinct_smart(cfg, "stream0", false) ||
+        section_uses_distinct_smart(cfg, "stream1", true))
+        return false;
+
+    for (int sensor = 1; sensor < RVD_MAX_SENSORS; ++sensor) {
+        char sensor_section[24];
+        snprintf(sensor_section, sizeof(sensor_section), "sensor%d", sensor);
+        if (!rss_config_get_str(cfg, sensor_section, "name", "")[0])
+            continue;
+        char main_section[32], sub_section[32];
+        snprintf(main_section, sizeof(main_section), "sensor%d_stream0", sensor);
+        snprintf(sub_section, sizeof(sub_section), "sensor%d_stream1", sensor);
+        if (section_uses_distinct_smart(cfg, main_section, false) ||
+            section_uses_distinct_smart(cfg, sub_section, true))
+            return false;
+    }
+    return true;
+}
+
+bool rvd_stream_enable_config_valid(rss_config_t *cfg)
+{
+    if (!cfg || !rss_config_get_bool(cfg, "stream0", "enabled", true))
+        return false;
+    if (rss_config_get_bool(cfg, "stream1", "enabled", true))
+        return true;
+    return !rss_config_get_bool(cfg, "motion", "enabled", false) &&
+        !rss_config_get_bool(cfg, "recorder1", "autostart", false);
+}
+
+static bool stream_active_enabled(rvd_state_t *st, int id)
+{
+    int index = gop_owner(st, id);
+    return index >= 0 && st->streams[index].enabled &&
+        atomic_load(&st->stream_active[index]) && st->streams[index].ring;
+}
+
+int rvd_stream_enable_command(rvd_state_t *st, const char *json, char *resp, int size)
+{
+    cJSON *root = cJSON_ParseWithOpts(json, NULL, true);
+    const cJSON *cmd = cJSON_GetObjectItemCaseSensitive(root, "cmd");
+    const cJSON *id = cJSON_GetObjectItemCaseSensitive(root, "stream_id");
+    bool set = cJSON_IsString(cmd) &&
+        strcmp(cmd->valuestring, "set-stream-enabled-config") == 0;
+    const cJSON *enabled = cJSON_GetObjectItemCaseSensitive(root, "enabled");
+    bool valid = cJSON_IsObject(root) && cJSON_IsString(cmd) &&
+        (set || strcmp(cmd->valuestring, "get-stream-enabled") == 0) &&
+        cJSON_IsNumber(id) && id->valuedouble == id->valueint &&
+        id->valueint >= 0 && id->valueint <= 1 &&
+        cJSON_GetArraySize(root) == (set ? 3 : 2) && (!set || cJSON_IsBool(enabled));
+    int stream_id = valid ? id->valueint : -1;
+    bool requested = set && cJSON_IsTrue(enabled);
+    cJSON_Delete(root);
+    if (!valid)
+        return rss_ctrl_resp_error(resp, size, "invalid stream enable request");
+
+    bool active = stream_active_enabled(st, stream_id);
+    const char *section = stream_id == 0 ? "stream0" : "stream1";
+    bool configured = rss_config_get_bool(st->cfg, section, "enabled", true);
+    if (set) {
+        if (stream_id == 0)
+            return rss_ctrl_resp_error(resp, size,
+                "main stream is required by the current media profile");
+        if (!requested && rss_config_get_bool(st->cfg, "motion", "enabled", false))
+            return rss_ctrl_resp_error(resp, size,
+                "disable motion before disabling the substream");
+        if (!requested && rss_config_get_bool(st->cfg, "recorder1", "autostart", false))
+            return rss_ctrl_resp_error(resp, size,
+                "disable stream1 recorder autostart before disabling the substream");
+        rss_config_set_bool(st->cfg, "stream1", "enabled", requested);
+        configured = rss_config_get_bool(st->cfg, "stream1", "enabled", !requested);
+        if (configured != requested)
+            return rss_ctrl_resp_error(resp, size, "stream enable cache update failed");
+    }
+
+    cJSON *reply = cJSON_CreateObject();
+    cJSON_AddStringToObject(reply, "status", "ok");
+    cJSON_AddStringToObject(reply, "persistence", "checked-next-full-stack-restart");
+    cJSON_AddNumberToObject(reply, "stream_id", stream_id);
+    cJSON_AddBoolToObject(reply, "supported", true);
+    cJSON_AddBoolToObject(reply, "editable", stream_id == 1);
+    cJSON_AddBoolToObject(reply, "required", stream_id == 0);
+    cJSON_AddBoolToObject(reply, "active_enabled", active);
+    cJSON_AddBoolToObject(reply, "configured_enabled", configured);
+    cJSON_AddBoolToObject(reply, "pending_restart", active != configured);
+    cJSON_AddBoolToObject(reply, "motion_blocks_disable", stream_id == 1 &&
+        rss_config_get_bool(st->cfg, "motion", "enabled", false));
+    cJSON_AddBoolToObject(reply, "recorder_blocks_disable", stream_id == 1 &&
+        rss_config_get_bool(st->cfg, "recorder1", "autostart", false));
+    return rss_ctrl_resp_json(resp, size, reply);
+}
+
+int rvd_stream_audio_config_command(rvd_state_t *st, const char *json, char *resp, int size)
+{
+	cJSON *root = cJSON_ParseWithOpts(json, NULL, true);
+	const cJSON *cmd = cJSON_GetObjectItemCaseSensitive(root, "cmd");
+	const cJSON *id = cJSON_GetObjectItemCaseSensitive(root, "stream_id");
+	bool set = cJSON_IsString(cmd) && !strcmp(cmd->valuestring, "set-stream-audio-config");
+	const cJSON *enabled = cJSON_GetObjectItemCaseSensitive(root, "enabled");
+	bool valid = cJSON_IsObject(root) && cJSON_IsString(cmd) &&
+		(set || !strcmp(cmd->valuestring, "get-stream-audio-config")) &&
+		cJSON_IsNumber(id) && id->valuedouble == id->valueint && id->valueint >= 0 &&
+		id->valueint <= 1 && cJSON_GetArraySize(root) == (set ? 3 : 2) &&
+		(!set || cJSON_IsBool(enabled));
+	int stream_id = valid ? id->valueint : -1;
+	bool requested = set && cJSON_IsTrue(enabled);
+	cJSON_Delete(root);
+	if (!valid)
+		return rss_ctrl_resp_error(resp, size, "invalid stream audio request");
+	const char *section = stream_id ? "stream1" : "stream0";
+	if (set) {
+		rss_config_set_bool(st->cfg, section, "audio_enabled", requested);
+		if (rss_config_get_bool(st->cfg, section, "audio_enabled", !requested) != requested)
+			return rss_ctrl_resp_error(resp, size, "stream audio cache update failed");
+	}
+	cJSON *reply = cJSON_CreateObject();
+	cJSON_AddStringToObject(reply, "status", "ok");
+	cJSON_AddStringToObject(reply, "persistence", "checked-next-full-stack-restart");
+	cJSON_AddNumberToObject(reply, "stream_id", stream_id);
+	const char *configured = rss_config_get_str(st->cfg, section, "audio_enabled", NULL);
+	cJSON_AddBoolToObject(reply, "configured_explicit", configured != NULL);
+	if (configured)
+		cJSON_AddBoolToObject(reply, "configured_enabled",
+			rss_config_get_bool(st->cfg, section, "audio_enabled", false));
+	else
+		cJSON_AddNullToObject(reply, "configured_enabled");
+	return rss_ctrl_resp_json(resp, size, reply);
+}
+
+int rvd_stream_gop_command(rvd_state_t *st, const char *json, char *resp, int size)
+{
+    cJSON *root = cJSON_ParseWithOpts(json, NULL, true);
+    cJSON *cmd = cJSON_GetObjectItemCaseSensitive(root, "cmd");
+    cJSON *id = cJSON_GetObjectItemCaseSensitive(root, "stream_id");
+    cJSON *gop = cJSON_GetObjectItemCaseSensitive(root, "gop");
+    bool set = cJSON_IsString(cmd) && strcmp(cmd->valuestring, "set-stream-gop") == 0;
+    bool valid = cJSON_IsObject(root) && cJSON_IsString(cmd) &&
+        (set || strcmp(cmd->valuestring, "get-stream-gop") == 0) &&
+        cJSON_GetArraySize(root) == (set ? 3 : 2) && cJSON_IsNumber(id) &&
+        id->valuedouble == id->valueint && id->valueint >= 0 && id->valueint <= 1 &&
+        (!set || (cJSON_IsNumber(gop) && gop->valuedouble == gop->valueint &&
+         gop->valueint >= 1 && gop->valueint <= 65535));
+    if (!valid) {
+        cJSON_Delete(root);
+        return rss_ctrl_resp_error(resp, size, "invalid stream GOP request");
+    }
+    int stream_id = id->valueint, requested = set ? gop->valueint : 0;
+    cJSON_Delete(root);
+    int index = gop_owner(st, stream_id);
+    rvd_stream_t *s = index >= 0 ? &st->streams[index] : NULL;
+    bool supported = s && gop_codec(s) && s->gop_checked && st->ops->enc_set_gop &&
+        st->ops->enc_get_gop_attr && st->ops->enc_get_gop_mode;
+	bool available = supported && !rvd_codec_recovery_fs(st, s->fs_chn) &&
+		s->enabled && atomic_load(&st->stream_active[index]);
+    uint32_t observed = 0;
+    rss_gop_mode_t observed_mode = RSS_GOP_DEFAULT;
+    if (available && (st->ops->enc_get_gop_attr(st->hal_ctx, s->chn, &observed) != RSS_OK ||
+        st->ops->enc_get_gop_mode(st->hal_ctx, s->chn, &observed_mode) != RSS_OK ||
+        observed_mode != s->enc_cfg.gop_mode || !observed || observed > 65535)) available = false;
+    if (set) {
+        if (!available) return rss_ctrl_resp_error(resp, size, "stream GOP unavailable");
+        if (observed != (uint32_t)requested &&
+            st->ops->enc_set_gop(st->hal_ctx, s->chn, (uint32_t)requested) != RSS_OK)
+            return rss_ctrl_resp_error(resp, size, "stream GOP setter failed");
+        if (st->ops->enc_get_gop_attr(st->hal_ctx, s->chn, &observed) != RSS_OK ||
+            st->ops->enc_get_gop_mode(st->hal_ctx, s->chn, &observed_mode) != RSS_OK ||
+            observed != (uint32_t)requested || observed_mode != s->enc_cfg.gop_mode)
+            return rss_ctrl_resp_error(resp, size, "stream GOP readback failed");
+        s->enc_cfg.gop_length = observed;
+        rss_config_set_int(st->cfg, s->cfg_sect, "gop", requested);
+        char expected[6];
+        snprintf(expected, sizeof(expected), "%d", requested);
+        if (strcmp(rss_config_get_str(st->cfg, s->cfg_sect, "gop", ""), expected) != 0)
+            return rss_ctrl_resp_error(resp, size, "stream GOP cache update failed");
+    }
+    cJSON *r = cJSON_CreateObject();
+    cJSON_AddStringToObject(r, "status", "ok");
+    cJSON_AddStringToObject(r, "persistence", "checked-startup-gop");
+    cJSON_AddNumberToObject(r, "stream_id", stream_id);
+    cJSON_AddBoolToObject(r, "supported", supported);
+    cJSON_AddBoolToObject(r, "available", available);
+    if (available) cJSON_AddNumberToObject(r, "gop", observed);
+    else cJSON_AddNullToObject(r, "gop");
+    return rss_ctrl_resp_json(resp, size, r);
+}
+
+static const char *gop_mode_name(rss_gop_mode_t mode)
+{
+    switch (mode) {
+    case RSS_GOP_DEFAULT: return "default";
+    case RSS_GOP_PYRAMIDAL: return "pyramidal";
+    case RSS_GOP_SMARTP: return "smartp";
+    default: return NULL;
+    }
+}
+
+static bool gop_mode_parse(const cJSON *value, rss_gop_mode_t *mode)
+{
+    if (!cJSON_IsString(value)) return false;
+    if (strcmp(value->valuestring, "default") == 0) *mode = RSS_GOP_DEFAULT;
+    else if (strcmp(value->valuestring, "pyramidal") == 0) *mode = RSS_GOP_PYRAMIDAL;
+    else if (strcmp(value->valuestring, "smartp") == 0) *mode = RSS_GOP_SMARTP;
+    else return false;
+    return true;
+}
+
+bool rvd_stream_gop_mode_config_valid(rss_config_t *cfg)
+{
+    if (!cfg) return false;
+    for (int id = 0; id < 2; ++id) {
+        char section[16];
+        snprintf(section, sizeof(section), "stream%d", id);
+        if (id == 1 && !rss_config_get_bool(cfg, section, "enabled", true)) continue;
+        rss_gop_mode_t mode;
+        if (!rvd_stream_gop_mode_load(cfg, section, &mode)) return false;
+    }
+    return true;
+}
+
+bool rvd_stream_gop_mode_load(rss_config_t *cfg, const char *section,
+                              rss_gop_mode_t *mode)
+{
+    if (!cfg || !section || !mode) return false;
+    const char *value = rss_config_get_str(cfg, section, "gop_mode", "default");
+    if (strcasecmp(value, "default") == 0) *mode = RSS_GOP_DEFAULT;
+    else if (strcasecmp(value, "pyramidal") == 0) *mode = RSS_GOP_PYRAMIDAL;
+    else if (strcasecmp(value, "smartp") == 0) *mode = RSS_GOP_SMARTP;
+    else return false;
+    return true;
+}
+
+int rvd_stream_gop_mode_command(rvd_state_t *st, const char *json, char *resp, int size)
+{
+    cJSON *root = cJSON_ParseWithOpts(json, NULL, true);
+    cJSON *cmd = cJSON_GetObjectItemCaseSensitive(root, "cmd");
+    cJSON *id = cJSON_GetObjectItemCaseSensitive(root, "stream_id");
+    cJSON *mode_value = cJSON_GetObjectItemCaseSensitive(root, "gop_mode");
+    bool set = cJSON_IsString(cmd) && strcmp(cmd->valuestring, "set-stream-gop-mode") == 0;
+    rss_gop_mode_t requested = RSS_GOP_DEFAULT;
+    bool valid = cJSON_IsObject(root) && cJSON_IsString(cmd) &&
+        (set || strcmp(cmd->valuestring, "get-stream-gop-mode") == 0) &&
+        cJSON_GetArraySize(root) == (set ? 3 : 2) && cJSON_IsNumber(id) &&
+        id->valuedouble == id->valueint && id->valueint >= 0 && id->valueint <= 1 &&
+        (!set || gop_mode_parse(mode_value, &requested));
+    if (!valid) {
+        cJSON_Delete(root);
+        return rss_ctrl_resp_error(resp, size, "invalid restart-only GOP mode request");
+    }
+    int stream_id = id->valueint;
+    cJSON_Delete(root);
+    int index = gop_owner(st, stream_id);
+    rvd_stream_t *s = index >= 0 ? &st->streams[index] : NULL;
+    bool supported = s && gop_codec(s) && st->ops && st->ops->enc_get_gop_mode;
+    bool available = supported && !rvd_codec_recovery_fs(st, s->fs_chn) && s->enabled &&
+        atomic_load(&st->stream_active[index]);
+    rss_gop_mode_t active = RSS_GOP_DEFAULT;
+    if (available && (st->ops->enc_get_gop_mode(st->hal_ctx, s->chn, &active) != RSS_OK ||
+        !gop_mode_name(active) || active != s->enc_cfg.gop_mode)) available = false;
+    if (set) {
+        if (!available)
+            return rss_ctrl_resp_error(resp, size, "restart-only GOP mode unavailable");
+        const char *name = gop_mode_name(requested);
+        rss_config_set_str(st->cfg, s->cfg_sect, "gop_mode", name);
+        if (strcmp(rss_config_get_str(st->cfg, s->cfg_sect, "gop_mode", ""), name) != 0)
+            return rss_ctrl_resp_error(resp, size, "GOP mode configuration cache failed");
+        cJSON *reply = cJSON_CreateObject();
+        cJSON_AddStringToObject(reply, "status", "ok");
+        cJSON_AddStringToObject(reply, "persistence", "checked-next-full-stack-restart");
+        cJSON_AddBoolToObject(reply, "pending_restart", active != requested);
+        return rss_ctrl_resp_json(resp, size, reply);
+    }
+    cJSON *reply = cJSON_CreateObject();
+    cJSON_AddStringToObject(reply, "status", "ok");
+    cJSON_AddStringToObject(reply, "persistence", "checked-next-full-stack-restart");
+    cJSON_AddNumberToObject(reply, "stream_id", stream_id);
+    cJSON_AddBoolToObject(reply, "supported", supported);
+    cJSON_AddBoolToObject(reply, "available", available);
+    if (available) cJSON_AddStringToObject(reply, "active_mode", gop_mode_name(active));
+    else cJSON_AddNullToObject(reply, "active_mode");
+    return rss_ctrl_resp_json(resp, size, reply);
+}
+
+/* The matched T31 HAL setter accepts bit/s and writes SDK RC attributes in
+ * kbit/s. Its channel-attribute getter exposes those SDK fields unchanged.
+ * Keep that known unit boundary local to this T31-only semantic command. */
+#if defined(PLATFORM_T31)
+#define STREAM_BITRATE_MIN 1000u
+#define STREAM_BITRATE_MAX 100000000u
+
+static bool encoding_codec(const rvd_stream_t *s)
+{
+    return !s->is_jpeg && (s->enc_cfg.codec == RSS_CODEC_H264 ||
+        s->enc_cfg.codec == RSS_CODEC_H265);
+}
+
+static const char *encoding_mode_name(rss_rc_mode_t mode)
+{
+    switch (mode) {
+    case RSS_RC_CBR: return "cbr";
+    case RSS_RC_VBR: return "vbr";
+    case RSS_RC_CAPPED_VBR: return "capped_vbr";
+    case RSS_RC_CAPPED_QUALITY: return "capped_quality";
+    default: return NULL;
+    }
+}
+
+static bool encoding_mode_parse(const cJSON *value, rss_rc_mode_t *mode)
+{
+    if (!cJSON_IsString(value)) return false;
+    const char *name = value->valuestring;
+    if (strcmp(name, "cbr") == 0) *mode = RSS_RC_CBR;
+    else if (strcmp(name, "vbr") == 0) *mode = RSS_RC_VBR;
+    else if (strcmp(name, "capped_vbr") == 0) *mode = RSS_RC_CAPPED_VBR;
+    else if (strcmp(name, "capped_quality") == 0) *mode = RSS_RC_CAPPED_QUALITY;
+    else return false;
+    return true;
+}
+
+static bool encoding_non_rate_same(const rss_video_config_t *expected,
+                                   const rss_video_config_t *live)
+{
+    return live->codec == expected->codec && live->width == expected->width &&
+        live->height == expected->height &&
+        (live->codec == RSS_CODEC_H265 || live->profile == expected->profile) &&
+        live->fps_num == expected->fps_num && live->fps_den == expected->fps_den &&
+        live->gop_length == expected->gop_length;
+}
+
+static bool encoding_readback(rvd_state_t *st, rvd_stream_t *s,
+                              rss_video_config_t *live, uint32_t *bitrate)
+{
+    if (st->ops->enc_get_channel_attr(st->hal_ctx, s->chn, live) != RSS_OK ||
+        !encoding_non_rate_same(&s->enc_cfg, live) || !encoding_mode_name(live->rc_mode) ||
+        live->bitrate < STREAM_BITRATE_MIN / 1000u ||
+        live->bitrate > STREAM_BITRATE_MAX / 1000u)
+        return false;
+    *bitrate = live->bitrate * 1000u;
+    return true;
+}
+
+int rvd_stream_encoding_command(rvd_state_t *st, const char *json, char *resp, int size)
+{
+    cJSON *root = cJSON_ParseWithOpts(json, NULL, true);
+    cJSON *cmd = cJSON_GetObjectItemCaseSensitive(root, "cmd");
+    cJSON *id = cJSON_GetObjectItemCaseSensitive(root, "stream_id");
+    cJSON *mode_value = cJSON_GetObjectItemCaseSensitive(root, "rc_mode");
+    cJSON *bitrate_value = cJSON_GetObjectItemCaseSensitive(root, "bitrate");
+    bool set = cJSON_IsString(cmd) && strcmp(cmd->valuestring, "set-stream-encoding") == 0;
+    rss_rc_mode_t requested_mode = RSS_RC_CBR;
+    bool bitrate_valid = cJSON_IsNumber(bitrate_value) &&
+        bitrate_value->valuedouble == bitrate_value->valueint && bitrate_value->valueint >= 0 &&
+        (uint32_t)bitrate_value->valueint >= STREAM_BITRATE_MIN &&
+        (uint32_t)bitrate_value->valueint <= STREAM_BITRATE_MAX &&
+        (uint32_t)bitrate_value->valueint % 1000u == 0;
+    bool valid = cJSON_IsObject(root) && cJSON_IsString(cmd) &&
+        (set || strcmp(cmd->valuestring, "get-stream-encoding") == 0) &&
+        cJSON_GetArraySize(root) == (set ? 4 : 2) && cJSON_IsNumber(id) &&
+        id->valuedouble == id->valueint && id->valueint >= 0 && id->valueint <= 1 &&
+        (!set || (encoding_mode_parse(mode_value, &requested_mode) && bitrate_valid));
+    if (!valid) {
+        cJSON_Delete(root);
+        return rss_ctrl_resp_error(resp, size, "invalid stream encoding request");
+    }
+    int stream_id = id->valueint;
+    uint32_t requested_bitrate = set ? (uint32_t)bitrate_value->valueint : 0;
+    cJSON_Delete(root);
+
+    int index = gop_owner(st, stream_id);
+    rvd_stream_t *s = index >= 0 ? &st->streams[index] : NULL;
+    bool supported = s && encoding_codec(s) && st->ops && st->ops->enc_set_rc_mode &&
+        st->ops->enc_get_channel_attr;
+	bool available = supported && !rvd_codec_recovery_fs(st, s->fs_chn) &&
+		s->enabled && atomic_load(&st->stream_active[index]);
+    rss_video_config_t live = {0};
+    uint32_t observed_bitrate = 0;
+    if (available && !encoding_readback(st, s, &live, &observed_bitrate)) available = false;
+
+    if (set) {
+        if (!available)
+            return rss_ctrl_resp_error(resp, size, "stream encoding unavailable");
+        if ((live.rc_mode != requested_mode || observed_bitrate != requested_bitrate) &&
+            st->ops->enc_set_rc_mode(st->hal_ctx, s->chn, requested_mode,
+                                     requested_bitrate) != RSS_OK)
+            return rss_ctrl_resp_error(resp, size, "stream encoding setter failed");
+        if (!encoding_readback(st, s, &live, &observed_bitrate) ||
+            live.rc_mode != requested_mode || observed_bitrate != requested_bitrate)
+            return rss_ctrl_resp_error(resp, size, "stream encoding readback failed");
+        s->enc_cfg.rc_mode = requested_mode;
+        s->enc_cfg.bitrate = requested_bitrate;
+        const char *mode_name = encoding_mode_name(requested_mode);
+        rss_config_set_str(st->cfg, s->cfg_sect, "rc_mode", mode_name);
+        rss_config_set_int(st->cfg, s->cfg_sect, "bitrate", (int)requested_bitrate);
+        if (strcmp(rss_config_get_str(st->cfg, s->cfg_sect, "rc_mode", ""), mode_name) != 0 ||
+            rss_config_get_int(st->cfg, s->cfg_sect, "bitrate", 0) !=
+                (int)requested_bitrate)
+            return rss_ctrl_resp_error(resp, size, "stream encoding cache update failed");
+    }
+
+    cJSON *reply = cJSON_CreateObject();
+    cJSON_AddStringToObject(reply, "status", "ok");
+    cJSON_AddStringToObject(reply, "persistence", "checked-live-encoding");
+    cJSON_AddNumberToObject(reply, "stream_id", stream_id);
+    cJSON_AddBoolToObject(reply, "supported", supported);
+    cJSON_AddBoolToObject(reply, "available", available);
+    cJSON_AddNumberToObject(reply, "bitrate_min", STREAM_BITRATE_MIN);
+    cJSON_AddNumberToObject(reply, "bitrate_max", STREAM_BITRATE_MAX);
+    cJSON_AddNumberToObject(reply, "bitrate_step", 1000);
+    if (available) {
+        cJSON_AddStringToObject(reply, "rc_mode", encoding_mode_name(live.rc_mode));
+        cJSON_AddNumberToObject(reply, "bitrate", observed_bitrate);
+    } else {
+        cJSON_AddNullToObject(reply, "rc_mode");
+        cJSON_AddNullToObject(reply, "bitrate");
+    }
+    return rss_ctrl_resp_json(resp, size, reply);
+}
+
+#define STREAM_FIXQP_MIN 0
+#define STREAM_FIXQP_MAX 51
+
+static const char *rc_config_mode_name(rss_rc_mode_t mode)
+{
+    switch (mode) {
+    case RSS_RC_FIXQP: return "fixqp";
+    case RSS_RC_CBR: return "cbr";
+    case RSS_RC_VBR: return "vbr";
+    case RSS_RC_CAPPED_VBR: return "capped_vbr";
+    case RSS_RC_CAPPED_QUALITY: return "capped_quality";
+    default: return NULL;
+    }
+}
+
+static bool rc_config_mode_parse(const cJSON *value, rss_rc_mode_t *mode)
+{
+    if (!cJSON_IsString(value)) return false;
+    const char *name = value->valuestring;
+    if (strcmp(name, "fixqp") == 0) *mode = RSS_RC_FIXQP;
+    else if (strcmp(name, "cbr") == 0) *mode = RSS_RC_CBR;
+    else if (strcmp(name, "vbr") == 0) *mode = RSS_RC_VBR;
+    else if (strcmp(name, "capped_vbr") == 0) *mode = RSS_RC_CAPPED_VBR;
+    else if (strcmp(name, "capped_quality") == 0) *mode = RSS_RC_CAPPED_QUALITY;
+    else return false;
+    return true;
+}
+
+static bool decimal_qp(const char *raw, int *qp)
+{
+    if (!raw || !raw[0] || strlen(raw) > 2) return false;
+    int value = 0;
+    for (const char *p = raw; *p; ++p) {
+        if (*p < '0' || *p > '9') return false;
+        value = value * 10 + (*p - '0');
+    }
+    if (value < STREAM_FIXQP_MIN || value > STREAM_FIXQP_MAX) return false;
+    if (qp) *qp = value;
+    return true;
+}
+
+bool rvd_stream_fixqp_config_valid(rss_config_t *cfg)
+{
+    if (!cfg) return false;
+    for (int id = 0; id < 2; ++id) {
+        if (id == 1 && !rss_config_get_bool(cfg, "stream1", "enabled", true))
+            continue;
+        char section[16];
+        snprintf(section, sizeof(section), "stream%d", id);
+        const char *mode = rss_config_get_str(cfg, section, "rc_mode", "cbr");
+        if (strcasecmp(mode, "fixqp") == 0 &&
+            !decimal_qp(rss_config_get_str(cfg, section, "init_qp", NULL), NULL))
+            return false;
+    }
+    return true;
+}
+
+static bool rc_config_readback(rvd_state_t *st, rvd_stream_t *s,
+                               rss_video_config_t *live)
+{
+    if (st->ops->enc_get_channel_attr(st->hal_ctx, s->chn, live) != RSS_OK ||
+        !encoding_non_rate_same(&s->enc_cfg, live) || !rc_config_mode_name(live->rc_mode))
+        return false;
+    return live->rc_mode != RSS_RC_FIXQP ||
+        (live->init_qp >= STREAM_FIXQP_MIN && live->init_qp <= STREAM_FIXQP_MAX);
+}
+
+int rvd_stream_rc_config_verify(rvd_state_t *st, rvd_stream_t *s)
+{
+    if (!encoding_codec(s)) return RSS_OK;
+    if (!st->ops || !st->ops->enc_get_channel_attr) return RSS_ERR;
+
+    rss_video_config_t live = {0};
+    if (st->ops->enc_get_channel_attr(st->hal_ctx, s->chn, &live) != RSS_OK ||
+        live.rc_mode != s->enc_cfg.rc_mode)
+        return RSS_ERR;
+    if (live.rc_mode == RSS_RC_FIXQP &&
+        (s->enc_cfg.init_qp < STREAM_FIXQP_MIN || s->enc_cfg.init_qp > STREAM_FIXQP_MAX ||
+         live.init_qp != s->enc_cfg.init_qp))
+        return RSS_ERR;
+    return RSS_OK;
+}
+
+int rvd_stream_buffer_status_command(rvd_state_t *st, const char *json, char *resp, int size)
+{
+    cJSON *root = cJSON_ParseWithOpts(json, NULL, true);
+    cJSON *cmd = cJSON_GetObjectItemCaseSensitive(root, "cmd");
+    cJSON *id = cJSON_GetObjectItemCaseSensitive(root, "stream_id");
+    bool valid = cJSON_IsObject(root) && cJSON_GetArraySize(root) == 2 &&
+        cJSON_IsString(cmd) && strcmp(cmd->valuestring, "get-stream-buffer-status") == 0 &&
+        cJSON_IsNumber(id) && id->valuedouble == id->valueint &&
+        id->valueint >= 0 && id->valueint <= 1;
+    int stream_id = valid ? id->valueint : -1;
+    cJSON_Delete(root);
+    if (!valid)
+        return rss_ctrl_resp_error(resp, size, "invalid stream buffer status request");
+
+    int index = gop_owner(st, stream_id);
+    rvd_stream_t *stream = index >= 0 ? &st->streams[index] : NULL;
+    bool supported = st->ops && st->ops->fs_get_nr_vbs;
+    uint32_t active = 0;
+    bool available = supported && stream && stream->enabled &&
+        atomic_load(&st->stream_active[index]) &&
+        st->ops->fs_get_nr_vbs(st->hal_ctx, stream->fs_chn, &active) == RSS_OK;
+    char section[16];
+    snprintf(section, sizeof(section), "stream%d", stream_id);
+    int configured = rss_config_get_int(st->cfg, section, "nr_vbs", 2);
+
+    cJSON *reply = cJSON_CreateObject();
+    cJSON_AddStringToObject(reply, "status", "ok");
+    cJSON_AddStringToObject(reply, "persistence", "read-only-config-and-sdk");
+    cJSON_AddNumberToObject(reply, "stream_id", stream_id);
+    cJSON_AddBoolToObject(reply, "supported", supported);
+    cJSON_AddBoolToObject(reply, "available", available);
+    cJSON_AddBoolToObject(reply, "editable", false);
+    cJSON_AddStringToObject(reply, "profile", "dcs6100lhv2-a1-42m-22m-v1");
+    cJSON_AddNumberToObject(reply, "profile_required_buffers", 1);
+    cJSON_AddBoolToObject(reply, "hardware_limit_known", false);
+    if (available)
+        cJSON_AddNumberToObject(reply, "active_buffers", active);
+    else
+        cJSON_AddNullToObject(reply, "active_buffers");
+    if (configured > 0)
+        cJSON_AddNumberToObject(reply, "configured_buffers", configured);
+    else
+        cJSON_AddNullToObject(reply, "configured_buffers");
+    cJSON_AddBoolToObject(reply, "matches_configured",
+        available && configured > 0 && active == (uint32_t)configured);
+    cJSON_AddBoolToObject(reply, "profile_admitted",
+        available && active == 1 && configured == 1);
+    return rss_ctrl_resp_json(resp, size, reply);
+}
+
+int rvd_stream_rc_config_command(rvd_state_t *st, const char *json, char *resp, int size)
+{
+    cJSON *root = cJSON_ParseWithOpts(json, NULL, true);
+    cJSON *cmd = cJSON_GetObjectItemCaseSensitive(root, "cmd");
+    cJSON *id = cJSON_GetObjectItemCaseSensitive(root, "stream_id");
+    cJSON *mode_value = cJSON_GetObjectItemCaseSensitive(root, "rc_mode");
+    cJSON *qp_value = cJSON_GetObjectItemCaseSensitive(root, "initial_qp");
+    bool set = cJSON_IsString(cmd) && strcmp(cmd->valuestring, "set-stream-rc-config") == 0;
+    rss_rc_mode_t requested_mode = RSS_RC_CBR;
+    bool valid = cJSON_IsObject(root) && cJSON_IsString(cmd) &&
+        (set || strcmp(cmd->valuestring, "get-stream-rc-config") == 0) &&
+        cJSON_GetArraySize(root) == (set ? 4 : 2) && cJSON_IsNumber(id) &&
+        id->valuedouble == id->valueint && id->valueint >= 0 && id->valueint <= 1 &&
+        (!set || (rc_config_mode_parse(mode_value, &requested_mode) &&
+         cJSON_IsNumber(qp_value) && qp_value->valuedouble == qp_value->valueint &&
+         qp_value->valueint >= STREAM_FIXQP_MIN && qp_value->valueint <= STREAM_FIXQP_MAX));
+    if (!valid) {
+        cJSON_Delete(root);
+        return rss_ctrl_resp_error(resp, size, "invalid restart-only rate-control request");
+    }
+    int stream_id = id->valueint;
+    int requested_qp = set ? qp_value->valueint : 0;
+    cJSON_Delete(root);
+
+    int index = gop_owner(st, stream_id);
+    rvd_stream_t *s = index >= 0 ? &st->streams[index] : NULL;
+    bool supported = s && encoding_codec(s) && st->ops && st->ops->enc_get_channel_attr;
+    bool available = supported && !rvd_codec_recovery_fs(st, s->fs_chn) && s->enabled &&
+        atomic_load(&st->stream_active[index]);
+    rss_video_config_t live = {0};
+    if (available && !rc_config_readback(st, s, &live)) available = false;
+
+    if (set) {
+        if (!available || (live.rc_mode != RSS_RC_FIXQP && requested_mode != RSS_RC_FIXQP))
+            return rss_ctrl_resp_error(resp, size,
+                "restart-only rate-control transition unavailable");
+        const char *mode_name = rc_config_mode_name(requested_mode);
+        rss_config_set_str(st->cfg, s->cfg_sect, "rc_mode", mode_name);
+        rss_config_set_int(st->cfg, s->cfg_sect, "init_qp", requested_qp);
+        if (strcmp(rss_config_get_str(st->cfg, s->cfg_sect, "rc_mode", ""), mode_name) != 0 ||
+            rss_config_get_int(st->cfg, s->cfg_sect, "init_qp", -1) != requested_qp)
+            return rss_ctrl_resp_error(resp, size, "rate-control configuration cache failed");
+        cJSON *reply = cJSON_CreateObject();
+        cJSON_AddStringToObject(reply, "status", "ok");
+        cJSON_AddStringToObject(reply, "persistence", "checked-next-full-stack-restart");
+        cJSON_AddBoolToObject(reply, "pending_restart", live.rc_mode != requested_mode ||
+            (live.rc_mode == RSS_RC_FIXQP && live.init_qp != requested_qp));
+        return rss_ctrl_resp_json(resp, size, reply);
+    }
+
+    cJSON *reply = cJSON_CreateObject();
+    cJSON_AddStringToObject(reply, "status", "ok");
+    cJSON_AddStringToObject(reply, "persistence", "checked-next-full-stack-restart");
+    cJSON_AddNumberToObject(reply, "stream_id", stream_id);
+    cJSON_AddBoolToObject(reply, "supported", supported);
+    cJSON_AddBoolToObject(reply, "available", available);
+    cJSON_AddNumberToObject(reply, "qp_min", STREAM_FIXQP_MIN);
+    cJSON_AddNumberToObject(reply, "qp_max", STREAM_FIXQP_MAX);
+    if (available) {
+        cJSON_AddStringToObject(reply, "active_mode", rc_config_mode_name(live.rc_mode));
+        if (live.rc_mode == RSS_RC_FIXQP)
+            cJSON_AddNumberToObject(reply, "active_qp", live.init_qp);
+        else
+            cJSON_AddNullToObject(reply, "active_qp");
+    } else {
+        cJSON_AddNullToObject(reply, "active_mode");
+        cJSON_AddNullToObject(reply, "active_qp");
+    }
+    return rss_ctrl_resp_json(resp, size, reply);
+}
+
+/* The DCS-6100LHV2 A1 startup profile is deliberately narrower than the
+ * scaler's theoretical range. Every admitted pair is even, 16:9, inside the
+ * 1920x1080 OS02G10 envelope and no larger than the installed FS/JPEG profile.
+ * Keeping the substream at no more than one third of the main stream also
+ * keeps the reserved 48 px, 22-character timestamp canvas within its tested
+ * main/sub allocation. Other hardware-valid combinations need their own
+ * memory and camera acceptance before admission here. */
+static bool geometry_pair(int id, int width, int height)
+{
+    static const int main[][2] = {{1920, 1080}, {1280, 720}};
+    static const int sub[][2] = {{640, 360}, {480, 270}, {320, 180}};
+    const int (*pairs)[2] = id == 0 ? main : sub;
+    size_t count = id == 0 ? sizeof(main) / sizeof(main[0]) : sizeof(sub) / sizeof(sub[0]);
+    for (size_t i = 0; i < count; ++i)
+        if (pairs[i][0] == width && pairs[i][1] == height)
+            return true;
+    return false;
+}
+
+static bool geometry_combination(int main_w, int main_h, int sub_w, int sub_h)
+{
+    return geometry_pair(0, main_w, main_h) && geometry_pair(1, sub_w, sub_h) &&
+        sub_w * 3 <= main_w && sub_h * 3 <= main_h;
+}
+
+static bool geometry_roi_at(rss_config_t *cfg, int index, int width, int height,
+                            rss_rect_t *parsed)
+{
+    char key[16];
+    snprintf(key, sizeof(key), "roi%d", index);
+    const char *raw = rss_config_get_str(cfg, "motion", key, "");
+    int x0, y0, x1, y1;
+    char tail;
+    if (sscanf(raw, "%d,%d,%d,%d%c", &x0, &y0, &x1, &y1, &tail) != 4 ||
+        x0 < 0 || y0 < 0 || x0 >= x1 || y0 >= y1 || x1 >= width || y1 >= height)
+        return false;
+    if (parsed)
+        *parsed = (rss_rect_t){x0, y0, x1, y1};
+    return true;
+}
+
+static bool geometry_single_roi(rss_config_t *cfg, int width, int height,
+                                bool update_full_frame, bool *adjusted)
+{
+    if (adjusted)
+        *adjusted = false;
+    if (rss_config_get_int(cfg, "motion", "roi_count", 0) != 1)
+        return false;
+    int prior_w = rss_config_get_int(cfg, "stream1", "width", -1);
+    int prior_h = rss_config_get_int(cfg, "stream1", "height", -1);
+    rss_rect_t roi;
+    if (!geometry_roi_at(cfg, 0, prior_w, prior_h, &roi))
+        return false;
+    bool full_frame = roi.p0_x == 0 && roi.p0_y == 0 && roi.p1_x == prior_w - 1 &&
+        roi.p1_y == prior_h - 1;
+    if (full_frame && update_full_frame) {
+        char next[48];
+        snprintf(next, sizeof(next), "0,0,%d,%d", width - 1, height - 1);
+        rss_config_set_str(cfg, "motion", "roi0", next);
+        bool match = strcmp(rss_config_get_str(cfg, "motion", "roi0", ""), next) == 0;
+        if (match && adjusted)
+            *adjusted = true;
+        return match;
+    }
+    return roi.p1_x < width && roi.p1_y < height;
+}
+
+bool rvd_stream_geometry_config_valid(rss_config_t *cfg)
+{
+    if (!cfg)
+        return false;
+    if (strcmp(rss_config_get_str(cfg, "sensor", "name", ""), "os02g10") != 0)
+        return true;
+    int main_w = rss_config_get_int(cfg, "stream0", "width", -1);
+    int main_h = rss_config_get_int(cfg, "stream0", "height", -1);
+    int sub_w = rss_config_get_int(cfg, "stream1", "width", -1);
+    int sub_h = rss_config_get_int(cfg, "stream1", "height", -1);
+    if (main_w < 2 || main_w > 4096 || main_h < 2 || main_h > 4096)
+        return false;
+    if (!rss_config_get_bool(cfg, "stream1", "enabled", true))
+        return true;
+    if (sub_w < 2 || sub_w > 4096 || sub_h < 2 || sub_h > 4096)
+        return false;
+    if (!rss_config_get_bool(cfg, "motion", "enabled", false) ||
+        strcmp(rss_config_get_str(cfg, "motion", "algorithm", "move"), "move") != 0)
+        return true;
+    int roi_count = rss_config_get_int(cfg, "motion", "roi_count", 0);
+    if (roi_count < 1 || roi_count > RSS_IVS_MAX_ROI)
+        return true;
+    for (int i = 0; i < roi_count; ++i)
+        if (!geometry_roi_at(cfg, i, sub_w, sub_h, NULL))
+            return false;
+    return true;
+}
+
+static bool geometry_mutation_admitted(rss_config_t *cfg)
+{
+    int main_w = rss_config_get_int(cfg, "stream0", "width", -1);
+    int main_h = rss_config_get_int(cfg, "stream0", "height", -1);
+    int sub_w = rss_config_get_int(cfg, "stream1", "width", -1);
+    int sub_h = rss_config_get_int(cfg, "stream1", "height", -1);
+    return strcmp(rss_config_get_str(cfg, "sensor", "name", ""), "os02g10") == 0 &&
+        rss_config_get_int(cfg, "stream0", "nr_vbs", -1) == 1 &&
+        rss_config_get_int(cfg, "stream1", "nr_vbs", -1) == 1 &&
+        rss_config_get_bool(cfg, "stream1", "enabled", false) &&
+        rss_config_get_bool(cfg, "jpeg", "enabled", false) &&
+        rss_config_get_bool(cfg, "stream0", "jpeg", false) &&
+        rss_config_get_bool(cfg, "stream1", "jpeg", false) &&
+        rss_config_get_int(cfg, "osd", "font_size", -1) >= 16 &&
+        rss_config_get_int(cfg, "osd", "font_size", -1) <= 48 &&
+        rss_config_get_int(cfg, "osd.timestamp", "max_chars", -1) > 0 &&
+        rss_config_get_int(cfg, "osd.timestamp", "max_chars", -1) <= 22 &&
+        geometry_combination(main_w, main_h, sub_w, sub_h) &&
+        geometry_single_roi(cfg, sub_w, sub_h, false, NULL);
+}
+
+bool rvd_stream_geometry_pending(rvd_state_t *st)
+{
+    if (!st || !st->cfg)
+        return false;
+    for (int id = 0; id < 2; ++id) {
+        int index = gop_owner(st, id);
+        if (index < 0)
+            return false;
+        char section[16];
+        snprintf(section, sizeof(section), "stream%d", id);
+        int width = rss_config_get_int(st->cfg, section, "width", -1);
+        int height = rss_config_get_int(st->cfg, section, "height", -1);
+        if (width < 0 || height < 0 || (uint32_t)width != st->streams[index].enc_cfg.width ||
+            (uint32_t)height != st->streams[index].enc_cfg.height)
+            return true;
+    }
+    return false;
+}
+
+static bool geometry_live(rvd_state_t *st, int id, int *width, int *height)
+{
+    int index = gop_owner(st, id);
+    if (index < 0 || !st->ops || !st->ops->enc_get_channel_attr)
+        return false;
+    rvd_stream_t *stream = &st->streams[index];
+    if (!stream->enabled || !atomic_load(&st->stream_active[index]) ||
+        rvd_fps_blocked_fs(st, stream->fs_chn) ||
+        rvd_codec_recovery_fs(st, stream->fs_chn) || !stream->ring)
+        return false;
+    rss_video_config_t attr = {0};
+    const rss_ring_header_t *ring = rss_ring_get_header(stream->ring);
+    if (!ring || st->ops->enc_get_channel_attr(st->hal_ctx, stream->chn, &attr) != RSS_OK ||
+        attr.codec != stream->enc_cfg.codec || attr.width != stream->enc_cfg.width ||
+        attr.height != stream->enc_cfg.height || ring->codec != (uint32_t)attr.codec ||
+        ring->width != attr.width || ring->height != attr.height)
+        return false;
+    *width = (int)attr.width;
+    *height = (int)attr.height;
+    return true;
+}
+
+int rvd_stream_geometry_command(rvd_state_t *st, const char *json, char *resp, int size)
+{
+    cJSON *root = cJSON_ParseWithOpts(json, NULL, true);
+    cJSON *cmd = cJSON_GetObjectItemCaseSensitive(root, "cmd");
+    bool set = cJSON_IsString(cmd) &&
+        strcmp(cmd->valuestring, "set-stream-geometry-config") == 0;
+    cJSON *id = cJSON_GetObjectItemCaseSensitive(root, "stream_id");
+    const char *names[] = {"stream0_width", "stream0_height", "stream1_width", "stream1_height"};
+    int requested[4] = {0};
+    bool valid = cJSON_IsObject(root) && cJSON_IsString(cmd) &&
+        (set || strcmp(cmd->valuestring, "get-stream-geometry") == 0) &&
+        cJSON_GetArraySize(root) == (set ? 5 : 2);
+    if (set) {
+        for (int i = 0; valid && i < 4; ++i) {
+            cJSON *value = cJSON_GetObjectItemCaseSensitive(root, names[i]);
+            valid = cJSON_IsNumber(value) && value->valuedouble == value->valueint;
+            if (valid) requested[i] = value->valueint;
+        }
+        valid = valid && geometry_combination(requested[0], requested[1], requested[2], requested[3]);
+    } else {
+        valid = valid && cJSON_IsNumber(id) && id->valuedouble == id->valueint &&
+            id->valueint >= 0 && id->valueint <= 1;
+    }
+    int stream_id = !set && valid ? id->valueint : -1;
+    cJSON_Delete(root);
+    if (!valid)
+        return rss_ctrl_resp_error(resp, size, "invalid admitted stream geometry request");
+
+    int active_w[2], active_h[2];
+    bool available = strcmp(rss_config_get_str(st->cfg, "sensor", "name", ""), "os02g10") == 0 &&
+        !st->ivs_roi_uncertain && geometry_live(st, 0, &active_w[0], &active_h[0]) &&
+        geometry_live(st, 1, &active_w[1], &active_h[1]);
+    if (set) {
+        if (!available || !geometry_mutation_admitted(st->cfg))
+            return rss_ctrl_resp_error(resp, size, "stream geometry configuration unavailable");
+        int prior_w = rss_config_get_int(st->cfg, "stream1", "width", -1);
+        int prior_h = rss_config_get_int(st->cfg, "stream1", "height", -1);
+        bool change_sub = requested[2] != prior_w || requested[3] != prior_h;
+        bool adjust_roi = false;
+        if (change_sub && !geometry_single_roi(st->cfg, requested[2], requested[3], true,
+                                               &adjust_roi))
+            return rss_ctrl_resp_error(resp, size, "saved motion ROI does not fit requested substream");
+        rss_config_set_int(st->cfg, "stream0", "width", requested[0]);
+        rss_config_set_int(st->cfg, "stream0", "height", requested[1]);
+        rss_config_set_int(st->cfg, "stream1", "width", requested[2]);
+        rss_config_set_int(st->cfg, "stream1", "height", requested[3]);
+        for (int i = 0; i < 4; ++i) {
+            const char *section = i < 2 ? "stream0" : "stream1";
+            const char *key = i % 2 == 0 ? "width" : "height";
+            if (rss_config_get_int(st->cfg, section, key, -1) != requested[i])
+                return rss_ctrl_resp_error(resp, size, "stream geometry cache update failed");
+        }
+        cJSON *reply = cJSON_CreateObject();
+        cJSON_AddStringToObject(reply, "status", "ok");
+        cJSON_AddStringToObject(reply, "persistence", "checked-next-full-stack-restart");
+        cJSON_AddBoolToObject(reply, "motion_roi_full_frame_adjusted", adjust_roi);
+        cJSON_AddBoolToObject(reply, "pending_restart",
+            active_w[0] != requested[0] || active_h[0] != requested[1] ||
+            active_w[1] != requested[2] || active_h[1] != requested[3]);
+        return rss_ctrl_resp_json(resp, size, reply);
+    }
+
+    cJSON *reply = cJSON_CreateObject();
+    cJSON_AddStringToObject(reply, "status", "ok");
+    cJSON_AddStringToObject(reply, "persistence", "checked-next-full-stack-restart");
+    cJSON_AddNumberToObject(reply, "stream_id", stream_id);
+    cJSON_AddBoolToObject(reply, "supported", true);
+    cJSON_AddBoolToObject(reply, "available", available);
+    cJSON_AddStringToObject(reply, "profile", "dcs6100lhv2-a1-42m-22m-v1");
+    if (available) {
+        cJSON_AddNumberToObject(reply, "active_width", active_w[stream_id]);
+        cJSON_AddNumberToObject(reply, "active_height", active_h[stream_id]);
+    } else {
+        cJSON_AddNullToObject(reply, "active_width");
+        cJSON_AddNullToObject(reply, "active_height");
+    }
+    return rss_ctrl_resp_json(resp, size, reply);
+}
+#else
+int rvd_stream_rc_config_verify(rvd_state_t *st, rvd_stream_t *s)
+{
+    (void)st;
+    (void)s;
+    return RSS_OK;
+}
