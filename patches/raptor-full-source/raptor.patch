diff --git a/tests/test_rod_metadata.c b/tests/test_rod_metadata.c
new file mode 100644
index 0000000000000000000000000000000000000000..00a144bebcff49fcb48d3ca15910d12f83f18437
--- /dev/null
+++ b/tests/test_rod_metadata.c
@@ -0,0 +1,267 @@
+#include "rod_metadata.h"
+
+#include <assert.h>
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+
+static const uint8_t expected_uuid[16] = {
+	0xa1, 0xb2, 0xc3, 0xd4, 0xe5, 0xf6, 0x47, 0x80,
+	0xab, 0xcd, 0xef, 0x12, 0x34, 0x56, 0x78, 0x90,
+};
+
+static int parse_metadata_sei(const uint8_t *encoded, size_t encoded_len, int codec, int prefix,
+			      char *json, size_t json_cap)
+{
+	if (!encoded || !json || !json_cap)
+		return -EINVAL;
+	size_t prefix_len = prefix == RSS_SEI_PREFIX_NONE ? 0 : 4;
+	if (encoded_len <= prefix_len)
+		return -EBADMSG;
+	if (prefix == RSS_SEI_PREFIX_ANNEXB) {
+		static const uint8_t start_code[4] = {0, 0, 0, 1};
+		if (memcmp(encoded, start_code, sizeof(start_code)) != 0)
+			return -EBADMSG;
+	} else if (prefix == RSS_SEI_PREFIX_AVCC) {
+		size_t declared = ((size_t)encoded[0] << 24) | ((size_t)encoded[1] << 16) |
+				  ((size_t)encoded[2] << 8) | encoded[3];
+		if (declared != encoded_len - 4)
+			return -EBADMSG;
+	} else if (prefix != RSS_SEI_PREFIX_NONE) {
+		return -EINVAL;
+	}
+
+	const uint8_t *nal = encoded + prefix_len;
+	size_t nal_len = encoded_len - prefix_len;
+	size_t header_len;
+	if (codec == RSS_SEI_CODEC_H264) {
+		if ((nal[0] & 0x1f) != 6)
+			return -EBADMSG;
+		header_len = 1;
+	} else if (codec == RSS_SEI_CODEC_H265) {
+		if (nal_len < 2 || ((nal[0] >> 1) & 0x3f) != 39 || nal[1] != 1)
+			return -EBADMSG;
+		header_len = 2;
+	} else {
+		return -EINVAL;
+	}
+
+	uint8_t rbsp[ROD_METADATA_JSON_MAX + 32];
+	size_t rbsp_len = 0;
+	int zeros = 0;
+	for (size_t i = header_len; i < nal_len; ++i) {
+		uint8_t byte = nal[i];
+		if (zeros == 2 && byte == 3) {
+			zeros = 0;
+			continue;
+		}
+		if (rbsp_len == sizeof(rbsp))
+			return -E2BIG;
+		rbsp[rbsp_len++] = byte;
+		zeros = byte == 0 ? zeros + 1 : 0;
+	}
+
+	size_t offset = 0;
+	size_t payload_type = 0;
+	while (offset < rbsp_len && rbsp[offset] == 0xff) {
+		payload_type += 0xff;
+		offset++;
+	}
+	if (offset >= rbsp_len)
+		return -EBADMSG;
+	payload_type += rbsp[offset++];
+	size_t payload_size = 0;
+	while (offset < rbsp_len && rbsp[offset] == 0xff) {
+		payload_size += 0xff;
+		offset++;
+	}
+	if (offset >= rbsp_len)
+		return -EBADMSG;
+	payload_size += rbsp[offset++];
+	if (payload_type != 5 || payload_size < sizeof(expected_uuid) ||
+	    payload_size > rbsp_len - offset ||
+	    memcmp(rbsp + offset, expected_uuid, sizeof(expected_uuid)) != 0 ||
+	    offset + payload_size + 1 != rbsp_len || rbsp[offset + payload_size] != 0x80)
+		return -EBADMSG;
+	size_t json_len = payload_size - sizeof(expected_uuid);
+	if (json_len >= json_cap)
+		return -ENOSPC;
+	memcpy(json, rbsp + offset + sizeof(expected_uuid), json_len);
+	json[json_len] = '\0';
+	return (int)json_len;
+}
+
+static void test_entry_validation(void)
+{
+	rod_metadata_entry_t entry;
+	assert(rod_metadata_entry_parse(&entry, "label", "text", "Keitti\xc3\xb6", "10,20") == 0);
+	assert(rod_metadata_entry_parse(&entry, "gain", "gain", "vahvistus \xc3\xa4=%s", "-10,20") == 0);
+	assert(rod_metadata_entry_parse(&entry, "host", "hostname", "%s", "0,0") == 0);
+	assert(rod_metadata_entry_parse(&entry, "ip", "ipaddress", "[%s]", "8192,-8192") == 0);
+	assert(rod_metadata_entry_parse(&entry, "clock", "timestamp", "%F %T %Z", "0,0") == 0);
+	assert(rod_metadata_entry_parse(&entry, "up", "uptime", "%02lu:%02lu:%02lu", "0,0") == 0);
+
+	assert(rod_metadata_entry_parse(&entry, "name", NULL, "x", "0,0") == -EINVAL);
+	assert(rod_metadata_entry_parse(&entry, "_name", "text", "x", "0,0") == 0);
+	assert(rod_metadata_entry_parse(&entry, "bad/name", "text", "x", "0,0") == -EINVAL);
+	assert(rod_metadata_entry_parse(&entry, "name", "other", "x", "0,0") == -EINVAL);
+	assert(rod_metadata_entry_parse(&entry, "name", "gain", "%n", "0,0") == -EINVAL);
+	assert(rod_metadata_entry_parse(&entry, "name", "gain", "%s%s", "0,0") == -EINVAL);
+	assert(rod_metadata_entry_parse(&entry, "name", "timestamp", "%q", "0,0") == -EINVAL);
+	assert(rod_metadata_entry_parse(&entry, "name", "uptime", "%lu:%n:%lu", "0,0") ==
+	       -EINVAL);
+	assert(rod_metadata_entry_parse(&entry, "name", "text", "x", "8193,0") == -EINVAL);
+	assert(rod_metadata_entry_parse(&entry, "name", "text", "x", "0,0 trailing") ==
+	       -EINVAL);
+	assert(rod_metadata_entry_parse(&entry, "name", "text", "line\nfeed", "0,0") ==
+	       -EINVAL);
+	const char malformed_utf8[] = {'x', (char)0xc3, '(', '\0'};
+	assert(rod_metadata_entry_parse(&entry, "name", "text", malformed_utf8, "0,0") ==
+	       -EINVAL);
+
+	char exact_limit[ROD_METADATA_FORMAT_MAX + 1];
+	memset(exact_limit, 'a', sizeof(exact_limit));
+	exact_limit[ROD_METADATA_FORMAT_MAX - 2] = (char)0xc3;
+	exact_limit[ROD_METADATA_FORMAT_MAX - 1] = (char)0xb6;
+	exact_limit[ROD_METADATA_FORMAT_MAX] = '\0';
+	assert(rod_metadata_entry_parse(&entry, "name", "text", exact_limit, "0,0") == 0);
+	char over_limit[ROD_METADATA_FORMAT_MAX + 2];
+	memset(over_limit, 'a', sizeof(over_limit));
+	over_limit[ROD_METADATA_FORMAT_MAX - 1] = (char)0xc3;
+	over_limit[ROD_METADATA_FORMAT_MAX] = (char)0xb6;
+	over_limit[ROD_METADATA_FORMAT_MAX + 1] = '\0';
+	assert(rod_metadata_entry_parse(&entry, "name", "text", over_limit, "0,0") == -EINVAL);
+
+	char unterminated_name[ROD_METADATA_NAME_MAX + 1];
+	memset(unterminated_name, 'a', sizeof(unterminated_name));
+	assert(rod_metadata_entry_parse(&entry, unterminated_name, "text", "x", "0,0") ==
+	       -EINVAL);
+	char unterminated_format[ROD_METADATA_FORMAT_MAX + 1];
+	memset(unterminated_format, 'a', sizeof(unterminated_format));
+	assert(rod_metadata_entry_parse(&entry, "name", "text", unterminated_format, "0,0") ==
+	       -EINVAL);
+}
+
+static void test_render_and_json_escape(void)
+{
+	rod_metadata_entry_t entries[6];
+	assert(rod_metadata_entry_parse(&entries[0], "label", "text", "Keitti\xc3\xb6 \"A\" \\",
+					 "10,10") == 0);
+	assert(rod_metadata_entry_parse(&entries[1], "gain", "gain", "gain=%s", "10,-10") ==
+	       0);
+	assert(rod_metadata_entry_parse(&entries[2], "host", "hostname", "%s", "0,10") == 0);
+	assert(rod_metadata_entry_parse(&entries[3], "ip", "ipaddress", "[%s]", "0,-10") == 0);
+	assert(rod_metadata_entry_parse(&entries[4], "clock", "timestamp", "%F %T", "-10,-10") ==
+	       0);
+	assert(rod_metadata_entry_parse(&entries[5], "up", "uptime", "%02lu:%02lu:%02lu",
+					 "-10,10") == 0);
+	rod_metadata_values_t values = {
+		.stream_width = 1920,
+		.stream_height = 1080,
+		.rotation = 0,
+		.local_time = {.tm_year = 126, .tm_mon = 8, .tm_mday = 13,
+			       .tm_hour = 14, .tm_min = 5, .tm_sec = 6},
+		.time_available = true,
+		.gain = "12.5",
+		.hostname = "camera-a",
+		.ipaddress = "192.0.2.10",
+		.uptime_seconds = 86400 + 2 * 3600 + 3 * 60,
+	};
+	char rendered[128];
+	assert(rod_metadata_render(&entries[5], &values, rendered, sizeof(rendered)) == 8);
+	assert(strcmp(rendered, "01:02:03") == 0);
+
+	char json[ROD_METADATA_JSON_MAX + 1];
+	int length = rod_metadata_build_json(entries, 6, &values, json, sizeof(json));
+	assert(length > 0 && (size_t)length == strlen(json));
+	assert(strstr(json, "\"text\":\"Keitti\xc3\xb6 \\\"A\\\" \\\\\"") != NULL);
+	assert(strstr(json, "\"name\":\"clock\"") != NULL);
+	assert(strstr(json, "\"text\":\"2026-09-13 14:05:06\"") != NULL);
+	assert(strstr(json, "\"text\":\"01:02:03\"") != NULL);
+	assert(rod_metadata_build_json(entries, 6, &values, rendered, sizeof(rendered)) == -ENOSPC);
+	values.hostname = "camera\nline";
+	assert(rod_metadata_build_json(entries, 6, &values, json, sizeof(json)) == -EINVAL);
+	values.hostname = "kamera-\xc3\xa4";
+	assert(rod_metadata_build_json(entries, 6, &values, json, sizeof(json)) > 0);
+	assert(strstr(json, "kamera-\xc3\xa4") != NULL);
+	values.hostname = "camera-a";
+	entries[5] = entries[0];
+	assert(rod_metadata_build_json(entries, 6, &values, json, sizeof(json)) == -EINVAL);
+	rod_metadata_entry_t unterminated = entries[0];
+	memset(unterminated.name, 'a', sizeof(unterminated.name));
+	assert(rod_metadata_render(&unterminated, &values, rendered, sizeof(rendered)) == -EINVAL);
+	assert(rod_metadata_build_json(&unterminated, 1, &values, json, sizeof(json)) == -EINVAL);
+	unterminated = entries[0];
+	memset(unterminated.format, 'a', sizeof(unterminated.format));
+	assert(rod_metadata_render(&unterminated, &values, rendered, sizeof(rendered)) == -EINVAL);
+	assert(rod_metadata_build_json(&unterminated, 1, &values, json, sizeof(json)) == -EINVAL);
+}
+
+static void test_h264_h265_serialization(void)
+{
+	const char json[] = "{\"v\":1,\"elements\":[{\"name\":\"clock\",\"text\":\"12:34\"}]}";
+	for (int codec = RSS_SEI_CODEC_H264; codec <= RSS_SEI_CODEC_H265; ++codec) {
+		for (int prefix = RSS_SEI_PREFIX_NONE; prefix <= RSS_SEI_PREFIX_AVCC; ++prefix) {
+			uint8_t sei[ROD_METADATA_SEI_MAX];
+			int length = rod_metadata_build_sei(sei, sizeof(sei), codec, prefix,
+						    json, strlen(json));
+			assert(length > 0);
+			char parsed[ROD_METADATA_JSON_MAX + 1];
+			assert(parse_metadata_sei(sei, (size_t)length, codec, prefix, parsed,
+						  sizeof(parsed)) == (int)strlen(json));
+			assert(strcmp(parsed, json) == 0);
+			sei[length - 1] ^= 1;
+			assert(parse_metadata_sei(sei, (size_t)length, codec, prefix, parsed,
+						  sizeof(parsed)) == -EBADMSG);
+		}
+	}
+	uint8_t small[16];
+	assert(rod_metadata_build_sei(small, sizeof(small), RSS_SEI_CODEC_H264,
+				      RSS_SEI_PREFIX_ANNEXB, json, strlen(json)) == -ENOSPC);
+	assert(rod_metadata_build_sei(small, sizeof(small), 7, RSS_SEI_PREFIX_NONE,
+				      json, strlen(json)) == -EINVAL);
+
+	char long_json[320];
+	memset(long_json, 'a', sizeof(long_json));
+	long_json[0] = '{';
+	memcpy(long_json + 1, "\"x\":\"", 5);
+	long_json[sizeof(long_json) - 3] = '\"';
+	long_json[sizeof(long_json) - 2] = '}';
+	long_json[sizeof(long_json) - 1] = '\0';
+	uint8_t sei[ROD_METADATA_SEI_MAX];
+	int length = rod_metadata_build_sei(sei, sizeof(sei), RSS_SEI_CODEC_H265,
+					    RSS_SEI_PREFIX_AVCC, long_json, strlen(long_json));
+	assert(length > 0);
+	char parsed[sizeof(long_json)];
+	assert(parse_metadata_sei(sei, (size_t)length, RSS_SEI_CODEC_H265,
+				  RSS_SEI_PREFIX_AVCC, parsed, sizeof(parsed)) ==
+	       (int)strlen(long_json));
+	assert(strcmp(parsed, long_json) == 0);
+}
+
+static void test_config_size_bound(void)
+{
+	rod_metadata_config_t metadata = {.valid = true, .count = 1};
+	assert(rod_metadata_entry_parse(&metadata.entries[0], "clock", "timestamp", "%Z",
+				       "0,0") == 0);
+	assert(rod_metadata_config_fits(&metadata));
+
+	metadata.count = ROD_METADATA_MAX_ENTRIES;
+	for (size_t i = 0; i < metadata.count; ++i) {
+		char name[ROD_METADATA_NAME_MAX + 1];
+		snprintf(name, sizeof(name), "timezone-%02zu", i);
+		assert(rod_metadata_entry_parse(&metadata.entries[i], name, "timestamp", "%Z",
+					       "0,0") == 0);
+	}
+	assert(!rod_metadata_config_fits(&metadata));
+}
+
+int main(void)
+{
+	test_entry_validation();
+	test_render_and_json_escape();
+	test_h264_h265_serialization();
+	test_config_size_bound();
+	puts("Named OSD metadata validation, rendering, JSON escaping and H264/H265 SEI passed");
+	return 0;
+}
diff --git a/tests/test_rod_metadata_config.c b/tests/test_rod_metadata_config.c
new file mode 100644
index 0000000000000000000000000000000000000000..a8489aaf88c9306b7a0a7b16059200087a336bef
--- /dev/null
+++ b/tests/test_rod_metadata_config.c
@@ -0,0 +1,170 @@
+#include "../rod/rod_metadata.h"
+
+#include <assert.h>
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+
+typedef struct {
+	const char *section;
+	const char *type;
+	const char *format;
+	const char *position;
+} fake_entry_t;
+
+struct rss_config {
+	const char *enabled;
+	const char *entry_count;
+	const fake_entry_t *entries;
+	size_t count;
+};
+
+static unsigned config_writes;
+static char last_key[32];
+
+bool rss_config_get_bool(rss_config_t *cfg, const char *section, const char *key,
+			 bool default_value)
+{
+	return strcmp(section, "osd_metadata") == 0 && strcmp(key, "enabled") == 0
+		       ? cfg->enabled && strcmp(cfg->enabled, "true") == 0
+		       : default_value;
+}
+
+const char *rss_config_get_str(rss_config_t *cfg, const char *section, const char *key,
+			       const char *default_value)
+{
+	if (strcmp(section, "osd_metadata") == 0 && strcmp(key, "enabled") == 0)
+		return cfg->enabled ? cfg->enabled : default_value;
+	if (strcmp(section, "osd_metadata") == 0 && strcmp(key, "entry_count") == 0)
+		return cfg->entry_count ? cfg->entry_count : default_value;
+	if (strcmp(section, "osd_metadata") == 0 && cfg->entry_count && cfg->count > 0) {
+		if (strcmp(key, "entry0_name") == 0) return "room";
+		if (strcmp(key, "entry0_type") == 0) return cfg->entries[0].type;
+		if (strcmp(key, "entry0_format") == 0) return cfg->entries[0].format;
+		if (strcmp(key, "entry0_position") == 0) return cfg->entries[0].position;
+	}
+	for (size_t i = 0; i < cfg->count; ++i) {
+		if (strcmp(section, cfg->entries[i].section) != 0)
+			continue;
+		if (strcmp(key, "type") == 0)
+			return cfg->entries[i].type;
+		if (strcmp(key, "format") == 0)
+			return cfg->entries[i].format;
+		if (strcmp(key, "position") == 0)
+			return cfg->entries[i].position;
+	}
+	return default_value;
+}
+
+void rss_config_set_bool(rss_config_t *cfg, const char *section, const char *key, bool value)
+{
+	(void)cfg; (void)section; (void)key; (void)value;
+	config_writes++;
+}
+
+void rss_config_set_str(rss_config_t *cfg, const char *section, const char *key,
+			const char *value)
+{
+	(void)cfg; (void)section; (void)key; (void)value;
+	config_writes++;
+	assert(strlen(key) < sizeof(last_key));
+	strcpy(last_key, key);
+}
+
+void rss_config_set_int(rss_config_t *cfg, const char *section, const char *key, int value)
+{
+	(void)cfg; (void)section; (void)key; (void)value;
+	config_writes++;
+}
+
+int rss_config_foreach_section(rss_config_t *cfg, const char *prefix,
+			       void (*callback)(const char *, void *), void *userdata)
+{
+	int count = 0;
+	for (size_t i = 0; i < cfg->count; ++i) {
+		if (strncmp(cfg->entries[i].section, prefix, strlen(prefix)) == 0) {
+			callback(cfg->entries[i].section, userdata);
+			count++;
+		}
+	}
+	return count;
+}
+
+static void test_valid_and_disabled_config(void)
+{
+	const fake_entry_t entries[] = {
+		{"osd_metadata.clock", "timestamp", "%F %T", "-10,-10"},
+		{"osd_metadata.room", "text", "Keitti\xc3\xb6", "10,10"},
+	};
+	struct rss_config cfg = {.enabled = "true", .entries = entries, .count = 2};
+	rod_metadata_config_t metadata;
+	assert(rod_metadata_config_load(&cfg, &metadata) == 0);
+	assert(metadata.enabled && metadata.valid && metadata.count == 2);
+	assert(strcmp(metadata.entries[1].name, "room") == 0);
+
+	cfg.enabled = "false";
+	assert(rod_metadata_config_load(&cfg, &metadata) == 0);
+	assert(!metadata.enabled && metadata.valid && metadata.count == 2);
+}
+
+static void test_invalid_config(void)
+{
+	const fake_entry_t entries[] = {
+		{"osd_metadata.clock", "timestamp", "%n", "-10,-10"},
+	};
+	struct rss_config cfg = {.enabled = "true", .entries = entries, .count = 1};
+	rod_metadata_config_t metadata;
+	assert(rod_metadata_config_load(&cfg, &metadata) < 0);
+	assert(metadata.enabled && !metadata.valid && metadata.count == 0);
+}
+
+static void test_serialized_and_missing_config(void)
+{
+	struct rss_config cfg = {
+		.enabled = "true",
+		.entry_count = "1",
+		.entries = (const fake_entry_t[]){{NULL, "text", "Keittiö", "1,2"}},
+		.count = 1,
+	};
+	rod_metadata_config_t metadata;
+	assert(rod_metadata_config_load(&cfg, &metadata) == 0);
+	assert(metadata.present && metadata.valid && metadata.id[0] && metadata.count == 1);
+	cfg.entry_count = "not-a-number";
+	assert(rod_metadata_config_load(&cfg, &metadata) == -EINVAL);
+	const char *invalid_counts[] = {"", "-1", "17", "9999999999999999999999"};
+	for (size_t i = 0; i < sizeof(invalid_counts) / sizeof(invalid_counts[0]); ++i) {
+		cfg.entry_count = invalid_counts[i];
+		assert(rod_metadata_config_load(&cfg, &metadata) == -EINVAL);
+		assert(!metadata.valid && metadata.count == 0);
+	}
+	cfg.enabled = NULL;
+	cfg.entry_count = NULL;
+	assert(rod_metadata_config_load(&cfg, &metadata) == -ENOENT);
+	assert(!metadata.present && !metadata.valid && !metadata.id[0]);
+}
+
+static void test_store_count_bound(void)
+{
+	struct rss_config cfg = {0};
+	rod_metadata_config_t metadata = {
+		.present = true, .valid = true, .count = ROD_METADATA_MAX_ENTRIES,
+	};
+	config_writes = 0;
+	assert(rod_metadata_config_store(&cfg, &metadata) == 0);
+	assert(config_writes == 2 + 4 * ROD_METADATA_MAX_ENTRIES);
+	assert(strcmp(last_key, "entry15_position") == 0);
+	metadata.count++;
+	config_writes = 0;
+	assert(rod_metadata_config_store(&cfg, &metadata) == -EINVAL);
+	assert(config_writes == 0);
+}
+
+int main(void)
+{
+	test_valid_and_disabled_config();
+	test_invalid_config();
+	test_serialized_and_missing_config();
+	test_store_count_bound();
+	puts("ROD named metadata valid, disabled and malformed config passed");
+	return 0;
+}
diff --git a/tests/test_rod_metadata_runtime.c b/tests/test_rod_metadata_runtime.c
new file mode 100644
index 0000000000000000000000000000000000000000..fdf5ec65552afd0e9fcaddc676a179c1b96bf4a5
--- /dev/null
+++ b/tests/test_rod_metadata_runtime.c
@@ -0,0 +1,150 @@
+#include "../rod/rod.h"
+
+#include <assert.h>
+#include <errno.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+
+size_t rss_strlcpy(char *dst, const char *src, size_t size)
+{
+	size_t length = strlen(src);
+	if (size > 0) {
+		size_t copied = length < size - 1 ? length : size - 1;
+		memcpy(dst, src, copied);
+		dst[copied] = '\0';
+	}
+	return length;
+}
+
+void rss_log(rss_log_level_t level, const char *file, int line, const char *format, ...)
+{
+	(void)level;
+	(void)file;
+	(void)line;
+	(void)format;
+}
+
+int rod_expand_template(rod_state_t *state, const char *format, char *out, int size)
+{
+	(void)state;
+	assert(strcmp(format, "%ip%") == 0);
+	return (int)rss_strlcpy(out, "192.0.2.10", (size_t)size);
+}
+
+int main(int argc, char **argv)
+{
+	assert(argc == 2);
+	rod_state_t state = {
+		.stream_count = 1,
+		.stream_w = {1920},
+		.stream_h = {1080},
+		.metadata = {.enabled = true, .valid = true, .count = 2},
+		.metadata_directory = argv[1],
+	};
+	strcpy(state.hostname, "camera-a");
+	assert(rod_metadata_entry_parse(&state.metadata.entries[0], "room", "text", "Keitti\xc3\xb6",
+					 "10,10") == 0);
+	assert(rod_metadata_entry_parse(&state.metadata.entries[1], "gain", "gain", "%s",
+					 "10,30") == 0);
+
+	rod_metadata_publish(&state, 1000000);
+	osd_metadata_snapshot_t snapshot;
+	assert(osd_metadata_snapshot_read(argv[1], 0, 1000001, OSD_METADATA_MAX_AGE_US,
+					  &snapshot) == 0);
+	assert(snapshot.generation == 1 && strstr(snapshot.json, "Keitti\xc3\xb6"));
+	assert(strstr(snapshot.json, "\"name\":\"gain\",\"t\":\"gain\",\"text\":\"--\""));
+
+	rod_metadata_publish(&state, 1500000);
+	assert(state.metadata_generation == 1);
+	rod_metadata_publish(&state, 2000000);
+	assert(state.metadata_generation == 2);
+
+	state.metadata.count = 0;
+	rod_metadata_publish(&state, 2000001);
+	assert(state.metadata_generation == 3);
+	assert(osd_metadata_snapshot_read(argv[1], 0, 2000002, OSD_METADATA_MAX_AGE_US,
+					  &snapshot) == -ENODATA);
+
+	state.metadata.count = 2;
+	rod_metadata_publish(&state, 2000002);
+	assert(state.metadata_generation == 4);
+	state.metadata.enabled = false;
+	rod_metadata_publish(&state, 2000003);
+	assert(state.metadata_generation == 5);
+	assert(osd_metadata_snapshot_read(argv[1], 0, 2000004, OSD_METADATA_MAX_AGE_US,
+					  &snapshot) == -ENODATA);
+	rod_metadata_publish(&state, 4000004);
+	assert(state.metadata_generation == 5);
+
+	rod_state_t idle = {
+		.stream_count = 1,
+		.stream_w = {1920},
+		.stream_h = {1080},
+		.metadata = {.present = true, .enabled = false, .valid = true},
+		.metadata_directory = argv[1],
+	};
+	rod_metadata_publish(&idle, 5000000);
+	assert(idle.metadata_generation == 1);
+	rod_metadata_publish(&idle, 7000000);
+	assert(idle.metadata_generation == 1);
+	idle.metadata = state.metadata;
+	idle.metadata.enabled = true;
+	idle.metadata.count = 2;
+	rod_metadata_publish(&idle, 7000001);
+	assert(idle.metadata_generation == 2);
+	idle.metadata.enabled = false;
+	rod_metadata_publish(&idle, 7000002);
+	assert(idle.metadata_generation == 3);
+	rod_metadata_publish(&idle, 9000002);
+	assert(idle.metadata_generation == 3);
+
+	rod_state_t gain_state = {
+		.stream_count = 1,
+		.stream_w = {1920},
+		.stream_h = {1080},
+		.metadata = {.enabled = true, .valid = true, .count = 1},
+		.metadata_directory = argv[1],
+		.metadata_gain = 15864,
+		.metadata_gain_observed_us = 1000000,
+	};
+	gain_state.metadata.entries[0] = state.metadata.entries[1];
+	rod_metadata_publish(&gain_state, 1000000);
+	assert(osd_metadata_snapshot_read(argv[1], 0, 1000001, OSD_METADATA_MAX_AGE_US,
+					  &snapshot) == 0);
+	assert(strstr(snapshot.json, "\"name\":\"gain\",\"t\":\"gain\",\"text\":\"15864\""));
+	assert(rod_metadata_gain_fresh(&gain_state, 4000000));
+	gain_state.metadata_last_publish_us = 0;
+	rod_metadata_publish(&gain_state, 4000000);
+	assert(osd_metadata_snapshot_read(argv[1], 0, 4000000, OSD_METADATA_MAX_AGE_US,
+					  &snapshot) == 0);
+	assert(strstr(snapshot.json, "\"text\":\"15864\""));
+	assert(!rod_metadata_gain_fresh(&gain_state, 4000001));
+	gain_state.metadata_last_publish_us = 0;
+	rod_metadata_publish(&gain_state, 4000001);
+	assert(osd_metadata_snapshot_read(argv[1], 0, 4000001, OSD_METADATA_MAX_AGE_US,
+					  &snapshot) == 0);
+	assert(strstr(snapshot.json, "\"text\":\"--\""));
+
+	/* A restarted daemon has no inherited volatile observation. */
+	rod_state_t restarted = gain_state;
+	restarted.metadata_gain = 0;
+	restarted.metadata_gain_observed_us = 0;
+	restarted.metadata_last_publish_us = 0;
+	rod_metadata_publish(&restarted, 5000000);
+	assert(osd_metadata_snapshot_read(argv[1], 0, 5000000, OSD_METADATA_MAX_AGE_US,
+					  &snapshot) == 0);
+	assert(strstr(snapshot.json, "\"text\":\"--\""));
+
+	rod_state_t no_streams = {
+		.metadata = {.present = true, .enabled = true, .valid = true, .count = 1},
+		.metadata_directory = argv[1],
+	};
+	strcpy(no_streams.metadata.id, "0123456789abcdef");
+	no_streams.metadata.entries[0] = state.metadata.entries[0];
+	rod_metadata_publish(&no_streams, 3000000);
+	assert(no_streams.metadata_publish_status == -ENODEV);
+	assert(no_streams.metadata_published_id[0] == '\0');
+	puts("ROD tick publishes generations, unavailable gain and disabled metadata");
+	return 0;
+}
diff --git a/tests/test_rod_metadata_settings.c b/tests/test_rod_metadata_settings.c
new file mode 100644
index 0000000000000000000000000000000000000000..00d1aca589889abe9b47d868c1c9c453e794188b
--- /dev/null
+++ b/tests/test_rod_metadata_settings.c
@@ -0,0 +1,299 @@
+#include "../rod/rod.h"
+
+#include <assert.h>
+#include <errno.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#define ROD_CTRL_RESPONSE_MAX 65535
+
+static int64_t test_now = 1000000;
+static bool fail_publish;
+static bool mismatch_after_write;
+static int publish_calls;
+
+int64_t rss_timestamp_us(void) { return test_now; }
+void rss_log(rss_log_level_t level, const char *file, int line, const char *format, ...)
+{
+	(void)level; (void)file; (void)line; (void)format;
+}
+size_t rss_strlcpy(char *dst, const char *src, size_t size)
+{
+	size_t length = strlen(src), copied = length < size - 1 ? length : size - 1;
+	if (size) { memcpy(dst, src, copied); dst[copied] = '\0'; }
+	return length;
+}
+char *rss_trim(char *text)
+{
+	while (*text == ' ' || *text == '\t') text++;
+	char *end = text + strlen(text);
+	while (end > text && (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\r' ||
+			      end[-1] == '\n')) *--end = '\0';
+	return text;
+}
+int rss_write_file_atomic(const char *path, const void *data, int length)
+{
+	FILE *file = fopen(path, "wb");
+	if (!file) return -1;
+	const char mismatch[] = "[osd_metadata]\nenabled=false\nentry_count=0\n";
+	if (mismatch_after_write) {
+		data = mismatch;
+		length = (int)strlen(mismatch);
+		mismatch_after_write = false;
+	}
+	int status = fwrite(data, 1, (size_t)length, file) == (size_t)length &&
+		     fclose(file) == 0 ? 0 : -1;
+	return status;
+}
+void rod_metadata_publish(rod_state_t *state, int64_t now_us)
+{
+	publish_calls++;
+	state->metadata_generation++;
+	state->metadata_last_publish_us = now_us;
+	state->metadata_publish_status = fail_publish ? -EIO : 0;
+	state->metadata_last_enabled = state->metadata.enabled && state->metadata.count > 0;
+	if (!fail_publish)
+		rss_strlcpy(state->metadata_published_id, state->metadata.id,
+			    sizeof(state->metadata_published_id));
+}
+
+static cJSON *response(const char *text)
+{
+	cJSON *root = cJSON_ParseWithOpts(text, NULL, true);
+	assert(root);
+	return root;
+}
+
+static void write_initial(const char *path)
+{
+	FILE *file = fopen(path, "wb");
+	assert(file);
+	fputs("[osd_metadata]\nenabled=false\nentries=[]\n", file);
+	assert(fclose(file) == 0);
+}
+
+static char *table_request(int count, bool duplicate, bool long_format)
+{
+	cJSON *root = cJSON_CreateObject();
+	cJSON_AddStringToObject(root, "cmd", "set-metadata-settings");
+	cJSON *values = cJSON_AddObjectToObject(root, "values");
+	cJSON_AddBoolToObject(values, "enabled", true);
+	cJSON *entries = cJSON_AddArrayToObject(values, "entries");
+	for (int i = 0; i < count; ++i) {
+		cJSON *entry = cJSON_CreateObject();
+		char name[64];
+		char format[ROD_METADATA_FORMAT_MAX + 1];
+		int name_length = snprintf(name, sizeof(name), "long-metadata-entry-number-%02d",
+					   duplicate && i == count - 1 ? 0 : i);
+		assert(name_length > 0 && name_length <= ROD_METADATA_NAME_MAX);
+		if (long_format) {
+			memset(format, 'a', sizeof(format));
+			format[ROD_METADATA_FORMAT_MAX - 2] = (char)0xc3;
+			format[ROD_METADATA_FORMAT_MAX - 1] = (char)0xa4;
+			format[ROD_METADATA_FORMAT_MAX] = '\0';
+		} else {
+			snprintf(format, sizeof(format), "entry-%02d", i);
+		}
+		cJSON_AddStringToObject(entry, "name", name);
+		cJSON_AddStringToObject(entry, "type", "text");
+		cJSON_AddStringToObject(entry, "format", format);
+		cJSON_AddStringToObject(entry, "position", "1,2");
+		cJSON_AddItemToArray(entries, entry);
+	}
+	char *request = cJSON_PrintUnformatted(root);
+	cJSON_Delete(root);
+	return request;
+}
+
+static void test_checked_set_get(const char *path)
+{
+	write_initial(path);
+	rod_state_t state = {.config_path = path, .stream_count = 1};
+	state.cfg = rss_config_load(path);
+	assert(state.cfg && rod_metadata_config_load(state.cfg, &state.metadata) == 0);
+	state.metadata_saved_known = true;
+	char reply[8192];
+	const char *request =
+		"{\"cmd\":\"set-metadata-settings\",\"values\":{\"enabled\":true,"
+		"\"entries\":[{\"name\":\"room\",\"type\":\"text\","
+		"\"format\":\"Keittiö\",\"position\":\"1,2\"},{\"name\":\"gain\","
+		"\"type\":\"gain\",\"format\":\"%s\",\"position\":\"1,3\"}]}}";
+	assert(rod_metadata_set_settings(&state, request, reply, sizeof(reply)) > 0);
+	cJSON *root = response(reply);
+	if (strcmp(cJSON_GetObjectItem(root, "status")->valuestring, "ok") != 0)
+		fprintf(stderr, "unexpected set response: %s\n", reply);
+	assert(strcmp(cJSON_GetObjectItem(root, "status")->valuestring, "ok") == 0);
+	assert(cJSON_IsTrue(cJSON_GetObjectItem(root, "confirmed")));
+	cJSON_Delete(root);
+
+	char *full = table_request(ROD_METADATA_MAX_ENTRIES, false, false);
+	int full_length = full ? rod_metadata_set_settings(&state, full, reply, sizeof(reply)) : -1;
+	assert(full_length > 0 && full_length < ROD_CTRL_RESPONSE_MAX);
+	root = response(reply);
+	assert(strcmp(cJSON_GetObjectItem(root, "status")->valuestring, "ok") == 0);
+	assert(state.metadata.count == ROD_METADATA_MAX_ENTRIES);
+	cJSON_Delete(root);
+	free(full);
+	int calls_before_invalid = publish_calls;
+	char *oversized = table_request(ROD_METADATA_MAX_ENTRIES, false, true);
+	assert(oversized && rod_metadata_set_settings(&state, oversized, reply, sizeof(reply)) > 0);
+	root = response(reply);
+	assert(strcmp(cJSON_GetObjectItem(root, "status")->valuestring, "error") == 0);
+	assert(strstr(reply, "snapshot limit"));
+	assert(publish_calls == calls_before_invalid);
+	assert(state.metadata.count == ROD_METADATA_MAX_ENTRIES);
+	cJSON_Delete(root);
+	free(oversized);
+	char *duplicate = table_request(2, true, false);
+	assert(duplicate && rod_metadata_set_settings(&state, duplicate, reply, sizeof(reply)) > 0);
+	root = response(reply);
+	assert(strcmp(cJSON_GetObjectItem(root, "status")->valuestring, "error") == 0);
+	assert(publish_calls == calls_before_invalid);
+	cJSON_Delete(root);
+	free(duplicate);
+
+	char lock_path[512];
+	assert(snprintf(lock_path, sizeof(lock_path), "%s.lock", path) > 0);
+	assert(unlink(lock_path) == 0);
+	assert(mkdir(lock_path, 0700) == 0);
+	char previous_id[17];
+	rss_strlcpy(previous_id, state.metadata.id, sizeof(previous_id));
+	assert(rod_metadata_set_settings(&state, request, reply, sizeof(reply)) > 0);
+	root = response(reply);
+	assert(strcmp(cJSON_GetObjectItem(root, "status")->valuestring, "error") == 0);
+	assert(strcmp(state.metadata.id, previous_id) == 0);
+	cJSON_Delete(root);
+	assert(rmdir(lock_path) == 0);
+	mismatch_after_write = true;
+	assert(rod_metadata_set_settings(&state, request, reply, sizeof(reply)) > 0);
+	root = response(reply);
+	assert(strcmp(cJSON_GetObjectItem(root, "status")->valuestring, "error") == 0);
+	cJSON_Delete(root);
+	assert(!state.metadata_saved_known);
+	assert(rod_metadata_get_settings(&state, reply, sizeof(reply)) > 0);
+	root = response(reply);
+	cJSON *saved = cJSON_GetObjectItem(root, "saved");
+	cJSON *published = cJSON_GetObjectItem(root, "published");
+	assert(cJSON_IsFalse(cJSON_GetObjectItem(saved, "available")));
+	assert(cJSON_IsFalse(cJSON_GetObjectItem(published, "matches_saved")));
+	cJSON_Delete(root);
+	assert(rod_metadata_set_settings(&state, request, reply, sizeof(reply)) > 0);
+
+	char saved_id[17];
+	rss_strlcpy(saved_id, state.metadata.id, sizeof(saved_id));
+	assert(rod_metadata_get_settings(&state, reply, sizeof(reply)) > 0);
+	root = response(reply);
+	cJSON *entries = cJSON_GetObjectItem(cJSON_GetObjectItem(root, "saved"), "entries");
+	assert(cJSON_GetArraySize(entries) == 2);
+	assert(cJSON_IsFalse(cJSON_GetObjectItem(cJSON_GetArrayItem(entries, 1), "available")));
+	cJSON_Delete(root);
+
+	assert(rod_metadata_gain_demand(&state, "{\"cmd\":\"get-gain-demand\"}", reply,
+					 sizeof(reply)) > 0);
+	root = response(reply);
+	assert(cJSON_IsTrue(cJSON_GetObjectItem(root, "needed")));
+	cJSON_Delete(root);
+	state.paused = true;
+	assert(rod_metadata_gain_demand(&state, "{\"cmd\":\"get-gain-demand\"}", reply,
+					 sizeof(reply)) > 0);
+	root = response(reply);
+	assert(cJSON_IsFalse(cJSON_GetObjectItem(root, "needed")));
+	cJSON_Delete(root);
+	state.paused = false;
+	char observation[160];
+	snprintf(observation, sizeof(observation),
+		 "{\"cmd\":\"observe-gain\",\"total_gain\":15864,\"observed_us\":%lld}",
+		 (long long)test_now);
+	assert(rod_metadata_observe_gain(&state, observation, reply, sizeof(reply)) > 0);
+	assert(state.metadata_gain == 15864 && state.metadata_gain_observed_us == test_now);
+	uint32_t accepted_gain = state.metadata_gain;
+	int64_t accepted_time = state.metadata_gain_observed_us;
+	for (int64_t duplicate_or_older = accepted_time; duplicate_or_older >= accepted_time - 1;
+	     --duplicate_or_older) {
+		snprintf(observation, sizeof(observation),
+			 "{\"cmd\":\"observe-gain\",\"total_gain\":1,\"observed_us\":%lld}",
+			 (long long)duplicate_or_older);
+		assert(rod_metadata_observe_gain(&state, observation, reply, sizeof(reply)) > 0);
+		root = response(reply);
+		assert(!strcmp(cJSON_GetObjectItem(root, "status")->valuestring, "error"));
+		cJSON_Delete(root);
+		assert(state.metadata_gain == accepted_gain &&
+		       state.metadata_gain_observed_us == accepted_time);
+	}
+	snprintf(observation, sizeof(observation),
+		 "{\"cmd\":\"observe-gain\",\"total_gain\":1,\"observed_us\":%lld}",
+		 (long long)(test_now + 1));
+	assert(rod_metadata_observe_gain(&state, observation, reply, sizeof(reply)) > 0);
+	root = response(reply);
+	assert(!strcmp(cJSON_GetObjectItem(root, "status")->valuestring, "error"));
+	cJSON_Delete(root);
+	assert(rod_metadata_observe_gain(
+		       &state, "{\"cmd\":\"observe-gain\",\"total_gain\":null,\"observed_us\":1}",
+		       reply, sizeof(reply)) > 0);
+	root = response(reply);
+	assert(!strcmp(cJSON_GetObjectItem(root, "status")->valuestring, "error"));
+	cJSON_Delete(root);
+	assert(state.metadata_gain == accepted_gain &&
+	       state.metadata_gain_observed_us == accepted_time);
+	assert(rod_metadata_get_settings(&state, reply, sizeof(reply)) > 0);
+	root = response(reply);
+	entries = cJSON_GetObjectItem(cJSON_GetObjectItem(root, "saved"), "entries");
+	assert(cJSON_IsTrue(cJSON_GetObjectItem(cJSON_GetArrayItem(entries, 1), "available")));
+	cJSON_Delete(root);
+
+	state.metadata_published_id[0] = 'x';
+	test_now += 1;
+	rod_metadata_get_settings(&state, reply, sizeof(reply));
+	root = response(reply);
+	assert(cJSON_IsFalse(cJSON_GetObjectItem(root, "confirmed")));
+	cJSON_Delete(root);
+	rss_strlcpy(state.metadata_published_id, saved_id, sizeof(state.metadata_published_id));
+	test_now += OSD_METADATA_MAX_AGE_US + 1;
+	rod_metadata_get_settings(&state, reply, sizeof(reply));
+	root = response(reply);
+	assert(cJSON_IsFalse(cJSON_GetObjectItem(root, "confirmed")));
+	entries = cJSON_GetObjectItem(cJSON_GetObjectItem(root, "saved"), "entries");
+	assert(cJSON_IsFalse(cJSON_GetObjectItem(cJSON_GetArrayItem(entries, 1), "available")));
+	assert(!strcmp(cJSON_GetObjectItem(cJSON_GetArrayItem(entries, 1), "unavailable_reason")
+			       ->valuestring,
+		       "gain observation stale"));
+	cJSON_Delete(root);
+
+	fail_publish = true;
+	assert(rod_metadata_set_settings(&state, request, reply, sizeof(reply)) > 0);
+	root = response(reply);
+	assert(strcmp(cJSON_GetObjectItem(root, "status")->valuestring, "error") == 0);
+	cJSON_Delete(root);
+	fail_publish = false;
+	test_now++;
+	assert(rod_metadata_set_settings(&state, request, reply, sizeof(reply)) > 0);
+	root = response(reply);
+	assert(strcmp(cJSON_GetObjectItem(root, "status")->valuestring, "ok") == 0);
+	cJSON_Delete(root);
+	assert(publish_calls == 5);
+	const char *disable =
+		"{\"cmd\":\"set-metadata-settings\",\"values\":{\"enabled\":false,"
+		"\"entries\":[{\"name\":\"room\",\"type\":\"text\","
+		"\"format\":\"Keittiö\",\"position\":\"1,2\"}]}}";
+	assert(rod_metadata_set_settings(&state, disable, reply, sizeof(reply)) > 0);
+	test_now += OSD_METADATA_MAX_AGE_US + 1;
+	assert(rod_metadata_get_settings(&state, reply, sizeof(reply)) > 0);
+	root = response(reply);
+	assert(cJSON_IsTrue(cJSON_GetObjectItem(root, "confirmed")));
+	published = cJSON_GetObjectItem(root, "published");
+	assert(cJSON_IsTrue(cJSON_GetObjectItem(published, "fresh")));
+	cJSON_Delete(root);
+	rss_config_free(state.cfg);
+}
+
+int main(int argc, char **argv)
+{
+	assert(argc == 2);
+	test_checked_set_get(argv[1]);
+	puts("ROD metadata checked save, readback, stale mismatch and retry passed");
+	return 0;
+}
diff --git a/tests/test_rod_settings.c b/tests/test_rod_settings.c
new file mode 100644
index 0000000000000000000000000000000000000000..281f30a35533f4774005bd7605f3eb00508b070e
--- /dev/null
+++ b/tests/test_rod_settings.c
@@ -0,0 +1,432 @@
+#include "rod.h"
+#include "rvd.h"
+#include "../osd_snapshot.h"
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+struct rss_osd_shm {
+    uint8_t *pixels[2];
+    uint32_t width, height;
+    int active;
+};
+static rvd_state_t video;
+static int published, sdk_calls, fail_sdk, fail_reply;
+static int created;
+
+rss_osd_shm_t *rss_osd_create(const char *name, uint32_t width, uint32_t height)
+{
+    assert(strncmp(name, "osd_", 4) == 0);
+    rss_osd_shm_t *shm = calloc(1, sizeof(*shm));
+    assert(shm);
+    shm->width = width;
+    shm->height = height;
+    shm->pixels[0] = calloc((size_t)width * height, 4);
+    shm->pixels[1] = calloc((size_t)width * height, 4);
+    assert(shm->pixels[0] && shm->pixels[1]);
+    created++;
+    return shm;
+}
+
+const uint8_t *rss_osd_get_active_buffer(rss_osd_shm_t *shm, uint32_t *width, uint32_t *height)
+{
+    *width = shm->width;
+    *height = shm->height;
+    return shm->pixels[shm->active];
+}
+uint8_t *rss_osd_get_draw_buffer(rss_osd_shm_t *shm)
+{
+    return shm->pixels[1 - shm->active];
+}
+void rss_osd_publish(rss_osd_shm_t *shm)
+{
+    shm->active = 1 - shm->active;
+    published++;
+}
+int rss_ctrl_send_command(const char *path, const char *request, char *response, int size, uint32_t timeout)
+{
+    assert(strcmp(path, RSS_RUN_DIR "/rvd.sock") == 0 && timeout == 1000);
+    int length = rvd_osd_apply_snapshot(&video, request, response, size);
+    if (fail_reply && strstr(request, "osd-apply-snapshot")) {
+        assert(size > 40);
+        memcpy(response, "{\"status\":\"ok\"}\0suffix", 22);
+        return 22;
+    }
+    return length;
+}
+static int sdk_update(void *ctx, int handle, const uint8_t *pixels)
+{
+    (void)ctx;
+    (void)handle;
+    assert(pixels);
+    sdk_calls++;
+    return fail_sdk ? RSS_ERR : RSS_OK;
+}
+static int sdk_show(void *ctx, int handle, int group, int visible, int layer)
+{
+    (void)ctx;
+    (void)handle;
+    (void)group;
+    (void)layer;
+    assert(visible == 1);
+    return RSS_OK;
+}
+static void apply(rod_state_t *rod, const char *values, bool success)
+{
+    char request[1024], response[1024];
+    snprintf(request, sizeof(request), "{\"cmd\":\"set-osd-settings\",\"id\":\"abc123\",\"values\":%s}", values);
+    assert(rod_set_settings(rod, request, response, sizeof(response)) > 0);
+    cJSON *root = cJSON_Parse(response);
+    cJSON *status = cJSON_GetObjectItemCaseSensitive(root, "status");
+    assert(cJSON_IsString(status));
+    assert((strcmp(status->valuestring, "ok") == 0) == success);
+    cJSON_Delete(root);
+}
+
+static void test_outline_coverage_union(void)
+{
+    rod_state_t *synthetic = calloc(1, sizeof(*synthetic));
+    assert(synthetic);
+    rod_font_t *font = &synthetic->fonts[0][0];
+    int glyph_index = 'X' - 0x20;
+    uint8_t coverage[3 * 3];
+    uint8_t canvas[16 * 16 * 4];
+
+    memset(coverage, 255, sizeof(coverage));
+    font->glyph_count = glyph_index + 1;
+    font->ascender = 4;
+    font->glyphs[glyph_index] = (rod_glyph_t){
+        .codepoint = 'X',
+        .width = 3,
+        .height = 3,
+        .advance = 3,
+        .alpha = coverage,
+    };
+    synthetic->settings.background_color = 0x00000000;
+
+    for (int stroke = 1; stroke <= 3; stroke += 2) {
+        rod_draw_text_overlay(synthetic, 0, 0, canvas, 16, 16, "X", 0,
+                              0x00FFFFFF, 0x8000FF00, stroke);
+        bool outline_seen = false;
+        for (size_t offset = 0; offset < sizeof(canvas); offset += 4) {
+            uint8_t alpha = canvas[offset + 3];
+            assert(alpha <= 128);
+            outline_seen |= alpha == 128;
+        }
+        assert(outline_seen);
+    }
+    free(synthetic);
+}
+
+int main(int argc, char **argv)
+{
+    assert(argc == 3 && strlen(argv[1]) < sizeof(((rod_state_t *)0)->settings.font_path));
+    FILE *file = fopen(argv[2], "w");
+    assert(file);
+    fputs("[osd]\ntime_format=%H:%M\nfont_color=0xFFFFFFFF\nstroke_color=0xFF000000\nbackground_color=0x00000000\n", file);
+    fclose(file);
+    rod_state_t *rod = calloc(1, sizeof(*rod));
+    assert(rod);
+    rod->cfg = rss_config_load(argv[2]);
+    assert(rod->cfg);
+    rod->settings.font_size = 24;
+    rod->settings.font_stroke = 1;
+    rod->settings.font_color = 0xFFFFFFFF;
+    rod->settings.stroke_color = 0xFF000000;
+    rod->settings.background_color = 0x00000000;
+    rod->settings.frame_rate = 25;
+    strcpy(rod->settings.font_path, argv[1]);
+    strcpy(rod->settings.time_format, "%H:%M");
+    rod->stream_count = 2;
+    test_outline_coverage_union();
+    rod->stream_h[0] = 1080;
+    rod->stream_h[1] = 360;
+    rod->elem_count = 1;
+    rod_element_t *element = &rod->elements[0];
+    element->active = element->visible = true;
+    element->type = ROD_ELEM_TEXT;
+    element->stroke_size = -1;
+    strcpy(element->name, "timestamp");
+    strcpy(element->tmpl, "%time%");
+    rss_hal_ops_t ops = {.osd_update_region_data = sdk_update, .osd_show_region = sdk_show};
+    video = (rvd_state_t){.ops = &ops, .osd_enabled = true, .pipeline_ready = true, .stream_count = 2};
+    assert(pthread_mutex_init(&video.osd_lock, NULL) == 0);
+    struct rss_osd_shm shm[2];
+    for (int s = 0; s < 2; ++s) {
+        assert(rod_alloc_font(rod, s, s ? 12 : 24) == 0);
+        shm[s] = (struct rss_osd_shm){.width = 256, .height = 64};
+        shm[s].pixels[0] = calloc(256 * 64, 4);
+        shm[s].pixels[1] = calloc(256 * 64, 4);
+        assert(shm[s].pixels[0] && shm[s].pixels[1]);
+        element->streams[s] = (rod_elem_stream_t){.shm = &shm[s], .width = 256, .height = 64, .font_idx = 0};
+        snprintf(video.streams[s].cfg_sect, sizeof(video.streams[s].cfg_sect), "stream%d", s);
+        video.osd_region_count[s] = 1;
+        video.osd_regions[s][0] = (rvd_osd_region_t){.shm = &shm[s], .hal_handle = s,
+            .width = 256, .height = 64, .local_buf = calloc(256 * 64, 4), .active = true};
+        assert(video.osd_regions[s][0].local_buf);
+        strcpy(video.osd_regions[s][0].name, "timestamp");
+    }
+    /* Production startup reserves a bounded canvas for a 22-character clock.
+     * Measuring with the actual font catches accidental SHM/pool growth. */
+    size_t canvas_bytes = 0;
+    rss_osd_shm_t *production_canvas[2];
+    rod_element_t reserved = *element;
+    reserved.max_chars = 22;
+    for (int s = 0; s < 2; ++s) {
+        create_elem_shm(rod, &reserved, s);
+        rss_osd_shm_t *canvas = reserved.streams[s].shm;
+        assert(canvas && canvas != &shm[s]);
+        canvas_bytes += (size_t)canvas->width * canvas->height * 4;
+        assert(rod->font_contexts == 2);
+        production_canvas[s] = canvas;
+    }
+    assert(created == 2 && canvas_bytes <= 512 * 1024);
+    printf("Reserved timestamp bitmap bytes across both streams: %zu\n", canvas_bytes);
+    /* Every admitted geometry must fit the reserved timestamp canvases without
+     * increasing the installed profile's bitmap allocation. Keep the RGBA
+     * rendering tests below on the original main/substream geometry. */
+    static const int geometries[][4] = {
+        {1920, 1080, 640, 360}, {1920, 1080, 480, 270},
+        {1920, 1080, 320, 180}, {1280, 720, 320, 180},
+    };
+    for (size_t g = 0; g < sizeof(geometries) / sizeof(geometries[0]); ++g) {
+        rod->stream_h[0] = geometries[g][1];
+        rod->stream_h[1] = geometries[g][3];
+        size_t admitted_bytes = 0;
+        for (int s = 0; s < 2; ++s) {
+            rod_element_t candidate = *element;
+            candidate.max_chars = 22;
+            create_elem_shm(rod, &candidate, s);
+            rss_osd_shm_t *canvas = candidate.streams[s].shm;
+            assert(canvas);
+            assert(canvas->width <= (uint32_t)geometries[g][s ? 2 : 0]);
+            assert(canvas->height <= (uint32_t)geometries[g][s ? 3 : 1]);
+            admitted_bytes += (size_t)canvas->width * canvas->height * 4;
+            free(canvas->pixels[0]);
+            free(canvas->pixels[1]);
+            free(canvas);
+            created--;
+        }
+        assert(admitted_bytes <= canvas_bytes);
+    }
+    rod->stream_h[0] = 1080;
+    rod->stream_h[1] = 360;
+    apply(rod, "{\"font_color\":\"0xGGFFFFFF\"}", false);
+    apply(rod, "{\"time_format\":\"%n\"}", false);
+    apply(rod, "{\"time_format\":\"%H:%M\",\"font_size\":49}", false);
+    apply(rod, "{\"font_size\":15}", false);
+    apply(rod, "{\"font_size\":24.5}", false);
+    apply(rod, "{\"font_size\":\"24\"}", false);
+    apply(rod, "{\"time_format\":\"%Y %Y %Y %Y %Y %Y %Y %Y %Y %Y\"}", false);
+    assert(published == 0 && sdk_calls == 0);
+    assert(strcmp(rod->settings.time_format, "%H:%M") == 0);
+    fail_sdk = 1;
+    apply(rod, "{\"font_color\":\"0xFFFF0000\"}", false);
+    assert(!rod->settings_apply_id[0]);
+    assert(strcmp(rss_config_get_str(rod->cfg, "osd", "font_color", ""), "0xFFFFFFFF") == 0);
+    fail_sdk = 0;
+    fail_reply = 1;
+    apply(rod, "{\"font_color\":\"0xFFFF0000\"}", false);
+    assert(!rod->settings_apply_id[0]);
+    fail_reply = 0;
+    apply(rod, "{\"font_color\":\"0xFFFF0000\",\"time_format\":\"%H:%M:%S\"}", true);
+    assert(strcmp(rod->settings_apply_id, "abc123") == 0 && strcmp(video.osd_apply_id, "abc123") == 0);
+    assert(strcmp(rss_config_get_str(rod->cfg, "osd", "font_color", ""), "0xFFFF0000") == 0);
+    for (int s = 0; s < 2; ++s) {
+        bool red = false;
+        uint8_t *pixels = video.osd_regions[s][0].local_buf;
+        assert(memcmp(pixels, shm[s].pixels[shm[s].active], 256 * 64 * 4) == 0);
+        for (size_t n = 0; n < 256 * 64 * 4; n += 4) {
+            if (pixels[n + 2] > pixels[n] && pixels[n + 2] > pixels[n + 1]) red = true;
+        }
+        assert(red);
+    }
+    rss_config_set_str(rod->cfg, "osd", "font_color", "0xFFFFFFFF");
+    apply(rod, "{\"font_color\":\"0xFFFF0000\"}", true);
+    /* More transitions than the font pool has slots. Replacements must
+     * release old glyph caches without freeing another stream's font file. */
+    for (int pass = 0; pass < 4; ++pass) {
+        for (int font_size = 16; font_size <= 48; ++font_size) {
+            char values[128];
+            snprintf(values, sizeof(values), "{\"time_format\":\"%%H:%%M\",\"font_size\":%d}", font_size);
+            apply(rod, values, true);
+            assert(rod->settings.font_size == font_size);
+            assert(rod->font_contexts == 2);
+            for (int s = 0; s < 2; ++s) {
+                int scaled = s ? font_size / 3 : font_size;
+                if (scaled < 12) scaled = 12;
+                int index = element->streams[s].font_idx;
+                assert(rod->fonts[s][index].size == scaled);
+                assert(rod->fonts[s][index].refcount == 1);
+                assert(element->streams[s].shm == &shm[s]);
+                assert(element->streams[s].width == 256 && element->streams[s].height == 64);
+            }
+        }
+    }
+    int before_publish = published, before_sdk = sdk_calls;
+    int old_indices[2] = {element->streams[0].font_idx, element->streams[1].font_idx};
+    apply(rod, "{\"font_size\":40,\"time_format\":\"%Y %Y %Y %Y %Y %Y %Y %Y %Y %Y\"}", false);
+    assert(published == before_publish && sdk_calls == before_sdk);
+    assert(rod->settings.font_size == 48 && rod->font_contexts == 2);
+    for (int s = 0; s < 2; ++s) assert(element->streams[s].font_idx == old_indices[s]);
+    fail_sdk = 1;
+    apply(rod, "{\"font_size\":40}", false);
+    assert(!rod->settings_apply_id[0] && rod->settings.font_size == 40);
+    assert(strcmp(rss_config_get_str(rod->cfg, "osd", "font_size", ""), "48") == 0);
+    fail_sdk = 0;
+    apply(rod, "{\"font_size\":40}", true);
+
+    /* Named text honors all three BGRA alpha bytes. A fully transparent
+     * configuration must publish an actually empty canvas, including RGB. */
+    apply(rod, "{\"font_color\":\"0x00FFFFFF\",\"stroke_color\":\"0x00000000\","
+           "\"background_color\":\"0x00ABCDEF\"}", true);
+    for (int s = 0; s < 2; ++s) {
+        size_t bytes = (size_t)shm[s].width * shm[s].height * 4;
+        for (size_t n = 0; n < bytes; ++n)
+            assert(video.osd_regions[s][0].local_buf[n] == 0);
+    }
+
+    /* Background is blue at alpha 128. Green outline and red fill blend over
+     * it in that order, so each layer leaves distinct pixels above alpha 128. */
+    apply(rod, "{\"font_color\":\"0x80FF0000\",\"stroke_color\":\"0x8000FF00\","
+           "\"background_color\":\"0x800000FF\"}", true);
+    for (int s = 0; s < 2; ++s) {
+        bool background_seen = false, outline_seen = false, fill_seen = false;
+        uint8_t *pixels = video.osd_regions[s][0].local_buf;
+        for (size_t n = 0; n < (size_t)shm[s].width * shm[s].height * 4; n += 4) {
+            background_seen |= pixels[n] == 255 && pixels[n + 1] == 0 &&
+                pixels[n + 2] == 0 && pixels[n + 3] == 128;
+            outline_seen |= pixels[n + 1] > pixels[n] && pixels[n + 1] > pixels[n + 2] &&
+                pixels[n + 3] > 128;
+            fill_seen |= pixels[n + 2] > pixels[n] && pixels[n + 2] > pixels[n + 1] &&
+                pixels[n + 3] > 128;
+        }
+        assert(background_seen && outline_seen && fill_seen);
+    }
+
+    /* An identical update produces byte-identical pixels. */
+    size_t main_bytes = (size_t)shm[0].width * shm[0].height * 4;
+    uint8_t *first_pixels = malloc(main_bytes);
+    assert(first_pixels);
+    memcpy(first_pixels, video.osd_regions[0][0].local_buf, main_bytes);
+    apply(rod, "{\"font_color\":\"0x80FF0000\",\"stroke_color\":\"0x8000FF00\","
+           "\"background_color\":\"0x800000FF\"}", true);
+    assert(memcmp(first_pixels, video.osd_regions[0][0].local_buf, main_bytes) == 0);
+    free(first_pixels);
+
+    apply(rod, "{\"font_color\":\"0xFFFF0000\",\"stroke_color\":\"0xFF000000\","
+           "\"background_color\":\"0x00000000\"}", true);
+    assert(rss_config_save(rod->cfg, argv[2]) == RSS_OK);
+    rss_config_t *disk = rss_config_load(argv[2]);
+    assert(disk && strcmp(rss_config_get_str(disk, "osd", "font_color", ""), "0xFFFF0000") == 0);
+    assert(strcmp(rss_config_get_str(disk, "osd", "font_size", ""), "40") == 0);
+    assert(strcmp(rss_config_get_str(disk, "osd", "background_color", ""), "0x00000000") == 0);
+    rss_config_free(disk);
+
+    /* A second fixture uses the actual startup canvases instead of the small
+     * failure-injection canvas. Full timestamps must fit at every exposed
+     * size, including a four-character summer timezone on the substream. */
+    assert(setenv("TZ", "EEST-3", 1) == 0);
+    tzset();
+    for (int s = 0; s < 2; ++s) {
+        free(shm[s].pixels[0]);
+        free(shm[s].pixels[1]);
+        free(video.osd_regions[s][0].local_buf);
+        shm[s] = *production_canvas[s];
+        free(production_canvas[s]);
+        element->streams[s].width = shm[s].width;
+        element->streams[s].height = shm[s].height;
+        video.osd_regions[s][0].width = shm[s].width;
+        video.osd_regions[s][0].height = shm[s].height;
+        video.osd_regions[s][0].local_buf = calloc((size_t)shm[s].width * shm[s].height, 4);
+        assert(video.osd_regions[s][0].local_buf);
+    }
+    for (int font_size = 16; font_size <= 48; ++font_size) {
+        char values[160];
+        snprintf(values, sizeof(values),
+                 "{\"time_format\":\"%%Y-%%m-%%d %%H:%%M:%%S %%Z\",\"font_size\":%d}", font_size);
+        apply(rod, values, true);
+        assert(rod->font_contexts == 2 && created == 2);
+        for (int s = 0; s < 2; ++s) {
+            size_t bytes = (size_t)shm[s].width * shm[s].height * 4;
+            assert(memcmp(video.osd_regions[s][0].local_buf, shm[s].pixels[shm[s].active], bytes) == 0);
+        }
+    }
+    apply(rod, "{\"font_color\":\"0x80FF0000\",\"stroke_color\":\"0x0000FF00\","
+           "\"background_color\":\"0xFF0000FF\"}", true);
+    puts("Full date/time and timezone fit both production canvases at sizes 16 through 48");
+    apply(rod, "{\"text_enabled\":\"false\"}", false);
+    fail_sdk = 1;
+    apply(rod, "{\"text_enabled\":false}", false);
+    assert(!rod->settings_apply_id[0]);
+    assert(rss_config_get_bool(rod->cfg, "osd", "text_enabled", true));
+    fail_sdk = 0;
+    apply(rod, "{\"text_enabled\":false}", true);
+    assert(rod->settings.text_hidden && !rod->paused);
+    for (int s = 0; s < 2; ++s) {
+        size_t bytes = (size_t)shm[s].width * shm[s].height * 4;
+        for (size_t n = 0; n < bytes; ++n)
+            assert(video.osd_regions[s][0].local_buf[n] == 0);
+        uint8_t *scratch = malloc(bytes);
+        assert(scratch);
+        memset(scratch, 0xA5, bytes);
+        rod_draw_text_overlay(rod, s, element->streams[s].font_idx, scratch,
+                              shm[s].width, shm[s].height, "next tick", 0,
+                              0xFFFFFFFF, 0xFF000000, 1);
+        for (size_t n = 0; n < bytes; ++n) assert(scratch[n] == 0);
+        /* The ordinary drawing primitive used by receipts remains the legacy
+         * compositor and deliberately ignores the high color byte. */
+        rod_draw_text(rod, s, element->streams[s].font_idx, scratch,
+                      shm[s].width, shm[s].height, "receipt", 0,
+                      0x00FFFFFF, 0x00000000, 1);
+        bool visible = false;
+        for (size_t n = 3; n < bytes; n += 4) visible |= scratch[n] != 0;
+        assert(visible);
+        free(scratch);
+    }
+    char hidden_reply[1024];
+    assert(rod_get_settings(rod, hidden_reply, sizeof(hidden_reply)) > 0);
+    cJSON *hidden = cJSON_Parse(hidden_reply);
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(hidden, "available")));
+    assert(cJSON_IsFalse(cJSON_GetObjectItemCaseSensitive(hidden, "enabled")));
+    assert(cJSON_GetObjectItemCaseSensitive(hidden, "fields")->valueint & 16);
+    cJSON_Delete(hidden);
+    assert(rss_config_save(rod->cfg, argv[2]) == RSS_OK);
+    disk = rss_config_load(argv[2]);
+    assert(disk && !rss_config_get_bool(disk, "osd", "text_enabled", true));
+    rod_state_t *restarted = calloc(1, sizeof(*restarted));
+    assert(restarted);
+    restarted->cfg = disk;
+    load_config(restarted);
+    assert(restarted->settings.enabled && restarted->settings.text_hidden);
+    assert(restarted->settings.font_color == 0x80FF0000);
+    assert(restarted->settings.stroke_color == 0x0000FF00);
+    assert(restarted->settings.background_color == 0xFF0000FF);
+    free(restarted);
+    rss_config_free(disk);
+    apply(rod, "{\"text_enabled\":true}", true);
+    assert(!rod->settings.text_hidden && created == 2);
+    for (int s = 0; s < 2; ++s) {
+        size_t bytes = (size_t)shm[s].width * shm[s].height * 4;
+        bool visible = false;
+        for (size_t n = 3; n < bytes; n += 4)
+            visible |= video.osd_regions[s][0].local_buf[n] != 0;
+        assert(visible);
+    }
+    puts("Text visibility clears both bitmaps, remains hidden on later ticks, and restores without region recreation");
+    rss_config_free(rod->cfg);
+    for (int s = 1; s >= 0; --s) {
+        release_font(rod, s, element->streams[s].font_idx);
+        free(shm[s].pixels[0]);
+        free(shm[s].pixels[1]);
+        free(video.osd_regions[s][0].local_buf);
+    }
+    pthread_mutex_destroy(&video.osd_lock);
+    assert(rod->font_contexts == 0 && rod->font_file == NULL);
+    assert(created == 2); /* No allocation of new regions during live changes. */
+    free(rod);
+    puts("Real glyph rendering, checked ROD/RVD snapshot, malformed reply and persistence retry passed");
+    return 0;
+}
diff --git a/tests/test_rsd_access.c b/tests/test_rsd_access.c
