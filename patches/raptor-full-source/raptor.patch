+    assert(rss_config_get_int(disk, "ircut", "night_luma", -1) == 22);
+    assert(rss_config_get_int(disk, "ircut", "day_threshold", -1) == 100);
+    assert(rss_config_get_int(disk, "ircut", "adc_night", -1) == 200);
+    assert(rss_config_get_int(disk, "ircut", "adc_day", -1) == 600);
+    assert(rss_config_get_int(disk, "ircut", "photo_ev_deep", -1) == 30);
+    rss_config_free(disk);
+    st->settings.trigger = RIC_TRIGGER_LUMA;
+    threshold_request(st, luma, false);
+}
+
+
+static void save_sequence(ric_state_t *st, const char *mode, const char *path,
+                          bool save_success)
+{
+    threshold_request(st, "{\"cmd\":\"set-daynight-thresholds\",\"trigger\":\"luma\",\"values\":{\"night_luma\":23,\"night_gain\":90000,\"day_gain_pct\":30}}", true);
+    set_policy(st, mode, true);
+    char response[4096];
+    assert(ric_get_settings(st, response, sizeof(response)) > 0);
+    cJSON *root = cJSON_Parse(response);
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(root, "available")));
+    cJSON_Delete(root);
+    assert(ric_isp_mode_is(st->current_mode));
+    assert((rss_config_save(st->cfg, path) == 0) == save_success);
+    if (save_success) {
+        rss_config_t *disk = rss_config_load(path);
+        assert(disk);
+        assert(strcmp(rss_config_get_str(disk, "ircut", "mode", ""), mode) == 0);
+        assert(rss_config_get_int(disk, "ircut", "night_luma", -1) == 23);
+        rss_config_free(disk);
+    }
+}
+
+static void test_idempotent_save_and_recovery(ric_state_t *st, const char *path)
+{
+    st->settings.trigger = RIC_TRIGGER_LUMA;
+    rss_config_set_str(st->cfg, "ircut", "trigger", "luma");
+    char failed_path[1024];
+    snprintf(failed_path, sizeof(failed_path), "%s/not-a-directory", path);
+    const char *modes[] = {"day", "night", "auto"};
+    for (size_t i = 0; i < sizeof(modes) / sizeof(modes[0]); ++i) {
+        int before_change = pulses;
+        set_policy(st, modes[i], true);
+        assert(pulses == before_change + 1);
+        int before_writes = writes;
+        int before_pulses = pulses;
+        int before_sets = isp_sets;
+        int before_gets = isp_gets;
+        save_sequence(st, modes[i], failed_path, false);
+        assert(writes == before_writes);
+        assert(pulses == before_pulses);
+        assert(isp_sets == before_sets);
+        assert(isp_gets > before_gets);
+        save_sequence(st, modes[i], path, true);
+        assert(writes == before_writes);
+        assert(pulses == before_pulses);
+        assert(isp_sets == before_sets);
+        rss_config_set_str(st->cfg, "ircut", "mode", "stale-cache");
+        save_sequence(st, modes[i], path, true);
+        assert(writes == before_writes);
+        assert(pulses == before_pulses);
+        assert(isp_sets == before_sets);
+    }
+
+    /* A partial state must release both coils before the failing ISP setter. */
+    st->mode_confirmed = false;
+    pins[2] = 1;
+    int before_writes = writes;
+    int before_pulses = pulses;
+    int before_release1 = zero_attempts[1];
+    int before_release2 = zero_attempts[2];
+    fail_isp = true;
+    set_policy(st, "auto", false);
+    assert(writes == before_writes + 2);
+    assert(zero_attempts[1] == before_release1 + 1);
+    assert(zero_attempts[2] == before_release2 + 1);
+    assert(isp_write_at == writes);
+    assert(pulses == before_pulses);
+    assert(!st->mode_confirmed);
+    fail_isp = false;
+    save_sequence(st, "auto", path, true);
+    assert(writes == before_writes + 8);
+    assert(pulses == before_pulses + 1);
+    assert(st->mode_confirmed);
+
+    /* A cached confirmation alone cannot bypass fresh output validation. */
+    pins[3] = 0;
+    before_pulses = pulses;
+    save_sequence(st, "auto", path, true);
+    assert(pulses == before_pulses + 1);
+    assert(st->mode_confirmed && pins[3] == 1);
+
+    st->settings.trigger = RIC_TRIGGER_PHOTO;
+    st->photo.phase = PHOTO_PHASE_INTERFERE;
+    before_writes = writes;
+    before_pulses = pulses;
+    set_policy(st, "auto", true);
+    assert(writes == before_writes);
+    assert(pulses == before_pulses);
+    assert(st->photo.phase == PHOTO_PHASE_INTERFERE);
+}
+
+static void test_remaining_automation_policies(ric_state_t *st, const char *path)
+{
+    st->settings.opmode = RIC_AUTO;
+    st->settings.trigger = RIC_TRIGGER_GAIN;
+    st->settings.automation_paused = false;
+    st->settings.auto_color = true;
+    st->settings.auto_ircut = true;
+    st->settings.day_confirm_count = 1;
+    st->settings.night_confirm_count = 1;
+    st->settings.loglevel = RSS_LOG_INFO;
+    rss_log_set_level(RSS_LOG_INFO);
+    rss_config_set_str(st->cfg, "ircut", "trigger", "gain");
+    st->current_mode = RIC_MODE_DAY;
+    st->current_mode_automatic = true;
+    st->mode_confirmed = true;
+    st->filter_state_known = true;
+    st->filter_day = true;
+    pins[1] = pins[2] = pins[3] = 0;
+
+    settings_request(st,
+        "{\"cmd\":\"set-daynight-settings\",\"mode\":\"auto\","
+        "\"automatic_outputs\":{\"color\":false,\"ircut\":false},"
+        "\"confirmation\":{\"day\":3,\"night\":4},\"loglevel\":\"debug\"}", true);
+    assert(!st->settings.auto_color && !st->settings.auto_ircut);
+    assert(st->settings.day_confirm_count == 3 && st->settings.night_confirm_count == 4);
+    assert(st->settings.loglevel == RSS_LOG_DEBUG && rss_log_get_level() == RSS_LOG_DEBUG);
+    assert(rss_config_get_bool(st->cfg, "ircut", "auto_color", true) == false);
+    assert(rss_config_get_bool(st->cfg, "ircut", "auto_ircut", true) == false);
+
+    st->settings.schedule_enabled = true;
+    st->settings.schedule_start_minute = 0;
+    st->settings.schedule_stop_minute = 24 * 60 - 1;
+    st->filter_day = false;
+    isp_mode = RIC_MODE_NIGHT;
+    int ownership_writes = writes;
+    settings_request(st,
+        "{\"cmd\":\"set-daynight-settings\",\"mode\":\"auto\","
+        "\"automatic_outputs\":{\"color\":true,\"ircut\":true}}", true);
+    assert(st->mode_confirmed && st->filter_day && isp_mode == RIC_MODE_DAY &&
+           writes > ownership_writes);
+
+    /* Rejoining only the filter must compare its latched state with the
+     * automatic target even when the ISP already matches that target. */
+    settings_request(st,
+        "{\"cmd\":\"set-daynight-settings\",\"mode\":\"auto\","
+        "\"automatic_outputs\":{\"color\":true,\"ircut\":false}}", true);
+    st->filter_day = false;
+    isp_mode = RIC_MODE_DAY;
+    st->mode_confirmed = true;
+    int filter_rejoin_pulses = pulses;
+    int filter_rejoin_isp_sets = isp_sets;
+    settings_request(st,
+        "{\"cmd\":\"set-daynight-settings\",\"mode\":\"auto\","
+        "\"automatic_outputs\":{\"color\":true,\"ircut\":true}}", true);
+    assert(st->mode_confirmed && st->filter_day && pulses == filter_rejoin_pulses + 1);
+    assert(isp_sets == filter_rejoin_isp_sets + 1);
+
+    settings_request(st,
+        "{\"cmd\":\"set-daynight-settings\",\"mode\":\"auto\","
+        "\"automatic_outputs\":{\"color\":false,\"ircut\":false}}", true);
+    st->filter_day = false;
+    isp_mode = RIC_MODE_NIGHT;
+    fail_isp = true;
+    settings_request(st,
+        "{\"cmd\":\"set-daynight-settings\",\"mode\":\"auto\","
+        "\"automatic_outputs\":{\"color\":true,\"ircut\":true}}", false);
+    fail_isp = false;
+    assert(!st->mode_confirmed && st->settings.auto_color && st->settings.auto_ircut);
+    settings_request(st,
+        "{\"cmd\":\"set-daynight-settings\",\"mode\":\"auto\","
+        "\"automatic_outputs\":{\"color\":true,\"ircut\":true}}", true);
+    settings_request(st,
+        "{\"cmd\":\"set-daynight-settings\",\"mode\":\"auto\","
+        "\"automatic_outputs\":{\"color\":false,\"ircut\":false}}", true);
+    st->filter_day = false;
+    isp_mode = RIC_MODE_NIGHT;
+    st->mode_confirmed = true;
+    int readback_gets = isp_gets;
+    char ownership[4096];
+    assert(ric_get_settings(st, ownership, sizeof(ownership)) > 0);
+    cJSON *ownership_root = cJSON_Parse(ownership);
+    cJSON *ownership_outputs = cJSON_GetObjectItemCaseSensitive(ownership_root,
+        "automatic_outputs");
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(ownership_root, "available")));
+    assert(strcmp(cJSON_GetStringValue(cJSON_GetObjectItemCaseSensitive(
+        ownership_root, "state")), "day") == 0);
+    assert(strcmp(cJSON_GetStringValue(cJSON_GetObjectItemCaseSensitive(
+        ownership_outputs, "color_state")), "night") == 0);
+    assert(strcmp(cJSON_GetStringValue(cJSON_GetObjectItemCaseSensitive(
+        ownership_outputs, "ircut_commanded_state")), "night") == 0);
+    assert(isp_gets == readback_gets + 1);
+    cJSON_Delete(ownership_root);
+    int loglevel_writes = writes;
+    int loglevel_isp_sets = isp_sets;
+    settings_request(st,
+        "{\"cmd\":\"set-daynight-settings\",\"mode\":\"auto\",\"loglevel\":\"trace\"}",
+        true);
+    assert(writes == loglevel_writes && isp_sets == loglevel_isp_sets &&
+           !st->filter_day && isp_mode == RIC_MODE_NIGHT);
+    st->filter_day = true;
+    isp_mode = RIC_MODE_DAY;
+    st->settings.schedule_enabled = false;
+
+    int manual_writes = writes;
+    int manual_isp_sets = isp_sets;
+    assert(ric_set_policy(st, RIC_FORCE_NIGHT));
+    assert(writes > manual_writes && isp_sets > manual_isp_sets && !st->filter_day);
+    assert(ric_set_policy(st, RIC_FORCE_DAY));
+    assert(st->filter_day && st->current_mode == RIC_MODE_DAY);
+    assert(ric_set_policy(st, RIC_AUTO));
+
+    st->photo.calibrated = true;
+    st->photo.rgain_base = 123;
+    st->photo.phase = PHOTO_PHASE_INTERFERE;
+    st->settings.trigger = RIC_TRIGGER_PHOTO;
+    st->day_count = 2;
+    st->night_count = 3;
+    st->day_condition_since_us = 10;
+    st->night_condition_since_us = 20;
+    settings_request(st,
+        "{\"cmd\":\"set-daynight-settings\",\"mode\":\"auto\","
+        "\"automation\":{\"paused\":true}}", true);
+    assert(st->settings.automation_paused && st->current_mode == RIC_MODE_DAY &&
+           st->mode_confirmed);
+    assert(st->day_count == 0 && st->night_count == 0 &&
+           st->day_condition_since_us == 0 && st->night_condition_since_us == 0);
+    assert(st->photo.phase == PHOTO_PHASE_NIGHT_DETECT && st->photo.calibrated &&
+           st->photo.rgain_base == 123);
+    int before_writes = writes;
+    assert(ric_set_policy(st, RIC_AUTO));
+    assert(writes == before_writes);
+    st->settings.schedule_enabled = true;
+    assert(ric_schedule_apply_minute(st, 23 * 60));
+    assert(writes == before_writes && !st->schedule_target_known);
+    st->settings.schedule_enabled = false;
+
+    settings_request(st,
+        "{\"cmd\":\"set-daynight-settings\",\"mode\":\"auto\","
+        "\"automation\":{\"paused\":false}}", true);
+    assert(!st->settings.automation_paused && st->current_mode == RIC_MODE_DAY);
+
+    settings_request(st,
+        "{\"cmd\":\"set-daynight-settings\",\"mode\":\"auto\","
+        "\"confirmation\":{\"day\":2,\"night\":2}}", false);
+    char response[4096];
+    assert(ric_get_settings(st, response, sizeof(response)) > 0);
+    cJSON *root = cJSON_Parse(response);
+    cJSON *confirmation = cJSON_GetObjectItemCaseSensitive(root, "confirmation");
+    assert(cJSON_IsFalse(cJSON_GetObjectItemCaseSensitive(confirmation, "supported")));
+    assert(cJSON_IsNull(cJSON_GetObjectItemCaseSensitive(confirmation, "values")));
+    cJSON_Delete(root);
+    st->settings.trigger = RIC_TRIGGER_GAIN;
+    assert(rss_config_save(st->cfg, path) == 0);
+}
+
+int main(int argc, char **argv)
+{
+    assert(argc == 2);
+    FILE *file = fopen(argv[1], "w");
+    assert(file);
+    fputs("[ircut]\nmode=auto\n", file);
+    fclose(file);
+    rss_config_t *cfg = rss_config_load(argv[1]);
+    assert(cfg);
+    ric_state_t st = {.cfg = cfg, .settings = {.enabled = true, .gpio_ircut = 1,
+        .gpio_ircut2 = 2, .gpio_irled = 3, .gpio_irled2 = -1, .ir850_enabled = true,
+        .auto_color = true, .auto_ircut = true, .day_confirm_count = 1,
+        .night_confirm_count = 1, .loglevel = RSS_LOG_INFO}};
+    set_policy(&st, "invalid", false);
+    assert(writes == 0);
+    bad_direction = true;
+    set_policy(&st, "night", false);
+    assert(writes == 0);
+    bad_direction = false;
+    fail_isp = true;
+    set_policy(&st, "night", false);
+    assert(writes == 2 && !st.mode_confirmed);
+    fail_isp = false;
+    for (int fault = 1; fault <= 6; ++fault) {
+        writes = 0;
+        fail_write = fault;
+        set_policy(&st, "night", false);
+        assert(!st.mode_confirmed);
+        assert(strcmp(rss_config_get_str(cfg, "ircut", "mode", ""), "auto") == 0);
+        if (fault <= 3)
+            assert(pins[1] == 0 && pins[2] == 0);
+    }
+    retry_failed_coil_release(&st, false);
+    retry_failed_coil_release(&st, true);
+    fail_write = 0;
+    bad_ack = true;
+    set_policy(&st, "night", false);
+    bad_ack = false;
+    stale_isp = true;
+    set_policy(&st, "night", false);
+    stale_isp = false;
+    writes = 0;
+    set_policy(&st, "night", true);
+    assert(isp_write_at == 2 && st.mode_confirmed && pins[1] == 0 && pins[2] == 0 && pins[3] == 1);
+    assert(rss_config_save(cfg, argv[1]) == 0);
+    rss_config_t *disk = rss_config_load(argv[1]);
+    assert(disk && strcmp(rss_config_get_str(disk, "ircut", "mode", ""), "night") == 0);
+    rss_config_free(disk);
+    rss_config_set_str(cfg, "ircut", "mode", "auto");
+    set_policy(&st, "night", true);
+    assert(strcmp(rss_config_get_str(cfg, "ircut", "mode", ""), "night") == 0);
+    writes = 0;
+    set_policy(&st, "day", true);
+    assert(isp_write_at > 0 && pins[3] == 0 && st.current_mode == RIC_MODE_DAY);
+    st.settings.trigger = RIC_TRIGGER_PHOTO;
+    st.photo.calibrated = true;
+    st.photo.rgain_base = 123;
+    st.photo.phase = PHOTO_PHASE_DAY_DETECT;
+    set_policy(&st, "auto", true);
+    assert(st.settings.opmode == RIC_AUTO);
+    assert(st.photo.phase == PHOTO_PHASE_NIGHT_DETECT);
+    assert(st.photo.calibrated && st.photo.rgain_base == 123);
+    set_policy(&st, "night", true);
+    set_policy(&st, "auto", true);
+    assert(st.photo.phase == PHOTO_PHASE_DAY_DETECT);
+    test_timing(&st, argv[1]);
+    test_transition_delay_uses_elapsed_time(&st);
+    test_invalid_exposure_does_not_advance_detection(&st);
+    test_poll_timer_ignores_early_wakeups();
+    test_gain_observation_modes_and_coalescing(&st);
+    test_gain_observation_rejects_inexact_responses(&st);
+    test_disabled_service_observation(&st);
+    test_schedule(&st);
+    test_sun_schedule(&st, argv[1]);
+    test_thresholds(&st, argv[1]);
+    test_idempotent_save_and_recovery(&st, argv[1]);
+    test_remaining_automation_policies(&st, argv[1]);
+    test_ir850_at_night_policy(&st, argv[1]);
+    test_initial_mode(&st, argv[1]);
+    test_independent_outputs(&st);
+    rss_config_free(cfg);
+    puts("Day/night GPIO failures, ISP readback, coil release and persistence retry passed");
+    return 0;
+}
