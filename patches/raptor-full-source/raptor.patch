diff --git a/rmr/rmr_policy.c b/rmr/rmr_policy.c
new file mode 100644
index 0000000000000000000000000000000000000000..84fd10a126a624dc592859b5bbbbe8d5beae9ae9
--- /dev/null
+++ b/rmr/rmr_policy.c
@@ -0,0 +1,115 @@
+#include "rmr_policy.h"
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static const struct { const char *key; int min, max; } integers[] = {
+	{"duration", 1, 86400}, {"limit", 1, 1000},
+	{"min_free_mb", 1, 1000000}, {"check_interval", 1, 86400}
+};
+
+int rmr_policy_parse(const cJSON *value, rmr_policy_t *out)
+{
+	if (!cJSON_IsObject(value) || cJSON_GetArraySize(value) != 6)
+		return -1;
+	const cJSON *autostart = cJSON_GetObjectItemCaseSensitive(value, "autostart");
+	const cJSON *cleanup = cJSON_GetObjectItemCaseSensitive(value, "cleanup_enabled");
+	if (!cJSON_IsBool(autostart) || !cJSON_IsBool(cleanup))
+		return -1;
+	rmr_policy_t next = {.autostart = cJSON_IsTrue(autostart),
+			     .cleanup_enabled = cJSON_IsTrue(cleanup)};
+	int *dest[] = {&next.duration, &next.limit, &next.min_free_mb, &next.check_interval};
+	for (unsigned i = 0; i < 4; ++i) {
+		const cJSON *field = cJSON_GetObjectItemCaseSensitive(value, integers[i].key);
+		if (!cJSON_IsNumber(field) || field->valuedouble < integers[i].min ||
+		    field->valuedouble > integers[i].max || field->valuedouble != field->valueint)
+			return -1;
+		*dest[i] = field->valueint;
+	}
+	*out = next;
+	return 0;
+}
+
+struct parse_state { cJSON *value; bool invalid; };
+static void config_key(const char *key, const char *value, void *opaque)
+{
+	struct parse_state *state = opaque;
+	if (!strcmp(key, "autostart") || !strcmp(key, "cleanup_enabled")) {
+		if (strcmp(value, "true") && strcmp(value, "false")) {
+			state->invalid = true;
+			return;
+		}
+		cJSON_ReplaceItemInObjectCaseSensitive(state->value, key,
+						cJSON_CreateBool(!strcmp(value, "true")));
+		return;
+	}
+	for (unsigned i = 0; i < 4; ++i) {
+		if (strcmp(key, integers[i].key))
+			continue;
+		char *end;
+		errno = 0;
+		long number = strtol(value, &end, 10);
+		if (errno || !*value || strspn(value, "0123456789") != strlen(value) ||
+		    *end || number < integers[i].min || number > integers[i].max) {
+			state->invalid = true;
+			return;
+		}
+		cJSON_ReplaceItemInObjectCaseSensitive(state->value, key, cJSON_CreateNumber(number));
+		return;
+	}
+	state->invalid = true;
+}
+
+static cJSON *settings_json(const rmr_policy_t *p)
+{
+	cJSON *value = cJSON_CreateObject();
+	cJSON_AddBoolToObject(value, "autostart", p->autostart);
+	cJSON_AddBoolToObject(value, "cleanup_enabled", p->cleanup_enabled);
+	cJSON_AddNumberToObject(value, "duration", p->duration);
+	cJSON_AddNumberToObject(value, "limit", p->limit);
+	cJSON_AddNumberToObject(value, "min_free_mb", p->min_free_mb);
+	cJSON_AddNumberToObject(value, "check_interval", p->check_interval);
+	return value;
+}
+
+int rmr_policy_load(rss_config_t *cfg, unsigned channel, rmr_policy_t *out)
+{
+	if (!cfg || channel > 1)
+		return -1;
+	rmr_policy_t defaults = {.duration = 300, .limit = 15, .min_free_mb = 1,
+				 .check_interval = 60};
+	struct parse_state state = {.value = settings_json(&defaults)};
+	if (!state.value)
+		return -1;
+	char section[16];
+	snprintf(section, sizeof(section), "recorder%u", channel);
+	rss_config_foreach(cfg, section, config_key, &state);
+	int rc = state.invalid ? -1 : rmr_policy_parse(state.value, out);
+	cJSON_Delete(state.value);
+	return rc;
+}
+
+void rmr_policy_store(rss_config_t *cfg, unsigned channel, const rmr_policy_t *p)
+{
+	char section[16];
+	snprintf(section, sizeof(section), "recorder%u", channel);
+	rss_config_set_bool(cfg, section, "autostart", p->autostart);
+	rss_config_set_bool(cfg, section, "cleanup_enabled", p->cleanup_enabled);
+	rss_config_set_int(cfg, section, "duration", p->duration);
+	rss_config_set_int(cfg, section, "limit", p->limit);
+	rss_config_set_int(cfg, section, "min_free_mb", p->min_free_mb);
+	rss_config_set_int(cfg, section, "check_interval", p->check_interval);
+}
+
+cJSON *rmr_policy_json(unsigned channel, const rmr_policy_t *p)
+{
+	cJSON *value = settings_json(p);
+	char path[32];
+	snprintf(path, sizeof(path), "raptor/stream%u", channel);
+	cJSON_AddNumberToObject(value, "channel", channel);
+	cJSON_AddStringToObject(value, "mount", "/mnt/mmcblk0p1");
+	cJSON_AddStringToObject(value, "device_path", path);
+	cJSON_AddStringToObject(value, "filename", "%Y-%m-%d/%H-%M-%S");
+	return value;
+}
