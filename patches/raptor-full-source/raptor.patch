diff --git a/rad/rad_input.c b/rad/rad_input.c
new file mode 100644
index 0000000000000000000000000000000000000000..7edf7785a7a80101041839804b0b60c31dd5aa92
--- /dev/null
+++ b/rad/rad_input.c
@@ -0,0 +1,520 @@
+/* Checked audio-input ownership. The main capture loop and control handler
+ * share one thread; callers must never hold an SDK frame across this call. */
+#include "rad_state.h"
+#include "rad_level.h"
+#include <stdlib.h>
+#include <string.h>
+
+static bool sample_rate_valid(int rate)
+{
+    /* Matched T31 1.1.6 IMPAudioSampleRate values, not device acceptance. */
+    const int rates[] = {8000, 16000, 24000, 32000, 44100, 48000, 96000};
+    for (size_t i = 0; i < sizeof(rates) / sizeof(rates[0]); ++i) {
+        if (rate == rates[i]) {
+            return true;
+        }
+    }
+    return false;
+}
+
+bool rad_input_ready(const rad_ctrl_ctx_t *ctx)
+{
+    if (ctx->ai_disabled || ctx->ai_cleanup_pending || !ctx->codec_ops ||
+        !*ctx->codec_ops || !ctx->ring || !*ctx->ring || !ctx->codec_ctx ||
+        !ctx->codec_str || strcmp((*ctx->codec_ops)->name, ctx->codec_str) != 0 ||
+        (*ctx->codec_ops)->codec_id != ctx->codec_id ||
+        ctx->codec_ctx->codec_id != ctx->codec_id || ctx->codec_ctx->ring != *ctx->ring) {
+        return false;
+    }
+    unsigned effects = 0;
+#ifdef RAPTOR_AUDIO_EFFECTS
+    effects = (ctx->ns_enabled ? 1u : 0u) | (ctx->hpf_enabled ? 2u : 0u) |
+              (ctx->agc_enabled ? 4u : 0u) | (ctx->aec_enabled ? 8u : 0u);
+#endif
+    return ctx->input_effects_owned == effects;
+}
+
+static int stop_processing(rad_ctrl_ctx_t *ctx);
+
+int rad_input_stop(rad_ctrl_ctx_t *ctx)
+{
+    bool needs_deinit = !ctx->ai_disabled || ctx->ai_cleanup_pending;
+    /* Quiesce the capture loop even when SDK teardown fails. */
+    ctx->ai_disabled = true;
+    if (*ctx->codec_ops && (*ctx->codec_ops)->deinit) {
+        (*ctx->codec_ops)->deinit(ctx->codec_ctx);
+    }
+    *ctx->codec_ops = NULL;
+    memset(ctx->codec_ctx, 0, sizeof(*ctx->codec_ctx));
+    if (*ctx->ring) {
+        rss_ring_destroy(*ctx->ring);
+        *ctx->ring = NULL;
+    }
+    int effect_ret = stop_processing(ctx);
+    if (effect_ret != RSS_OK) {
+        ctx->ai_cleanup_pending = true;
+        return effect_ret;
+    }
+    if (!needs_deinit) {
+        return RSS_OK;
+    }
+    ctx->ai_cleanup_pending = true;
+    int ret = RSS_HAL_CALL(ctx->ops, audio_deinit, ctx->hal_ctx);
+    if (ret == RSS_OK) {
+        ctx->ai_cleanup_pending = false;
+    }
+    return ret;
+}
+
+static int stop_processing(rad_ctrl_ctx_t *ctx)
+{
+#ifdef RAPTOR_AUDIO_EFFECTS
+    const struct { unsigned bit; int (*disable)(void *); } effects[] = {
+        {8, ctx->ops->audio_disable_aec},
+        {4, ctx->ops->audio_disable_agc},
+        {2, ctx->ops->audio_disable_hpf},
+        {1, ctx->ops->audio_disable_ns},
+    };
+    int first_error = RSS_OK;
+    for (size_t i = 0; i < sizeof(effects) / sizeof(effects[0]); ++i) {
+        if (!(ctx->input_effects_owned & effects[i].bit)) {
+            continue;
+        }
+        int ret = effects[i].disable ? effects[i].disable(ctx->hal_ctx) : RSS_ERR_NOTSUP;
+        if (ret == RSS_OK) {
+            ctx->input_effects_owned &= ~effects[i].bit;
+        } else if (first_error == RSS_OK) {
+            first_error = ret;
+        }
+    }
+    return first_error;
+#else
+    (void)ctx;
+    return RSS_OK;
+#endif
+}
+
+static int restore_processing(rad_ctrl_ctx_t *ctx, int level, int target, int compression)
+{
+#ifdef RAPTOR_AUDIO_EFFECTS
+    int ret;
+    if (ctx->ns_enabled) {
+        ctx->input_effects_owned |= 1;
+        ret = RSS_HAL_CALL(ctx->ops, audio_enable_ns, ctx->hal_ctx, (rss_ns_level_t)level);
+        if (ret == RSS_ERR_NOTSUP) {
+            ctx->input_effects_owned &= ~1u;
+        }
+        if (ret != RSS_OK) {
+            return ret;
+        }
+    }
+    if (ctx->hpf_enabled) {
+        ctx->input_effects_owned |= 2;
+        ret = RSS_HAL_CALL(ctx->ops, audio_enable_hpf, ctx->hal_ctx);
+        if (ret == RSS_ERR_NOTSUP) {
+            ctx->input_effects_owned &= ~2u;
+        }
+        if (ret != RSS_OK) {
+            return ret;
+        }
+    }
+    if (ctx->agc_enabled) {
+        rss_agc_config_t cfg = {
+            .target_level_dbfs = target,
+            .compression_gain_db = compression,
+        };
+        ctx->input_effects_owned |= 4;
+        ret = RSS_HAL_CALL(ctx->ops, audio_enable_agc, ctx->hal_ctx, &cfg);
+        if (ret == RSS_ERR_NOTSUP) {
+            ctx->input_effects_owned &= ~4u;
+        }
+        if (ret != RSS_OK) {
+            return ret;
+        }
+    }
+    if (ctx->aec_enabled) {
+        const char *path = rss_config_get_str(ctx->cfg, "audio", "aec_profile_path", "/etc");
+        ret = RSS_HAL_CALL(ctx->ops, audio_set_aec_profile_path, ctx->hal_ctx, path);
+        if (ret != RSS_OK) {
+            return ret;
+        }
+        ctx->input_effects_owned |= 8;
+        ret = RSS_HAL_CALL(ctx->ops, audio_enable_aec, ctx->hal_ctx, ctx->ai_dev, 0, 0, 0);
+        if (ret == RSS_ERR_NOTSUP) {
+            ctx->input_effects_owned &= ~8u;
+        }
+        if (ret != RSS_OK) {
+            return ret;
+        }
+    }
+#else
+    (void)ctx;
+    (void)level;
+    (void)target;
+    (void)compression;
+#endif
+    return RSS_OK;
+}
+
+static int input_start(rad_ctrl_ctx_t *ctx, const char *codec, int sample_rate,
+                       int level, int target, int compression)
+{
+    const rad_codec_ops_t *next_ops = rad_codec_find(codec);
+    if (!next_ops || !next_ops->init || !sample_rate_valid(sample_rate) ||
+        ctx->volume < -30 || ctx->volume > 120 || ctx->gain < 0 || ctx->gain > 31) {
+        return RSS_ERR_INVAL;
+    }
+    if (next_ops->codec_id == RAD_CODEC_PCMU || next_ops->codec_id == RAD_CODEC_PCMA) {
+        sample_rate = 8000;
+    }
+#ifdef RAPTOR_AUDIO_EFFECTS
+    if ((ctx->ns_enabled && (!ctx->ops->audio_enable_ns || !ctx->ops->audio_disable_ns)) ||
+        (ctx->hpf_enabled && (!ctx->ops->audio_enable_hpf || !ctx->ops->audio_disable_hpf)) ||
+        (ctx->agc_enabled && (!ctx->ops->audio_enable_agc || !ctx->ops->audio_disable_agc)) ||
+        (ctx->aec_enabled && (!ctx->ops->audio_enable_aec || !ctx->ops->audio_disable_aec ||
+                             !ctx->ops->audio_set_aec_profile_path))) {
+        return RSS_ERR_NOTSUP;
+    }
+    if ((level < RSS_NS_LOW || level > RSS_NS_VERYHIGH) ||
+        (target < 0 || target > 31 || compression < 0 || compression > 90) ||
+        (ctx->aec_enabled && !ctx->ao_enabled)) {
+        return RSS_ERR_INVAL;
+    }
+#endif
+    const char *configured_alc = rss_config_get_str(ctx->cfg, "audio", "alc_gain", NULL);
+    int alc_gain = -1;
+    if (configured_alc) {
+        if (configured_alc[0] < '0' || configured_alc[0] > '7' || configured_alc[1]) {
+            return RSS_ERR_INVAL;
+        }
+        if (!ctx->ops->audio_set_alc_gain || !ctx->ops->audio_get_alc_gain) {
+            return RSS_ERR_NOTSUP;
+        }
+        alc_gain = configured_alc[0] - '0';
+    }
+    /* Codec and encode-buffer preparation do not disturb the active input. */
+    rad_codec_ctx_t next = {.codec_id = next_ops->codec_id};
+    if (next_ops->init(&next, ctx->cfg, sample_rate) != 0) {
+        if (next_ops->deinit) {
+            next_ops->deinit(&next);
+        }
+        return RSS_ERR;
+    }
+    int size = next.encode_buf_size;
+    int minimum = sample_rate / 50 * 2;
+    if (size < minimum) {
+        size = minimum;
+    }
+    uint8_t *buffer = size <= 1024 * 1024 ? malloc((size_t)size) : NULL;
+    if (!buffer) {
+        if (next_ops->deinit) {
+            next_ops->deinit(&next);
+        }
+        return RSS_ERR;
+    }
+    int ret = rad_input_stop(ctx);
+    if (ret != RSS_OK) {
+        goto failed;
+    }
+    rss_audio_config_t config = {
+        .sample_rate = sample_rate,
+        .samples_per_frame = sample_rate / 50,
+        .chn_count = 1,
+        .frame_depth = 20,
+        .ai_device = ctx->ai_dev,
+        .ai_device_set = true,
+        .ai_vol = ctx->volume,
+        .ai_gain = ctx->gain,
+        .input_type = ctx->input_type,
+        .dmic_count = rss_config_get_int(ctx->cfg, "audio", "dmic_count", 1),
+        .dmic_aec_id = rss_config_get_int(ctx->cfg, "audio", "dmic_aec_id", 0),
+    };
+    ctx->ai_cleanup_pending = true;
+    ret = RSS_HAL_CALL(ctx->ops, audio_init, ctx->hal_ctx, &config);
+    if (ret != RSS_OK) {
+        goto cleanup_input;
+    }
+    ret = rad_apply_level(ctx->ops, ctx->hal_ctx, false, false, ctx->ai_dev, ctx->volume);
+    if (ret != RSS_OK) {
+        goto cleanup_input;
+    }
+    ret = rad_apply_level(ctx->ops, ctx->hal_ctx, false, true, ctx->ai_dev, ctx->gain);
+    if (ret != RSS_OK) {
+        goto cleanup_input;
+    }
+    if (alc_gain >= 0) {
+        ret = rad_apply_alc(ctx->ops, ctx->hal_ctx, ctx->ai_dev, alc_gain);
+        if (ret != RSS_OK) {
+            goto cleanup_input;
+        }
+    }
+    ret = restore_processing(ctx, level, target, compression);
+    if (ret != RSS_OK) {
+        goto cleanup_input;
+    }
+    /* Reinitialization must preserve privacy/mute before publishing a ring. */
+    ret = RSS_HAL_CALL(ctx->ops, audio_set_mute, ctx->hal_ctx, ctx->ai_dev, 0, ctx->muted);
+    if (ret != RSS_OK) {
+        goto cleanup_input;
+    }
+    int ring_size = next_ops->codec_id == RAD_CODEC_L16 ? 256 * 1024 : 128 * 1024;
+    rss_ring_t *ring = rss_ring_create("audio", 32, ring_size);
+    if (!ring) {
+        ring = rss_ring_create("audio", 32, 128 * 1024);
+    }
+    if (!ring) {
+        ret = RSS_ERR;
+        goto cleanup_input;
+    }
+    rss_ring_set_stream_info(ring, 0x10, next_ops->codec_id,
+                            (uint32_t)next.frame_samples, 0,
+                            sample_rate, 1, next.aot, 0);
+    next.ring = ring;
+    free(*ctx->encode_buf);
+    *ctx->encode_buf = buffer;
+    *ctx->encode_buf_size = size;
+    *ctx->codec_ctx = next;
+    *ctx->codec_ops = next_ops;
+    *ctx->ring = ring;
+    ctx->codec_str = next_ops->name;
+    ctx->codec_id = next_ops->codec_id;
+    ctx->sample_rate = sample_rate;
+#ifdef RAPTOR_AUDIO_EFFECTS
+    ctx->ns_level = level;
+    ctx->agc_target = target;
+    ctx->agc_compression = compression;
+#endif
+    ctx->ai_cleanup_pending = false;
+    ctx->ai_disabled = false;
+    *ctx->synth_audio_ts = rss_timestamp_us();
+    return RSS_OK;
+
+cleanup_input:
+    /* Failure leaves the owner quiesced. Failed cleanup stays explicitly
+     * unknown and is retried before any later initialization. */
+    (void)rad_input_stop(ctx);
+failed:
+    if (next_ops->deinit) {
+        next_ops->deinit(&next);
+    }
+    free(buffer);
+    return ret;
+}
+
+int rad_input_start(rad_ctrl_ctx_t *ctx, const char *codec, int sample_rate)
+{
+    return input_start(ctx, codec, sample_rate,
+        rss_config_get_int(ctx->cfg, "audio", "ns_level", RSS_NS_MODERATE),
+        rss_config_get_int(ctx->cfg, "audio", "agc_target_dbfs", 10),
+        rss_config_get_int(ctx->cfg, "audio", "agc_compression_db", 0));
+}
+
+int rad_input_boot(rad_ctrl_ctx_t *ctx)
+{
+    ctx->muted = true;
+    if (rss_config_privacy(ctx->cfg, &ctx->muted) != 0)
+        return RSS_ERR_INVAL;
+    if (!rss_config_get_bool(ctx->cfg, "audio", "ai_enabled", true)) {
+        return RSS_OK;
+    }
+    return rad_input_start(ctx, ctx->codec_str, ctx->sample_rate);
+}
+
+int rad_input_mute(rad_ctrl_ctx_t *ctx, bool muted)
+{
+    if (ctx->ai_cleanup_pending) {
+        return RSS_ERR;
+    }
+    if (!ctx->ai_disabled) {
+        int ret = RSS_HAL_CALL(ctx->ops, audio_set_mute, ctx->hal_ctx, ctx->ai_dev, 0, muted);
+        if (ret != RSS_OK) {
+            return ret;
+        }
+    }
+    /* With no capture pipeline, retain the explicit privacy policy for the
+     * next enable. rad_input_start applies it before creating the audio ring. */
+    ctx->muted = muted;
+    return RSS_OK;
+}
+
+int rad_input_status(rad_ctrl_ctx_t *ctx, char *buf, int size)
+{
+    bool active = !ctx->ai_disabled;
+    bool consistent = !active || (*ctx->codec_ops && *ctx->ring &&
+        (*ctx->codec_ops)->codec_id == ctx->codec_id && ctx->codec_ctx->codec_id == ctx->codec_id);
+    bool available = !ctx->ai_cleanup_pending && consistent;
+    cJSON *root = cJSON_CreateObject();
+    cJSON_AddStringToObject(root, "status", "ok");
+    cJSON_AddStringToObject(root, "readback", "owner");
+    cJSON_AddBoolToObject(root, "available", available);
+    if (available) {
+        cJSON_AddBoolToObject(root, "enabled", active);
+        cJSON_AddBoolToObject(root, "muted", ctx->muted);
+    } else {
+        cJSON_AddNullToObject(root, "enabled");
+        cJSON_AddNullToObject(root, "muted");
+    }
+    if (available && active) {
+        cJSON_AddStringToObject(root, "codec", ctx->codec_str);
+        cJSON_AddNumberToObject(root, "sample_rate", ctx->sample_rate);
+    } else {
+        cJSON_AddNullToObject(root, "codec");
+        cJSON_AddNullToObject(root, "sample_rate");
+    }
+    cJSON_AddStringToObject(root, "configured_codec",
+                          rss_config_get_str(ctx->cfg, "audio", "codec", "l16"));
+    cJSON *codecs = cJSON_AddObjectToObject(root, "codecs_built");
+    const char *names[] = {"pcmu", "pcma", "l16", "aac", "opus"};
+    for (size_t i = 0; i < sizeof(names) / sizeof(names[0]); ++i) {
+        cJSON_AddBoolToObject(codecs, names[i], rad_codec_find(names[i]) != NULL);
+    }
+    cJSON *processing = cJSON_AddObjectToObject(root, "processing");
+    cJSON_AddStringToObject(processing, "readback", "owner");
+#ifdef RAPTOR_AUDIO_EFFECTS
+    cJSON_AddBoolToObject(processing, "available", available && active);
+    if (available && active) {
+        cJSON_AddBoolToObject(processing, "ns", ctx->ns_enabled);
+        cJSON_AddNumberToObject(processing, "level", ctx->ns_level);
+        cJSON_AddBoolToObject(processing, "hpf", ctx->hpf_enabled);
+        cJSON_AddBoolToObject(processing, "agc", ctx->agc_enabled);
+        cJSON_AddNumberToObject(processing, "target", ctx->agc_target);
+        cJSON_AddNumberToObject(processing, "compression", ctx->agc_compression);
+    }
+    cJSON_AddBoolToObject(root, "effects_built", true);
+#else
+    cJSON_AddBoolToObject(processing, "available", false);
+    cJSON_AddBoolToObject(root, "effects_built", false);
+#endif
+    return rss_ctrl_resp_json(buf, size, root);
+}
+
+int rad_input_track_processing(rad_ctrl_ctx_t *ctx, unsigned bit, bool enabled, int result)
+{
+    if (result == RSS_OK) {
+        if (enabled) {
+            ctx->input_effects_owned |= bit;
+        } else {
+            ctx->input_effects_owned &= ~bit;
+        }
+    } else if (result != RSS_ERR_NOTSUP) {
+        /* A failed SDK change may have acquired or changed the processor.
+         * Stop capture and retain any teardown stage that cannot be released. */
+        ctx->input_effects_owned |= bit;
+        (void)rad_input_stop(ctx);
+    }
+    return result;
+}
+
+
+#ifdef RAPTOR_AUDIO_EFFECTS
+static bool processing_integer(cJSON *root, const char *name, int min, int max, int *value)
+{
+    cJSON *item = cJSON_GetObjectItemCaseSensitive(root, name);
+    if (!cJSON_IsNumber(item) || item->valuedouble != item->valueint ||
+        item->valueint < min || item->valueint > max) {
+        return false;
+    }
+    *value = item->valueint;
+    return true;
+}
+#endif
+
+int rad_input_processing(rad_ctrl_ctx_t *ctx, const char *json, char *buf, int size)
+{
+#ifndef RAPTOR_AUDIO_EFFECTS
+    (void)ctx;
+    (void)json;
+    return rss_ctrl_resp_error(buf, size, "audio effects were not built");
+#else
+    if (ctx->ai_disabled || ctx->ai_cleanup_pending) {
+        return rss_ctrl_resp_error(buf, size, "input unavailable");
+    }
+    cJSON *request = cJSON_Parse(json);
+    cJSON *command = cJSON_GetObjectItemCaseSensitive(request, "cmd");
+    bool valid = cJSON_IsString(command);
+    int ns = ctx->ns_enabled, hpf = ctx->hpf_enabled, agc = ctx->agc_enabled;
+    int level = ctx->ns_level, target = ctx->agc_target, compression = ctx->agc_compression;
+    if (valid && strcmp(command->valuestring, "set-input-processing") == 0) {
+        valid = processing_integer(request, "ns", 0, 1, &ns) &&
+            processing_integer(request, "hpf", 0, 1, &hpf) &&
+            processing_integer(request, "agc", 0, 1, &agc) &&
+            processing_integer(request, "level", 0, 3, &level) &&
+            processing_integer(request, "target", 0, 31, &target) &&
+            processing_integer(request, "compression", 0, 90, &compression);
+    } else if (valid && strcmp(command->valuestring, "set-ns") == 0) {
+        valid = processing_integer(request, "value", 0, 1, &ns);
+        if (cJSON_HasObjectItem(request, "level")) {
+            valid = valid && processing_integer(request, "level", 0, 3, &level);
+        }
+    } else if (valid && strcmp(command->valuestring, "set-hpf") == 0) {
+        valid = processing_integer(request, "value", 0, 1, &hpf);
+    } else if (valid && strcmp(command->valuestring, "set-agc") == 0) {
+        valid = processing_integer(request, "value", 0, 1, &agc);
+        if (cJSON_HasObjectItem(request, "target")) {
+            valid = valid && processing_integer(request, "target", 0, 31, &target);
+        }
+        if (cJSON_HasObjectItem(request, "compression")) {
+            valid = valid && processing_integer(request, "compression", 0, 90, &compression);
+        }
+    } else {
+        valid = false;
+    }
+    cJSON_Delete(request);
+    if (!valid) {
+        return rss_ctrl_resp_error(buf, size, "invalid processing profile");
+    }
+    bool old_ns = ctx->ns_enabled, old_hpf = ctx->hpf_enabled, old_agc = ctx->agc_enabled;
+    /* A persistence retry must repair the cache without interrupting a
+     * healthy pipeline that already owns exactly this profile. */
+    bool unchanged = rad_input_ready(ctx) && ns == old_ns && hpf == old_hpf &&
+        agc == old_agc && level == ctx->ns_level && target == ctx->agc_target &&
+        compression == ctx->agc_compression;
+    ctx->ns_enabled = ns;
+    ctx->hpf_enabled = hpf;
+    ctx->agc_enabled = agc;
+    int ret = unchanged ? RSS_OK :
+        input_start(ctx, ctx->codec_str, ctx->sample_rate, level, target, compression);
+    if (ret != RSS_OK) {
+        /* Restore the desired policy only. Keep failed teardown ownership and
+         * quiescence intact for the next explicit enable/retry. */
+        ctx->ns_enabled = old_ns;
+        ctx->hpf_enabled = old_hpf;
+        ctx->agc_enabled = old_agc;
+        return rss_ctrl_resp_error(buf, size, "processing apply failed");
+    }
+    const struct { const char *key; int value; } values[] = {
+        {"ns_level", level}, {"agc_target_dbfs", target}, {"agc_compression_db", compression},
+    };
+    rss_config_set_bool(ctx->cfg, "audio", "ns_enabled", ns);
+    rss_config_set_bool(ctx->cfg, "audio", "hpf_enabled", hpf);
+    rss_config_set_bool(ctx->cfg, "audio", "agc_enabled", agc);
+    for (size_t i = 0; i < sizeof(values) / sizeof(values[0]); ++i) {
+        rss_config_set_int(ctx->cfg, "audio", values[i].key, values[i].value);
+        if (rss_config_get_int(ctx->cfg, "audio", values[i].key, -1) != values[i].value) {
+            return rss_ctrl_resp_error(buf, size, "processing cache update failed");
+        }
+    }
+    if (rss_config_get_bool(ctx->cfg, "audio", "ns_enabled", !ns) != !!ns ||
+        rss_config_get_bool(ctx->cfg, "audio", "hpf_enabled", !hpf) != !!hpf ||
+        rss_config_get_bool(ctx->cfg, "audio", "agc_enabled", !agc) != !!agc) {
+        return rss_ctrl_resp_error(buf, size, "processing cache update failed");
+    }
+    return rss_ctrl_resp_ok(buf, size);
+#endif
+}
+
+
+int rad_privacy_status(rad_ctrl_ctx_t *ctx, char *buf, int size)
+{
+    bool available = !ctx->ai_cleanup_pending && (ctx->ai_disabled || rad_input_ready(ctx));
+    return rss_ctrl_resp(buf, size,
+        "{\"status\":\"ok\",\"persistence\":\"checked-startup\",\"available\":%s,\"enabled\":%s}",
+        available ? "true" : "false", available ? (ctx->muted ? "true" : "false") : "null");
+}
+
+int rad_input_publish(rad_ctrl_ctx_t *ctx, const void *data, uint32_t length, int64_t timestamp)
+{
+    if (ctx->muted || !rad_input_ready(ctx))
+        return RSS_OK;
+    return rss_ring_publish(*ctx->ring, data, length, timestamp, ctx->codec_id, 0);
+}
diff --git a/rad/rad_level.h b/rad/rad_level.h
new file mode 100644
index 0000000000000000000000000000000000000000..d24de7676653a18b7b24de99c365ffc66b001f40
--- /dev/null
+++ b/rad/rad_level.h
@@ -0,0 +1,60 @@
+#ifndef RAD_LEVEL_H
+#define RAD_LEVEL_H
+
+#include <raptor_hal.h>
+
+/* A successful setter alone is not readback. Keep cached state unchanged
+ * unless both operations succeed and the hardware reports the requested level. */
+static inline int rad_apply_level(const rss_hal_ops_t *ops, void *ctx,
+                                 bool output, bool gain, int dev, int value)
+{
+    int ret, observed = 0;
+    if (value < (gain ? 0 : -30) || value > (gain ? 31 : 120))
+        return RSS_ERR;
+    if (output) {
+        ret = gain ? RSS_HAL_CALL(ops, ao_set_gain, ctx, value)
+                   : RSS_HAL_CALL(ops, ao_set_volume, ctx, value);
+        if (ret != RSS_OK)
+            return ret;
+        ret = gain ? RSS_HAL_CALL(ops, ao_get_gain, ctx, &observed)
+                   : RSS_HAL_CALL(ops, ao_get_volume, ctx, &observed);
+    } else {
+        ret = gain ? RSS_HAL_CALL(ops, audio_set_gain, ctx, dev, 0, value)
+                   : RSS_HAL_CALL(ops, audio_set_volume, ctx, dev, 0, value);
+        if (ret != RSS_OK)
+            return ret;
+        ret = gain ? RSS_HAL_CALL(ops, audio_get_gain, ctx, dev, 0, &observed)
+                   : RSS_HAL_CALL(ops, audio_get_volume, ctx, dev, 0, &observed);
+    }
+    if (ret != RSS_OK)
+        return ret;
+    return observed == value ? RSS_OK : RSS_ERR;
+}
+
+static inline int rad_apply_alc(const rss_hal_ops_t *ops, void *ctx, int dev, int value)
+{
+    if (value < 0 || value > 7) {
+        return RSS_ERR_INVAL;
+    }
+    if (!ops->audio_set_alc_gain || !ops->audio_get_alc_gain) {
+        return RSS_ERR_NOTSUP;
+    }
+    int ret = RSS_HAL_CALL(ops, audio_set_alc_gain, ctx, dev, 0, value);
+    if (ret != RSS_OK) {
+        return ret;
+    }
+    int observed = -1;
+    ret = RSS_HAL_CALL(ops, audio_get_alc_gain, ctx, dev, 0, &observed);
+    if (ret != RSS_OK) {
+        return ret;
+    }
+    return observed == value ? RSS_OK : RSS_ERR;
+}
+
+int rad_audio_alc(const rss_hal_ops_t *ops, void *ctx, int dev,
+                  bool active, char *buf, int size);
+
+int rad_audio_levels(const rss_hal_ops_t *ops, void *ctx, int dev,
+                     bool ai_enabled, bool ao_enabled, char *buf, int size);
+
+#endif
