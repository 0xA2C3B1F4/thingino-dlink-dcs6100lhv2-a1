+static time_t utc_time(int year, int month, int day, int hour, int minute)
+{
+    struct tm value = {.tm_year = year - 1900, .tm_mon = month - 1,
+        .tm_mday = day, .tm_hour = hour, .tm_min = minute};
+    return timegm(&value);
+}
+
+static void configure_sun(ric_state_t *st, double latitude, double longitude,
+                          int sunrise_offset, int sunset_offset)
+{
+    st->settings.sun_enabled = true;
+    st->settings.schedule_enabled = false;
+    st->settings.sun_latitude = latitude;
+    st->settings.sun_longitude = longitude;
+    st->settings.sun_sunrise_offset = sunrise_offset;
+    st->settings.sun_sunset_offset = sunset_offset;
+    st->sun_cache_valid = false;
+}
+
+typedef struct {
+    int year, month, day, hour, minute;
+    ric_mode_t target;
+} expected_sun_state_t;
+
+static void assert_sun_chain(ric_state_t *st, const expected_sun_state_t *chain,
+                             size_t count)
+{
+    for (size_t i = 0; i < count; ++i) {
+        ric_mode_t target;
+        assert(ric_sun_target_at(st, utc_time(chain[i].year, chain[i].month,
+            chain[i].day, chain[i].hour, chain[i].minute), &target));
+        if (target != chain[i].target)
+            fprintf(stderr, "solar chain mismatch at %04d-%02d-%02d %02d:%02d: got %d expected %d\n",
+                chain[i].year, chain[i].month, chain[i].day, chain[i].hour,
+                chain[i].minute, target, chain[i].target);
+        assert(target == chain[i].target);
+    }
+}
+
+static void test_sun_schedule(ric_state_t *st, const char *path)
+{
+    ric_mode_t target;
+    configure_sun(st, 69.6492, 18.9553, 0, 0);
+    assert(ric_sun_target_at(st, utc_time(2028, 6, 21, 12, 0), &target));
+    assert(target == RIC_MODE_DAY && st->sun_condition == RIC_SUN_POLAR_DAY);
+    assert(ric_sun_target_at(st, utc_time(2028, 12, 21, 12, 0), &target));
+    assert(target == RIC_MODE_NIGHT && st->sun_condition == RIC_SUN_POLAR_NIGHT);
+    configure_sun(st, 90.0, 0.0, 0, 0);
+    assert(ric_sun_target_at(st, utc_time(2028, 6, 21, 12, 0), &target));
+    assert(target == RIC_MODE_DAY);
+    assert(ric_sun_target_at(st, utc_time(2028, 12, 21, 12, 0), &target));
+    assert(target == RIC_MODE_NIGHT);
+
+    /* Expected Tromso event chains around the approximation's 2028 polar
+     * boundaries. A polar entry begins at estimated solar midnight and settles
+     * again 24 hours later, after the maximum positive event offset. These
+     * tables pin the policy rather than accepting whichever state the current
+     * implementation returns. */
+    configure_sun(st, 69.6492, 18.9553, 0, 1440);
+    const expected_sun_state_t polar_day_positive[] = {
+        {2028, 5, 18, 22, 35, RIC_MODE_NIGHT},
+        {2028, 5, 18, 22, 41, RIC_MODE_DAY},
+        {2028, 5, 19, 22, 35, RIC_MODE_NIGHT},
+        {2028, 5, 19, 22, 41, RIC_MODE_DAY},
+        {2028, 6, 21, 12, 0, RIC_MODE_DAY},
+    };
+    assert_sun_chain(st, polar_day_positive,
+        sizeof(polar_day_positive) / sizeof(polar_day_positive[0]));
+
+    configure_sun(st, 69.6492, 18.9553, -1440, -1440);
+    const expected_sun_state_t polar_day_negative_and_exit[] = {
+        {2028, 5, 18, 22, 35, RIC_MODE_NIGHT},
+        {2028, 5, 18, 22, 41, RIC_MODE_DAY},
+        {2028, 7, 26, 22, 20, RIC_MODE_NIGHT},
+        {2028, 7, 26, 23, 45, RIC_MODE_DAY},
+        {2028, 7, 27, 22, 5, RIC_MODE_NIGHT},
+    };
+    assert_sun_chain(st, polar_day_negative_and_exit,
+        sizeof(polar_day_negative_and_exit) / sizeof(polar_day_negative_and_exit[0]));
+
+    configure_sun(st, 69.6492, 18.9553, 1440, 1440);
+    const expected_sun_state_t polar_night_positive_and_exit[] = {
+        {2028, 11, 27, 22, 30, RIC_MODE_NIGHT},
+        {2028, 11, 27, 22, 35, RIC_MODE_NIGHT},
+        {2028, 11, 28, 10, 30, RIC_MODE_DAY},
+        {2028, 11, 28, 11, 30, RIC_MODE_NIGHT},
+        {2028, 12, 21, 12, 0, RIC_MODE_NIGHT},
+        {2029, 1, 17, 10, 45, RIC_MODE_DAY},
+        {2029, 1, 17, 11, 30, RIC_MODE_NIGHT},
+    };
+    assert_sun_chain(st, polar_night_positive_and_exit,
+        sizeof(polar_night_positive_and_exit) / sizeof(polar_night_positive_and_exit[0]));
+
+    configure_sun(st, 69.6492, 18.9553, -1440, -1440);
+    const expected_sun_state_t polar_night_negative[] = {
+        {2028, 11, 27, 11, 30, RIC_MODE_NIGHT},
+        {2028, 11, 27, 22, 35, RIC_MODE_NIGHT},
+        {2028, 12, 21, 12, 0, RIC_MODE_NIGHT},
+    };
+    assert_sun_chain(st, polar_night_negative,
+        sizeof(polar_night_negative) / sizeof(polar_night_negative[0]));
+
+    configure_sun(st, 0.0, 0.0, 0, 0);
+    assert(ric_sun_target_at(st, utc_time(2028, 2, 29, 12, 0), &target));
+    assert(target == RIC_MODE_DAY && st->sun_cache_yday == 59);
+    configure_sun(st, 0.0, 179.0, 0, 0);
+    assert(ric_sun_target_at(st, utc_time(2028, 3, 20, 0, 0), &target));
+    assert(target == RIC_MODE_DAY);
+    configure_sun(st, 0.0, -179.0, 0, 0);
+    assert(ric_sun_target_at(st, utc_time(2028, 3, 20, 0, 0), &target));
+    assert(target == RIC_MODE_DAY);
+
+    char *saved_tz = getenv("TZ") ? strdup(getenv("TZ")) : NULL;
+    configure_sun(st, 60.1699, 24.9384, 0, 0);
+    time_t instant = utc_time(2028, 4, 2, 5, 0);
+    assert(setenv("TZ", "Europe/Helsinki", 1) == 0);
+    tzset();
+    assert(ric_sun_target_at(st, instant, &target));
+    ric_mode_t helsinki_target = target;
+    assert(setenv("TZ", "America/New_York", 1) == 0);
+    tzset();
+    assert(ric_sun_target_at(st, instant, &target) && target == helsinki_target);
+    if (saved_tz) {
+        assert(setenv("TZ", saved_tz, 1) == 0);
+        free(saved_tz);
+    } else {
+        assert(unsetenv("TZ") == 0);
+    }
+    tzset();
+
+    configure_sun(st, 0.0, 0.0, 1440, 0);
+    assert(ric_sun_target_at(st, utc_time(2028, 3, 20, 12, 0), &target));
+    assert(target == RIC_MODE_DAY);
+    st->settings.sun_latitude = NAN;
+    assert(!ric_sun_target_at(st, instant, &target));
+    st->settings.sun_latitude = 91.0;
+    assert(!ric_sun_target_at(st, instant, &target));
+    st->settings.sun_latitude = 60.1699;
+    assert(!ric_sun_target_at(st, 0, &target));
+
+    st->settings.trigger = RIC_TRIGGER_PHOTO;
+    configure_sun(st, 60.1699, 24.9384, 0, 0);
+    settings_request(st,
+        "{\"cmd\":\"set-daynight-settings\",\"mode\":\"auto\",\"schedule\":{\"enabled\":true,\"start_at\":\"07:00\",\"stop_at\":\"19:00\"}}",
+        false);
+    settings_request(st,
+        "{\"cmd\":\"set-daynight-settings\",\"mode\":\"night\",\"sun\":{\"enabled\":true,\"latitude\":60.1699123,\"longitude\":24.9384567,\"sunrise_offset\":15,\"sunset_offset\":-20}}",
+        true);
+    assert(st->settings.opmode == RIC_FORCE_NIGHT && st->settings.sun_enabled);
+    assert(st->settings.sun_latitude == 60.1699123);
+    assert(st->settings.sun_longitude == 24.9384567);
+    int before_sets = isp_sets;
+    assert(ric_sun_poll(st, instant) && !st->sun_target_known && isp_sets == before_sets);
+    assert(rss_config_save(st->cfg, path) == 0);
+    rss_config_t *disk = rss_config_load(path);
+    assert(disk && rss_config_get_bool(disk, "ircut", "sun_enabled", false));
+    char *end = NULL;
+    double disk_latitude = strtod(rss_config_get_str(disk, "ircut", "sun_latitude", ""), &end);
+    assert(end && *end == '\0' && disk_latitude == 60.1699123);
+    end = NULL;
+    double disk_longitude = strtod(rss_config_get_str(disk, "ircut", "sun_longitude", ""), &end);
+    assert(end && *end == '\0' && disk_longitude == 24.9384567);
+    assert(rss_config_get_int(disk, "ircut", "sunrise_offset", 0) == 15);
+    assert(rss_config_get_int(disk, "ircut", "sunset_offset", 0) == -20);
+    rss_config_free(disk);
+
+    st->settings.opmode = RIC_AUTO;
+    st->current_mode = RIC_MODE_NIGHT;
+    st->mode_confirmed = true;
+    fail_isp = true;
+    assert(!ric_sun_poll(st, instant));
+    assert(st->sun_target_known && !st->sun_application_ok);
+    fail_isp = false;
+    st->settings.trigger = RIC_TRIGGER_GAIN;
+    st->settings.sun_enabled = false;
+    st->sun_target_known = false;
+}
