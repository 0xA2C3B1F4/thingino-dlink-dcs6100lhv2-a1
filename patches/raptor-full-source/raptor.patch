+static void threshold_request(ric_state_t *st, const char *request, bool success)
+{
+    char response[512];
+    ric_config_t before = st->settings;
+    int writes_before = writes;
+    assert(ric_set_thresholds(st, request, response, sizeof(response)) > 0);
+    cJSON *root = cJSON_Parse(response);
+    const cJSON *status = cJSON_GetObjectItemCaseSensitive(root, "status");
+    assert(cJSON_IsString(status));
+    assert((strcmp(status->valuestring, "ok") == 0) == success);
+    assert(writes == writes_before);
+    if (!success)
+        assert(memcmp(&before, &st->settings, sizeof(before)) == 0);
+    cJSON_Delete(root);
+}
