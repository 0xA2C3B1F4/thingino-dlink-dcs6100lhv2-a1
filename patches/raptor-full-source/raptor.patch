+static void test_ir850_at_night_policy(ric_state_t *st, const char *path)
+{
+    set_policy(st, "day", true);
+    int before_writes = writes;
+    settings_request(st,
+        "{\"cmd\":\"set-daynight-settings\",\"mode\":\"day\",\"ir850_at_night\":false}", true);
+    assert(!st->settings.ir850_enabled && !st->ir850_manual && pins[3] == 0);
+    assert(writes == before_writes);
+
+    char response[4096];
+    assert(ric_get_settings(st, response, sizeof(response)) > 0);
+    cJSON *root = cJSON_Parse(response);
+    assert(cJSON_IsFalse(cJSON_GetObjectItemCaseSensitive(root, "ir850_at_night")));
+    cJSON_Delete(root);
+    assert(rss_config_save(st->cfg, path) == 0);
+    rss_config_t *disk = rss_config_load(path);
+    assert(disk && !rss_config_get_bool(disk, "ircut", "ir850", true));
+    rss_config_free(disk);
+
+    set_policy(st, "night", true);
+    assert(pins[3] == 0);
+    settings_request(st,
+        "{\"cmd\":\"set-daynight-settings\",\"mode\":\"night\",\"ir850_at_night\":true}", true);
+    assert(st->settings.ir850_enabled && pins[3] == 1 && ric_verify_mode(st));
+
+    before_writes = writes;
+    fail_write = writes + 1;
+    settings_request(st,
+        "{\"cmd\":\"set-daynight-settings\",\"mode\":\"night\",\"ir850_at_night\":false}", false);
+    fail_write = 0;
+    assert(st->settings.ir850_enabled && pins[3] == 1 && ric_verify_mode(st));
+    assert(writes == before_writes + 2);
+    assert(rss_config_get_bool(st->cfg, "ircut", "ir850", false));
+
+    cJSON *state = output_request(st,
+        "{\"cmd\":\"set-output\",\"output\":\"ir850\",\"enabled\":false}", true);
+    cJSON_Delete(state);
+    assert(st->ir850_manual && pins[3] == 0);
+    before_writes = writes;
+    settings_request(st,
+        "{\"cmd\":\"set-daynight-settings\",\"mode\":\"night\",\"ir850_at_night\":false}", true);
+    assert(st->ir850_manual && !st->settings.ir850_enabled && pins[3] == 0);
+    assert(writes == before_writes);
+    set_policy(st, "night", true);
+    assert(!st->ir850_manual && pins[3] == 0 && ric_verify_mode(st));
+
+    before_writes = writes;
+    const char *invalid[] = {
+        "{\"cmd\":\"set-daynight-settings\",\"mode\":\"night\",\"ir850_at_night\":1}",
+        "{\"cmd\":\"set-daynight-settings\",\"mode\":\"night\",\"ir850_at_night\":false,\"extra\":0}",
+        "{\"cmd\":\"set-daynight-settings\",\"mode\":\"night\",\"ir850_at_night\":true,\"ir850_at_night\":false}"
+    };
+    for (size_t i = 0; i < sizeof(invalid) / sizeof(invalid[0]); ++i)
+        settings_request(st, invalid[i], false);
+    assert(writes == before_writes && !st->settings.ir850_enabled);
+}
