+rss_ring_t *fps_test_ring(int slot, uint32_t id, uint32_t codec, uint32_t num, uint32_t den)
+{
+    if (slot < 0 || slot >= 3)
+        abort();
+    headers[slot] = (rss_ring_header_t){0};
+    headers[slot].version = RSS_RING_VERSION;
+    rings[slot] = (rss_ring_t){.header = &headers[slot], .is_producer = true};
+    rss_ring_set_stream_info(&rings[slot], id, codec, 640, 360, num, den, 0, 0);
+    return &rings[slot];
+}
diff --git a/tests/test_fps_cpp.cpp b/tests/test_fps_cpp.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..90ad7d65942619a3e6d8d67ddb38e1e64b76c633
--- /dev/null
+++ b/tests/test_fps_cpp.cpp
@@ -0,0 +1,59 @@
+#include <cassert>
+#include <cstddef>
+#include "../rsd-555/rsd555.h"
+
+extern "C" {
+rss_ring_t *test_cpp_ring(uint32_t num, uint32_t den, uint32_t stream_id);
+size_t test_cpp_header_offset(unsigned field);
+int rss_ring_set_video_fps(rss_ring_t *ring, uint32_t num);
+}
+
+static void expect(rss_ring_t *ring, uint32_t num, uint32_t den)
+{
+    uint32_t n = 111;
+    uint32_t d = 222;
+    assert(rss_ring_get_fps(ring, &n, &d) == 0);
+    assert(n == num);
+    assert(d == den);
+}
+
+int main()
+{
+    /* Assert only the prefix offsets still used for static metadata. The
+     * numerator padding must never be read as a C++ scalar. */
+    const size_t offsets[] = {
+        offsetof(rss_ring_header_t, _fps_num_padding),
+        offsetof(rss_ring_header_t, _fps_den_padding),
+        offsetof(rss_ring_header_t, codec),
+        offsetof(rss_ring_header_t, width),
+        offsetof(rss_ring_header_t, height),
+        offsetof(rss_ring_header_t, profile),
+        offsetof(rss_ring_header_t, level),
+    };
+    for (unsigned i = 0; i < sizeof(offsets) / sizeof(offsets[0]); i++)
+        assert(offsets[i] == test_cpp_header_offset(i));
+    rss_ring_t *ring = test_cpp_ring(5, 1, 0);
+    expect(ring, 5, 1);
+    assert(rss_ring_set_video_fps(ring, 30) == 0);
+    expect(ring, 30, 1);
+    ring = test_cpp_ring(30000, 1001, 1);
+    expect(ring, 30000, 1001);
+    assert(rss_ring_set_video_fps(ring, 30) != 0);
+    expect(ring, 30000, 1001);
+    ring = test_cpp_ring(48000, 1, 0x10);
+    assert(rsd555_ring_sample_rate(ring) == 48000);
+    assert(rss_ring_set_video_fps(ring, 30) != 0);
+    expect(ring, 48000, 1);
+    ring = test_cpp_ring(96000, 2, 0x10);
+    assert(rsd555_ring_sample_rate(ring) == 96000);
+    expect(ring, 96000, 2);
+    ring = test_cpp_ring(0, 1, 0);
+    uint32_t num = 111;
+    uint32_t den = 222;
+    assert(rss_ring_get_fps(ring, &num, &den) != 0);
+    assert(num == 111 && den == 222);
+    assert(rsd555_ring_sample_rate(ring) == 0);
+    assert(rsd555_ring_sample_rate(NULL) == 0);
+    puts("Actual C IPC getter through rsd-555 C++ header boundary passed");
+    return 0;
+}
