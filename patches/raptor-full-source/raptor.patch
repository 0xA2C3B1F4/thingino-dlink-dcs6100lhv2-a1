index 0000000000000000000000000000000000000000..52fba6d4d8f1857a61a7aa8b9cc8bde621485098
--- /dev/null
+++ b/tests/test_stream_init_verify.c
@@ -0,0 +1,228 @@
+#include "rvd.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+static int test_shm_open(const char *name, int flags, ...);
+static int test_shm_unlink(const char *name);
+static int test_ftruncate(int fd, off_t length);
+static void *test_mmap(void *addr, size_t length, int prot, int flags, int fd,
+                       off_t offset);
+static int test_munmap(void *addr, size_t length);
+static int test_close(int fd);
+
+#define shm_open test_shm_open
+#define shm_unlink test_shm_unlink
+#define ftruncate test_ftruncate
+#define mmap test_mmap
+#define munmap test_munmap
