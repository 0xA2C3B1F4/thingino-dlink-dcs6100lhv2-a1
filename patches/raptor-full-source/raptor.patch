diff --git a/tests/test_rhd_snapshot_policy.c b/tests/test_rhd_snapshot_policy.c
new file mode 100644
index 0000000000000000000000000000000000000000..5240d1dfe01d487a5be201ca70388a0e0fc697d5
--- /dev/null
+++ b/tests/test_rhd_snapshot_policy.c
@@ -0,0 +1,69 @@
+#include "../rhd/rhd_snapshot_policy.h"
+
+#include <assert.h>
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+
+static void finish_if_resolved(rhd_client_t *client, rhd_snapshot_resolution_t resolution)
+{
+	if (resolution != RHD_SNAPSHOT_WAIT)
+		rhd_snapshot_resolve(client);
+}
+
+int main(void)
+{
+	static const uint8_t jpeg[] = {0xFF, 0xD8, 0xFF, 0xD9};
+	rhd_client_t client;
+	memset(&client, 0, sizeof(client));
+	client.snap_pending = true;
+	client.snap_stream = 1;
+	client.snap_deadline = 5000;
+	assert(rhd_snapshot_has_ring_demand(&client));
+
+	/* A normal parked request remains live until a fresh JPEG arrives. */
+	rhd_snapshot_resolution_t resolution =
+		rhd_snapshot_resolution(false, 0, -EAGAIN, NULL, 0, 1000,
+					client.snap_deadline);
+	assert(resolution == RHD_SNAPSHOT_WAIT);
+	finish_if_resolved(&client, resolution);
+	assert(client.snap_pending);
+
+	resolution = rhd_snapshot_resolution(false, 0, 0, jpeg, sizeof(jpeg), 1001,
+					     client.snap_deadline);
+	assert(resolution == RHD_SNAPSHOT_FRAME);
+	finish_if_resolved(&client, resolution);
+	assert(!client.snap_pending);
+
+	/* Privacy takes priority over a simultaneously readable scene frame. */
+	client.snap_pending = true;
+	resolution = rhd_snapshot_resolution(true, sizeof(jpeg), 0, jpeg, sizeof(jpeg), 1002,
+					     client.snap_deadline);
+	assert(resolution == RHD_SNAPSHOT_PRIVACY);
+	finish_if_resolved(&client, resolution);
+	assert(!rhd_snapshot_has_ring_demand(&client));
+
+	/* Missing Privacy media fails closed and also clears ring demand. */
+	client.snap_pending = true;
+	resolution = rhd_snapshot_resolution(true, 0, 0, jpeg, sizeof(jpeg), 1003,
+					     client.snap_deadline);
+	assert(resolution == RHD_SNAPSHOT_PRIVACY_UNAVAILABLE);
+	finish_if_resolved(&client, resolution);
+	assert(!rhd_snapshot_has_ring_demand(&client));
+
+	/* Ring errors remain bounded by the existing parked-request deadline. */
+	client.snap_pending = true;
+	resolution = rhd_snapshot_resolution(false, 0, -EIO, NULL, 0, 4999,
+					     client.snap_deadline);
+	assert(resolution == RHD_SNAPSHOT_WAIT);
+	finish_if_resolved(&client, resolution);
+	assert(client.snap_pending);
+	resolution = rhd_snapshot_resolution(false, 0, -EIO, NULL, 0, 5000,
+					     client.snap_deadline);
+	assert(resolution == RHD_SNAPSHOT_TIMEOUT);
+	finish_if_resolved(&client, resolution);
+	assert(!rhd_snapshot_has_ring_demand(&client));
+
+	puts("RHD parked snapshot Privacy, normal frame, timeout and demand cleanup passed");
+	return 0;
+}
