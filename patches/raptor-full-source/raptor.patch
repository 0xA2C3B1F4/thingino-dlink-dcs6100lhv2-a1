+static void mark_glyph_coverage(uint8_t *buf, uint32_t buf_w, uint32_t buf_h,
+				const rod_glyph_t *glyph, int dx, int dy, size_t channel)
+{
+	if (!glyph->alpha)
+		return;
+	for (int gy = 0; gy < glyph->height; gy++) {
+		int py = dy + gy;
+		if (py < 0 || py >= (int)buf_h)
+			continue;
+		for (int gx = 0; gx < glyph->width; gx++) {
+			int px = dx + gx;
+			if (px < 0 || px >= (int)buf_w)
+				continue;
+			uint8_t coverage = glyph->alpha[gy * glyph->width + gx];
+			uint8_t *stored = buf + (py * buf_w + px) * 4 + channel;
+			if (coverage > *stored)
+				*stored = coverage;
+		}
+	}
+}
+
+static void mark_string_coverage(rod_font_t *font, uint8_t *buf, uint32_t buf_w, uint32_t buf_h,
+				 int pen_x, int baseline, const char *text, size_t channel)
+{
+	while (*text) {
+		rod_glyph_t *glyph = rod_glyph_lookup(font, (uint32_t)(uint8_t)*text);
+		if (glyph) {
+			int dx = pen_x + glyph->x_offset;
+			int dy = baseline + glyph->y_offset;
+			mark_glyph_coverage(buf, buf_w, buf_h, glyph, dx, dy, channel);
+			pen_x += glyph->advance;
+		}
+		text++;
+	}
+}
+
+static void blend_overlay_pixel(uint8_t *dst, uint32_t color, uint8_t coverage)
+{
+	uint8_t color_alpha = (uint8_t)(color >> 24);
+	uint32_t alpha = (coverage * (uint32_t)color_alpha + 127) / 255;
+	if (alpha == 0)
+		return;
+	uint32_t inverse = 255 - alpha;
+	uint32_t old_weight = (dst[3] * inverse + 127) / 255;
+	uint32_t out_alpha = alpha + old_weight;
+	dst[0] = (uint8_t)(((color & 0xff) * alpha + dst[0] * old_weight + out_alpha / 2) /
+			   out_alpha);
+	dst[1] = (uint8_t)((((color >> 8) & 0xff) * alpha + dst[1] * old_weight + out_alpha / 2) /
+			   out_alpha);
+	dst[2] = (uint8_t)((((color >> 16) & 0xff) * alpha + dst[2] * old_weight + out_alpha / 2) /
+			   out_alpha);
+	dst[3] = (uint8_t)out_alpha;
+}
+
+/* Named text overlays use the output bitmap itself as two temporary coverage
+ * channels. A stroke is blended once per pixel even when several offsets overlap. */
+void rod_draw_text_overlay(rod_state_t *st, int stream_idx, int font_idx, uint8_t *buf,
+			   uint32_t buf_w, uint32_t buf_h, const char *text, int align,
+			   uint32_t color, uint32_t stroke_color, int stroke_size)
+{
+	rod_font_t *f = &st->fonts[stream_idx][font_idx];
+	int stroke = stroke_size;
+	int baseline = f->ascender + (stroke > 0 ? stroke : 0);
+	int pad = stroke > 0 ? stroke : 0;
+	int text_w = measure_text(f, text);
+	int pen_x;
+	size_t pixels = (size_t)buf_w * buf_h;
+
+	memset(buf, 0, pixels * 4);
+	if (st->settings.text_hidden)
+		return;
+
+	if (align == 2)
+		pen_x = (int)buf_w - text_w - pad;
+	else if (align == 1)
+		pen_x = ((int)buf_w - text_w) / 2;
+	else
+		pen_x = pad;
+
+	if (pen_x < pad)
+		pen_x = pad;
+
+	if (stroke > 0) {
+		for (int sy = -stroke; sy <= stroke; sy++) {
+			for (int sx = -stroke; sx <= stroke; sx++) {
+				if (sx == 0 && sy == 0)
+					continue;
+				/* Skip corners for round-ish stroke */
+				if (abs(sx) + abs(sy) > stroke)
+					continue;
+				mark_string_coverage(f, buf, buf_w, buf_h, pen_x + sx, baseline + sy,
+						     text, 0);
+			}
+		}
+	}
+	mark_string_coverage(f, buf, buf_w, buf_h, pen_x, baseline, text, 1);
+
+	uint32_t background = st->settings.background_color;
+	uint8_t background_alpha = (uint8_t)(background >> 24);
+	for (size_t i = 0; i < pixels; i++) {
+		uint8_t *pixel = buf + i * 4;
+		uint8_t outline_coverage = pixel[0];
+		uint8_t fill_coverage = pixel[1];
+		if (background_alpha == 0) {
+			memset(pixel, 0, 4);
+		} else {
+			pixel[0] = (uint8_t)(background & 0xff);
+			pixel[1] = (uint8_t)((background >> 8) & 0xff);
+			pixel[2] = (uint8_t)((background >> 16) & 0xff);
+			pixel[3] = background_alpha;
+		}
+		blend_overlay_pixel(pixel, stroke_color, outline_coverage);
+		blend_overlay_pixel(pixel, color, fill_coverage);
+	}
+}
+
 void rod_draw_text(rod_state_t *st, int stream_idx, int font_idx, uint8_t *buf, uint32_t buf_w,
 		   uint32_t buf_h, const char *text, int align, uint32_t color,
 		   uint32_t stroke_color, int stroke_size)
diff --git a/rod/rod_settings.c b/rod/rod_settings.c
new file mode 100644
index 0000000000000000000000000000000000000000..0dfa4077930684db31f06d27a0e8948361aa5f0b
--- /dev/null
+++ b/rod/rod_settings.c
@@ -0,0 +1,388 @@
+/* Checked OSD text settings. RVD validates its local bitmap copies before
+ * SDK submission; a ROD IPC timeout may resume SHM publishing meanwhile. */
+#include "rod.h"
+#include "../osd_snapshot.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+struct text_target {
+    rod_element_t *element;
+    rod_elem_stream_t *stream;
+    int index;
+    char text[ROD_EXPANDED_LEN];
+};
+
+static int collect_targets(rod_state_t *st, struct text_target targets[32], unsigned *caps)
+{
+    if (st->paused || st->stream_count < 1 || st->stream_count > 2 ||
+        st->elem_count < 0 || st->elem_count > ROD_MAX_ELEMENTS)
+        return -1;
+    int count = 0;
+    size_t total = 0;
+    *caps = 0;
+    for (int i = 0; i < st->elem_count; ++i) {
+        rod_element_t *e = &st->elements[i];
+        if (!e->active || !e->visible || e->type != ROD_ELEM_TEXT)
+            continue;
+        if (strcmp(e->name, "privacy") == 0 || strcmp(e->name, "detect") == 0)
+            return -1;
+        char expanded[ROD_EXPANDED_LEN];
+        int length = rod_expand_template(st, e->tmpl, expanded, sizeof(expanded));
+        if (length <= 0 || length >= (int)sizeof(expanded) - 1)
+            return -1;
+        int stroke = e->stroke_size >= 0 ? e->stroke_size : st->settings.font_stroke;
+        if (stroke < 0 || stroke > 5)
+            return -1;
+        for (int s = 0; s < st->stream_count; ++s) {
+            if (e->sub_streams_only && s == 0)
+                continue;
+            rod_elem_stream_t *es = &e->streams[s];
+            if (!es->shm || es->font_idx < 0 || es->font_idx >= ROD_MAX_FONTS ||
+                !es->width || !es->height || es->width > 4096 || es->height > 4096 || count >= 32)
+                return -1;
+            rod_font_t *font = &st->fonts[s][es->font_idx];
+            if (!font->sft.font || font->text_height <= 0 || (uint32_t)font->text_height > es->height)
+                return -1;
+            int width = stroke * 2;
+            for (const unsigned char *p = (const unsigned char *)expanded; *p; ++p) {
+                if (*p < 0x20 || *p > 0x7e)
+                    return -1;
+                rod_glyph_t *glyph = rod_glyph_lookup(font, *p);
+                if (!glyph || glyph->advance < 0 ||
+                    (glyph->width > 0 && glyph->height > 0 && !glyph->alpha))
+                    return -1;
+                width += glyph->advance;
+                if ((uint32_t)width > es->width)
+                    return -1;
+            }
+            int text_width = width - stroke * 2;
+            int pen = e->align == 2 ? (int)es->width - text_width - stroke :
+                      e->align == 1 ? ((int)es->width - text_width) / 2 : stroke;
+            if (pen < stroke)
+                pen = stroke;
+            for (const unsigned char *p = (const unsigned char *)expanded; *p; ++p) {
+                rod_glyph_t *glyph = rod_glyph_lookup(font, *p);
+                int x = pen + glyph->x_offset;
+                int y = font->ascender + stroke + glyph->y_offset;
+                if (glyph->width > 0 && glyph->height > 0 &&
+                    (x < stroke || y < stroke ||
+                     x + glyph->width + stroke > (int)es->width ||
+                     y + glyph->height + stroke > (int)es->height))
+                    return -1;
+                pen += glyph->advance;
+            }
+            uint32_t width_seen = 0, height_seen = 0;
+            if (!rss_osd_get_active_buffer(es->shm, &width_seen, &height_seen) ||
+                width_seen != es->width || height_seen != es->height ||
+                !rss_osd_get_draw_buffer(es->shm))
+                return -1;
+            total += (size_t)es->width * es->height * 4;
+            if (total > 512 * 1024)
+                return -1;
+            targets[count] = (struct text_target){.element = e, .stream = es, .index = s};
+            rss_strlcpy(targets[count].text, expanded, sizeof(targets[count].text));
+            count++;
+        }
+        if (strstr(e->tmpl, "%time%"))
+            *caps |= 1;
+        if (!e->has_color)
+            *caps |= 2 | 64;
+        if (!e->has_stroke_color && stroke > 0)
+            *caps |= 4 | 128;
+        if (e->font_size <= 0)
+            *caps |= 8;
+        *caps |= 16;
+        *caps |= 32;
+    }
+    return count ? count : -1;
+}
+
+static int sync_snapshot(struct text_target *targets, int count, const char *id, bool check_only)
+{
+    cJSON *root = cJSON_CreateObject();
+    cJSON_AddStringToObject(root, "cmd", check_only ? "osd-check-snapshot" : "osd-apply-snapshot");
+    cJSON_AddStringToObject(root, "id", id);
+    cJSON *regions = cJSON_AddArrayToObject(root, "regions");
+    for (int i = 0; i < count; ++i) {
+        rod_elem_stream_t *es = targets[i].stream;
+        uint32_t width = 0, height = 0;
+        const uint8_t *pixels = rss_osd_get_active_buffer(es->shm, &width, &height);
+        if (!pixels || width != es->width || height != es->height) {
+            cJSON_Delete(root);
+            return -1;
+        }
+        cJSON *entry = cJSON_CreateObject();
+        cJSON_AddNumberToObject(entry, "stream", targets[i].index);
+        cJSON_AddStringToObject(entry, "name", targets[i].element->name);
+        cJSON_AddNumberToObject(entry, "width", width);
+        cJSON_AddNumberToObject(entry, "height", height);
+        cJSON_AddNumberToObject(entry, "hash", osd_snapshot_hash(pixels, (size_t)width * height * 4));
+        cJSON_AddItemToArray(regions, entry);
+    }
+    char *command = cJSON_PrintUnformatted(root);
+    cJSON_Delete(root);
+    if (!command || strlen(command) >= 4096) {
+        free(command);
+        return -1;
+    }
+    char response[256];
+    int length = rss_ctrl_send_command(RSS_RUN_DIR "/rvd.sock", command, response, sizeof(response), 1000);
+    free(command);
+    if (length <= 0 || length >= (int)sizeof(response) - 1 || strlen(response) != (size_t)length)
+        return -1;
+    root = cJSON_ParseWithOpts(response, NULL, true);
+    cJSON *status = cJSON_GetObjectItemCaseSensitive(root, "status");
+    bool ok = cJSON_IsObject(root) && cJSON_GetArraySize(root) == 1 &&
+        cJSON_IsString(status) && strcmp(status->valuestring, "ok") == 0;
+    cJSON_Delete(root);
+    return ok ? 0 : -1;
+}
+
+int rod_get_settings(rod_state_t *st, char *resp, int size)
+{
+    struct text_target targets[32];
+    unsigned caps = 0;
+    int count = collect_targets(st, targets, &caps);
+    bool available = count > 0 && sync_snapshot(targets, count, "0", true) == 0;
+    bool confirmed = available && st->settings_apply_id[0] &&
+        strcmp(st->settings.time_format, st->confirmed_settings.time_format) == 0 &&
+        st->settings.font_color == st->confirmed_settings.font_color &&
+        st->settings.stroke_color == st->confirmed_settings.stroke_color &&
+        st->settings.background_color == st->confirmed_settings.background_color &&
+        st->settings.font_size == st->confirmed_settings.font_size &&
+        st->settings.text_hidden == st->confirmed_settings.text_hidden;
+    cJSON *root = cJSON_CreateObject();
+    cJSON_AddStringToObject(root, "status", "ok");
+    cJSON_AddStringToObject(root, "persistence", "checked-snapshot");
+    cJSON_AddBoolToObject(root, "enabled", !st->paused && !st->settings.text_hidden);
+    cJSON_AddBoolToObject(root, "text_enabled", !st->settings.text_hidden);
+    cJSON_AddBoolToObject(root, "available", available);
+    cJSON_AddBoolToObject(root, "confirmed", confirmed);
+    cJSON_AddStringToObject(root, "id", confirmed ? st->settings_apply_id : "");
+    cJSON_AddNumberToObject(root, "fields", available ? caps : 0);
+    cJSON_AddStringToObject(root, "time_format", st->settings.time_format);
+    cJSON_AddNumberToObject(root, "font_size", st->settings.font_size);
+    char color[11];
+    snprintf(color, sizeof(color), "0x%08X", st->settings.font_color);
+    cJSON_AddStringToObject(root, "font_color", color);
+    snprintf(color, sizeof(color), "0x%08X", st->settings.stroke_color);
+    cJSON_AddStringToObject(root, "stroke_color", color);
+    snprintf(color, sizeof(color), "0x%08X", st->settings.background_color);
+    cJSON_AddStringToObject(root, "background_color", color);
+    return rss_ctrl_resp_json(resp, size, root);
+}
+
+static bool parse_color_setting(const cJSON *value, uint32_t *color)
+{
+    if (!cJSON_IsString(value) || strlen(value->valuestring) != 10 ||
+        strncmp(value->valuestring, "0x", 2) != 0)
+        return false;
+    uint32_t result = 0;
+    for (int i = 2; i < 10; ++i) {
+        unsigned char ch = (unsigned char)value->valuestring[i];
+        unsigned digit;
+        if (ch >= '0' && ch <= '9') digit = ch - '0';
+        else if (ch >= 'a' && ch <= 'f') digit = ch - 'a' + 10;
+        else if (ch >= 'A' && ch <= 'F') digit = ch - 'A' + 10;
+        else return false;
+        result = result * 16 + digit;
+    }
+    *color = result;
+    return true;
+}
+
+struct font_change {
+    rod_elem_stream_t *stream;
+    int stream_index;
+    int previous_index;
+};
+
+static void finish_fonts(rod_state_t *st, struct font_change *changes, int count, bool commit)
+{
+    for (int i = 0; i < count; ++i) {
+        struct font_change *change = &changes[i];
+        int discard = commit ? change->previous_index : change->stream->font_idx;
+        if (!commit)
+            change->stream->font_idx = change->previous_index;
+        release_font(st, change->stream_index, discard);
+    }
+}
+
+static int prepare_fonts(rod_state_t *st, int size, struct font_change changes[32])
+{
+    int count = 0;
+    if (st->stream_count < 1 || st->stream_count > 2 ||
+        st->elem_count < 0 || st->elem_count > ROD_MAX_ELEMENTS)
+        return -1;
+    for (int i = 0; i < st->elem_count; ++i) {
+        rod_element_t *element = &st->elements[i];
+        if (!element->active || element->font_size > 0)
+            continue;
+        /* Receipt line geometry has a separate lifetime and is not resized. */
+        if (element->type == ROD_ELEM_RECEIPT)
+            goto fail;
+        if (element->type != ROD_ELEM_TEXT)
+            continue;
+        for (int s = 0; s < st->stream_count; ++s) {
+            rod_elem_stream_t *stream = &element->streams[s];
+            if (element->sub_streams_only && s == 0)
+                continue;
+            if (count == 32 || !stream->shm || stream->font_idx < 0 ||
+                stream->font_idx >= ROD_MAX_FONTS)
+                goto fail;
+            int scaled = size;
+            if (s > 0) {
+                if (st->stream_h[0] <= 0 || st->stream_h[s] <= 0)
+                    goto fail;
+                scaled = size * st->stream_h[s] / st->stream_h[0];
+                if (scaled < 12)
+                    scaled = 12;
+            }
+            int index = rod_alloc_font(st, s, scaled);
+            if (index < 0)
+                goto fail;
+            changes[count++] = (struct font_change){stream, s, stream->font_idx};
+            stream->font_idx = index;
+        }
+    }
+    return count;
+fail:
+    finish_fonts(st, changes, count, false);
+    return -1;
+}
+
+int rod_set_settings(rod_state_t *st, const char *json, char *resp, int size)
+{
+    cJSON *root = cJSON_ParseWithOpts(json, NULL, true);
+    cJSON *cmd = cJSON_GetObjectItemCaseSensitive(root, "cmd");
+    cJSON *id = cJSON_GetObjectItemCaseSensitive(root, "id");
+    cJSON *values = cJSON_GetObjectItemCaseSensitive(root, "values");
+    bool valid = cJSON_IsObject(root) && cJSON_GetArraySize(root) == 3 &&
+        cJSON_IsString(cmd) && strcmp(cmd->valuestring, "set-osd-settings") == 0 &&
+        cJSON_IsString(id) && id->valuestring[0] && strlen(id->valuestring) < sizeof(st->settings_apply_id) &&
+        cJSON_IsObject(values) && cJSON_GetArraySize(values) > 0 && cJSON_GetArraySize(values) <= 6;
+    if (valid) {
+        for (const char *p = id->valuestring; *p; ++p) {
+            if (!((*p >= '0' && *p <= '9') || (*p >= 'a' && *p <= 'f')))
+                valid = false;
+        }
+    }
+    rod_config_t previous = st->settings, next = previous;
+    unsigned mask = 0;
+    cJSON *field;
+    cJSON_ArrayForEach(field, values) {
+        unsigned bit = 0;
+        if (field->string && strcmp(field->string, "time_format") == 0) {
+            bit = 1;
+            valid = valid && cJSON_IsString(field) && field->valuestring[0] &&
+                strlen(field->valuestring) < sizeof(next.time_format);
+            if (valid) {
+                const char *text = field->valuestring;
+                size_t length = strlen(text);
+                if (text[0] == ' ' || text[length - 1] == ' ')
+                    valid = false;
+                for (size_t i = 0; valid && i < length; ++i) {
+                    unsigned char ch = (unsigned char)text[i];
+                    if (ch < 0x20 || ch > 0x7e || ch == '#' || ch == ';') valid = false;
+                    if (ch == '%' && (!text[i + 1] || !strchr("YymdHMSFTZzabeIpRjuwf%", text[++i]))) valid = false;
+                }
+                const char *fraction = strstr(text, "%f");
+                if (fraction && (strstr(fraction + 2, "%f") || next.frame_rate < 1 || next.frame_rate > 99))
+                    valid = false;
+                rss_strlcpy(next.time_format, text, sizeof(next.time_format));
+            }
+        } else if (field->string && strcmp(field->string, "font_color") == 0) {
+            bit = 2;
+            valid = valid && parse_color_setting(field, &next.font_color);
+        } else if (field->string && strcmp(field->string, "stroke_color") == 0) {
+            bit = 4;
+            valid = valid && parse_color_setting(field, &next.stroke_color);
+        } else if (field->string && strcmp(field->string, "font_size") == 0) {
+            bit = 8;
+            valid = valid && cJSON_IsNumber(field) &&
+                field->valuedouble >= ROD_TEXT_SIZE_MIN && field->valuedouble <= ROD_TEXT_SIZE_MAX &&
+                field->valuedouble == field->valueint;
+            if (valid)
+                next.font_size = field->valueint;
+        } else if (field->string && strcmp(field->string, "text_enabled") == 0) {
+            bit = 16;
+            valid = valid && cJSON_IsBool(field);
+            if (valid)
+                next.text_hidden = cJSON_IsFalse(field);
+        } else if (field->string && strcmp(field->string, "background_color") == 0) {
+            bit = 32;
+            valid = valid && parse_color_setting(field, &next.background_color);
+        } else valid = false;
+        if (!bit || (mask & bit)) valid = false;
+        mask |= bit;
+    }
+    if (!valid || !mask) {
+        cJSON_Delete(root);
+        return rss_ctrl_resp_error(resp, size, "invalid OSD text settings");
+    }
+    struct text_target targets[32];
+    struct font_change fonts[32];
+    int font_count = (mask & 8) ? prepare_fonts(st, next.font_size, fonts) : 0;
+    if (font_count < 0) {
+        cJSON_Delete(root);
+        return rss_ctrl_resp_error(resp, size, "OSD font contexts unavailable");
+    }
+    unsigned caps = 0;
+    /* Only local parameter storage changes while validating the proposed text.
+     * No bitmap is published or SDK command sent until every target fits. */
+    st->settings = next;
+    int count = collect_targets(st, targets, &caps);
+    st->settings = previous;
+    if (count <= 0 || (caps & mask) != mask || sync_snapshot(targets, count, "0", true) != 0) {
+        finish_fonts(st, fonts, font_count, false);
+        cJSON_Delete(root);
+        return rss_ctrl_resp_error(resp, size, "OSD text targets unavailable or text does not fit");
+    }
+    finish_fonts(st, fonts, font_count, true);
+    st->settings_apply_id[0] = '\0';
+    st->settings = next;
+    if (mask & 1)
+        st->tick_interval = strstr(next.time_format, "%f") ? 1000000 / next.frame_rate : 1000000;
+    for (int i = 0; i < count; ++i) {
+        rod_element_t *e = targets[i].element;
+        rod_elem_stream_t *es = targets[i].stream;
+        uint8_t *pixels = rss_osd_get_draw_buffer(es->shm);
+        if (!pixels) {
+            cJSON_Delete(root);
+            return rss_ctrl_resp_error(resp, size, "OSD draw buffer unavailable");
+        }
+        rod_draw_text_overlay(st, targets[i].index, es->font_idx, pixels, es->width, es->height,
+                      targets[i].text, e->align, e->has_color ? e->color : next.font_color,
+                      e->has_stroke_color ? e->stroke_color : next.stroke_color,
+                      e->stroke_size >= 0 ? e->stroke_size : next.font_stroke);
+        rss_osd_publish(es->shm);
+        es->needs_update = false;
+    }
+    if (sync_snapshot(targets, count, id->valuestring, false) != 0) {
+        cJSON_Delete(root);
+        return rss_ctrl_resp_error(resp, size, "OSD SDK application was not confirmed");
+    }
+    const char *keys[] = {"time_format", "font_color", "stroke_color", "font_size", "text_enabled",
+                  "background_color"};
+    char colors[3][11];
+    snprintf(colors[0], sizeof(colors[0]), "0x%08X", next.font_color);
+    snprintf(colors[1], sizeof(colors[1]), "0x%08X", next.stroke_color);
+    snprintf(colors[2], sizeof(colors[2]), "0x%08X", next.background_color);
+    char font_size[16];
+    snprintf(font_size, sizeof(font_size), "%d", next.font_size);
+    const char *texts[] = {next.time_format, colors[0], colors[1], font_size,
+                          next.text_hidden ? "false" : "true", colors[2]};
+    for (unsigned i = 0; i < 6; ++i) {
+        if (!(mask & (1u << i))) continue;
+        rss_config_set_str(st->cfg, "osd", keys[i], texts[i]);
+        if (strcmp(rss_config_get_str(st->cfg, "osd", keys[i], ""), texts[i]) != 0) {
+            cJSON_Delete(root);
+            return rss_ctrl_resp_error(resp, size, "OSD configuration cache failed");
+        }
+    }
+    st->confirmed_settings = next;
+    rss_strlcpy(st->settings_apply_id, id->valuestring, sizeof(st->settings_apply_id));
+    cJSON_Delete(root);
+    return rss_ctrl_resp_ok(resp, size);
+}
