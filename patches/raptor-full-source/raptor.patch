+/* Raptor listener candidate: explicit loopback binding without IPC ABI changes. */
+#ifndef RAPTOR_LISTENER_H
+#define RAPTOR_LISTENER_H
+
+#include <stdio.h>
+#include <string.h>
+#include <rss_common.h>
+#include <rss_net.h>
+
+/* Only credentialed RTSP may bind all IPv4 interfaces. HTTP remains local. */
+static inline int raptor_listen_config_tcp(rss_config_t *cfg, const char *section,
+                                         int port, int backlog, int nonblocking)
+{
+    if (!cfg || port < 0 || port > 65535 || backlog < 1) {
+        errno = EINVAL;
+        return -1;
+    }
+    const char *address = rss_config_get_str(cfg, section, "bind_address", NULL);
+    bool wildcard = address && strcmp(address, "0.0.0.0") == 0;
+    if (wildcard) {
+        const char *user = rss_config_get_str(cfg, section, "username", "");
+        const char *password = rss_config_get_str(cfg, section, "password", "");
+        if (strcmp(section, "rtsp") != 0 || !user[0] || !password[0]) {
+            errno = EINVAL;
+            return -1;
+        }
+    }
+    int fd;
+    if (!address) {
+        fd = rss_listen_tcp(port, backlog);
+    } else {
+        int family;
+        if (wildcard || strcmp(address, "127.0.0.1") == 0)
+            family = AF_INET;
+        else if (strcmp(address, "::1") == 0)
+            family = AF_INET6;
+        else {
+            errno = EINVAL;
+            return -1;
+        }
+        fd = socket(family, SOCK_STREAM, 0);
+        if (fd < 0)
+            return -1;
+        int one = 1;
+        if (setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one)) < 0)
+            goto failed;
+        if (family == AF_INET) {
+            struct sockaddr_in addr = {
+                .sin_family = AF_INET,
+                .sin_port = htons((uint16_t)port),
+                .sin_addr = {.s_addr = htonl(wildcard ? INADDR_ANY : INADDR_LOOPBACK)},
+            };
+            if (bind(fd, (struct sockaddr *)&addr, sizeof(addr)) < 0)
+                goto failed;
+        } else {
+            /* A selected IPv6 loopback socket must not become dual-stack. */
+            if (setsockopt(fd, IPPROTO_IPV6, IPV6_V6ONLY, &one, sizeof(one)) < 0)
+                goto failed;
+            struct sockaddr_in6 addr = {
+                .sin6_family = AF_INET6,
+                .sin6_port = htons((uint16_t)port),
+                .sin6_addr = IN6ADDR_LOOPBACK_INIT,
+            };
+            if (bind(fd, (struct sockaddr *)&addr, sizeof(addr)) < 0)
+                goto failed;
+        }
+        if (listen(fd, backlog) < 0)
+            goto failed;
+    }
+    if (fd < 0)
+        return -1;
+    if (nonblocking && rss_set_nonblocking(fd) < 0)
+        goto failed;
+    return fd;
+
+failed: {
+        int saved = errno;
+        close(fd);
+        errno = saved;
+        return -1;
+    }
+}
+
+static inline int rhd_listen_tcp(rss_config_t *cfg, int port)
+{
+    return raptor_listen_config_tcp(cfg, "http", port, 8, 0);
+}
+
+static inline int rsd_listen_tcp(rss_config_t *cfg, int port)
+{
+    return raptor_listen_config_tcp(cfg, "rtsp", port, 4, 1);
+}
+
+static inline bool rsd_backchannel_allowed(rss_config_t *cfg)
+{
+    return rss_config_get_bool(cfg, "rtsp", "backchannel", false);
+}
+
+#endif
