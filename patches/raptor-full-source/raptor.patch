diff --git a/tests/test_image_persistence.c b/tests/test_image_persistence.c
new file mode 100644
index 0000000000000000000000000000000000000000..8324d8e65523eeeabe37280261935d4da8f1943b
--- /dev/null
+++ b/tests/test_image_persistence.c
@@ -0,0 +1,560 @@
+#include "rvd.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+static int hardware[15] = {128, 128, 128, 128, 0, 128, 0, 128, 128, 128, 128, 128, 0, 0, 2};
+static int setters, getters, fail_set, fail_get, mismatch;
+static bool sinter_get_notsup, sinter_get_error, sinter_fail_after_set;
+static rss_wb_config_t wb_hardware = {
+    .mode = RSS_WB_AUTO, .r_gain = 128, .g_gain = 0, .b_gain = 128};
+static int wb_setters, wb_getters, wb_fail_set, wb_fail_get, wb_mismatch;
+#define FIELD(index, name) \
+static int set_##name(void *ctx, int value) \
+{ \
+    (void)ctx; \
+    setters++; \
+    if (fail_set) \
+        return RSS_ERR; \
+    hardware[index] = value; \
+    return RSS_OK; \
+} \
+static int get_##name(void *ctx, uint8_t *value) \
+{ \
+    (void)ctx; \
+    getters++; \
+    if (fail_get) \
+        return RSS_ERR; \
+    *value = (uint8_t)(hardware[index] + mismatch); \
+    return RSS_OK; \
+}
+FIELD(0, brightness)
+FIELD(1, contrast)
+FIELD(2, saturation)
+FIELD(3, sharpness)
+FIELD(4, backlight)
+FIELD(5, drc)
+FIELD(6, highlight)
+FIELD(7, defog)
+FIELD(9, hue)
+FIELD(10, dpc)
+#undef FIELD
+static int set_extra(int index, int value)
+{
+    setters++;
+    if (fail_set)
+        return RSS_ERR;
+    hardware[index] = value;
+    return RSS_OK;
+}
+static int set_exposure(void *ctx, int value)
+{
+    (void)ctx;
+    return set_extra(11, value);
+}
+static int set_hflip(void *ctx, int value)
+{
+    (void)ctx;
+    return set_extra(12, value);
+}
+static int set_vflip(void *ctx, int value)
+{
+    (void)ctx;
+    return set_extra(13, value);
+}
+static int get_exposure(void *ctx, int *value)
+{
+    (void)ctx;
+    getters++;
+    if (fail_get)
+        return RSS_ERR;
+    *value = hardware[11] + mismatch;
+    return RSS_OK;
+}
+static int get_flips(void *ctx, int *horizontal, int *vertical)
+{
+    (void)ctx;
+    getters++;
+    if (fail_get)
+        return RSS_ERR;
+    *horizontal = hardware[12] + mismatch;
+    *vertical = hardware[13];
+    return RSS_OK;
+}
+static int set_antiflicker(void *ctx, rss_antiflicker_t value)
+{
+    (void)ctx;
+    return set_extra(14, (int)value);
+}
+static int get_antiflicker(void *ctx, rss_antiflicker_t *value)
+{
+    (void)ctx;
+    getters++;
+    if (fail_get) return RSS_ERR;
+    *value = (rss_antiflicker_t)(hardware[14] + mismatch);
+    return RSS_OK;
+}
+static int set_sinter(void *ctx, int value)
+{
+    (void)ctx;
+    setters++;
+    if (sinter_fail_after_set) {
+        hardware[8] = value;
+        return RSS_ERR;
+    }
+    if (fail_set)
+        return RSS_ERR;
+    hardware[8] = value;
+    return RSS_OK;
+}
+static int get_sinter(void *ctx, uint8_t *value)
+{
+    (void)ctx;
+    getters++;
+    if (sinter_get_notsup)
+        return RSS_ERR_NOTSUP;
+    if (sinter_get_error || fail_get)
+        return RSS_ERR;
+    *value = (uint8_t)(hardware[8] + mismatch);
+    return RSS_OK;
+}
+
+static int get_backlight_notsup(void *ctx, uint8_t *value)
+{
+    (void)ctx;
+    (void)value;
+    getters++;
+    return RSS_ERR_NOTSUP;
+}
+
+static int get_defog_error(void *ctx, uint8_t *value)
+{
+    (void)ctx;
+    (void)value;
+    getters++;
+    return RSS_ERR;
+}
+
+static int set_wb(void *ctx, const rss_wb_config_t *value)
+{
+    (void)ctx;
+    wb_setters++;
+    if (wb_fail_set) return RSS_ERR;
+    wb_hardware = *value;
+    return RSS_OK;
+}
+
+static int get_wb(void *ctx, rss_wb_config_t *value)
+{
+    (void)ctx;
+    wb_getters++;
+    if (wb_fail_get) return RSS_ERR;
+    *value = wb_hardware;
+    if (wb_mismatch) value->r_gain++;
+    return RSS_OK;
+}
+
+static void command(rvd_state_t *st, const char *body, bool ok)
+{
+    char response[2048];
+    assert(rvd_set_imaging(st, body, response, sizeof(response)) > 0);
+    cJSON *root = cJSON_Parse(response);
+    cJSON *status = cJSON_GetObjectItemCaseSensitive(root, "status");
+    assert(cJSON_IsString(status));
+    assert((strcmp(status->valuestring, "ok") == 0) == ok);
+    cJSON_Delete(root);
+}
+
+int main(int argc, char **argv)
+{
+    assert(argc == 2);
+    FILE *file = fopen(argv[1], "w");
+    assert(file);
+    fputs("[sensor]\nantiflicker=2\n[image]\nbrightness=128\ncontrast=128\nsaturation=128\nsharpness=128\n"
+          "backlight_comp=0\ndrc_strength=128\nhighlight_depress=0\n"
+          "defog_strength=128\nsinter=128\n", file);
+    fclose(file);
+    rss_config_t *cfg = rss_config_load(argv[1]);
+    assert(cfg);
+    rss_hal_ops_t ops = {
+        .isp_set_brightness = set_brightness, .isp_get_brightness = get_brightness,
+        .isp_set_contrast = set_contrast, .isp_get_contrast = get_contrast,
+        .isp_set_saturation = set_saturation, .isp_get_saturation = get_saturation,
+        .isp_set_sharpness = set_sharpness, .isp_get_sharpness = get_sharpness,
+        .isp_set_backlight_comp = set_backlight, .isp_get_backlight_comp = get_backlight,
+        .isp_set_drc_strength = set_drc, .isp_get_drc_strength = get_drc,
+        .isp_set_highlight_depress = set_highlight,
+        .isp_get_highlight_depress = get_highlight,
+        .isp_set_defog_strength = set_defog, .isp_get_defog_strength = get_defog,
+        .isp_set_sinter_strength = set_sinter, .isp_get_sinter_strength = get_sinter,
+        .isp_set_hue = set_hue, .isp_get_hue = get_hue,
+        .isp_set_dpc_strength = set_dpc, .isp_get_dpc_strength = get_dpc,
+        .isp_set_ae_comp = set_exposure, .isp_get_ae_comp = get_exposure,
+        .isp_set_hflip = set_hflip, .isp_set_vflip = set_vflip,
+        .isp_get_hvflip = get_flips,
+        .isp_set_antiflicker = set_antiflicker, .isp_get_antiflicker = get_antiflicker,
+        .isp_set_wb = set_wb, .isp_get_wb = get_wb,
+    };
+    rvd_state_t st = {.cfg = cfg, .ops = &ops};
+    hardware[8] = 0;
+    sinter_get_notsup = true;
+    assert(rvd_restore_imaging(&st) == RSS_OK && hardware[8] == 128);
+    assert(st.sinter_config_acknowledged && st.sinter_config_value == 128);
+    sinter_get_notsup = false;
+    setters = 0;
+    getters = 0;
+    wb_setters = 0;
+    wb_getters = 0;
+    const char *invalid[] = {
+        "{\"cmd\":\"set-imaging\",\"values\":{\"brightness\":256}}",
+        "{\"cmd\":\"set-imaging\",\"values\":{\"backlight\":11}}",
+        "{\"cmd\":\"set-imaging\",\"values\":{\"brightness\":1.5}}",
+        "{\"cmd\":\"set-imaging\",\"values\":{\"brightness\":true}}",
+        "{\"cmd\":\"set-imaging\",\"values\":{\"brightness\":140,\"unknown\":1}}",
+        "{\"cmd\":\"set-imaging\",\"values\":{\"hue\":256}}",
+        "{\"cmd\":\"set-imaging\",\"values\":{\"dpc_strength\":-1}}",
+        "{\"cmd\":\"set-imaging\",\"values\":{\"exposure_compensation\":256}}",
+        "{\"cmd\":\"set-imaging\",\"values\":{\"hflip\":2}}",
+        "{\"cmd\":\"set-imaging\",\"values\":{\"vflip\":true}}",
+        "{\"cmd\":\"set-imaging\",\"values\":{\"anti_flicker\":3}}",
+        "{\"cmd\":\"set-imaging\",\"values\":{\"white_balance\":{\"mode\":10,\"rgain\":128,\"bgain\":128}}}",
+        "{\"cmd\":\"set-imaging\",\"values\":{\"white_balance\":{\"mode\":1,\"rgain\":1025,\"bgain\":128}}}",
+        "{\"cmd\":\"set-imaging\",\"values\":{\"white_balance\":{\"mode\":1,\"rgain\":1.5,\"bgain\":128}}}",
+        "{\"cmd\":\"set-imaging\",\"values\":{\"white_balance\":{\"mode\":1,\"rgain\":128}}}",
+        "{\"cmd\":\"set-imaging\",\"values\":{\"white_balance\":{\"mode\":1,\"rgain\":128,\"bgain\":128,\"extra\":0}}}",
+        "{\"cmd\":\"set-imaging\",\"values\":{\"brightness\":140,\"brightness\":150}}",
+        "{\"cmd\":\"set-imaging\",\"sensor\":1,\"values\":{\"brightness\":140}}",
+        "{\"cmd\":\"set-imaging\",\"values\":{}}",
+    };
+    for (size_t i = 0; i < sizeof(invalid) / sizeof(invalid[0]); ++i)
+        command(&st, invalid[i], false);
+    assert(setters == 0 && getters == 0);
+    assert(wb_setters == 0 && wb_getters == 0);
+
+    char wb_response[8192];
+    assert(rvd_get_imaging(&st, wb_response, sizeof(wb_response)) > 0);
+    cJSON *wb_root = cJSON_Parse(wb_response);
+    cJSON *wb = cJSON_GetObjectItemCaseSensitive(wb_root, "white_balance");
+    cJSON *initial_fields = cJSON_GetObjectItemCaseSensitive(wb_root, "fields");
+    cJSON *anti = cJSON_GetObjectItemCaseSensitive(initial_fields, "anti_flicker");
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(anti, "supported")));
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(anti, "available")));
+    assert(cJSON_GetObjectItemCaseSensitive(anti, "observed_value")->valueint == 2);
+    assert(cJSON_GetObjectItemCaseSensitive(anti, "configured_value")->valueint == 2);
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(wb, "supported")));
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(wb, "available")));
+    assert(cJSON_GetObjectItemCaseSensitive(wb, "mode")->valueint == 0);
+    assert(cJSON_IsFalse(cJSON_GetObjectItemCaseSensitive(wb, "gains_effective")));
