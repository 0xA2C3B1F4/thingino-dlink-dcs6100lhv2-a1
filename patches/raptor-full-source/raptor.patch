+    assert(st.enc_tids[0] && st.streams[0].enabled && st.streams[0].fs_enabled);
+    assert(!atomic_load(&st.stream_active[0])); trace[0]=0;
+    assert(rvd_stream_start(&st,0)!=0); expect("");
+    join_error=0; assert(rvd_stream_stop(&st,0)==0); expect("join enc-stop fs-disable ");
+    owned(); enc_stop_error=-8; assert(rvd_stream_stop(&st,0)==-8); expect("join enc-stop ");
+    assert(!st.enc_tids[0] && st.streams[0].enabled && st.streams[0].fs_enabled);
