+        assert(rvd_stream_stop(&st,0)!=0); expect("join ");
+        trace[0]=0; assert(rvd_stream_stop(&st,0)!=0); assert(rvd_stream_start(&st,0)!=0); expect("");
+    }
+    owned(); st.stream_count=2; st.streams[1].is_jpeg=true; st.enc_tids[1]=(pthread_t)(uintptr_t)1;
+    assert(rvd_stream_stop(&st,0)!=0); expect("join enc-stop "); assert(st.streams[0].fs_enabled);
+    assert(rvd_stream_stop(&st,1)==0); trace[0]=0; assert(rvd_stream_stop(&st,0)==0); expect("fs-disable ");
+    reset(); assert(rvd_stream_start(&st,0)==0); expect("privacy fs-enable enc-start create ");
+    assert(st.enc_tids[0] && st.streams[0].enabled && st.streams[0].fs_enabled);
+    reset(); privacy_error=-7; assert(rvd_stream_start(&st,0)==-7); expect("privacy ");
+    reset(); fs_enable_error=-4; assert(rvd_stream_start(&st,0)==-4); expect("privacy fs-enable ");
+    assert(st.streams[0].fs_start_uncertain && !st.streams[0].fs_enabled && shutdowns==1);
+    trace[0]=0; assert(rvd_stream_stop(&st,0)!=0); expect("");
+    reset(); enc_start_error=-5; assert(rvd_stream_start(&st,0)==-5); expect("privacy fs-enable enc-start ");
+    assert(st.streams[0].enc_start_uncertain && st.streams[0].fs_enabled && !st.streams[0].enabled);
+    trace[0]=0; assert(rvd_stream_stop(&st,0)!=0); expect("");
+    for (int failure=0; failure<3; failure++) {
+        reset(); if (failure==0) create_error=11; else if (failure==1) attr_error=11; else size_error=11;
+        assert(rvd_stream_start(&st,0)!=0); assert(!st.enc_tids[0] && !st.streams[0].enabled && !st.streams[0].fs_enabled);
+        assert(strstr(trace,"enc-stop fs-disable "));
+    }
+    reset(); create_error=11; enc_stop_error=-8; assert(rvd_stream_start(&st,0)==-8);
+    assert(!st.enc_tids[0] && st.streams[0].enabled && st.streams[0].fs_enabled);
+    trace[0]=0; enc_stop_error=0; assert(rvd_stream_stop(&st,0)==0); expect("enc-stop fs-disable ");
+    reset(); create_error=11; fs_disable_error=-9; assert(rvd_stream_start(&st,0)==-9);
+    assert(!st.enc_tids[0] && !st.streams[0].enabled && st.streams[0].fs_enabled);
+    trace[0]=0; fs_disable_error=0; assert(rvd_stream_stop(&st,0)==0); expect("fs-disable ");
+    reset(); st.streams[0].is_jpeg=st.streams[0].jpeg_idle=true;
+    assert(rvd_stream_start(&st,0)!=0); expect(""); /* No video owner. */
+    st.stream_count=2; st.streams[1].fs_enabled=true; st.enc_tids[1]=(pthread_t)(uintptr_t)1;
+    atomic_store(&st.stream_active[1],true);
