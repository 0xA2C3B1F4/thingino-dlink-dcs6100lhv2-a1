@@ -0,0 +1,62 @@
+#include "rvd.h"
+#include <assert.h>
+#include <string.h>
+#include <stdio.h>
+static int fail_call, calls, transport;
+static bool configured;
+static const char *wire;
+static int next(void) { return ++calls == fail_call ? -7 : 0; }
+static int u8(void *ctx, uint8_t *value) { (void)ctx; *value = 42; return next(); }
+static int u32(void *ctx, uint32_t *value) { (void)ctx; *value = 42; return next(); }
+static int integer(void *ctx, int *value) { (void)ctx; *value = 42; return next(); }
+static int flip(void *ctx, int *h, int *v) { (void)ctx; *h = *v = 0; return next(); }
+static int wb(void *ctx, rss_wb_config_t *value) { (void)ctx; memset(value, 0, sizeof(*value)); return next(); }
+bool rss_config_get_bool(rss_config_t *cfg, const char *section, const char *key, bool fallback)
+{ (void)cfg; (void)section; (void)key; (void)fallback; return configured; }
+int rss_ctrl_send_command(const char *path, const char *command, char *response, int capacity, uint32_t timeout)
+{
+    (void)path; (void)command; assert(timeout == 250);
+    if (transport < 0) return transport;
+    snprintf(response, capacity, "%s", wire);
+    return (int)strlen(response);
+}
+int main(int argc, char **argv)
+{
+    assert(argc == 2);
+    rss_hal_ops_t ops = {
+        .isp_get_brightness=u8, .isp_get_contrast=u8, .isp_get_saturation=u8,
+        .isp_get_sharpness=u8, .isp_get_hue=u8, .isp_get_sinter_strength=u8,
+        .isp_get_temper_strength=u8, .isp_get_hvflip=flip, .isp_get_ae_comp=integer,
+        .isp_get_max_again=u32, .isp_get_max_dgain=u32, .isp_get_dpc_strength=u8,
+        .isp_get_drc_strength=u8, .isp_get_highlight_depress=u8,
+        .isp_get_backlight_comp=u8, .isp_get_defog_strength=u8, .isp_get_wb=wb,
+    };
+    rvd_state_t st = {0}; st.ops = &ops;
+    char response[2048];
+    for (fail_call = 1; fail_call <= 17; fail_call++) {
+        calls = 0;
+        assert(rvd_get_isp(&st, response, sizeof(response)) > 0);
+        assert(strstr(response, "\"status\":\"error\""));
+    }
+    fail_call = calls = 0;
+    rvd_get_isp(&st, response, sizeof(response));
+    assert(strstr(response, "\"brightness\":42"));
+    calls = 0; fail_call = 1;
+    rvd_get_imaging(&st, response, sizeof(response));
+    cJSON *imaging = cJSON_Parse(response);
+    cJSON *fields = cJSON_GetObjectItem(imaging, "fields");
+    cJSON *brightness = cJSON_GetObjectItem(fields, "brightness");
+    assert(cJSON_IsTrue(cJSON_GetObjectItem(brightness, "supported")));
+    assert(cJSON_IsFalse(cJSON_GetObjectItem(brightness, "available")));
+    assert(cJSON_IsNull(cJSON_GetObjectItem(brightness, "value")));
+    cJSON_Delete(imaging);
+    configured = false;
+    assert(rvd_privacy_participant(&st, "audio", argv[1], "{}") == 1);
+    configured = true; transport = -1;
+    assert(rvd_privacy_participant(&st, "audio", argv[1], "{}") < 0);
+    transport = 0; wire = "{\"status\":\"error\"}";
+    assert(rvd_privacy_participant(&st, "audio", argv[1], "{}") < 0);
+    wire = "{\"status\":\"ok\"}";
+    assert(rvd_privacy_participant(&st, "audio", argv[1], "{}") == 0);
+    puts("ISP getter and privacy participant failure tests passed");
+}
diff --git a/tests/test_recorder_maintenance.c b/tests/test_recorder_maintenance.c
new file mode 100644
index 0000000000000000000000000000000000000000..72a2e3244eb1b6c9decb34fb6127f7b18b9fa6cd
--- /dev/null
+++ b/tests/test_recorder_maintenance.c
@@ -0,0 +1,139 @@
+#include "rmr.h"
+#include "rmr_sd.h"
+#include <assert.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+static atomic_bool entered, release_io, exited;
+static atomic_uint probes, scans;
+static bool block_probe;
+
+int rmr_sd_free_mb(uint64_t *free_mb)
+{
+	atomic_fetch_add(&probes, 1);
+	if (block_probe) {
+		atomic_store(&entered, true);
+		while (!atomic_load(&release_io))
+			usleep(1000);
+		atomic_store(&exited, true);
+	}
+	*free_mb = 100;
+	return 0;
+}
+
+int rmr_sd_retention_step(unsigned channel, unsigned limit, uint64_t minimum,
+                         rmr_sd_progress_fn progress, void *opaque)
+{
+	assert(channel == 1 && limit == 15 && minimum == 1);
+	atomic_fetch_add(&scans, 1);
+	atomic_store(&entered, true);
+	while (!atomic_load(&release_io))
+		usleep(1000);
+	/* Destroy/policy change must revoke the paused scan before any deletion. */
+	assert(!progress(opaque));
+	atomic_store(&exited, true);
+	return -1;
+}
+
+unsigned rmr_writer_active(void) { return 0; }
+unsigned rmr_writer_errors(void) { return 0; }
+uint64_t rmr_writer_written(void) { return 0; }
+void rss_ring_request_idr(rss_ring_t *ring) { assert(ring); }
+
+int main(int argc, char **argv)
+{
+	assert(argc == 2);
+	block_probe = !strcmp(argv[1], "space");
+	rmr_storage_config_t config = {.base_path = "/mnt/mmcblk0p1/raptor/stream1",
+		.managed_sd = true, .channel = 1};
+	rmr_storage_t *storage = rmr_storage_create(&config);
+	assert(storage);
+	rmr_policy_t policy = {.cleanup_enabled = true, .duration = 300, .limit = 15,
+		.min_free_mb = 1, .check_interval = 60};
+	rmr_storage_set_policy(storage, &policy);
+	int64_t until = rss_timestamp_us() + 2000000;
+	while (!atomic_load(&entered) && rss_timestamp_us() < until)
+		usleep(1000);
+	assert(atomic_load(&entered));
+	rmr_state_t state = {.managed = true, .stream_idx = 1, .video_ring = (void *)1,
+		.storage = storage, .policy = policy};
+	char response[1024];
+	int64_t maximum = 0;
+	unsigned frames = 0;
+	until = rss_timestamp_us() + 2800000;
+	while (rss_timestamp_us() < until) {
+		int64_t start = rss_timestamp_us();
+		rmr_managed_service(&state);
+		rmr_managed_command(&state, "{\"cmd\":\"get-recording-state\"}", response, sizeof(response));
+		cJSON *reply = cJSON_Parse(response);
+		assert(reply && !strcmp(cJSON_GetObjectItem(reply, "status")->valuestring, "ok"));
+		if (block_probe || rss_timestamp_us() > until - 200000)
+			assert(!strcmp(cJSON_GetObjectItem(reply, "reason")->valuestring, "storage_unknown"));
+		cJSON_Delete(reply);
+		rmr_managed_command(&state, "{\"cmd\":\"set-recording\",\"enabled\":false}", response, sizeof(response));
+		assert(!atomic_load(&state.recording));
+		int64_t elapsed = rss_timestamp_us() - start;
+		if (elapsed > maximum)
+			maximum = elapsed;
+		++frames; /* Main-loop frame work remains schedulable while worker I/O is blocked. */
+		usleep(1000);
+	}
+	assert(frames > 100 && maximum < 100000);
+	assert(atomic_load(&probes) == 1); /* Status/frame reads do not repeat statvfs. */
+	assert(atomic_load(&scans) == (block_probe ? 0U : 1U));
+	assert(rmr_managed_maintenance_command(&state,
+		"{\"cmd\":\"set-storage-maintenance\",\"paused\":true}", response,
+		sizeof(response)) > 0);
+	cJSON *maintenance = cJSON_Parse(response);
+	assert(maintenance && cJSON_IsTrue(cJSON_GetObjectItem(maintenance, "paused")));
+	assert(cJSON_IsFalse(cJSON_GetObjectItem(maintenance, "quiescent")));
+	cJSON_Delete(maintenance); /* Blocked probe/retention cannot acknowledge. */
+	bool paused = false, quiescent = false;
+	unsigned probes_before_pause = atomic_load(&probes);
+	unsigned scans_before_pause = atomic_load(&scans);
+	atomic_store(&release_io, true);
+	until = rss_timestamp_us() + 2000000;
+	while (!atomic_load(&exited) && rss_timestamp_us() < until)
+		usleep(1000);
+	assert(atomic_load(&exited));
+	until = rss_timestamp_us() + 2000000;
+	do {
+		assert(rmr_managed_maintenance_command(
+			&state, "{\"cmd\":\"get-storage-maintenance\"}", response,
+			sizeof(response)) > 0);
+		maintenance = cJSON_Parse(response);
+		assert(maintenance);
+		paused = cJSON_IsTrue(cJSON_GetObjectItem(maintenance, "paused"));
+		quiescent = cJSON_IsTrue(cJSON_GetObjectItem(maintenance, "quiescent"));
+		cJSON_Delete(maintenance);
+		if (paused && quiescent)
+			break;
+		usleep(1000);
+	} while (rss_timestamp_us() < until);
+	assert(paused && quiescent);
+	usleep(200000);
+	assert(atomic_load(&probes) == probes_before_pause);
+	assert(atomic_load(&scans) == scans_before_pause);
+	unsigned probes_before_resume = atomic_load(&probes);
+	assert(rmr_managed_maintenance_command(&state,
+		"{\"cmd\":\"set-storage-maintenance\",\"paused\":false}", response,
+		sizeof(response)) > 0);
+	maintenance = cJSON_Parse(response);
+	assert(maintenance && cJSON_IsFalse(cJSON_GetObjectItem(maintenance, "paused")));
+	assert(cJSON_IsFalse(cJSON_GetObjectItem(maintenance, "quiescent")));
+	cJSON_Delete(maintenance);
+	bool mounted = false, cleanup_ok = false;
+	uint64_t free_mb = 0;
+	bool fresh = rmr_storage_observe(storage, &mounted, &free_mb, &cleanup_ok);
+	assert(!fresh || atomic_load(&probes) > probes_before_resume);
+	int64_t start = rss_timestamp_us();
+	rmr_storage_destroy(storage);
+	assert(rss_timestamp_us() - start < 100000);
+	usleep(200000); /* Detached worker releases its own reference after cancellation. */
+	printf("Blocked %s I/O: %u control/frame iterations, max status/stop %lld us; one space probe\n",
+		argv[1], frames, (long long)maximum);
+	return 0;
+}
diff --git a/tests/test_recorder_policy.c b/tests/test_recorder_policy.c
new file mode 100644
index 0000000000000000000000000000000000000000..fa71812269af2ef59aaa39759e588ba91ca70034
--- /dev/null
+++ b/tests/test_recorder_policy.c
@@ -0,0 +1,41 @@
+#include "rmr_policy.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+int main(int argc, char **argv)
+{
+	assert(argc == 2);
+	FILE *file = fopen(argv[1], "w");
+	assert(file);
+	assert(fputs("[recorder0]\nduration = 300\n[recorder1]\nduration = 900\n", file) >= 0);
+	assert(fclose(file) == 0);
+	rss_config_t *main = rss_config_load(argv[1]);
+	rss_config_t *sub = rss_config_load(argv[1]);
+	assert(main && sub);
+	rmr_policy_t a, b;
+	assert(rmr_policy_load(main, 0, &a) == 0 && a.duration == 300 && !a.autostart);
+	assert(rmr_policy_load(sub, 1, &b) == 0 && b.duration == 900);
+	a.duration = 600;
+	a.autostart = true;
+	b.limit = 7;
+	rmr_policy_store(main, 0, &a);
+	rmr_policy_store(sub, 1, &b);
+	assert(rss_config_save(main, argv[1]) == 0);
+	assert(rss_config_save(sub, argv[1]) == 0);
+	rss_config_t *disk = rss_config_load(argv[1]);
+	assert(disk);
+	assert(rmr_policy_load(disk, 0, &a) == 0 && a.duration == 600 && a.autostart);
+	assert(rmr_policy_load(disk, 1, &b) == 0 && b.duration == 900 && b.limit == 7);
+	const char *invalid[] = {"+600", " 600", "0", "86401", "1.5", "-1", ""};
+	for (unsigned i = 0; i < sizeof(invalid) / sizeof(invalid[0]); ++i) {
+		rss_config_set_str(disk, "recorder0", "duration", invalid[i]);
+		assert(rmr_policy_load(disk, 0, &a) != 0);
+		assert(rmr_policy_load(disk, 1, &b) == 0 && b.duration == 900);
+	}
+	rss_config_free(disk);
+	rss_config_free(main);
+	rss_config_free(sub);
+	puts("Recorder policy strict parsing and independent owner disk merge passed");
+	return 0;
+}
diff --git a/tests/test_restart_init_start.c b/tests/test_restart_init_start.c
new file mode 100644
index 0000000000000000000000000000000000000000..48b8626ff1f72fccc907b5a63e17e91dc275ff0b
--- /dev/null
+++ b/tests/test_restart_init_start.c
@@ -0,0 +1,645 @@
+#include "rvd.h"
+#include "native_fps_unused.h"
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static int test_create(pthread_t *, const pthread_attr_t *, void *(*)(void *), void *);
+static int test_join(pthread_t, void **);
+#define pthread_create test_create
+#define pthread_join test_join
+#include "../rvd/rvd_ctrl.c"
+#include "../rvd/rvd_ivs.c"
+#undef pthread_create
+#undef pthread_join
+
+static char sequence[256];
+static const char *fail_at;
+static bool without_ring;
+static void record(const char *step);
+static bool own_ivs;
+static bool fail_join;
+static bool fail_stop;
+static bool fail_resume;
+static bool fail_create;
+static bool fail_stop_after_start;
+static bool uncertain_on_start;
+static int interface_handle;
+static rvd_state_t *current_state;
+static rss_ring_header_t video_header;
+static rss_hal_caps_t codec_caps = {.has_h265 = true};
+static bool fail_codec_read;
+static bool wrong_profile_after_init;
+
+rss_ring_t *rss_ring_open(const char *name) { (void)name; abort(); }
+void rss_ring_close(rss_ring_t *ring) { (void)ring; abort(); }
+void rss_ring_acquire(rss_ring_t *ring) { (void)ring; abort(); }
+void rss_ring_release(rss_ring_t *ring) { (void)ring; abort(); }
+uint32_t rss_ring_max_frame_size(rss_ring_t *ring) { (void)ring; abort(); }
+int rss_ring_wait(rss_ring_t *ring, uint32_t timeout_ms) { (void)ring; (void)timeout_ms; abort(); }
+int rss_ring_read(rss_ring_t *ring, uint64_t *sequence, uint8_t *data, uint32_t capacity,
+                  uint32_t *length, rss_ring_slot_t *metadata)
+{ (void)ring; (void)sequence; (void)data; (void)capacity; (void)length; (void)metadata; abort(); }
+rvd_osd_region_t *rvd_osd_find_region(rvd_state_t *st, int stream, const char *name)
+{ (void)st; (void)stream; (void)name; abort(); }
+void rvd_osd_calc_position(int sw, int sh, int rw, int rh, const char *position, int *x, int *y)
+{ (void)sw; (void)sh; (void)rw; (void)rh; (void)position; (void)x; (void)y; abort(); }
+int rvd_osd_apply_snapshot(rvd_state_t *st, const char *json, char *response, int size)
+{ (void)st; (void)json; (void)response; (void)size; abort(); }
+int rvd_osd_apply_state(rvd_state_t *st, char *response, int size)
+{ (void)st; (void)response; (void)size; abort(); }
+
+const rss_ring_header_t *rss_ring_get_header(rss_ring_t *ring)
+{
+    assert(ring == (rss_ring_t *)(uintptr_t)1);
+    return &video_header;
+}
+
+static const rss_hal_caps_t *get_caps(void *ctx)
+{
+    (void)ctx;
+    return &codec_caps;
+}
+
+static int get_video_attr(void *ctx, int channel, rss_video_config_t *out)
+{
+    (void)ctx;
+    assert(channel == 7);
+    if (fail_codec_read) return RSS_ERR;
+    *out = current_state->streams[1].enc_cfg;
+    return RSS_OK;
+}
+
+static void retained(const rvd_state_t *st)
+{
+    assert(st->ivs_group_created);
+    assert(st->ivs_channel_created);
+    assert(st->ivs_registered);
+    assert(st->ivs_bound);
+    assert(st->ivs_algo_handle == &interface_handle);
+}
+
+static int sdk_stop(void *ctx, int channel)
+{
+    (void)ctx;
+    rvd_state_t *st = current_state;
+    assert(channel == st->ivs_chn);
+    assert(!atomic_load(&st->ivs_active));
+    assert(st->ivs_tid == 0);
+    retained(st);
+    record("ivs-stop");
+    return fail_stop ? -12 : RSS_OK;
+}
+
+static int sdk_start(void *ctx, int channel)
+{
+    (void)ctx;
+    rvd_state_t *st = current_state;
+    assert(channel == st->ivs_chn);
+    retained(st);
+    record("ivs-start");
+    if (fail_stop_after_start)
+        fail_stop = true;
+    return fail_resume ? -13 : RSS_OK;
+}
+
+static void record(const char *step)
+{
+    assert(strlen(sequence) + strlen(step) + 2 < sizeof(sequence));
+    if (sequence[0])
+        strcat(sequence, " ");
+    strcat(sequence, step);
+}
+
+static int test_create(pthread_t *thread, const pthread_attr_t *attr,
+                       void *(*entry)(void *), void *arg)
+{
+    (void)attr;
+    assert(entry == rvd_ivs_thread);
+    rvd_state_t *st = arg;
+    assert(st->ivs_receiving);
+    record("ivs-thread");
+    if (fail_create)
+        return 11;
+    *thread = (pthread_t)(uintptr_t)1;
+    return 0;
+}
+
+static int test_join(pthread_t thread, void **result)
+{
+    (void)thread;
+    (void)result;
+    record("ivs-join");
+    return fail_join ? 11 : 0;
+}
+
+int rvd_stream_stop(rvd_state_t *st, int index)
+{
+    assert(index == 0 || index == 1 || index == 3);
+    if (own_ivs)
+        retained(st);
+    const char *step = index == 1 ? "video-stop" : "jpeg-stop";
+    record(step);
+    if (fail_at && strcmp(fail_at, step) == 0)
+        return -9;
+    st->streams[index].enabled = false;
+    atomic_store(&st->stream_active[index], false);
+	return RSS_OK;
+}
+
+void rvd_stream_deinit(rvd_state_t *st, int index)
+{
+    assert(index == 0 || index == 1 || index == 3);
+    if (own_ivs)
+        retained(st);
+    record(index == 1 ? "video-deinit" : "jpeg-deinit");
+    st->streams[index].ring = NULL;
+}
+
+int rvd_stream_init(rvd_state_t *st, int index)
+{
+    assert(index == 0 || index == 1 || index == 3);
+    if (own_ivs)
+        retained(st);
+    if (own_ivs)
+        assert(!atomic_load(&st->ivs_active));
+    const char *step = index == 1 ? "video-init" : "jpeg-init";
+    record(step);
+    if (fail_at && strcmp(fail_at, step) == 0)
+        return -7;
+    if (!(without_ring && index == 3))
+        st->streams[index].ring = (rss_ring_t *)(uintptr_t)1;
+    if (index == 1) {
+        video_header.codec = st->streams[index].enc_cfg.codec;
+        video_header.width = st->streams[index].enc_cfg.width;
+        video_header.height = st->streams[index].enc_cfg.height;
+        video_header.profile = stream_h264_profile_idc(st->streams[index].enc_cfg.profile);
+        if (wrong_profile_after_init)
+            video_header.profile++;
+    }
+    return RSS_OK;
+}
+
+int rvd_stream_start(rvd_state_t *st, int index)
+{
+    assert(index == 0 || index == 1 || index == 3);
+    if (own_ivs)
+        retained(st);
+    if (own_ivs)
+        assert(!atomic_load(&st->ivs_active));
+    const char *step = index == 1 ? "video-start" : "jpeg-start";
+    record(step);
+    if (fail_at && strcmp(fail_at, step) == 0)
+        return -8;
+    st->streams[index].enabled = true;
+    atomic_store(&st->stream_active[index], true);
+    if (uncertain_on_start && index == 3)
+        st->ivs_roi_uncertain = true;
+    return RSS_OK;
+}
+
+static void setup(rvd_state_t *st, bool jpeg, bool ivs)
+{
+    memset(st, 0, sizeof(*st));
+    static const rss_hal_ops_t ops = {
+        .ivs_stop = sdk_stop, .ivs_start = sdk_start,
+        .get_caps = get_caps, .enc_get_channel_attr = get_video_attr,
+    };
+    st->ops = &ops;
+    current_state = st;
+    st->ivs_group_created = true;
+    st->ivs_channel_created = true;
+    st->ivs_registered = true;
+    st->ivs_bound = true;
+    st->ivs_algo_handle = &interface_handle;
+    sequence[0] = 0;
+    own_ivs = ivs;
+    st->stream_count = 4;
+    st->streams[1].chn = 7;
+    st->streams[1].fs_chn = 5;
+    st->streams[1].enc_cfg.width = 640;
+    st->streams[1].enc_cfg.height = 360;
+    st->streams[1].enc_cfg.codec = RSS_CODEC_H264;
+    st->streams[1].enc_cfg.fps_num = 15;
+    st->streams[1].enc_cfg.fps_den = 1;
+    st->streams[1].enc_cfg.gop_length = 30;
+    st->streams[1].enc_cfg.profile = 2;
+    strcpy(st->streams[1].cfg_sect, "stream0");
+    st->streams[1].sensor_idx = 0;
+    st->streams[1].enabled = true;
+    st->streams[1].ring = (rss_ring_t *)(uintptr_t)1;
+    atomic_store(&st->stream_active[1], true);
+    video_header.codec = RSS_CODEC_H264;
+    video_header.width = 640;
+    video_header.height = 360;
+    video_header.profile = 100;
+    st->streams[3].is_jpeg = true;
+    st->streams[3].fs_chn = 5;
+    st->jpeg_count = jpeg ? 2 : 0;
+    st->jpeg_streams[0] = -1;
+    st->jpeg_streams[1] = 3;
+    st->ivs_fs_chn = ivs ? 5 : 99;
+    atomic_store(&st->ivs_active, true);
+    st->ivs_receiving = true;
+    st->ivs_tid = (pthread_t)(uintptr_t)1;
+}
+
+int main(int argc, char **argv)
+{
+    assert(argc == 2);
+    rvd_state_t st;
+    char response[256];
+    for (int which = 0; which < 2; which++) {
+        setup(&st, true, true);
+        fail_at = which ? "video-stop" : "jpeg-stop";
+        assert(do_stream_restart(&st, 1, response, sizeof(response)) > 0);
+        assert(strcmp(sequence, which ? "ivs-join ivs-stop jpeg-stop video-stop" :
+                                       "ivs-join ivs-stop jpeg-stop") == 0);
+        assert(!atomic_load(&st.ivs_active) && !st.ivs_receiving && !st.ivs_tid);
