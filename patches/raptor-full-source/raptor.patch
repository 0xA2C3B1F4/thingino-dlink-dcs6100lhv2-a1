+static size_t mapping_size;
+static char trace[512];
+static int create_error;
+static int verify_error;
+static int register_error;
+static int destroy_error;
+static int unlink_count;
+
+static void record(const char *step)
+{
+    assert(strlen(trace) + strlen(step) + 2 < sizeof(trace));
+    if (trace[0]) strcat(trace, " ");
+    strcat(trace, step);
+}
+
+static int test_shm_unlink(const char *name)
+{
+    assert(strcmp(name, "/rss_enc_main") == 0);
+    record(unlink_count++ ? "shm-unlink-release" : "shm-unlink-open");
+    return 0;
+}
+
+static int test_shm_open(const char *name, int flags, ...)
+{
+    (void)flags;
+    assert(strcmp(name, "/rss_enc_main") == 0);
+    record("shm-open");
+    return 9;
+}
+
+static int test_ftruncate(int fd, off_t length)
+{
+    assert(fd == 9 && length > 0);
+    mapping_size = (size_t)length;
+    record("shm-size");
+    return 0;
+}
+
+static void *test_mmap(void *addr, size_t length, int prot, int flags, int fd,
+                       off_t offset)
+{
+    (void)addr; (void)prot; (void)flags;
+    assert(length == mapping_size && fd == 9 && offset == 0);
+    record("shm-map");
+    return mapping;
+}
+
+static int test_munmap(void *addr, size_t length)
+{
+    assert(addr == mapping && length == mapping_size);
+    record("shm-unmap");
+    return 0;
+}
+
+static int test_close(int fd)
+{
+    assert(fd == 9);
+    record("shm-close");
+    return 0;
+}
+
+static int create_group(void *ctx, int group)
+{
+    (void)ctx; assert(group == 7); record("group-create"); return RSS_OK;
+}
+
+static int destroy_group(void *ctx, int group)
+{
+    (void)ctx; assert(group == 7); record("group-destroy"); return RSS_OK;
+}
+
+static int inject_shm(void *ctx, int channel, void *addr, uint32_t size)
+{
+    (void)ctx;
+    assert(channel == 7 && addr == mapping && size == mapping_size);
+    record("shm-inject");
+    return RSS_OK;
+}
+
+static int create_channel(void *ctx, int channel, const rss_video_config_t *cfg)
+{
+    (void)ctx;
+    assert(channel == 7 && cfg == &state.streams[0].enc_cfg);
+    record("channel-create");
+    return create_error;
+}
+
+static int destroy_channel(void *ctx, int channel)
+{
+    (void)ctx; assert(channel == 7); record("channel-destroy");
+    return destroy_error;
+}
+
+static int register_channel(void *ctx, int group, int channel)
+{
+    (void)ctx; assert(group == 7 && channel == 7); record("channel-register");
+    return register_error;
+}
+
+int rvd_stream_gop_prepare(rvd_state_t *st, rvd_stream_t *stream)
+{
+    (void)st; (void)stream; record("gop-prepare"); return RSS_OK;
+}
+
+int rvd_stream_gop_verify(rvd_state_t *st, rvd_stream_t *stream)
+{
+    (void)st; (void)stream; record("gop-verify"); return RSS_OK;
+}
+
+int rvd_stream_rc_config_verify(rvd_state_t *st, rvd_stream_t *stream)
+{
+    (void)st; (void)stream; record("rc-verify"); return verify_error;
+}
+
+void rvd_osd_init_stream(rvd_state_t *st, int index) { (void)st; (void)index; }
+void rvd_osd_deinit_stream(rvd_state_t *st, int index) { (void)st; (void)index; }
+int rvd_privacy_prepare_stream(rvd_state_t *st, int index)
+{ (void)st; (void)index; return RSS_OK; }
+
+rss_ring_t *rss_ring_create(const char *name, uint32_t slots, uint32_t data_size)
+{ (void)name; (void)slots; (void)data_size; return NULL; }
+void rss_ring_set_stream_info(rss_ring_t *ring, uint32_t id, uint32_t codec,
+                              uint32_t width, uint32_t height, uint32_t fps_num,
+                              uint32_t fps_den, uint8_t profile, uint8_t level)
+{ (void)ring; (void)id; (void)codec; (void)width; (void)height; (void)fps_num;
+  (void)fps_den; (void)profile; (void)level; }
+int rss_ring_enable_refmode(rss_ring_t *ring, uint32_t size, uint32_t offset,
+                            uint8_t count, uint32_t stride)
+{ (void)ring; (void)size; (void)offset; (void)count; (void)stride; return RSS_OK; }
+
+static void reset(void)
+{
+    memset(&state, 0, sizeof(state));
+    memset(&ops, 0, sizeof(ops));
+    trace[0] = '\0';
+    create_error = verify_error = register_error = destroy_error = unlink_count = 0;
+    mapping_size = 0;
+    ops.enc_create_group = create_group;
+    ops.enc_destroy_group = destroy_group;
+    ops.enc_inject_stream_shm = inject_shm;
+    ops.enc_create_channel = create_channel;
+    ops.enc_destroy_channel = destroy_channel;
+    ops.enc_register_channel = register_channel;
+    state.ops = &ops;
+    state.stream_count = 1;
+    state.refmode = true;
+    state.refmode_shm = true;
+    state.enc_shm_fd[0] = -1;
+    state.streams[0].chn = 7;
+    state.streams[0].fs_chn = 0;
+    state.streams[0].enc_cfg.codec = RSS_CODEC_H264;
+    state.streams[0].enc_cfg.width = 128;
+    state.streams[0].enc_cfg.height = 64;
+}
+
+int main(void)
+{
+    reset();
+    create_error = -11;
+    assert(rvd_stream_init(&state, 0) == -11);
+    assert(strcmp(trace, "gop-prepare group-create shm-unlink-open shm-open shm-size "
+                         "shm-map shm-inject shm-close channel-create shm-unmap "
+                         "shm-unlink-release group-destroy") == 0);
+    assert(state.enc_shm_addr[0] == NULL && state.enc_shm_size[0] == 0);
+
+    reset();
+    verify_error = RSS_ERR;
+    assert(rvd_stream_init(&state, 0) == RSS_ERR);
+    assert(strcmp(trace, "gop-prepare group-create shm-unlink-open shm-open shm-size "
+                         "shm-map shm-inject shm-close channel-create gop-verify "
+                         "rc-verify channel-destroy shm-unmap shm-unlink-release "
+                         "group-destroy") == 0);
+    assert(state.enc_shm_addr[0] == NULL && state.enc_shm_size[0] == 0);
+
+    reset();
+    register_error = RSS_ERR;
+    assert(rvd_stream_init(&state, 0) == RSS_ERR);
+    assert(strcmp(trace, "gop-prepare group-create shm-unlink-open shm-open shm-size "
+                         "shm-map shm-inject shm-close channel-create gop-verify "
+                         "rc-verify channel-register channel-destroy shm-unmap "
+                         "shm-unlink-release group-destroy") == 0);
+    assert(state.enc_shm_addr[0] == NULL && state.enc_shm_size[0] == 0);
+
+    reset();
+    verify_error = RSS_ERR;
+    destroy_error = -17;
+    assert(rvd_stream_init(&state, 0) == -17);
+    assert(strstr(trace, "rc-verify channel-destroy") != NULL);
+    assert(strstr(trace, "shm-unmap") == NULL && strstr(trace, "group-destroy") == NULL);
+    assert(state.enc_shm_addr[0] == mapping && state.enc_shm_size[0] == mapping_size);
+    trace[0] = '\0';
+    assert(rvd_stream_init(&state, 0) == RSS_ERR);
+    assert(strcmp(trace, "") == 0);
+    assert(state.enc_shm_addr[0] == mapping && state.enc_shm_size[0] == mapping_size);
+
+    puts("stream init verification ownership checks passed");
+    return 0;
+}
