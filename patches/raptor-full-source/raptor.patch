+    ao_thread_ctx_t worker = {.ops = &ops, .running = &running, .completed = true};
+    playback = &worker;
+    pthread_t thread;
+    bool started = false;
+    rad_ctrl_ctx_t owner = {
+        .cfg = cfg, .ops = &ops, .ao_ctx = &worker, .ao_tid = &thread,
+        .ao_thread_started = &started, .ao_volume = 10, .ao_gain = 10,
+    };
+    assert(rad_output_start(&owner, 16000) == RSS_OK);
+    wait_count(&send_calls, 1);
+    wait_count(&closed, 2);
+    assert(send_calls == 1);
+
+    atomic_store(&frame_timestamp, rss_timestamp_us());
+    atomic_fetch_add(&header.incarnation, 1);
+    wait_count(&send_calls, 2);
+    wait_count(&closed, atomic_load(&closed) + 2);
+    assert(send_calls == 2);
+
+    /* A newly opened producer may reset incarnation/sequence to the same
+     * numbers. A fresh monotonic timestamp must still permit its frame. */
+    atomic_store(&frame_timestamp, rss_timestamp_us());
+    wait_count(&send_calls, 3);
+    wait_count(&closed, atomic_load(&closed) + 2);
+    assert(send_calls == 3);
+    assert(rad_output_stop(&owner) == RSS_OK && torn_down == 1 && acquired == 0);
+    rss_config_free(cfg);
+    puts("Actual RAD idle timeouts do not replay the final frame; new producer frames recover");
+    return 0;
+}
diff --git a/tests/test_rad_input.c b/tests/test_rad_input.c
new file mode 100644
index 0000000000000000000000000000000000000000..7eb3d76a346af8ff80babced1960122c6c77dc15
--- /dev/null
+++ b/tests/test_rad_input.c
@@ -0,0 +1,532 @@
+/* Real lifecycle code with HAL, codec, allocation and ring fault doubles. */
+#include "rad_state.h"
+#include <assert.h>
+#include <stdlib.h>
+#include <string.h>
+#include "native_input_commands.h"
+
+typedef struct {
+    int volume, gain, mute;
+    int alc_gain, alc_set_error, alc_get_error;
+    bool alc_mismatch, alc_required, alc_checked;
+    int init_calls, deinit_calls, ring_calls, publish_calls;
+    int init_error, deinit_error, getter_error, mute_error;
+    bool mismatch, codec_failure, allocation_failure, ring_failure;
+    bool mute_checked;
+#ifdef RAPTOR_AUDIO_EFFECTS
+    int effect_error;
+    int observed_ns, observed_target, observed_compression;
+    bool observed_hpf;
+    int effect_cleanup_error;
+#endif
+} fixture_t;
+static fixture_t state;
+
+void *rad_test_malloc(size_t size)
+{
+    return state.allocation_failure ? NULL : malloc(size);
+}
+
+static int init_audio(void *ctx, const rss_audio_config_t *cfg)
+{
+    assert(ctx == &state && cfg->ai_device == 1 && cfg->chn_count == 1);
+    state.init_calls++;
+    state.mute_checked = false;
+    state.alc_checked = false;
+    return state.init_error;
+}
+
+static int deinit_audio(void *ctx)
+{
+    assert(ctx == &state);
+    state.deinit_calls++;
+    return state.deinit_error;
+}
+
+static int set_volume(void *ctx, int dev, int chn, int value)
+{
+    assert(ctx == &state && dev == 1 && chn == 0);
+    state.volume = value;
+    return 0;
+}
+
+static int set_gain(void *ctx, int dev, int chn, int value)
+{
+    assert(ctx == &state && dev == 1 && chn == 0);
+    state.gain = value;
+    return 0;
+}
+
+static int get_volume(void *ctx, int dev, int chn, int *value)
+{
+    assert(ctx == &state && dev == 1 && chn == 0);
+    *value = state.volume + state.mismatch;
+    return state.getter_error;
+}
+
+static int get_gain(void *ctx, int dev, int chn, int *value)
+{
+    assert(ctx == &state && dev == 1 && chn == 0);
+    *value = state.gain;
+    return state.getter_error;
+}
+
+static int set_alc(void *ctx, int dev, int chn, int value)
+{
+    assert(ctx == &state && dev == 1 && chn == 0);
+    state.alc_gain = value;
+    return state.alc_set_error;
+}
+
+static int get_alc(void *ctx, int dev, int chn, int *value)
+{
+    assert(ctx == &state && dev == 1 && chn == 0);
+    *value = state.alc_gain + state.alc_mismatch;
+    state.alc_checked = state.alc_get_error == 0 && !state.alc_mismatch;
+    return state.alc_get_error;
+}
+
+static int set_mute(void *ctx, int dev, int chn, int value)
+{
+    assert(ctx == &state && dev == 1 && chn == 0);
+    assert(!state.alc_required || state.alc_checked);
+    state.mute = value;
+    state.mute_checked = state.mute_error == 0;
+    return state.mute_error;
+}
+
+#ifdef RAPTOR_AUDIO_EFFECTS
+static int enable_ns(void *ctx, rss_ns_level_t level)
+{
+    assert(ctx == &state && level >= RSS_NS_LOW && level <= RSS_NS_VERYHIGH);
+    state.observed_ns = level;
+    return state.effect_error;
+}
+static int disable_ns(void *ctx)
+{
+    assert(ctx == &state);
+    return state.effect_cleanup_error;
+}
+static int enable_hpf(void *ctx)
+{
+    assert(ctx == &state);
+    state.observed_hpf = true;
+    return state.effect_error;
+}
+static int enable_agc(void *ctx, const rss_agc_config_t *cfg)
+{
+    assert(ctx == &state);
+    state.observed_target = cfg->target_level_dbfs;
+    state.observed_compression = cfg->compression_gain_db;
+    return state.effect_error;
+}
+#endif
+
+#ifndef RAD_TEST_REAL_CODECS
+static int codec_init(rad_codec_ctx_t *ctx, rss_config_t *cfg, int rate)
+{
+    (void)cfg;
+    assert(rate > 0);
+    if (state.codec_failure) {
+        return -1;
+    }
+    ctx->priv = calloc(1, 1);
+    assert(ctx->priv);
+    ctx->encode_buf_size = 2048;
+    return 0;
+}
+
+static void codec_deinit(rad_codec_ctx_t *ctx)
+{
+    free(ctx->priv);
+    ctx->priv = NULL;
+}
+
+const rad_codec_ops_t *rad_codec_find(const char *name)
+{
+    static const rad_codec_ops_t pcm = {
+        .name = "l16", .codec_id = RAD_CODEC_L16, .init = codec_init, .deinit = codec_deinit,
+    };
+    static const rad_codec_ops_t pcma = {
+        .name = "pcma", .codec_id = RAD_CODEC_PCMA, .init = codec_init, .deinit = codec_deinit,
+    };
+    if (strcmp(name, "l16") == 0) {
+        return &pcm;
+    }
+    return strcmp(name, "pcma") == 0 ? &pcma : NULL;
+}
+
+#endif
+
+rss_ring_t *rss_ring_create(const char *name, uint32_t slots, uint32_t bytes)
+{
+    assert(strcmp(name, "audio") == 0 && slots == 32);
+    assert(bytes == 128 * 1024 || bytes == 256 * 1024);
+    assert(state.mute_checked);
+    state.ring_calls++;
+    return state.ring_failure ? NULL : (rss_ring_t *)calloc(1, 1);
+}
+
+int rss_ring_publish(rss_ring_t *ring, const uint8_t *data, uint32_t length,
+                     int64_t timestamp, uint16_t codec, uint8_t flags)
+{
+    assert(ring && data && length == 1 && timestamp == 123 && codec == RAD_CODEC_L16 && flags == 0);
+    state.publish_calls++;
+    return RSS_OK;
+}
+
+void rss_ring_destroy(rss_ring_t *ring)
+{
+    free(ring);
+}
+
+void rss_ring_set_stream_info(rss_ring_t *ring, uint32_t type, uint32_t codec,
+                             uint32_t width, uint32_t height, uint32_t fps_num,
+                             uint32_t fps_den, uint8_t aot, uint8_t profile)
+{
+    (void)width;
+    (void)height;
+    (void)aot;
+    (void)profile;
+    assert(ring && type == 0x10 && fps_den == 1);
+    assert(codec == RAD_CODEC_L16 || (codec == RAD_CODEC_PCMA && fps_num == 8000));
+}
+
+static void expect_command(rad_ctrl_ctx_t *ctx, const char *request, bool success)
+{
+    char reply[1024];
+    assert(native_input_command(ctx, request, reply, sizeof(reply)) > 0);
+    cJSON *root = cJSON_Parse(reply);
+    assert(root);
+    cJSON *status = cJSON_GetObjectItem(root, "status");
+    assert(cJSON_IsString(status));
+    assert((strcmp(status->valuestring, "ok") == 0) == success);
+    cJSON_Delete(root);
+}
+
+static void expect_processing(rad_ctrl_ctx_t *ctx, const char *request, bool success)
+{
+    char reply[1024];
+    assert(rad_input_processing(ctx, request, reply, sizeof(reply)) > 0);
+    cJSON *root = cJSON_Parse(reply);
+    cJSON *status = cJSON_GetObjectItemCaseSensitive(root, "status");
+    assert(cJSON_IsString(status));
+    assert((strcmp(status->valuestring, "ok") == 0) == success);
+    cJSON_Delete(root);
+}
+
+static void expect_owner_status(rad_ctrl_ctx_t *ctx, bool available, bool enabled)
+{
+    char buf[2048];
+    assert(rad_input_status(ctx, buf, sizeof(buf)) > 0);
+    cJSON *root = cJSON_Parse(buf);
+    assert(root);
+    assert(cJSON_IsTrue(cJSON_GetObjectItem(root, "available")) == available);
+    cJSON *state = cJSON_GetObjectItem(root, "enabled");
+    if (available) {
+        assert(cJSON_IsTrue(state) == enabled);
+    } else {
+        assert(cJSON_IsNull(state));
+        assert(cJSON_IsNull(cJSON_GetObjectItem(root, "codec")));
+        assert(cJSON_IsNull(cJSON_GetObjectItem(root, "muted")));
+    }
+    cJSON *codecs = cJSON_GetObjectItem(root, "codecs_built");
+    assert(cJSON_IsTrue(cJSON_GetObjectItem(codecs, "l16")));
+    assert(cJSON_IsFalse(cJSON_GetObjectItem(codecs, "aac")));
+#ifdef RAD_TEST_REAL_CODECS
+    assert(cJSON_IsTrue(cJSON_GetObjectItem(codecs, "pcmu")));
+#endif
+#ifdef RAPTOR_AUDIO_EFFECTS
+    assert(cJSON_IsTrue(cJSON_GetObjectItem(root, "effects_built")));
+#else
+    assert(cJSON_IsFalse(cJSON_GetObjectItem(root, "effects_built")));
+#endif
+    cJSON_Delete(root);
+}
+
+static void expect_quiesced(const rad_ctrl_ctx_t *ctx)
+{
+    assert(ctx->ai_disabled && !*ctx->ring && !*ctx->codec_ops);
+}
+
+int main(int argc, char **argv)
+{
+    assert(argc == 2);
+    FILE *file = fopen(argv[1], "w");
+    assert(file);
+    assert(fputs("[privacy]\nenabled=true\n[audio]\ncodec=l16\nai_enabled=false\n", file) >= 0);
+    assert(fclose(file) == 0);
+    rss_config_t *cfg = rss_config_load(argv[1]);
+    assert(cfg);
+    rss_hal_ops_t ops = {
+        .audio_init = init_audio, .audio_deinit = deinit_audio,
+        .audio_set_volume = set_volume, .audio_get_volume = get_volume,
+        .audio_set_gain = set_gain, .audio_get_gain = get_gain,
+        .audio_set_mute = set_mute,
+        .audio_set_alc_gain = set_alc, .audio_get_alc_gain = get_alc,
+#ifdef RAPTOR_AUDIO_EFFECTS
+        .audio_enable_ns = enable_ns,
+        .audio_enable_hpf = enable_hpf, .audio_disable_hpf = disable_ns,
+        .audio_enable_agc = enable_agc, .audio_disable_agc = disable_ns, .audio_disable_ns = disable_ns,
+#endif
+    };
+    rss_ring_t *ring = NULL;
+    const rad_codec_ops_t *codec = NULL;
+    rad_codec_ctx_t codec_ctx = {0};
+    uint8_t *buffer = NULL;
+    int size = 0;
+    int64_t timestamp = 0;
+    rad_ctrl_ctx_t ctx = {
+        .cfg = cfg, .config_path = argv[1], .ops = &ops, .hal_ctx = (rss_hal_ctx_t *)&state,
+        .ai_dev = 1, .volume = 20, .gain = 5, .muted = true,
+        .ai_disabled = true, .codec_str = "l16", .sample_rate = 16000,
+        .ring = &ring, .codec_ops = &codec, .codec_ctx = &codec_ctx,
+        .encode_buf = &buffer, .encode_buf_size = &size, .synth_audio_ts = &timestamp,
+    };
+    assert(rad_input_mute(&ctx, false) == 0 && !ctx.muted);
+    assert(rad_input_mute(&ctx, true) == 0 && ctx.muted);
+    assert(!state.mute_checked);
+    assert(rad_input_boot(&ctx) == 0);
+    assert(state.init_calls == 0 && !ring && !codec && ctx.ai_disabled);
+    expect_owner_status(&ctx, true, false);
+    rss_config_set_bool(cfg, "audio", "ai_enabled", true);
+    assert(rad_input_boot(&ctx) == 0);
+    assert(!ctx.ai_disabled && !ctx.ai_cleanup_pending && state.mute == 1);
+    expect_owner_status(&ctx, true, true);
+    /* A raw microphone buffer must never reach the shared ring while protected. */
+    uint8_t sample = 42;
+    assert(rad_input_publish(&ctx, &sample, 1, 123) == RSS_OK && state.publish_calls == 0);
+    assert(rad_input_mute(&ctx, false) == RSS_OK);
+    assert(rad_input_publish(&ctx, &sample, 1, 123) == RSS_OK && state.publish_calls == 1);
+    assert(rad_input_mute(&ctx, true) == RSS_OK);
+    assert(rad_input_publish(&ctx, &sample, 1, 123) == RSS_OK && state.publish_calls == 1);
+    void *old_codec = codec_ctx.priv;
+    rss_ring_t *old_ring = ring;
+    int old_deinits = state.deinit_calls;
+#ifndef RAD_TEST_REAL_CODECS
+    state.codec_failure = true;
+    assert(rad_input_start(&ctx, "pcma", 16000) != 0);
+    state.codec_failure = false;
+#endif
+    state.allocation_failure = true;
+    assert(rad_input_start(&ctx, "pcma", 16000) != 0);
+    state.allocation_failure = false;
+    assert(codec_ctx.priv == old_codec && ring == old_ring && state.deinit_calls == old_deinits);
+
+    state.deinit_error = -1;
+    assert(rad_input_start(&ctx, "pcma", 16000) != 0);
+    expect_quiesced(&ctx);
+    assert(ctx.ai_cleanup_pending);
+    expect_owner_status(&ctx, false, false);
+    assert(rad_input_mute(&ctx, false) != 0 && ctx.muted);
+    state.deinit_error = 0;
+    assert(rad_input_start(&ctx, "pcma", 16000) == 0);
+    assert(ctx.sample_rate == 8000 && ctx.codec_id == RAD_CODEC_PCMA);
+    assert(strcmp(rss_config_get_str(cfg, "audio", "codec", ""), "l16") == 0);
+
+    for (int fault = 0; fault < 5; ++fault) {
+        state.init_error = fault == 0 ? -1 : 0;
+        state.getter_error = fault == 1 ? -1 : 0;
+        state.mismatch = fault == 2;
+        state.mute_error = fault == 3 ? -1 : 0;
+        state.ring_failure = fault == 4;
+        assert(rad_input_start(&ctx, "l16", 16000) != 0);
+        expect_quiesced(&ctx);
+        assert(!ctx.ai_cleanup_pending);
+        state.init_error = state.getter_error = state.mute_error = 0;
+        state.mismatch = state.ring_failure = false;
+        assert(rad_input_start(&ctx, "l16", 16000) == 0);
+    }
+#ifdef RAPTOR_AUDIO_EFFECTS
+    old_ring = ring;
+    assert(rad_input_track_processing(&ctx, 1, true, RSS_ERR_NOTSUP) == RSS_ERR_NOTSUP);
+    assert(ring == old_ring && !ctx.ai_disabled);
+    assert(rad_input_track_processing(&ctx, 1, true, -1) == -1);
+    expect_quiesced(&ctx);
+    assert(rad_input_start(&ctx, "l16", 16000) == 0);
+    ctx.ns_enabled = true;
+    state.effect_error = -1;
+    assert(rad_input_start(&ctx, "l16", 16000) != 0);
+    expect_quiesced(&ctx);
+    state.effect_error = 0;
+    assert(rad_input_start(&ctx, "l16", 16000) == 0);
+    int deinitializations = state.deinit_calls;
+    state.effect_cleanup_error = -1;
+    assert(rad_input_stop(&ctx) != 0);
+    assert(ctx.ai_cleanup_pending && ctx.input_effects_owned != 0);
+    assert(state.deinit_calls == deinitializations);
+    state.effect_cleanup_error = 0;
+    assert(rad_input_start(&ctx, "l16", 16000) == 0);
+#endif
+    expect_command(&ctx, "{\"cmd\":\"set-codec\",\"value\":\"pcma\"}", true);
+    assert(strcmp(rss_config_get_str(cfg, "audio", "codec", ""), "pcma") == 0);
+    assert(rss_config_get_int(cfg, "audio", "sample_rate", 0) == 8000);
+    old_deinits = state.deinit_calls;
+    expect_command(&ctx, "{\"cmd\":\"set-codec\",\"value\":\"unbuilt\"}", false);
+    assert(state.deinit_calls == old_deinits && !ctx.ai_disabled);
+    state.deinit_error = -1;
+    expect_command(&ctx, "{\"cmd\":\"ai-disable\"}", false);
+    assert(rss_config_get_bool(cfg, "audio", "ai_enabled", false));
+    state.deinit_error = 0;
+    expect_command(&ctx, "{\"cmd\":\"ai-disable\"}", true);
+    expect_quiesced(&ctx);
+    assert(!rss_config_get_bool(cfg, "audio", "ai_enabled", true));
+    assert(rss_config_save(cfg, argv[1]) == 0);
+    rss_config_t *disk = rss_config_load(argv[1]);
+    assert(disk && !rss_config_get_bool(disk, "audio", "ai_enabled", true));
+    assert(strcmp(rss_config_get_str(disk, "audio", "codec", ""), "pcma") == 0);
+    rss_config_free(disk);
+    expect_command(&ctx, "{\"cmd\":\"mute\"}", true);
+    expect_command(&ctx, "{\"cmd\":\"ai-enable\"}", true);
+    assert(ctx.muted && state.mute == 1 && !ctx.ai_disabled);
+    old_ring = ring;
+    old_deinits = state.deinit_calls;
+    rss_config_set_str(cfg, "audio", "alc_gain", "invalid");
+    assert(rad_input_start(&ctx, "pcma", 8000) != RSS_OK);
+    assert(ring == old_ring && state.deinit_calls == old_deinits);
+    rss_config_set_int(cfg, "audio", "alc_gain", 5);
+    ops.audio_get_alc_gain = NULL;
+    assert(rad_input_start(&ctx, "pcma", 8000) != RSS_OK);
+    assert(ring == old_ring && state.deinit_calls == old_deinits);
+    ops.audio_get_alc_gain = get_alc;
+    state.alc_required = true;
+    assert(rad_input_start(&ctx, "pcma", 8000) == RSS_OK);
+    assert(state.alc_gain == 5 && state.alc_checked && state.mute == 1);
+    for (int fault = 0; fault < 3; ++fault) {
+        state.alc_set_error = fault == 0 ? RSS_ERR : RSS_OK;
+        state.alc_get_error = fault == 1 ? RSS_ERR : RSS_OK;
+        state.alc_mismatch = fault == 2;
+        assert(rad_input_start(&ctx, "pcma", 8000) != RSS_OK);
+        expect_quiesced(&ctx);
+        state.alc_set_error = state.alc_get_error = 0;
+        state.alc_mismatch = false;
+        assert(rad_input_start(&ctx, "pcma", 8000) == RSS_OK);
+        assert(state.alc_gain == 5 && state.mute == 1);
+    }
+    const char *profile = "{\"cmd\":\"set-input-processing\",\"ns\":1,\"level\":3,\"hpf\":1,\"agc\":1,\"target\":12,\"compression\":20}";
+    old_ring = ring;
+    old_deinits = state.deinit_calls;
+    expect_processing(&ctx, "{\"cmd\":\"set-input-processing\",\"ns\":true}", false);
+    assert(ring == old_ring && state.deinit_calls == old_deinits);
+#ifdef RAPTOR_AUDIO_EFFECTS
+    expect_processing(&ctx, profile, true);
+    assert(ctx.ns_enabled && ctx.ns_level == 3 && ctx.agc_target == 12 && ctx.agc_compression == 20);
+    assert(ctx.hpf_enabled && ctx.agc_enabled && state.observed_hpf);
+    assert(state.observed_ns == 3 && state.observed_target == 12 && state.observed_compression == 20);
+    assert(ctx.muted && state.mute == 1);
+    int stable_inits = state.init_calls;
+    int stable_deinits = state.deinit_calls;
+    rss_ring_t *stable_ring = ring;
+    /* Exercise the exact command sequence emitted by an unchanged form Save.
+     * Drifted caches must be repaired even when no SDK restart is needed. */
+    rss_config_set_str(cfg, "audio", "codec", "l16");
+    rss_config_set_int(cfg, "audio", "sample_rate", 16000);
+    rss_config_set_bool(cfg, "audio", "ns_enabled", false);
+    rss_config_set_int(cfg, "audio", "ns_level", 0);
+    rss_config_set_bool(cfg, "audio", "hpf_enabled", false);
+    rss_config_set_bool(cfg, "audio", "agc_enabled", false);
+    rss_config_set_int(cfg, "audio", "agc_target_dbfs", 0);
+    rss_config_set_int(cfg, "audio", "agc_compression_db", 0);
+    expect_command(&ctx, "{\"cmd\":\"ai-enable\"}", true);
+    expect_command(&ctx, "{\"cmd\":\"set-codec\",\"value\":\"pcma\"}", true);
+    expect_command(&ctx, profile, true);
+    assert(state.init_calls == stable_inits && state.deinit_calls == stable_deinits && ring == stable_ring);
+    assert(rss_config_get_int(cfg, "audio", "sample_rate", 0) == 8000);
+    assert(strcmp(rss_config_get_str(cfg, "audio", "codec", ""), "pcma") == 0);
+    char failed_path[4096];
+    assert(snprintf(failed_path, sizeof(failed_path), "%s/missing", argv[1]) < (int)sizeof(failed_path));
+    ctx.config_path = failed_path;
+    expect_command(&ctx, "{\"cmd\":\"config-save\"}", false);
+    ctx.config_path = argv[1];
+    expect_command(&ctx, "{\"cmd\":\"set-codec\",\"value\":\"pcma\"}", true);
+    expect_command(&ctx, profile, true);
+    assert(state.init_calls == stable_inits && state.deinit_calls == stable_deinits && ring == stable_ring);
+    expect_command(&ctx, "{\"cmd\":\"config-save\"}", true);
+    expect_command(&ctx, "{\"cmd\":\"config-read-section\",\"section\":\"audio\"}", true);
+    disk = rss_config_load(argv[1]);
+    assert(disk && rss_config_get_int(disk, "audio", "ns_level", -1) == 3);
+    assert(rss_config_get_int(disk, "audio", "agc_target_dbfs", -1) == 12);
+    assert(rss_config_get_bool(disk, "audio", "ns_enabled", false));
+    assert(rss_config_get_bool(disk, "audio", "hpf_enabled", false));
+    assert(rss_config_get_bool(disk, "audio", "agc_enabled", false));
+    assert(rss_config_get_int(disk, "audio", "agc_compression_db", -1) == 20);
+    rss_config_free(disk);
+    ctx.ai_cleanup_pending = true;
+    expect_command(&ctx, profile, false);
+    assert(state.init_calls == stable_inits && state.deinit_calls == stable_deinits);
+    expect_command(&ctx, "{\"cmd\":\"ai-enable\"}", true);
+    assert(state.init_calls == stable_inits + 1 && state.deinit_calls == stable_deinits + 1);
+    stable_inits = state.init_calls;
+    stable_deinits = state.deinit_calls;
+    stable_ring = ring;
+    expect_command(&ctx, "{\"cmd\":\"unmute\"}", true);
+    expect_command(&ctx, "{\"cmd\":\"set-codec\",\"value\":\"pcma\"}", true);
+    expect_command(&ctx, profile, true);
+    expect_command(&ctx, "{\"cmd\":\"set-gain\",\"value\":21}", true);
+    expect_command(&ctx, "{\"cmd\":\"set-alc-gain\",\"value\":6}", true);
+    assert(state.init_calls == stable_inits && state.deinit_calls == stable_deinits && ring == stable_ring);
+    expect_command(&ctx, "{\"cmd\":\"config-save\"}", true);
+    expect_command(&ctx, "{\"cmd\":\"config-read-section\",\"section\":\"audio\"}", true);
+    disk = rss_config_load(argv[1]);
+    assert(disk && rss_config_get_int(disk, "audio", "gain", -1) == 21);
+    assert(rss_config_get_int(disk, "audio", "alc_gain", -1) == 6);
+    rss_config_free(disk);
+    expect_command(&ctx, "{\"cmd\":\"mute\"}", true);
+    expect_processing(&ctx, "{\"cmd\":\"set-ns\",\"value\":1,\"level\":1}", true);
+    assert(state.init_calls == stable_inits + 1 && state.deinit_calls == stable_deinits + 1);
+    assert(ctx.ns_level == 1);
+    state.effect_error = RSS_ERR;
+    expect_processing(&ctx, profile, false);
+    expect_quiesced(&ctx);
+    assert(ctx.ns_level == 1 && rss_config_get_int(cfg, "audio", "ns_level", -1) == 1);
+    state.effect_error = RSS_OK;
+    expect_command(&ctx, "{\"cmd\":\"ai-enable\"}", true);
+    assert(ctx.ns_level == 1 && ctx.muted && state.mute == 1);
+    state.effect_cleanup_error = RSS_ERR;
+    expect_processing(&ctx, profile, false);
+    assert(ctx.ai_cleanup_pending && ctx.input_effects_owned);
+    state.effect_cleanup_error = RSS_OK;
+    expect_command(&ctx, "{\"cmd\":\"ai-enable\"}", true);
+#else
+    expect_processing(&ctx, profile, false);
+    assert(ring == old_ring && state.deinit_calls == old_deinits);
+#endif
+    int same_inits = state.init_calls, same_deinits = state.deinit_calls;
+    expect_command(&ctx, "{\"cmd\":\"unmute\"}", true);
+    expect_command(&ctx, "{\"cmd\":\"set-gain\",\"value\":22}", true);
+    expect_command(&ctx, "{\"cmd\":\"set-alc-gain\",\"value\":7}", true);
+    expect_command(&ctx, "{\"cmd\":\"mute\"}", true);
+    expect_command(&ctx, "{\"cmd\":\"set-codec\",\"value\":\"pcma\"}", true);
+    assert(state.init_calls == same_inits && state.deinit_calls == same_deinits);
+    expect_command(&ctx, "{\"cmd\":\"set-codec\",\"value\":\"l16\"}", true);
+    assert(state.init_calls == same_inits + 1 && state.deinit_calls == same_deinits + 1);
+    /* Explicit restart and an unknown owner are never treated as no-ops. */
+    expect_command(&ctx, "{\"cmd\":\"audio-restart\"}", true);
+    assert(state.init_calls == same_inits + 2 && state.deinit_calls == same_deinits + 2);
+    ctx.ai_cleanup_pending = true;
+    expect_command(&ctx, "{\"cmd\":\"set-codec\",\"value\":\"l16\"}", true);
+    assert(!ctx.ai_cleanup_pending && state.init_calls == same_inits + 3 && state.deinit_calls == same_deinits + 3);
+    codec_ctx.ring = NULL; /* Inconsistent active ownership is not healthy. */
+    expect_command(&ctx, "{\"cmd\":\"ai-enable\"}", true);
+    assert(state.init_calls == same_inits + 4 && state.deinit_calls == same_deinits + 4);
+    assert(codec_ctx.ring == ring && !ctx.ai_disabled && !ctx.ai_cleanup_pending);
+    assert(rad_input_stop(&ctx) == 0);
+    expect_quiesced(&ctx);
+    int rings_before = state.ring_calls, inits_before = state.init_calls;
+    rss_config_set_str(cfg, "privacy", "enabled", "invalid");
+    assert(rad_input_boot(&ctx) != RSS_OK && ctx.muted);
+    assert(state.ring_calls == rings_before && state.init_calls == inits_before);
+    assert(rad_input_publish(&ctx, &sample, 1, 123) == RSS_OK && state.publish_calls == 1);
+    rss_config_set_bool(cfg, "privacy", "enabled", true);
+    state.mute_error = RSS_ERR;
+    assert(rad_input_boot(&ctx) != RSS_OK && ctx.muted);
+    assert(state.ring_calls == rings_before);
+    state.mute_error = RSS_OK;
+    rss_config_set_bool(cfg, "privacy", "enabled", false);
+    assert(rad_input_boot(&ctx) == RSS_OK && !ctx.muted && state.mute == 0);
+    assert(rad_input_stop(&ctx) == RSS_OK);
+    free(buffer);
+    rss_config_free(cfg);
+    puts("RAD input preparation, checked startup, cleanup and mute preservation passed");
+    return 0;
+}
diff --git a/tests/test_rad_output.c b/tests/test_rad_output.c
new file mode 100644
index 0000000000000000000000000000000000000000..44c840890235080dbaab7e3956a502626347994e
--- /dev/null
+++ b/tests/test_rad_output.c
@@ -0,0 +1,258 @@
+#include "rad_state.h"
+#include "rad_level.h"
+#include <assert.h>
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+#include "native_output_commands.h"
+
+static int init_error, deinit_error, getter_error, mismatch, mute_error, clear_error;
+static int create_error, join_error, aec_error;
+static int init_calls, deinit_calls, volume, gain, mute_calls, clear_calls;
+static bool muted;
+static _Atomic bool thread_alive;
+static _Atomic bool simulate_sdk_block;
+
+static int initialize(void *opaque, const rss_audio_config_t *config)
+{
+    (void)opaque;
+    assert(config->sample_rate == 16000);
+    init_calls++;
+    return init_error;
+}
+
+static int deinitialize(void *opaque)
+{
+    (void)opaque;
+    assert(!atomic_load(&thread_alive));
+    deinit_calls++;
+    return deinit_error;
+}
+
+static int set_volume(void *opaque, int value)
+{
+    (void)opaque;
+    volume = value;
+    return RSS_OK;
+}
+
+static int set_gain(void *opaque, int value)
+{
+    (void)opaque;
+    gain = value;
+    return RSS_OK;
+}
+
+static int get_volume(void *opaque, int *value)
+{
+    (void)opaque;
+    *value = volume + mismatch;
+    return getter_error;
+}
+
+static int get_gain(void *opaque, int *value)
+{
+    (void)opaque;
+    *value = gain + mismatch;
+    return getter_error;
+}
+
+static int set_mute(void *opaque, int dev, int channel)
+{
+    (void)opaque;
+    assert(dev == 0 && channel == 0);
+    mute_calls++;
+    muted = true;
+    return mute_error;
+}
+
+static int clear_mute(void *opaque, int dev, int channel)
+{
+    int ret = set_mute(opaque, dev, channel);
+    muted = false;
+    return ret;
+}
+
+static int clear_buffer(void *opaque)
+{
+    (void)opaque;
+    clear_calls++;
+    return clear_error;
+}
+
+static int disable_aec(void *opaque)
+{
+    (void)opaque;
+    return aec_error;
+}
+
+int rad_input_track_processing(rad_ctrl_ctx_t *ctx, unsigned bit, bool enabled, int result)
+{
+    assert(!enabled);
+    if (result == RSS_OK) {
+        ctx->input_effects_owned &= ~bit;
+    }
+    return result;
+}
+
+void *ao_playback_thread(void *opaque)
+{
+    ao_thread_ctx_t *ctx = opaque;
+    atomic_store(&thread_alive, true);
+    while (!atomic_load(&ctx->stop) || atomic_load(&simulate_sdk_block)) {
+        usleep(1000);
+    }
+    atomic_store(&thread_alive, false);
+    atomic_store(&ctx->completed, true);
+    return NULL;
+}
+
+int rad_test_pthread_create(pthread_t *thread, const pthread_attr_t *attributes,
+                            void *(*entry)(void *), void *opaque)
+{
+    assert(mute_calls > 0 && clear_calls > 0);
+    if (create_error) {
+        return create_error;
+    }
+    int ret = pthread_create(thread, attributes, entry, opaque);
+    if (ret == 0) {
+        while (!atomic_load(&thread_alive)) {
+            usleep(1000);
+        }
+    }
+    return ret;
+}
+
+int rad_test_pthread_join(pthread_t thread, void **result)
+{
+    if (join_error) {
+        return join_error;
+    }
+    return pthread_join(thread, result);
+}
+
+int main(int argc, char **argv)
+{
+    assert(argc == 2);
+    FILE *file = fopen(argv[1], "w");
+    assert(file);
+    fputs("[audio]\nao_enabled=false\nao_sample_rate=16000\n", file);
+    fclose(file);
+    rss_config_t *cfg = rss_config_load(argv[1]);
+    assert(cfg);
+    rss_hal_ops_t ops = {
+        .ao_init = initialize, .ao_deinit = deinitialize,
+        .ao_set_volume = set_volume, .ao_get_volume = get_volume,
+        .ao_set_gain = set_gain, .ao_get_gain = get_gain,
+        .ao_soft_mute = set_mute, .ao_soft_unmute = clear_mute,
+        .ao_clear_buf = clear_buffer, .audio_disable_aec = disable_aec,
+    };
+    ao_thread_ctx_t playback = {.ops = &ops};
+    pthread_t thread;
+    bool started = false;
+    rad_ctrl_ctx_t ctx = {
+        .cfg = cfg, .ops = &ops, .ao_ctx = &playback,
+        .ao_tid = &thread, .ao_thread_started = &started,
+        .sample_rate = 16000, .ao_volume = 50, .ao_gain = 12,
+        .ao_muted = true,
+    };
+    assert(rad_output_boot(&ctx) == RSS_OK && init_calls == 0);
+    assert(rad_output_start(&ctx, 12345) == RSS_ERR_INVAL && init_calls == 0);
+    assert(rad_output_start(&ctx, 16000) == RSS_OK);
+    assert(ctx.ao_enabled && started && muted && !ctx.ao_cleanup_pending);
+    int before = deinit_calls;
+    atomic_store(&simulate_sdk_block, true);
+    int64_t began = rss_timestamp_us();
+    assert(rad_output_stop(&ctx) != RSS_OK);
+    assert(rss_timestamp_us() - began < 1000000);
+    assert(ctx.ao_cleanup_pending && started && atomic_load(&thread_alive));
+    assert(deinit_calls == before);
+    atomic_store(&simulate_sdk_block, false);
+    assert(rad_output_stop(&ctx) == RSS_OK);
+    assert(rad_output_start(&ctx, 16000) == RSS_OK);
+    before = deinit_calls;
+    join_error = EINVAL;
+    assert(rad_output_stop(&ctx) != RSS_OK);
+    assert(ctx.ao_cleanup_pending && started && !ctx.ao_enabled);
+    assert(deinit_calls == before);
+    join_error = 0;
+    deinit_error = RSS_ERR;
+    assert(rad_output_stop(&ctx) != RSS_OK);
+    assert(ctx.ao_cleanup_pending && !started);
+    before = init_calls;
+    assert(rad_output_start(&ctx, 16000) != RSS_OK && init_calls == before);
+    deinit_error = 0;
+    assert(rad_output_start(&ctx, 16000) == RSS_OK && muted);
+    assert(rad_output_stop(&ctx) == RSS_OK);
+
+    int *faults[] = {&init_error, &getter_error, &mismatch, &mute_error,
+                    &clear_error, &create_error};
+    for (size_t i = 0; i < sizeof(faults) / sizeof(faults[0]); ++i) {
+        *faults[i] = 1;
+        assert(rad_output_start(&ctx, 16000) != RSS_OK);
+        assert(!started && !ctx.ao_enabled && !ctx.ao_cleanup_pending);
+        *faults[i] = 0;
+        assert(rad_output_start(&ctx, 16000) == RSS_OK && muted);
+        assert(rad_output_stop(&ctx) == RSS_OK);
+    }
+    init_error = deinit_error = RSS_ERR;
+    assert(rad_output_start(&ctx, 16000) != RSS_OK && ctx.ao_cleanup_pending);
+    init_error = deinit_error = 0;
+    assert(rad_output_start(&ctx, 16000) == RSS_OK);
+#ifdef RAPTOR_AUDIO_EFFECTS
+    ctx.input_effects_owned = 8;
+    ctx.aec_enabled = true;
+    aec_error = RSS_ERR;
+    before = deinit_calls;
+    assert(rad_output_stop(&ctx) != RSS_OK);
+    assert(ctx.ao_cleanup_pending && deinit_calls == before && !started);
+    aec_error = 0;
+    assert(rad_output_stop(&ctx) == RSS_OK && !ctx.aec_enabled);
+#else
+    assert(rad_output_stop(&ctx) == RSS_OK);
+#endif
+    rss_config_set_bool(cfg, "audio", "ao_enabled", true);
+    ctx.ao_muted = false;
+    assert(rad_output_boot(&ctx) == RSS_OK && !muted);
+    assert(rad_output_stop(&ctx) == RSS_OK);
+    char reply[2048];
+    assert(native_output_command(&ctx, "{\"cmd\":\"ao-enable\"}", reply, sizeof(reply)) > 0);
+    assert(strstr(reply, "\"ok\"") && ctx.ao_enabled);
+    ctx.muted = true;
+    assert(native_output_command(&ctx, "{\"cmd\":\"ao-set-volume\",\"value\":30}", reply,
+                                 sizeof(reply)) > 0);
+    assert(strstr(reply, "\"ok\"") && volume == 30);
+    assert(native_output_command(&ctx, "{\"cmd\":\"ao-set-gain\",\"value\":10}", reply,
+                                 sizeof(reply)) > 0);
+    assert(strstr(reply, "\"ok\"") && gain == 10);
+    assert(ctx.muted);
+    assert(rss_config_get_int(cfg, "audio", "ao_volume", -1) == 30);
+    assert(rss_config_get_int(cfg, "audio", "ao_gain", -1) == 10);
+    int previous_init = init_calls;
+    assert(native_output_command(&ctx, "{\"cmd\":\"ao-set-sample-rate\",\"value\":12345}", reply, sizeof(reply)) > 0);
+    assert(strstr(reply, "\"error\"") && init_calls == previous_init && ctx.ao_enabled);
+    assert(native_output_command(&ctx, "{\"cmd\":\"ao-set-sample-rate\",\"value\":16000}", reply, sizeof(reply)) > 0);
+    assert(strstr(reply, "\"ok\"") && init_calls == previous_init + 1);
+    assert(rss_config_get_int(cfg, "audio", "ao_sample_rate", 0) == 16000);
+    atomic_store(&playback.failure, RSS_ERR);
+    assert(native_output_command(&ctx, "{\"cmd\":\"status\"}", reply, sizeof(reply)) > 0);
+    cJSON *status = cJSON_Parse(reply);
+    assert(status && cJSON_IsNull(cJSON_GetObjectItemCaseSensitive(status, "ao_enabled")));
+    cJSON_Delete(status);
+    deinit_error = RSS_ERR;
+    assert(native_output_command(&ctx, "{\"cmd\":\"ao-disable\"}", reply, sizeof(reply)) > 0);
+    assert(strstr(reply, "\"error\"") && ctx.ao_cleanup_pending);
+    assert(rss_config_get_bool(cfg, "audio", "ao_enabled", false));
+    deinit_error = 0;
+    assert(native_output_command(&ctx, "{\"cmd\":\"ao-disable\"}", reply, sizeof(reply)) > 0);
+    assert(strstr(reply, "\"ok\"") && !ctx.ao_cleanup_pending);
+    assert(!rss_config_get_bool(cfg, "audio", "ao_enabled", true));
+    assert(rss_config_save(cfg, argv[1]) == RSS_OK);
+    rss_config_t *disk = rss_config_load(argv[1]);
+    assert(disk && !rss_config_get_bool(disk, "audio", "ao_enabled", true));
+    rss_config_free(disk);
+    rss_config_free(cfg);
+    puts("RAD output checked startup, mute ordering, real-thread join and cleanup retry passed");
+    return 0;
+}
diff --git a/tests/test_rad_playback.c b/tests/test_rad_playback.c
new file mode 100644
index 0000000000000000000000000000000000000000..6f8295b5dee73dabc675bd9aa75b427437df49e0
--- /dev/null
+++ b/tests/test_rad_playback.c
@@ -0,0 +1,215 @@
+#include "rad_state.h"
+#include <assert.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+#include <unistd.h>
+#include <imp/imp_audio.h>
+#include "native_hal_send.h"
+#include "native_playback.h"
+
+void rss_ipc_log(int level, const char *file, int line, const char *format, ...)
+{
+    (void)level;
+    (void)file;
+    (void)line;
+    (void)format;
+    abort();
+}
+
+static rss_ring_header_t header;
+static int ring_identity, acquired, closed, initialized, torn_down;
+static int clear_error, send_error, send_calls;
+static _Atomic bool send_entered, release_send;
+static ao_thread_ctx_t *playback;
+
+rss_ring_t *rss_ring_open(const char *name)
+{
+    assert(strcmp(name, "speaker") == 0);
+    return (rss_ring_t *)&ring_identity;
+}
+
+const rss_ring_header_t *rss_ring_get_header(rss_ring_t *ring)
+{
+    assert(ring == (rss_ring_t *)&ring_identity);
+    return &header;
+}
+
+void rss_ring_acquire(rss_ring_t *ring)
+{
+    (void)ring;
+    assert(acquired == 0);
+    acquired++;
+}
+
+void rss_ring_release(rss_ring_t *ring)
+{
+    (void)ring;
+    assert(acquired == 1);
+    acquired--;
+}
+
+void rss_ring_close(rss_ring_t *ring)
+{
+    (void)ring;
+    assert(acquired == 0);
+    closed++;
+}
+
+int rss_ring_read(rss_ring_t *ring, uint64_t *sequence, uint8_t *buffer,
+                  uint32_t capacity, uint32_t *length, rss_ring_slot_t *meta)
+{
+    (void)ring;
+    assert(capacity >= 4 && acquired == 1);
+    memset(buffer, 0, 4);
+    meta->timestamp = rss_timestamp_us();
+    *length = 4;
+    atomic_store(&meta->seq, *sequence);
+    (*sequence)++;
+    return RSS_OK;
+}
+
+int rss_ring_wait(rss_ring_t *ring, uint32_t milliseconds)
+{
+    (void)ring;
+    (void)milliseconds;
+    abort();
+}
+
+static int initialize(void *context, const rss_audio_config_t *config)
+{
+    (void)context;
+    assert(config->sample_rate == 16000);
+    initialized++;
+    return RSS_OK;
+}
+
+static int teardown(void *context)
+{
+    (void)context;
+    assert(atomic_load(&playback->completed));
+    torn_down++;
+    return RSS_OK;
+}
+
+static int set_level(void *context, int value)
+{
+    (void)context;
+    assert(value == 10);
+    return RSS_OK;
+}
+
+static int get_level(void *context, int *value)
+{
+    (void)context;
+    *value = 10;
+    return RSS_OK;
+}
+
+static int mute(void *context, int device, int channel)
+{
+    (void)context;
+    assert(device == 0 && channel == 0);
+    return RSS_OK;
+}
+
+static int clear(void *context)
+{
+    (void)context;
+    /* Startup clear succeeds; inject failure inside the production worker. */
+    return acquired ? clear_error : RSS_OK;
+}
+
+int IMP_AO_SendFrame(int device, int channel, IMPAudioFrame *frame, IMPBlock block)
+{
+    assert(device == 0 && channel == 0 && frame->virAddr && frame->len == 4 && block == NOBLOCK);
+    send_calls++;
+    atomic_store(&send_entered, true);
+    while (!atomic_load(&release_send)) {
+        usleep(1000);
+    }
+    if (send_error == 0) {
+        atomic_store(&playback->stop, true);
+    }
+    return send_error;
+}
+
+int rad_input_track_processing(rad_ctrl_ctx_t *ctx, unsigned bit, bool enabled, int result)
+{
+    (void)ctx;
+    (void)bit;
+    (void)enabled;
+    return result;
+}
+
+static void wait_flag(_Atomic bool *flag)
+{
+    int64_t deadline = rss_timestamp_us() + 1000000;
+    while (!atomic_load(flag)) {
+        assert(rss_timestamp_us() < deadline);
+        usleep(1000);
+    }
+}
+
+int main(int argc, char **argv)
+{
+    assert(argc == 2);
+    FILE *file = fopen(argv[1], "w");
+    assert(file);
+    fputs("[audio]\nao_enabled=true\n", file);
+    fclose(file);
+    rss_config_t *cfg = rss_config_load(argv[1]);
+    assert(cfg);
+    header.version = RSS_RING_VERSION;
+    header.data_size = 32;
+    volatile sig_atomic_t running = 1;
+    rss_hal_ops_t ops = {
+        .ao_init = initialize, .ao_deinit = teardown,
+        .ao_set_volume = set_level, .ao_get_volume = get_level,
+        .ao_set_gain = set_level, .ao_get_gain = get_level,
+        .ao_soft_mute = mute, .ao_soft_unmute = mute,
+        .ao_clear_buf = clear, .ao_send_frame = hal_ao_send_frame,
+    };
+    ao_thread_ctx_t worker = {.ops = &ops, .running = &running, .completed = true};
+    playback = &worker;
+    pthread_t thread;
+    bool started = false;
+    rad_ctrl_ctx_t owner = {
+        .cfg = cfg, .ops = &ops, .ao_ctx = &worker, .ao_tid = &thread,
+        .ao_thread_started = &started, .ao_volume = 10, .ao_gain = 10,
+    };
+    clear_error = RSS_ERR;
+    assert(rad_output_start(&owner, 16000) == RSS_OK);
+    wait_flag(&worker.completed);
+    assert(atomic_load(&worker.failure) == RSS_ERR && send_calls == 0 && closed == 1);
+    assert(rad_output_stop(&owner) == RSS_OK && torn_down == 1);
+    clear_error = 0;
+    send_error = RSS_ERR;
+    atomic_store(&release_send, true);
+    assert(rad_output_start(&owner, 16000) == RSS_OK);
+    wait_flag(&worker.completed);
+    assert(atomic_load(&worker.failure) == RSS_ERR && send_calls == 1 && closed == 2);
+    assert(rad_output_stop(&owner) == RSS_OK && torn_down == 2);
+
+    send_error = 0;
+    atomic_store(&send_entered, false);
+    atomic_store(&release_send, false);
+    assert(rad_output_start(&owner, 16000) == RSS_OK);
+    wait_flag(&send_entered);
+    int64_t began = rss_timestamp_us();
+    assert(rad_output_stop(&owner) != RSS_OK);
+    assert(rss_timestamp_us() - began < 1000000);
+    assert(started && owner.ao_cleanup_pending && torn_down == 2 && acquired == 1);
+    assert(rad_output_start(&owner, 16000) != RSS_OK);
+    assert(initialized == 3 && torn_down == 2 && closed == 2);
+    atomic_store(&release_send, true);
+    wait_flag(&worker.completed);
+    assert(rad_output_stop(&owner) == RSS_OK);
+    assert(!started && !owner.ao_cleanup_pending && closed == 3 && torn_down == 3);
+    assert(rad_output_stop(&owner) == RSS_OK && torn_down == 3 && closed == 3);
+    rss_config_free(cfg);
+    puts("Actual RAD playback NOBLOCK, failure, timeout, late completion and single cleanup passed");
+    return 0;
+}
diff --git a/tests/test_readback.c b/tests/test_readback.c
