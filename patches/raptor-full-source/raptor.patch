new file mode 100644
index 0000000000000000000000000000000000000000..40fc877dec8b89bba8ed121a38c09d392ff26793
--- /dev/null
+++ b/rsd/rsd_reconfigure.c
@@ -0,0 +1,46 @@
+#include "rsd.h"
+#include "../raptor_listener.h"
+#include <sys/epoll.h>
+#include <string.h>
+
+int rsd_access_activate(rsd_server_t *srv, int port, Compy_Auth *auth, int slot,
+                        const char *main_endpoint, const char *sub_endpoint)
+{
+    /* Callers may retain the current endpoint by passing its own storage. */
+    char next_main[sizeof(srv->endpoints[0])];
+    char next_sub[sizeof(srv->endpoints[1])];
+    rss_strlcpy(next_main, main_endpoint, sizeof(next_main));
+    rss_strlcpy(next_sub, sub_endpoint, sizeof(next_sub));
+    int next_listener = -1;
+    if (port != srv->port) {
+        next_listener = rsd_listen_tcp(srv->cfg, port);
+        if (next_listener < 0) {
+            return -1;
+        }
+        struct epoll_event ev = {.events = EPOLLIN, .data.fd = next_listener};
+        if (epoll_ctl(srv->epoll_fd, EPOLL_CTL_ADD, next_listener, &ev) != 0) {
+            close(next_listener);
+            return -1;
+        }
+    }
+    /* All RTSP sessions are revoked before replacing credentials/endpoints.
+     * RTSP requests and control commands share this event-loop owner. */
+    rsd_disconnect_clients(srv);
+    if (next_listener >= 0) {
+        epoll_ctl(srv->epoll_fd, EPOLL_CTL_DEL, srv->listen_fd, NULL);
+        close(srv->listen_fd);
+        srv->listen_fd = next_listener;
+        srv->port = port;
+    }
+    Compy_Auth *old_auth = srv->auth;
+    int old_slot = srv->credential_slot;
+    srv->auth = auth;
+    srv->credential_slot = slot;
+    rss_strlcpy(srv->endpoints[0], next_main, sizeof(srv->endpoints[0]));
+    rss_strlcpy(srv->endpoints[1], next_sub, sizeof(srv->endpoints[1]));
+    if (old_auth) {
+        Compy_Auth_free(old_auth);
+    }
+    memset(&srv->credentials[old_slot], 0, sizeof(srv->credentials[old_slot]));
+    return 0;
+}
