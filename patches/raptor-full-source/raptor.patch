+#define pthread_join test_join
+#define pthread_attr_init test_attr_init
+#define pthread_attr_setstacksize test_attr_size
+#define usleep test_sleep
+#define rss_ntp_synced test_ntp
+#define rss_log test_rss_log
+static void test_rss_log(rss_log_level_t level, const char *file, int line,
+			 const char *fmt, ...);
+#include "../rvd/rvd_pipeline.c"
+#include "../rvd/rvd_frame_loop.c"
+#undef pthread_create
+#undef pthread_join
+#undef pthread_attr_init
+#undef pthread_attr_setstacksize
+#undef usleep
+#undef rss_ntp_synced
+#undef rss_log
+
+static rvd_state_t st;
+static volatile sig_atomic_t running = 1;
+static char trace[512];
+static int join_error, create_error, attr_error, size_error;
+static int fs_enable_error, fs_disable_error, enc_start_error, enc_stop_error, privacy_error;
+static unsigned readers;
+static bool pulse_mode, stop_after_frame;
+static int shutdowns, destroys, polls, create_calls, fail_create_call;
+static int log_count;
+static rss_log_level_t last_log_level;
+static char last_log[128];
+static rss_ring_header_t header;
+static void event(const char *s) { assert(strlen(trace)+strlen(s)+2 < sizeof(trace)); strcat(trace,s); strcat(trace," "); }
+static void test_rss_log(rss_log_level_t level, const char *file, int line,
+			 const char *fmt, ...)
+{
+	(void)file;
+	(void)line;
+	va_list ap;
+	va_start(ap, fmt);
+	vsnprintf(last_log, sizeof(last_log), fmt, ap);
+	va_end(ap);
+	last_log_level = level;
+	log_count++;
+}
+static int fs_enable(void *ctx, int ch) { (void)ctx; (void)ch; event("fs-enable"); return fs_enable_error; }
+static int fs_disable(void *ctx, int ch) { (void)ctx; (void)ch; event("fs-disable"); return fs_disable_error; }
+static int enc_start(void *ctx, int ch) { (void)ctx; (void)ch; event("enc-start"); return enc_start_error; }
+static int enc_stop(void *ctx, int ch) { (void)ctx; (void)ch; event("enc-stop"); return enc_stop_error; }
+static int test_join(pthread_t t, void **r) { (void)r; assert(t == (pthread_t)(uintptr_t)1); event("join"); return join_error; }
+static int test_create(pthread_t *t, const pthread_attr_t *a, void *(*fn)(void *), void *v) {
+    (void)a; (void)v; assert(fn == rvd_encoder_thread); event("create");
+    if (++create_calls == fail_create_call) create_error=11;
+    *t = (pthread_t)(uintptr_t)(create_error ? 99 : 1); return create_error;
+}
+static int test_attr_init(pthread_attr_t *a) { return attr_error ? attr_error : pthread_attr_init(a); }
+static int test_attr_size(pthread_attr_t *a, size_t n) { return size_error ? size_error : pthread_attr_setstacksize(a,n); }
