+    reset(); running=0; join_error=11;
+    assert(rvd_frame_loop(&st,&running)!=0);
+    assert(st.enc_tids[0] && st.streams[0].enabled && st.streams[0].fs_enabled);
+    expect("privacy fs-enable enc-start create join ");
+    trace[0]=0; join_error=0; assert(rvd_stream_stop(&st,0)==0); expect("join enc-stop fs-disable ");
+    reset(); assert(rvd_frame_loop(&st,&running)==0); assert(!st.enc_tids[0]);
+    reset(); create_error=11; assert(rvd_frame_loop(&st,&running)!=0);
+    assert(!st.enc_tids[0] && !st.streams[0].enabled && !st.streams[0].fs_enabled);
+    reset(); st.stream_count=2; st.streams[1].fs_chn=1; fail_create_call=2;
+    assert(rvd_frame_loop(&st,&running)!=0);
+    assert(!st.enc_tids[0] && !st.enc_tids[1]);
+    assert(!atomic_load(&st.stream_active[0]) && !atomic_load(&st.stream_active[1]));
+    assert(st.streams[0].enabled && st.streams[0].fs_enabled);
+    expect("privacy fs-enable enc-start create privacy fs-enable enc-start create enc-stop fs-disable join ");
+    owned(); st.ops=NULL; assert(rvd_stream_stop(&st,0)!=0); expect("join ");
+    assert(st.streams[0].enabled && st.streams[0].fs_enabled);
+    reset(); st.ops=NULL; assert(rvd_stream_start(&st,0)!=0); expect("");
+    running=1;
+    puts("production stream start/stop, worker ownership, and teardown failure gates passed");
