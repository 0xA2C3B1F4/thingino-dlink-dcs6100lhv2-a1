+static void test_independent_outputs(ric_state_t *st)
+{
+    set_policy(st, "day", true);
+    int before_isp = isp_sets;
+    int before_pulse = pulses;
+    cJSON *state = output_request(st,
+        "{\"cmd\":\"set-output\",\"output\":\"ir850\",\"enabled\":true}", true);
+    assert(cJSON_IsTrue(cJSON_GetObjectItem(cJSON_GetObjectItem(state, "ir850"), "enabled")));
+    cJSON_Delete(state);
+    assert(pins[3] == 1 && isp_sets == before_isp && pulses == before_pulse);
+    assert(st->current_mode == RIC_MODE_DAY && ric_verify_mode(st));
+
+    state = output_request(st,
+        "{\"cmd\":\"set-output\",\"output\":\"ircut\",\"enabled\":false}", true);
+    assert(cJSON_IsFalse(cJSON_GetObjectItem(cJSON_GetObjectItem(state, "ircut"), "enabled")));
+    cJSON_Delete(state);
+    assert(pins[3] == 1 && isp_sets == before_isp && pulses == before_pulse + 1);
+    assert(pins[1] == 0 && pins[2] == 0 && ric_verify_mode(st));
+    state = output_request(st,
+        "{\"cmd\":\"set-output\",\"output\":\"ircut\",\"enabled\":false}", true);
+    cJSON_Delete(state);
+    assert(pulses == before_pulse + 1);
+
+    int before_writes = writes;
+    const char *invalid[] = {
+        "{\"cmd\":\"set-output\",\"output\":\"ircut\",\"enabled\":1}",
+        "{\"cmd\":\"set-output\",\"output\":\"other\",\"enabled\":true}",
+        "{\"cmd\":\"set-output\",\"output\":\"ircut\",\"enabled\":true,\"extra\":0}",
+        "{\"cmd\":\"get-output-state\",\"enabled\":true}",
+        "{\"cmd\":\"set-output\",\"output\":\"ircut\",\"output\":\"ir850\"}"
+    };
+    for (size_t i = 0; i < sizeof(invalid) / sizeof(invalid[0]); ++i) {
+        state = output_request(st, invalid[i], false);
+        cJSON_Delete(state);
+    }
+    assert(writes == before_writes);
+
+    /* Re-selecting the same Day policy clears both manual overrides. */
+    set_policy(st, "day", true);
+    assert(!st->filter_manual && !st->ir850_manual);
+    assert(st->filter_day && pins[3] == 0 && ric_verify_mode(st));
+
+    /* A failed pulse release never reports a known filter position. */
+    fail_write = writes + 4;
+    state = output_request(st,
+        "{\"cmd\":\"set-output\",\"output\":\"ircut\",\"enabled\":false}", false);
+    cJSON_Delete(state);
+    state = output_request(st, "{\"cmd\":\"get-output-state\"}", true);
+    assert(cJSON_IsNull(cJSON_GetObjectItem(cJSON_GetObjectItem(state, "ircut"), "enabled")));
+    cJSON_Delete(state);
+    fail_write = 0;
+    state = output_request(st,
+        "{\"cmd\":\"set-output\",\"output\":\"ircut\",\"enabled\":false}", true);
+    cJSON_Delete(state);
+    assert(pins[1] == 0 && pins[2] == 0);
+    set_policy(st, "day", true);
+    bad_direction = true;
+    state = output_request(st, "{\"cmd\":\"get-output-state\"}", true);
+    assert(cJSON_IsNull(cJSON_GetObjectItem(cJSON_GetObjectItem(state, "ir850"), "enabled")));
+    cJSON_Delete(state);
+    bad_direction = false;
+}
