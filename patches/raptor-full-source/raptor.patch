+	return fps_readback_phase(st, index, jpeg, expected, 0, "preflight", observed) == 1;
+}
+
+static bool fps_wait_readback(rvd_state_t *st, int index, int jpeg, uint32_t expected,
+			     uint32_t prior, uint32_t *observed)
+{
+	/* T31 IMP 1.1.4 SetChnFrmRate documents next-GOP application within
+	 * one second. Allow 500 ms scheduling margin after checked restart.
+	 * SDK errors and non-rate changes are terminal, never retried. */
+	struct timespec start, now;
+	if (clock_gettime(CLOCK_MONOTONIC, &start) != 0)
+		return false;
+	for (unsigned attempt = 0; attempt < 32; ++attempt) {
+		rvd_stream_t *s = &st->streams[index];
+		if (!s->enabled || !s->fs_enabled || !st->enc_tids[index] ||
+		    !atomic_load(&st->stream_active[index]) ||
+		    (jpeg >= 0 && (!st->enc_tids[jpeg] || !atomic_load(&st->stream_active[jpeg])))) {
+			RSS_ERROR("FPS phase=running stream ownership lost; recovery required");
+			return false;
+		}
+		int ret = fps_readback_phase(st, index, jpeg, expected, prior, "running", observed);
+		if (clock_gettime(CLOCK_MONOTONIC, &now) != 0)
+			return false;
+		int64_t elapsed = (int64_t)(now.tv_sec - start.tv_sec) * 1000000000 +
+			(now.tv_nsec - start.tv_nsec);
+		if (elapsed < 0 || elapsed > 1500000000 || ret < 0)
+			break;
+		if (ret == 1)
+			return true;
+		if (elapsed == 1500000000)
+			break;
+		struct timespec delay = {.tv_sec = 0, .tv_nsec = 50000000};
+		if (nanosleep(&delay, NULL) != 0 && errno != EINTR)
+			return false;
+	}
+	RSS_ERROR("FPS phase=running convergence failed within 1500 ms; recovery required");
+	return false;
+}
+
+static int fps_response(rvd_state_t *st, int index, int id, const char *error,
+			int applied, int persisted, uint32_t rate, char *resp, int size)
+{
+	cJSON *r = cJSON_CreateObject();
+	cJSON_AddStringToObject(r, "status", error ? "error" : "ok");
+	if (error)
+		cJSON_AddStringToObject(r, "error", error);
+	cJSON_AddNumberToObject(r, "stream_id", id);
+	bool uncertain = index >= 0 &&
+		(rvd_fps_recovery_fs(st, st->streams[index].fs_chn) ||
+		 rvd_codec_recovery_fs(st, st->streams[index].fs_chn));
+	cJSON_AddBoolToObject(r, "recovery_required", uncertain);
+	cJSON_AddBoolToObject(r, "persistence_pending", index >= 0 &&
+		rvd_fps_persistence_fs(st, st->streams[index].fs_chn));
+	if (applied < 0)
+		cJSON_AddNullToObject(r, "live_applied");
+	else
+		cJSON_AddBoolToObject(r, "live_applied", applied != 0);
+	if (persisted < 0)
+		cJSON_AddNullToObject(r, "persisted");
+	else
+		cJSON_AddBoolToObject(r, "persisted", persisted != 0);
+	if (!uncertain && rate)
+		cJSON_AddNumberToObject(r, "fps", rate);
+	else
+		cJSON_AddNullToObject(r, "fps");
+	cJSON_AddStringToObject(r, "evidence", "SDK configuration readback");
+	cJSON *m = cJSON_AddObjectToObject(r, "monitoring");
+	cJSON_AddBoolToObject(m, "related", index >= 0 &&
+		st->streams[index].fs_chn == st->ivs_fs_chn);
+	cJSON_AddBoolToObject(m, "active", atomic_load(&st->ivs_active));
+	cJSON_AddBoolToObject(m, "paused", st->ivs_stream_paused);
+	cJSON_AddBoolToObject(m, "receiving", st->ivs_receiving);
+	cJSON_AddBoolToObject(m, "thread_owned", st->ivs_tid != 0);
+	return rss_ctrl_resp_json(resp, size, r);
+}
+
+static int fps_saved(rvd_state_t *st, rvd_stream_t *s, uint32_t rate)
+{
+	if (!st->config_path || !st->config_path[0])
+		return -1;
+	rss_config_t *disk = rss_config_load(st->config_path);
+	if (!disk)
+		return -1;
+	char expected[12];
+	snprintf(expected, sizeof(expected), "%u", rate);
+	bool match = strcmp(rss_config_get_str(disk, s->cfg_sect, "fps", ""), expected) == 0;
+	rss_config_free(disk);
+	return match;
+}
+
+static int stream_fps_command(rvd_state_t *st, const char *json, char *resp, int size)
+{
+	cJSON *root = cJSON_ParseWithOpts(json, NULL, true);
+	cJSON *cmd = cJSON_GetObjectItemCaseSensitive(root, "cmd");
+	cJSON *id = cJSON_GetObjectItemCaseSensitive(root, "stream_id");
+	cJSON *fps = cJSON_GetObjectItemCaseSensitive(root, "fps");
+	bool set = cJSON_IsString(cmd) && strcmp(cmd->valuestring, "set-stream-fps") == 0;
+	bool valid = cJSON_IsObject(root) && cJSON_IsString(cmd) &&
+		(set || strcmp(cmd->valuestring, "get-stream-fps") == 0) &&
+		cJSON_GetArraySize(root) == (set ? 3 : 2) && cJSON_IsNumber(id) &&
+		id->valuedouble == id->valueint && id->valueint >= 0 && id->valueint <= 1 &&
+		(!set || (cJSON_IsNumber(fps) && fps->valuedouble == fps->valueint &&
+			  fps->valueint >= 1 && fps->valueint <= 30));
+	if (!valid) {
+		cJSON_Delete(root);
+		return rss_ctrl_resp_error(resp, size, "invalid integer stream FPS request");
+	}
+	int semantic = id->valueint;
+	uint32_t requested = set ? (uint32_t)fps->valueint : 0;
+	cJSON_Delete(root);
+	int index = fps_owner(st, semantic);
+	int jpeg = -1;
+	uint32_t current = 0;
+	const char *error = "stream FPS preflight unavailable";
+	int applied = 0;
+	int persisted = -1;
+	bool resume = false;
+	bool stopped_retry = false;
+	if (index < 0)
+		goto done;
+	rvd_stream_t *s = &st->streams[index];
+	if (rvd_codec_recovery_fs(st, s->fs_chn)) {
+		error = "codec recovery required; full daemon bootstrap";
+		applied = -1;
+		goto done;
+	}
+	stopped_retry = set && s->fps_persist_pending && requested == s->enc_cfg.fps_num &&
+		!st->enc_tids[index] && !atomic_load(&st->stream_active[index]) &&
+		!s->enabled && !s->fs_enabled;
+	if (rvd_fps_recovery_fs(st, s->fs_chn)) {
+		error = "FPS recovery required; full daemon bootstrap";
+		applied = -1;
+		goto done;
+	}
+	if (!fps_ops(st->ops) || st->sensor_count < 1 || !st->cfg || !st->config_path || !st->config_path[0] ||
+	    s->fs_chn < 0 || s->fs_chn > 1 ||
+	    (s->enc_cfg.codec != RSS_CODEC_H264 && s->enc_cfg.codec != RSS_CODEC_H265) ||
+	    !s->enc_cfg.width || !s->enc_cfg.height || !s->ring ||
+	    (!stopped_retry && (!s->enabled || !s->fs_enabled || !st->enc_tids[index] ||
+	    !atomic_load(&st->stream_active[index]))) ||
+	    s->enc_start_uncertain || s->fs_start_uncertain)
+		goto done;
+	for (int i = 0; i < st->stream_count; i++) {
+		if (i != index && st->streams[i].chn == s->chn)
+			goto done;
+		if (i == index || st->streams[i].fs_chn != s->fs_chn)
+			continue;
+		rvd_stream_t *j = &st->streams[i];
+		if (jpeg >= 0 || !j->is_jpeg || j->sensor_idx != 0 || !j->ring ||
+		    j->enc_cfg.codec != RSS_CODEC_JPEG)
+			goto done;
+		if (stopped_retry) {
+			if (st->enc_tids[i] || atomic_load(&st->stream_active[i]) ||
+			    j->enabled || j->fs_enabled || j->enc_start_uncertain || j->fs_start_uncertain)
+				goto done;
+		} else if (!st->enc_tids[i] || !atomic_load(&st->stream_active[i])) {
+			goto done;
+		}
+		/* JPEG worker-owned receive/uncertainty fields are inspected only
+		 * by checked stop after join, never raced during this preflight. */
+		jpeg = i;
+	}
+	if (st->jpeg_count < 0 || st->jpeg_count > RVD_MAX_JPEG)
+		goto done;
+	int paired_entries = 0;
+	for (int i = 0; i < st->jpeg_count; i++) {
+		int j = st->jpeg_streams[i];
+		if (j < 0 || j >= st->stream_count || !st->streams[j].is_jpeg)
+			goto done;
+		if (j == jpeg)
+			paired_entries++;
+	}
+	if (jpeg >= 0 && paired_entries != 1)
+		goto done;
+	if (!fps_sdk_readback(st, index, jpeg, 0, &current) ||
+	    s->enc_cfg.fps_num != current || s->enc_cfg.fps_den != 1 ||
+	    s->fs_cfg.fps_num != current || s->fs_cfg.fps_den != 1 ||
+	    (jpeg >= 0 && (st->streams[jpeg].fs_cfg.fps_num != current ||
+			   st->streams[jpeg].fs_cfg.fps_den != 1)))
+		goto done;
+	uint32_t ring_num = 0, ring_den = 0;
+	const rss_ring_header_t *header = rss_ring_get_header(s->ring);
+	if (!header || header->stream_id != (uint32_t)index ||
+	    header->codec != (uint32_t)s->enc_cfg.codec ||
+	    header->width != s->enc_cfg.width || header->height != s->enc_cfg.height ||
+	    rss_ring_get_fps(s->ring, &ring_num, &ring_den) != 0 ||
+	    ring_num != current || ring_den != 1 ||
+	    rss_ring_check_video_fps(s->ring, set ? requested : current) != 0)
+		goto done;
+	bool related = s->fs_chn == st->ivs_fs_chn;
+	if (stopped_retry && related && (atomic_load(&st->ivs_active) ||
+	    st->ivs_tid || st->ivs_receiving))
+		goto done;
+	if (related && ivs_stream_check(st, true) != RSS_OK)
+		goto done;
+	if (!set) {
+		error = NULL;
+		applied = 1;
+		persisted = fps_saved(st, s, current);
+		goto done;
+	}
+	uint32_t sensor_num = 0, sensor_den = 0;
+	if (st->ops->isp_get_sensor_fps(st->hal_ctx, &sensor_num, &sensor_den) != RSS_OK ||
+	    !sensor_num || !sensor_den || (uint64_t)requested * sensor_den > sensor_num ||
+	    !fps_jpeg_readback(st, jpeg, requested))
+		goto done;
+	if (s->fps_persist_pending && requested != current) {
+		error = "retry persistence of the current FPS first";
+		goto done;
+	}
+	resume = related && st->ivs_stream_paused;
+	if (requested != current) {
+		error = "IVS pause failed before FPS mutation";
+		if (related && ivs_stream_pause(st, &resume) != RSS_OK)
+			goto done;
+		error = "JPEG stop failed before FPS mutation";
+		if (jpeg >= 0 && rvd_stream_stop(st, jpeg) != RSS_OK)
+			goto done;
+		error = "video stop failed before FPS mutation";
+		if (rvd_stream_stop(st, index) != RSS_OK)
+			goto done;
+		/* Checked stop must have released every shared owner. */
+		if (s->enabled || s->fs_enabled || st->enc_tids[index] ||
+		    (jpeg >= 0 && (st->streams[jpeg].enabled || st->enc_tids[jpeg])))
+			goto done;
+		uint32_t prior = current;
+		s->fps_uncertain = true; /* First call may partially mutate attributes. */
+		applied = -1;
+		error = "FS FPS mutation failed; recovery required";
+		if (st->ops->fs_set_fps(st->hal_ctx, s->fs_chn, requested, 1) != RSS_OK)
+			goto uncertain;
+		error = "encoder FPS mutation failed; recovery required";
+		if (st->ops->enc_set_fps(st->hal_ctx, s->chn, requested, 1) != RSS_OK)
+			goto uncertain;
+		error = "stopped FPS readback failed; recovery required";
+		if (fps_readback_phase(st, index, jpeg, requested, prior, "stopped", &current) < 0)
+			goto uncertain;
+		/* Only this synchronous transaction may restart known stopped owners
+		 * after successful setters and unchanged FS/geometry/JPEG checks.
+		 * This is not a rate commit: either SDK getter may still show prior.
+		 * Every restart/convergence failure re-latches recovery below. */
+		s->fps_uncertain = false;
+		error = "video FPS restart failed; recovery required";
+		if (rvd_stream_start(st, index) != RSS_OK)
+			goto uncertain;
+		error = "JPEG FPS restart failed; recovery required";
+		if (jpeg >= 0 && rvd_stream_start(st, jpeg) != RSS_OK)
+			goto uncertain;
+		error = "final FPS readback failed; recovery required";
+		if (!fps_wait_readback(st, index, jpeg, requested, prior, &current))
+			goto uncertain;
+	}
+	applied = 1; /* SDK configuration, never physical cadence/GOP acceptance. */
+	if (ring_num != requested) {
+		error = "video FPS metadata commit failed; recovery required";
+		if (rss_ring_set_video_fps(s->ring, requested) != 0 ||
+		    rss_ring_get_fps(s->ring, &ring_num, &ring_den) != 0 ||
+		    ring_num != requested || ring_den != 1)
+			goto uncertain;
+	}
+	s->enc_cfg.fps_num = requested;
+	s->enc_cfg.fps_den = 1;
+	s->fs_cfg.fps_num = requested;
+	s->fs_cfg.fps_den = 1;
+	if (jpeg >= 0) {
+		st->streams[jpeg].fs_cfg.fps_num = requested;
+		st->streams[jpeg].fs_cfg.fps_den = 1;
+	}
+	char expected[12];
+	snprintf(expected, sizeof(expected), "%u", requested);
+	bool cached = strcmp(rss_config_get_str(st->cfg, s->cfg_sect, "fps", ""), expected) == 0;
+	if (!cached || fps_saved(st, s, requested) != 1) {
+		s->fps_persist_pending = true;
+		error = "FPS live applied; config cache update failed";
+		rss_config_set_int(st->cfg, s->cfg_sect, "fps", (int)requested);
+		if (strcmp(rss_config_get_str(st->cfg, s->cfg_sect, "fps", ""), expected) != 0)
+			goto done;
+		error = "FPS live applied; persistence unconfirmed";
+		if (rss_config_save(st->cfg, st->config_path) != 0 ||
+		    fps_saved(st, s, requested) != 1)
+			goto done;
+	}
+	s->fps_persist_pending = false;
+	persisted = 1;
+	error = "FPS applied and persisted; IVS resume failed";
+	/* A persistence-only retry preserves an explicit stream stop. */
+	if (!stopped_retry && related && ivs_stream_resume(st, resume) != RSS_OK)
+		goto done;
+	error = NULL;
+	goto done;
+
+uncertain:
+	s->fps_uncertain = true;
+	/* Release only known lifecycle owners. No attribute rollback or second
+	 * RMW can reinterpret changed geometry as a new valid baseline. */
+	if (jpeg >= 0)
+		(void)rvd_stream_stop(st, jpeg);
+	(void)rvd_stream_stop(st, index);
+done:
+	return fps_response(st, index, semantic, error, applied, persisted, current, resp, size);
+}
