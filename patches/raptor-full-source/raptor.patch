diff --git a/tests/test_osd_metadata_snapshot.c b/tests/test_osd_metadata_snapshot.c
new file mode 100644
index 0000000000000000000000000000000000000000..88cbe28bbbe0115aedea1c6d2c6f431ea504b3a3
--- /dev/null
+++ b/tests/test_osd_metadata_snapshot.c
@@ -0,0 +1,123 @@
+#include "../osd_metadata_snapshot.h"
+
+#include <rss_sei.h>
+
+#include <assert.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+static void overwrite_snapshot(const char *directory)
+{
+	char path[256];
+	int length = snprintf(path, sizeof(path), "%s/osd-metadata-0.snapshot", directory);
+	assert(length > 0 && (size_t)length < sizeof(path));
+	int fd = open(path, O_WRONLY | O_TRUNC);
+	assert(fd >= 0);
+	assert(write(fd, "bad", 3) == 3);
+	assert(close(fd) == 0);
+}
+
+static void test_snapshot_states(const char *directory)
+{
+	const char json[] = "{\"v\":1,\"elements\":[]}";
+	osd_metadata_snapshot_t snapshot;
+	assert(osd_metadata_snapshot_write(directory, 0, 0, 100, true, json,
+					   strlen(json)) == -EINVAL);
+	assert(osd_metadata_snapshot_write(directory, 0, 1, 100, true, "not-json",
+					   strlen("not-json")) == -EINVAL);
+	assert(osd_metadata_snapshot_write(directory, 0, 7, 100, true, json,
+					   strlen(json)) == 0);
+	assert(osd_metadata_snapshot_read(directory, 0, 101, OSD_METADATA_MAX_AGE_US,
+					  &snapshot) == 0);
+	assert(snapshot.generation == 7 && strcmp(snapshot.json, json) == 0);
+
+	assert(osd_metadata_snapshot_write(directory, 0, 8, 200, false, NULL, 0) == 0);
+	assert(osd_metadata_snapshot_read(directory, 0, 201, OSD_METADATA_MAX_AGE_US,
+					  &snapshot) == -ENODATA);
+	assert(osd_metadata_snapshot_write(directory, 0, 9, 300, true, NULL, 0) == 0);
+	assert(osd_metadata_snapshot_read(directory, 0, 301, OSD_METADATA_MAX_AGE_US,
+					  &snapshot) == -ENODATA);
+
+	assert(osd_metadata_snapshot_write(directory, 0, 10, 400, true, json,
+					   strlen(json)) == 0);
+	assert(osd_metadata_snapshot_read(directory, 0, 400 + OSD_METADATA_MAX_AGE_US + 1,
+					  OSD_METADATA_MAX_AGE_US, &snapshot) == -ESTALE);
+	overwrite_snapshot(directory);
+	assert(osd_metadata_snapshot_read(directory, 0, 401, OSD_METADATA_MAX_AGE_US,
+					  &snapshot) == -EBADMSG);
+}
+
+static void test_late_reader_and_insert(const char *directory)
+{
+	const char json[] = "{\"v\":1,\"elements\":[{\"name\":\"clock\",\"text\":\"12:34\"}]}";
+	assert(osd_metadata_snapshot_write(directory, 0, 11, 500, true, json,
+					   strlen(json)) == 0);
+
+	uint8_t annexb[OSD_METADATA_SEI_MAX];
+	uint32_t generation = 0;
+	int annexb_len = osd_metadata_snapshot_read_sei(
+		directory, 0, 501, RSS_SEI_CODEC_H264, RSS_SEI_PREFIX_ANNEXB, annexb,
+		sizeof(annexb), &generation);
+	assert(annexb_len > 0 && generation == 11);
+	assert(memcmp(annexb, "\0\0\0\1\6", 5) == 0);
+	const uint8_t h264_vcl[] = {0, 0, 0, 1, 0x65, 0x88};
+	uint8_t access_unit[OSD_METADATA_SEI_MAX + sizeof(h264_vcl)];
+	memcpy(access_unit, annexb, (size_t)annexb_len);
+	memcpy(access_unit + annexb_len, h264_vcl, sizeof(h264_vcl));
+	assert(memcmp(access_unit + annexb_len, h264_vcl, sizeof(h264_vcl)) == 0);
+
+	uint8_t avcc[OSD_METADATA_SEI_MAX];
+	int avcc_len = osd_metadata_snapshot_read_sei(
+		directory, 0, 501, RSS_SEI_CODEC_H265, RSS_SEI_PREFIX_AVCC, avcc,
+		sizeof(avcc), &generation);
+	assert(avcc_len > 0 && generation == 11);
+	uint32_t declared = ((uint32_t)avcc[0] << 24) | ((uint32_t)avcc[1] << 16) |
+			    ((uint32_t)avcc[2] << 8) | avcc[3];
+	assert(declared == (uint32_t)avcc_len - 4);
+	const uint8_t h265_vcl[] = {0, 0, 0, 3, 0x26, 0x01, 0xaa};
+	memcpy(access_unit, avcc, (size_t)avcc_len);
+	memcpy(access_unit + avcc_len, h265_vcl, sizeof(h265_vcl));
+	assert(memcmp(access_unit + avcc_len, h265_vcl, sizeof(h265_vcl)) == 0);
+}
+
+static void test_unknown_runtime_objects(const char *directory)
+{
+	char final_path[256];
+	int length = snprintf(final_path, sizeof(final_path),
+			      "%s/osd-metadata-1.snapshot", directory);
+	assert(length > 0 && (size_t)length < sizeof(final_path));
+	assert(mkfifo(final_path, 0600) == 0);
+	osd_metadata_snapshot_t snapshot;
+	assert(osd_metadata_snapshot_read(directory, 1, 100, OSD_METADATA_MAX_AGE_US,
+					  &snapshot) == -EBADMSG);
+	const char json[] = "{\"v\":1}";
+	assert(osd_metadata_snapshot_write(directory, 1, 1, 100, true, json,
+					   strlen(json)) == -EBADMSG);
+	struct stat statbuf;
+	assert(lstat(final_path, &statbuf) == 0 && S_ISFIFO(statbuf.st_mode));
+	assert(unlink(final_path) == 0);
+
+	char temporary_path[256];
+	length = snprintf(temporary_path, sizeof(temporary_path),
+			  "%s/.osd-metadata-2.%ld.1.tmp", directory, (long)getpid());
+	assert(length > 0 && (size_t)length < sizeof(temporary_path));
+	assert(mkfifo(temporary_path, 0600) == 0);
+	assert(osd_metadata_snapshot_write(directory, 2, 1, 100, true, json,
+					   strlen(json)) == -EEXIST);
+	assert(lstat(temporary_path, &statbuf) == 0 && S_ISFIFO(statbuf.st_mode));
+	assert(unlink(temporary_path) == 0);
+}
+
+int main(int argc, char **argv)
+{
+	assert(argc == 2);
+	test_snapshot_states(argv[1]);
+	test_unknown_runtime_objects(argv[1]);
+	test_late_reader_and_insert(argv[1]);
+	puts("OSD metadata snapshot states, runtime objects, late reader and SEI insert passed");
+	return 0;
+}
diff --git a/tests/test_osd_snapshot.c b/tests/test_osd_snapshot.c
new file mode 100644
index 0000000000000000000000000000000000000000..1073c92dabb519b6e6330065a8f76cecafadfb06
--- /dev/null
+++ b/tests/test_osd_snapshot.c
@@ -0,0 +1,127 @@
+#include "rvd.h"
+#include "../osd_snapshot.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+struct rss_osd_shm {
+    uint8_t pixels[16];
+    uint32_t width, height;
+};
+static int updates, shows, fail_update, fail_show;
+static rss_osd_shm_t *mutate_after_preflight;
+static int buffer_reads;
+const uint8_t *rss_osd_get_active_buffer(rss_osd_shm_t *shm, uint32_t *width, uint32_t *height)
+{
+    /* The second target is read only after the first target's SHM hash.
+     * Model ROD resuming after timeout before RVD copies the first target. */
+    if (++buffer_reads == 2 && mutate_after_preflight)
+        mutate_after_preflight->pixels[0] ^= 0x80;
+    *width = shm->width;
+    *height = shm->height;
+    return shm->pixels;
+}
+static int update(void *ctx, int handle, const uint8_t *pixels)
+{
+    (void)ctx;
+    (void)handle;
+    assert(pixels);
+    updates++;
+    return fail_update ? RSS_ERR : RSS_OK;
+}
+static int show(void *ctx, int handle, int group, int visible, int layer)
+{
+    (void)ctx;
+    (void)handle;
+    (void)group;
+    (void)layer;
+    assert(visible == 1);
+    shows++;
+    return fail_show ? RSS_ERR : RSS_OK;
+}
+static int isp_update(void *ctx, int sensor, int handle, int channel, const rss_osd_region_t *attr)
+{
+    (void)sensor;
+    (void)channel;
+    return update(ctx, handle, attr->bitmap_data);
+}
+static int isp_show(void *ctx, int sensor, int handle, int visible)
+{
+    return show(ctx, handle, sensor, visible, 0);
+}
+static void apply(rvd_state_t *st, uint32_t hash, bool success)
+{
+    char request[512], response[512];
+    snprintf(request, sizeof(request),
+             "{\"cmd\":\"osd-apply-snapshot\",\"id\":\"a123\",\"regions\":["
+             "{\"stream\":0,\"name\":\"timestamp\",\"width\":2,\"height\":2,\"hash\":%u},"
+             "{\"stream\":1,\"name\":\"timestamp\",\"width\":2,\"height\":2,\"hash\":%u}]}", hash, hash);
+    assert(rvd_osd_apply_snapshot(st, request, response, sizeof(response)) > 0);
+    cJSON *root = cJSON_Parse(response);
+    const cJSON *status = cJSON_GetObjectItemCaseSensitive(root, "status");
+    assert(cJSON_IsString(status));
+    assert((strcmp(status->valuestring, "ok") == 0) == success);
+    cJSON_Delete(root);
+}
+int main(void)
+{
+    rss_hal_ops_t ops = {.osd_update_region_data = update, .osd_show_region = show,
+                        .isp_osd_set_region_attr = isp_update, .isp_osd_show_region = isp_show};
+    for (int isp = 0; isp < 2; ++isp) {
+        struct rss_osd_shm shm = {.pixels = {1, 2, 3, 4}, .width = 2, .height = 2};
+        struct rss_osd_shm second_shm = shm;
+        uint8_t local[2][16] = {{0}};
+        rvd_state_t st = {.ops = &ops, .osd_enabled = true, .use_isp_osd = isp != 0,
+                          .stream_count = 2, .pipeline_ready = true};
+        assert(pthread_mutex_init(&st.osd_lock, NULL) == 0);
+        for (int s = 0; s < 2; ++s) {
+            snprintf(st.streams[s].cfg_sect, sizeof(st.streams[s].cfg_sect), "stream%d", s);
+            st.streams[s].fs_chn = s;
+            st.streams[s].enc_cfg.width = 640;
+            st.streams[s].enc_cfg.height = 360;
+            st.osd_region_count[s] = 1;
+            st.osd_regions[s][0] = (rvd_osd_region_t){.shm = s == 0 ? &shm : &second_shm, .hal_handle = s,
+                .width = 2, .height = 2, .local_buf = local[s], .active = true};
+            strcpy(st.osd_regions[s][0].name, "timestamp");
+        }
+        uint32_t hash = osd_snapshot_hash(shm.pixels, sizeof(shm.pixels));
+        updates = shows = 0;
+        apply(&st, hash ^ 1u, false);
+        assert(updates == 0 && shows == 0);
+        st.osd_regions[1][0].hal_handle = -1;
+        apply(&st, hash, false);
+        assert(updates == 0 && shows == 0);
+        st.osd_regions[1][0].hal_handle = 1;
+        buffer_reads = 0;
+        mutate_after_preflight = &shm;
+        apply(&st, hash, false);
+        assert(updates == 0 && shows == 0 && !st.osd_apply_id[0]);
+        assert(atomic_load(&st.osd_apply_failed));
+        mutate_after_preflight = NULL;
+        shm.pixels[0] ^= 0x80;
+        fail_update = 1;
+        apply(&st, hash, false);
+        assert(updates == 1 && shows == 0 && !st.osd_apply_id[0]);
+        fail_update = 0;
+        fail_show = 1;
+        apply(&st, hash, false);
+        assert(shows == 1 && !st.osd_apply_id[0]);
+        fail_show = 0;
+        apply(&st, hash, true);
+        assert(strcmp(st.osd_apply_id, "a123") == 0 && !atomic_load(&st.osd_apply_failed));
+        assert(memcmp(local[0], shm.pixels, 16) == 0 && memcmp(local[1], shm.pixels, 16) == 0);
+        char response[512];
+        assert(rvd_osd_apply_state(&st, response, sizeof(response)) > 0);
+        cJSON *root = cJSON_Parse(response);
+        assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(root, "accepted")));
+        cJSON_Delete(root);
+        atomic_store(&st.osd_apply_failed, true);
+        assert(rvd_osd_apply_state(&st, response, sizeof(response)) > 0);
+        root = cJSON_Parse(response);
+        assert(cJSON_IsFalse(cJSON_GetObjectItemCaseSensitive(root, "accepted")));
+        cJSON_Delete(root);
+        pthread_mutex_destroy(&st.osd_lock);
+    }
+    puts("OSD snapshot preflight, checked SDK application and independent receipt passed");
+    return 0;
+}
diff --git a/tests/test_prebuf.c b/tests/test_prebuf.c
index 72d359bac9f5face3d2c58191235b183ac752c02..d5754569c791c0799267ddf94c7884cf950d454e 100644
--- a/tests/test_prebuf.c
+++ b/tests/test_prebuf.c
@@ -2,6 +2,7 @@
 #include "rmr_prebuf.h"
 
 #include <string.h>
+#include <limits.h>
 
 TEST prebuf_push_count(void)
 {
@@ -218,6 +219,165 @@ TEST prebuf_data_wrap(void)
 	PASS();
 }
 
+struct expected_frame {
+	int64_t timestamp;
+	uint32_t len;
+	uint8_t key;
+	uint8_t data[8];
+};
+
+struct verify_frames {
+	const struct expected_frame *frames;
+	int expected;
+	int count;
+	bool failed;
+};
+
+static int verify_frame(const rmr_prebuf_slot_t *slot, const uint8_t *data, void *arg)
+{
+	struct verify_frames *v = arg;
+	if (v->count >= v->expected) {
+		v->failed = true;
+		return -1;
+	}
+	const struct expected_frame *e = &v->frames[v->count];
+	if (slot->timestamp != e->timestamp || slot->data_length != e->len ||
+	    slot->is_key != e->key || memcmp(data, e->data, e->len) != 0) {
+		v->failed = true;
+		return -1;
+	}
+	v->count++;
+	return 0;
+}
+
+static bool verify_history(rmr_prebuf_t *pb, const struct expected_frame *frames, int count)
+{
+	struct verify_frames v = {.frames = frames, .expected = count};
+	uint32_t oldest = pb->write_idx - pb->count;
+	int result = rmr_prebuf_iterate(pb, oldest, verify_frame, &v);
+	return result == count && v.count == count && !v.failed;
+}
+
+static void push_expected(rmr_prebuf_t *pb, const struct expected_frame *f)
+{
+	rmr_prebuf_push(pb, f->data, f->len, f->timestamp, f->key);
+}
+
+TEST prebuf_overwritten_payload_evicts_descriptor(void)
+{
+	rmr_prebuf_t *pb = rmr_prebuf_create(8, 8);
+	ASSERT(pb);
+	/* Video-like A/C and nonuniform audio-like B payloads. C wraps over A;
+	 * B starts exactly where C ends and must survive with its own metadata. */
+	const struct expected_frame frames[] = {
+		{1000, 3, 1, {0, 0, 1}},
+		{2000, 3, 0, {0x80, 0x81, 0x82}},
+		{3000, 3, 0, {0, 0, 2}},
+		{4000, 8, 1, {1, 2, 3, 4, 5, 6, 7, 8}},
+	};
+	for (int i = 0; i < 3; i++)
+		push_expected(pb, &frames[i]);
+	ASSERT_EQ(2u, pb->count);
+	ASSERT(verify_history(pb, frames + 1, 2));
+	ASSERT_EQ(UINT32_MAX, rmr_prebuf_find_keyframe(pb, 5000));
+	ASSERT_EQ(2000, rmr_prebuf_timestamp(pb, rmr_prebuf_find_frame_at(pb, 0)));
+	push_expected(pb, &frames[3]); /* One full-size frame evicts all old data. */
+	ASSERT_EQ(1u, pb->count);
+	ASSERT(verify_history(pb, frames + 3, 1));
+	ASSERT_EQ(4000, rmr_prebuf_timestamp(pb, rmr_prebuf_find_keyframe(pb, 5000)));
+	rmr_prebuf_destroy(pb);
+	PASS();
+}
+
+TEST prebuf_wrap_gap_and_touching_boundaries(void)
+{
+	rmr_prebuf_t *pb = rmr_prebuf_create(8, 10);
+	ASSERT(pb);
+	const struct expected_frame f[] = {
+		{1, 4, 1, {1, 2, 3, 4}},
+		{2, 4, 0, {5, 6, 7, 8}},
+		{3, 3, 1, {9, 10, 11}},
+		{4, 1, 0, {12}},
+		{5, 5, 0, {13, 14, 15, 16, 17}},
+	};
+	for (int i = 0; i < 4; i++)
+		push_expected(pb, &f[i]);
+	ASSERT_EQ(3u, pb->count);
+	ASSERT(verify_history(pb, f + 1, 3)); /* B@4..8 C@0..3 D@3..4. */
+	push_expected(pb, &f[4]); /* E@4..9 evicts B; boundary-touching D survives. */
+	ASSERT_EQ(3u, pb->count);
+	ASSERT(verify_history(pb, f + 2, 3));
+	ASSERT_EQ(3, rmr_prebuf_timestamp(pb, rmr_prebuf_find_keyframe(pb, 100)));
+	rmr_prebuf_destroy(pb);
+	PASS();
+}
+
+TEST prebuf_capacity_and_data_eviction_compose(void)
+{
+	const struct expected_frame f[] = {
+		{1, 3, 1, {1, 2, 3}}, {2, 3, 0, {4, 5, 6}}, {3, 3, 1, {7, 8, 9}},
+	};
+	const uint32_t sizes[] = {6, 32};
+	for (size_t i = 0; i < sizeof(sizes) / sizeof(sizes[0]); i++) {
+		rmr_prebuf_t *pb = rmr_prebuf_create(2, sizes[i]);
+		ASSERT(pb);
+		for (int j = 0; j < 3; j++)
+			push_expected(pb, &f[j]);
+		ASSERT_EQ(2u, pb->count);
+		ASSERT(verify_history(pb, f + 1, 2));
+		rmr_prebuf_destroy(pb);
+	}
+	PASS();
+}
+
+TEST prebuf_head_addition_cannot_wrap_past_bounds(void)
+{
+	rmr_prebuf_t *pb = rmr_prebuf_create(8, 8);
+	ASSERT(pb);
+	/* Synthetic head makes offset+len wrap uint32. No large allocation is
+	 * needed: the checked subtraction must restart at offset zero. */
+	pb->data_head = UINT32_MAX - 1;
+	const struct expected_frame f = {1, 3, 1, {1, 2, 3}};
+	push_expected(pb, &f);
+	ASSERT_EQ(3u, pb->data_head);
+	ASSERT(verify_history(pb, &f, 1));
+	rmr_prebuf_destroy(pb);
+	PASS();
+}
+
+TEST prebuf_video_slot_budget_is_bounded(void)
+{
+	ASSERT_EQ(0u, rmr_prebuf_video_slots(INT_MIN));
+	ASSERT_EQ(0u, rmr_prebuf_video_slots(0));
+	const uint32_t expected[] = {0, 64, 128, 128, 256, 256};
+	for (int sec = 1; sec <= 5; sec++)
+		ASSERT_EQ(expected[sec], rmr_prebuf_video_slots(sec));
+	ASSERT_EQ(256u, rmr_prebuf_video_slots(INT_MAX));
+	PASS();
+}
+
+TEST prebuf_five_to_thirty_fps_keeps_slot_history(void)
+{
+	rmr_prebuf_t *pb = rmr_prebuf_create(rmr_prebuf_video_slots(5), 4096);
+	ASSERT(pb);
+	uint8_t data = 1;
+	for (int i = 0; i < 25; i++)
+		rmr_prebuf_push(pb, &data, 1, (int64_t)i * 200000, i % 5 == 0);
+	for (int i = 0; i < 150; i++)
+		rmr_prebuf_push(pb, &data, 1, 5000000 + (int64_t)i * 1000000 / 30,
+				i % 30 == 0);
+	ASSERT_EQ(175u, pb->count);
+	uint32_t start = rmr_prebuf_find_keyframe(pb, 5000000);
+	ASSERT(start != UINT32_MAX);
+	int64_t age = rmr_prebuf_timestamp(pb, rmr_prebuf_newest(pb)) -
+		      rmr_prebuf_timestamp(pb, start);
+	ASSERT(age >= 5000000);
+	printf("video metadata slots: %u bytes each; 5 FPS/5s 32 -> 256 adds %zu bytes\n",
+	       (unsigned)sizeof(rmr_prebuf_slot_t), 224 * sizeof(rmr_prebuf_slot_t));
+	rmr_prebuf_destroy(pb);
+	PASS();
+}
+
 SUITE(prebuf_suite)
 {
 	RUN_TEST(prebuf_push_count);
@@ -229,4 +389,10 @@ SUITE(prebuf_suite)
 	RUN_TEST(prebuf_iterate_data);
 	RUN_TEST(prebuf_no_keyframe);
 	RUN_TEST(prebuf_data_wrap);
+	RUN_TEST(prebuf_overwritten_payload_evicts_descriptor);
+	RUN_TEST(prebuf_wrap_gap_and_touching_boundaries);
+	RUN_TEST(prebuf_capacity_and_data_eviction_compose);
+	RUN_TEST(prebuf_head_addition_cannot_wrap_past_bounds);
+	RUN_TEST(prebuf_video_slot_budget_is_bounded);
+	RUN_TEST(prebuf_five_to_thirty_fps_keeps_slot_history);
 }
diff --git a/tests/test_privacy_control.c b/tests/test_privacy_control.c
new file mode 100644
index 0000000000000000000000000000000000000000..50a2f5946dc9661e2fd1bff718b8815c7e4eee86
--- /dev/null
+++ b/tests/test_privacy_control.c
@@ -0,0 +1,64 @@
+#include "rvd.h"
+#include <assert.h>
+#include <string.h>
+#include <stdio.h>
+static int next_handle;
+static int fail_call;
+static int calls;
+static int hidden;
+static int call(void) { return ++calls == fail_call ? -7 : 0; }
+static int create(void *ctx, int *handle, const rss_osd_region_t *attr)
+{
+    (void)ctx; (void)attr;
+    int ret = call();
+    if (!ret) *handle = next_handle++;
+    return ret;
+}
+static int region(void *ctx, int handle, int group)
+{ (void)ctx; (void)handle; (void)group; return call(); }
+static int destroy(void *ctx, int handle)
+{ (void)ctx; (void)handle; return call(); }
+static int show(void *ctx, int handle, int group, int enabled, int layer)
+{
+    (void)ctx; (void)handle; (void)group; (void)layer;
+    if (!enabled) hidden++;
+    return call();
+}
+static int idr(void *ctx, int ch) { (void)ctx; (void)ch; return call(); }
+const char *rss_config_get_str(rss_config_t *cfg, const char *section, const char *key, const char *fallback)
+{ (void)cfg; (void)section; (void)key; return fallback; }
+static rss_hal_ops_t ops = {
+    .osd_create_region = create, .osd_register_region = region,
+    .osd_unregister_region = region, .osd_destroy_region = destroy,
+    .osd_show_region = show, .enc_request_idr = idr,
+};
+int main(void)
+{
+    for (int failure = 1; failure <= 7; failure++) {
+        rvd_state_t st = {0};
+        st.ops = &ops;
+        st.osd_enabled = true;
+        st.stream_count = 1;
+        st.streams[0].enabled = true;
+        st.streams[0].enc_cfg.width = 1920;
+        st.streams[0].enc_cfg.height = 1080;
+        st.privacy_handles[0] = st.privacy_handles_extra[0] = -1;
+        pthread_mutex_init(&st.osd_lock, NULL);
+        next_handle = calls = hidden = 0;
+        fail_call = failure;
+        assert(rvd_osd_set_privacy(&st, true, -1) == -7);
+        assert(st.privacy_error[0] && !st.privacy[0]);
+        assert(hidden == 0);
+        fail_call = 0;
+        assert(rvd_osd_set_privacy(&st, true, -1) == 0);
+        assert(st.privacy[0] && !st.privacy_error[0]);
+        assert(next_handle == 2);
+        assert(rvd_osd_set_privacy(&st, true, -1) == 0);
+        assert(next_handle == 2);
+        assert(rvd_osd_set_privacy(&st, false, -1) == 0);
+        assert(!st.privacy[0] && !st.privacy_error[0]);
+        assert(rvd_osd_set_privacy(&st, false, -1) == 0);
+        pthread_mutex_destroy(&st.osd_lock);
+    }
+    puts("Privacy mask failure and retry tests passed");
+}
diff --git a/tests/test_privacy_startup.c b/tests/test_privacy_startup.c
new file mode 100644
index 0000000000000000000000000000000000000000..ea7f538598086fb9ae1f2ace42b85960e3332af1
--- /dev/null
+++ b/tests/test_privacy_startup.c
@@ -0,0 +1,253 @@
+/* Actual startup and control owners with observable SDK/publication boundaries. */
+#include "rvd.h"
+#include "rhd.h"
+#include <assert.h>
+#include <string.h>
+#include <errno.h>
+
+static int calls, fail_call, handles, publishers, hidden;
+static int peer_error, listeners;
+static bool peer_audio, peer_jpeg;
+static rvd_state_t *owner;
+
+static int step(void)
+{
+    return ++calls == fail_call ? RSS_ERR : RSS_OK;
+}
+
+static int create_region(void *ctx, int *handle, const rss_osd_region_t *attr)
+{
+    (void)ctx;
+    assert(attr->type == RSS_OSD_COVER && attr->width == 1920);
+    int ret = step();
+    if (ret == RSS_OK)
+        *handle = handles++;
+    return ret;
+}
+
+static int region(void *ctx, int handle, int group)
+{
+    (void)ctx;
+    assert(handle >= 0 && group == 0);
+    return step();
+}
+
+static int destroy_region(void *ctx, int handle)
+{
+    (void)ctx;
+    assert(handle >= 0);
+    return step();
+}
+
+static int show_region(void *ctx, int handle, int group, int enabled, int layer)
+{
+    (void)layer;
+    if (!enabled)
+        hidden++;
+    return region(ctx, handle, group);
+}
+
+static int start_media(void *ctx, int channel)
+{
+    (void)ctx;
+    (void)channel;
+    assert(!owner->privacy_requested[0] ||
+           (owner->privacy[0] && owner->privacy_shown[0][0] && owner->privacy_shown[0][1]));
+    publishers++;
+    return RSS_OK;
+}
+
+static int request_idr(void *ctx, int channel)
+{
+    (void)ctx;
+    (void)channel;
+    return step();
+}
+
+void *rvd_encoder_thread(void *arg)
+{
+    (void)arg;
+    assert(false);
+    return NULL;
+}
+
+void rss_daemon_request_shutdown(void) { assert(false); }
+/* This suite never injects worker-creation errors. Cleanup is exercised by
+ * test_stream_stop.c with the actual production stop implementation. */
+int rvd_stream_stop(rvd_state_t *st, int idx) {
+    (void)st;
+    (void)idx;
+    assert(false);
+    return RSS_ERR;
+}
+
+static int start_thread(pthread_t *thread, const pthread_attr_t *attr,
+                        void *(*entry)(void *), void *arg)
+{
+    *thread = (pthread_t)(uintptr_t)1;
+    (void)attr;
+    (void)arg;
+    assert(entry == rvd_encoder_thread);
+    return start_media(NULL, 0);
+}
+
+int rvd_privacy_required(rvd_state_t *st, const char *section, const char *socket)
+{
+    (void)st;
+    (void)section;
+    (void)socket;
+    return 1;
+}
+
+int rvd_privacy_participant(rvd_state_t *st, const char *section, const char *socket,
+                            const char *command)
+{
+    (void)st;
+    (void)socket;
+    if (strcmp(section, "audio") == 0)
+        peer_audio = strstr(command, "unmute") == NULL;
+    else
+        peer_jpeg = strstr(command, "off") == NULL;
+    return peer_error;
+}
+
+static int privacy_test_listen(rss_config_t *cfg, int port)
+{
+    (void)cfg;
+    (void)port;
+    listeners++;
+    return 123;
+}
+
+#define pthread_create start_thread
+#include "native_privacy_commands.h"
+#undef pthread_create
+
+static rss_hal_ops_t ops = {
+    .osd_create_region = create_region, .osd_register_region = region,
+    .osd_unregister_region = region, .osd_destroy_region = destroy_region,
+    .osd_show_region = show_region, .enc_request_idr = request_idr,
+    .fs_enable_channel = start_media, .fs_disable_channel = start_media,
+    .enc_start = start_media, .enc_stop = start_media,
+};
+
+static void setup(rvd_state_t *st, rss_config_t *cfg)
+{
+    memset(st, 0, sizeof(*st));
+    st->cfg = cfg;
+    st->ops = &ops;
+    st->osd_enabled = true;
+    st->stream_count = 2;
+    st->streams[0].enc_cfg.width = 1920;
+    st->streams[0].enc_cfg.height = 1080;
+    st->streams[1].is_jpeg = true;
+    st->streams[1].jpeg_idle = true;
+    st->privacy_handles[0] = st->privacy_handles_extra[0] = -1;
+    st->privacy_target_ready[0] = true;
+    pthread_mutex_init(&st->osd_lock, NULL);
+    owner = st;
+    calls = fail_call = handles = publishers = hidden = peer_error = 0;
+}
+
+static void command(rvd_state_t *st, const char *request, bool success)
+{
+    char reply[2048];
+    assert(native_privacy_command(st, request, reply, sizeof(reply)) > 0);
+    cJSON *root = cJSON_Parse(reply);
+    assert(root);
+    const cJSON *status = cJSON_GetObjectItemCaseSensitive(root, "status");
+    assert(cJSON_IsString(status));
+    assert((strcmp(status->valuestring, "ok") == 0) == success);
+    cJSON_Delete(root);
+}
+
+int main(int argc, char **argv)
+{
+    assert(argc == 2);
+    FILE *file = fopen(argv[1], "w");
+    assert(file && fputs("[privacy]\nenabled=true\n", file) >= 0 && fclose(file) == 0);
+    rss_config_t *cfg = rss_config_load(argv[1]);
+    assert(cfg);
+    /* Independent daemon config snapshots must agree in either startup order. */
+    for (int order = 0; order < 2; ++order) {
+        rvd_state_t st;
+        setup(&st, cfg);
+        rss_config_t *http_cfg = rss_config_load(argv[1]);
+        rhd_server_t http = {.cfg = http_cfg, .privacy_jpeg_len = 1};
+        if (order == 0)
+            assert(native_http_start(&http) == 0 && http.privacy);
+        assert(rvd_privacy_load(&st) == RSS_OK && st.privacy_requested[0]);
+        if (order == 1)
+            assert(native_http_start(&http) == 0 && http.privacy);
+        assert(rvd_stream_start(&st, 1) != RSS_OK && publishers == 0);
+        assert(rvd_stream_start(&st, 0) == RSS_OK && publishers == 3);
+        assert(rvd_stream_start(&st, 1) == RSS_OK && publishers == 4);
+        assert(st.privacy[0] && handles == 2 && hidden == 0);
+        rss_config_free(http_cfg);
+        pthread_mutex_destroy(&st.osd_lock);
+    }
+    /* Fail each create/register/show step. Neither video nor JPEG may start. */
+    for (int failure = 1; failure <= 6; ++failure) {
+        rvd_state_t st;
+        setup(&st, cfg);
+        assert(rvd_privacy_load(&st) == RSS_OK);
+        fail_call = failure;
+        assert(rvd_stream_start(&st, 0) != RSS_OK && publishers == 0);
+        assert(rvd_stream_start(&st, 1) != RSS_OK && publishers == 0);
+        assert(hidden == 0 && st.privacy_requested[0]);
+        fail_call = 0;
+        assert(rvd_stream_start(&st, 0) == RSS_OK && publishers == 3);
+        assert(handles == 2 && st.privacy[0]);
+        pthread_mutex_destroy(&st.osd_lock);
+    }
+    rvd_state_t st;
+    setup(&st, cfg);
+    assert(rvd_privacy_load(&st) == RSS_OK);
+    st.privacy_target_ready[0] = false;
+    assert(rvd_stream_start(&st, 0) != RSS_OK && publishers == 0 && calls == 0);
+    st.privacy_target_ready[0] = true;
+    st.osd_enabled = false;
+    assert(rvd_stream_start(&st, 0) != RSS_OK && publishers == 0 && calls == 0);
+    st.osd_enabled = true;
+    assert(rvd_stream_start(&st, 0) == RSS_OK);
+    command(&st, "{\"cmd\":\"set-privacy-config\",\"enabled\":false,\"channel\":0}", false);
+    assert(st.privacy[0]);
+    peer_error = RSS_ERR;
+    command(&st, "{\"cmd\":\"set-privacy-config\",\"enabled\":false}", false);
+    bool saved;
+    assert(rss_config_privacy(cfg, &saved) == 0 && saved);
+    peer_error = RSS_OK;
+    command(&st, "{\"cmd\":\"set-privacy-config\",\"enabled\":false}", true);
+    assert(!peer_audio && !peer_jpeg);
+    assert(rss_config_save(cfg, argv[1]) == 0);
+    rss_config_t *disk = rss_config_load(argv[1]);
+    assert(rss_config_privacy(disk, &saved) == 0 && !saved);
+    rhd_server_t http = {.cfg = disk};
+    assert(native_http_start(&http) == 0 && !http.privacy);
+    rss_config_free(disk);
+    rss_config_t *stale = rss_config_load(argv[1]);
+    command(&st, "{\"cmd\":\"set-privacy-config\",\"enabled\":true}", true);
+    assert(peer_audio && peer_jpeg && st.privacy[0]);
+    assert(rss_config_save(cfg, argv[1]) == 0);
+    /* A separately loaded daemon saving another dirty key cannot clear privacy. */
+    rss_config_set_int(stale, "http", "port", 8080);
+    assert(rss_config_save(stale, argv[1]) == 0);
+    rss_config_free(stale);
+    disk = rss_config_load(argv[1]);
+    assert(rss_config_privacy(disk, &saved) == 0 && saved);
+    http.cfg = disk;
+    int before_listen = listeners;
+    assert(native_http_start(&http) != 0 && http.privacy); /* Missing black frame. */
+    assert(listeners == before_listen);
+    rss_config_free(disk);
+    rss_config_set_str(cfg, "privacy", "enabled", "invalid");
+    assert(rvd_privacy_load(&st) != RSS_OK);
+    http.cfg = cfg;
+    http.privacy_jpeg_len = 1;
+    assert(native_http_start(&http) != 0 && http.privacy);
+    assert(listeners == before_listen);
+    rss_config_free(cfg);
+    pthread_mutex_destroy(&st.osd_lock);
+    puts("Privacy startup ordering, SDK failures, JPEG gate and persistent control passed");
+    return 0;
+}
diff --git a/tests/test_rac_flush.c b/tests/test_rac_flush.c
new file mode 100644
index 0000000000000000000000000000000000000000..4c92590ad20c00b832b54e5099c059f7aa6a1bbf
--- /dev/null
+++ b/tests/test_rac_flush.c
@@ -0,0 +1,105 @@
+#include "rac.h"
+#include <assert.h>
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+
+volatile sig_atomic_t g_running = 1;
+static int transport_error, binary_length;
+static const char *reply;
+static int ring_identity, created, published, destroyed;
+
+int rss_ctrl_send_command(const char *path, const char *command, char *buffer,
+                          int size, uint32_t timeout)
+{
+    assert(strcmp(path, RSS_RUN_DIR "/rad.sock") == 0);
+    assert(strcmp(command, "{\"cmd\":\"ao-flush\"}") == 0 && timeout == 500);
+    if (transport_error) {
+        return transport_error;
+    }
+    if (binary_length) {
+        assert(binary_length < size);
+        memcpy(buffer, reply, (size_t)binary_length);
+        buffer[binary_length] = '\0';
+        return binary_length;
+    }
+    assert((int)strlen(reply) < size);
+    strcpy(buffer, reply);
+    return (int)strlen(reply);
+}
+
+rss_ring_t *rss_ring_create(const char *name, uint32_t slots, uint32_t capacity)
+{
+    assert(strcmp(name, "speaker") == 0 && slots == 16 && capacity == 64 * 1024);
+    created++;
+    return (rss_ring_t *)&ring_identity;
+}
+
+void rss_ring_destroy(rss_ring_t *ring)
+{
+    assert(ring == (rss_ring_t *)&ring_identity);
+    destroyed++;
+}
+
+void rss_ring_set_stream_info(rss_ring_t *ring, uint32_t id, uint32_t codec,
+                              uint32_t width, uint32_t height, uint32_t rate,
+                              uint32_t channels, uint8_t profile, uint8_t level)
+{
+    assert(ring == (rss_ring_t *)&ring_identity && id == 0x11 && codec == 0);
+    assert(width == 0 && height == 0 && rate == 16000 && channels == 1);
+    assert(profile == 0 && level == 0);
+}
+
+uint32_t rss_ring_reader_count(rss_ring_t *ring)
+{
+    assert(ring == (rss_ring_t *)&ring_identity);
+    return 1;
+}
+
+int rss_ring_publish(rss_ring_t *ring, const uint8_t *data, uint32_t length,
+                     int64_t timestamp, uint16_t nal, uint8_t key)
+{
+    assert(ring == (rss_ring_t *)&ring_identity && data && length == 16);
+    assert(timestamp > 0 && nal == 0 && key == 0);
+    published++;
+    return 0;
+}
+
+int main(int argc, char **argv)
+{
+    assert(argc == 2);
+    FILE *file = fopen(argv[1], "wb");
+    assert(file);
+    char pcm[16] = {0};
+    assert(fwrite(pcm, 1, sizeof(pcm), file) == sizeof(pcm));
+    fclose(file);
+    const char *invalid[] = {
+        "", "{\"status\":\"error\"}", "{\"status\":\"ok\"}trailing", "{\"status\":true}",
+        "{\"status\":\"ok\",\"status\":\"error\"}", "{\"status\":\"ok\",\"pending\":true}",
+        "{\"status\":\"ok\\u0000ignored\"}", "{\"status\\u0000ignored\":\"ok\"}",
+    };
+    for (size_t i = 0; i < sizeof(invalid) / sizeof(invalid[0]); ++i) {
+        reply = invalid[i];
+        assert(cmd_play(argv[1], 16000) != 0);
+        assert(created == 0 && published == 0 && destroyed == 0);
+    }
+    const char embedded[] = "{\"status\":\"ok\"}\0{\"status\":\"error\"}";
+    reply = embedded;
+    binary_length = sizeof(embedded) - 1;
+    assert(cmd_play(argv[1], 16000) != 0 && created == 0 && published == 0);
+    binary_length = 0;
+    char oversized[256];
+    memset(oversized, ' ', sizeof(oversized) - 1);
+    memcpy(oversized, "{\"status\":\"ok\"}", 15);
+    oversized[sizeof(oversized) - 1] = '\0';
+    reply = oversized;
+    assert(cmd_play(argv[1], 16000) != 0 && created == 0);
+    reply = "{\"status\":\"ok\"}";
+    transport_error = -ETIMEDOUT;
+    assert(cmd_play(argv[1], 16000) != 0 && created == 0);
+    transport_error = 0;
+    assert(cmd_play(argv[1], 16000) == 0);
+    assert(created == 1 && published == 1 && destroyed == 1);
+    puts("Actual RAC playback refuses ring creation until a complete flush ack");
+    return 0;
+}
diff --git a/tests/test_rad_alc.c b/tests/test_rad_alc.c
new file mode 100644
index 0000000000000000000000000000000000000000..393782762eab4ad76d08f457619c301f83d0c83d
--- /dev/null
+++ b/tests/test_rad_alc.c
@@ -0,0 +1,162 @@
+#include "rad_state.h"
+#include "rad_level.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "native_alc_commands.h"
+
+#ifdef RAD_TEST_OWNER_LEVELS
+bool rad_output_ready(const rad_ctrl_ctx_t *ctx)
+{
+    (void)ctx;
+    return false; /* An exited worker must remain unknown, not disabled. */
+}
+
+static void owner_levels(rad_ctrl_ctx_t *ctx, bool unknown)
+{
+    char reply[1024];
+    assert(native_alc_command(ctx, "{\"cmd\":\"get-audio-observation-levels\"}", reply, sizeof(reply)) > 0);
+    cJSON *root = cJSON_Parse(reply);
+    assert(root);
+    cJSON *ai = cJSON_GetObjectItemCaseSensitive(root, "ai_enabled");
+    cJSON *ao = cJSON_GetObjectItemCaseSensitive(root, "ao_enabled");
+    assert(unknown ? cJSON_IsNull(ai) && cJSON_IsNull(ao) : cJSON_IsFalse(ai) && cJSON_IsFalse(ao));
+    cJSON *fields = cJSON_GetObjectItemCaseSensitive(root, "fields");
+    const char *names[] = {"mic_vol", "mic_gain", "spk_vol", "spk_gain"};
+    for (size_t i = 0; i < sizeof(names) / sizeof(names[0]); ++i) {
+        cJSON *field = cJSON_GetObjectItemCaseSensitive(fields, names[i]);
+        assert(cJSON_IsFalse(cJSON_GetObjectItemCaseSensitive(field, "available")));
+        assert(cJSON_IsNull(cJSON_GetObjectItemCaseSensitive(field, "value")));
+    }
+    cJSON_Delete(root);
+}
+#endif
+
+static int value = 2, set_error, get_error, mismatch, setters, getters;
+
+static int set_alc(void *ctx, int device, int channel, int requested)
+{
+    (void)ctx;
+    assert(device == 1 && channel == 0);
+    setters++;
+    if (set_error == RSS_OK) {
+        value = requested;
+    }
+    return set_error;
+}
+
+static int get_alc(void *ctx, int device, int channel, int *observed)
+{
+    (void)ctx;
+    assert(device == 1 && channel == 0);
+    getters++;
+    *observed = value + mismatch;
+    return get_error;
+}
+
+static void command(rad_ctrl_ctx_t *ctx, const char *request, bool accepted)
+{
+    char response[512];
+    assert(native_alc_command(ctx, request, response, sizeof(response)) > 0);
+    cJSON *root = cJSON_Parse(response);
+    cJSON *status = cJSON_GetObjectItemCaseSensitive(root, "status");
+    assert(cJSON_IsString(status));
+    assert((strcmp(status->valuestring, "ok") == 0) == accepted);
+    cJSON_Delete(root);
+}
+
+static void observation(rad_ctrl_ctx_t *ctx, bool supported, bool available, int expected)
+{
+    char response[512];
+    assert(native_alc_command(ctx, "{\"cmd\":\"get-alc-gain\"}", response, sizeof(response)) > 0);
+    cJSON *root = cJSON_Parse(response);
+    cJSON *field = cJSON_GetObjectItemCaseSensitive(root, "field");
+    assert(cJSON_IsObject(field));
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(field, "supported")) == supported);
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(field, "available")) == available);
+    assert(cJSON_GetObjectItemCaseSensitive(field, "min")->valueint == 0);
+    assert(cJSON_GetObjectItemCaseSensitive(field, "max")->valueint == 7);
+    cJSON *observed = cJSON_GetObjectItemCaseSensitive(field, "value");
+    if (available) {
+        assert(cJSON_IsNumber(observed) && observed->valueint == expected);
+    } else {
+        assert(cJSON_IsNull(observed));
+    }
+    cJSON_Delete(root);
+}
+
+int main(int argc, char **argv)
+{
+    assert(argc == 2);
+    FILE *file = fopen(argv[1], "w");
+    assert(file);
+    fputs("[audio]\nalc_gain=2\n", file);
+    fclose(file);
+    rss_config_t *cfg = rss_config_load(argv[1]);
+    assert(cfg);
+    rss_hal_ops_t ops = {.audio_set_alc_gain = set_alc, .audio_get_alc_gain = get_alc};
+    rad_ctrl_ctx_t ctx = {.cfg = cfg, .ops = &ops, .ai_dev = 1};
+    observation(&ctx, true, true, 2);
+    const char *invalid[] = {
+        "{\"cmd\":\"set-alc-gain\",\"value\":-1}",
+        "{\"cmd\":\"set-alc-gain\",\"value\":8}",
+        "{\"cmd\":\"set-alc-gain\",\"value\":1.5}",
+        "{\"cmd\":\"set-alc-gain\",\"value\":true}",
+        "{\"cmd\":\"set-alc-gain\"}",
+    };
+    for (size_t i = 0; i < sizeof(invalid) / sizeof(invalid[0]); ++i) {
+        command(&ctx, invalid[i], false);
+    }
+    assert(setters == 0);
+    ops.audio_get_alc_gain = NULL;
+    command(&ctx, "{\"cmd\":\"set-alc-gain\",\"value\":7}", false);
+    observation(&ctx, false, false, 0);
+    assert(setters == 0);
+    ops.audio_get_alc_gain = get_alc;
+    ctx.ai_disabled = true;
+    int before = getters;
+    observation(&ctx, true, false, 0);
+    command(&ctx, "{\"cmd\":\"set-alc-gain\",\"value\":7}", false);
+    assert(getters == before && setters == 0);
+    ctx.ai_disabled = false;
+    ctx.ai_cleanup_pending = true;
+    observation(&ctx, true, false, 0);
+    command(&ctx, "{\"cmd\":\"set-alc-gain\",\"value\":7}", false);
+    ctx.ai_cleanup_pending = false;
+    ctx.muted = true;
+    command(&ctx, "{\"cmd\":\"set-alc-gain\",\"value\":7}", false);
+    assert(setters == 0);
+    ctx.muted = false;
+    for (int fault = 0; fault < 3; ++fault) {
+        set_error = fault == 0 ? RSS_ERR : RSS_OK;
+        get_error = fault == 1 ? RSS_ERR : RSS_OK;
+        mismatch = fault == 2;
+        command(&ctx, "{\"cmd\":\"set-alc-gain\",\"value\":7}", false);
+        assert(strcmp(rss_config_get_str(cfg, "audio", "alc_gain", ""), "2") == 0);
+    }
+    set_error = get_error = mismatch = 0;
+    value = 9;
+    observation(&ctx, true, false, 0);
+    get_error = RSS_ERR_NOTSUP;
+    observation(&ctx, true, false, 0);
+    get_error = 0;
+    command(&ctx, "{\"cmd\":\"set-alc-gain\",\"value\":7}", true);
+    observation(&ctx, true, true, 7);
+    assert(strcmp(rss_config_get_str(cfg, "audio", "alc_gain", ""), "7") == 0);
+    assert(rss_config_save(cfg, argv[1]) == RSS_OK);
+    rss_config_t *disk = rss_config_load(argv[1]);
+    assert(disk && strcmp(rss_config_get_str(disk, "audio", "alc_gain", ""), "7") == 0);
+    rss_config_free(disk);
+#ifdef RAD_TEST_OWNER_LEVELS
+    ctx.ai_cleanup_pending = true;
+    ctx.ao_enabled = true;
+    owner_levels(&ctx, true);
+    ctx.ai_cleanup_pending = false;
+    ctx.ai_disabled = true;
+    ctx.ao_enabled = false;
+    owner_levels(&ctx, false);
+#endif
+    rss_config_free(cfg);
+    puts("RAD ALC strict range, setter/getter equality, availability and cache persistence passed");
+    return 0;
+}
diff --git a/tests/test_rad_clip.c b/tests/test_rad_clip.c
new file mode 100644
index 0000000000000000000000000000000000000000..1946a8ac82d738062151734ac35a7a39ae0216b4
--- /dev/null
+++ b/tests/test_rad_clip.c
@@ -0,0 +1,229 @@
+#include "rad_state.h"
+#include <assert.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include "native_playback.h"
+
+void rss_ipc_log(int level, const char *file, int line, const char *format, ...)
+{
+    (void)level; (void)file; (void)line; (void)format;
+    abort();
+}
+
+static rss_ring_header_t header;
+static int ring_identity;
+static _Atomic bool ring_available;
+static _Atomic int sends, clears, acquired, mute_calls, unmute_calls;
+static _Atomic bool advance_before_reply;
+static ao_thread_ctx_t *playback;
+
+void rad_test_clip_accept_hook(ao_thread_ctx_t *ctx)
+{
+    if (!atomic_exchange(&advance_before_reply, false)) return;
+    int64_t deadline = rss_timestamp_us() + 1000000;
+    while (atomic_load(&ctx->clip_state) != RAD_CLIP_COMPLETED) {
+        assert(rss_timestamp_us() < deadline);
+        usleep(1000);
+    }
+}
+
+rss_ring_t *rss_ring_open(const char *name)
+{
+    assert(strcmp(name, "speaker") == 0);
+    return atomic_load(&ring_available) ? (rss_ring_t *)&ring_identity : NULL;
+}
+
+const rss_ring_header_t *rss_ring_get_header(rss_ring_t *ring)
+{
+    assert(ring == (rss_ring_t *)&ring_identity);
+    return &header;
+}
+
+void rss_ring_acquire(rss_ring_t *ring)
+{
+    assert(ring == (rss_ring_t *)&ring_identity);
+    assert(atomic_fetch_add(&acquired, 1) == 0);
+}
+
+void rss_ring_release(rss_ring_t *ring)
+{
+    assert(ring == (rss_ring_t *)&ring_identity);
+    assert(atomic_fetch_sub(&acquired, 1) == 1);
+}
+
+void rss_ring_close(rss_ring_t *ring)
+{
+    assert(ring == (rss_ring_t *)&ring_identity);
+}
+
+int rss_ring_read(rss_ring_t *ring, uint64_t *sequence, uint8_t *buffer,
+                  uint32_t capacity, uint32_t *length, rss_ring_slot_t *meta)
+{
+    (void)ring; (void)sequence; (void)buffer; (void)capacity; (void)length; (void)meta;
+    return -EAGAIN;
+}
+
+int rss_ring_wait(rss_ring_t *ring, uint32_t milliseconds)
+{
+    (void)ring; (void)milliseconds;
+    usleep(1000);
+    return -ETIMEDOUT;
+}
+
+static int initialize(void *opaque, const rss_audio_config_t *config)
+{
+    (void)opaque;
+    return config->sample_rate == RAD_MOTION_CLIP_RATE ? RSS_OK : RSS_ERR;
+}
+
+static int deinitialize(void *opaque) { (void)opaque; return RSS_OK; }
+static int set_level(void *opaque, int value) { (void)opaque; (void)value; return RSS_OK; }
+static int get_level(void *opaque, int *value) { (void)opaque; *value = 10; return RSS_OK; }
+static int set_mute(void *opaque, int dev, int ch)
+{
+    (void)opaque; (void)dev; (void)ch;
+    atomic_fetch_add(&mute_calls, 1);
+    return RSS_OK;
+}
+static int clear_mute(void *opaque, int dev, int ch)
+{
+    (void)opaque; (void)dev; (void)ch;
+    atomic_fetch_add(&unmute_calls, 1);
+    return RSS_OK;
+}
+static int clear_buffer(void *opaque)
+{
+    (void)opaque;
+    atomic_fetch_add(&clears, 1);
+    return RSS_OK;
+}
+static int send_frame(void *opaque, const int16_t *pcm, uint32_t length, bool block)
+{
+    (void)opaque;
+    assert(pcm && length > 0 && length <= RAD_MOTION_CLIP_RATE / 50 * 2 && !block);
+    atomic_fetch_add(&sends, 1);
+    return RSS_OK;
+}
+
+int rad_input_track_processing(rad_ctrl_ctx_t *ctx, unsigned bit, bool enabled, int result)
+{
+    (void)ctx; (void)bit; (void)enabled;
+    return result;
+}
+
+static void wait_state(int expected)
+{
+    int64_t deadline = rss_timestamp_us() + 1000000;
+    while (atomic_load(&playback->clip_state) != expected) {
+        assert(rss_timestamp_us() < deadline);
+        usleep(1000);
+    }
+}
+
+int main(int argc, char **argv)
+{
+    assert(argc == 2);
+    FILE *config_file = fopen(argv[1], "w");
+    assert(config_file);
+    fputs("[audio]\nao_enabled=true\nao_sample_rate=16000\n", config_file);
+    fclose(config_file);
+    rss_config_t *cfg = rss_config_load(argv[1]);
+    assert(cfg);
+    header.version = RSS_RING_VERSION;
+    header.data_size = 640;
+    volatile sig_atomic_t running = 1;
+    rss_hal_ops_t ops = {
+        .ao_init = initialize, .ao_deinit = deinitialize,
+        .ao_set_volume = set_level, .ao_get_volume = get_level,
+        .ao_set_gain = set_level, .ao_get_gain = get_level,
+        .ao_soft_mute = set_mute, .ao_soft_unmute = clear_mute,
+        .ao_clear_buf = clear_buffer, .ao_send_frame = send_frame,
+    };
+    ao_thread_ctx_t worker = {.ops = &ops, .running = &running, .completed = true};
+    playback = &worker;
+    pthread_t thread;
+    bool started = false;
+    rad_ctrl_ctx_t owner = {
+        .cfg = cfg, .ops = &ops, .ao_ctx = &worker, .ao_tid = &thread,
+        .ao_thread_started = &started, .ao_volume = 10, .ao_gain = 10,
+    };
+    assert(rad_output_start(&owner, RAD_MOTION_CLIP_RATE) == RSS_OK);
+    char reply[1024];
+    atomic_store(&advance_before_reply, true);
+    assert(rad_clip_command(&owner,
+        "{\"cmd\":\"ao-play-clip\",\"clip\":\"motion\",\"repeats\":2}",
+        reply, sizeof(reply)) > 0);
+    assert(strstr(reply, "\"playback\":\"accepted\""));
+    assert(atomic_load(&worker.clip_state) == RAD_CLIP_COMPLETED);
+    assert(atomic_load(&sends) == 26);
+    assert(rad_clip_command(&owner,
+        "{\"cmd\":\"ao-play-clip\",\"clip\":\"other\",\"repeats\":1}",
+        reply, sizeof(reply)) > 0 && strstr(reply, "\"status\":\"error\""));
+    owner.muted = true;
+    assert(rad_clip_command(&owner,
+        "{\"cmd\":\"ao-play-clip\",\"clip\":\"motion\",\"repeats\":1}",
+        reply, sizeof(reply)) > 0 && strstr(reply, "unavailable"));
+    owner.muted = false;
+
+    assert(rad_clip_command(&owner,
+        "{\"cmd\":\"ao-play-clip\",\"clip\":\"motion\",\"repeats\":3}",
+        reply, sizeof(reply)) > 0);
+    assert(rad_clip_command(&owner,
+        "{\"cmd\":\"ao-play-clip\",\"clip\":\"motion\",\"repeats\":1}",
+        reply, sizeof(reply)) > 0 && strstr(reply, "busy"));
+    int clears_before_cancel = atomic_load(&clears);
+    assert(rad_clip_command(&owner, "{\"cmd\":\"ao-cancel-clip\"}",
+                            reply, sizeof(reply)) > 0);
+    assert(strstr(reply, "\"playback\":\"cancelled\""));
+    assert(atomic_load(&clears) > clears_before_cancel);
+
+    assert(rad_clip_command(&owner,
+        "{\"cmd\":\"ao-play-clip\",\"clip\":\"motion\",\"repeats\":3}",
+        reply, sizeof(reply)) > 0);
+    wait_state(RAD_CLIP_RUNNING);
+    int clears_before_flush = atomic_load(&clears);
+    assert(rad_output_flush(&owner) == RSS_OK);
+    assert(atomic_load(&worker.clip_state) == RAD_CLIP_CANCELLED);
+    assert(atomic_load(&clears) > clears_before_flush);
+
+    assert(rad_clip_command(&owner,
+        "{\"cmd\":\"ao-play-clip\",\"clip\":\"motion\",\"repeats\":3}",
+        reply, sizeof(reply)) > 0);
+    wait_state(RAD_CLIP_RUNNING);
+    int clears_before_mute = atomic_load(&clears);
+    int unmutes_before_mute = atomic_load(&unmute_calls);
+    assert(rad_output_set_mute(&owner, true) == RSS_OK);
+    assert(owner.ao_muted && atomic_load(&worker.clip_state) == RAD_CLIP_CANCELLED);
+    assert(atomic_load(&clears) > clears_before_mute && atomic_load(&mute_calls) == 1);
+    int sends_after_mute = atomic_load(&sends);
+    assert(rad_clip_command(&owner,
+        "{\"cmd\":\"ao-play-clip\",\"clip\":\"motion\",\"repeats\":1}",
+        reply, sizeof(reply)) > 0 && strstr(reply, "unavailable"));
+    assert(rad_output_set_mute(&owner, false) == RSS_OK);
+    assert(!owner.ao_muted && atomic_load(&unmute_calls) == unmutes_before_mute + 1);
+    usleep(300000);
+    assert(atomic_load(&worker.clip_state) == RAD_CLIP_CANCELLED);
+    assert(atomic_load(&sends) == sends_after_mute);
+
+    atomic_store(&ring_available, false);
+    assert(rad_clip_command(&owner,
+        "{\"cmd\":\"ao-play-clip\",\"clip\":\"motion\",\"repeats\":3}",
+        reply, sizeof(reply)) > 0);
+    wait_state(RAD_CLIP_RUNNING);
+    atomic_store(&ring_available, true);
+    wait_state(RAD_CLIP_PREEMPTED);
+    assert(rad_clip_command(&owner, "{\"cmd\":\"ao-clip-status\"}",
+                            reply, sizeof(reply)) > 0);
+    assert(strstr(reply, "\"playback\":\"preempted\"") &&
+           strstr(reply, "\"talkback_active\":true"));
+    int clears_before_stop = atomic_load(&clears);
+    assert(rad_output_stop(&owner) == RSS_OK);
+    assert(atomic_load(&clears) > clears_before_stop && atomic_load(&acquired) == 0);
+    rss_config_free(cfg);
+    puts("RAD bounded motion clip acceptance, flush, mute, cancel and talkback passed");
+    return 0;
+}
diff --git a/tests/test_rad_flush.c b/tests/test_rad_flush.c
new file mode 100644
index 0000000000000000000000000000000000000000..d86bbcae030c43dee82f094a6e22a28701d5d867
--- /dev/null
+++ b/tests/test_rad_flush.c
@@ -0,0 +1,287 @@
+#include "rad_state.h"
+#include <assert.h>
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+#include <unistd.h>
+#include <imp/imp_audio.h>
+#include "native_hal_send.h"
+#include "native_playback.h"
+
+void rss_ipc_log(int level, const char *file, int line, const char *format, ...)
+{
+    (void)level;
+    (void)file;
+    (void)line;
+    (void)format;
+    abort();
+}
+
+static rss_ring_header_t header;
+static int ring_identity, initialized, torn_down;
+static uint32_t opened_incarnation;
+static _Atomic int acquired, closed, reads, next_frame, idle_calls, open_calls;
+static _Atomic bool ring_available = true;
+static _Atomic int64_t frame_timestamp;
+static int clear_error;
+static _Atomic int send_calls, flush_clears;
+static _Atomic bool clear_entered, release_clear, close_entered, release_close;
+static _Atomic bool idle_entered;
+static _Atomic int flush_result;
+static rad_ctrl_ctx_t *flush_owner;
+
+static ao_thread_ctx_t *playback;
+
+rss_ring_t *rss_ring_open(const char *name)
+{
+    assert(strcmp(name, "speaker") == 0);
+    open_calls++;
+    if (!atomic_load(&ring_available)) {
+        return NULL;
+    }
+    opened_incarnation = atomic_load(&header.incarnation);
+    return (rss_ring_t *)&ring_identity;
+}
+
+const rss_ring_header_t *rss_ring_get_header(rss_ring_t *ring)
+{
+    assert(ring == (rss_ring_t *)&ring_identity);
+    return &header;
+}
+
+void rss_ring_acquire(rss_ring_t *ring)
+{
+    (void)ring;
+    assert(acquired == 0);
+    acquired++;
+}
+
+void rss_ring_release(rss_ring_t *ring)
+{
+    (void)ring;
+    assert(acquired == 1);
+    acquired--;
+}
+
+void rss_ring_close(rss_ring_t *ring)
+{
+    (void)ring;
+    assert(acquired == 0);
+    if (atomic_load(&playback->flush) == RAD_FLUSH_PROCESSING) {
+        atomic_store(&close_entered, true);
+        while (!atomic_load(&release_close)) {
+            usleep(1000);
+        }
+    }
+    closed++;
+}
+
+int rss_ring_read(rss_ring_t *ring, uint64_t *sequence, uint8_t *buffer,
+                  uint32_t capacity, uint32_t *length, rss_ring_slot_t *meta)
+{
+    (void)ring;
+    assert(*sequence >= 1);
+    if (opened_incarnation != atomic_load(&header.incarnation)) {
+        return RSS_EOVERFLOW;
+    }
+    if (!atomic_exchange(&next_frame, 0)) {
+        return -EAGAIN;
+    }
+    meta->timestamp = atomic_load(&frame_timestamp);
+    reads++;
+    assert(capacity >= 4 && acquired == 1);
+    memset(buffer, 0, 4);
+    *length = 4;
+    atomic_store(&meta->seq, *sequence);
+    (*sequence)++;
+    return RSS_OK;
+}
+
+int rss_ring_wait(rss_ring_t *ring, uint32_t milliseconds)
+{
+    (void)ring;
+    (void)milliseconds;
+    atomic_store(&idle_entered, true);
+    idle_calls++;
+    usleep(1000);
+    return 0;
+}
+
+static int initialize(void *context, const rss_audio_config_t *config)
+{
+    (void)context;
+    assert(config->sample_rate == 16000);
+    initialized++;
+    return RSS_OK;
+}
+
+static int teardown(void *context)
+{
+    (void)context;
+    assert(atomic_load(&playback->completed));
+    torn_down++;
+    return RSS_OK;
+}
+
+static int set_level(void *context, int value)
+{
+    (void)context;
+    assert(value == 10);
+    return RSS_OK;
+}
+
+static int get_level(void *context, int *value)
+{
+    (void)context;
+    *value = 10;
+    return RSS_OK;
+}
+
+static int mute(void *context, int device, int channel)
+{
+    (void)context;
+    assert(device == 0 && channel == 0);
+    return RSS_OK;
+}
+
+static int clear(void *context)
+{
+    (void)context;
+    if (atomic_load(&playback->flush) == RAD_FLUSH_PROCESSING) {
+        flush_clears++;
+        atomic_store(&clear_entered, true);
+        while (!atomic_load(&release_clear)) {
+            usleep(1000);
+        }
+        return clear_error;
+    }
+    return RSS_OK;
+}
+
+int IMP_AO_SendFrame(int device, int channel, IMPAudioFrame *frame, IMPBlock block)
+{
+    assert(device == 0 && channel == 0 && frame->virAddr && frame->len == 4 && block == NOBLOCK);
+    send_calls++;
+    return RSS_OK;
+}
+
+int rad_input_track_processing(rad_ctrl_ctx_t *ctx, unsigned bit, bool enabled, int result)
+{
+    (void)ctx;
+    (void)bit;
+    (void)enabled;
+    return result;
+}
+
+static void wait_flag(_Atomic bool *flag)
+{
+    int64_t deadline = rss_timestamp_us() + 1000000;
+    while (!atomic_load(flag)) {
+        assert(rss_timestamp_us() < deadline);
+        usleep(1000);
+    }
+}
+
+static void wait_count(_Atomic int *value, int minimum)
+{
+    int64_t deadline = rss_timestamp_us() + 1000000;
+    while (atomic_load(value) < minimum) {
+        assert(rss_timestamp_us() < deadline);
+        usleep(1000);
+    }
+}
+
+static void *request_flush(void *opaque)
+{
+    (void)opaque;
+    atomic_store(&flush_result, rad_output_flush(flush_owner));
+    return NULL;
+}
+
+int main(int argc, char **argv)
+{
+    assert(argc == 2);
+    FILE *file = fopen(argv[1], "w");
+    assert(file);
+    fputs("[audio]\nao_enabled=true\n", file);
+    fclose(file);
+    rss_config_t *cfg = rss_config_load(argv[1]);
+    assert(cfg);
+    header.version = RSS_RING_VERSION;
+    header.data_size = 32;
+    volatile sig_atomic_t running = 1;
+    rss_hal_ops_t ops = {
+        .ao_init = initialize, .ao_deinit = teardown,
+        .ao_set_volume = set_level, .ao_get_volume = get_level,
+        .ao_set_gain = set_level, .ao_get_gain = get_level,
+        .ao_soft_mute = mute, .ao_soft_unmute = mute,
+        .ao_clear_buf = clear, .ao_send_frame = hal_ao_send_frame,
+    };
+    ao_thread_ctx_t worker = {.ops = &ops, .running = &running, .completed = true};
+    playback = &worker;
+    pthread_t thread, caller;
+    bool started = false;
+    rad_ctrl_ctx_t owner = {
+        .cfg = cfg, .ops = &ops, .ao_ctx = &worker, .ao_tid = &thread,
+        .ao_thread_started = &started, .ao_volume = 10, .ao_gain = 10,
+    };
+    flush_owner = &owner;
+    assert(rad_output_flush(&owner) != RSS_OK);
+    assert(rad_output_start(&owner, 16000) == RSS_OK);
+    wait_flag(&idle_entered);
+    atomic_store(&flush_result, 99);
+    assert(pthread_create(&caller, NULL, request_flush, NULL) == 0);
+    wait_flag(&clear_entered);
+    assert(atomic_load(&flush_result) == 99);
+    atomic_store(&release_clear, true);
+    wait_flag(&close_entered);
+    assert(atomic_load(&flush_result) == 99 && closed == 0);
+    atomic_store(&release_close, true);
+    assert(pthread_join(caller, NULL) == 0);
+    assert(atomic_load(&flush_result) == RSS_OK && closed == 1 && flush_clears == 1);
+
+    /* Reopening the same old ring cannot replay a pre-flush frame. */
+    atomic_store(&frame_timestamp, 1);
+    atomic_store(&next_frame, 1);
+    wait_count(&reads, 1);
+    wait_count(&idle_calls, atomic_load(&idle_calls) + 1);
+    assert(send_calls == 0);
+    /* A producer may recreate the ring after receiving the flush ack. */
+    atomic_fetch_add(&header.incarnation, 1);
+    atomic_store(&frame_timestamp, rss_timestamp_us());
+    atomic_store(&next_frame, 1);
+    wait_count(&send_calls, 1);
+
+    atomic_store(&release_clear, false);
+    atomic_store(&clear_entered, false);
+    atomic_store(&flush_result, 99);
+    assert(pthread_create(&caller, NULL, request_flush, NULL) == 0);
+    wait_flag(&clear_entered);
+    assert(pthread_join(caller, NULL) == 0);
+    assert(atomic_load(&flush_result) != RSS_OK && flush_clears == 2);
+    assert(atomic_load(&worker.flush) == RAD_FLUSH_PROCESSING && acquired == 1);
+    /* A second request cannot mistake this late completion for its own. */
+    assert(rad_output_flush(&owner) != RSS_OK && flush_clears == 2);
+    atomic_store(&release_clear, true);
+    wait_count(&worker.flush, RAD_FLUSH_DONE);
+    assert(rad_output_flush(&owner) == RSS_OK && flush_clears == 3);
+
+    clear_error = RSS_ERR;
+    assert(rad_output_flush(&owner) != RSS_OK);
+    wait_flag(&worker.completed);
+    assert(atomic_load(&worker.failure) == RSS_ERR);
+    assert(rad_output_stop(&owner) == RSS_OK && torn_down == 1 && acquired == 0);
+    clear_error = 0;
+    atomic_store(&ring_available, false);
+    int opened_before = atomic_load(&open_calls);
+    int closed_before = atomic_load(&closed);
+    assert(rad_output_start(&owner, 16000) == RSS_OK);
+    wait_count(&open_calls, opened_before + 1);
+    assert(rad_output_flush(&owner) == RSS_OK);
+    assert(acquired == 0 && closed == closed_before);
+    assert(rad_output_stop(&owner) == RSS_OK && torn_down == 2);
+    rss_config_free(cfg);
+    puts("Actual RAD flush waits for clear and close, rejects late ack, and drops stale frames");
+    return 0;
+}
