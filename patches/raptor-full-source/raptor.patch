+extern rss_ring_t *fps_test_ring(int, uint32_t, uint32_t, uint32_t, uint32_t);
+extern int fps_real_get(rss_ring_t *, uint32_t *, uint32_t *);
+extern int fps_real_set(rss_ring_t *, uint32_t);
+extern int fps_real_check(rss_ring_t *, uint32_t);
+
+static rvd_state_t state;
+static rss_hal_ops_t ops;
+static const char *fixture;
+static uint32_t fs_rate, enc_rate, disk_rate;
+static int calls, fail_at, fs_sets, enc_sets, saves, starts, creates;
+static int target = 2, jpeg = 1;
+static int semantic;
+static int target_fs;
+static char events[1024][32];
+static bool deferred;
+static int deferred_mode;
+static int64_t fake_ns;
+static uint32_t pending_rate, attr_rate;
+static int interface_handle;
+
+static bool step(const char *name)
+{
+    assert(calls < 1024);
+    snprintf(events[calls], sizeof(events[calls]), "%s", name);
+    calls++;
+    return calls == fail_at;
+}
+
+static void assert_uncommitted(void)
+{
+    if (!deferred || !pending_rate)
+        return;
+    uint32_t num, den;
+    assert(fps_real_get(state.streams[target].ring, &num, &den) == 0 && num == 20 && den == 1);
+    assert(state.streams[target].enc_cfg.fps_num == 20);
+    assert(state.streams[target].fs_cfg.fps_num == 20);
+    assert(disk_rate == 20 && saves == 0);
+    assert(state.ivs_fs_chn != target_fs || !atomic_load(&state.ivs_active));
+}
+static int test_clock_gettime(clockid_t id, struct timespec *time)
+{
+    assert(id == CLOCK_MONOTONIC);
+    time->tv_sec = fake_ns / 1000000000;
+    time->tv_nsec = fake_ns % 1000000000;
+    return 0;
+}
+static int test_nanosleep(const struct timespec *delay, struct timespec *remaining)
+{
+    (void)remaining;
+    assert_uncommitted();
+    assert(state.enc_tids[target] && state.enc_tids[jpeg]);
+    assert(delay->tv_sec == 0 && delay->tv_nsec == 50000000);
+    fake_ns += delay->tv_nsec;
+    return 0;
+}
+static int fs_get(void *ctx, int channel, uint32_t *num, uint32_t *den)
+{
+    (void)ctx;
+    assert(channel == target_fs);
+    if (step("fs-get"))
+        return -17;
+    assert_uncommitted();
+    *num = fs_rate + (deferred && deferred_mode == 5 && fake_ns >= 100000000);
+    *den = 1;
+    return 0;
+}
+static int enc_get(void *ctx, int channel, uint32_t *num, uint32_t *den)
+{
+    (void)ctx;
+    assert(channel == 9); /* Never use GetChnFrmRate on JPEG channel 12. */
+    if (step("enc-get"))
+        return -17;
+    assert_uncommitted();
+    if (deferred && pending_rate && state.enc_tids[target] && fake_ns >= 100000000) {
+        if (deferred_mode == 3) return -17;
+        if (deferred_mode != 1) enc_rate = pending_rate;
+    }
+    *num = enc_rate;
+    *den = 1;
+    return 0;
+}
+static int sensor_get(void *ctx, uint32_t *num, uint32_t *den)
+{
+    (void)ctx;
+    if (step("sensor-get"))
+        return -17;
+    *num = 30;
+    *den = 1;
+    return 0;
+}
+static int enc_attr(void *ctx, int channel, rss_video_config_t *cfg)
+{
+    (void)ctx;
+    assert(channel == 9 || channel == 12);
+    if (step(channel == 9 ? "video-attr" : "jpeg-attr"))
+        return -17;
+    *cfg = state.streams[channel == 9 ? target : jpeg].enc_cfg;
+    assert_uncommitted();
+    if (channel == 9) {
+        if (deferred && pending_rate && state.enc_tids[target] && fake_ns >= 200000000 && deferred_mode != 2)
+            attr_rate = pending_rate;
+        cfg->fps_num = deferred ? attr_rate : enc_rate;
+        if (deferred && deferred_mode == 4 && fake_ns >= 100000000) cfg->width++;
+    } else if (deferred && deferred_mode == 6 && fake_ns >= 100000000) {
+        cfg->fps_num++;
+    }
+    return 0;
+}
+static int fs_set(void *ctx, int channel, uint32_t num, uint32_t den)
+{
+    (void)ctx;
+    assert(channel == target_fs && den == 1);
+    assert(!state.enc_tids[target] && !state.enc_tids[jpeg]);
+    assert(!state.streams[target].fs_enabled);
+    assert(state.ivs_fs_chn != target_fs || !atomic_load(&state.ivs_active));
+    fs_sets++;
+    fs_rate = num; /* Failure can follow a partial apply/non-rate mismatch. */
+    return step("fs-set") ? -17 : 0;
+}
+static int enc_set(void *ctx, int channel, uint32_t num, uint32_t den)
