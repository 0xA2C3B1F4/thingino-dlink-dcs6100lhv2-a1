+/* Native owner-transition test. epoll and Compy authentication are test doubles;
+ * listener sockets, access validation and configuration cache are real code. */
+#include "rsd.h"
+#include "../raptor_listener.h"
+#include <sys/epoll.h>
+#include <assert.h>
+#include <stdlib.h>
+#include <fcntl.h>
+
+#ifdef __APPLE__
+#undef getsockopt
+/* Substitute only the unavailable listening-state query. Connect to this
+ * test-owned loopback socket to establish that it is actually listening. */
+int native_getsockopt(int fd, int level, int option, void *value, socklen_t *size)
+{
+    if (level != SOL_SOCKET || option != SO_ACCEPTCONN) {
+        return getsockopt(fd, level, option, value, size);
+    }
+    struct sockaddr_in address;
+    socklen_t length = sizeof(address);
+    if (getsockname(fd, (struct sockaddr *)&address, &length) != 0) {
+        return -1;
+    }
+    assert(address.sin_family == AF_INET);
+    assert(address.sin_addr.s_addr == htonl(INADDR_LOOPBACK));
+    int peer = socket(AF_INET, SOCK_STREAM, 0);
+    assert(peer >= 0);
+    int result = connect(peer, (struct sockaddr *)&address, length);
+    close(peer);
+    if (result != 0) {
+        return -1;
+    }
+    int accepted = accept(fd, NULL, NULL);
+    assert(accepted >= 0);
+    close(accepted);
+    assert(*size >= sizeof(int));
+    *(int *)value = 1;
+    *size = sizeof(int);
+    return 0;
+}
+#endif
+
+struct Compy_Auth {
+    Compy_CredentialLookup lookup;
+    void *userdata;
+};
+static bool fail_auth;
+static bool fail_registration;
+static int registrations;
+static int disconnections;
+static Compy_Auth *expected_old_auth;
+
+Compy_Auth *Compy_Auth_new(const char *realm, Compy_CredentialLookup lookup, void *userdata)
+{
+    assert(strcmp(realm, "Raptor") == 0);
+    if (fail_auth) {
+        return NULL;
+    }
+    Compy_Auth *auth = calloc(1, sizeof(*auth));
+    assert(auth);
+    auth->lookup = lookup;
+    auth->userdata = userdata;
+    return auth;
+}
+
+void Compy_Auth_free(Compy_Auth *auth)
+{
+    free(auth);
+}
+
+int epoll_ctl(int fd, int operation, int target, struct epoll_event *event)
+{
+    (void)fd;
+    assert(fcntl(target, F_GETFD) >= 0);
+    if (operation == EPOLL_CTL_ADD) {
+        assert(event && event->data.fd == target);
+        registrations++;
+        if (fail_registration) {
+            errno = ENOMEM;
+            return -1;
+        }
+    }
+    return 0;
+}
+
+void rsd_disconnect_clients(rsd_server_t *srv)
+{
+    assert(srv->auth == expected_old_auth);
+    assert(fcntl(srv->listen_fd, F_GETFD) >= 0);
+    disconnections++;
+}
+
+static int listener_port(int fd)
+{
+    struct sockaddr_in address;
+    socklen_t size = sizeof(address);
+    assert(getsockname(fd, (struct sockaddr *)&address, &size) == 0);
+    return ntohs(address.sin_port);
+}
+
+static void expect_reply(rsd_server_t *srv, const char *request, bool success)
+{
+    char reply[2048];
+    assert(rsd_access_apply(srv, request, reply, sizeof(reply)) > 0);
+    cJSON *root = cJSON_Parse(reply);
+    assert(root);
+    const cJSON *status = cJSON_GetObjectItemCaseSensitive(root, "status");
+    assert(cJSON_IsString(status));
+    if ((strcmp(status->valuestring, "ok") == 0) != success) {
+        int listening = -1;
+        socklen_t len = sizeof(listening);
+        int result = getsockopt(srv->listen_fd, SOL_SOCKET, SO_ACCEPTCONN, &listening, &len);
+        fprintf(stderr, "Unexpected response after %d transitions: %s; fd=%d accept=%d result=%d errno=%d\n", disconnections, reply, srv->listen_fd, listening, result, errno);
+        abort();
+    }
+    assert(!cJSON_GetObjectItemCaseSensitive(root, "password"));
+    cJSON_Delete(root);
+}
+
+int main(int argc, char **argv)
+{
+    assert(argc == 2);
+    FILE *fixture = fopen(argv[1], "w");
+    assert(fixture);
+    assert(fputs("[rtsp]\nbind_address=127.0.0.1\n", fixture) >= 0);
+    assert(fclose(fixture) == 0);
+    rsd_server_t srv = {0};
+    srv.cfg = rss_config_load(argv[1]);
+    assert(srv.cfg);
+    rss_config_set_str(srv.cfg, "rtsp", "bind_address", "127.0.0.1");
+    srv.listen_fd = rsd_listen_tcp(srv.cfg, 0);
+    assert(srv.listen_fd >= 0);
+    srv.port = listener_port(srv.listen_fd);
+    srv.auth = rsd_auth_new(&srv.credentials[0], "original", "old-password");
+    assert(srv.auth);
+    expected_old_auth = srv.auth;
+    int old_listener = srv.listen_fd;
+    int old_port = srv.port;
+    char request[256];
+
+    int occupied = rsd_listen_tcp(srv.cfg, 0);
+    assert(occupied >= 0);
+    snprintf(request, sizeof(request), "{\"cmd\":\"access-apply\",\"port\":%d}", listener_port(occupied));
+    expect_reply(&srv, request, false);
+    assert(srv.listen_fd == old_listener && srv.port == old_port);
+    assert(srv.auth == expected_old_auth && disconnections == 0);
+    close(occupied);
+
+    int available = rsd_listen_tcp(srv.cfg, 0);
+    assert(available >= 0);
+    int new_port = listener_port(available);
+    close(available);
+    snprintf(request, sizeof(request), "{\"cmd\":\"access-apply\",\"port\":%d}", new_port);
+    fail_registration = true;
+    expect_reply(&srv, request, false);
+    assert(registrations == 1 && disconnections == 0);
+    assert(srv.listen_fd == old_listener && srv.auth == expected_old_auth);
+    fail_registration = false;
+
+    fail_auth = true;
+    expect_reply(&srv, "{\"cmd\":\"access-apply\",\"username\":\"changed\"}", false);
+    assert(disconnections == 0 && srv.auth == expected_old_auth);
+    assert(srv.credentials[1].password[0] == 0);
+    fail_auth = false;
+    expect_reply(&srv, "{\"cmd\":\"access-apply\",\"main\":\"audio\"}", false);
+    expect_reply(&srv, "{\"cmd\":\"access-apply\",\"password\":\"short\"}", false);
+    assert(disconnections == 0);
+
+    expect_reply(&srv, request, true);
+    assert(disconnections == 1 && srv.port == new_port);
+    assert(fcntl(old_listener, F_GETFD) < 0);
+    assert(srv.auth != expected_old_auth);
+    assert(srv.credentials[0].username[0] == 0);
+    char password[128];
+    assert(srv.auth->lookup("original", password, sizeof(password), srv.auth->userdata));
+    assert(strcmp(password, "old-password") == 0);
+    assert(rss_config_get_int(srv.cfg, "rtsp", "port", 0) == new_port);
+
+    expected_old_auth = srv.auth;
+    expect_reply(&srv, "{\"cmd\":\"access-apply\",\"main\":\"front-door\",\"username\":\"new-user\",\"password\":\"new-password\"}", true);
+    assert(disconnections == 2);
+    assert(strcmp(srv.endpoints[0], "front-door") == 0);
+    expected_old_auth = srv.auth;
+    expect_reply(&srv, "{\"cmd\":\"access-apply\",\"sub\":\"low-res\"}", true);
+    assert(strcmp(srv.endpoints[0], "front-door") == 0);
+    assert(strcmp(srv.endpoints[1], "low-res") == 0);
+    assert(!srv.auth->lookup("original", password, sizeof(password), srv.auth->userdata));
+    assert(srv.auth->lookup("new-user", password, sizeof(password), srv.auth->userdata));
+    assert(strcmp(password, "new-password") == 0);
+    Compy_Auth_free(srv.auth);
+    close(srv.listen_fd);
+    rss_config_free(srv.cfg);
+    puts("RSD access preparation failures and owner transitions passed");
+    return 0;
+}
diff --git a/tests/test_rsd_timestamp.c b/tests/test_rsd_timestamp.c
new file mode 100644
index 0000000000000000000000000000000000000000..dd38a7bcff2078ac2ad8133416d0bc4bea325b20
--- /dev/null
+++ b/tests/test_rsd_timestamp.c
@@ -0,0 +1,123 @@
+#include "greatest.h"
+
+#include "../rsd/rsd_timestamp.h"
+
+TEST rsd_timestamp_accepts_forward_progress(void)
+{
+	ASSERT_EQ(1200, rsd_client_timestamp_monotonic(1200, 1000, true, 320));
+	PASS();
+}
+
+TEST rsd_timestamp_repairs_rebase_regression(void)
+{
+	/* Matches the device failure shape: a queue recovery rebased audio from
+	 * 11.5M ticks back near the original RTP-Info timestamp. */
+	ASSERT_EQ(11511632, rsd_client_timestamp_monotonic(60480, 11511312, true, 320));
+	PASS();
+}
+
+TEST rsd_timestamp_advances_duplicate(void)
+{
+	ASSERT_EQ(1320, rsd_client_timestamp_monotonic(1000, 1000, true, 320));
+	PASS();
+}
+
+TEST rsd_timestamp_allows_rtp_wrap(void)
+{
+	ASSERT_EQ(0x00000040, rsd_client_timestamp_monotonic(0x00000040, 0xfffffff0, true, 320));
+	PASS();
+}
+
+TEST rsd_timestamp_accepts_initial_candidate(void)
+{
+	ASSERT_EQ(77, rsd_client_timestamp_monotonic(77, 999, false, 320));
+	PASS();
+}
+
+TEST rsd_timestamp_converts_nonnegative_media_delta(void)
+{
+	uint32_t rtp = 0;
+	ASSERT(rsd_media_timestamp_to_rtp(1066667, 1000000, &rtp));
+	ASSERT_EQ(6000, rtp);
+	PASS();
+}
+
+TEST rsd_timestamp_rejects_negative_media_delta_before_unsigned_cast(void)
+{
+	uint32_t rtp = 1234;
+	ASSERT_FALSE(rsd_media_timestamp_to_rtp(999999, 1000000, &rtp));
+	ASSERT_EQ(1234, rtp);
+	PASS();
+}
+
+TEST rsd_timestamp_maps_imp_epoch_to_monotonic(void)
+{
+	/* Device shape: IMP has run 498s while Linux has run 1277s. */
+	const int64_t media_us = 498000000;
+	const int64_t monotonic_us = 1277000000;
+	const int64_t wall_us = 1800000000000000;
+	const int64_t media_to_wall_us = wall_us - monotonic_us + (monotonic_us - media_us);
+	ASSERT_EQ(monotonic_us,
+		  rsd_media_capture_monotonic(media_us, media_to_wall_us, wall_us,
+					       monotonic_us));
+	PASS();
+}
+
+TEST rsd_capture_timestamp_follows_repaired_rtp_delta(void)
+{
+	/* The candidate repeats, but the repaired 15 fps RTP clock advances by
+	 * 6000 ticks.  The SR capture reference must advance with it. */
+	ASSERT_EQ(1277066667,
+		  rsd_capture_timestamp_after_rtp_repair(1277000000, 7000, 1000));
+	PASS();
+}
+
+TEST rsd_capture_timestamp_uses_wrap_aware_rtp_delta(void)
+{
+	ASSERT_EQ(2000889,
+		  rsd_capture_timestamp_after_rtp_repair(2000000, 0x00000040, 0xfffffff0));
+	PASS();
+}
+
+TEST rsd_timestamp_rational_fallback(void)
+{
+	ASSERT_EQ(3000, rsd_video_frame_duration(30, 1));
+	ASSERT_EQ(6000, rsd_video_frame_duration(15, 1));
+	ASSERT_EQ(3003, rsd_video_frame_duration(30000, 1001));
+	ASSERT_EQ(180000, rsd_video_frame_duration(1, 2));
+	ASSERT_EQ(3000, rsd_video_frame_duration(0, 1));
+	ASSERT_EQ(3000, rsd_video_frame_duration(1, 0));
+	ASSERT_EQ(1, rsd_video_frame_duration(UINT32_MAX, 1));
+	ASSERT_EQ(INT32_MAX, rsd_video_frame_duration(1, UINT32_MAX));
+	PASS();
+}
+
+TEST rsd_timestamp_buffered_capture_survives_rate_change(void)
+{
+	uint32_t ts = 0;
+	ASSERT(rsd_media_timestamp_to_rtp(1033334, 1000000, &ts));
+	ASSERT_EQ(3000, ts);
+	/* A buffered 30 fps capture stays on its timeline after metadata says 15.
+	 * Only a repeated/non-forward candidate uses the current fallback. */
+	ASSERT_EQ(3000, rsd_client_timestamp_monotonic(ts, 0, true,
+						    rsd_video_frame_duration(15, 1)));
+	ASSERT_EQ(9000, rsd_client_timestamp_monotonic(ts, ts, true,
+						    rsd_video_frame_duration(15, 1)));
+	PASS();
+}
+
+SUITE(rsd_timestamp_suite)
+{
+	RUN_TEST(rsd_timestamp_accepts_forward_progress);
+	RUN_TEST(rsd_timestamp_repairs_rebase_regression);
+	RUN_TEST(rsd_timestamp_advances_duplicate);
+	RUN_TEST(rsd_timestamp_allows_rtp_wrap);
+	RUN_TEST(rsd_timestamp_accepts_initial_candidate);
+	RUN_TEST(rsd_timestamp_converts_nonnegative_media_delta);
+	RUN_TEST(rsd_timestamp_rejects_negative_media_delta_before_unsigned_cast);
+	RUN_TEST(rsd_timestamp_maps_imp_epoch_to_monotonic);
+	RUN_TEST(rsd_capture_timestamp_follows_repaired_rtp_delta);
+	RUN_TEST(rsd_capture_timestamp_uses_wrap_aware_rtp_delta);
+	RUN_TEST(rsd_timestamp_rational_fallback);
+	RUN_TEST(rsd_timestamp_buffered_capture_survives_rate_change);
+}
diff --git a/tests/test_rwd_sdp_direction.c b/tests/test_rwd_sdp_direction.c
new file mode 100644
index 0000000000000000000000000000000000000000..36a3bcd815facb9db829028f3796e93800d9b88d
--- /dev/null
+++ b/tests/test_rwd_sdp_direction.c
@@ -0,0 +1,143 @@
+/*
+ * Native regression tests for the full rwd_sdp.c parser and answer generator.
+ *
+ * Run with:
+ *   make -C tests test-rwd-sdp-direction
+ *
+ * The Makefile places the binary under $TMPDIR so this test leaves no build
+ * output in the source tree.
+ */
+
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "rwd_sdp_direction_shim.h"
+
+static void make_offer(char *sdp, size_t size, const char *session_direction,
+		       const char *video_direction, const char *unknown_direction,
+		       const char *audio_direction)
+{
+	const char *session = session_direction ? session_direction : "";
+	const char *video = video_direction ? video_direction : "";
+	const char *unknown = unknown_direction ? unknown_direction : "";
+	const char *audio = audio_direction ? audio_direction : "";
+	const char *unknown_prefix = unknown_direction
+		? "m=application 9 UDP/DTLS/SCTP webrtc-datachannel\r\na="
+		: "";
+	const char *unknown_suffix = unknown_direction ? "\r\n" : "";
+	int written = snprintf(sdp, size,
+		"v=0\r\n"
+		"o=- 1234 1 IN IP4 0.0.0.0\r\n"
+		"s=-\r\n"
+		"t=0 0\r\n"
+		"a=ice-ufrag:abcd\r\n"
+		"a=ice-pwd:efghijklmnopqrstuvwxyz1234\r\n"
+		"a=fingerprint:sha-256 AA:BB\r\n"
+		"a=setup:actpass\r\n"
+		"%s%s\r\n"
+		"m=video 9 UDP/TLS/RTP/SAVPF 96\r\n"
+		"a=mid:0\r\n"
+		"a=rtpmap:96 H264/90000\r\n"
+		"%s%s\r\n"
+		"%s%s%s"
+		"m=audio 9 UDP/TLS/RTP/SAVPF 111 0 8\r\n"
+		"a=mid:1\r\n"
+		"a=rtpmap:111 opus/48000/2\r\n"
+		"a=rtpmap:0 PCMU/8000\r\n"
+		"a=rtpmap:8 PCMA/8000\r\n"
+		"%s%s\r\n",
+		session_direction ? "a=" : "", session,
+		video_direction ? "a=" : "", video,
+		unknown_prefix, unknown, unknown_suffix,
+		audio_direction ? "a=" : "", audio);
+	assert(written > 0 && (size_t)written < size);
+}
+
+static void parse_direction(const char *session_direction, const char *video_direction,
+			    const char *unknown_direction, const char *audio_direction,
+			    const char *expected)
+{
+	char sdp[4096];
+	rwd_sdp_offer_t offer;
+	make_offer(sdp, sizeof(sdp), session_direction, video_direction,
+		  unknown_direction, audio_direction);
+	assert(rwd_sdp_parse_offer(sdp, &offer) == 0);
+	assert(strcmp(offer.audio_direction, expected) == 0);
+}
+
+static void test_parser_default_and_session_directions(void)
+{
+	parse_direction(NULL, NULL, NULL, NULL, "sendrecv");
+	parse_direction("sendrecv", NULL, NULL, NULL, "sendrecv");
+	parse_direction("sendonly", NULL, NULL, NULL, "sendonly");
+	parse_direction("recvonly", NULL, NULL, NULL, "recvonly");
+	parse_direction("inactive", NULL, NULL, NULL, "inactive");
+}
+
+static void test_parser_media_override_and_isolation(void)
+{
+	/* Audio media direction wins over the session attribute. */
+	parse_direction("recvonly", "sendonly", "inactive", "sendonly", "sendonly");
+
+	/* Direction attributes in video and data media do not leak into audio. */
+	parse_direction("inactive", "sendonly", "recvonly", NULL, "inactive");
+}
+
+static void assert_audio_direction(const char *answer, const char *expected)
+{
+	const char *audio = strstr(answer, "m=audio ");
+	const char *next_media;
+	char line[32];
+	const char *found;
+	assert(audio != NULL);
+	next_media = strstr(audio + 8, "\r\nm=");
+	if (!next_media)
+		next_media = answer + strlen(answer);
+	snprintf(line, sizeof(line), "a=%s\r\n", expected);
+	found = strstr(audio, line);
+	assert(found != NULL && found < next_media);
+}
+
+static void generate_direction(const char *offered, const char *expected)
+{
+	char sdp[4096];
+	char answer[8192];
+	rwd_client_t client = {0};
+	rwd_server_t server = {0};
+	rwd_dtls_ctx_t dtls = {0};
+
+	make_offer(sdp, sizeof(sdp), offered, NULL, NULL, NULL);
+	assert(rwd_sdp_parse_offer(sdp, &client.offer) == 0);
+	strcpy(client.local_ufrag, "serverufrag");
+	strcpy(client.local_pwd, "serverpassword123456789012");
+	client.video_ssrc = 100;
+	client.audio_ssrc = 200;
+	strcpy(server.local_ip, "192.0.2.1");
+	server.udp_port = 5000;
+	strcpy(dtls.fingerprint, "sha-256 11:22");
+	server.dtls = &dtls;
+	server.wire_codec = RWD_CODEC_PCMU;
+	server.wire_pt = 0;
+
+	assert(rwd_sdp_generate_answer(&client, &server, answer, sizeof(answer)) > 0);
+	assert_audio_direction(answer, expected);
+}
+
+static void test_generator_directions(void)
+{
+	generate_direction(NULL, "sendrecv");
+	generate_direction("sendrecv", "sendrecv");
+	generate_direction("recvonly", "sendonly");
+	generate_direction("sendonly", "recvonly");
+	generate_direction("inactive", "inactive");
+}
+
+int main(void)
+{
+	test_parser_default_and_session_directions();
+	test_parser_media_override_and_isolation();
+	test_generator_directions();
+	puts("rwd SDP direction parser/generator tests passed");
+	return 0;
+}
diff --git a/tests/test_storage.c b/tests/test_storage.c
index 326446f5a62dcfa80cafa6d3c5b939bface2ff40..76e6a1afbdf04ee8994953ce1adfea0a25184c29 100644
--- a/tests/test_storage.c
+++ b/tests/test_storage.c
@@ -1,12 +1,24 @@
 #include "greatest.h"
 #include "../rmr/rmr_storage.h"
+#include "../rmr/rmr_writer.h"
 
+#include <errno.h>
+#include <fcntl.h>
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
 #include <sys/stat.h>
+#include <time.h>
 #include <unistd.h>
 
+static int64_t monotonic_us(void)
+{
+	struct timespec ts;
+	if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0)
+		return -1;
+	return (int64_t)ts.tv_sec * 1000000 + ts.tv_nsec / 1000;
+}
+
 static bool same_dev_as_root(const char *path)
 {
 	struct stat a, b;
@@ -73,9 +85,80 @@ TEST storage_refuses_rootfs_autocreate(void)
 	PASS();
 }
 
+TEST storage_close_is_bounded_and_finishes_in_worker(void)
+{
+	const char *tmp = getenv("TMPDIR");
+	if (!tmp || !*tmp)
+		tmp = "/tmp";
+	char path[320];
+	snprintf(path, sizeof(path), "%s/rmr_close_test_XXXXXX", tmp);
+	int fd = mkstemp(path);
+	ASSERT(fd >= 0);
+	ASSERT_EQ(4, write(fd, "test", 4));
+
+	int64_t started = monotonic_us();
+	ASSERT(started >= 0);
+	rmr_storage_close_segment(fd);
+	ASSERT(monotonic_us() - started < 500000);
+
+	int attempts = 0;
+	while (fcntl(fd, F_GETFD) >= 0 && attempts++ < 200)
+		usleep(10000);
+	errno = 0;
+	ASSERT_EQ(-1, fcntl(fd, F_GETFD));
+	ASSERT_EQ(EBADF, errno);
+	unlink(path);
+	PASS();
+}
+
+TEST storage_writer_queues_and_closes_off_thread(void)
+{
+	const char *tmp = getenv("TMPDIR");
+	if (!tmp || !*tmp)
+		tmp = "/tmp";
+	char path[320];
+	snprintf(path, sizeof(path), "%s/rmr_writer_test_XXXXXX", tmp);
+	int fd = mkstemp(path);
+	ASSERT(fd >= 0);
+
+	rmr_writer_t *writer = rmr_writer_create(fd, 1024, false, 1);
+	ASSERT(writer);
+	ASSERT_EQ(0, rmr_writer_submit(writer, "test", 4));
+	ASSERT_EQ(-1, rmr_writer_submit(writer, path, 1025));
+	size_t queued = 0;
+	size_t limit = 0;
+	bool failed = true;
+	rmr_writer_status(writer, &queued, &limit, &failed);
+	ASSERT_EQ(1024, limit);
+	ASSERT_FALSE(failed);
+
+	int64_t started = monotonic_us();
+	ASSERT(started >= 0);
+	rmr_writer_finish(writer);
+	ASSERT(monotonic_us() - started < 500000);
+
+	int attempts = 0;
+	while (fcntl(fd, F_GETFD) >= 0 && attempts++ < 200)
+		usleep(10000);
+	errno = 0;
+	ASSERT_EQ(-1, fcntl(fd, F_GETFD));
+	ASSERT_EQ(EBADF, errno);
+
+	fd = open(path, O_RDONLY);
+	ASSERT(fd >= 0);
+	char data[4];
+	ASSERT_EQ(4, read(fd, data, sizeof(data)));
+	ASSERT_MEM_EQ("test", data, sizeof(data));
+	close(fd);
+	unlink(path);
+	PASS();
+}
+
 SUITE(storage_suite)
 {
 	RUN_TEST(storage_available_existing_dir);
 	RUN_TEST(storage_autocreate_on_mounted_fs);
 	RUN_TEST(storage_refuses_rootfs_autocreate);
+	RUN_TEST(storage_close_is_bounded_and_finishes_in_worker);
+	RUN_TEST(storage_writer_queues_and_closes_off_thread);
 }
diff --git a/tests/test_stream_buffer_status.c b/tests/test_stream_buffer_status.c
new file mode 100644
index 0000000000000000000000000000000000000000..6446ef982cce974a6e0d73aa12680a1fd1066958
--- /dev/null
+++ b/tests/test_stream_buffer_status.c
@@ -0,0 +1,122 @@
+#include "rvd.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+static uint32_t sdk_buffers;
+static int sdk_error;
+static int reads;
+
+static int get_buffers(void *ctx, int channel, uint32_t *value)
+{
+    (void)ctx;
+    assert(channel == 1);
+    reads++;
+    if (sdk_error)
+        return sdk_error;
+    *value = sdk_buffers;
+    return RSS_OK;
+}
+
+static cJSON *command(rvd_state_t *st, const char *request, bool ok)
+{
+    char response[2048];
+    assert(rvd_stream_buffer_status_command(st, request, response, sizeof(response)) > 0);
+    cJSON *reply = cJSON_Parse(response);
+    assert(reply);
+    const cJSON *status = cJSON_GetObjectItemCaseSensitive(reply, "status");
+    assert(cJSON_IsString(status));
+    assert((strcmp(status->valuestring, "ok") == 0) == ok);
+    return reply;
+}
+
+static void write_config(const char *path, const char *body)
+{
+    FILE *file = fopen(path, "w");
+    assert(file && fputs(body, file) >= 0 && fclose(file) == 0);
+}
+
+int main(int argc, char **argv)
+{
+    assert(argc == 2);
+    write_config(argv[1],
+        "[stream0]\nrc_mode=cbr\nnr_vbs=1\n"
+        "[stream1]\nenabled=true\nrc_mode=cbr\nnr_vbs=1\n");
+    rss_config_t *cfg = rss_config_load(argv[1]);
+    assert(cfg);
+
+    rss_hal_caps_t caps = {.has_smart_rc = false};
+    assert(rvd_stream_smart_config_valid(cfg, &caps));
+    rss_config_set_str(cfg, "stream0", "rc_mode", "smart");
+    assert(!rvd_stream_smart_config_valid(cfg, &caps));
+    assert(!rvd_stream_smart_config_valid(cfg, NULL));
+    caps.has_smart_rc = true;
+    assert(rvd_stream_smart_config_valid(cfg, &caps));
+
+    caps.has_smart_rc = false;
+    rss_config_set_str(cfg, "stream0", "rc_mode", "cbr");
+    rss_config_set_str(cfg, "stream1", "rc_mode", "SMART");
+    assert(!rvd_stream_smart_config_valid(cfg, &caps));
+    rss_config_set_bool(cfg, "stream1", "enabled", false);
+    assert(rvd_stream_smart_config_valid(cfg, &caps));
+    rss_config_set_str(cfg, "sensor1_stream0", "rc_mode", "smart");
+    assert(rvd_stream_smart_config_valid(cfg, &caps));
+    rss_config_set_str(cfg, "sensor1", "name", "secondary");
+    assert(!rvd_stream_smart_config_valid(cfg, &caps));
+    rss_config_set_str(cfg, "sensor1_stream0", "rc_mode", "vbr");
+    assert(rvd_stream_smart_config_valid(cfg, &caps));
+
+    rss_hal_ops_t ops = {.fs_get_nr_vbs = get_buffers};
+    rvd_state_t st = {.cfg = cfg, .ops = &ops, .stream_count = 1};
+    rvd_stream_t *sub = &st.streams[0];
+    strcpy(sub->cfg_sect, "stream1");
+    sub->sensor_idx = 0;
+    sub->fs_chn = 1;
+    sub->enabled = true;
+    atomic_store(&st.stream_active[0], true);
+
+    sdk_buffers = 1;
+    cJSON *reply = command(&st,
+        "{\"cmd\":\"get-stream-buffer-status\",\"stream_id\":1}", true);
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(reply, "supported")));
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(reply, "available")));
+    assert(cJSON_IsFalse(cJSON_GetObjectItemCaseSensitive(reply, "editable")));
+    assert(cJSON_IsFalse(cJSON_GetObjectItemCaseSensitive(reply, "hardware_limit_known")));
+    assert(cJSON_GetObjectItemCaseSensitive(reply, "active_buffers")->valueint == 1);
+    assert(cJSON_GetObjectItemCaseSensitive(reply, "configured_buffers")->valueint == 1);
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(reply, "matches_configured")));
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(reply, "profile_admitted")));
+    cJSON_Delete(reply);
+
+    sdk_buffers = 3;
+    reply = command(&st,
+        "{\"cmd\":\"get-stream-buffer-status\",\"stream_id\":1}", true);
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(reply, "supported")));
+    assert(cJSON_IsFalse(cJSON_GetObjectItemCaseSensitive(reply, "matches_configured")));
+    assert(cJSON_IsFalse(cJSON_GetObjectItemCaseSensitive(reply, "profile_admitted")));
+    cJSON_Delete(reply);
+
+    sdk_error = RSS_ERR;
+    reply = command(&st,
+        "{\"cmd\":\"get-stream-buffer-status\",\"stream_id\":1}", true);
+    assert(cJSON_IsFalse(cJSON_GetObjectItemCaseSensitive(reply, "available")));
+    assert(cJSON_IsNull(cJSON_GetObjectItemCaseSensitive(reply, "active_buffers")));
+    assert(cJSON_GetObjectItemCaseSensitive(reply, "configured_buffers")->valueint == 1);
+    cJSON_Delete(reply);
+    sdk_error = 0;
+
+    ops.fs_get_nr_vbs = NULL;
+    reply = command(&st,
+        "{\"cmd\":\"get-stream-buffer-status\",\"stream_id\":1}", true);
+    assert(cJSON_IsFalse(cJSON_GetObjectItemCaseSensitive(reply, "supported")));
+    assert(cJSON_IsFalse(cJSON_GetObjectItemCaseSensitive(reply, "available")));
+    cJSON_Delete(reply);
+
+    cJSON_Delete(command(&st,
+        "{\"cmd\":\"get-stream-buffer-status\",\"stream_id\":1,\"extra\":true}",
+        false));
+    assert(reads == 3);
+    rss_config_free(cfg);
+    puts("stream SMART admission and buffer status checks passed");
+    return 0;
+}
diff --git a/tests/test_stream_enable.c b/tests/test_stream_enable.c
new file mode 100644
index 0000000000000000000000000000000000000000..de4be372019c7d75137f1511fe56c8454bea5429
--- /dev/null
+++ b/tests/test_stream_enable.c
@@ -0,0 +1,119 @@
+#include "rvd.h"
+#include <assert.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+
+void rss_log(rss_log_level_t level, const char *file, int line, const char *fmt, ...)
+{
+    (void)level; (void)file; (void)line; (void)fmt;
+}
+
+size_t rss_strlcpy(char *dst, const char *src, size_t size)
+{
+    size_t length = strlen(src);
+    if (size) {
+        size_t copy = length < size - 1 ? length : size - 1;
+        memcpy(dst, src, copy);
+        dst[copy] = '\0';
+    }
+    return length;
+}
+
+char *rss_trim(char *value)
+{
+    while (*value == ' ' || *value == '\t')
+        value++;
+    char *end = value + strlen(value);
+    while (end > value && (end[-1] == ' ' || end[-1] == '\t' ||
+                           end[-1] == '\r' || end[-1] == '\n'))
+        *--end = '\0';
+    return value;
+}
+
+int rvd_ivs_set_enabled(rvd_state_t *st, bool enabled)
+{
+    (void)st; (void)enabled;
+    assert(!"motion transition must not run when substream is configured disabled");
+    return RSS_ERR;
+}
+
+static void write_config(const char *path, const char *body)
+{
+    FILE *file = fopen(path, "w");
+    assert(file && fputs(body, file) >= 0 && fclose(file) == 0);
+}
+
+static cJSON *command(rvd_state_t *st, const char *request, bool ok)
+{
+    char response[2048];
+    assert(rvd_stream_enable_command(st, request, response, sizeof(response)) > 0);
+    cJSON *reply = cJSON_Parse(response);
+    assert(reply);
+    const cJSON *status = cJSON_GetObjectItemCaseSensitive(reply, "status");
+    assert(cJSON_IsString(status));
+    assert((strcmp(status->valuestring, "ok") == 0) == ok);
+    return reply;
+}
+
+int main(int argc, char **argv)
+{
+    assert(argc == 2);
+    write_config(argv[1],
+        "[stream0]\nenabled=true\n[stream1]\nenabled=true\n"
+        "[motion]\nenabled=false\n[recorder1]\nautostart=false\n");
+    rss_config_t *cfg = rss_config_load(argv[1]);
+    assert(cfg && rvd_stream_enable_config_valid(cfg));
+
+    rvd_state_t st = {.cfg = cfg, .stream_count = 2};
+    strcpy(st.streams[0].cfg_sect, "stream0");
+    strcpy(st.streams[1].cfg_sect, "stream1");
+    st.streams[0].enabled = st.streams[1].enabled = true;
+    st.streams[0].ring = st.streams[1].ring = (rss_ring_t *)1;
+    atomic_store(&st.stream_active[0], true);
+    atomic_store(&st.stream_active[1], true);
+
+    cJSON *reply = command(&st, "{\"cmd\":\"get-stream-enabled\",\"stream_id\":0}", true);
+    assert(cJSON_IsFalse(cJSON_GetObjectItemCaseSensitive(reply, "editable")));
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(reply, "required")));
+    cJSON_Delete(reply);
+    cJSON_Delete(command(&st,
+        "{\"cmd\":\"set-stream-enabled-config\",\"stream_id\":0,\"enabled\":false}", false));
+
+    rss_config_set_bool(cfg, "motion", "enabled", true);
+    cJSON_Delete(command(&st,
+        "{\"cmd\":\"set-stream-enabled-config\",\"stream_id\":1,\"enabled\":false}", false));
+    assert(rss_config_get_bool(cfg, "stream1", "enabled", false));
+    rss_config_set_bool(cfg, "motion", "enabled", false);
+    rss_config_set_bool(cfg, "recorder1", "autostart", true);
+    cJSON_Delete(command(&st,
+        "{\"cmd\":\"set-stream-enabled-config\",\"stream_id\":1,\"enabled\":false}", false));
+    rss_config_set_bool(cfg, "recorder1", "autostart", false);
+
+    reply = command(&st,
+        "{\"cmd\":\"set-stream-enabled-config\",\"stream_id\":1,\"enabled\":false}", true);
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(reply, "active_enabled")));
+    assert(cJSON_IsFalse(cJSON_GetObjectItemCaseSensitive(reply, "configured_enabled")));
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(reply, "pending_restart")));
+    cJSON_Delete(reply);
+    char response[2048];
+    assert(rvd_set_motion_config(&st,
+        "{\"cmd\":\"set-motion-config\",\"enabled\":true}",
+        response, sizeof(response)) > 0);
+    reply = cJSON_Parse(response);
+    assert(reply);
+    assert(strcmp(cJSON_GetObjectItemCaseSensitive(reply, "status")->valuestring,
+                  "error") == 0);
+    assert(!rss_config_get_bool(cfg, "motion", "enabled", true));
+    cJSON_Delete(reply);
+    assert(rvd_stream_enable_config_valid(cfg));
+    rss_config_set_bool(cfg, "motion", "enabled", true);
+    assert(!rvd_stream_enable_config_valid(cfg));
+    rss_config_set_bool(cfg, "motion", "enabled", false);
+    rss_config_set_bool(cfg, "stream0", "enabled", false);
+    assert(!rvd_stream_enable_config_valid(cfg));
+
+    rss_config_free(cfg);
+    puts("stream enable configuration checks passed");
+    return 0;
+}
diff --git a/tests/test_stream_encoding.c b/tests/test_stream_encoding.c
new file mode 100644
index 0000000000000000000000000000000000000000..8f88b28d43ff1e40e397f89c03b07f6967465368
--- /dev/null
+++ b/tests/test_stream_encoding.c
@@ -0,0 +1,196 @@
+#include "rvd.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+static rss_video_config_t actual;
+static int reads, writes, fail_read_at;
+static bool fail_set, wrong_bitrate, wrong_geometry;
+
+static int get_attr(void *ctx, int chn, rss_video_config_t *out)
+{
+    (void)ctx;
+    assert(chn == 7);
+    reads++;
+    if (reads == fail_read_at) return RSS_ERR;
+    *out = actual;
+    if (wrong_bitrate) out->bitrate++;
+    if (wrong_geometry) out->width++;
+    return RSS_OK;
+}
+
+static int set_encoding(void *ctx, int chn, rss_rc_mode_t mode, uint32_t bitrate)
+{
+    (void)ctx;
+    assert(chn == 7);
+    writes++;
+    if (fail_set) return RSS_ERR;
+    actual.rc_mode = mode;
+    actual.bitrate = bitrate / 1000;
+    return RSS_OK;
+}
+
+static cJSON *command(rvd_state_t *st, const char *json, bool ok)
+{
+    char out[1024];
+    assert(rvd_stream_encoding_command(st, json, out, sizeof(out)) > 0);
+    cJSON *reply = cJSON_Parse(out);
+    assert(reply);
+    const cJSON *status = cJSON_GetObjectItemCaseSensitive(reply, "status");
+    assert(cJSON_IsString(status));
+    assert((strcmp(status->valuestring, "ok") == 0) == ok);
+    return reply;
+}
+
+static void run(rvd_state_t *st, const char *json, bool ok)
+{
+    cJSON_Delete(command(st, json, ok));
+}
+
+int main(int argc, char **argv)
+{
+    assert(argc == 2);
+    FILE *file = fopen(argv[1], "w");
+    assert(file);
+    fputs("[stream0]\nrc_mode=cbr\nbitrate=2000000\n", file);
+    fclose(file);
+
+    rvd_state_t st = {0};
+    rss_hal_ops_t ops = {
+        .enc_get_channel_attr = get_attr,
+        .enc_set_rc_mode = set_encoding,
+    };
+    st.ops = &ops;
+    st.cfg = rss_config_load(argv[1]);
+    assert(st.cfg);
+    st.stream_count = 2;
+    st.streams[0].is_jpeg = true;
+    rvd_stream_t *stream = &st.streams[1];
+    strcpy(stream->cfg_sect, "stream0");
+    stream->chn = 7;
+    stream->sensor_idx = 0;
+    stream->enabled = true;
+    atomic_store(&st.stream_active[1], true);
+    stream->enc_cfg = (rss_video_config_t){
+        .codec = RSS_CODEC_H264,
+        .width = 1920,
+        .height = 1080,
+        .profile = 2,
+        .rc_mode = RSS_RC_CBR,
+        .bitrate = 2000000,
+        .fps_num = 15,
+        .fps_den = 1,
+        .gop_length = 30,
+    };
+    actual = stream->enc_cfg;
+    actual.bitrate /= 1000; /* Matched T31 HAL getter exposes the SDK kbit/s field. */
+
+    cJSON *reply = command(&st,
+        "{\"cmd\":\"get-stream-encoding\",\"stream_id\":0}", true);
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(reply, "supported")));
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(reply, "available")));
+    assert(strcmp(cJSON_GetObjectItemCaseSensitive(reply, "rc_mode")->valuestring, "cbr") == 0);
+    assert(cJSON_GetObjectItemCaseSensitive(reply, "bitrate")->valueint == 2000000);
+    cJSON_Delete(reply);
+
+    const char *set_vbr =
+        "{\"cmd\":\"set-stream-encoding\",\"stream_id\":0,"
+        "\"rc_mode\":\"vbr\",\"bitrate\":3000000}";
+    run(&st, set_vbr, true);
+    assert(writes == 1 && actual.rc_mode == RSS_RC_VBR && actual.bitrate == 3000);
+    assert(stream->enc_cfg.rc_mode == RSS_RC_VBR && stream->enc_cfg.bitrate == 3000000);
+    assert(strcmp(rss_config_get_str(st.cfg, "stream0", "rc_mode", ""), "vbr") == 0);
+    assert(rss_config_get_int(st.cfg, "stream0", "bitrate", 0) == 3000000);
+
+    /* An unchanged request repairs stale cache without another SDK setter. */
+    rss_config_set_str(st.cfg, "stream0", "rc_mode", "cbr");
+    rss_config_set_int(st.cfg, "stream0", "bitrate", 1000000);
+    run(&st, set_vbr, true);
+    assert(writes == 1);
+    assert(strcmp(rss_config_get_str(st.cfg, "stream0", "rc_mode", ""), "vbr") == 0);
+    assert(rss_config_get_int(st.cfg, "stream0", "bitrate", 0) == 3000000);
+    assert(rss_config_save(st.cfg, argv[1]) == RSS_OK);
+    rss_config_t *disk = rss_config_load(argv[1]);
+    assert(disk);
+    assert(strcmp(rss_config_get_str(disk, "stream0", "rc_mode", ""), "vbr") == 0);
+    assert(rss_config_get_int(disk, "stream0", "bitrate", 0) == 3000000);
+    rss_config_free(disk);
+
+    fail_set = true;
+    run(&st,
+        "{\"cmd\":\"set-stream-encoding\",\"stream_id\":0,"
+        "\"rc_mode\":\"cbr\",\"bitrate\":2000000}", false);
+    fail_set = false;
+    wrong_bitrate = true;
+    run(&st, set_vbr, false);
+    wrong_bitrate = false;
+    wrong_geometry = true;
+    run(&st, set_vbr, false);
+    wrong_geometry = false;
+    fail_read_at = reads + 1;
+    run(&st, set_vbr, false);
+    fail_read_at = 0;
+
+    stream->enabled = false;
+    run(&st, set_vbr, false);
+    stream->enabled = true;
+    atomic_store(&st.stream_active[1], false);
+    run(&st, set_vbr, false);
+    atomic_store(&st.stream_active[1], true);
+    stream->is_jpeg = true;
+    run(&st, set_vbr, false);
+    stream->is_jpeg = false;
+    ops.enc_set_rc_mode = NULL;
+    run(&st, set_vbr, false);
+    ops.enc_set_rc_mode = set_encoding;
+
+    actual.rc_mode = RSS_RC_FIXQP;
+    actual.bitrate = 0;
+    reply = command(&st,
+        "{\"cmd\":\"get-stream-encoding\",\"stream_id\":0}", true);
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(reply, "supported")));
+    assert(cJSON_IsFalse(cJSON_GetObjectItemCaseSensitive(reply, "available")));
+    assert(cJSON_IsNull(cJSON_GetObjectItemCaseSensitive(reply, "rc_mode")));
+    assert(cJSON_IsNull(cJSON_GetObjectItemCaseSensitive(reply, "bitrate")));
+    cJSON_Delete(reply);
+    actual.rc_mode = RSS_RC_CBR;
+    actual.bitrate = 2000;
+
+    stream->codec_uncertain = true;
+    int writes_before_recovery = writes;
+    reply = command(&st,
+        "{\"cmd\":\"get-stream-encoding\",\"stream_id\":0}", true);
+    assert(cJSON_IsFalse(cJSON_GetObjectItemCaseSensitive(reply, "available")));
+    cJSON_Delete(reply);
+    run(&st, set_vbr, false);
+    assert(writes == writes_before_recovery);
+    stream->codec_uncertain = false;
+
+    const char *valid[] = {
+        "{\"cmd\":\"set-stream-encoding\",\"stream_id\":0,\"rc_mode\":\"cbr\",\"bitrate\":1000}",
+        "{\"cmd\":\"set-stream-encoding\",\"stream_id\":0,\"rc_mode\":\"capped_vbr\",\"bitrate\":100000000}",
+        "{\"cmd\":\"set-stream-encoding\",\"stream_id\":0,\"rc_mode\":\"capped_quality\",\"bitrate\":4000000}",
+    };
+    for (unsigned i = 0; i < sizeof(valid) / sizeof(valid[0]); ++i)
+        run(&st, valid[i], true);
+
+    const char *invalid[] = {
+        "{\"cmd\":\"set-stream-encoding\",\"stream_id\":0,\"rc_mode\":\"fixqp\",\"bitrate\":2000000}",
+        "{\"cmd\":\"set-stream-encoding\",\"stream_id\":0,\"rc_mode\":\"smart\",\"bitrate\":2000000}",
+        "{\"cmd\":\"set-stream-encoding\",\"stream_id\":0,\"rc_mode\":\"cbr\",\"bitrate\":0}",
+        "{\"cmd\":\"set-stream-encoding\",\"stream_id\":0,\"rc_mode\":\"cbr\",\"bitrate\":1001}",
+        "{\"cmd\":\"set-stream-encoding\",\"stream_id\":0,\"rc_mode\":\"cbr\",\"bitrate\":100000001}",
+        "{\"cmd\":\"set-stream-encoding\",\"stream_id\":0,\"rc_mode\":\"cbr\",\"bitrate\":2000.5}",
+        "{\"cmd\":\"set-stream-encoding\",\"stream_id\":0,\"rc_mode\":\"cbr\"}",
+        "{\"cmd\":\"set-stream-encoding\",\"stream_id\":0,\"rc_mode\":\"cbr\",\"bitrate\":2000000,\"extra\":true}",
+        "{\"cmd\":\"get-stream-encoding\",\"stream_id\":2}",
+    };
+    int writes_before = writes;
+    for (unsigned i = 0; i < sizeof(invalid) / sizeof(invalid[0]); ++i)
+        run(&st, invalid[i], false);
+    assert(writes == writes_before);
+
+    rss_config_free(st.cfg);
+    puts("stream encoding native checks passed");
+    return 0;
+}
diff --git a/tests/test_stream_fixqp.c b/tests/test_stream_fixqp.c
new file mode 100644
index 0000000000000000000000000000000000000000..c35df1356a2f1cb3234e6b60a9d7d336ad75bb63
--- /dev/null
+++ b/tests/test_stream_fixqp.c
@@ -0,0 +1,234 @@
+#include "rvd.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+static rss_video_config_t actual[2];
+static int reads;
+static int attr_error;
+
+static int get_attr(void *ctx, int chn, rss_video_config_t *out)
+{
+    (void)ctx;
+    assert(chn == 7 || chn == 8);
+    reads++;
+    if (attr_error) return RSS_ERR;
+    *out = actual[chn - 7];
+    return RSS_OK;
+}
+
+static int set_rate(void *ctx, int chn, rss_rc_mode_t mode, uint32_t bitrate)
+{
+    (void)ctx;
+    assert(chn == 7 || chn == 8);
+    actual[chn - 7].rc_mode = mode;
+    actual[chn - 7].bitrate = bitrate / 1000;
+    return RSS_OK;
+}
+
+static cJSON *command(rvd_state_t *st, const char *json, bool ok)
+{
+    char out[1024];
+    assert(rvd_stream_rc_config_command(st, json, out, sizeof(out)) > 0);
+    cJSON *reply = cJSON_Parse(out);
+    assert(reply);
+    const cJSON *status = cJSON_GetObjectItemCaseSensitive(reply, "status");
+    assert(cJSON_IsString(status));
+    assert((strcmp(status->valuestring, "ok") == 0) == ok);
+    return reply;
+}
+
+static void run(rvd_state_t *st, const char *json, bool ok)
+{
+    cJSON_Delete(command(st, json, ok));
+}
+
+static void run_encoding(rvd_state_t *st, const char *json)
+{
+    char out[1024];
+    assert(rvd_stream_encoding_command(st, json, out, sizeof(out)) > 0);
+    cJSON *reply = cJSON_Parse(out);
+    assert(reply);
+    const cJSON *status = cJSON_GetObjectItemCaseSensitive(reply, "status");
+    assert(cJSON_IsString(status) && strcmp(status->valuestring, "ok") == 0);
+    cJSON_Delete(reply);
+}
+
+static void write_config(const char *path, const char *stream0, const char *stream1)
+{
+    FILE *file = fopen(path, "w");
+    assert(file);
+    fprintf(file, "[stream0]\nenabled=true\n%s\n[stream1]\nenabled=true\n%s\n",
+        stream0, stream1);
+    fclose(file);
+}
+
+static void test_startup_readback(rvd_state_t *st, rvd_stream_t *stream, rss_hal_ops_t *ops)
+{
+    rss_video_config_t original = stream->enc_cfg;
+    rss_video_config_t original_actual = actual[0];
+    const rss_codec_t codecs[] = {RSS_CODEC_H264, RSS_CODEC_H265};
+    const int qps[] = {0, 35, 51};
+    for (size_t codec = 0; codec < sizeof(codecs) / sizeof(codecs[0]); codec++) {
+        stream->enc_cfg.codec = codecs[codec];
+        stream->enc_cfg.rc_mode = RSS_RC_FIXQP;
+        for (size_t qp = 0; qp < sizeof(qps) / sizeof(qps[0]); qp++) {
+            stream->enc_cfg.init_qp = qps[qp];
+            actual[0] = stream->enc_cfg;
+            assert(rvd_stream_rc_config_verify(st, stream) == RSS_OK);
+            actual[0].init_qp++;
+            assert(rvd_stream_rc_config_verify(st, stream) == RSS_ERR);
+            actual[0].init_qp = qps[qp];
+            actual[0].rc_mode = RSS_RC_CBR;
+            assert(rvd_stream_rc_config_verify(st, stream) == RSS_ERR);
+        }
+    }
+    stream->enc_cfg.rc_mode = RSS_RC_CBR;
+    actual[0] = stream->enc_cfg;
+    actual[0].init_qp = -123;
+    assert(rvd_stream_rc_config_verify(st, stream) == RSS_OK);
+    attr_error = 1;
+    assert(rvd_stream_rc_config_verify(st, stream) == RSS_ERR);
+    attr_error = 0;
+    ops->enc_get_channel_attr = NULL;
+    assert(rvd_stream_rc_config_verify(st, stream) == RSS_ERR);
+    stream->is_jpeg = true;
+    assert(rvd_stream_rc_config_verify(st, stream) == RSS_OK);
+    stream->is_jpeg = false;
+    ops->enc_get_channel_attr = get_attr;
+    stream->enc_cfg = original;
+    actual[0] = original_actual;
+    reads = 0;
+}
+
+int main(int argc, char **argv)
+{
+    assert(argc == 2);
+    write_config(argv[1], "rc_mode=cbr\nbitrate=2000000", "rc_mode=cbr\nbitrate=500000");
+
+    rvd_state_t st = {0};
+    rss_hal_ops_t ops = {
+        .enc_get_channel_attr = get_attr,
+        .enc_set_rc_mode = set_rate,
+    };
+    st.ops = &ops;
+    st.cfg = rss_config_load(argv[1]);
+    assert(st.cfg && rvd_stream_fixqp_config_valid(st.cfg));
+    st.stream_count = 2;
+    rvd_stream_t *stream = &st.streams[0];
+    strcpy(stream->cfg_sect, "stream0");
+    stream->chn = 7;
+    stream->sensor_idx = 0;
+    stream->enabled = true;
+    atomic_store(&st.stream_active[0], true);
+    stream->enc_cfg = (rss_video_config_t){
+        .codec = RSS_CODEC_H264, .width = 1920, .height = 1080, .profile = 2,
+        .rc_mode = RSS_RC_CBR, .bitrate = 2000000, .fps_num = 15, .fps_den = 1,
+        .gop_length = 30,
+    };
+    actual[0] = stream->enc_cfg;
+    actual[0].bitrate = 2000;
+    rvd_stream_t *sub = &st.streams[1];
+    strcpy(sub->cfg_sect, "stream1");
+    sub->chn = 8;
+    sub->sensor_idx = 0;
+    sub->enabled = true;
+    atomic_store(&st.stream_active[1], true);
+    sub->enc_cfg = (rss_video_config_t){
+        .codec = RSS_CODEC_H264, .width = 640, .height = 360, .profile = 1,
+        .rc_mode = RSS_RC_CBR, .bitrate = 500000, .fps_num = 15, .fps_den = 1,
+        .gop_length = 30,
+    };
+    actual[1] = sub->enc_cfg;
+    actual[1].bitrate = 500;
+
+    test_startup_readback(&st, stream, &ops);
+
+    cJSON *reply = command(&st, "{\"cmd\":\"get-stream-rc-config\",\"stream_id\":0}", true);
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(reply, "supported")));
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(reply, "available")));
+    assert(strcmp(cJSON_GetObjectItemCaseSensitive(reply, "active_mode")->valuestring, "cbr") == 0);
+    assert(cJSON_IsNull(cJSON_GetObjectItemCaseSensitive(reply, "active_qp")));
+    assert(cJSON_GetObjectItemCaseSensitive(reply, "qp_min")->valueint == 0);
+    assert(cJSON_GetObjectItemCaseSensitive(reply, "qp_max")->valueint == 51);
+    cJSON_Delete(reply);
+
+    const char *set_fixqp = "{\"cmd\":\"set-stream-rc-config\",\"stream_id\":0,"
+        "\"rc_mode\":\"fixqp\",\"initial_qp\":37}";
+    reply = command(&st, set_fixqp, true);
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(reply, "pending_restart")));
+    cJSON_Delete(reply);
+    assert(strcmp(rss_config_get_str(st.cfg, "stream0", "rc_mode", ""), "fixqp") == 0);
+    assert(rss_config_get_int(st.cfg, "stream0", "init_qp", -1) == 37);
+    assert(rss_config_get_int(st.cfg, "stream0", "bitrate", 0) == 2000000);
+    assert(actual[0].rc_mode == RSS_RC_CBR && reads == 2);
+
+    /* Another stream's live encoding change and save must retain pending FIXQP. */
+    run_encoding(&st, "{\"cmd\":\"set-stream-encoding\",\"stream_id\":1,"
+        "\"rc_mode\":\"vbr\",\"bitrate\":750000}");
+    assert(rss_config_save(st.cfg, argv[1]) == RSS_OK);
+    rss_config_t *disk = rss_config_load(argv[1]);
+    assert(disk);
+    assert(strcmp(rss_config_get_str(disk, "stream0", "rc_mode", ""), "fixqp") == 0);
+    assert(rss_config_get_int(disk, "stream0", "init_qp", -1) == 37);
+    assert(rss_config_get_int(disk, "stream0", "bitrate", 0) == 2000000);
+    assert(strcmp(rss_config_get_str(disk, "stream1", "rc_mode", ""), "vbr") == 0);
+    assert(rss_config_get_int(disk, "stream1", "bitrate", 0) == 750000);
+    rss_config_free(disk);
+
+    /* Simulate the full restart. Exact active mode and QP now come from HAL. */
+    stream->enc_cfg.rc_mode = RSS_RC_FIXQP;
+    stream->enc_cfg.init_qp = 37;
+    actual[0] = stream->enc_cfg;
+    actual[0].bitrate = 0;
+    reply = command(&st, "{\"cmd\":\"get-stream-rc-config\",\"stream_id\":0}", true);
+    assert(strcmp(cJSON_GetObjectItemCaseSensitive(reply, "active_mode")->valuestring,
+        "fixqp") == 0);
+    assert(cJSON_GetObjectItemCaseSensitive(reply, "active_qp")->valueint == 37);
+    cJSON_Delete(reply);
+
+    /* Unchanged retry repairs persistence without changing active state. */
+    rss_config_set_str(st.cfg, "stream0", "rc_mode", "cbr");
+    rss_config_set_int(st.cfg, "stream0", "init_qp", 10);
+    reply = command(&st, set_fixqp, true);
+    assert(cJSON_IsFalse(cJSON_GetObjectItemCaseSensitive(reply, "pending_restart")));
+    cJSON_Delete(reply);
+    assert(actual[0].rc_mode == RSS_RC_FIXQP && actual[0].init_qp == 37);
+    assert(rss_config_get_int(st.cfg, "stream0", "bitrate", 0) == 2000000);
+
+    /* Leaving FIXQP is also restart-only and keeps the prior bitrate. */
+    reply = command(&st,
+        "{\"cmd\":\"set-stream-rc-config\",\"stream_id\":0,"
+        "\"rc_mode\":\"vbr\",\"initial_qp\":37}", true);
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(reply, "pending_restart")));
+    cJSON_Delete(reply);
+    assert(strcmp(rss_config_get_str(st.cfg, "stream0", "rc_mode", ""), "vbr") == 0);
+    assert(rss_config_get_int(st.cfg, "stream0", "bitrate", 0) == 2000000);
+    assert(actual[0].rc_mode == RSS_RC_FIXQP);
+
+    const char *invalid[] = {
+        "{\"cmd\":\"set-stream-rc-config\",\"stream_id\":0,\"rc_mode\":\"fixqp\",\"initial_qp\":-1}",
+        "{\"cmd\":\"set-stream-rc-config\",\"stream_id\":0,\"rc_mode\":\"fixqp\",\"initial_qp\":52}",
+        "{\"cmd\":\"set-stream-rc-config\",\"stream_id\":0,\"rc_mode\":\"smart\",\"initial_qp\":35}",
+        "{\"cmd\":\"set-stream-rc-config\",\"stream_id\":0,\"rc_mode\":\"fixqp\",\"initial_qp\":35,\"extra\":true}",
+    };
+    for (size_t i = 0; i < sizeof(invalid) / sizeof(invalid[0]); ++i)
+        run(&st, invalid[i], false);
+
+    rss_config_free(st.cfg);
+    write_config(argv[1], "rc_mode=fixqp\ninit_qp=0", "rc_mode=fixqp\ninit_qp=51");
+    st.cfg = rss_config_load(argv[1]);
+    assert(st.cfg && rvd_stream_fixqp_config_valid(st.cfg));
+    rss_config_free(st.cfg);
+    write_config(argv[1], "rc_mode=fixqp\ninit_qp=52", "rc_mode=cbr");
+    st.cfg = rss_config_load(argv[1]);
+    assert(st.cfg && !rvd_stream_fixqp_config_valid(st.cfg));
+    rss_config_free(st.cfg);
+    write_config(argv[1], "rc_mode=cbr", "enabled=false\nrc_mode=fixqp\ninit_qp=99");
+    st.cfg = rss_config_load(argv[1]);
+    assert(st.cfg && rvd_stream_fixqp_config_valid(st.cfg));
+    rss_config_free(st.cfg);
+
+    puts("stream FIXQP restart-only checks passed");
+    return 0;
+}
diff --git a/tests/test_stream_geometry.c b/tests/test_stream_geometry.c
new file mode 100644
index 0000000000000000000000000000000000000000..148bc944cb507af2637717d377ba7246e75d56f7
--- /dev/null
+++ b/tests/test_stream_geometry.c
@@ -0,0 +1,163 @@
+#include "rvd.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+static rss_video_config_t live[2];
+static rss_ring_header_t headers[2];
+
+const rss_ring_header_t *rss_ring_get_header(rss_ring_t *ring)
+{
+    return ring == (rss_ring_t *)1 ? &headers[0] : ring == (rss_ring_t *)2 ? &headers[1] : NULL;
+}
+
+static int get_attr(void *ctx, int channel, rss_video_config_t *out)
+{
+    (void)ctx;
+    if (channel < 7 || channel > 8) return RSS_ERR;
+    *out = live[channel - 7];
+    return RSS_OK;
+}
+
+static cJSON *command(rvd_state_t *st, const char *json, bool ok)
+{
+    char output[1024];
+    assert(rvd_stream_geometry_command(st, json, output, sizeof(output)) > 0);
+    cJSON *reply = cJSON_Parse(output);
+    assert(reply);
+    const cJSON *status = cJSON_GetObjectItemCaseSensitive(reply, "status");
+    assert(cJSON_IsString(status));
+    assert((strcmp(status->valuestring, "ok") == 0) == ok);
+    return reply;
+}
+
+static void write_config(const char *path)
+{
+    FILE *file = fopen(path, "w");
+    assert(file);
+    fputs("[sensor]\nname=os02g10\n"
+          "[stream0]\nnr_vbs=1\nenabled=true\nwidth=1920\nheight=1080\njpeg=true\n"
+          "[stream1]\nnr_vbs=1\nenabled=true\nwidth=640\nheight=360\njpeg=true\n"
+          "[jpeg]\nenabled=true\n"
+          "[osd]\nfont_size=48\n"
+          "[osd.timestamp]\nmax_chars=22\n"
+          "[motion]\nenabled=true\nalgorithm=move\nroi_count=1\nroi0=0,0,639,359\n", file);
+    fclose(file);
+}
+
+int main(int argc, char **argv)
+{
+    assert(argc == 2);
+    write_config(argv[1]);
+    rvd_state_t st = {0};
+    rss_hal_ops_t ops = {.enc_get_channel_attr = get_attr};
+    st.ops = &ops;
+    st.cfg = rss_config_load(argv[1]);
+    assert(st.cfg && rvd_stream_geometry_config_valid(st.cfg));
+    st.stream_count = 2;
+    for (int i = 0; i < 2; ++i) {
+        rvd_stream_t *stream = &st.streams[i];
+        snprintf(stream->cfg_sect, sizeof(stream->cfg_sect), "stream%d", i);
+        stream->chn = 7 + i;
+        stream->fs_chn = i;
+        stream->sensor_idx = 0;
+        stream->enabled = true;
+        stream->ring = (rss_ring_t *)(uintptr_t)(i + 1);
+        atomic_store(&st.stream_active[i], true);
+        stream->enc_cfg = (rss_video_config_t){
+            .codec = RSS_CODEC_H264,
+            .width = i ? 640 : 1920,
+            .height = i ? 360 : 1080,
+            .fps_num = 15, .fps_den = 1,
+        };
+        live[i] = stream->enc_cfg;
+        headers[i].codec = RSS_CODEC_H264;
+        headers[i].width = stream->enc_cfg.width;
+        headers[i].height = stream->enc_cfg.height;
+    }
+    assert(!rvd_stream_geometry_pending(&st));
+
+    /* Existing multi-ROI and disabled-media configurations remain bootable.
+     * Startup checks every explicit ROI that the Move loader will consume,
+     * while the new geometry mutation remains a narrower single-ROI profile. */
+    rss_config_set_int(st.cfg, "motion", "roi_count", 2);
+    rss_config_set_str(st.cfg, "motion", "roi0", "0,0,319,359");
+    rss_config_set_str(st.cfg, "motion", "roi1", "320,0,639,359");
+    assert(rvd_stream_geometry_config_valid(st.cfg));
+    rss_config_set_str(st.cfg, "motion", "roi1", "320,0,640,359");
+    assert(!rvd_stream_geometry_config_valid(st.cfg));
+    rss_config_set_bool(st.cfg, "stream1", "enabled", false);
+    rss_config_set_bool(st.cfg, "jpeg", "enabled", false);
+    rss_config_set_bool(st.cfg, "stream0", "jpeg", false);
+    rss_config_set_bool(st.cfg, "stream1", "jpeg", false);
+    assert(rvd_stream_geometry_config_valid(st.cfg));
+    rss_config_set_bool(st.cfg, "stream1", "enabled", true);
+    rss_config_set_str(st.cfg, "motion", "roi1", "320,0,639,359");
+    assert(rvd_stream_geometry_config_valid(st.cfg));
+    rss_config_set_int(st.cfg, "motion", "roi_count", 1);
+    rss_config_set_str(st.cfg, "motion", "roi0", "0,0,639,359");
+    rss_config_set_bool(st.cfg, "jpeg", "enabled", true);
+    rss_config_set_bool(st.cfg, "stream0", "jpeg", true);
+    rss_config_set_bool(st.cfg, "stream1", "jpeg", true);
+
+    cJSON *reply = command(&st, "{\"cmd\":\"get-stream-geometry\",\"stream_id\":1}", true);
+    assert(cJSON_GetObjectItemCaseSensitive(reply, "active_width")->valueint == 640);
+    cJSON_Delete(reply);
+    st.ivs_roi_uncertain = true;
+    reply = command(&st, "{\"cmd\":\"get-stream-geometry\",\"stream_id\":1}", true);
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(reply, "supported")));
+    assert(cJSON_IsFalse(cJSON_GetObjectItemCaseSensitive(reply, "available")));
+    assert(cJSON_IsNull(cJSON_GetObjectItemCaseSensitive(reply, "active_width")));
+    cJSON_Delete(reply);
+    st.ivs_roi_uncertain = false;
+
+    reply = command(&st,
+        "{\"cmd\":\"set-stream-geometry-config\",\"stream0_width\":1920,"
+        "\"stream0_height\":1080,\"stream1_width\":320,\"stream1_height\":180}", true);
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(reply, "pending_restart")));
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(reply, "motion_roi_full_frame_adjusted")));
+    cJSON_Delete(reply);
+    assert(rss_config_get_int(st.cfg, "stream1", "width", 0) == 320);
+    assert(rss_config_get_int(st.cfg, "stream1", "height", 0) == 180);
+    assert(strcmp(rss_config_get_str(st.cfg, "motion", "roi0", ""), "0,0,319,179") == 0);
+    assert(rvd_stream_geometry_config_valid(st.cfg));
+    assert(live[1].width == 640 && headers[1].width == 640);
+    assert(rvd_stream_geometry_pending(&st));
+    reply = command(&st,
+        "{\"cmd\":\"set-motion-roi\",\"frame_width\":640,\"frame_height\":360,"
+        "\"roi_0_x\":0,\"roi_0_y\":0,\"roi_1_x\":640,\"roi_1_y\":360,"
+        "\"roi_count\":1}", false);
+    cJSON_Delete(reply);
+    assert(strcmp(rss_config_get_str(st.cfg, "motion", "roi0", ""), "0,0,319,179") == 0);
+
+    int saved_width = rss_config_get_int(st.cfg, "stream1", "width", 0);
+    const char *invalid[] = {
+        "{\"cmd\":\"set-stream-geometry-config\",\"stream0_width\":1920,\"stream0_height\":1080,\"stream1_width\":321,\"stream1_height\":180}",
+        "{\"cmd\":\"set-stream-geometry-config\",\"stream0_width\":1280,\"stream0_height\":720,\"stream1_width\":640,\"stream1_height\":360}",
+        "{\"cmd\":\"set-stream-geometry-config\",\"stream0_width\":1280,\"stream0_height\":720,\"stream1_width\":320,\"stream1_height\":180,\"extra\":1}",
+    };
+    for (size_t i = 0; i < sizeof(invalid) / sizeof(invalid[0]); ++i) {
+        cJSON_Delete(command(&st, invalid[i], false));
+        assert(rss_config_get_int(st.cfg, "stream1", "width", 0) == saved_width);
+    }
+
+    rss_config_set_str(st.cfg, "motion", "roi0", "200,100,319,179");
+    cJSON_Delete(command(&st,
+        "{\"cmd\":\"set-stream-geometry-config\",\"stream0_width\":1920,"
+        "\"stream0_height\":1080,\"stream1_width\":480,\"stream1_height\":270}", true));
+    rss_config_set_str(st.cfg, "motion", "roi0", "200,100,479,269");
+    cJSON_Delete(command(&st,
+        "{\"cmd\":\"set-stream-geometry-config\",\"stream0_width\":1920,"
+        "\"stream0_height\":1080,\"stream1_width\":320,\"stream1_height\":180}", false));
+    assert(rss_config_get_int(st.cfg, "stream1", "width", 0) == 480);
+
+    rss_config_set_int(st.cfg, "osd", "font_size", 49);
+    assert(rvd_stream_geometry_config_valid(st.cfg));
+    rss_config_set_int(st.cfg, "osd", "font_size", 48);
+    rss_config_set_str(st.cfg, "motion", "roi0", "0,0,639,359");
+    assert(!rvd_stream_geometry_config_valid(st.cfg));
+
+    rss_config_free(st.cfg);
+    puts("stream geometry native checks passed");
+    return 0;
+}
diff --git a/tests/test_stream_gop.c b/tests/test_stream_gop.c
new file mode 100644
index 0000000000000000000000000000000000000000..2d8c9238eebefffbf35164b24a229bc9c3f94a04
--- /dev/null
+++ b/tests/test_stream_gop.c
@@ -0,0 +1,174 @@
+#include "rvd.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+static uint32_t actual = 30;
+static rss_gop_mode_t actual_mode = RSS_GOP_DEFAULT;
+static int reads, mode_reads, writes, fail_read_at, fail_mode_read_at;
+static bool fail_set, clamp;
+static int get(void *ctx, int chn, uint32_t *out)
+{
+    (void)ctx; assert(chn == 7); reads++;
+    if (reads == fail_read_at) return RSS_ERR;
+    *out = actual; return RSS_OK;
+}
+static int get_mode(void *ctx, int chn, rss_gop_mode_t *out)
+{
+    (void)ctx; assert(chn == 7); mode_reads++;
+    if (mode_reads == fail_mode_read_at) return RSS_ERR;
+    *out = actual_mode; return RSS_OK;
+}
+static int set(void *ctx, int chn, uint32_t value)
+{
+    (void)ctx; assert(chn == 7); writes++;
+    if (fail_set) return RSS_ERR;
+    actual = clamp ? value + 1 : value; return RSS_OK;
+}
+static cJSON *command(rvd_state_t *st, const char *json, bool ok)
+{
+    char out[1024];
+    assert(rvd_stream_gop_command(st, json, out, sizeof(out)) > 0);
+    cJSON *r = cJSON_Parse(out);
+    const cJSON *status = cJSON_GetObjectItemCaseSensitive(r, "status");
+    assert(cJSON_IsString(status));
+    assert((strcmp(status->valuestring, "ok") == 0) == ok);
+    return r;
+}
+static void run(rvd_state_t *st, const char *json, bool ok) { cJSON_Delete(command(st, json, ok)); }
+static cJSON *mode_command(rvd_state_t *st, const char *json, bool ok)
+{
+    char out[1024];
+    assert(rvd_stream_gop_mode_command(st, json, out, sizeof(out)) > 0);
+    cJSON *r = cJSON_Parse(out);
+    const cJSON *status = cJSON_GetObjectItemCaseSensitive(r, "status");
+    assert(cJSON_IsString(status));
+    assert((strcmp(status->valuestring, "ok") == 0) == ok);
+    return r;
+}
+int main(int argc, char **argv)
+{
+    assert(argc == 2);
+    FILE *f = fopen(argv[1], "w"); assert(f); fputs("[stream0]\ngop=30\n", f); fclose(f);
+    rvd_state_t st = {0};
+    rss_hal_ops_t ops = { .enc_get_gop_attr = get, .enc_set_gop = set,
+        .enc_get_gop_mode = get_mode };
+    st.ops = &ops; st.cfg = rss_config_load(argv[1]); assert(st.cfg);
+    st.stream_count = 2;
+    st.streams[0].is_jpeg = true; /* Deliberately not the target index/channel. */
+    rvd_stream_t *s = &st.streams[1];
+    strcpy(s->cfg_sect, "stream0"); s->chn = 7; s->enc_cfg.codec = RSS_CODEC_H264;
+    s->enc_cfg.gop_length = 15; s->enabled = true; atomic_store(&st.stream_active[1], true);
+    assert(rvd_stream_gop_prepare(&st, s) == RSS_OK);
+    assert(s->enc_cfg.gop_length == 30 && !s->gop_checked);
+    assert(rvd_stream_gop_verify(&st, s) == RSS_OK && s->gop_checked);
+    const char *request = "{\"cmd\":\"set-stream-gop\",\"stream_id\":0,\"gop\":60}";
+    run(&st, request, true); assert(actual == 60 && writes == 1);
+    /* Same observed value repairs stale cache and disk without another setter. */
+    rss_config_set_int(st.cfg, "stream0", "gop", 20);
+    run(&st, request, true); assert(writes == 1);
+    assert(rss_config_save(st.cfg, argv[1]) == RSS_OK);
+    rss_config_t *disk = rss_config_load(argv[1]); assert(disk);
+    assert(rss_config_get_int(disk, "stream0", "gop", 0) == 60);
+    rss_config_free(st.cfg); st.cfg = disk;
+    s->enc_cfg.gop_length = 1;
+    assert(rvd_stream_gop_prepare(&st, s) == RSS_OK && s->enc_cfg.gop_length == 60);
+    assert(rvd_stream_gop_verify(&st, s) == RSS_OK);
+    actual = 30; fail_set = true; run(&st, request, false); fail_set = false;
+    clamp = true; run(&st, request, false); clamp = false;
+    actual = 30; fail_read_at = reads + 2; run(&st, request, false); fail_read_at = 0;
+    fail_read_at = reads + 1; run(&st, request, false); fail_read_at = 0;
+    s->enabled = false; run(&st, request, false); s->enabled = true;
+    atomic_store(&st.stream_active[1], false); run(&st, request, false); atomic_store(&st.stream_active[1], true);
+    s->enc_cfg.gop_mode = RSS_GOP_SMARTP; actual_mode = RSS_GOP_SMARTP;
+    run(&st, request, true);
+    actual_mode = RSS_GOP_DEFAULT; run(&st, request, false);
+    actual_mode = RSS_GOP_SMARTP; fail_mode_read_at = mode_reads + 1;
+    run(&st, request, false); fail_mode_read_at = 0;
+    s->enc_cfg.gop_mode = RSS_GOP_DEFAULT; actual_mode = RSS_GOP_DEFAULT;
+    s->enc_cfg.codec = RSS_CODEC_JPEG; run(&st, request, false); s->enc_cfg.codec = RSS_CODEC_H265;
+    ops.enc_set_gop = NULL; run(&st, request, false); ops.enc_set_gop = set;
+    run(&st, "{\"cmd\":\"set-stream-gop\",\"stream_id\":1,\"gop\":60}", false);
+    strcpy(s->cfg_sect, "stream1");
+    run(&st, "{\"cmd\":\"set-stream-gop\",\"stream_id\":1,\"gop\":61}", true);
+    assert(actual == 61 && rss_config_get_int(st.cfg, "stream1", "gop", 0) == 61);
+    run(&st, request, false); /* The old semantic identity no longer exists. */
+    strcpy(s->cfg_sect, "stream0");
+    const char *invalid[] = {"0", "65536", "-1", "1.5", "true", "\"30\""};
+    for (unsigned i = 0; i < sizeof(invalid)/sizeof(invalid[0]); i++) {
+        char req[128]; snprintf(req, sizeof(req), "{\"cmd\":\"set-stream-gop\",\"stream_id\":0,\"gop\":%s}", invalid[i]); run(&st, req, false);
+    }
+    run(&st, "{\"cmd\":\"set-stream-gop\",\"stream_id\":0,\"gop\":1}", true);
+    run(&st, "{\"cmd\":\"set-stream-gop\",\"stream_id\":0,\"gop\":65535}", true);
+    const char *bad[] = {"0", "65536", "30x", "-1", "", "1.5"};
+    for (unsigned i = 0; i < sizeof(bad)/sizeof(bad[0]); i++) {
+        rss_config_set_str(st.cfg, "stream0", "gop", bad[i]);
+        assert(rvd_stream_gop_prepare(&st, s) != RSS_OK && !s->gop_checked);
+    }
+    rss_config_set_int(st.cfg, "stream0", "gop", 30);
+    assert(rvd_stream_gop_prepare(&st, s) == RSS_OK);
+    actual = 29; assert(rvd_stream_gop_verify(&st, s) != RSS_OK && !s->gop_checked);
+    actual = 30; fail_read_at = reads + 1; assert(rvd_stream_gop_verify(&st, s) != RSS_OK); fail_read_at = 0;
+    assert(rvd_stream_gop_verify(&st, s) == RSS_OK);
+    /* Startup must fail if the SDK silently substitutes or cannot name the saved mode. */
+    s->enc_cfg.gop_mode = RSS_GOP_PYRAMIDAL;
+    actual_mode = RSS_GOP_DEFAULT;
+    assert(rvd_stream_gop_verify(&st, s) != RSS_OK && !s->gop_checked);
+    actual_mode = (rss_gop_mode_t)7;
+    assert(rvd_stream_gop_verify(&st, s) != RSS_OK && !s->gop_checked);
+    s->enc_cfg.gop_mode = RSS_GOP_DEFAULT;
+    actual_mode = RSS_GOP_DEFAULT;
+    assert(rvd_stream_gop_verify(&st, s) == RSS_OK && s->gop_checked);
+    cJSON *mode = mode_command(&st,
+        "{\"cmd\":\"get-stream-gop-mode\",\"stream_id\":0}", true);
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(mode, "available")));
+    assert(strcmp(cJSON_GetObjectItemCaseSensitive(mode, "active_mode")->valuestring,
+                  "default") == 0);
+    cJSON_Delete(mode);
+    mode = mode_command(&st,
+        "{\"cmd\":\"set-stream-gop-mode\",\"stream_id\":0,\"gop_mode\":\"pyramidal\"}", true);
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(mode, "pending_restart")));
+    cJSON_Delete(mode);
+    assert(strcmp(rss_config_get_str(st.cfg, "stream0", "gop_mode", ""), "pyramidal") == 0);
+    assert(actual_mode == RSS_GOP_DEFAULT && s->enc_cfg.gop_mode == RSS_GOP_DEFAULT);
+    mode = mode_command(&st,
+        "{\"cmd\":\"set-stream-gop-mode\",\"stream_id\":0,\"gop_mode\":\"default\"}", true);
+    assert(cJSON_IsFalse(cJSON_GetObjectItemCaseSensitive(mode, "pending_restart")));
+    cJSON_Delete(mode);
+    mode_command(&st,
+        "{\"cmd\":\"set-stream-gop-mode\",\"stream_id\":0,\"gop_mode\":\"smart\"}", false);
+    actual_mode = (rss_gop_mode_t)7;
+    mode = mode_command(&st,
+        "{\"cmd\":\"get-stream-gop-mode\",\"stream_id\":0}", true);
+    assert(cJSON_IsFalse(cJSON_GetObjectItemCaseSensitive(mode, "available")));
+    assert(cJSON_IsNull(cJSON_GetObjectItemCaseSensitive(mode, "active_mode")));
+    cJSON_Delete(mode);
+    actual_mode = RSS_GOP_DEFAULT;
+    rss_config_set_str(st.cfg, "stream0", "gop_mode", "smart");
+    assert(!rvd_stream_gop_mode_config_valid(st.cfg));
+    rss_config_set_str(st.cfg, "stream0", "gop_mode", "smartp");
+    assert(rvd_stream_gop_mode_config_valid(st.cfg));
+    rss_gop_mode_t loaded_mode = RSS_GOP_DEFAULT;
+    assert(rvd_stream_gop_mode_load(st.cfg, "stream0", &loaded_mode));
+    assert(loaded_mode == RSS_GOP_SMARTP);
+    rss_config_set_str(st.cfg, "stream0", "gop_mode", "PYRAMIDAL");
+    assert(rvd_stream_gop_mode_load(st.cfg, "stream0", &loaded_mode));
+    assert(loaded_mode == RSS_GOP_PYRAMIDAL);
+    s->codec_uncertain = true;
+    int writes_before_recovery = writes;
+    cJSON *blocked = command(&st, "{\"cmd\":\"get-stream-gop\",\"stream_id\":0}", true);
+    assert(cJSON_IsFalse(cJSON_GetObjectItemCaseSensitive(blocked, "available")));
+    cJSON_Delete(blocked);
+    run(&st, request, false);
+    assert(writes == writes_before_recovery);
+    s->codec_uncertain = false;
+    cJSON *r = command(&st, "{\"cmd\":\"get-stream-gop\",\"stream_id\":0}", true);
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(r, "available"))); cJSON_Delete(r);
+    fail_read_at = reads + 1;
+    r = command(&st, "{\"cmd\":\"get-stream-gop\",\"stream_id\":0}", true);
+    assert(cJSON_IsFalse(cJSON_GetObjectItemCaseSensitive(r, "available")));
+    assert(cJSON_IsNull(cJSON_GetObjectItemCaseSensitive(r, "gop"))); cJSON_Delete(r);
+    rss_config_free(st.cfg);
+    puts("stream GOP native checks passed");
+    return 0;
+}
diff --git a/tests/test_stream_init_verify.c b/tests/test_stream_init_verify.c
