diff --git a/rad/rad_output.c b/rad/rad_output.c
new file mode 100644
index 0000000000000000000000000000000000000000..5109e6ef6c91542b11c1f174b93988c31b12eaca
--- /dev/null
+++ b/rad/rad_output.c
@@ -0,0 +1,305 @@
+/* Control and startup own the output lifecycle. The playback thread must be
+ * joined before the control thread tears down or replaces the HAL instance. */
+#include "rad_state.h"
+#include "rad_level.h"
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+static const char *clip_state_name(int state)
+{
+    switch (state) {
+    case RAD_CLIP_IDLE: return "idle";
+    case RAD_CLIP_ACCEPTED: return "accepted";
+    case RAD_CLIP_RUNNING: return "running";
+    case RAD_CLIP_COMPLETED: return "completed";
+    case RAD_CLIP_PREEMPTED: return "preempted";
+    case RAD_CLIP_CANCELLED: return "cancelled";
+    default: return "error";
+    }
+}
+
+static bool clip_terminal(int state)
+{
+    return state == RAD_CLIP_IDLE || state == RAD_CLIP_COMPLETED ||
+        state == RAD_CLIP_PREEMPTED || state == RAD_CLIP_CANCELLED ||
+        state == RAD_CLIP_ERROR;
+}
+
+static int clip_file_size(int repeats, off_t *size)
+{
+    int fd = open(RAD_MOTION_CLIP_PATH, O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+    if (fd < 0) return RSS_ERR;
+    struct stat st;
+    int ret = fstat(fd, &st);
+    close(fd);
+    off_t max_bytes = (off_t)RAD_MOTION_CLIP_RATE * 2 * RAD_MOTION_CLIP_MAX_MS / 1000;
+    if (ret != 0 || !S_ISREG(st.st_mode) || st.st_size <= 0 || (st.st_size & 1) ||
+        st.st_size > max_bytes || st.st_size > max_bytes / repeats) {
+        return RSS_ERR_INVAL;
+    }
+    *size = st.st_size;
+    return RSS_OK;
+}
+
+static int clip_response(char *buf, int size, int state, int repeats,
+                         unsigned generation, bool talkback_active)
+{
+    cJSON *root = cJSON_CreateObject();
+    if (!root) return rss_ctrl_resp_error(buf, size, "json alloc failed");
+    cJSON_AddStringToObject(root, "status", "ok");
+    cJSON_AddStringToObject(root, "clip", "motion");
+    cJSON_AddStringToObject(root, "playback", clip_state_name(state));
+    cJSON_AddNumberToObject(root, "repeats", repeats);
+    cJSON_AddNumberToObject(root, "sample_rate", RAD_MOTION_CLIP_RATE);
+    cJSON_AddNumberToObject(root, "max_duration_ms", RAD_MOTION_CLIP_MAX_MS);
+    cJSON_AddBoolToObject(root, "talkback_active", talkback_active);
+    cJSON_AddNumberToObject(root, "generation", generation);
+    return rss_ctrl_resp_json(buf, size, root);
+}
+
+static int clip_status(rad_ctrl_ctx_t *ctx, char *buf, int size)
+{
+    return clip_response(buf, size,
+                         atomic_load(&ctx->ao_ctx->clip_state),
+                         atomic_load(&ctx->ao_ctx->clip_repeats),
+                         atomic_load(&ctx->ao_ctx->clip_generation),
+                         atomic_load(&ctx->ao_ctx->speaker_ring_active));
+}
+
+#ifdef RAD_TEST_CLIP_ACCEPT_HOOK
+extern void rad_test_clip_accept_hook(ao_thread_ctx_t *ctx);
+#endif
+
+int rad_clip_cancel(rad_ctrl_ctx_t *ctx, bool wait)
+{
+    if (!ctx->ao_ctx) return RSS_ERR;
+    int state = atomic_load(&ctx->ao_ctx->clip_state);
+    if (state != RAD_CLIP_ACCEPTED && state != RAD_CLIP_RUNNING) return RSS_OK;
+    atomic_store(&ctx->ao_ctx->clip_cancel, true);
+    if (!wait) return RSS_OK;
+    int64_t deadline = rss_timestamp_us() + 200000;
+    while (rad_output_ready(ctx)) {
+        state = atomic_load(&ctx->ao_ctx->clip_state);
+        if (state == RAD_CLIP_CANCELLED || state == RAD_CLIP_PREEMPTED ||
+            state == RAD_CLIP_COMPLETED || state == RAD_CLIP_ERROR) {
+            return RSS_OK;
+        }
+        if (rss_timestamp_us() >= deadline) return RSS_ERR;
+        usleep(1000);
+    }
+    return RSS_ERR;
+}
+
+int rad_clip_command(rad_ctrl_ctx_t *ctx, const char *json, char *buf, int size)
+{
+    char cmd[32];
+    if (rss_json_get_str(json, "cmd", cmd, sizeof(cmd)) != 0)
+        return rss_ctrl_resp_error(buf, size, "missing clip command");
+    if (strcmp(cmd, "ao-clip-status") == 0) return clip_status(ctx, buf, size);
+    if (strcmp(cmd, "ao-cancel-clip") == 0) {
+        int ret = rad_clip_cancel(ctx, true);
+        return ret == RSS_OK ? clip_status(ctx, buf, size)
+                             : rss_ctrl_resp_error(buf, size, "clip cancel failed");
+    }
+    if (strcmp(cmd, "ao-play-clip") != 0)
+        return rss_ctrl_resp_error(buf, size, "unknown clip command");
+    cJSON *root = cJSON_ParseWithOpts(json, NULL, true);
+    cJSON *clip = cJSON_GetObjectItemCaseSensitive(root, "clip");
+    cJSON *repeats = cJSON_GetObjectItemCaseSensitive(root, "repeats");
+    bool valid = cJSON_IsObject(root) && cJSON_GetArraySize(root) == 3 &&
+        cJSON_IsString(clip) && strcmp(clip->valuestring, "motion") == 0 &&
+        cJSON_IsNumber(repeats) && repeats->valuedouble == repeats->valueint &&
+        repeats->valueint >= 1 && repeats->valueint <= 3;
+    int repeat_count = valid ? repeats->valueint : 0;
+    cJSON_Delete(root);
+    off_t file_size = 0;
+    if (!valid || clip_file_size(repeat_count, &file_size) != RSS_OK)
+        return rss_ctrl_resp_error(buf, size, "invalid built-in motion clip");
+    if (!rad_output_ready(ctx) || ctx->muted || ctx->ao_muted ||
+        atomic_load(&ctx->ao_ctx->sample_rate) != RAD_MOTION_CLIP_RATE)
+        return rss_ctrl_resp_error(buf, size, "speaker output is unavailable");
+    if (atomic_load(&ctx->ao_ctx->speaker_ring_active))
+        return rss_ctrl_resp_error(buf, size, "speaker is owned by talkback");
+    int state = atomic_load(&ctx->ao_ctx->clip_state);
+    if (!clip_terminal(state)) return rss_ctrl_resp_error(buf, size, "clip is busy");
+    atomic_store(&ctx->ao_ctx->clip_repeats, repeat_count);
+    atomic_store(&ctx->ao_ctx->clip_cancel, false);
+    unsigned generation = atomic_fetch_add(&ctx->ao_ctx->clip_generation, 1) + 1;
+    atomic_store(&ctx->ao_ctx->clip_state, RAD_CLIP_ACCEPTED);
+#ifdef RAD_TEST_CLIP_ACCEPT_HOOK
+    rad_test_clip_accept_hook(ctx->ao_ctx);
+#endif
+    (void)file_size;
+    return clip_response(buf, size, RAD_CLIP_ACCEPTED, repeat_count,
+                         generation, false);
+}
+
+bool rad_output_ready(const rad_ctrl_ctx_t *ctx)
+{
+    return ctx->ao_enabled && !ctx->ao_cleanup_pending &&
+        !atomic_load(&ctx->ao_ctx->failure) && !atomic_load(&ctx->ao_ctx->completed);
+}
+
+int rad_output_flush(rad_ctrl_ctx_t *ctx)
+{
+    if (!rad_output_ready(ctx)) {
+        return RSS_ERR;
+    }
+    int state = atomic_load(&ctx->ao_ctx->flush);
+    /* Do not turn a late completion of an earlier timed-out request into
+     * success for a new request. Retry only after that operation completes. */
+    if (state != RAD_FLUSH_IDLE && state != RAD_FLUSH_DONE) {
+        return RSS_ERR;
+    }
+    atomic_store(&ctx->ao_ctx->flush, RAD_FLUSH_REQUESTED);
+    int64_t deadline = rss_timestamp_us() + 200000;
+    while (rad_output_ready(ctx)) {
+        if (atomic_load(&ctx->ao_ctx->flush) == RAD_FLUSH_DONE) {
+            return RSS_OK;
+        }
+        if (rss_timestamp_us() >= deadline) {
+            return RSS_ERR;
+        }
+        usleep(1000);
+    }
+    return RSS_ERR;
+}
+
+int rad_output_set_mute(rad_ctrl_ctx_t *ctx, bool muted)
+{
+    if (!rad_output_ready(ctx)) return RSS_ERR;
+    if (muted && rad_output_flush(ctx) != RSS_OK) return RSS_ERR;
+    int ret = muted
+        ? RSS_HAL_CALL(ctx->ops, ao_soft_mute, ctx->hal_ctx, 0, 0)
+        : RSS_HAL_CALL(ctx->ops, ao_soft_unmute, ctx->hal_ctx, 0, 0);
+    if (ret == RSS_OK) ctx->ao_muted = muted;
+    return ret;
+}
+
+int rad_output_stop(rad_ctrl_ctx_t *ctx)
+{
+    bool initialized = ctx->ao_enabled || ctx->ao_cleanup_pending;
+    ctx->ao_cleanup_pending = initialized || *ctx->ao_thread_started;
+    ctx->ao_enabled = false;
+    if (*ctx->ao_thread_started) {
+        (void)rad_clip_cancel(ctx, false);
+        atomic_store(&ctx->ao_ctx->stop, true);
+        int64_t deadline = rss_timestamp_us() + 200000;
+        while (!atomic_load(&ctx->ao_ctx->completed)) {
+            if (rss_timestamp_us() >= deadline) {
+                return RSS_ERR;
+            }
+            usleep(1000);
+        }
+        if (pthread_join(*ctx->ao_tid, NULL) != 0) {
+            return RSS_ERR;
+        }
+        *ctx->ao_thread_started = false;
+    }
+    ctx->ao_flush = NULL;
+    ctx->ao_sample_rate = NULL;
+#ifdef RAPTOR_AUDIO_EFFECTS
+    if (ctx->input_effects_owned & 8) {
+        int ret = RSS_HAL_CALL(ctx->ops, audio_disable_aec, ctx->hal_ctx);
+        ret = rad_input_track_processing(ctx, 8, false, ret);
+        if (ret != RSS_OK) {
+            return ret;
+        }
+    }
+    ctx->aec_enabled = false;
+#endif
+    if (initialized) {
+        int clear_ret = RSS_HAL_CALL(ctx->ops, ao_clear_buf, ctx->hal_ctx);
+        int ret = RSS_HAL_CALL(ctx->ops, ao_deinit, ctx->hal_ctx);
+        if (ret != RSS_OK) {
+            return ret;
+        }
+        if (clear_ret != RSS_OK) {
+            ctx->ao_cleanup_pending = false;
+            atomic_store(&ctx->ao_ctx->failure, 0);
+            return clear_ret;
+        }
+    }
+    ctx->ao_cleanup_pending = false;
+    atomic_store(&ctx->ao_ctx->failure, 0);
+    return RSS_OK;
+}
+
+int rad_output_start(rad_ctrl_ctx_t *ctx, int rate)
+{
+    const int rates[] = {8000, 16000, 24000, 32000, 44100, 48000, 96000};
+    bool valid = false;
+    for (size_t i = 0; i < sizeof(rates) / sizeof(rates[0]); ++i) {
+        valid |= rate == rates[i];
+    }
+    if (!valid || ctx->ao_volume < -30 || ctx->ao_volume > 120 ||
+        ctx->ao_gain < 0 || ctx->ao_gain > 31) {
+        return RSS_ERR_INVAL;
+    }
+    int ret = rad_output_stop(ctx);
+    if (ret != RSS_OK) {
+        return ret;
+    }
+    rss_audio_config_t config = {
+        .sample_rate = rate,
+        .samples_per_frame = rate / 50,
+        .chn_count = 1,
+        .frame_depth = 20,
+    };
+    ctx->ao_cleanup_pending = true;
+    ret = RSS_HAL_CALL(ctx->ops, ao_init, ctx->hal_ctx, &config);
+    if (ret != RSS_OK) {
+        goto failed;
+    }
+    ret = rad_apply_level(ctx->ops, ctx->hal_ctx, true, false, ctx->ai_dev, ctx->ao_volume);
+    if (ret != RSS_OK) {
+        goto failed;
+    }
+    ret = rad_apply_level(ctx->ops, ctx->hal_ctx, true, true, ctx->ai_dev, ctx->ao_gain);
+    if (ret != RSS_OK) {
+        goto failed;
+    }
+    ret = ctx->ao_muted
+        ? RSS_HAL_CALL(ctx->ops, ao_soft_mute, ctx->hal_ctx, 0, 0)
+        : RSS_HAL_CALL(ctx->ops, ao_soft_unmute, ctx->hal_ctx, 0, 0);
+    if (ret != RSS_OK) {
+        goto failed;
+    }
+    ret = RSS_HAL_CALL(ctx->ops, ao_clear_buf, ctx->hal_ctx);
+    if (ret != RSS_OK) {
+        goto failed;
+    }
+    atomic_store(&ctx->ao_ctx->stop, false);
+    atomic_store(&ctx->ao_ctx->completed, false);
+    atomic_store(&ctx->ao_ctx->failure, 0);
+    atomic_store(&ctx->ao_ctx->flush, RAD_FLUSH_IDLE);
+    atomic_store(&ctx->ao_ctx->sample_rate, rate);
+    atomic_store(&ctx->ao_ctx->clip_state, RAD_CLIP_IDLE);
+    atomic_store(&ctx->ao_ctx->clip_repeats, 0);
+    atomic_store(&ctx->ao_ctx->clip_cancel, false);
+    atomic_store(&ctx->ao_ctx->speaker_ring_active, false);
+    if (pthread_create(ctx->ao_tid, NULL, ao_playback_thread, ctx->ao_ctx) != 0) {
+        atomic_store(&ctx->ao_ctx->completed, true);
+        ret = RSS_ERR;
+        goto failed;
+    }
+    *ctx->ao_thread_started = true;
+    ctx->ao_flush = &ctx->ao_ctx->flush;
+    ctx->ao_sample_rate = &ctx->ao_ctx->sample_rate;
+    ctx->ao_enabled = true;
+    ctx->ao_cleanup_pending = false;
+    return RSS_OK;
+failed:
+    (void)rad_output_stop(ctx);
+    return ret;
+}
+
+int rad_output_boot(rad_ctrl_ctx_t *ctx)
+{
+    if (!rss_config_get_bool(ctx->cfg, "audio", "ao_enabled", false)) {
+        return RSS_OK;
+    }
+    int rate = rss_config_get_int(ctx->cfg, "audio", "ao_sample_rate", ctx->sample_rate);
+    return rad_output_start(ctx, rate);
+}
diff --git a/rad/rad_readback.c b/rad/rad_readback.c
new file mode 100644
index 0000000000000000000000000000000000000000..57be32b6adff320768f33057dce148b05cb02cd7
--- /dev/null
+++ b/rad/rad_readback.c
@@ -0,0 +1,76 @@
+#include <rss_common.h>
+#include "rad_level.h"
+
+int rad_audio_levels(const rss_hal_ops_t *ops, void *ctx, int dev,
+                     bool ai_enabled, bool ao_enabled, char *buf, int size)
+{
+    static const char *names[] = {"mic_vol", "mic_gain", "spk_vol", "spk_gain"};
+    cJSON *root = cJSON_CreateObject();
+    if (!root) return rss_ctrl_resp_error(buf, size, "json alloc failed");
+    cJSON_AddStringToObject(root, "status", "ok");
+    cJSON_AddBoolToObject(root, "ai_enabled", ai_enabled);
+    cJSON_AddBoolToObject(root, "ao_enabled", ao_enabled);
+    cJSON *fields = cJSON_AddObjectToObject(root, "fields");
+    if (!fields) {
+        cJSON_Delete(root);
+        return rss_ctrl_resp_error(buf, size, "json alloc failed");
+    }
+    for (int id = 0; id < 4; ++id) {
+        bool output = id >= 2, gain = id % 2;
+        int value = 0, ret = RSS_ERR_NOTSUP;
+        bool supported = output
+            ? (gain ? ops->ao_set_gain && ops->ao_get_gain : ops->ao_set_volume && ops->ao_get_volume)
+            : (gain ? ops->audio_set_gain && ops->audio_get_gain : ops->audio_set_volume && ops->audio_get_volume);
+        if (supported && (output ? ao_enabled : ai_enabled)) {
+            if (output) ret = gain ? RSS_HAL_CALL(ops, ao_get_gain, ctx, &value)
+                                   : RSS_HAL_CALL(ops, ao_get_volume, ctx, &value);
+            else ret = gain ? RSS_HAL_CALL(ops, audio_get_gain, ctx, dev, 0, &value)
+                            : RSS_HAL_CALL(ops, audio_get_volume, ctx, dev, 0, &value);
+        }
+        bool available = ret == RSS_OK && value >= (gain ? 0 : -30) && value <= (gain ? 31 : 120);
+        cJSON *field = cJSON_AddObjectToObject(fields, names[id]);
+        if (!field) {
+            cJSON_Delete(root);
+            return rss_ctrl_resp_error(buf, size, "json alloc failed");
+        }
+        cJSON_AddBoolToObject(field, "supported", supported);
+        cJSON_AddBoolToObject(field, "available", available);
+        if (available) cJSON_AddNumberToObject(field, "value", value);
+        else cJSON_AddNullToObject(field, "value");
+        cJSON_AddNumberToObject(field, "min", gain ? 0 : -30);
+        cJSON_AddNumberToObject(field, "max", gain ? 31 : 120);
+    }
+    return rss_ctrl_resp_json(buf, size, root);
+}
+
+int rad_audio_alc(const rss_hal_ops_t *ops, void *ctx, int dev,
+                  bool active, char *buf, int size)
+{
+    bool supported = ops->audio_set_alc_gain && ops->audio_get_alc_gain;
+    int observed = -1;
+    int ret = RSS_ERR_NOTSUP;
+    if (supported && active) {
+        ret = RSS_HAL_CALL(ops, audio_get_alc_gain, ctx, dev, 0, &observed);
+    }
+    bool available = ret == RSS_OK && observed >= 0 && observed <= 7;
+    cJSON *root = cJSON_CreateObject();
+    if (!root) {
+        return rss_ctrl_resp_error(buf, size, "json alloc failed");
+    }
+    cJSON_AddStringToObject(root, "status", "ok");
+    cJSON *field = cJSON_AddObjectToObject(root, "field");
+    if (!field) {
+        cJSON_Delete(root);
+        return rss_ctrl_resp_error(buf, size, "json alloc failed");
+    }
+    cJSON_AddBoolToObject(field, "supported", supported);
+    cJSON_AddBoolToObject(field, "available", available);
+    if (available) {
+        cJSON_AddNumberToObject(field, "value", observed);
+    } else {
+        cJSON_AddNullToObject(field, "value");
+    }
+    cJSON_AddNumberToObject(field, "min", 0);
+    cJSON_AddNumberToObject(field, "max", 7);
+    return rss_ctrl_resp_json(buf, size, root);
+}
diff --git a/rad/rad_state.h b/rad/rad_state.h
new file mode 100644
index 0000000000000000000000000000000000000000..7926480eb5eefd599771eb481f039856c0583941
--- /dev/null
+++ b/rad/rad_state.h
@@ -0,0 +1,117 @@
+/* RAD owner state shared by control, startup and checked lifecycle code. */
+#ifndef RAD_STATE_H
+#define RAD_STATE_H
+#include "rad.h"
+#include <raptor_hal.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <signal.h>
+
+enum {
+    RAD_FLUSH_IDLE,
+    RAD_FLUSH_REQUESTED,
+    RAD_FLUSH_PROCESSING,
+    RAD_FLUSH_DONE,
+};
+
+enum {
+    RAD_CLIP_IDLE,
+    RAD_CLIP_ACCEPTED,
+    RAD_CLIP_RUNNING,
+    RAD_CLIP_COMPLETED,
+    RAD_CLIP_PREEMPTED,
+    RAD_CLIP_CANCELLED,
+    RAD_CLIP_ERROR,
+};
+
+#define RAD_MOTION_CLIP_RATE 16000
+#define RAD_MOTION_CLIP_MAX_MS 10000
+#ifndef RAD_MOTION_CLIP_PATH
+#define RAD_MOTION_CLIP_PATH "/usr/share/raptor/audio/motion.pcm"
+#endif
+
+typedef struct {
+	const rss_hal_ops_t *ops;
+	rss_hal_ctx_t *hal_ctx;
+	volatile sig_atomic_t *running;
+	_Atomic bool stop;
+	_Atomic bool completed;
+	_Atomic int failure;
+	_Atomic int flush;
+	_Atomic int sample_rate;
+	_Atomic int clip_state;
+	_Atomic int clip_repeats;
+	_Atomic bool clip_cancel;
+	_Atomic bool speaker_ring_active;
+	_Atomic unsigned clip_generation;
+} ao_thread_ctx_t;
+
+void *ao_playback_thread(void *arg);
+
+/* ── Control socket handler ── */
+
+typedef struct {
+	rss_config_t *cfg;
+	const char *config_path;
+	const rss_hal_ops_t *ops;
+	rss_hal_ctx_t *hal_ctx;
+	int ai_dev;
+	rss_audio_input_t input_type;
+	int volume;
+	int gain;
+	int sample_rate;
+	int codec_id;
+	const char *codec_str;
+	bool ao_enabled;
+	bool ao_cleanup_pending;
+	int ao_volume;
+	int ao_gain;
+	_Atomic int *ao_flush;
+	_Atomic int *ao_sample_rate;
+#ifdef RAPTOR_AUDIO_EFFECTS
+	bool aec_enabled;
+	bool ns_enabled;
+	bool hpf_enabled;
+	bool agc_enabled;
+    int ns_level;
+    int agc_target;
+    int agc_compression;
+#endif
+	bool muted;
+	bool ao_muted;
+	bool ai_disabled;
+	bool ai_cleanup_pending;
+	unsigned input_effects_owned;
+	/* AO thread lifecycle (for ao-disable/ao-enable) */
+	ao_thread_ctx_t *ao_ctx;
+	pthread_t *ao_tid;
+	bool *ao_thread_started;
+	/* Pipeline state — updated by ctrl handler on restart */
+	rss_ring_t **ring;
+	const rad_codec_ops_t **codec_ops;
+	rad_codec_ctx_t *codec_ctx;
+	uint8_t **encode_buf;
+	int *encode_buf_size;
+	int64_t *synth_audio_ts;
+} rad_ctrl_ctx_t;
+
+int rad_output_flush(rad_ctrl_ctx_t *ctx);
+int rad_output_set_mute(rad_ctrl_ctx_t *ctx, bool muted);
+int rad_clip_command(rad_ctrl_ctx_t *ctx, const char *json, char *buf, int size);
+int rad_clip_cancel(rad_ctrl_ctx_t *ctx, bool wait);
+bool rad_output_ready(const rad_ctrl_ctx_t *ctx);
+int rad_output_start(rad_ctrl_ctx_t *ctx, int rate);
+int rad_output_stop(rad_ctrl_ctx_t *ctx);
+int rad_output_boot(rad_ctrl_ctx_t *ctx);
+
+int rad_input_processing(rad_ctrl_ctx_t *ctx, const char *json, char *buf, int size);
+bool rad_input_ready(const rad_ctrl_ctx_t *ctx);
+int rad_input_track_processing(rad_ctrl_ctx_t *ctx, unsigned bit, bool enabled, int result);
+int rad_input_status(rad_ctrl_ctx_t *ctx, char *buf, int size);
+int rad_input_mute(rad_ctrl_ctx_t *ctx, bool muted);
+int rad_input_boot(rad_ctrl_ctx_t *ctx);
+int rad_privacy_status(rad_ctrl_ctx_t *ctx, char *buf, int size);
+int rad_input_publish(rad_ctrl_ctx_t *ctx, const void *data, uint32_t length, int64_t timestamp);
+int rad_input_stop(rad_ctrl_ctx_t *ctx);
+int rad_input_start(rad_ctrl_ctx_t *ctx, const char *codec, int sample_rate);
+#endif
diff --git a/raptor_listener.h b/raptor_listener.h
