+static void test_gain_observation_modes_and_coalescing(ric_state_t *st)
+{
+    ric_poll_timer_t policy = {0}, gain = {0};
+    ric_poll_due_t due = ric_poll_due(&policy, &gain, 1000000, 100);
+    assert(due.policy && due.gain);
+	/* Non-detector cycles consult ROD before adding a sensor observation. */
+	gain_demand = false;
+	assert(!ric_gain_requested());
+	gain_demand = true;
+	assert(ric_gain_requested());
+    due = ric_poll_due(&policy, &gain, 1100000, 100);
+    assert(due.policy && !due.gain);
+    assert(ric_poll_wait_ms(&policy, &gain, 1100000) == 100);
+    due = ric_poll_due(&policy, &gain, 2000000, 100);
+    assert(due.policy && due.gain);
+
+    exposure_calls = gain_pushes = 0;
+    last_gain_request[0] = '\0';
+    exposure_gain = 12345;
+    exposure_error = exposure_missing_gain = false;
+    st->gain_last_push_us = 0;
+    st->settings.opmode = RIC_FORCE_DAY;
+    st->current_mode = RIC_MODE_DAY;
+    test_now_us = 3000000;
+    assert(ric_observe_exposure(st, false));
+    assert(st->observed_gain == 12345 && st->gain_observed_us == test_now_us);
+    assert(exposure_calls == 1 && gain_pushes == 1);
+    assert(strstr(last_gain_request, "\"total_gain\":12345"));
+
+    st->settings.opmode = RIC_FORCE_NIGHT;
+    st->current_mode = RIC_MODE_NIGHT;
+    test_now_us += 100000;
+    assert(ric_observe_exposure(st, false));
+    assert(st->current_mode == RIC_MODE_NIGHT && gain_pushes == 1);
+
+    st->settings.opmode = RIC_AUTO;
+    st->settings.automation_paused = true;
+    st->settings.trigger = RIC_TRIGGER_PHOTO;
+    ric_photo_phase_t photo_phase = st->photo.phase;
+    test_now_us += 900000;
+    assert(ric_observe_exposure(st, false));
+    assert(st->photo.phase == photo_phase && gain_pushes == 2);
+
+    st->settings.automation_paused = false;
+    st->settings.sun_enabled = true;
+    test_now_us += 1000000;
+    assert(ric_observe_exposure(st, false));
+    assert(st->photo.phase == photo_phase && gain_pushes == 3);
+    st->settings.sun_enabled = false;
+    st->settings.schedule_enabled = true;
+    test_now_us += 1000000;
+    assert(ric_observe_exposure(st, false));
+    assert(st->photo.phase == photo_phase && gain_pushes == 4);
+
+    uint32_t last_gain = st->observed_gain;
+    int64_t last_observed = st->gain_observed_us;
+    exposure_error = true;
+    test_now_us += 1000000;
+    assert(!ric_observe_exposure(st, false));
+    exposure_error = false;
+    exposure_missing_gain = true;
+    assert(!ric_observe_exposure(st, false));
+    exposure_missing_gain = false;
+    assert(st->observed_gain == last_gain && st->gain_observed_us == last_observed &&
+           gain_pushes == 4);
+
+    /* A restarted RIC cannot republish its predecessor's observation. */
+    ric_state_t restarted = {0};
+    unsigned pushes_before_restart = gain_pushes;
+    exposure_error = true;
+    test_now_us += 1000000;
+    assert(!ric_observe_exposure(&restarted, false));
+    assert(restarted.gain_observed_us == 0 && gain_pushes == pushes_before_restart);
+    exposure_error = false;
+    exposure_gain = 54321;
+    assert(ric_observe_exposure(&restarted, false));
+    assert(restarted.observed_gain == 54321 &&
+           restarted.gain_observed_us == test_now_us &&
+           gain_pushes == pushes_before_restart + 1);
+
+    st->settings.schedule_enabled = false;
+    st->settings.trigger = RIC_TRIGGER_LUMA;
+}
