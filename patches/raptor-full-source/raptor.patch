diff --git a/rmr/rmr_maintenance.c b/rmr/rmr_maintenance.c
new file mode 100644
index 0000000000000000000000000000000000000000..4e5b74b958acb3b89e5437616295c8fb0a6befea
--- /dev/null
+++ b/rmr/rmr_maintenance.c
@@ -0,0 +1,222 @@
+#include "rmr_maintenance.h"
+#include "rmr_sd.h"
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdlib.h>
+#include <time.h>
+
+/* One fixed-stack worker per managed owner. No filesystem call holds lock. */
+struct rmr_maintenance {
+	pthread_mutex_t lock;
+	atomic_uint references;
+	bool stop, paused, mounted, cleanup_ok;
+	unsigned active_io;
+	uint64_t generation, free_mb;
+	int64_t observed_us;
+	unsigned channel;
+	rmr_policy_t policy;
+};
+
+static int64_t monotonic_us(void)
+{
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (int64_t)ts.tv_sec * 1000000 + ts.tv_nsec / 1000;
+}
+
+static void release(rmr_maintenance_t *state)
+{
+	if (atomic_fetch_sub(&state->references, 1) == 1) {
+		pthread_mutex_destroy(&state->lock);
+		free(state);
+	}
+}
+
+struct scan_context {
+	rmr_maintenance_t *state;
+	uint64_t generation;
+	int64_t next_probe_us;
+};
+
+static bool begin_io(rmr_maintenance_t *state, uint64_t generation)
+{
+	pthread_mutex_lock(&state->lock);
+	bool current = !state->stop && !state->paused && state->generation == generation;
+	if (current)
+		++state->active_io;
+	pthread_mutex_unlock(&state->lock);
+	return current;
+}
+
+static void end_io(rmr_maintenance_t *state)
+{
+	pthread_mutex_lock(&state->lock);
+	if (state->active_io > 0)
+		--state->active_io;
+	pthread_mutex_unlock(&state->lock);
+}
+
+static bool service_scan(void *opaque)
+{
+	struct scan_context *scan = opaque;
+	rmr_maintenance_t *state = scan->state;
+	pthread_mutex_lock(&state->lock);
+	bool cancelled = state->stop || state->paused || state->generation != scan->generation;
+	pthread_mutex_unlock(&state->lock);
+	if (cancelled)
+		return false;
+	int64_t now = monotonic_us();
+	if (now >= scan->next_probe_us) {
+		if (!begin_io(state, scan->generation))
+			return false;
+		uint64_t free_mb = 0;
+		bool mounted = rmr_sd_free_mb(&free_mb) == 0;
+		pthread_mutex_lock(&state->lock);
+		if (!state->paused && state->generation == scan->generation) {
+			state->mounted = mounted;
+			state->free_mb = free_mb;
+			state->observed_us = monotonic_us();
+		}
+		pthread_mutex_unlock(&state->lock);
+		end_io(state);
+		scan->next_probe_us = monotonic_us() + 1000000;
+	}
+	pthread_mutex_lock(&state->lock);
+	bool current = !state->stop && !state->paused && state->generation == scan->generation &&
+		state->mounted;
+	pthread_mutex_unlock(&state->lock);
+	return current;
+}
+
+static void *worker(void *opaque)
+{
+	rmr_maintenance_t *state = opaque;
+	struct scan_context scan = {.state = state};
+	int64_t next_cleanup = 0;
+	for (;;) {
+		pthread_mutex_lock(&state->lock);
+		bool stop = state->stop;
+		rmr_policy_t policy = state->policy;
+		if (scan.generation != state->generation) {
+			scan.generation = state->generation;
+			scan.next_probe_us = 0;
+			next_cleanup = 0;
+		}
+		pthread_mutex_unlock(&state->lock);
+		if (stop)
+			break;
+		if (service_scan(&scan) && policy.cleanup_enabled && monotonic_us() >= next_cleanup) {
+			if (!begin_io(state, scan.generation))
+				continue;
+			int result = rmr_sd_retention_step(state->channel, (unsigned)policy.limit,
+				(uint64_t)policy.min_free_mb, service_scan, &scan);
+			end_io(state);
+			pthread_mutex_lock(&state->lock);
+			if (state->generation == scan.generation)
+				state->cleanup_ok = result >= 0;
+			pthread_mutex_unlock(&state->lock);
+			/* Full batches continue toward the limit without waiting a policy interval. */
+			next_cleanup = monotonic_us() + (result == 32 ? 100000 :
+				(int64_t)policy.check_interval * 1000000);
+		}
+		struct timespec pause = {.tv_nsec = 100000000};
+		nanosleep(&pause, NULL);
+	}
+	release(state);
+	return NULL;
+}
+
+rmr_maintenance_t *rmr_maintenance_create(unsigned channel)
+{
+	if (channel > 1)
+		return NULL;
+	rmr_maintenance_t *state = calloc(1, sizeof(*state));
+	if (!state)
+		return NULL;
+	if (pthread_mutex_init(&state->lock, NULL) != 0) {
+		free(state);
+		return NULL;
+	}
+	atomic_init(&state->references, 2);
+	state->channel = channel;
+	state->cleanup_ok = true;
+	state->policy = (rmr_policy_t){.duration = 300, .limit = 15, .min_free_mb = 1,
+		.check_interval = 60};
+	pthread_attr_t attr;
+	pthread_t thread;
+	int result = pthread_attr_init(&attr);
+	if (result == 0) {
+		result = pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+		if (result == 0)
+			result = pthread_attr_setstacksize(&attr, 128 * 1024);
+		if (result == 0)
+			result = pthread_create(&thread, &attr, worker, state);
+		pthread_attr_destroy(&attr);
+	}
+	if (result != 0) {
+		release(state);
+		release(state);
+		return NULL;
+	}
+	return state;
+}
+
+void rmr_maintenance_destroy(rmr_maintenance_t *state)
+{
+	if (!state)
+		return;
+	pthread_mutex_lock(&state->lock);
+	state->stop = true;
+	pthread_mutex_unlock(&state->lock);
+	/* A stalled filesystem owns only the worker's reference, never the caller. */
+	release(state);
+}
+
+void rmr_maintenance_policy(rmr_maintenance_t *state, const rmr_policy_t *policy)
+{
+	pthread_mutex_lock(&state->lock);
+	state->policy = *policy;
+	++state->generation;
+	pthread_mutex_unlock(&state->lock);
+}
+
+bool rmr_maintenance_set_paused(rmr_maintenance_t *state, bool paused, bool *quiescent)
+{
+	if (!state || !quiescent)
+		return false;
+	pthread_mutex_lock(&state->lock);
+	if (state->paused != paused) {
+		state->paused = paused;
+		state->observed_us = 0;
+		++state->generation;
+	}
+	*quiescent = paused && state->active_io == 0;
+	pthread_mutex_unlock(&state->lock);
+	return true;
+}
+
+bool rmr_maintenance_pause_observe(rmr_maintenance_t *state, bool *paused, bool *quiescent)
+{
+	if (!state || !paused || !quiescent)
+		return false;
+	pthread_mutex_lock(&state->lock);
+	*paused = state->paused;
+	*quiescent = state->paused && state->active_io == 0;
+	pthread_mutex_unlock(&state->lock);
+	return true;
+}
+
+bool rmr_maintenance_observe(rmr_maintenance_t *state, bool *mounted, uint64_t *free_mb,
+                             bool *cleanup_ok)
+{
+	if (!state)
+		return false;
+	pthread_mutex_lock(&state->lock);
+	int64_t age = monotonic_us() - state->observed_us;
+	bool fresh = state->observed_us != 0 && age >= 0 && age <= 2500000;
+	*mounted = fresh && state->mounted;
+	*free_mb = *mounted ? state->free_mb : 0;
+	*cleanup_ok = state->cleanup_ok;
+	pthread_mutex_unlock(&state->lock);
+	return fresh;
+}
diff --git a/rmr/rmr_maintenance.h b/rmr/rmr_maintenance.h
new file mode 100644
index 0000000000000000000000000000000000000000..940b562b65f99a1d146bbbc41c4d9f7bd1f620f8
--- /dev/null
+++ b/rmr/rmr_maintenance.h
@@ -0,0 +1,14 @@
+#ifndef RMR_MAINTENANCE_H
+#define RMR_MAINTENANCE_H
+#include "rmr_policy.h"
+#include <stdint.h>
+typedef struct rmr_maintenance rmr_maintenance_t;
+rmr_maintenance_t *rmr_maintenance_create(unsigned channel);
+void rmr_maintenance_destroy(rmr_maintenance_t *state);
+void rmr_maintenance_policy(rmr_maintenance_t *state, const rmr_policy_t *policy);
+bool rmr_maintenance_set_paused(rmr_maintenance_t *state, bool paused, bool *quiescent);
+bool rmr_maintenance_pause_observe(rmr_maintenance_t *state, bool *paused, bool *quiescent);
+/* No filesystem I/O or worker join. False means no fresh observation. */
+bool rmr_maintenance_observe(rmr_maintenance_t *state, bool *mounted, uint64_t *free_mb,
+                             bool *cleanup_ok);
+#endif
diff --git a/rmr/rmr_managed.c b/rmr/rmr_managed.c
new file mode 100644
index 0000000000000000000000000000000000000000..22155aa0f1e92a0b2e936346b2e4c0ca473c817e
--- /dev/null
+++ b/rmr/rmr_managed.c
@@ -0,0 +1,187 @@
+#include "rmr.h"
+#include "rmr_sd.h"
+#include <stdio.h>
+#include <string.h>
+
+int rmr_managed_args(int *argc, char **argv, int *channel)
+{
+	*channel = -1;
+	for (int i = 1; i < *argc; ++i) {
+		if (strcmp(argv[i], "--channel") != 0)
+			continue;
+		if (*channel >= 0 || i + 1 >= *argc || strlen(argv[i + 1]) != 1 ||
+		    (argv[i + 1][0] != '0' && argv[i + 1][0] != '1'))
+			return -1;
+		*channel = argv[i + 1][0] - '0';
+		for (int j = i; j + 2 <= *argc; ++j)
+			argv[j] = argv[j + 2];
+		*argc -= 2;
+		--i;
+	}
+	return 0;
+}
+
+void rmr_managed_service(rmr_state_t *st)
+{
+	if (!st->managed)
+		return;
+	if (st->boot_recording_pending && st->video_ring && rmr_storage_available(st->storage)) {
+		char response[512];
+		st->boot_recording_pending = false;
+		rmr_managed_command(st, "{\"cmd\":\"set-recording\",\"enabled\":true}", response, sizeof(response));
+	}
+	bool requested = atomic_load(&st->recording);
+	if (st->managed_error || rmr_writer_errors() != st->managed_errors_at_start) {
+		st->managed_error = true;
+		atomic_store(&st->recording, false);
+	} else if (requested &&
+		   (!st->video_ring || !rmr_storage_available(st->storage) ||
+		    (!st->segment_writer && rss_timestamp_us() >= st->managed_start_deadline))) {
+		st->managed_error = true;
+		atomic_store(&st->recording, false);
+	}
+}
+
+static int state_reply(rmr_state_t *st, char *response, int size)
+{
+	uint64_t free_mb;
+	bool mounted = false, cleanup_ok;
+	bool fresh = rmr_storage_observe(st->storage, &mounted, &free_mb, &cleanup_ok);
+	bool storage = fresh && mounted && free_mb >= (uint64_t)st->policy.min_free_mb;
+	bool video = st->video_ring != NULL;
+	bool closed =
+		!st->managed_close_failed && st->segment_writer == NULL && rmr_writer_active() == 0;
+	bool failed = st->managed_error || rmr_writer_errors() != st->managed_errors_at_start;
+	bool requested = atomic_load(&st->recording);
+	bool active = st->segment_writer && !failed &&
+		      rmr_writer_written() > st->managed_written_at_start;
+	const char *reason = !fresh ? "storage_unknown"
+			     : !mounted		     ? "no_sd"
+			     : !storage              ? "no_space"
+			     : !video		     ? "video_unavailable"
+			     : failed		     ? "writer_error"
+			     : requested && !active  ? "starting"
+			     : !requested && !closed ? "stopping"
+						     : NULL;
+	cJSON *root = cJSON_CreateObject();
+	cJSON_AddStringToObject(root, "status", "ok");
+	cJSON_AddNumberToObject(root, "stream_id", st->stream_idx);
+	cJSON_AddBoolToObject(root, "available", storage && video);
+	if (active)
+		cJSON_AddBoolToObject(root, "recording", true);
+	else if (closed && !requested)
+		cJSON_AddBoolToObject(root, "recording", false);
+	else
+		cJSON_AddNullToObject(root, "recording");
+	cJSON_AddBoolToObject(root, "file_closed", closed);
+	if (reason)
+		cJSON_AddStringToObject(root, "reason", reason);
+	else
+		cJSON_AddNullToObject(root, "reason");
+	return rss_ctrl_resp_json(response, size, root);
+}
+
+int rmr_managed_command(rmr_state_t *st, const char *request, char *response, int size)
+{
+	cJSON *root = cJSON_ParseWithOpts(request, NULL, true);
+	const cJSON *cmd = cJSON_GetObjectItemCaseSensitive(root, "cmd");
+	bool get = cJSON_IsString(cmd) && strcmp(cmd->valuestring, "get-recording-state") == 0;
+	bool set = cJSON_IsString(cmd) && strcmp(cmd->valuestring, "set-recording") == 0;
+	if (!st->managed || !cJSON_IsObject(root) || (!get && !set) ||
+	    cJSON_GetArraySize(root) != (set ? 2 : 1)) {
+		cJSON_Delete(root);
+		return rss_ctrl_resp_error(response, size, "invalid managed recording request");
+	}
+	if (set) {
+		const cJSON *enabled = cJSON_GetObjectItemCaseSensitive(root, "enabled");
+		if (!cJSON_IsBool(enabled)) {
+			cJSON_Delete(root);
+			return rss_ctrl_resp_error(response, size, "enabled must be boolean");
+		}
+		bool on = cJSON_IsTrue(enabled);
+		bool maintenance_paused = false, maintenance_quiescent = false;
+		if (on && (!rmr_storage_maintenance_observe(st->storage, &maintenance_paused,
+							   &maintenance_quiescent) ||
+			   maintenance_paused)) {
+			cJSON_Delete(root);
+			return rss_ctrl_resp_error(response, size, "storage maintenance is paused");
+		}
+		st->boot_recording_pending = false;
+		if (on && !atomic_load(&st->recording)) {
+			if (!rmr_storage_available(st->storage) || !st->video_ring ||
+			    st->managed_close_failed || st->segment_writer ||
+			    rmr_writer_active() != 0) {
+				cJSON_Delete(root);
+				return rss_ctrl_resp_error(
+					response, size,
+					"storage, video or closed writer unavailable");
+			}
+			st->managed_error = false;
+			st->managed_errors_at_start = rmr_writer_errors();
+			st->managed_written_at_start = rmr_writer_written();
+			st->managed_start_deadline = rss_timestamp_us() + 2000000;
+			rss_ring_request_idr(st->video_ring);
+		}
+		atomic_store(&st->recording, on);
+	}
+	cJSON_Delete(root);
+	return state_reply(st, response, size);
+}
+
+int rmr_managed_audio_status(rmr_state_t *st, const char *request, char *response, int size)
+{
+	cJSON *root = cJSON_ParseWithOpts(request, NULL, true);
+	const cJSON *cmd = cJSON_GetObjectItemCaseSensitive(root, "cmd");
+	const cJSON *id = cJSON_GetObjectItemCaseSensitive(root, "stream_id");
+	bool valid = st->managed && cJSON_IsObject(root) && cJSON_GetArraySize(root) == 2 &&
+		cJSON_IsString(cmd) && !strcmp(cmd->valuestring, "get-stream-audio-policy") &&
+		cJSON_IsNumber(id) && id->valuedouble == id->valueint && id->valueint == st->stream_idx;
+	cJSON_Delete(root);
+	if (!valid)
+		return rss_ctrl_resp_error(response, size, "invalid stream audio request");
+	cJSON *reply = cJSON_CreateObject();
+	cJSON_AddStringToObject(reply, "status", "ok");
+	cJSON_AddStringToObject(reply, "owner", st->stream_idx ? "rmr1" : "rmr0");
+	cJSON_AddStringToObject(reply, "apply", "full-camera-restart");
+	cJSON_AddNumberToObject(reply, "stream_id", st->stream_idx);
+	cJSON_AddBoolToObject(reply, "supported", true);
+	cJSON_AddBoolToObject(reply, "startup_explicit", st->audio_explicit);
+	cJSON_AddBoolToObject(reply, "active_enabled", st->audio_enabled);
+	cJSON_AddBoolToObject(reply, "source_available", st->audio_ring != NULL);
+	cJSON_AddBoolToObject(reply, "track_active", rmr_mux_has_audio(st->mux));
+	return rss_ctrl_resp_json(response, size, reply);
+}
+
+int rmr_managed_maintenance_command(rmr_state_t *st, const char *request, char *response,
+				    int size)
+{
+	cJSON *root = cJSON_ParseWithOpts(request, NULL, true);
+	const cJSON *cmd = cJSON_GetObjectItemCaseSensitive(root, "cmd");
+	bool get = cJSON_IsString(cmd) && !strcmp(cmd->valuestring, "get-storage-maintenance");
+	bool set = cJSON_IsString(cmd) && !strcmp(cmd->valuestring, "set-storage-maintenance");
+	if (!st->managed || !cJSON_IsObject(root) || (!get && !set) ||
+	    cJSON_GetArraySize(root) != (set ? 2 : 1)) {
+		cJSON_Delete(root);
+		return rss_ctrl_resp_error(response, size, "invalid storage maintenance request");
+	}
+	bool paused = false, quiescent = false;
+	if (set) {
+		const cJSON *value = cJSON_GetObjectItemCaseSensitive(root, "paused");
+		if (!cJSON_IsBool(value) ||
+		    !rmr_storage_maintenance(st->storage, cJSON_IsTrue(value), &quiescent)) {
+			cJSON_Delete(root);
+			return rss_ctrl_resp_error(response, size, "paused must be boolean");
+		}
+		paused = cJSON_IsTrue(value);
+	} else if (!rmr_storage_maintenance_observe(st->storage, &paused, &quiescent)) {
+		cJSON_Delete(root);
+		return rss_ctrl_resp_error(response, size, "storage maintenance unavailable");
+	}
+	cJSON_Delete(root);
+	cJSON *reply = cJSON_CreateObject();
+	cJSON_AddStringToObject(reply, "status", "ok");
+	cJSON_AddNumberToObject(reply, "stream_id", st->stream_idx);
+	cJSON_AddBoolToObject(reply, "paused", paused);
+	cJSON_AddBoolToObject(reply, "quiescent", quiescent);
+	return rss_ctrl_resp_json(response, size, reply);
+}
