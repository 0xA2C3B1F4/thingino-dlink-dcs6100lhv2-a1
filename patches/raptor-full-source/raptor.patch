+static int stream_profile_command(rvd_state_t *st, const char *json, char *resp, int size)
+{
+	cJSON *root = cJSON_ParseWithOpts(json, NULL, true);
+	cJSON *cmd = cJSON_GetObjectItemCaseSensitive(root, "cmd");
+	cJSON *id = cJSON_GetObjectItemCaseSensitive(root, "stream_id");
+	cJSON *profile = cJSON_GetObjectItemCaseSensitive(root, "profile");
+	bool set = cJSON_IsString(cmd) && strcmp(cmd->valuestring, "set-stream-profile") == 0;
+	bool valid = cJSON_IsObject(root) && cJSON_IsString(cmd) &&
+		(set || strcmp(cmd->valuestring, "get-stream-profile") == 0) &&
+		cJSON_GetArraySize(root) == (set ? 3 : 2) && cJSON_IsNumber(id) &&
+		id->valuedouble == id->valueint && id->valueint >= 0 && id->valueint <= 1 &&
+		(!set || (cJSON_IsNumber(profile) && profile->valuedouble == profile->valueint &&
+		 profile->valueint >= 0 && profile->valueint <= 2));
+	if (!valid) {
+		cJSON_Delete(root);
+		return rss_ctrl_resp_error(resp, size, "invalid stream profile request");
+	}
+	int stream_id = id->valueint;
+	int requested = set ? profile->valueint : 0;
+	cJSON_Delete(root);
+
+	int index = stream_codec_owner(st, stream_id);
+	rvd_stream_t *s = index >= 0 ? &st->streams[index] : NULL;
+	bool supported = s && s->enc_cfg.codec == RSS_CODEC_H264 && st->ops &&
+		st->ops->enc_get_channel_attr;
+	bool available = supported && !s->codec_uncertain && !stream_restart_preflight(st, index) &&
+		s->enabled &&
+		atomic_load(&st->stream_active[index]);
+	rss_video_config_t live = {0};
+	if (available && !stream_codec_readback(st, s, &live))
+		available = false;
+
+	if (set) {
+		if (!available)
+			return rss_ctrl_resp_error(resp, size, "stream profile unavailable");
+		if (live.profile != requested) {
+			s->enc_cfg.profile = requested;
+			if (do_stream_restart(st, index, resp, size) != RSS_OK) {
+				s->codec_uncertain = true;
+				return strlen(resp) > 0 ? (int)strlen(resp) : RSS_ERR;
+			}
+			if (!stream_codec_readback(st, s, &live) || live.profile != requested) {
+				s->codec_uncertain = true;
+				return rss_ctrl_resp_error(resp, size, "stream profile readback failed");
+			}
+		}
+		rss_config_set_int(st->cfg, s->cfg_sect, "profile", requested);
+		if (rss_config_get_int(st->cfg, s->cfg_sect, "profile", -1) != requested)
+			return rss_ctrl_resp_error(resp, size, "stream profile cache update failed");
+		available = true;
+	}
+
+	cJSON *reply = cJSON_CreateObject();
+	cJSON_AddStringToObject(reply, "status", "ok");
+	cJSON_AddStringToObject(reply, "persistence", "checked-restart-profile");
+	cJSON_AddNumberToObject(reply, "stream_id", stream_id);
+	cJSON_AddBoolToObject(reply, "supported", supported);
+	cJSON_AddBoolToObject(reply, "available", available);
+	cJSON_AddBoolToObject(reply, "recovery_required", s && s->codec_uncertain);
+	if (available)
+		cJSON_AddNumberToObject(reply, "profile", live.profile);
+	else
+		cJSON_AddNullToObject(reply, "profile");
+	return rss_ctrl_resp_json(resp, size, reply);
+}
