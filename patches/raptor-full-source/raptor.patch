diff --git a/rod/rod_metadata.c b/rod/rod_metadata.c
new file mode 100644
index 0000000000000000000000000000000000000000..87ca557b03a198aae0784ef4a87b613389b03356
--- /dev/null
+++ b/rod/rod_metadata.c
@@ -0,0 +1,525 @@
+#include "rod_metadata.h"
+
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+
+#define ROD_METADATA_COORD_MAX 8192
+
+struct text_writer {
+	char *dst;
+	size_t cap;
+	size_t len;
+};
+
+static bool writer_bytes(struct text_writer *writer, const char *value, size_t length)
+{
+	if (!writer || !value || writer->len >= writer->cap ||
+	    length > writer->cap - writer->len - 1)
+		return false;
+	memcpy(writer->dst + writer->len, value, length);
+	writer->len += length;
+	writer->dst[writer->len] = '\0';
+	return true;
+}
+
+static bool writer_string(struct text_writer *writer, const char *value)
+{
+	return value && writer_bytes(writer, value, strlen(value));
+}
+
+static bool writer_number(struct text_writer *writer, int64_t value, bool pad_two)
+{
+	char number[32];
+	int length = pad_two ? snprintf(number, sizeof(number), "%02lld", (long long)value) :
+			       snprintf(number, sizeof(number), "%lld", (long long)value);
+	return length > 0 && (size_t)length < sizeof(number) &&
+		writer_bytes(writer, number, (size_t)length);
+}
+
+static size_t utf8_sequence_length(const unsigned char *value, size_t remaining)
+{
+	unsigned char first = value[0];
+	if (first < 0x80)
+		return first >= 0x20 && first != 0x7f ? 1 : 0;
+	if (first >= 0xc2 && first <= 0xdf && remaining >= 2) {
+		if (value[1] < 0x80 || value[1] > 0xbf)
+			return 0;
+		if (first == 0xc2 && value[1] < 0xa0)
+			return 0;
+		return 2;
+	}
+	if (first >= 0xe0 && first <= 0xef && remaining >= 3) {
+		if (value[1] < 0x80 || value[1] > 0xbf ||
+		    value[2] < 0x80 || value[2] > 0xbf)
+			return 0;
+		if ((first == 0xe0 && value[1] < 0xa0) ||
+		    (first == 0xed && value[1] > 0x9f))
+			return 0;
+		return 3;
+	}
+	if (first >= 0xf0 && first <= 0xf4 && remaining >= 4) {
+		if (value[1] < 0x80 || value[1] > 0xbf ||
+		    value[2] < 0x80 || value[2] > 0xbf ||
+		    value[3] < 0x80 || value[3] > 0xbf)
+			return 0;
+		if ((first == 0xf0 && value[1] < 0x90) ||
+		    (first == 0xf4 && value[1] > 0x8f))
+			return 0;
+		return 4;
+	}
+	return 0;
+}
+
+static bool valid_utf8_string(const char *value, size_t capacity, size_t max_length,
+			      bool allow_empty)
+{
+	if (!value || !capacity)
+		return false;
+	const char *end = memchr(value, '\0', capacity);
+	if (!end)
+		return false;
+	size_t length = (size_t)(end - value);
+	if ((!allow_empty && length == 0) || length > max_length)
+		return false;
+	for (size_t i = 0; i < length;) {
+		size_t sequence = utf8_sequence_length((const unsigned char *)value + i,
+						      length - i);
+		if (!sequence)
+			return false;
+		i += sequence;
+	}
+	return true;
+}
+
+static bool valid_name(const char *name, size_t capacity)
+{
+	if (!name || !memchr(name, '\0', capacity))
+		return false;
+	size_t length = strnlen(name, capacity);
+	if (!length || length > ROD_METADATA_NAME_MAX)
+		return false;
+	for (size_t i = 0; i < length; ++i) {
+		unsigned char ch = (unsigned char)name[i];
+		if (!((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
+		      (ch >= '0' && ch <= '9') || ch == '_' || ch == '-' || ch == '.'))
+			return false;
+	}
+	return true;
+}
+
+static bool parse_coordinate(const char **cursor, int *value, char separator)
+{
+	const char *p = *cursor;
+	bool negative = *p == '-';
+	if (negative)
+		p++;
+	if (*p < '0' || *p > '9')
+		return false;
+	int result = 0;
+	while (*p >= '0' && *p <= '9') {
+		if (result > ROD_METADATA_COORD_MAX / 10)
+			return false;
+		result = result * 10 + (*p++ - '0');
+		if (result > ROD_METADATA_COORD_MAX)
+			return false;
+	}
+	if (*p != separator)
+		return false;
+	*cursor = separator ? p + 1 : p;
+	*value = negative ? -result : result;
+	return true;
+}
+
+static bool valid_scalar_format(const char *format)
+{
+	int replacements = 0;
+	for (size_t i = 0; format[i]; ++i) {
+		if (format[i] != '%')
+			continue;
+		char token = format[++i];
+		if (token == '%')
+			continue;
+		if (token != 's')
+			return false;
+		replacements++;
+	}
+	return replacements == 1;
+}
+
+static bool valid_timestamp_format(const char *format)
+{
+	static const char tokens[] = "FTYmdHMSZzjabB";
+	for (size_t i = 0; format[i]; ++i) {
+		if (format[i] != '%')
+			continue;
+		char token = format[++i];
+		if (!token || (token != '%' && !strchr(tokens, token)))
+			return false;
+	}
+	return true;
+}
+
+static bool uptime_token(const char *format, size_t *offset, bool *pad_two)
+{
+	size_t i = *offset;
+	if (format[i] != '%')
+		return false;
+	i++;
+	*pad_two = false;
+	if (format[i] == '0' && format[i + 1] == '2') {
+		*pad_two = true;
+		i += 2;
+	}
+	if (format[i] != 'l' || format[i + 1] != 'u')
+		return false;
+	*offset = i + 1;
+	return true;
+}
+
+static bool valid_uptime_format(const char *format)
+{
+	int replacements = 0;
+	for (size_t i = 0; format[i]; ++i) {
+		if (format[i] != '%')
+			continue;
+		if (format[i + 1] == '%') {
+			i++;
+			continue;
+		}
+		bool pad_two;
+		if (!uptime_token(format, &i, &pad_two))
+			return false;
+		replacements++;
+	}
+	return replacements == 3;
+}
+
+static bool valid_entry(const rod_metadata_entry_t *entry)
+{
+	if (!entry || !valid_name(entry->name, sizeof(entry->name)) ||
+	    !valid_utf8_string(entry->format, sizeof(entry->format),
+			       ROD_METADATA_FORMAT_MAX, false) ||
+	    entry->x < -ROD_METADATA_COORD_MAX || entry->x > ROD_METADATA_COORD_MAX ||
+	    entry->y < -ROD_METADATA_COORD_MAX || entry->y > ROD_METADATA_COORD_MAX)
+		return false;
+	switch (entry->type) {
+	case ROD_METADATA_TEXT:
+		return true;
+	case ROD_METADATA_GAIN:
+	case ROD_METADATA_HOSTNAME:
+	case ROD_METADATA_IPADDRESS:
+		return valid_scalar_format(entry->format);
+	case ROD_METADATA_TIMESTAMP:
+		return valid_timestamp_format(entry->format);
+	case ROD_METADATA_UPTIME:
+		return valid_uptime_format(entry->format);
+	}
+	return false;
+}
+
+int rod_metadata_entry_parse(rod_metadata_entry_t *entry, const char *name,
+			     const char *type, const char *format, const char *position)
+{
+	if (!entry || !valid_name(name, ROD_METADATA_NAME_MAX + 1) || !type ||
+	    !valid_utf8_string(format, ROD_METADATA_FORMAT_MAX + 1,
+			       ROD_METADATA_FORMAT_MAX, false) || !position)
+		return -EINVAL;
+	rod_metadata_type_t parsed_type;
+	if (strcmp(type, "text") == 0)
+		parsed_type = ROD_METADATA_TEXT;
+	else if (strcmp(type, "gain") == 0)
+		parsed_type = ROD_METADATA_GAIN;
+	else if (strcmp(type, "hostname") == 0)
+		parsed_type = ROD_METADATA_HOSTNAME;
+	else if (strcmp(type, "ipaddress") == 0)
+		parsed_type = ROD_METADATA_IPADDRESS;
+	else if (strcmp(type, "timestamp") == 0)
+		parsed_type = ROD_METADATA_TIMESTAMP;
+	else if (strcmp(type, "uptime") == 0)
+		parsed_type = ROD_METADATA_UPTIME;
+	else
+		return -EINVAL;
+
+	const char *cursor = position;
+	int x, y;
+	if (!parse_coordinate(&cursor, &x, ',') || !parse_coordinate(&cursor, &y, '\0'))
+		return -EINVAL;
+
+	rod_metadata_entry_t parsed = {.type = parsed_type, .x = x, .y = y};
+	memcpy(parsed.name, name, strlen(name) + 1);
+	memcpy(parsed.format, format, strlen(format) + 1);
+	if (!valid_entry(&parsed))
+		return -EINVAL;
+	*entry = parsed;
+	return 0;
+}
+
+static int render_scalar(const char *format, const char *value, char *dst, size_t cap)
+{
+	if (!value)
+		return -ENOENT;
+	struct text_writer writer = {.dst = dst, .cap = cap};
+	if (!cap)
+		return -ENOSPC;
+	dst[0] = '\0';
+	for (size_t i = 0; format[i]; ++i) {
+		if (format[i] != '%') {
+			if (!writer_bytes(&writer, format + i, 1))
+				return -ENOSPC;
+			continue;
+		}
+		char token = format[++i];
+		if (token == '%') {
+			if (!writer_bytes(&writer, "%", 1))
+				return -ENOSPC;
+		} else if (token == 's') {
+			if (!writer_string(&writer, value))
+				return -ENOSPC;
+		} else {
+			return -EINVAL;
+		}
+	}
+	return (int)writer.len;
+}
+
+static int render_uptime(const char *format, uint64_t uptime, char *dst, size_t cap)
+{
+	uint64_t values[3] = {uptime / 86400, (uptime % 86400) / 3600,
+			      (uptime % 3600) / 60};
+	int replacement = 0;
+	struct text_writer writer = {.dst = dst, .cap = cap};
+	if (!cap)
+		return -ENOSPC;
+	dst[0] = '\0';
+	for (size_t i = 0; format[i]; ++i) {
+		if (format[i] != '%') {
+			if (!writer_bytes(&writer, format + i, 1))
+				return -ENOSPC;
+			continue;
+		}
+		if (format[i + 1] == '%') {
+			i++;
+			if (!writer_bytes(&writer, "%", 1))
+				return -ENOSPC;
+			continue;
+		}
+		bool pad_two;
+		if (replacement >= 3 || !uptime_token(format, &i, &pad_two) ||
+		    values[replacement] > INT64_MAX ||
+		    !writer_number(&writer, (int64_t)values[replacement], pad_two))
+			return -ENOSPC;
+		replacement++;
+	}
+	return replacement == 3 ? (int)writer.len : -EINVAL;
+}
+
+int rod_metadata_render(const rod_metadata_entry_t *entry,
+			const rod_metadata_values_t *values, char *dst, size_t cap)
+{
+	if (!valid_entry(entry) || !values || !dst)
+		return -EINVAL;
+	switch (entry->type) {
+	case ROD_METADATA_TEXT:
+		return render_scalar("%s", entry->format, dst, cap);
+	case ROD_METADATA_GAIN:
+		return render_scalar(entry->format, values->gain, dst, cap);
+	case ROD_METADATA_HOSTNAME:
+		return render_scalar(entry->format, values->hostname, dst, cap);
+	case ROD_METADATA_IPADDRESS:
+		return render_scalar(entry->format, values->ipaddress, dst, cap);
+	case ROD_METADATA_TIMESTAMP: {
+		if (!values->time_available)
+			return -ENOENT;
+		if (!cap)
+			return -ENOSPC;
+		size_t length = strftime(dst, cap, entry->format, &values->local_time);
+		return length ? (int)length : -ENOSPC;
+	}
+	case ROD_METADATA_UPTIME:
+		return render_uptime(entry->format, values->uptime_seconds, dst, cap);
+	}
+	return -EINVAL;
+}
+
+static const char *type_name(rod_metadata_type_t type)
+{
+	switch (type) {
+	case ROD_METADATA_TEXT:
+		return "text";
+	case ROD_METADATA_GAIN:
+		return "gain";
+	case ROD_METADATA_HOSTNAME:
+		return "hostname";
+	case ROD_METADATA_IPADDRESS:
+		return "ipaddress";
+	case ROD_METADATA_TIMESTAMP:
+		return "timestamp";
+	case ROD_METADATA_UPTIME:
+		return "uptime";
+	}
+	return NULL;
+}
+
+static int writer_json_string(struct text_writer *writer, const char *value)
+{
+	if (!writer_string(writer, "\""))
+		return -ENOSPC;
+	for (const unsigned char *p = (const unsigned char *)value; *p; ++p) {
+		if (*p == '"' || *p == '\\') {
+			char escaped[2] = {'\\', (char)*p};
+			if (!writer_bytes(writer, escaped, sizeof(escaped)))
+				return -ENOSPC;
+		} else if (*p < 0x20) {
+			char escaped[7];
+			int length = snprintf(escaped, sizeof(escaped), "\\u%04x", *p);
+			if (length != 6 || !writer_bytes(writer, escaped, 6))
+				return -ENOSPC;
+		} else if (!writer_bytes(writer, (const char *)p, 1)) {
+			return -ENOSPC;
+		}
+	}
+	return writer_string(writer, "\"") ? 0 : -ENOSPC;
+}
+
+int rod_metadata_build_json(const rod_metadata_entry_t *entries, size_t count,
+			    const rod_metadata_values_t *values, char *dst, size_t cap)
+{
+	if (!entries || !values || !dst || !cap || count == 0 ||
+	    count > ROD_METADATA_MAX_ENTRIES || values->stream_width == 0 ||
+	    values->stream_width > ROD_METADATA_COORD_MAX || values->stream_height == 0 ||
+	    values->stream_height > ROD_METADATA_COORD_MAX ||
+	    (values->rotation != 0 && values->rotation != 90 && values->rotation != 180 &&
+	     values->rotation != 270))
+		return -EINVAL;
+	for (size_t i = 0; i < count; ++i) {
+		if (!valid_entry(&entries[i]))
+			return -EINVAL;
+		for (size_t j = i + 1; j < count; ++j) {
+			if (strcmp(entries[i].name, entries[j].name) == 0)
+				return -EINVAL;
+		}
+	}
+	struct text_writer writer = {.dst = dst, .cap = cap};
+	dst[0] = '\0';
+	char header[96];
+	int header_len = snprintf(header, sizeof(header),
+		"{\"v\":1,\"sw\":%u,\"sh\":%u,\"rotation\":%d,\"elements\":[",
+		values->stream_width, values->stream_height, values->rotation);
+	if (header_len <= 0 || (size_t)header_len >= sizeof(header) ||
+	    !writer_bytes(&writer, header, (size_t)header_len))
+		return -ENOSPC;
+	for (size_t i = 0; i < count; ++i) {
+		char text[ROD_METADATA_TEXT_MAX + 1];
+		int rendered = rod_metadata_render(&entries[i], values, text, sizeof(text));
+		const char *type = type_name(entries[i].type);
+		if (rendered < 0 || !type)
+			return rendered < 0 ? rendered : -EINVAL;
+		if (!valid_utf8_string(text, sizeof(text), ROD_METADATA_TEXT_MAX, true))
+			return -EINVAL;
+		if ((i && !writer_string(&writer, ",")) ||
+		    !writer_string(&writer, "{\"name\":"))
+			return -ENOSPC;
+		int error = writer_json_string(&writer, entries[i].name);
+		if (error < 0)
+			return error;
+		if (!writer_string(&writer, ",\"t\":"))
+			return -ENOSPC;
+		error = writer_json_string(&writer, type);
+		if (error < 0)
+			return error;
+		if (!writer_string(&writer, ",\"text\":"))
+			return -ENOSPC;
+		error = writer_json_string(&writer, text);
+		if (error < 0)
+			return error;
+		if (!writer_string(&writer, ",\"x\":") ||
+		    !writer_number(&writer, entries[i].x, false) ||
+		    !writer_string(&writer, ",\"y\":") ||
+		    !writer_number(&writer, entries[i].y, false) ||
+		    !writer_string(&writer, "}"))
+			return -ENOSPC;
+	}
+	if (!writer_string(&writer, "]}"))
+		return -ENOSPC;
+	return (int)writer.len;
+}
+
+bool rod_metadata_config_fits(const rod_metadata_config_t *metadata)
+{
+	if (!metadata || !metadata->valid || metadata->count > ROD_METADATA_MAX_ENTRIES)
+		return false;
+	if (metadata->count == 0)
+		return true;
+
+	/* strftime() can source %Z from the configured timezone. Bound timestamp
+	 * output by the runtime text buffer instead of sampling one host timezone. */
+	size_t total = strlen("{\"v\":1,\"sw\":8192,\"sh\":8192,\"rotation\":270,\"elements\":[") +
+		       strlen("]}");
+	for (size_t i = 0; i < metadata->count; ++i) {
+		const rod_metadata_entry_t *entry = &metadata->entries[i];
+		const char *type = type_name(entry->type);
+		if (!valid_entry(entry) || !type)
+			return false;
+
+		size_t rendered_bound = 0;
+		if (entry->type == ROD_METADATA_TEXT) {
+			rendered_bound = strlen(entry->format);
+		} else if (entry->type == ROD_METADATA_TIMESTAMP) {
+			rendered_bound = ROD_METADATA_TEXT_MAX;
+		} else {
+			size_t replacement_bound = 0;
+			if (entry->type == ROD_METADATA_GAIN)
+				replacement_bound = 31;
+			else if (entry->type == ROD_METADATA_HOSTNAME)
+				replacement_bound = 63;
+			else if (entry->type == ROD_METADATA_IPADDRESS)
+				replacement_bound = 45;
+
+			for (size_t offset = 0; entry->format[offset]; ++offset) {
+				if (entry->format[offset] != '%') {
+					rendered_bound++;
+					continue;
+				}
+				if (entry->format[offset + 1] == '%') {
+					rendered_bound++;
+					offset++;
+				} else if (entry->type == ROD_METADATA_UPTIME) {
+					bool pad_two;
+					if (!uptime_token(entry->format, &offset, &pad_two))
+						return false;
+					(void)pad_two;
+					rendered_bound += 20;
+				} else if (entry->format[offset + 1] == 's') {
+					rendered_bound += replacement_bound;
+					offset++;
+				} else {
+					return false;
+				}
+			}
+			if (rendered_bound > ROD_METADATA_TEXT_MAX)
+				return false;
+		}
+
+		/* Names and types cannot contain JSON escapes. Text may consist entirely
+		 * of quotes or backslashes, so reserve two bytes per rendered byte. */
+		int fixed = snprintf(NULL, 0,
+			"{\"name\":\"%s\",\"t\":\"%s\",\"text\":\"\",\"x\":-8192,\"y\":-8192}",
+			entry->name, type);
+		if (fixed < 0)
+			return false;
+		total += (i ? 1 : 0) + (size_t)fixed + rendered_bound * 2;
+		if (total > ROD_METADATA_JSON_MAX)
+			return false;
+	}
+	return true;
+}
+
+int rod_metadata_build_sei(uint8_t *dst, size_t cap, int codec, int prefix,
+			   const char *json, size_t json_len)
+{
+	if (!dst || !json || json_len < 2 || json_len > ROD_METADATA_JSON_MAX ||
+	    memchr(json, '\0', json_len) || json[0] != '{' || json[json_len - 1] != '}')
+		return -EINVAL;
+	return osd_metadata_build_sei(dst, cap, codec, prefix, json, json_len);
+}
diff --git a/rod/rod_metadata.h b/rod/rod_metadata.h
new file mode 100644
index 0000000000000000000000000000000000000000..0c504b6638ec1a851fc426b3b75dc3bb3b338d53
--- /dev/null
+++ b/rod/rod_metadata.h
@@ -0,0 +1,82 @@
+#ifndef ROD_METADATA_H
+#define ROD_METADATA_H
+
+#include "../osd_metadata_snapshot.h"
+
+#include <rss_common.h>
+#include <rss_sei.h>
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <time.h>
+
+#define ROD_METADATA_MAX_ENTRIES 16
+#define ROD_METADATA_NAME_MAX 31
+#define ROD_METADATA_FORMAT_MAX 95
+#define ROD_METADATA_TEXT_MAX 127
+#define ROD_METADATA_JSON_MAX OSD_METADATA_JSON_MAX
+#define ROD_METADATA_SEI_MAX OSD_METADATA_SEI_MAX
+
+typedef enum {
+	ROD_METADATA_TEXT,
+	ROD_METADATA_GAIN,
+	ROD_METADATA_HOSTNAME,
+	ROD_METADATA_IPADDRESS,
+	ROD_METADATA_TIMESTAMP,
+	ROD_METADATA_UPTIME,
+} rod_metadata_type_t;
+
+typedef struct {
+	char name[ROD_METADATA_NAME_MAX + 1];
+	rod_metadata_type_t type;
+	char format[ROD_METADATA_FORMAT_MAX + 1];
+	int x;
+	int y;
+} rod_metadata_entry_t;
+
+typedef struct {
+	uint32_t stream_width;
+	uint32_t stream_height;
+	int rotation;
+	struct tm local_time;
+	bool time_available;
+	const char *gain;
+	const char *hostname;
+	const char *ipaddress;
+	uint64_t uptime_seconds;
+} rod_metadata_values_t;
+
+typedef struct {
+	bool present;
+	bool enabled;
+	bool valid;
+	size_t count;
+	char id[17];
+	rod_metadata_entry_t entries[ROD_METADATA_MAX_ENTRIES];
+} rod_metadata_config_t;
+
+/* Parse one user-visible entry without retaining caller-owned pointers. */
+int rod_metadata_entry_parse(rod_metadata_entry_t *entry, const char *name,
+			     const char *type, const char *format, const char *position);
+
+/* Render one typed value. User input is parsed as tokens, never as printf input. */
+int rod_metadata_render(const rod_metadata_entry_t *entry,
+			const rod_metadata_values_t *values, char *dst, size_t cap);
+
+/* Build the bounded version-1 Thingino metadata JSON document. */
+int rod_metadata_build_json(const rod_metadata_entry_t *entries, size_t count,
+			    const rod_metadata_values_t *values, char *dst, size_t cap);
+bool rod_metadata_config_fits(const rod_metadata_config_t *metadata);
+
+/* Build one user_data_unregistered NAL using the Thingino metadata UUID. */
+int rod_metadata_build_sei(uint8_t *dst, size_t cap, int codec, int prefix,
+			   const char *json, size_t json_len);
+
+/* Load [osd_metadata] and its named [osd_metadata.*] entry sections. */
+int rod_metadata_config_load(rss_config_t *cfg, rod_metadata_config_t *metadata);
+int rod_metadata_config_parse_values(const cJSON *values, rod_metadata_config_t *metadata);
+int rod_metadata_config_store(rss_config_t *cfg, const rod_metadata_config_t *metadata);
+void rod_metadata_config_identify(rod_metadata_config_t *metadata);
+
+#endif
diff --git a/rod/rod_metadata_config.c b/rod/rod_metadata_config.c
new file mode 100644
index 0000000000000000000000000000000000000000..96d6c726f7551dc4ee8db730363211180a0d7d43
--- /dev/null
+++ b/rod/rod_metadata_config.c
@@ -0,0 +1,193 @@
+#include "rod_metadata.h"
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define METADATA_PREFIX "osd_metadata."
+
+struct metadata_load_context {
+	rss_config_t *cfg;
+	rod_metadata_config_t *metadata;
+};
+
+static bool parse_bool(const char *text, bool *value)
+{
+	if (text && strcmp(text, "true") == 0) {
+		*value = true;
+		return true;
+	}
+	if (text && strcmp(text, "false") == 0) {
+		*value = false;
+		return true;
+	}
+	return false;
+}
+
+static uint64_t hash_bytes(uint64_t hash, const void *data, size_t length)
+{
+	const unsigned char *bytes = data;
+	for (size_t i = 0; i < length; ++i) {
+		hash ^= bytes[i];
+		hash *= UINT64_C(1099511628211);
+	}
+	return hash;
+}
+
+void rod_metadata_config_identify(rod_metadata_config_t *metadata)
+{
+	if (!metadata || !metadata->present || !metadata->valid) {
+		if (metadata)
+			metadata->id[0] = '\0';
+		return;
+	}
+	uint64_t hash = UINT64_C(14695981039346656037);
+	hash = hash_bytes(hash, &metadata->enabled, sizeof(metadata->enabled));
+	hash = hash_bytes(hash, &metadata->count, sizeof(metadata->count));
+	for (size_t i = 0; i < metadata->count; ++i) {
+		const rod_metadata_entry_t *entry = &metadata->entries[i];
+		hash = hash_bytes(hash, entry->name, strlen(entry->name) + 1);
+		hash = hash_bytes(hash, &entry->type, sizeof(entry->type));
+		hash = hash_bytes(hash, entry->format, strlen(entry->format) + 1);
+		hash = hash_bytes(hash, &entry->x, sizeof(entry->x));
+		hash = hash_bytes(hash, &entry->y, sizeof(entry->y));
+	}
+	snprintf(metadata->id, sizeof(metadata->id), "%016llx", (unsigned long long)hash);
+}
+
+static int append_entry(rod_metadata_config_t *metadata, const char *name, const char *type,
+			const char *format, const char *position)
+{
+	if (metadata->count >= ROD_METADATA_MAX_ENTRIES)
+		return -E2BIG;
+	rod_metadata_entry_t entry;
+	if (rod_metadata_entry_parse(&entry, name, type, format, position) != 0)
+		return -EINVAL;
+	for (size_t i = 0; i < metadata->count; ++i)
+		if (strcmp(metadata->entries[i].name, entry.name) == 0)
+			return -EEXIST;
+	metadata->entries[metadata->count++] = entry;
+	return 0;
+}
+
+static int parse_entries(const cJSON *entries, rod_metadata_config_t *metadata)
+{
+	if (!cJSON_IsArray(entries) || cJSON_GetArraySize(entries) > ROD_METADATA_MAX_ENTRIES)
+		return -EINVAL;
+	const cJSON *item;
+	cJSON_ArrayForEach(item, entries) {
+		if (!cJSON_IsObject(item) || cJSON_GetArraySize(item) != 4)
+			return -EINVAL;
+		const cJSON *name = cJSON_GetObjectItemCaseSensitive(item, "name");
+		const cJSON *type = cJSON_GetObjectItemCaseSensitive(item, "type");
+		const cJSON *format = cJSON_GetObjectItemCaseSensitive(item, "format");
+		const cJSON *position = cJSON_GetObjectItemCaseSensitive(item, "position");
+		if (!cJSON_IsString(name) || !cJSON_IsString(type) || !cJSON_IsString(format) ||
+		    !cJSON_IsString(position) || append_entry(metadata, name->valuestring,
+			type->valuestring, format->valuestring, position->valuestring) != 0)
+			return -EINVAL;
+	}
+	return 0;
+}
+
+int rod_metadata_config_parse_values(const cJSON *values, rod_metadata_config_t *metadata)
+{
+	if (!cJSON_IsObject(values) || cJSON_GetArraySize(values) != 2 || !metadata)
+		return -EINVAL;
+	const cJSON *enabled = cJSON_GetObjectItemCaseSensitive(values, "enabled");
+	const cJSON *entries = cJSON_GetObjectItemCaseSensitive(values, "entries");
+	if (!cJSON_IsBool(enabled))
+		return -EINVAL;
+	*metadata = (rod_metadata_config_t){.present = true, .enabled = cJSON_IsTrue(enabled),
+		.valid = true};
+	if (parse_entries(entries, metadata) != 0) {
+		metadata->valid = false;
+		return -EINVAL;
+	}
+	rod_metadata_config_identify(metadata);
+	return 0;
+}
+
+static void load_metadata_entry(const char *section, void *userdata)
+{
+	struct metadata_load_context *context = userdata;
+	rod_metadata_config_t *metadata = context->metadata;
+	const char *name = section + strlen(METADATA_PREFIX);
+	if (!name[0] || append_entry(metadata, name,
+		rss_config_get_str(context->cfg, section, "type", NULL),
+		rss_config_get_str(context->cfg, section, "format", NULL),
+		rss_config_get_str(context->cfg, section, "position", NULL)) != 0)
+		metadata->valid = false;
+}
+
+int rod_metadata_config_load(rss_config_t *cfg, rod_metadata_config_t *metadata)
+{
+	if (!cfg || !metadata)
+		return -EINVAL;
+	*metadata = (rod_metadata_config_t){0};
+	const char *enabled = rss_config_get_str(cfg, "osd_metadata", "enabled", NULL);
+	const char *count_text = rss_config_get_str(cfg, "osd_metadata", "entry_count", NULL);
+	if (!enabled && !count_text)
+		return -ENOENT;
+	metadata->present = true;
+	metadata->valid = parse_bool(enabled, &metadata->enabled);
+	if (count_text) {
+		char *end = NULL;
+		errno = 0;
+		long count = strtol(count_text, &end, 10);
+		if (errno || !end || end == count_text || *end || count < 0 ||
+		    count > ROD_METADATA_MAX_ENTRIES) {
+			metadata->valid = false;
+			return -EINVAL;
+		}
+		const unsigned entry_count = (unsigned)count;
+		for (unsigned i = 0; metadata->valid && i < entry_count; ++i) {
+			char name_key[32], type_key[32], format_key[32], position_key[32];
+			snprintf(name_key, sizeof(name_key), "entry%u_name", i);
+			snprintf(type_key, sizeof(type_key), "entry%u_type", i);
+			snprintf(format_key, sizeof(format_key), "entry%u_format", i);
+			snprintf(position_key, sizeof(position_key), "entry%u_position", i);
+			if (append_entry(metadata,
+				rss_config_get_str(cfg, "osd_metadata", name_key, NULL),
+				rss_config_get_str(cfg, "osd_metadata", type_key, NULL),
+				rss_config_get_str(cfg, "osd_metadata", format_key, NULL),
+				rss_config_get_str(cfg, "osd_metadata", position_key, NULL)) != 0)
+				metadata->valid = false;
+		}
+	} else {
+		struct metadata_load_context context = {.cfg = cfg, .metadata = metadata};
+		rss_config_foreach_section(cfg, METADATA_PREFIX, load_metadata_entry, &context);
+	}
+	if (!metadata->valid)
+		return -EINVAL;
+	rod_metadata_config_identify(metadata);
+	return 0;
+}
+
+int rod_metadata_config_store(rss_config_t *cfg, const rod_metadata_config_t *metadata)
+{
+	if (!cfg || !metadata || !metadata->present || !metadata->valid ||
+	    metadata->count > ROD_METADATA_MAX_ENTRIES)
+		return -EINVAL;
+	static const char *types[] = {"text", "gain", "hostname", "ipaddress", "timestamp",
+				      "uptime"};
+	rss_config_set_bool(cfg, "osd_metadata", "enabled", metadata->enabled);
+	rss_config_set_int(cfg, "osd_metadata", "entry_count", (int)metadata->count);
+	for (unsigned i = 0; i < metadata->count; ++i) {
+		const rod_metadata_entry_t *entry = &metadata->entries[i];
+		char name_key[32], type_key[32], format_key[32], position_key[32], position[32];
+		if (entry->type < 0 || entry->type > ROD_METADATA_UPTIME)
+			return -EINVAL;
+		snprintf(name_key, sizeof(name_key), "entry%u_name", i);
+		snprintf(type_key, sizeof(type_key), "entry%u_type", i);
+		snprintf(format_key, sizeof(format_key), "entry%u_format", i);
+		snprintf(position_key, sizeof(position_key), "entry%u_position", i);
+		snprintf(position, sizeof(position), "%d,%d", entry->x, entry->y);
+		rss_config_set_str(cfg, "osd_metadata", name_key, entry->name);
+		rss_config_set_str(cfg, "osd_metadata", type_key, types[entry->type]);
+		rss_config_set_str(cfg, "osd_metadata", format_key, entry->format);
+		rss_config_set_str(cfg, "osd_metadata", position_key, position);
+	}
+	return 0;
+}
diff --git a/rod/rod_metadata_runtime.c b/rod/rod_metadata_runtime.c
new file mode 100644
index 0000000000000000000000000000000000000000..2439535b8d21aa55bc2181689c49bb51525d7065
--- /dev/null
+++ b/rod/rod_metadata_runtime.c
@@ -0,0 +1,89 @@
+#include "rod.h"
+
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <time.h>
+
+static void metadata_values(rod_state_t *state, int stream, rod_metadata_values_t *values,
+			    char *gain, size_t gain_size, char *ip, size_t ip_size,
+			    int64_t now_us)
+{
+	time_t wall_time = time(NULL);
+	struct timespec uptime = {0};
+	struct tm local_time = {0};
+	bool time_available = wall_time != (time_t)-1 &&
+			      localtime_r(&wall_time, &local_time) != NULL;
+	if (rod_metadata_gain_fresh(state, now_us))
+		snprintf(gain, gain_size, "%u", state->metadata_gain);
+	else
+		rss_strlcpy(gain, "--", gain_size);
+	rod_expand_template(state, "%ip%", ip, (int)ip_size);
+	*values = (rod_metadata_values_t){
+		.stream_width = (uint32_t)state->stream_w[stream],
+		.stream_height = (uint32_t)state->stream_h[stream],
+		.rotation = state->metadata_rotation[stream],
+		.local_time = local_time,
+		.time_available = time_available,
+		.gain = gain,
+		.hostname = state->hostname,
+		.ipaddress = ip,
+	};
+	if (clock_gettime(CLOCK_MONOTONIC, &uptime) == 0)
+		values->uptime_seconds = (uint64_t)uptime.tv_sec;
+}
+
+void rod_metadata_publish(rod_state_t *state, int64_t now_us)
+{
+	const char *directory = state->metadata_directory ? state->metadata_directory : RSS_RUN_DIR;
+	bool requested_enabled = state->metadata.enabled && state->metadata.valid &&
+				 !state->paused && state->metadata.count > 0;
+	if (state->metadata_last_publish_us > 0 && requested_enabled == state->metadata_last_enabled) {
+		if (!requested_enabled ||
+		    (now_us >= state->metadata_last_publish_us &&
+		     now_us - state->metadata_last_publish_us < 1000000))
+			return;
+	}
+	bool enabled = requested_enabled;
+	uint32_t generation = ++state->metadata_generation;
+	if (generation == 0)
+		generation = ++state->metadata_generation;
+	int status = state->stream_count > 0 && state->stream_count <= ROD_MAX_STREAMS
+			     ? 0
+			     : -ENODEV;
+
+	for (int stream = 0; status == 0 && stream < state->stream_count; ++stream) {
+		char json[ROD_METADATA_JSON_MAX + 1];
+		int json_len = 0;
+		if (enabled && state->metadata.count > 0) {
+			char gain[32], ip[46];
+			rod_metadata_values_t values;
+			metadata_values(state, stream, &values, gain, sizeof(gain), ip,
+					 sizeof(ip), now_us);
+			json_len = rod_metadata_build_json(state->metadata.entries,
+						   state->metadata.count, &values, json,
+						   sizeof(json));
+			if (json_len < 0)
+				enabled = false;
+		}
+		int ret = osd_metadata_snapshot_write(
+			directory, (unsigned)stream, generation, now_us, enabled,
+			json_len > 0 ? json : NULL, json_len > 0 ? (size_t)json_len : 0);
+		if (ret < 0 && status == 0)
+			status = ret;
+		if (json_len < 0 && status == 0)
+			status = json_len;
+	}
+	if (status != state->metadata_publish_status) {
+		if (status < 0)
+			RSS_WARN("named OSD metadata snapshot failed: %s", strerror(-status));
+		else if (state->metadata_publish_status < 0)
+			RSS_INFO("named OSD metadata snapshot recovered");
+		state->metadata_publish_status = status;
+	}
+	state->metadata_last_publish_us = now_us;
+	state->metadata_last_enabled = requested_enabled;
+	if (status == 0)
+		rss_strlcpy(state->metadata_published_id, state->metadata.id,
+			    sizeof(state->metadata_published_id));
+}
diff --git a/rod/rod_metadata_settings.c b/rod/rod_metadata_settings.c
new file mode 100644
index 0000000000000000000000000000000000000000..07a4906c61287959af7475fab95fcb600fbc5c67
--- /dev/null
+++ b/rod/rod_metadata_settings.c
@@ -0,0 +1,189 @@
+#include "rod.h"
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static const char *metadata_type_name(rod_metadata_type_t type)
+{
+	static const char *names[] = {"text", "gain", "hostname", "ipaddress", "timestamp",
+				      "uptime"};
+	return type >= ROD_METADATA_TEXT && type <= ROD_METADATA_UPTIME ? names[type] : NULL;
+}
+
+static bool metadata_fresh(const rod_state_t *state, int64_t now_us)
+{
+	if (state->metadata_publish_status != 0 || state->metadata_last_publish_us <= 0 ||
+	    now_us < state->metadata_last_publish_us)
+		return false;
+	if (state->metadata_saved_known && !state->metadata_last_enabled &&
+	    (!state->metadata.enabled || state->metadata.count == 0))
+		return true;
+	return now_us - state->metadata_last_publish_us <= OSD_METADATA_MAX_AGE_US;
+}
+
+static int metadata_response(rod_state_t *state, char *response, int size, bool mutation)
+{
+	int64_t now_us = rss_timestamp_us();
+	bool fresh = metadata_fresh(state, now_us);
+	bool gain_fresh = rod_metadata_gain_fresh(state, now_us);
+	bool matched = state->metadata_saved_known && state->metadata.id[0] &&
+		       state->metadata_published_id[0] &&
+		       strcmp(state->metadata.id, state->metadata_published_id) == 0;
+	bool confirmed = state->metadata_saved_known && state->metadata.present &&
+			 state->metadata.valid && fresh && matched;
+	cJSON *root = cJSON_CreateObject();
+	if (!root)
+		return rss_ctrl_resp_error(response, size, "json alloc failed");
+	cJSON_AddStringToObject(root, "status", mutation && !confirmed ? "error" : "ok");
+	if (mutation && !confirmed)
+		cJSON_AddStringToObject(root, "error", "saved but publication unconfirmed");
+	cJSON_AddStringToObject(root, "persistence", "checked-snapshot");
+	cJSON_AddBoolToObject(root, "confirmed", confirmed);
+	cJSON *saved = cJSON_AddObjectToObject(root, "saved");
+	cJSON *published = cJSON_AddObjectToObject(root, "published");
+	if (!saved || !published) {
+		cJSON_Delete(root);
+		return rss_ctrl_resp_error(response, size, "json alloc failed");
+	}
+	cJSON_AddBoolToObject(saved, "available", state->metadata_saved_known);
+	cJSON_AddStringToObject(saved, "id", state->metadata_saved_known ? state->metadata.id : "");
+	if (state->metadata_saved_known)
+		cJSON_AddBoolToObject(saved, "enabled", state->metadata.enabled);
+	else
+		cJSON_AddNullToObject(saved, "enabled");
+	cJSON *entries = cJSON_AddArrayToObject(saved, "entries");
+	if (!entries) {
+		cJSON_Delete(root);
+		return rss_ctrl_resp_error(response, size, "json alloc failed");
+	}
+	for (size_t i = 0; state->metadata_saved_known && i < state->metadata.count; ++i) {
+		const rod_metadata_entry_t *entry = &state->metadata.entries[i];
+		const char *type = metadata_type_name(entry->type);
+		cJSON *item = cJSON_CreateObject();
+		char position[32];
+		if (!item || !type) {
+			cJSON_Delete(item);
+			cJSON_Delete(root);
+			return rss_ctrl_resp_error(response, size, "invalid saved metadata");
+		}
+		snprintf(position, sizeof(position), "%d,%d", entry->x, entry->y);
+		cJSON_AddStringToObject(item, "name", entry->name);
+		cJSON_AddStringToObject(item, "type", type);
+		cJSON_AddStringToObject(item, "format", entry->format);
+		cJSON_AddStringToObject(item, "position", position);
+		bool available = entry->type != ROD_METADATA_GAIN || gain_fresh;
+		cJSON_AddBoolToObject(item, "available", available);
+		if (entry->type == ROD_METADATA_GAIN && !available)
+			cJSON_AddStringToObject(item, "unavailable_reason",
+					state->metadata_gain_observed_us > 0
+						? "gain observation stale"
+						: "gain producer missing");
+		cJSON_AddItemToArray(entries, item);
+	}
+	cJSON_AddStringToObject(published, "id", state->metadata_published_id);
+	cJSON_AddNumberToObject(published, "generation", state->metadata_generation);
+	cJSON_AddNumberToObject(published, "status", state->metadata_publish_status);
+	cJSON_AddBoolToObject(published, "fresh", fresh);
+	cJSON_AddBoolToObject(published, "matches_saved", matched);
+	return rss_ctrl_resp_json(response, size, root);
+}
+
+int rod_metadata_observe_gain(rod_state_t *state, const char *request, char *response,
+			      int size)
+{
+	cJSON *root = cJSON_ParseWithOpts(request, NULL, true);
+	const cJSON *command = cJSON_GetObjectItemCaseSensitive(root, "cmd");
+	const cJSON *gain = cJSON_GetObjectItemCaseSensitive(root, "total_gain");
+	const cJSON *observed = cJSON_GetObjectItemCaseSensitive(root, "observed_us");
+	double gain_number = cJSON_GetNumberValue(gain);
+	double observed_number = cJSON_GetNumberValue(observed);
+	bool valid = cJSON_IsObject(root) && cJSON_GetArraySize(root) == 3 &&
+		cJSON_IsString(command) && strcmp(command->valuestring, "observe-gain") == 0 &&
+		cJSON_IsNumber(gain) && gain_number >= 0 && gain_number <= UINT32_MAX &&
+		gain_number == (double)(uint32_t)gain_number && cJSON_IsNumber(observed) &&
+		observed_number >= 1 && observed_number <= 9007199254740991.0;
+	int64_t observed_us = valid ? (int64_t)observed_number : 0;
+	int64_t now_us = rss_timestamp_us();
+	valid = valid && observed_number == (double)observed_us && now_us >= observed_us &&
+		observed_us > state->metadata_gain_observed_us;
+	cJSON_Delete(root);
+	if (!valid)
+		return rss_ctrl_resp_error(response, size, "invalid gain observation");
+	state->metadata_gain = (uint32_t)gain_number;
+	state->metadata_gain_observed_us = observed_us;
+	state->metadata_last_publish_us = 0;
+	return rss_ctrl_resp_ok(response, size);
+}
+
+int rod_metadata_gain_demand(rod_state_t *state, const char *request, char *response,
+			     int size)
+{
+	cJSON *root = cJSON_ParseWithOpts(request, NULL, true);
+	const cJSON *command = cJSON_GetObjectItemCaseSensitive(root, "cmd");
+	bool valid = cJSON_IsObject(root) && cJSON_GetArraySize(root) == 1 &&
+		cJSON_IsString(command) && strcmp(command->valuestring, "get-gain-demand") == 0;
+	cJSON_Delete(root);
+	if (!valid)
+		return rss_ctrl_resp_error(response, size, "invalid gain demand request");
+	bool needed = state->metadata.enabled && state->metadata.valid && !state->paused;
+	for (size_t i = 0; needed && i < state->metadata.count; ++i) {
+		if (state->metadata.entries[i].type == ROD_METADATA_GAIN)
+			goto reply;
+	}
+	needed = false;
+reply:
+	root = cJSON_CreateObject();
+	if (!root)
+		return rss_ctrl_resp_error(response, size, "json alloc failed");
+	cJSON_AddStringToObject(root, "status", "ok");
+	cJSON_AddBoolToObject(root, "needed", needed);
+	return rss_ctrl_resp_json(response, size, root);
+}
+
+int rod_metadata_get_settings(rod_state_t *state, char *response, int size)
+{
+	return metadata_response(state, response, size, false);
+}
+
+int rod_metadata_set_settings(rod_state_t *state, const char *request, char *response, int size)
+{
+	cJSON *root = cJSON_ParseWithOpts(request, NULL, true);
+	const cJSON *command = cJSON_GetObjectItemCaseSensitive(root, "cmd");
+	const cJSON *values = cJSON_GetObjectItemCaseSensitive(root, "values");
+	rod_metadata_config_t candidate;
+	bool request_valid = cJSON_IsObject(root) && cJSON_GetArraySize(root) == 2 &&
+			     cJSON_IsString(command) &&
+			     strcmp(command->valuestring, "set-metadata-settings") == 0 &&
+			     rod_metadata_config_parse_values(values, &candidate) == 0;
+	cJSON_Delete(root);
+	if (!request_valid)
+		return rss_ctrl_resp_error(response, size, "invalid metadata settings");
+	if (!rod_metadata_config_fits(&candidate))
+		return rss_ctrl_resp_error(response, size, "metadata table exceeds snapshot limit");
+
+	rss_config_t *updated = rss_config_load(state->config_path);
+	if (!updated || rod_metadata_config_store(updated, &candidate) != 0 ||
+	    rss_config_save(updated, state->config_path) != 0) {
+		rss_config_free(updated);
+		return rss_ctrl_resp_error(response, size, "config save failed");
+	}
+	rss_config_free(updated);
+	state->metadata_saved_known = false;
+
+	rss_config_t *readback = rss_config_load(state->config_path);
+	rod_metadata_config_t saved;
+	if (!readback || rod_metadata_config_load(readback, &saved) != 0 ||
+	    strcmp(saved.id, candidate.id) != 0) {
+		rss_config_free(readback);
+		return rss_ctrl_resp_error(response, size, "config readback mismatch");
+	}
+	rss_config_free(state->cfg);
+	state->cfg = readback;
+	state->metadata = saved;
+	state->metadata_saved_known = true;
+	state->metadata_last_publish_us = 0;
+	rod_metadata_publish(state, rss_timestamp_us());
+	return metadata_response(state, response, size, true);
+}
