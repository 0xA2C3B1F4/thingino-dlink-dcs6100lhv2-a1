diff --git a/osd_metadata_snapshot.c b/osd_metadata_snapshot.c
new file mode 100644
index 0000000000000000000000000000000000000000..d7be09b25d5bab6b741d317affa298f0f56317fd
--- /dev/null
+++ b/osd_metadata_snapshot.c
@@ -0,0 +1,213 @@
+#include "osd_metadata_snapshot.h"
+
+#include "osd_snapshot.h"
+
+#include <rss_sei.h>
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#define OSD_METADATA_MAGIC 0x4f534d31u
+#define OSD_METADATA_VERSION 1u
+#define OSD_METADATA_ENABLED 0x01u
+
+static const uint8_t metadata_uuid[16] = {
+	0xa1, 0xb2, 0xc3, 0xd4, 0xe5, 0xf6, 0x47, 0x80,
+	0xab, 0xcd, 0xef, 0x12, 0x34, 0x56, 0x78, 0x90,
+};
+
+typedef struct {
+	uint32_t magic;
+	uint16_t version;
+	uint16_t flags;
+	uint32_t stream;
+	uint32_t generation;
+	int64_t updated_us;
+	uint32_t json_len;
+	uint32_t json_hash;
+	char json[OSD_METADATA_JSON_MAX];
+} osd_metadata_wire_t;
+
+static int snapshot_path(char *dst, size_t cap, const char *directory, unsigned stream,
+			 bool temporary, uint32_t generation)
+{
+	if (!dst || !cap || !directory || !directory[0] || stream >= 6)
+		return -EINVAL;
+	int length = temporary
+			     ? snprintf(dst, cap, "%s/.osd-metadata-%u.%ld.%u.tmp", directory,
+					stream, (long)getpid(), generation)
+			     : snprintf(dst, cap, "%s/osd-metadata-%u.snapshot", directory,
+					stream);
+	return length > 0 && (size_t)length < cap ? 0 : -ENAMETOOLONG;
+}
+
+static int write_all(int fd, const void *data, size_t length)
+{
+	const uint8_t *cursor = data;
+	while (length > 0) {
+		ssize_t written = write(fd, cursor, length);
+		if (written < 0) {
+			if (errno == EINTR)
+				continue;
+			return -errno;
+		}
+		if (written == 0)
+			return -EIO;
+		cursor += written;
+		length -= (size_t)written;
+	}
+	return 0;
+}
+
+static int read_all(int fd, void *data, size_t length)
+{
+	uint8_t *cursor = data;
+	while (length > 0) {
+		ssize_t received = read(fd, cursor, length);
+		if (received < 0) {
+			if (errno == EINTR)
+				continue;
+			return -errno;
+		}
+		if (received == 0)
+			return -EBADMSG;
+		cursor += received;
+		length -= (size_t)received;
+	}
+	return 0;
+}
+
+int osd_metadata_snapshot_write(const char *directory, unsigned stream,
+				uint32_t generation, int64_t updated_us, bool enabled,
+				const char *json, size_t json_len)
+{
+	if ((json_len > 0 && !json) || json_len > OSD_METADATA_JSON_MAX ||
+	    (!enabled && json_len != 0) || generation == 0 || updated_us < 0 ||
+	    (json_len > 0 && (memchr(json, '\0', json_len) || json[0] != '{' ||
+			      json[json_len - 1] != '}')))
+		return -EINVAL;
+	osd_metadata_wire_t wire = {
+		.magic = OSD_METADATA_MAGIC,
+		.version = OSD_METADATA_VERSION,
+		.flags = enabled ? OSD_METADATA_ENABLED : 0,
+		.stream = stream,
+		.generation = generation,
+		.updated_us = updated_us,
+		.json_len = (uint32_t)json_len,
+	};
+	if (json_len > 0) {
+		memcpy(wire.json, json, json_len);
+		wire.json_hash = osd_snapshot_hash((const uint8_t *)json, json_len);
+	}
+
+	char path[256], temporary[256];
+	int ret = snapshot_path(path, sizeof(path), directory, stream, false, 0);
+	if (ret == 0)
+		ret = snapshot_path(temporary, sizeof(temporary), directory, stream, true,
+				    generation);
+	if (ret < 0)
+		return ret;
+	int fd = open(temporary,
+		      O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK,
+		      0600);
+	if (fd < 0)
+		return -errno;
+	struct stat statbuf;
+	if (fstat(fd, &statbuf) != 0)
+		ret = -errno;
+	else if (!S_ISREG(statbuf.st_mode))
+		ret = -EBADMSG;
+	else if (ftruncate(fd, 0) != 0)
+		ret = -errno;
+	else
+		ret = write_all(fd, &wire, sizeof(wire));
+	if (close(fd) != 0 && ret == 0)
+		ret = -errno;
+	if (ret == 0) {
+		int path_status = lstat(path, &statbuf);
+		if (path_status == 0 && !S_ISREG(statbuf.st_mode))
+			ret = -EBADMSG;
+		else if (path_status != 0 && errno != ENOENT)
+			ret = -errno;
+	}
+	if (ret == 0 && rename(temporary, path) != 0)
+		ret = -errno;
+	if (ret < 0)
+		unlink(temporary);
+	return ret;
+}
+
+int osd_metadata_snapshot_read(const char *directory, unsigned stream, int64_t now_us,
+			       int64_t max_age_us, osd_metadata_snapshot_t *snapshot)
+{
+	if (!snapshot || now_us < 0 || max_age_us < 0)
+		return -EINVAL;
+	char path[256];
+	int ret = snapshot_path(path, sizeof(path), directory, stream, false, 0);
+	if (ret < 0)
+		return ret;
+	int fd = open(path, O_RDONLY | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK);
+	if (fd < 0)
+		return -errno;
+	struct stat statbuf;
+	if (fstat(fd, &statbuf) != 0 || !S_ISREG(statbuf.st_mode) ||
+	    statbuf.st_size != (off_t)sizeof(osd_metadata_wire_t)) {
+		close(fd);
+		return -EBADMSG;
+	}
+	osd_metadata_wire_t wire;
+	ret = read_all(fd, &wire, sizeof(wire));
+	if (close(fd) != 0 && ret == 0)
+		ret = -errno;
+	if (ret < 0)
+		return ret;
+	if (wire.magic != OSD_METADATA_MAGIC || wire.version != OSD_METADATA_VERSION ||
+	    wire.stream != stream || (wire.flags & ~OSD_METADATA_ENABLED) != 0 ||
+	    wire.generation == 0 || wire.updated_us < 0 || wire.json_len > OSD_METADATA_JSON_MAX ||
+	    (wire.json_len == 0 && wire.json_hash != 0) ||
+	    (wire.json_len > 0 &&
+	     (memchr(wire.json, '\0', wire.json_len) || wire.json[0] != '{' ||
+	      wire.json[wire.json_len - 1] != '}')) ||
+	    (wire.json_len > 0 && wire.json_hash !=
+				  osd_snapshot_hash((const uint8_t *)wire.json, wire.json_len)))
+		return -EBADMSG;
+	if (now_us < wire.updated_us || now_us - wire.updated_us > max_age_us)
+		return -ESTALE;
+	if (!(wire.flags & OSD_METADATA_ENABLED) || wire.json_len == 0)
+		return -ENODATA;
+	snapshot->generation = wire.generation;
+	snapshot->json_len = wire.json_len;
+	memcpy(snapshot->json, wire.json, wire.json_len);
+	snapshot->json[wire.json_len] = '\0';
+	return 0;
+}
+
+int osd_metadata_build_sei(uint8_t *dst, size_t cap, int codec, int prefix,
+			   const char *json, size_t json_len)
+{
+	if (!json || json_len < 2 || json_len > OSD_METADATA_JSON_MAX ||
+	    memchr(json, '\0', json_len) || json[0] != '{' || json[json_len - 1] != '}')
+		return -EINVAL;
+	return rss_sei_build_user_data(dst, cap, codec, prefix, metadata_uuid,
+				       (const uint8_t *)json, json_len);
+}
+
+int osd_metadata_snapshot_read_sei(const char *directory, unsigned stream, int64_t now_us,
+				   int codec, int prefix, uint8_t *dst, size_t cap,
+				   uint32_t *generation)
+{
+	osd_metadata_snapshot_t snapshot;
+	int ret = osd_metadata_snapshot_read(directory, stream, now_us,
+					     OSD_METADATA_MAX_AGE_US, &snapshot);
+	if (ret < 0)
+		return ret;
+	ret = osd_metadata_build_sei(dst, cap, codec, prefix, snapshot.json,
+				     snapshot.json_len);
+	if (ret > 0 && generation)
+		*generation = snapshot.generation;
+	return ret;
+}
diff --git a/osd_metadata_snapshot.h b/osd_metadata_snapshot.h
new file mode 100644
index 0000000000000000000000000000000000000000..42b97e456afbd19f6724523921894f8e399d981d
