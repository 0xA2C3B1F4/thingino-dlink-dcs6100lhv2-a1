diff --git a/rmr/rmr_prebuf.c b/rmr/rmr_prebuf.c
index e3297b59c6870467d0595a24b7ff255ff9e40753..a8b85523be638f1e17024eb1ea6be9fb2658500b 100644
--- a/rmr/rmr_prebuf.c
+++ b/rmr/rmr_prebuf.c
@@ -13,6 +13,19 @@
 
 #include "rmr_prebuf.h"
 
+uint32_t rmr_prebuf_video_slots(int seconds)
+{
+	if (seconds <= 0)
+		return 0;
+	if (seconds > RMR_PREBUFFER_MAX_SEC)
+		seconds = RMR_PREBUFFER_MAX_SEC;
+	uint32_t frames = 30u * ((uint32_t)seconds + 1u);
+	uint32_t slots = 1;
+	while (slots < frames)
+		slots <<= 1;
+	return slots;
+}
+
 rmr_prebuf_t *rmr_prebuf_create(uint32_t capacity, uint32_t data_size)
 {
 	if (capacity == 0 || (capacity & (capacity - 1)) != 0)
@@ -57,9 +70,25 @@ void rmr_prebuf_push(rmr_prebuf_t *pb, const uint8_t *data, uint32_t len, int64_
 	/* Allocate space in data region. If the frame doesn't fit at
 	 * the current head, wrap to offset 0. */
 	uint32_t offset = pb->data_head;
-	if (offset + len > pb->data_size)
+	if (offset > pb->data_size || len > pb->data_size - offset)
 		offset = 0;
 
+	/* Retained descriptors must never outlive their payload. Remove a
+	 * logical prefix through the last overlapping range before memcpy.
+	 * uint64 endpoints avoid overflow even at uint32 data-size limits. */
+	uint64_t end = (uint64_t)offset + len;
+	uint32_t oldest = pb->write_idx - pb->count;
+	uint32_t evict = 0;
+	for (uint32_t n = 0; n < pb->count; n++) {
+		const rmr_prebuf_slot_t *slot = &pb->slots[(oldest + n) & pb->mask];
+		uint64_t slot_end = (uint64_t)slot->data_offset + slot->data_length;
+		if ((uint64_t)offset < slot_end && (uint64_t)slot->data_offset < end)
+			evict = n + 1;
+	}
+	pb->count -= evict;
+	if (pb->count == pb->capacity)
+		pb->count--; /* Slot capacity can evict even without data overlap. */
+
 	memcpy(pb->data + offset, data, len);
 	pb->data_head = offset + len;
 
