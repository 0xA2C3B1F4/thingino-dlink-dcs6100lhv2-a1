+        } else {
+            assert(strstr(trace, "video-start jpeg-start ivs-start ivs-create "));
+            assert(!state.ivs_stream_paused);
+            assert(atomic_load(&state.ivs_active));
+        }
+    }
+    /* Originally off, including a retained paused SDK channel, never auto-starts. */
+    for (int cmd = 0; cmd < 4; cmd++) {
+        for (int retained_off = 0; retained_off < 2; retained_off++) {
+            setup(false, false);
+            if (!retained_off) {
+                state.ivs_group_created = false;
+                state.ivs_channel_created = false;
+                state.ivs_registered = false;
+                state.ivs_bound = false;
+                state.ivs_algo_handle = NULL;
+            }
+            assert(command(cmd));
+            assert(!strstr(trace, "ivs-"));
+            assert(!atomic_load(&state.ivs_active));
+            assert(!state.ivs_stream_paused);
+        }
+        setup(false, false);
+        state.ivs_fs_chn = 99;
+        atomic_store(&state.ivs_active, true);
+        state.ivs_tid = (pthread_t)(uintptr_t)7;
+        state.ivs_receiving = true;
+        state.ivs_stream_paused = true;
+        assert(command(cmd));
+        assert(!strstr(trace, "ivs-"));
+        assert(atomic_load(&state.ivs_active));
+        assert(state.ivs_stream_paused);
+    }
+    /* Stop and join failures gate config/streams, with explicit command retry. */
+    for (int cmd = 0; cmd < 4; cmd++) {
+        if (cmd == 1)
+            continue;
+        for (int fault = 0; fault < 2; fault++) {
+            setup(true, false);
+            fail_join = fault == 0;
+            fail_stop = fault == 1;
+            assert(!command(cmd));
+            no_stream_or_config();
+            assert(state.ivs_stream_paused);
+            assert(state.ivs_receiving);
+            assert((state.ivs_tid != 0) == fail_join);
+            trace[0] = 0;
+            assert(!command(1)); /* Start cannot consume a failed stop owner. */
+            assert(trace[0] == 0);
+            fail_join = false;
+            fail_stop = false;
+            assert(command(cmd));
+            assert(strstr(trace, "ivs-stop jpeg-stop video-stop "));
+            retained();
+        }
+    }
+    /* Resume failures must not become OK just because video is already active. */
+    for (int cmd = 1; cmd < 4; cmd++) {
+        for (int fault = 0; fault < 3; fault++) {
+            setup(cmd != 1, cmd == 1);
+            fail_start = fault == 0;
+            fail_create = fault != 0;
+            fail_cleanup_stop = fault == 2;
+            assert(!command(cmd));
+            assert(state.ivs_stream_paused);
+            assert(!atomic_load(&state.ivs_active));
+            assert(!state.ivs_tid);
+            assert(state.ivs_receiving == (fault == 2));
+            retained();
+            trace[0] = 0;
+            if (cmd == 2) {
+                assert(!command(2)); /* Matching cached dimensions do not prove recovery. */
+                assert(trace[0] == 0);
+            }
+            fail_start = false;
+            fail_create = false;
+            fail_cleanup_stop = false;
+            fail_stop = false;
+            if (fault == 2) {
+                assert(!command(1));
+                assert(trace[0] == 0);
+                assert(command(0)); /* Explicitly release the retained SDK receive owner. */
+                trace[0] = 0;
+            }
+            assert(command(1));
+            assert(strstr(trace, "ivs-start ivs-create "));
+            if (fault != 2)
+                assert(strcmp(trace, "ivs-start ivs-create ") == 0);
+            assert(!state.ivs_stream_paused);
+        }
+    }
+    for (int cmd = 0; cmd < 4; cmd++) {
+        for (int invalid = 0; invalid < 9; invalid++) {
+            setup(cmd != 1, cmd == 1);
+            if (invalid == 0)
+                state.ivs_roi_uncertain = true;
+            if (invalid == 1)
+                state.ivs_jzdl = true;
+            if (invalid == 2)
+                state.ivs_group_created = false;
+            if (invalid == 3)
+                state.ivs_channel_created = false;
+            if (invalid == 4)
+                state.ivs_registered = false;
+            if (invalid == 5)
+                state.ivs_bound = false;
+            if (invalid == 6)
+                state.ivs_algo_handle = NULL;
+            if (invalid == 7)
+                ops.ivs_start = NULL;
+            if (invalid == 8) {
+                atomic_store(&state.ivs_active, true);
+                state.ivs_receiving = true;
+                state.ivs_tid = (pthread_t)(uintptr_t)7;
+                state.ivs_stream_paused = true;
+            }
+            assert(!command(cmd));
+            assert(trace[0] == 0);
+            assert(config_writes == 0);
+        }
+    }
+    const char *stages[] = {"jpeg-stop", "video-stop",  "video-init",
+                            "jpeg-init", "video-start", "jpeg-start"};
+    for (int cmd = 2; cmd < 4; cmd++) {
+        for (size_t i = 0; i < sizeof(stages) / sizeof(stages[0]); i++) {
+            setup(true, false);
+            fail_stream = stages[i];
+            assert(!command(cmd));
+            assert(!strstr(trace, "ivs-start"));
+            assert(!atomic_load(&state.ivs_active));
+            assert(state.ivs_stream_paused);
+            if (i < 2) {
+                assert(config_writes == 0);
+                assert(!strstr(trace, "deinit"));
+                assert(!strstr(trace, "fs-attr"));
+            }
+        }
+    }
+    setup(true, false);
+    state.ivs_enabled = false; /* Boot config must not suppress restoring active motion. */
+    assert(command(0));
+    trace[0] = 0;
+    assert(command(1));
+    assert(strcmp(trace, "video-start jpeg-start ivs-start ivs-create ") == 0);
+    setup(true, false);
+    assert(command(1));
+    assert(trace[0] == 0); /* Fully healthy stream-start is still idempotent. */
+    setup(true, false);
+    state.enc_tids[0] = 0;
+    assert(!command(1));
+    assert(trace[0] == 0);
+    for (int cmd = 2; cmd < 4; cmd++) {
+        setup(true, false);
+        missing_jpeg_ring = true;
+        assert(!command(cmd));
+        assert(!strstr(trace, "video-start"));
+        assert(!strstr(trace, "ivs-start"));
+        assert(state.ivs_stream_paused);
+    }
+    setup(false, true);
+    fail_stream = "jpeg-start";
+    assert(!command(1));
+    assert(strcmp(trace, "video-start jpeg-start ") == 0);
+    trace[0] = 0;
+    fail_stream = NULL;
+    assert(command(1));
+    assert(strcmp(trace, "jpeg-start ivs-start ivs-create ") == 0);
+    setup(false, true);
+    assert(rvd_ivs_set_enabled(&state, false) == 0);
+    assert(!state.ivs_stream_paused);
+    assert(command(1));
+    assert(!strstr(trace, "ivs-start"));
+    setup(true, false);
+    fail_stop = true;
+    assert(rvd_ivs_set_enabled(&state, false) != 0);
+    assert(!state.ivs_stream_paused);
+    assert(state.ivs_receiving);
+    fail_stop = false;
+    assert(command(0));
+    trace[0] = 0;
+    assert(command(1));
+    assert(!strstr(trace, "ivs-start")); /* Failed explicit off still cancels restoration. */
+    setup(false, true);
+    fail_start = true;
+    assert(rvd_ivs_set_enabled(&state, true) != 0);
+    assert(state.ivs_stream_paused);
+    fail_start = false;
+    trace[0] = 0;
+    assert(command(1));
+    assert(strstr(trace, "ivs-start ivs-create "));
+    puts("actual control and checked IVS stream command transitions passed");
+    return 0;
+}
diff --git a/tests/test_managed_sd.c b/tests/test_managed_sd.c
new file mode 100644
index 0000000000000000000000000000000000000000..1754982ed9f87d5a89a58a6cfc1ec43a038187ee
--- /dev/null
+++ b/tests/test_managed_sd.c
@@ -0,0 +1,225 @@
+#include <assert.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#ifdef __linux__
+#include <sys/sysmacros.h>
+#endif
+#include <unistd.h>
+
+static char mount_root[512], mount_info[512];
+static bool wrong_device;
+static unsigned mount_checks;
+static int fixture_stat(const char *path, struct stat *value)
+{
+	if (strcmp(path, "/dev/mmcblk0p1") != 0)
+		return stat(path, value);
+	++mount_checks;
+	struct stat directory;
+	if (stat(mount_root, &directory) != 0)
+		return -1;
+	memset(value, 0, sizeof(*value));
+	value->st_mode = S_IFBLK | 0600;
+	value->st_rdev = wrong_device ? directory.st_dev + 1 : directory.st_dev;
+	return 0;
+}
+#define RMR_SD_MOUNT	  mount_root
+#define RMR_MOUNTINFO	  mount_info
+#define stat(path, value) fixture_stat(path, value)
+#include "../rmr/rmr_sd.c"
+#undef stat
+
+static void mount_record(const char *options, const char *source, const char *type)
+{
+	struct stat value;
+	assert(stat(mount_root, &value) == 0);
+	FILE *file = fopen(mount_info, "w");
+	assert(file);
+	fprintf(file, "42 1 %u:%u / %s %s - %s %s %s\n", (unsigned)major(value.st_dev),
+		(unsigned)minor(value.st_dev), mount_root, options, type, source, options);
+	assert(fclose(file) == 0);
+}
+
+static bool cancelled(void *opaque)
+{
+	(void)opaque;
+	return false;
+}
+
+static void fat_marker_regression(void)
+{
+	const char *types[] = {"ext4", "vfat", "exfat"};
+	for (unsigned i = 0; i < 3; ++i) {
+		mount_record("rw", "/dev/mmcblk0p1", types[i]);
+		char stamp[32], path[1024], name[32], marker[48], record[128];
+		snprintf(stamp, sizeof(stamp), "2026-09-12/01-00-%02u", i);
+		int fd = rmr_sd_open_segment(1, stamp, path, sizeof(path));
+		assert(fd >= 0 && write(fd, "jpeg", 4) == 4);
+		struct timespec times[2] = {{1789086139, 0}, {1789086139, 0}};
+		assert(futimens(fd, times) == 0);
+		struct stat completed, observed;
+		assert(fstat(fd, &completed) == 0 && close(fd) == 0);
+		assert(rmr_sd_mark_closed(1, path, &completed) == 0);
+		int directory = clip_directory(1, path, name, sizeof(name));
+		assert(directory >= 0);
+		mount_checks = 0;
+		assert(owned_clip(directory, 1, name, &observed));
+		assert(mount_checks == (i == 1 ? 1U : 0U));
+		snprintf(marker, sizeof(marker), "%s.rmr-owned", name);
+		fd = openat(directory, marker, O_RDONLY);
+		ssize_t count = read(fd, record, sizeof(record) - 1);
+		assert(count > 0 && close(fd) == 0);
+		record[count] = 0;
+		assert(strcmp(record, i == 1 ? "RMR1 1 4 1789086138 0\n" : "RMR1 1 4 1789086139 0\n") == 0);
+		fd = openat(directory, name, O_RDONLY);
+		times[1].tv_sec = 1789086138;
+		assert(futimens(fd, times) == 0 && close(fd) == 0);
+		assert(owned_clip(directory, 1, name, &observed) == (i == 1));
+		/* Legacy odd-second markers remain usable in the same FAT slot. */
+		fd = openat(directory, marker, O_WRONLY | O_TRUNC);
+		const char *old = "RMR1 1 4 1789086139 0\n";
+		assert(write(fd, old, strlen(old)) == (ssize_t)strlen(old) && close(fd) == 0);
+		assert(owned_clip(directory, 1, name, &observed) == (i == 1));
+		if (i == 1) {
+			wrong_device = true;
+			assert(!owned_clip(directory, 1, name, &observed));
+			wrong_device = false;
+		}
+		assert(!owned_clip(directory, 0, name, &observed));
+		assert(!marker_time_matches(i == 1, &observed, 1789086140, 0));
+		assert(!marker_time_matches(i == 1, &observed, 1789086137, 0));
+		assert(!marker_time_matches(i == 1, &observed, 1789086138, 1));
+		assert(!marker_time_matches(i == 1, &observed, -1, 0));
+		assert(!marker_time_matches(i == 1, &observed, 1789086138, -1));
+		fd = openat(directory, marker, O_WRONLY | O_TRUNC);
+		const char *wrong_size = "RMR1 1 5 1789086139 0\n";
+		assert(write(fd, wrong_size, strlen(wrong_size)) == (ssize_t)strlen(wrong_size) && close(fd) == 0);
+		assert(!owned_clip(directory, 1, name, &observed));
+		fd = openat(directory, marker, O_WRONLY | O_TRUNC);
+		const char *malformed = "RMR1 1 4 1789086139 0\nextra";
+		assert(write(fd, malformed, strlen(malformed)) == (ssize_t)strlen(malformed) && close(fd) == 0);
+		assert(!owned_clip(directory, 1, name, &observed));
+		close(directory);
+	}
+}
+
+int main(int argc, char **argv)
+{
+	assert(argc == 2);
+	snprintf(mount_root, sizeof(mount_root), "%s/sd", argv[1]);
+	snprintf(mount_info, sizeof(mount_info), "%s/mountinfo", argv[1]);
+	assert(mkdir(mount_root, 0750) == 0);
+	char path[1024], first[1024], outside[1024], link[1024];
+	assert(!rmr_sd_available());
+	assert(rmr_sd_open_segment(0, "2026-09-10/12-00-00", path, sizeof(path)) < 0);
+	snprintf(path, sizeof(path), "%s/raptor", mount_root);
+	assert(access(path, F_OK) != 0);
+	mount_record("rw,relatime", "/dev/mmcblk0p1", "ext4");
+	assert(rmr_sd_available());
+	wrong_device = true;
+	assert(!rmr_sd_available());
+	wrong_device = false;
+	int fd = rmr_sd_open_segment(0, "2026-09-10/12-00-00", first, sizeof(first));
+	assert(fd >= 0 && write(fd, "first", 5) == 5 && close(fd) == 0);
+	fd = rmr_sd_open_segment(0, "2026-09-10/12-00-00", path, sizeof(path));
+	assert(fd >= 0 && strcmp(path, first) != 0 && close(fd) == 0);
+	snprintf(outside, sizeof(outside), "%s/outside", argv[1]);
+	assert(mkdir(outside, 0750) == 0);
+	snprintf(link, sizeof(link), "%s/raptor/stream1", mount_root);
+	assert(symlink(outside, link) == 0);
+	assert(rmr_sd_open_segment(1, "2026-09-10/12-00-00", path, sizeof(path)) < 0);
+	snprintf(path, sizeof(path), "%s/2026-09-10", outside);
+	assert(access(path, F_OK) != 0);
+	assert(unlink(link) == 0);
+	fd = rmr_sd_open_segment(1, "2026-09-10/12-00-00", path, sizeof(path));
+	assert(fd >= 0 && strstr(path, "/stream1/") && close(fd) == 0);
+	assert(rmr_sd_open_segment(2, "2026-09-10/12-00-00", path, sizeof(path)) < 0);
+	assert(rmr_sd_open_segment(0, "../../etc/passwd...", path, sizeof(path)) < 0);
+	/* Retention owns only successfully sealed closed clips in its stream. */
+	char owned[3][1024], other[1024], active[1024];
+	struct stat completed;
+	for (unsigned i = 0; i < 3; ++i) {
+		char stamp[32];
+		snprintf(stamp, sizeof(stamp), "2026-09-10/15-00-%02u", i);
+		fd = rmr_sd_open_segment(0, stamp, owned[i], sizeof(owned[i]));
+		assert(fd >= 0 && write(fd, "clip", 4) == 4);
+		assert(fstat(fd, &completed) == 0 && close(fd) == 0);
+		assert(rmr_sd_mark_closed(0, owned[i], &completed) == 0);
+	}
+	fd = rmr_sd_open_segment(1, "2026-09-10/15-00-00", other, sizeof(other));
+	assert(fd >= 0 && write(fd, "other", 5) == 5);
+	assert(fstat(fd, &completed) == 0 && close(fd) == 0);
+	assert(rmr_sd_mark_closed(1, other, &completed) == 0);
+	fd = rmr_sd_open_segment(0, "2026-09-10/16-00-00", active, sizeof(active));
+	assert(fd >= 0 && write(fd, "active", 6) == 6);
+	assert(rmr_sd_retention(0, 1, 0) == 2);
+	assert(access(owned[0], F_OK) != 0 && access(owned[1], F_OK) != 0);
+	assert(access(owned[2], F_OK) == 0 && access(other, F_OK) == 0);
+	assert(access(first, F_OK) == 0 && access(active, F_OK) == 0);
+	assert(close(fd) == 0);
+	/* Altering a marked file revokes cleanup eligibility. */
+	fd = open(owned[2], O_WRONLY | O_APPEND);
+	assert(fd >= 0 && write(fd, "changed", 7) == 7 && close(fd) == 0);
+	assert(rmr_sd_retention(0, 1, UINT64_MAX) == 0);
+	assert(access(owned[2], F_OK) == 0 && access(other, F_OK) == 0);
+	assert(access(first, F_OK) == 0 && access(active, F_OK) == 0);
+	fd = rmr_sd_open_segment(0, "2026-09-09/00-00-00", path, sizeof(path));
+	assert(fd >= 0 && write(fd, "own", 3) == 3);
+	assert(fstat(fd, &completed) == 0 && close(fd) == 0);
+	assert(rmr_sd_mark_closed(0, path, &completed) == 0);
+	assert(rmr_sd_retention_step(0, 1, UINT64_MAX, cancelled, NULL) == -1);
+	assert(access(path, F_OK) == 0);
+	assert(rmr_sd_retention(0, 1, UINT64_MAX) == 1);
+	snprintf(path, sizeof(path), "%s/raptor/stream0/2026-09-09", mount_root);
+	assert(access(path, F_OK) != 0); /* Day emptied by our deletion was removed. */
+	/* More than both former limits must converge, without deleting user files. */
+	for (unsigned i = 0; i < 2065; ++i) {
+		char stamp[32];
+		snprintf(stamp, sizeof(stamp), "2026-09-11/%02u-%02u-%02u", i / 3600, (i / 60) % 60, i % 60);
+		fd = rmr_sd_open_segment(0, stamp, path, sizeof(path));
+		assert(fd >= 0 && write(fd, "x", 1) == 1);
+		assert(fstat(fd, &completed) == 0 && close(fd) == 0);
+		assert(rmr_sd_mark_closed(0, path, &completed) == 0);
+	}
+	for (unsigned i = 0; i < 4500; ++i) {
+		snprintf(path, sizeof(path), "%s/raptor/stream0/2026-09-11/user-%u", mount_root, i);
+		fd = open(path, O_CREAT | O_EXCL | O_WRONLY, 0640);
+		assert(fd >= 0 && close(fd) == 0);
+	}
+	unsigned removed = 0, passes = 0;
+	for (;;) {
+		int count = rmr_sd_retention(0, 15, 0);
+		assert(count >= 0 && count <= 32);
+		removed += (unsigned)count;
+		assert(++passes < 100);
+		if (count < 32)
+			break;
+	}
+	assert(removed == 2050 && passes > 1);
+	assert(access(other, F_OK) == 0 && access(first, F_OK) == 0 && access(active, F_OK) == 0);
+	assert(access(owned[2], F_OK) == 0);
+	for (unsigned i = 0; i < 4500; ++i) {
+		snprintf(path, sizeof(path), "%s/raptor/stream0/2026-09-11/user-%u", mount_root, i);
+		assert(access(path, F_OK) == 0);
+	}
+	puts("Retention converged from 2065 owned clips across more than 8192 entries to 15");
+	fat_marker_regression();
+	mount_record("ro,relatime", "/dev/mmcblk0p1", "ext4");
+	assert(!rmr_sd_available());
+	assert(rmr_sd_open_segment(0, "2026-09-10/13-00-00", path, sizeof(path)) < 0);
+	mount_record("rw", "/dev/root", "ext4");
+	assert(!rmr_sd_available());
+	mount_record("rw", "/dev/mmcblk0p1", "tmpfs");
+	assert(!rmr_sd_available());
+	assert(unlink(mount_info) == 0);
+	assert(!rmr_sd_available());
+	/* Existing writable directories do not bypass the absent mount check. */
+	assert(rmr_sd_open_segment(0, "2026-09-10/14-00-00", path, sizeof(path)) < 0);
+	puts("Managed SD mount, device, symlink, missing-card and channel separation passed");
+	return 0;
+}
diff --git a/tests/test_managed_state.c b/tests/test_managed_state.c
new file mode 100644
index 0000000000000000000000000000000000000000..1d2a12187f952eec79debdbc8ce7bea5eb2368cb
--- /dev/null
+++ b/tests/test_managed_state.c
@@ -0,0 +1,217 @@
+#include "rmr.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+static bool sd = true, space = true;
+static bool maintenance_available = true, maintenance_paused, maintenance_quiescent = true;
+static bool audio_track_active;
+static unsigned writers, errors, idrs;
+static uint64_t bytes;
+static int64_t now;
+bool rmr_storage_available(rmr_storage_t *s)
+{
+	(void)s;
+	return sd && space;
+}
+bool rmr_storage_observe(rmr_storage_t *storage, bool *mounted, uint64_t *free_mb, bool *cleanup)
+{
+	(void)storage;
+	*mounted = sd;
+	*free_mb = space ? 100 : 0;
+	*cleanup = true;
+	return true;
+}
+bool rmr_storage_maintenance(rmr_storage_t *storage, bool paused, bool *quiescent)
+{
+	(void)storage;
+	if (!maintenance_available)
+		return false;
+	maintenance_paused = paused;
+	*quiescent = maintenance_quiescent;
+	return true;
+}
+bool rmr_storage_maintenance_observe(rmr_storage_t *storage, bool *paused, bool *quiescent)
+{
+	(void)storage;
+	if (!maintenance_available)
+		return false;
+	*paused = maintenance_paused;
+	*quiescent = maintenance_quiescent;
+	return true;
+}
+bool rmr_mux_has_audio(const rmr_mux_t *mux)
+{
+	return mux && audio_track_active;
+}
+int rmr_sd_retention(unsigned channel, unsigned limit, uint64_t minimum)
+{
+	(void)channel;
+	(void)limit;
+	(void)minimum;
+	return 0;
+}
+unsigned rmr_writer_active(void)
+{
+	return writers;
+}
+unsigned rmr_writer_errors(void)
+{
+	return errors;
+}
+uint64_t rmr_writer_written(void)
+{
+	return bytes;
+}
+int64_t rss_timestamp_us(void)
+{
+	return now;
+}
+void rss_ring_request_idr(rss_ring_t *r)
+{
+	assert(r);
+	++idrs;
+}
+static cJSON *command(rmr_state_t *s, const char *q)
+{
+	char response[1024];
+	rmr_managed_command(s, q, response, sizeof(response));
+	cJSON *r = cJSON_Parse(response);
+	assert(r);
+	return r;
+}
+static void state(rmr_state_t *s, int recording, bool closed, const char *reason)
+{
+	cJSON *r = command(s, "{\"cmd\":\"get-recording-state\"}");
+	cJSON *v = cJSON_GetObjectItem(r, "recording");
+	assert(recording < 0 ? cJSON_IsNull(v) : cJSON_IsBool(v) && cJSON_IsTrue(v) == recording);
+	assert(cJSON_IsTrue(cJSON_GetObjectItem(r, "file_closed")) == closed);
+	assert(cJSON_GetObjectItem(r, "stream_id")->valueint == s->stream_idx);
+	v = cJSON_GetObjectItem(r, "reason");
+	assert(reason ? cJSON_IsString(v) && !strcmp(v->valuestring, reason) : cJSON_IsNull(v));
+	cJSON_Delete(r);
+}
+int main(void)
+{
+	maintenance_available = true;
+	maintenance_paused = false;
+	maintenance_quiescent = true;
+	for (int channel = 0; channel < 2; ++channel) {
+		rmr_state_t s = {.managed = true, .stream_idx = channel, .video_ring = (void *)1, .policy = {.min_free_mb = 1}};
+		sd = false;
+		writers = errors = idrs = 0;
+		bytes = now = 0;
+		state(&s, 0, true, "no_sd");
+		cJSON *r = command(&s, "{\"cmd\":\"set-recording\",\"enabled\":true}");
+		assert(!strcmp(cJSON_GetObjectItem(r, "status")->valuestring, "error"));
+		cJSON_Delete(r);
+		assert(!atomic_load(&s.recording) && idrs == 0);
+		sd = true;
+		r = command(&s, "{\"cmd\":\"set-recording\",\"enabled\":true}");
+		cJSON_Delete(r);
+		assert(idrs == 1);
+		state(&s, -1, true, "starting");
+		now = 2000001;
+		rmr_managed_service(&s);
+		assert(!atomic_load(&s.recording));
+		state(&s, 0, true, "writer_error");
+		r = command(&s, "{\"cmd\":\"set-recording\",\"enabled\":true}");
+		cJSON_Delete(r);
+		assert(idrs == 2);
+		s.segment_writer = (void *)1;
+		writers = 1;
+		state(&s, -1, false, "starting");
+		bytes = 100;
+		state(&s, 1, false, NULL);
+		r = command(&s, "{\"cmd\":\"set-recording\",\"enabled\":false}");
+		cJSON_Delete(r);
+		s.segment_writer = NULL;
+		state(&s, -1, false, "stopping");
+		writers = 0;
+		state(&s, 0, true, NULL);
+		s.managed_close_failed = true;
+		state(&s, -1, false, "stopping");
+		s.managed_close_failed = false;
+		s.managed_error = true;
+		atomic_store(&s.recording, true);
+		rmr_managed_service(&s);
+		assert(!atomic_load(&s.recording));
+		const char *bad[] = {
+			"{}", "{\"cmd\":\"set-recording\",\"enabled\":1}",
+			"{\"cmd\":\"get-recording-state\",\"extra\":true}",
+			"{\"cmd\":\"set-recording\",\"enabled\":true,\"enabled\":false}"};
+		for (unsigned i = 0; i < sizeof(bad) / sizeof(*bad); ++i) {
+			r = command(&s, bad[i]);
+			assert(!strcmp(cJSON_GetObjectItem(r, "status")->valuestring, "error"));
+			cJSON_Delete(r);
+		}
+	}
+	/* Boot intent waits for media/storage and is consumed exactly once. */
+	rmr_state_t boot = {.managed = true, .stream_idx = 1, .video_ring = (void *)1,
+		.boot_recording_pending = true, .policy = {.min_free_mb = 1}};
+	writers = errors = idrs = 0;
+	now = 0;
+	sd = false;
+	rmr_managed_service(&boot);
+	assert(boot.boot_recording_pending && idrs == 0);
+	sd = true;
+	space = false;
+	state(&boot, 0, true, "no_space");
+	rmr_managed_service(&boot);
+	assert(boot.boot_recording_pending && idrs == 0);
+	space = true;
+	rmr_managed_service(&boot);
+	assert(!boot.boot_recording_pending && idrs == 1);
+	rmr_managed_service(&boot);
+	assert(idrs == 1);
+	cJSON *stopped = command(&boot, "{\"cmd\":\"set-recording\",\"enabled\":false}");
+	cJSON_Delete(stopped);
+	boot.boot_recording_pending = true;
+	stopped = command(&boot, "{\"cmd\":\"set-recording\",\"enabled\":false}");
+	cJSON_Delete(stopped);
+	rmr_managed_service(&boot);
+	assert(!boot.boot_recording_pending && idrs == 1);
+	int argc = 4, channel;
+	char *argv[] = {"rmr", "--channel", "1", "-f", NULL};
+	assert(!rmr_managed_args(&argc, argv, &channel));
+	assert(argc == 2 && channel == 1 && !strcmp(argv[1], "-f") && !argv[2]);
+
+	/* Current managed readback reports the mux and storage-maintenance owners. */
+	rmr_state_t readback = {.managed = true,
+		.stream_idx = 1,
+		.audio_explicit = true,
+		.audio_enabled = true,
+		.audio_ring = (void *)1,
+		.mux = (void *)1,
+		.video_ring = (void *)1,
+		.policy = {.min_free_mb = 1}};
+	audio_track_active = true;
+	char response[1024];
+	assert(rmr_managed_audio_status(
+		       &readback, "{\"cmd\":\"get-stream-audio-policy\",\"stream_id\":1}",
+		       response, sizeof(response)) > 0);
+	cJSON *status = cJSON_Parse(response);
+	assert(status);
+	assert(cJSON_IsTrue(cJSON_GetObjectItem(status, "startup_explicit")));
+	assert(cJSON_IsTrue(cJSON_GetObjectItem(status, "active_enabled")));
+	assert(cJSON_IsTrue(cJSON_GetObjectItem(status, "source_available")));
+	assert(cJSON_IsTrue(cJSON_GetObjectItem(status, "track_active")));
+	cJSON_Delete(status);
+
+	maintenance_paused = false;
+	maintenance_quiescent = true;
+	assert(rmr_managed_maintenance_command(
+		       &readback, "{\"cmd\":\"set-storage-maintenance\",\"paused\":true}",
+		       response, sizeof(response)) > 0);
+	status = cJSON_Parse(response);
+	assert(status);
+	assert(cJSON_IsTrue(cJSON_GetObjectItem(status, "paused")));
+	assert(cJSON_IsTrue(cJSON_GetObjectItem(status, "quiescent")));
+	cJSON_Delete(status);
+	status = command(&readback, "{\"cmd\":\"set-recording\",\"enabled\":true}");
+	assert(!strcmp(cJSON_GetObjectItem(status, "status")->valuestring, "error"));
+	cJSON_Delete(status);
+	assert(!atomic_load(&readback.recording));
+
+	puts("Managed recording intent, write evidence, drain, failure and channel identity "
+	     "with audio and maintenance readback passed");
+}
diff --git a/tests/test_managed_writer.c b/tests/test_managed_writer.c
new file mode 100644
index 0000000000000000000000000000000000000000..94ebf9d02f26853b908fff21e587464725965edc
--- /dev/null
+++ b/tests/test_managed_writer.c
@@ -0,0 +1,104 @@
+#include <rss_common.h>
+#include <assert.h>
+#include <stdatomic.h>
+#include <stdarg.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <sys/stat.h>
+#include <stdio.h>
+#include <pthread.h>
+#include <string.h>
+static atomic_bool entered_close, allow_close;
+static bool fail_write, fail_close, fail_stack;
+static int checked_stacksize(pthread_attr_t *attr, size_t size);
+static int checked_close(int fd);
+static ssize_t checked_write(int fd, const void *p, size_t n);
+#define pthread_attr_setstacksize checked_stacksize
+#define close			  checked_close
+#define write			  checked_write
+#include "../rmr/rmr_writer.c"
+#undef pthread_attr_setstacksize
+#undef close
+#undef write
+void rss_log(rss_log_level_t level, const char *file, int line, const char *fmt, ...)
+{
+	(void)level;
+	(void)file;
+	(void)line;
+	(void)fmt;
+}
+int rmr_sd_mark_closed(unsigned channel, const char *path, const struct stat *completed)
+{
+	(void)channel;
+	(void)path;
+	(void)completed;
+	assert(false); /* Legacy writer factory must not create ownership markers. */
+	return -1;
+}
+static int checked_stacksize(pthread_attr_t *attr, size_t size)
+{
+	assert(size == 128 * 1024);
+	return fail_stack ? EINVAL : pthread_attr_setstacksize(attr, size);
+}
+static int checked_close(int fd)
+{
+	atomic_store(&entered_close, true);
+	while (!atomic_load(&allow_close))
+		usleep(1000);
+	int rc = close(fd);
+	if (fail_close) {
+		errno = EIO;
+		return -1;
+	}
+	return rc;
+}
+static ssize_t checked_write(int fd, const void *p, size_t n)
+{
+	if (fail_write) {
+		errno = EIO;
+		return -1;
+	}
+	return write(fd, p, n);
+}
+int main(int argc, char **argv)
+{
+	assert(argc == 3);
+	fail_stack = !strcmp(argv[2], "stack-error");
+	fail_write = !strcmp(argv[2], "write-error");
+	fail_close = !strcmp(argv[2], "close-error");
+	int fd = open(argv[1], O_CREAT | O_EXCL | O_RDWR, 0600);
+	assert(fd >= 0);
+	rmr_writer_t *w = rmr_writer_create(fd, 1024, true, 0);
+	if (fail_stack) {
+		assert(!w && errno == EINVAL && rmr_writer_active() == 0);
+		assert(close(fd) == 0);
+		puts("Writer stack attribute failure rejects thread creation");
+		return 0;
+	}
+	assert(w);
+	assert(rmr_writer_active() == 1 && !rmr_writer_written());
+	assert(!rmr_writer_submit(w, "recorded", 8));
+	rmr_writer_finish(w);
+	for (int i = 0; i < 2000 && !atomic_load(&entered_close); ++i)
+		usleep(1000);
+	assert(atomic_load(&entered_close));
+	assert(rmr_writer_active() == 1); /* Queue empty is not descriptor closed. */
+	assert(rmr_writer_written() == (fail_write ? 0 : 8));
+	atomic_store(&allow_close, true);
+	for (int i = 0; i < 2000 && (fail_close ? !rmr_writer_errors() : rmr_writer_active()); ++i)
+		usleep(1000);
+	if (fail_close)
+		assert(rmr_writer_active() == 1 && rmr_writer_errors() == 1);
+	else
+		assert(rmr_writer_active() == 0 && rmr_writer_errors() == (fail_write ? 1 : 0));
+	fd = open(argv[1], O_RDONLY);
+	assert(fd >= 0);
+	char buf[9] = {0};
+	ssize_t n = read(fd, buf, 8);
+	close(fd);
+	assert(n == (fail_write ? 0 : 8));
+	if (!fail_write)
+		assert(!strcmp(buf, "recorded"));
+	puts("Writer disk bytes, asynchronous close and error evidence passed");
+}
diff --git a/tests/test_media_status.c b/tests/test_media_status.c
new file mode 100644
index 0000000000000000000000000000000000000000..a3b3bdc7d5833e04249627e40a37e23712869492
--- /dev/null
+++ b/tests/test_media_status.c
@@ -0,0 +1,87 @@
+#include "rvd.h"
+#include "rhd.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+static bool sub_enabled;
+bool rss_config_get_bool(rss_config_t *cfg, const char *section,
+                         const char *key, bool fallback)
+{
+    (void)cfg; (void)fallback;
+    assert(strcmp(section, "stream1") == 0 && strcmp(key, "enabled") == 0);
+    return sub_enabled;
+}
+
+static void write_result(const char *root, const char *name,
+                         const char *daemon, const char *json)
+{
+    char path[1024];
+    assert(snprintf(path, sizeof(path), "%s/%s.%s.json", root, name, daemon) < (int)sizeof(path));
+    FILE *file = fopen(path, "w");
+    assert(file);
+    assert(fputs(json, file) >= 0);
+    assert(fclose(file) == 0);
+}
+
+int main(int argc, char **argv)
+{
+    assert(argc == 2);
+    const char *cases[] = {"main-only", "failed-sub", "missing-main-jpeg", "missing-sub-jpeg", "both"};
+    for (unsigned c = 0; c < sizeof(cases) / sizeof(cases[0]); c++) {
+        const char *name = cases[c];
+        sub_enabled = strcmp(name, "main-only") != 0;
+        rss_hal_ops_t ops = {0};
+        rvd_state_t st = {0};
+        st.ops = &ops;
+        st.stream_count = sub_enabled ? 2 : 1;
+        for (int id = 0; id < st.stream_count; id++) {
+            st.streams[id].chn = id;
+            st.streams[id].enabled = !(id == 1 && strcmp(name, "failed-sub") == 0);
+            st.streams[id].ring = (rss_ring_t *)(uintptr_t)1;
+            st.streams[id].enc_cfg = (rss_video_config_t){
+                .width = id == 0 ? 1280 : 640, .height = id == 0 ? 720 : 360,
+                .codec = RSS_CODEC_H264, .fps_num = 20, .fps_den = 1,
+                .bitrate = 2000000, .gop_length = 40,
+            };
+        }
+        int base = st.stream_count;
+        st.jpeg_count = sub_enabled ? 2 : 1;
+        for (int id = 0; id < st.jpeg_count; id++) {
+            int slot = st.stream_count++;
+            st.jpeg_streams[id] = slot;
+            st.streams[slot] = st.streams[id];
+            st.streams[slot].chn = base + id;
+            st.streams[slot].is_jpeg = true;
+            st.streams[slot].enc_cfg.codec = RSS_CODEC_JPEG;
+            st.streams[slot].enc_cfg.bitrate = 0;
+            st.streams[slot].enc_cfg.gop_length = 0;
+            st.streams[slot].enc_cfg.fps_num = 1;
+        }
+        char response[4096];
+        assert(rvd_media_status(&st, response, sizeof(response)) > 0);
+        cJSON *document = cJSON_Parse(response);
+        cJSON *streams = cJSON_GetObjectItem(document, "streams");
+        cJSON *jpeg = cJSON_GetArrayItem(streams, base);
+        assert(cJSON_IsTrue(cJSON_GetObjectItem(jpeg, "jpeg")));
+        assert(cJSON_GetNumberValue(cJSON_GetObjectItem(jpeg, "stream_id")) == 0);
+        assert(cJSON_GetNumberValue(cJSON_GetObjectItem(jpeg, "chn")) == base);
+        cJSON_Delete(document);
+        write_result(argv[1], name, "rvd", response);
+
+        rhd_server_t rhd = {0};
+        rhd.port = 8080;
+        rhd.jpeg_ring_count = st.jpeg_count;
+        rhd.jpeg_rings[0] = strcmp(name, "missing-main-jpeg") == 0 ? NULL : (rss_ring_t *)(uintptr_t)1;
+        rhd.jpeg_rings[1] = !sub_enabled || strcmp(name, "missing-sub-jpeg") == 0 ? NULL : (rss_ring_t *)(uintptr_t)1;
+        assert(rhd_media_status(&rhd, response, sizeof(response)) > 0);
+        document = cJSON_Parse(response);
+        cJSON *available = cJSON_GetObjectItem(document, "jpeg_available");
+        for (int id = 0; id < 2; id++)
+            assert(cJSON_IsTrue(cJSON_GetArrayItem(available, id)) == (rhd.jpeg_rings[id] != NULL));
+        cJSON_Delete(document);
+        write_result(argv[1], name, "rhd", response);
+    }
+    puts("Actual RVD/RHD per-stream status cases passed");
+    return 0;
+}
diff --git a/tests/test_motion_persistence.c b/tests/test_motion_persistence.c
new file mode 100644
index 0000000000000000000000000000000000000000..c6b59d28445266cb9d365f83eb92efe0e0cea7e0
--- /dev/null
+++ b/tests/test_motion_persistence.c
@@ -0,0 +1,295 @@
+#include "rvd.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+#ifndef RVD_IVS_READ_LOCK_TIMEOUT_MS
+#define RVD_IVS_READ_LOCK_TIMEOUT_MS 500
+#endif
+
+void rvd_ivs_lock_sdk(void) {}
+void rvd_ivs_unlock_sdk(void) {}
+static bool sdk_readable = true;
+bool rvd_ivs_lock_sdk_read(uint32_t timeout_ms)
+{
+    assert(timeout_ms == RVD_IVS_READ_LOCK_TIMEOUT_MS);
+    return sdk_readable;
+}
+
+static int transitions;
+static bool fail_transition, missing_worker;
+
+int rvd_ivs_set_enabled(rvd_state_t *st, bool enabled)
+{
+    transitions++;
+    if (fail_transition)
+        return RSS_ERR;
+    atomic_store(&st->ivs_active, enabled);
+    st->ivs_receiving = enabled;
+    st->ivs_tid = enabled && !missing_worker ? (pthread_t)(uintptr_t)1 : 0;
+    return RSS_OK;
+}
+
+static cJSON *reply(rvd_state_t *st, const char *request, bool expected_ok)
+{
+    char response[2048];
+    int size = request ? rvd_set_motion_config(st, request, response, sizeof(response)) :
+                        rvd_get_motion_config(st, response, sizeof(response));
+    assert(size > 0);
+    cJSON *root = cJSON_Parse(response);
+    cJSON *status = cJSON_GetObjectItemCaseSensitive(root, "status");
+    assert(cJSON_IsString(status));
+    assert((strcmp(status->valuestring, "ok") == 0) == expected_ok);
+    return root;
+}
+
+static void command(rvd_state_t *st, const char *request, bool expected_ok)
+{
+    cJSON_Delete(reply(st, request, expected_ok));
+}
+
+static rss_ivs_move_param_t parameters;
+static int parameter_reads, sets;
+static bool fail_get, fail_set, stale_set, change_roi;
+static int get_parameters(void *ctx, int channel, void *out)
+{
+    (void)ctx; (void)channel;
+    parameter_reads++;
+    if (fail_get) return RSS_ERR;
+    *(rss_ivs_move_param_t *)out = parameters;
+    return RSS_OK;
+}
+static int set_parameters(void *ctx, int channel, void *input)
+{
+    (void)ctx; (void)channel;
+    sets++;
+    if (fail_set) return RSS_ERR;
+    if (!stale_set) parameters = *(rss_ivs_move_param_t *)input;
+    if (change_roi) parameters.roi[0].p1_x++;
+    return RSS_OK;
+}
+static void sensitivity_command(rvd_state_t *st, const char *request, bool success)
+{
+    char response[2048];
+    assert(rvd_set_motion_sensitivity(st, request, response, sizeof(response)) > 0);
+    cJSON *root = cJSON_Parse(response);
+    assert((strcmp(cJSON_GetObjectItemCaseSensitive(root, "status")->valuestring, "ok") == 0) == success);
+    cJSON_Delete(root);
+}
+static void skip_frames_command(rvd_state_t *st, const char *request, bool success)
+{
+    char response[2048];
+    assert(rvd_set_motion_skip_frames(st, request, response, sizeof(response)) > 0);
+    cJSON *root = cJSON_Parse(response);
+    assert((strcmp(cJSON_GetObjectItemCaseSensitive(root, "status")->valuestring, "ok") == 0) == success);
+    cJSON_Delete(root);
+}
+static void lifecycle_command(rvd_state_t *st, const char *request, bool success)
+{
+    char response[2048];
+    assert(rvd_set_motion_lifecycle(st, request, response, sizeof(response)) > 0);
+    cJSON *root = cJSON_Parse(response);
+    assert((strcmp(cJSON_GetObjectItemCaseSensitive(root, "status")->valuestring, "ok") == 0) == success);
+    cJSON_Delete(root);
+}
+static void test_sensitivity(rss_config_t *cfg, const char *path)
+{
+    rss_hal_ops_t ops = {.ivs_get_param = get_parameters, .ivs_set_param = set_parameters};
+    rvd_state_t st = {.cfg = cfg, .ops = &ops, .stream_count = 2, .ivs_active = true,
+        .ivs_receiving = true, .ivs_tid = (pthread_t)(uintptr_t)1, .ivs_channel_created = true};
+    parameters = (rss_ivs_move_param_t){.width = 640, .height = 360, .roi_count = 2, .skip_frame_count = 5};
+    parameters.sense[0] = parameters.sense[1] = 3;
+    parameters.roi[0] = (rss_rect_t){0, 0, 319, 359};
+    parameters.roi[1] = (rss_rect_t){320, 0, 639, 359};
+    int reads_before_busy = parameter_reads;
+    sdk_readable = false;
+    cJSON *state = reply(&st, NULL, true);
+    cJSON *sense = cJSON_GetObjectItemCaseSensitive(state, "sensitivity");
+    cJSON *skip = cJSON_GetObjectItemCaseSensitive(state, "skip_frames");
+    cJSON *roi = cJSON_GetObjectItemCaseSensitive(state, "roi");
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(sense, "supported")));
+    assert(cJSON_IsFalse(cJSON_GetObjectItemCaseSensitive(sense, "available")));
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(skip, "supported")));
+    assert(cJSON_IsFalse(cJSON_GetObjectItemCaseSensitive(skip, "available")));
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(roi, "supported")));
+    assert(cJSON_IsFalse(cJSON_GetObjectItemCaseSensitive(roi, "available")));
+    assert(parameter_reads == reads_before_busy);
+    cJSON_Delete(state);
+    sdk_readable = true;
+    const char *request = "{\"cmd\":\"set-motion-sensitivity\",\"sensitivity\":4}";
+    rss_config_set_int(cfg, "motion", "sensitivity", 3);
+    sensitivity_command(&st, "{\"cmd\":\"set-motion-sensitivity\",\"sensitivity\":4.5}", false);
+    st.ivs_persondet = true;
+    sensitivity_command(&st, request, false);
+    assert(parameter_reads == 0 && sets == 0);
+    st.ivs_persondet = false;
+    fail_get = true;
+    sensitivity_command(&st, request, false);
+    assert(sets == 0);
+    fail_get = false;
+    fail_set = true;
+    sensitivity_command(&st, request, false);
+    assert(rss_config_get_int(cfg, "motion", "sensitivity", -1) == 3);
+    fail_set = false;
+    stale_set = true;
+    sensitivity_command(&st, request, false);
+    assert(rss_config_get_int(cfg, "motion", "sensitivity", -1) == 3);
+    stale_set = false;
+    change_roi = true;
+    sensitivity_command(&st, request, false);
+    assert(rss_config_get_int(cfg, "motion", "sensitivity", -1) == 3);
+    change_roi = false;
+    parameters.roi[0].p1_x--;
+    sensitivity_command(&st, request, true);
+    assert(parameters.sense[0] == 4 && parameters.sense[1] == 4);
+    int previous_sets = sets;
+    rss_config_set_int(cfg, "motion", "sensitivity", 3);
+    sensitivity_command(&st, request, true);
+    assert(sets == previous_sets && rss_config_get_int(cfg, "motion", "sensitivity", -1) == 4);
+    assert(rss_config_save(cfg, path) == RSS_OK);
+    rss_config_t *disk = rss_config_load(path);
+    assert(disk && rss_config_get_int(disk, "motion", "sensitivity", -1) == 4);
+    rss_config_free(disk);
+
+    const char *skip_request = "{\"cmd\":\"set-motion-skip-frames\",\"skip_frame_count\":12}";
+    rss_config_set_int(cfg, "motion", "skip_frames", 5);
+    skip_frames_command(&st, "{\"cmd\":\"set-motion-skip-frames\",\"skip_frame_count\":65536}", false);
+    fail_get = true;
+    skip_frames_command(&st, skip_request, false);
+    fail_get = false;
+    fail_set = true;
+    skip_frames_command(&st, skip_request, false);
+    assert(rss_config_get_int(cfg, "motion", "skip_frames", -1) == 5);
+    fail_set = false;
+    stale_set = true;
+    skip_frames_command(&st, skip_request, false);
+    assert(rss_config_get_int(cfg, "motion", "skip_frames", -1) == 5);
+    stale_set = false;
+    skip_frames_command(&st, "{\"cmd\":\"set-motion-skip-frames\",\"skip_frame_count\":0}", true);
+    assert(parameters.skip_frame_count == 0);
+    skip_frames_command(&st, "{\"cmd\":\"set-motion-skip-frames\",\"skip_frame_count\":65535}", true);
+    assert(parameters.skip_frame_count == 65535);
+    skip_frames_command(&st, skip_request, true);
+    assert(parameters.skip_frame_count == 12);
+    assert(parameters.sense[0] == 4 && parameters.sense[1] == 4);
+    previous_sets = sets;
+    rss_config_set_int(cfg, "motion", "skip_frames", 5);
+    skip_frames_command(&st, skip_request, true);
+    assert(sets == previous_sets && rss_config_get_int(cfg, "motion", "skip_frames", -1) == 12);
+    assert(rss_config_save(cfg, path) == RSS_OK);
+    disk = rss_config_load(path); /* Fresh load models the next RVD process start. */
+    assert(disk && rss_config_get_int(disk, "motion", "skip_frames", -1) == 12);
+    rss_config_free(disk);
+
+    const char *lifecycle = "{\"cmd\":\"set-motion-lifecycle\",\"debounce_time\":2,\"cooldown_time\":7,\"init_time\":3,\"min_time\":4,\"post_time\":6}";
+    lifecycle_command(&st, "{\"cmd\":\"set-motion-lifecycle\",\"debounce_time\":2,\"cooldown_time\":61,\"init_time\":3,\"min_time\":4,\"post_time\":6}", false);
+    lifecycle_command(&st, "{\"cmd\":\"set-motion-lifecycle\",\"debounce_time\":2,\"cooldown_time\":7,\"init_time\":3,\"min_time\":4}", false);
+    lifecycle_command(&st, lifecycle, true);
+    cJSON *lifecycle_state = reply(&st, NULL, true);
+    cJSON *lifecycle_readback = cJSON_GetObjectItemCaseSensitive(lifecycle_state, "lifecycle");
+    assert(cJSON_GetObjectItemCaseSensitive(lifecycle_readback, "debounce_time")->valueint == 2);
+    assert(cJSON_GetObjectItemCaseSensitive(lifecycle_readback, "cooldown_time")->valueint == 7);
+    assert(cJSON_GetObjectItemCaseSensitive(lifecycle_readback, "init_time")->valueint == 3);
+    assert(cJSON_GetObjectItemCaseSensitive(lifecycle_readback, "min_time")->valueint == 4);
+    assert(cJSON_GetObjectItemCaseSensitive(lifecycle_readback, "post_time")->valueint == 6);
+    cJSON_Delete(lifecycle_state);
+    assert(rss_config_save(cfg, path) == RSS_OK);
+    disk = rss_config_load(path);
+    assert(disk && rss_config_get_int(disk, "motion", "debounce_time", -1) == 2);
+    assert(rss_config_get_int(disk, "motion", "cooldown_time", -1) == 7);
+    assert(rss_config_get_int(disk, "motion", "init_time", -1) == 3);
+    assert(rss_config_get_int(disk, "motion", "min_time", -1) == 4);
+    assert(rss_config_get_int(disk, "motion", "post_time", -1) == 6);
+    rss_config_free(disk);
+
+    st.ivs_lock_initialized = true;
+    st.ivs_result_epoch = 42;
+    assert(pthread_mutex_init(&st.ivs_det_lock, NULL) == 0);
+    rvd_publish_motion_result(&st, true, 100);
+    rvd_publish_motion_result(&st, false, 200);
+    uint64_t epoch = 0, sequence = 0;
+    bool raw_motion = true;
+    int64_t timestamp = 0;
+    assert(rvd_snapshot_motion_result(&st, &epoch, &sequence, &raw_motion, &timestamp));
+    assert(epoch == 42 && sequence == 2 && !raw_motion && timestamp == 200);
+    for (int i = 0; i < 25; ++i) {
+        uint64_t previous_epoch = epoch;
+        rvd_reset_motion_results(&st);
+        assert(!rvd_snapshot_motion_result(&st, &epoch, &sequence, &raw_motion, &timestamp));
+        assert(epoch == previous_epoch + 1 && sequence == 0 && !raw_motion && timestamp == 0);
+        rvd_publish_motion_result(&st, true, 300 + i);
+        assert(rvd_snapshot_motion_result(&st, &epoch, &sequence, &raw_motion, &timestamp));
+        assert(sequence == 1 && raw_motion && timestamp == 300 + i);
+    }
+    assert(pthread_mutex_destroy(&st.ivs_det_lock) == 0);
+    st.ivs_lock_initialized = false;
+    st.ivs_receiving = false;
+    sensitivity_command(&st, request, false);
+    skip_frames_command(&st, skip_request, false);
+    assert(sets == previous_sets);
+    puts("Move sensitivity and skip-frame SDK readback, preserved parameters, cache repair and disk save passed");
+}
+
+int main(int argc, char **argv)
+{
+    assert(argc == 2);
+    FILE *file = fopen(argv[1], "w");
+    assert(file);
+    fputs("[motion]\nenabled=false\n", file);
+    fclose(file);
+    rss_config_t *cfg = rss_config_load(argv[1]);
+    assert(cfg);
+    rvd_state_t st = {.cfg = cfg, .stream_count = 2};
+    const char *enable = "{\"cmd\":\"set-motion-config\",\"enabled\":true}";
+    const char *disable = "{\"cmd\":\"set-motion-config\",\"enabled\":false}";
+    const char *invalid[] = {
+        "{\"cmd\":\"set-motion-config\",\"enabled\":1}",
+        "{\"cmd\":\"set-motion-config\",\"enabled\":true,\"roi\":1}",
+        "{\"cmd\":\"set-motion-config\",\"enabled\":true,\"enabled\":false}",
+        "{\"cmd\":\"set-motion-config\",\"enabled\":true} trailing",
+    };
+    for (size_t i = 0; i < sizeof(invalid) / sizeof(invalid[0]); ++i)
+        command(&st, invalid[i], false);
+    assert(transitions == 0);
+    st.ivs_jzdl = true;
+    command(&st, enable, false);
+    assert(transitions == 0);
+    st.ivs_jzdl = false;
+    fail_transition = true;
+    command(&st, enable, false);
+    assert(!rss_config_get_bool(cfg, "motion", "enabled", true));
+    fail_transition = false;
+    missing_worker = true;
+    command(&st, enable, false);
+    assert(!rss_config_get_bool(cfg, "motion", "enabled", true));
+    cJSON *state = reply(&st, NULL, true);
+    assert(cJSON_IsFalse(cJSON_GetObjectItemCaseSensitive(state, "available")));
+    cJSON_Delete(state);
+    missing_worker = false;
+    command(&st, enable, true);
+    assert(rss_config_get_bool(cfg, "motion", "enabled", false));
+    rss_config_set_bool(cfg, "motion", "enabled", false);
+    command(&st, enable, true);
+    assert(rss_config_get_bool(cfg, "motion", "enabled", false));
+    char bad_path[1024];
+    snprintf(bad_path, sizeof(bad_path), "%s/missing", argv[1]);
+    assert(rss_config_save(cfg, bad_path) != RSS_OK);
+    command(&st, enable, true);
+    assert(rss_config_save(cfg, argv[1]) == RSS_OK);
+    rss_config_t *disk = rss_config_load(argv[1]);
+    assert(disk && rss_config_get_bool(disk, "motion", "enabled", false));
+    rss_config_free(disk);
+    fail_transition = true;
+    command(&st, disable, false);
+    assert(rss_config_get_bool(cfg, "motion", "enabled", false));
+    fail_transition = false;
+    command(&st, disable, true);
+    assert(rss_config_save(cfg, argv[1]) == RSS_OK);
+    disk = rss_config_load(argv[1]);
+    assert(disk && !rss_config_get_bool(disk, "motion", "enabled", true));
+    rss_config_free(disk);
+    test_sensitivity(cfg, argv[1]);
+    rss_config_free(cfg);
+    puts("Motion configuration validation, owner checks, cache repair and disk save passed");
+    return 0;
+}
diff --git a/tests/test_motion_roi.c b/tests/test_motion_roi.c
new file mode 100644
index 0000000000000000000000000000000000000000..04c6e4ca41134834b0e232a06ffa28eda9e07e88
--- /dev/null
+++ b/tests/test_motion_roi.c
@@ -0,0 +1,221 @@
+#include "rvd.h"
+#include <assert.h>
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+
+static rss_ivs_move_param_t parameters;
+static rvd_state_t *owner;
+static bool sdk_locked, stale_set;
+static int get_calls, sets, stops, starts, joins, stop_error, set_error, get_fault, corrupt_set;
+
+void rvd_ivs_lock_sdk(void) { assert(!sdk_locked); sdk_locked = true; }
+bool rvd_ivs_lock_sdk_read(uint32_t timeout_ms)
+{
+	assert(timeout_ms == RVD_IVS_READ_LOCK_TIMEOUT_MS);
+	rvd_ivs_lock_sdk();
+	return true;
+}
+void rvd_ivs_unlock_sdk(void) { assert(sdk_locked); sdk_locked = false; }
+
+static int get_param(void *ctx, int channel, void *out)
+{
+    (void)ctx;
+    (void)channel;
+    assert(sdk_locked);
+    get_calls++;
+    if (get_fault && get_calls >= 2)
+        return RSS_ERR;
+    *(rss_ivs_move_param_t *)out = parameters;
+    return RSS_OK;
+}
+
+static int set_param(void *ctx, int channel, void *input)
+{
+    (void)ctx;
+    (void)channel;
+    assert(sdk_locked && !atomic_load(&owner->ivs_active) && !owner->ivs_receiving && !owner->ivs_tid);
+    assert(owner->ivs_roi_uncertain);
+    const rss_ivs_move_param_t *desired = input;
+    assert(desired->width == parameters.width && desired->height == parameters.height);
+    assert(desired->skip_frame_count == parameters.skip_frame_count && desired->sense[0] == parameters.sense[0]);
+    sets++;
+    if (set_error)
+        return RSS_ERR;
+    if (!stale_set)
+        parameters = *desired;
+    if (corrupt_set == 1) parameters.skip_frame_count++;
+    if (corrupt_set == 2) parameters.sense[0] = 4;
+    return RSS_OK;
+}
+
+static int stop_receive(void *ctx, int channel)
+{
+    (void)ctx;
+    (void)channel;
+    assert(!sdk_locked && !owner->ivs_tid && !atomic_load(&owner->ivs_active));
+    stops++;
+    return stop_error;
+}
+
+static int start_receive(void *ctx, int channel)
+{
+    (void)ctx;
+    (void)channel;
+    assert(!owner->ivs_roi_uncertain && !owner->ivs_tid);
+    starts++;
+    return RSS_OK;
+}
+
+static int join_worker(pthread_t thread, void **result)
+{
+    (void)result;
+    assert(thread && !sdk_locked && !atomic_load(&owner->ivs_active));
+    joins++;
+    return 0;
+}
+
+void *rvd_ivs_thread(void *arg) { (void)arg; assert(false); return NULL; }
+int rvd_ivs_init(rvd_state_t *st) { (void)st; assert(false); return RSS_ERR; }
+int rvd_ivs_start(rvd_state_t *st) { (void)st; assert(false); return RSS_ERR; }
+
+static int create_worker(pthread_t *thread, const pthread_attr_t *attr, void *(*entry)(void *), void *arg)
+{
+    (void)attr;
+    assert(entry == rvd_ivs_thread && arg == owner && owner->ivs_receiving);
+    *thread = (pthread_t)(uintptr_t)1;
+    return 0;
+}
+
+#define pthread_join join_worker
+#define pthread_create create_worker
+#include "native_motion_roi.h"
+#undef pthread_create
+#undef pthread_join
+
+static rss_hal_ops_t ops = {.ivs_get_param = get_param, .ivs_set_param = set_param,
+                           .ivs_stop = stop_receive, .ivs_start = start_receive};
+static const char *request = "{\"cmd\":\"set-motion-roi\",\"frame_width\":640,\"frame_height\":360,\"roi_0_x\":64,\"roi_0_y\":32,\"roi_1_x\":320,\"roi_1_y\":240,\"roi_count\":1}";
+
+static void command(rvd_state_t *st, const char *json, bool success)
+{
+    char buf[2048];
+    assert(rvd_set_motion_roi(st, json, buf, sizeof(buf)) > 0);
+    cJSON *root = cJSON_Parse(buf);
+    assert(root);
+    assert((strcmp(cJSON_GetObjectItemCaseSensitive(root, "status")->valuestring, "ok") == 0) == success);
+    cJSON_Delete(root);
+}
+
+static void setup(rvd_state_t *st, rss_config_t *cfg)
+{
+    memset(st, 0, sizeof(*st));
+    st->cfg = cfg;
+    st->ops = &ops;
+    st->stream_count = 2;
+    st->streams[1].enc_cfg.width = 640;
+    st->streams[1].enc_cfg.height = 360;
+    st->ivs_active = st->ivs_receiving = true;
+    st->ivs_group_created = st->ivs_channel_created = st->ivs_registered = st->ivs_bound = true;
+    st->ivs_tid = (pthread_t)(uintptr_t)1;
+    st->ivs_algo_handle = (void *)(uintptr_t)1;
+    st->ivs_grid_x = 2;
+    st->ivs_grid_y = 1;
+    st->ivs_roi_count = 2;
+    st->ivs_lock_initialized = true;
+    pthread_mutex_init(&st->ivs_det_lock, NULL);
+    parameters = (rss_ivs_move_param_t){.width = 640, .height = 360, .roi_count = 2, .skip_frame_count = 5};
+    parameters.sense[0] = parameters.sense[1] = 3;
+    parameters.roi[0] = (rss_rect_t){0, 0, 319, 359};
+    parameters.roi[1] = (rss_rect_t){320, 0, 639, 359};
+    owner = st;
+    get_calls = sets = stops = starts = joins = stop_error = set_error = get_fault = corrupt_set = 0;
+    stale_set = sdk_locked = false;
+    rss_config_set_int(cfg, "motion", "roi_count", 2);
+    rss_config_set_str(cfg, "motion", "roi0", "0,0,319,359");
+}
+
+int main(int argc, char **argv)
+{
+    assert(argc == 2);
+    FILE *file = fopen(argv[1], "w");
+    assert(file && fclose(file) == 0);
+    rss_config_t *cfg = rss_config_load(argv[1]);
+    assert(cfg);
+    for (int fault = 0; fault <= 6; ++fault) {
+        rvd_state_t st;
+        setup(&st, cfg);
+        stop_error = fault == 1 ? RSS_ERR : RSS_OK;
+        set_error = fault == 2 ? RSS_ERR : RSS_OK;
+        stale_set = fault == 3;
+        get_fault = fault == 4;
+        corrupt_set = fault > 4 ? fault - 4 : 0;
+        command(&st, request, fault == 0);
+        assert(!atomic_load(&st.ivs_active) && !st.ivs_tid);
+        assert(joins == 1 && stops == 1);
+        if (fault) {
+            assert(rss_config_get_int(cfg, "motion", "roi_count", 0) == 2);
+            assert(rvd_ivs_set_enabled(&st, true) != RSS_OK && starts == 0);
+            if (fault != 1) {
+                assert(st.ivs_roi_uncertain && !st.ivs_receiving);
+                atomic_store(&st.ivs_active, true);
+                rvd_ivs_resume(&st);
+                assert(!st.ivs_receiving && starts == 0);
+                atomic_store(&st.ivs_active, false);
+            }
+            stop_error = set_error = get_fault = corrupt_set = 0;
+            stale_set = false;
+            assert(rvd_ivs_set_enabled(&st, false) == RSS_OK);
+            command(&st, request, true);
+        }
+        assert(parameters.roi_count == 1 && parameters.roi[0].p1_x == 319 && parameters.roi[0].p1_y == 239);
+        assert(!st.ivs_roi_uncertain && st.ivs_grid_x == 0 && st.ivs_grid_y == 0 && st.ivs_roi_count == 1);
+        assert(rvd_ivs_set_enabled(&st, true) == RSS_OK && st.ivs_receiving && st.ivs_tid);
+        int previous_sets = sets, previous_stops = stops;
+        st.ivs_motion = true;
+        st.ivs_detections.count = 1;
+        /* Unchanged saving repairs stale config without pausing or losing an event. */
+        rss_config_set_str(cfg, "motion", "roi0", "0,0,639,359");
+        command(&st, request, true);
+        assert(sets == previous_sets && stops == previous_stops && st.ivs_motion && st.ivs_detections.count == 1);
+        assert(rss_config_save(cfg, argv[1]) == RSS_OK);
+        rss_config_t *disk = rss_config_load(argv[1]);
+        rss_rect_t restored;
+        assert(load_single_roi(disk, 640, 360, &restored) == RSS_OK);
+        assert(restored.p0_x == 64 && restored.p0_y == 32 && restored.p1_x == 319 && restored.p1_y == 239);
+        rss_config_free(disk);
+        rss_ivs_move_result_t result = {0};
+        result.ret_roi[1] = 1; /* Old result slot outside the new ROI count. */
+        ivs_process_move_result(&st, &result);
+        assert(!atomic_load(&st.ivs_motion));
+        result.ret_roi[0] = 1;
+        ivs_process_move_result(&st, &result);
+        assert(atomic_load(&st.ivs_motion));
+        char buf[4096];
+        assert(rvd_get_motion_config(&st, buf, sizeof(buf)) > 0);
+        cJSON *state = cJSON_Parse(buf);
+        cJSON *roi = cJSON_GetObjectItemCaseSensitive(state, "roi");
+        assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(roi, "applied")));
+        cJSON *single = cJSON_GetObjectItemCaseSensitive(roi, "single");
+        assert(cJSON_GetObjectItemCaseSensitive(single, "roi_1_x")->valueint == 320);
+        cJSON_Delete(state);
+        pthread_mutex_destroy(&st.ivs_det_lock);
+    }
+    rvd_state_t st;
+    setup(&st, cfg);
+    command(&st, "{\"cmd\":\"set-motion-roi\",\"frame_width\":640,\"frame_height\":360,\"roi_0_x\":0,\"roi_0_y\":0,\"roi_1_x\":641,\"roi_1_y\":240,\"roi_count\":1}", false);
+    assert(!get_calls && !sets && !stops);
+    st.ivs_base_move = true;
+    command(&st, request, false);
+    assert(!get_calls && !sets && !stops);
+    for (size_t i = 0; i < 5; ++i) {
+        const char *bad[] = {"1,2,3", "0,0,9999999999999999999999,30", "4,4,3,9", "0,0,640,359", "0,0,63,63 trailing"};
+        rss_config_set_str(cfg, "motion", "roi0", bad[i]);
+        rss_rect_t box;
+        assert(load_single_roi(cfg, 640, 360, &box) != RSS_OK);
+    }
+    pthread_mutex_destroy(&st.ivs_det_lock);
+    rss_config_free(cfg);
+    puts("ROI quiescence, retained channel, SDK readback, failure gating, retry, disk restore and result bounds passed");
+    return 0;
+}
