diff --git a/tests/test_stream_stop_callers.c b/tests/test_stream_stop_callers.c
new file mode 100644
index 0000000000000000000000000000000000000000..dbd2f168116f91fda0bd89e233160005c5a24b2b
--- /dev/null
+++ b/tests/test_stream_stop_callers.c
@@ -0,0 +1,111 @@
+#include "rvd.h"
+#include "native_fps_unused.h"
+#include <assert.h>
+#include <stdio.h>
+#include <fcntl.h>
+#include <unistd.h>
+static int forbidden_open(const char *p, int f, ...) { (void)p; (void)f; assert(0); return -1; }
+static ssize_t forbidden_write(int fd, const void *p, size_t n) { (void)fd; (void)p; (void)n; assert(0); return -1; }
+static int forbidden_unlink(const char *p) { (void)p; assert(0); return -1; }
+static int forbidden_rename(const char *p, const char *q) { (void)p; (void)q; assert(0); return -1; }
+FILE *forbidden_fopen(const char *p, const char *m) { (void)p; (void)m; assert(0); return NULL; }
+static int config_writes;
+static void config_int(rss_config_t *c, const char *s, const char *k, int v) { (void)c; (void)s; (void)k; (void)v; config_writes++; }
+static void config_str(rss_config_t *c, const char *s, const char *k, const char *v) { (void)c; (void)s; (void)k; (void)v; config_writes++; }
+#define open forbidden_open
+#define write forbidden_write
+#define unlink forbidden_unlink
+#define rename forbidden_rename
+#define fopen forbidden_fopen
+#define rss_config_set_int config_int
+#define rss_config_set_str config_str
+#include "../rvd/rvd_ctrl.c"
+#undef open
+#undef write
+#undef unlink
+#undef rename
+#undef fopen
+#undef rss_config_set_int
+#undef rss_config_set_str
+static int stop_index, start_index, stops[8], stop_count, inits, deinits, starts, ivs_calls;
+int rvd_stream_stop(rvd_state_t *st, int idx) {
+    assert(stop_count < 8); stops[stop_count++]=idx;
+    atomic_store(&st->stream_active[idx],false);
+    return idx==stop_index ? -9 : 0;
+}
+int rvd_stream_init(rvd_state_t *st, int idx) { (void)st; (void)idx; inits++; return 0; }
+void rvd_stream_deinit(rvd_state_t *st, int idx) { (void)st; (void)idx; deinits++; }
+int rvd_stream_start(rvd_state_t *st, int idx) { (void)st; starts++; return idx==start_index ? -8 : 0; }
+int rvd_ivs_set_enabled(rvd_state_t *st, bool enabled) { (void)st; (void)enabled; ivs_calls++; return 0; }
+void rvd_ivs_pause(rvd_state_t *st) { (void)st; ivs_calls++; }
+void rvd_ivs_resume(rvd_state_t *st) { (void)st; ivs_calls++; }
+void *rvd_ivs_thread(void *arg) { (void)arg; assert(0); return NULL; }
+rvd_osd_region_t *rvd_osd_find_region(rvd_state_t *s,int i,const char *n) { (void)s; (void)i; (void)n; assert(0); return NULL; }
+void rvd_osd_calc_position(int a,int b,int c,int d,const char *s,int *x,int *y) { (void)a;(void)b;(void)c;(void)d;(void)s;(void)x;(void)y;assert(0); }
+int rvd_osd_apply_snapshot(rvd_state_t *s,const char *j,char *r,int n) { (void)s;(void)j;(void)r;(void)n;assert(0);return -1; }
+int rvd_osd_apply_state(rvd_state_t *s,char *r,int n) { (void)s;(void)r;(void)n;assert(0);return -1; }
+rss_ring_t *rss_ring_open(const char *n) { (void)n; assert(0);return NULL; }
+void rss_ring_close(rss_ring_t *r) { (void)r;assert(0); }
+void rss_ring_acquire(rss_ring_t *r) { (void)r;assert(0); }
+void rss_ring_release(rss_ring_t *r) { (void)r;assert(0); }
+const rss_ring_header_t *rss_ring_get_header(rss_ring_t *r) { (void)r;assert(0);return NULL; }
+uint32_t rss_ring_max_frame_size(rss_ring_t *r) { (void)r;assert(0);return 0; }
+int rss_ring_wait(rss_ring_t *r,uint32_t ms) { (void)r;(void)ms;assert(0);return -1; }
+int rss_ring_read(rss_ring_t *r,uint64_t *seq,uint8_t *d,uint32_t n,uint32_t *l,rss_ring_slot_t *m) { (void)r;(void)seq;(void)d;(void)n;(void)l;(void)m;assert(0);return -1; }
+static int forbidden_fs(void *ctx,int ch,const rss_fs_config_t *cfg) { (void)ctx;(void)ch;(void)cfg;assert(0);return -1; }
+static rvd_state_t st;
+static void reset(void) {
+    memset(&st,0,sizeof(st)); static const rss_hal_ops_t ops={.fs_set_channel_attr=forbidden_fs};
+    st.ops=&ops; st.stream_count=2; st.jpeg_count=1; st.jpeg_streams[0]=1;
+    st.streams[1].is_jpeg=true; st.ivs_fs_chn=99;
+    st.streams[0].enc_cfg.codec=RSS_CODEC_H264;
+    st.streams[0].enc_cfg.width=640; st.streams[0].enc_cfg.height=360;
+    st.streams[1].enc_cfg.init_qp=50;
+    st.streams[0].ring=st.streams[1].ring=(rss_ring_t *)(uintptr_t)1;
+    stop_index=start_index=-1; stop_count=inits=deinits=starts=ivs_calls=config_writes=0;
+}
+int main(void) {
+    char resp[256];
+    const char *commands[]={"stream-restart","set-codec","stream-stop","set-resolution","osd-restart"};
+    const char *args[]={"{\"channel\":0}","{\"channel\":0,\"value\":\"h265\"}","{\"channel\":0}",
+        "{\"channel\":0,\"width\":320,\"height\":240}","{\"font_size\":20,\"pool_kb\":256}"};
+    for (size_t cmd=0; cmd<sizeof(commands)/sizeof(commands[0]); cmd++) {
+        for (int fail=0; fail<2; fail++) {
+            reset(); stop_index=fail;
+            assert(handle_pipeline_cmd(commands[cmd],args[cmd],&st,resp,sizeof(resp))>0);
+            assert(strstr(resp,"\"status\":\"error\""));
+            assert(stop_count==(fail ? 1 : 2) && stops[0]==1);
+            if (!fail) assert(stops[1]==0);
+            assert(inits==0 && deinits==0 && starts==0 && config_writes==0);
+            assert(st.streams[0].enc_cfg.width==640 && st.streams[0].enc_cfg.height==360);
+            assert(st.streams[0].enc_cfg.codec==RSS_CODEC_H264 && st.osd_pool_override==0);
+            /* run=false after the failed stop must not hide a second request. */
+            if (strcmp(commands[cmd],"stream-stop")==0) {
+                stop_count=0; stop_index=-1;
+                assert(handle_pipeline_cmd(commands[cmd],args[cmd],&st,resp,sizeof(resp))>0);
+                assert(strstr(resp,"\"status\":\"ok\"") && stop_count==2);
+            }
+        }
+    }
+    reset(); stop_index=1;
+    assert(handle_pipeline_cmd("set-jpeg-quality","{\"channel\":1,\"value\":80}",&st,resp,sizeof(resp))>0);
+    assert(strstr(resp,"stop failed") && stops[0]==1 && stop_count==1);
+    assert(inits==0 && deinits==0 && starts==0 && config_writes==0 && st.streams[1].enc_cfg.init_qp==50);
+    for (int fail=0; fail<2; fail++) {
+        reset(); start_index=fail;
+        assert(handle_pipeline_cmd("stream-start","{\"channel\":0}",&st,resp,sizeof(resp))>0);
+        assert(strstr(resp,"start failed") && starts==fail+1 && ivs_calls==0);
+    }
+#if defined(PLATFORM_T20)
+    reset(); st.ivs_fs_chn=0; atomic_store(&st.ivs_active,true);
+    st.ivs_tid=(pthread_t)(uintptr_t)1;
+    atomic_store(&st.stream_active[0],true); atomic_store(&st.stream_active[1],true);
+    rvd_state_t before=st;
+    assert(handle_pipeline_cmd("save","{\"format\":\"bayer\",\"file\":\"/never-write.raw\"}",&st,resp,sizeof(resp))>0);
+    assert(strstr(resp,"T20 bayer capture unsupported"));
+    assert(memcmp(&st,&before,sizeof(st))==0);
+    assert(ivs_calls==0 && stop_count==0 && inits==0 && deinits==0 && starts==0 && config_writes==0);
+#endif
+    puts("control stop failure gates, explicit retry, start errors and T20 restriction passed");
+    return 0;
+}
diff --git a/tests/test_timezone.c b/tests/test_timezone.c
new file mode 100644
index 0000000000000000000000000000000000000000..205f2282f6511c0a167b443f6c2ec61b6df6f906
--- /dev/null
+++ b/tests/test_timezone.c
@@ -0,0 +1,189 @@
+#include "rss_common.h"
+#include "rod.h"
+#include <assert.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdlib.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/statvfs.h>
+#include <sys/un.h>
+#include <time.h>
+#include <unistd.h>
+
+static time_t fixed_time(time_t *out)
+{
+    time_t value = 1768478400;
+    if (out)
+        *out = value;
+    return value;
+}
+
+static int fixed_clock(clockid_t clock, struct timespec *out)
+{
+    (void)clock;
+    out->tv_sec = fixed_time(NULL);
+    out->tv_nsec = 0;
+    return 0;
+}
+
+#define time fixed_time
+#define clock_gettime fixed_clock
+#include "../rod/rod_template.c"
+#include "../rmr/rmr_storage.c"
+#undef time
+#undef clock_gettime
+
+static const char *helsinki = "EET-2EEST,M3.5.0/3,M10.5.0/4";
+static const char *zone_path;
+static rss_config_t *config;
+
+static void write_zone(const char *rule)
+{
+    FILE *file = fopen(zone_path, "w");
+    assert(file);
+    assert(fprintf(file, "%s\n", rule) > 0);
+    assert(fclose(file) == 0);
+}
+
+static cJSON *command(const char *request, bool success)
+{
+    char response[4096];
+    assert(rss_timezone_command(request, config, response, sizeof(response)) > 0);
+    cJSON *root = cJSON_Parse(response);
+    const cJSON *status = cJSON_GetObjectItemCaseSensitive(root, "status");
+    assert(cJSON_IsString(status));
+    assert((strcmp(status->valuestring, "ok") == 0) == success);
+    return root;
+}
+
+static void reload(const char *rule, bool success)
+{
+    char request[512];
+    snprintf(request, sizeof(request), "{\"cmd\":\"timezone-reload\",\"expected_rule\":\"%s\"}", rule);
+    cJSON_Delete(command(request, success));
+}
+
+static void *format_loop(void *unused)
+{
+    (void)unused;
+    for (int i = 0; i < 10000; ++i) {
+        char value[128];
+        const time_t now = 1768478400;
+        assert(rss_format_localtime(value, sizeof(value), "%Y-%m-%d %H:%M:%S %z %Z", &now));
+        assert(strcmp(value, "2026-01-15 12:00:00 +0000 UTC") == 0 ||
+               strcmp(value, "2026-01-15 14:00:00 +0200 EET") == 0);
+    }
+    return NULL;
+}
+
+static void check_participant_inventory(void)
+{
+    rss_config_set_bool(config, "recording", "enabled", true);
+    cJSON *root = command("{\"cmd\":\"timezone-status\"}", true);
+    const cJSON *required = cJSON_GetObjectItemCaseSensitive(root, "required");
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(required, "rmr")));
+    cJSON_Delete(root);
+    rss_config_set_bool(config, "recording", "enabled", false);
+
+    struct sockaddr_un address = {.sun_family = AF_UNIX};
+    assert(snprintf(address.sun_path, sizeof(address.sun_path), RSS_TIMEZONE_RUN_DIR "/rmr.sock") < (int)sizeof(address.sun_path));
+    int socket_fd = socket(AF_UNIX, SOCK_STREAM, 0);
+    assert(socket_fd >= 0);
+    assert(bind(socket_fd, (const struct sockaddr *)&address, sizeof(address)) == 0);
+    root = command("{\"cmd\":\"timezone-status\"}", true);
+    required = cJSON_GetObjectItemCaseSensitive(root, "required");
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(required, "rmr")));
+    cJSON_Delete(root);
+    close(socket_fd);
+    assert(unlink(address.sun_path) == 0);
+
+    FILE *file = fopen(address.sun_path, "w");
+    assert(file);
+    assert(fclose(file) == 0);
+    cJSON_Delete(command("{\"cmd\":\"timezone-status\"}", false));
+    assert(unlink(address.sun_path) == 0);
+}
+
+int main(int argc, char **argv)
+{
+    assert(argc == 4);
+    zone_path = argv[1];
+    FILE *file = fopen(argv[2], "w");
+    assert(file);
+    fputs("[rtsp]\nenabled=false\n[http]\nenabled=false\n[audio]\nenabled=false\n[ircut]\nenabled=false\n[osd]\nenabled=false\n", file);
+    fclose(file);
+    config = rss_config_load(argv[2]);
+    assert(config);
+    write_zone("UTC0");
+    reload("UTC0", true);
+    reload(helsinki, false);
+    assert(strcmp(getenv("TZ"), "UTC0") == 0);
+    cJSON_Delete(command("{\"cmd\":\"timezone-reload\",\"expected_rule\":\"UTC0\",\"extra\":true}", false));
+    write_zone(helsinki);
+    reload(helsinki, true);
+    cJSON *root = command("{\"cmd\":\"timezone-status\"}", true);
+    assert(strcmp(cJSON_GetObjectItemCaseSensitive(root, "january")->valuestring, "2026-01-15T14:00:00+0200 EET") == 0);
+    assert(strcmp(cJSON_GetObjectItemCaseSensitive(root, "july")->valuestring, "2026-07-15T15:00:00+0300 EEST") == 0);
+    const cJSON *required = cJSON_GetObjectItemCaseSensitive(root, "required");
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(required, "rvd")));
+    assert(cJSON_IsFalse(cJSON_GetObjectItemCaseSensitive(required, "rmr")));
+    cJSON_Delete(root);
+    check_participant_inventory();
+
+    rod_state_t rod = {0};
+    rss_strlcpy(rod.settings.time_format, "%H:%M %Z", sizeof(rod.settings.time_format));
+    char overlay[128];
+    assert(rod_expand_template(&rod, "%time%", overlay, sizeof(overlay)) > 0);
+    assert(strcmp(overlay, "14:00 EET") == 0);
+    rmr_storage_config_t storage_config = {.base_path = argv[3]};
+    rmr_storage_t *storage = rmr_storage_create(&storage_config);
+    assert(storage);
+    char first[512], second[512];
+    int fd = rmr_storage_open_segment(storage, first, sizeof(first));
+    assert(fd >= 0 && strstr(first, "/2026-01-15/14-00-00.mp4"));
+    assert(write(fd, "keep", 4) == 4);
+    close(fd);
+    write_zone("UTC0");
+    reload("UTC0", true);
+    assert(rod_expand_template(&rod, "%time%", overlay, sizeof(overlay)) > 0);
+    assert(strcmp(overlay, "12:00 UTC") == 0);
+    fd = rmr_storage_open_segment(storage, second, sizeof(second));
+    assert(fd >= 0 && strstr(second, "/2026-01-15/12-00-00.mp4"));
+    close(fd);
+    write_zone(helsinki);
+    reload(helsinki, true);
+    fd = rmr_storage_open_segment(storage, second, sizeof(second));
+    assert(fd >= 0 && strstr(second, "14-00-00-001.mp4"));
+    close(fd);
+    fd = open(first, O_RDONLY);
+    char saved[4];
+    assert(fd >= 0 && read(fd, saved, sizeof(saved)) == 4 && memcmp(saved, "keep", 4) == 0);
+    close(fd);
+    rmr_storage_destroy(storage);
+
+    assert(unlink(zone_path) == 0);
+    assert(symlink(argv[2], zone_path) == 0);
+    reload(helsinki, false);
+    assert(unlink(zone_path) == 0);
+    assert(mkfifo(zone_path, 0600) == 0);
+    reload(helsinki, false);
+    assert(unlink(zone_path) == 0);
+    write_zone("UTC0\nextra");
+    reload("UTC0", false);
+    write_zone("UTC0");
+    reload("UTC0", true);
+    pthread_t thread;
+    assert(pthread_create(&thread, NULL, format_loop, NULL) == 0);
+    for (int i = 0; i < 100; ++i) {
+        const char *rule = i % 2 ? "UTC0" : helsinki;
+        write_zone(rule);
+        reload(rule, true);
+    }
+    assert(pthread_join(thread, NULL) == 0);
+    rss_config_free(config);
+    puts("Timezone reload, DST probes, OSD, recording collision and concurrent formatting passed");
+    return 0;
+}
