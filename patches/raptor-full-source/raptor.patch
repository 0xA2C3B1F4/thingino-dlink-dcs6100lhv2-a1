+void rss_daemon_request_shutdown(void) { shutdowns++; }
+int rvd_ivs_stop(rvd_state_t *state) { (void)state; event("ivs-stop"); return 0; }
+void rvd_osd_deinit_stream(rvd_state_t *state, int idx) { (void)state; (void)idx; destroys++; }
+void rss_hal_destroy(rss_hal_ctx_t *ctx) { (void)ctx; destroys++; }
+void rss_ring_destroy(rss_ring_t *ring) { (void)ring; destroys++; }
+uint32_t rss_ring_reader_count(rss_ring_t *ring) { (void)ring; return readers; }
+uint32_t rss_ring_reap_dead_readers(rss_ring_t *ring) { (void)ring; return 0; }
+const rss_ring_header_t *rss_ring_get_header(rss_ring_t *ring) { (void)ring; return &header; }
+int rss_ring_check_idr(rss_ring_t *ring) { (void)ring; return 0; }
+void rss_ring_set_utc(rss_ring_t *ring, int64_t off, uint8_t status) { (void)ring; (void)off; (void)status; }
+int rss_ring_publish_iov(rss_ring_t *r, const rss_iov_t *v, uint32_t n, int64_t t, uint16_t type, uint8_t key) {
+    (void)r; (void)v; (void)n; (void)t; (void)type; (void)key; event("publish"); return 0;
+}
+int rss_ring_publish_ref(rss_ring_t *r, uint32_t off, uint32_t len, int64_t t, uint16_t type, uint8_t key, uint8_t idx) {
+    (void)r; (void)off; (void)len; (void)t; (void)type; (void)key; (void)idx; assert(0); return 0;
+}
+static const rss_hal_caps_t *caps(void *ctx) { (void)ctx; static rss_hal_caps_t c; c.jpeg_pulse = pulse_mode; return &c; }
+static int poll_frame(void *ctx, int ch, uint32_t ms) { (void)ctx; (void)ch; (void)ms; assert(++polls < 3); event("poll"); return 0; }
+static int get_frame(void *ctx, int ch, rss_frame_t *f) { (void)ctx; (void)ch; memset(f,0,sizeof(*f)); event("get"); return 0; }
+static int release_frame(void *ctx, int ch, rss_frame_t *f) {
+    (void)ctx; (void)ch; (void)f; event("release");
+    if (stop_after_frame) atomic_store(&st.stream_active[0],false);
+    return 0;
+}
+int rvd_ivs_start(rvd_state_t *s) { (void)s;assert(0);return -1; }
+void *rvd_ivs_thread(void *arg) { (void)arg;assert(0);return NULL; }
+void *rvd_osd_thread(void *arg) { (void)arg;assert(0);return NULL; }
+int rvd_ctrl_handler(const char *j,char *r,int n,void *u) { (void)j;(void)r;(void)n;(void)u;assert(0);return -1; }
+int rss_ctrl_get_fd(rss_ctrl_t *c) { (void)c;assert(0);return -1; }
+int rss_ctrl_accept_and_handle(rss_ctrl_t *c,int (*h)(const char *,char *,int,void *),void *u) { (void)c;(void)h;(void)u;assert(0);return -1; }
+static rss_hal_ops_t ops = {.fs_enable_channel=fs_enable,.fs_disable_channel=fs_disable,
+    .enc_start=enc_start,.enc_stop=enc_stop,.get_caps=caps,.enc_poll=poll_frame,
+    .enc_get_frame=get_frame,.enc_release_frame=release_frame};
+static void reset(void) {
+    memset(&st,0,sizeof(st)); memset(&header,0,sizeof(header)); trace[0]=0;
+    st.ops=&ops; st.stream_count=1; st.running=&running;
+    st.streams[0].ring=(rss_ring_t *)(uintptr_t)1;
+    st.enc_shm_fd[0]=-1;
+    join_error=create_error=attr_error=size_error=fs_enable_error=fs_disable_error=0;
+    enc_start_error=enc_stop_error=privacy_error=shutdowns=destroys=polls=0;
+    readers=0; pulse_mode=stop_after_frame=false; create_calls=fail_create_call=0;
+}
+static void owned(void) {
+    reset(); st.enc_tids[0]=(pthread_t)(uintptr_t)1;
+    st.streams[0].enabled=st.streams[0].fs_enabled=true;
+    atomic_store(&st.stream_active[0],true);
+}
+static void expect(const char *s) { assert(strcmp(trace,s)==0); }
+static void worker(void) {
+    st.streams[0].is_jpeg=st.streams[0].jpeg_idle=true;
+    st.streams[0].enc_cfg.fps_num=1; st.streams[0].enc_cfg.fps_den=1;
+    st.enc_tids[0]=(pthread_t)(uintptr_t)1;
+    atomic_store(&st.stream_active[0],true);
+    rvd_enc_thread_arg_t a={.st=&st,.idx=0}; rvd_encoder_thread(&a);
+    assert(!atomic_load(&st.stream_active[0]));
+}
+int main(void) {
+	int ctrl_error = 0;
+	report_ctrl_result(0, &ctrl_error);
+	assert(ctrl_error == 0 && log_count == 0);
+	report_ctrl_result(-ENOMEM, &ctrl_error);
+	assert(ctrl_error == -ENOMEM && log_count == 1 && last_log_level == RSS_LOG_WARN);
+	assert(strstr(last_log, "control request failed") && strstr(last_log, "-12"));
+	report_ctrl_result(-ENOMEM, &ctrl_error);
+	assert(log_count == 1);
