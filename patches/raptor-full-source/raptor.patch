diff --git a/tests/rwd_sdp_direction_shim.h b/tests/rwd_sdp_direction_shim.h
new file mode 100644
index 0000000000000000000000000000000000000000..9ff189365a4b0422f8166b1eb93fea9cbef19547
--- /dev/null
+++ b/tests/rwd_sdp_direction_shim.h
@@ -0,0 +1,96 @@
+/*
+ * Host-only shim for the complete rwd_sdp.c parser and answer generator.
+ *
+ * Keep this independent from rwd.h: that header pulls in compy and mbedTLS,
+ * while this test only needs the fields touched by rwd_sdp.c.
+ */
+#ifndef RWD_SDP_DIRECTION_SHIM_H
+#define RWD_SDP_DIRECTION_SHIM_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <stdbool.h>
+#include <string.h>
+#include <sys/time.h>
+
+#define RWD_H 1
+#define RWD_MAX_CANDIDATES 16
+#define RWD_CODEC_PCMU 0
+#define RWD_CODEC_PCMA 8
+#define RWD_CODEC_L16 11
+#define RWD_CODEC_AAC 97
+#define RWD_CODEC_OPUS 111
+#define ICE_PRIORITY_SRFLX ((100u << 24) | (65535u << 8) | 255u)
+
+static inline size_t rss_strlcpy(char *dst, const char *src, size_t size)
+{
+	size_t length = strlen(src);
+	if (size != 0) {
+		size_t copy = length < size - 1 ? length : size - 1;
+		memcpy(dst, src, copy);
+		dst[copy] = '\0';
+	}
+	return length;
+}
+
+static inline int64_t rss_timestamp_us(void)
+{
+	struct timeval tv;
+	gettimeofday(&tv, NULL);
+	return (int64_t)tv.tv_sec * 1000000 + tv.tv_usec;
+}
+
+#define RSS_WARN(...) ((void)0)
+#define RSS_DEBUG(...) ((void)0)
+
+typedef struct {
+	char ice_ufrag[64];
+	char ice_pwd[256];
+	char fingerprint[256];
+	char setup[16];
+	int video_pt;
+	char video_fmtp[256];
+	int audio_pt;
+	bool has_pcmu;
+	bool has_pcma;
+	char audio_direction[9];
+	char mid_video[16];
+	char mid_audio[16];
+	int mid_ext_id;
+	bool has_video;
+	bool has_audio;
+	struct {
+		char ip[64];
+		uint16_t port;
+	} candidates[RWD_MAX_CANDIDATES];
+	int candidate_count;
+} rwd_sdp_offer_t;
+
+typedef struct {
+	char fingerprint[128];
+} rwd_dtls_ctx_t;
+
+typedef struct rwd_client {
+	rwd_sdp_offer_t offer;
+	char local_ufrag[16];
+	char local_pwd[32];
+	uint32_t video_ssrc;
+	uint32_t audio_ssrc;
+} rwd_client_t;
+
+typedef struct rwd_server {
+	char local_ip[64];
+	int udp_port;
+	rwd_dtls_ctx_t *dtls;
+	int wire_codec;
+	int wire_pt;
+	bool has_srflx;
+	char srflx_ip[64];
+	uint16_t srflx_port;
+} rwd_server_t;
+
+int rwd_sdp_parse_offer(const char *sdp, rwd_sdp_offer_t *offer);
+int rwd_sdp_generate_answer(rwd_client_t *client, const rwd_server_t *server,
+				    char *buf, size_t buf_size);
+
+#endif
