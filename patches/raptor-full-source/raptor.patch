+static void add_output(cJSON *root, const char *name, bool supported, bool available, bool enabled)
+{
+    cJSON *output = cJSON_AddObjectToObject(root, name);
+    cJSON_AddBoolToObject(output, "supported", supported);
+    cJSON_AddBoolToObject(output, "available", available);
+    if (available)
+        cJSON_AddBoolToObject(output, "enabled", enabled);
+    else
+        cJSON_AddNullToObject(output, "enabled");
+}
+
+int ric_output_command(ric_state_t *st, const char *json, char *response, int size)
+{
+    cJSON *request = cJSON_ParseWithOpts(json, NULL, true);
+    const cJSON *cmd = cJSON_GetObjectItemCaseSensitive(request, "cmd");
+    bool get = cJSON_IsString(cmd) && strcmp(cmd->valuestring, "get-output-state") == 0;
+    bool set = cJSON_IsString(cmd) && strcmp(cmd->valuestring, "set-output") == 0;
+    if (!cJSON_IsObject(request) || (!get && !set) ||
+        cJSON_GetArraySize(request) != (set ? 3 : 1)) {
+        cJSON_Delete(request);
+        return rss_ctrl_resp_error(response, size, "invalid output request");
+    }
+    if (set) {
+        const cJSON *output = cJSON_GetObjectItemCaseSensitive(request, "output");
+        const cJSON *enabled = cJSON_GetObjectItemCaseSensitive(request, "enabled");
+        bool filter = cJSON_IsString(output) && strcmp(output->valuestring, "ircut") == 0;
+        bool led = cJSON_IsString(output) && strcmp(output->valuestring, "ir850") == 0;
+        if ((!filter && !led) || !cJSON_IsBool(enabled) || !gpio_ready(st) ||
+            (led && st->settings.gpio_irled < 0)) {
+            cJSON_Delete(request);
+            return rss_ctrl_resp_error(response, size, "output unavailable or invalid");
+        }
+        bool on = cJSON_IsTrue(enabled);
+        bool ok;
+        if (filter) {
+            ok = filter_available(st) && st->filter_day == on;
+            if (!ok) {
+                st->filter_state_known = false;
+                ok = true;
+                if (st->settings.gpio_ircut2 >= 0) {
+                    ok = gpio_set(st->settings.gpio_ircut, 0);
+                    ok &= gpio_set(st->settings.gpio_ircut2, 0);
+                }
+                if (ok)
+                    ok = set_filter(st, on ? RIC_MODE_DAY : RIC_MODE_NIGHT);
+            }
+            if (ok)
+                st->filter_manual = true;
+        } else {
+            ok = gpio_set(st->settings.gpio_irled, on) &&
+                gpio_read(st->settings.gpio_irled, "value", on ? "1" : "0");
+            if (ok) {
+                st->ir850_manual = true;
+                st->ir850_manual_on = on;
+            }
+        }
+        if (!ok) {
+            cJSON_Delete(request);
+            return rss_ctrl_resp_error(response, size, "output application failed");
+        }
+    }
+    cJSON_Delete(request);
+    cJSON *result = cJSON_CreateObject();
+    cJSON_AddStringToObject(result, "status", "ok");
+    bool ready = gpio_ready(st);
+    bool led_supported = gpio_config_valid(st) && st->settings.gpio_irled >= 0;
+    bool led_on = ready && led_supported && gpio_read(st->settings.gpio_irled, "value", "1");
+    bool led_available = led_on || (ready && led_supported &&
+        gpio_read(st->settings.gpio_irled, "value", "0"));
+    /* A latching filter has no position sensor. Report a completed command,
+     * with released coils, rather than infer its position from the GPIOs. */
+    add_output(result, "ircut", gpio_config_valid(st),
+        filter_available(st), st->filter_day);
+    add_output(result, "ir850", led_supported, led_available, led_on);
+    return rss_ctrl_resp_json(response, size, result);
+}
+
+static bool apply_mode(ric_state_t *st, ric_mode_t mode, bool automatic)
+{
+    if ((mode != RIC_MODE_DAY && mode != RIC_MODE_NIGHT) || !gpio_ready(st))
+        return false;
+    st->mode_confirmed = false;
+	if (!automatic || st->settings.auto_ircut)
+		st->filter_manual = false;
+	st->ir850_manual = false;
+	const ric_config_t *c = &st->settings;
+	bool change_filter = !automatic || c->auto_ircut;
+	bool change_color = !automatic || c->auto_color;
+	if (change_filter && c->gpio_ircut2 >= 0) {
+        /* Retry a previous failed release before ISP or illumination can fail. */
+        bool released = gpio_set(c->gpio_ircut, 0);
+        released &= gpio_set(c->gpio_ircut2, 0);
+        if (!released)
+            return false;
+    }
+    bool ok;
+	if (mode == RIC_MODE_NIGHT)
+		ok = (!change_color || ric_set_isp_mode(mode)) &&
+			(!change_filter || set_filter(st, mode)) && set_lights(st, true);
+	else
+		ok = set_lights(st, false) && (!change_filter || set_filter(st, mode)) &&
+			(!change_color || ric_set_isp_mode(mode));
+    if (!ok)
+        return false;
+    st->current_mode = mode;
+    st->current_mode_automatic = automatic;
+    st->mode_confirmed = true;
+    if (!ric_verify_mode(st)) {
+        st->mode_confirmed = false;
+        return false;
+    }
+    st->day_count = 0;
+    st->night_count = 0;
+    st->day_condition_since_us = 0;
+    st->night_condition_since_us = 0;
+    st->cooldown_remaining = 3;
+    if (mode == RIC_MODE_DAY)
+        st->night_gain_baseline = 0;
+    return true;
+}
+
+bool ric_apply_mode(ric_state_t *st, ric_mode_t mode)
+{
+	return apply_mode(st, mode, false);
+}
+
+bool ric_apply_automatic_mode(ric_state_t *st, ric_mode_t mode)
+{
+	return apply_mode(st, mode, true);
+}
+
+void ric_set_mode(ric_state_t *st, ric_mode_t mode)
+{
+    if (mode == st->current_mode && st->mode_confirmed)
+        return;
+    if (!ric_apply_automatic_mode(st, mode))
+        RSS_WARN("day/night transition was not confirmed");
