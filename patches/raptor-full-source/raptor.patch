diff --git a/tests/test_daynight_settings.c b/tests/test_daynight_settings.c
new file mode 100644
index 0000000000000000000000000000000000000000..c188ebe7e088d0304c9add267b06863714cfb46d
--- /dev/null
+++ b/tests/test_daynight_settings.c
@@ -0,0 +1,1551 @@
+#include "ric.h"
+#include <assert.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <math.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/ioctl.h>
+
+static int pins[256];
+static int zero_attempts[256];
+static int pulses;
+static int isp_sets, isp_gets;
+static int writes, fail_write, isp_write_at;
+static bool bad_direction, fail_isp, stale_isp, bad_ack;
+static ric_mode_t isp_mode;
+static int64_t test_now_us = 1000000;
+static uint32_t exposure_gain, exposure_luma;
+static bool exposure_error, exposure_missing_gain;
+static const char *exposure_response_override;
+static int exposure_return_override = -1;
+static unsigned exposure_calls, gain_pushes;
+static char last_gain_request[128];
+static bool gain_demand = true;
+
+static int test_open(const char *path, int flags, ...)
+{
+    int pin = -1;
+    char field[32];
+    (void)flags;
+    if (sscanf(path, "/sys/class/gpio/gpio%d/%31s", &pin, field) != 2 || pin < 0 || pin > 255)
+        return -1;
+    if (strcmp(field, "value") != 0 && strcmp(field, "direction") != 0)
+        return -1;
+    return 10 + pin * 2 + (strcmp(field, "direction") == 0);
+}
+
+static ssize_t test_read(int fd, void *out, size_t size)
+{
+    int pin = (fd - 10) / 2;
+    const char *value = (fd - 10) % 2 ? (bad_direction ? "in\n" : "out\n") :
+        (pins[pin] ? "1\n" : "0\n");
+    size_t length = strlen(value);
+    assert(length <= size);
+    memcpy(out, value, length);
+    return (ssize_t)length;
+}
+
+static ssize_t test_write(int fd, const void *input, size_t size)
+{
+    int pin = (fd - 10) / 2;
+    assert((fd - 10) % 2 == 0 && size == 1);
+    writes++;
+    if (*(const char *)input == '0')
+        zero_attempts[pin]++;
+    if (writes == fail_write)
+        return -1;
+    pins[pin] = *(const char *)input == '1';
+    return 1;
+}
+
+static int test_close(int fd)
+{
+    assert(fd >= 10);
+    return 0;
+}
+
+static int test_sleep(useconds_t delay)
+{
+    assert(delay == 100000);
+    assert(pins[1] != pins[2]);
+    pulses++;
+    return 0;
+}
+
+int rss_ctrl_send_command(const char *path, const char *command, char *response,
+                          int size, uint32_t timeout)
+{
+    if (strcmp(path, RSS_RUN_DIR "/rod.sock") == 0) {
+        assert(timeout == 50);
+        if (strstr(command, "get-gain-demand"))
+            return snprintf(response, (size_t)size,
+                            "{\"status\":\"ok\",\"needed\":%s}",
+                            gain_demand ? "true" : "false");
+        gain_pushes++;
+        snprintf(last_gain_request, sizeof(last_gain_request), "%s", command);
+        return snprintf(response, (size_t)size, "{\"status\":\"ok\"}");
+    }
+    assert(strcmp(path, RSS_RUN_DIR "/rvd.sock") == 0);
+    if (strstr(command, "get-exposure")) {
+        assert(timeout == 1000);
+        exposure_calls++;
+        if (exposure_response_override) {
+            int length = snprintf(response, (size_t)size, "%s", exposure_response_override);
+            return exposure_return_override >= 0 ? exposure_return_override : length;
+        }
+        if (exposure_error)
+            return snprintf(response, (size_t)size, "{\"status\":\"error\",\"error\":\"isp\"}");
+        if (exposure_missing_gain)
+            return snprintf(response, (size_t)size,
+                "{\"status\":\"ok\",\"ae_luma\":%u,\"ev\":0,\"wb_rgain\":0,\"wb_bgain\":0}",
+                exposure_luma);
+        return snprintf(response, (size_t)size,
+            "{\"status\":\"ok\",\"total_gain\":%u,\"ae_luma\":%u,\"ev\":0,\"wb_rgain\":0,\"wb_bgain\":0}",
+            exposure_gain, exposure_luma);
+    }
+    assert(timeout == 500);
+    if (strstr(command, "set-running-mode")) {
+        isp_sets++;
+        isp_write_at = writes;
+        if (fail_isp)
+            return snprintf(response, (size_t)size, "{\"status\":\"error\"}");
+        isp_mode = strstr(command, "night") ? RIC_MODE_NIGHT : RIC_MODE_DAY;
+    }
+    if (strstr(command, "get-running-mode"))
+        isp_gets++;
+    if (bad_ack) {
+        memcpy(response, "{\"status\":\"ok\"}\0suffix", 23);
+        return 22;
+    }
+    ric_mode_t observed = isp_mode;
+    if (stale_isp && strstr(command, "get-running-mode"))
+        observed = isp_mode == RIC_MODE_NIGHT ? RIC_MODE_DAY : RIC_MODE_NIGHT;
+    return snprintf(response, (size_t)size, "{\"status\":\"ok\",\"mode\":\"%s\"}",
+                    observed == RIC_MODE_NIGHT ? "night" : "day");
+}
+
+/* Compile the actual GPIO/ISP implementation with host-only I/O doubles. */
+static int64_t test_timestamp_us(void) { return test_now_us; }
+#define rss_timestamp_us test_timestamp_us
+#define open test_open
+#define read test_read
+#define write test_write
+#define close test_close
+#define usleep test_sleep
+#include "../ric/ric_daynight.c"
+#undef open
+#undef read
+#undef write
+#undef close
+#undef usleep
+#undef rss_timestamp_us
+
+static void set_policy(ric_state_t *st, const char *mode, bool success)
+{
+    char request[128], response[512];
+    snprintf(request, sizeof(request), "{\"cmd\":\"set-daynight-settings\",\"mode\":\"%s\"}", mode);
+    assert(ric_set_settings(st, request, response, sizeof(response)) > 0);
+    cJSON *root = cJSON_Parse(response);
+    const cJSON *status = cJSON_GetObjectItemCaseSensitive(root, "status");
+    assert(cJSON_IsString(status));
+    assert((strcmp(status->valuestring, "ok") == 0) == success);
+    cJSON_Delete(root);
+}
+
+static void settings_request(ric_state_t *st, const char *request, bool success)
+{
+    char response[4096];
+    assert(ric_set_settings(st, request, response, sizeof(response)) > 0);
+    cJSON *root = cJSON_Parse(response);
+    const cJSON *status = cJSON_GetObjectItemCaseSensitive(root, "status");
+    assert(cJSON_IsString(status));
+    if ((strcmp(status->valuestring, "ok") == 0) != success)
+        fprintf(stderr, "unexpected timing reply for %s: %s\n", request, response);
+    assert((strcmp(status->valuestring, "ok") == 0) == success);
+    cJSON_Delete(root);
+}
+
+static void initial_mode_request(ric_state_t *st, const char *value, bool success)
+{
+    char request[160], response[512];
+    snprintf(request, sizeof(request),
+        "{\"cmd\":\"set-daynight-initial-mode\",\"value\":\"%s\"}", value);
+    assert(ric_set_initial_mode(st, request, response, sizeof(response)) > 0);
+    cJSON *root = cJSON_Parse(response);
+    const cJSON *status = cJSON_GetObjectItemCaseSensitive(root, "status");
+    assert(cJSON_IsString(status));
+    assert((strcmp(status->valuestring, "ok") == 0) == success);
+    cJSON_Delete(root);
+}
+
+static void test_initial_mode(ric_state_t *st, const char *path)
+{
+    ric_initial_mode_t parsed;
+    assert(ric_initial_mode_parse("default", &parsed) && parsed == RIC_INITIAL_DEFAULT);
+    assert(ric_initial_mode_parse("day", &parsed) && parsed == RIC_INITIAL_DAY);
+    assert(ric_initial_mode_parse("night", &parsed) && parsed == RIC_INITIAL_NIGHT);
+    assert(!ric_initial_mode_parse("", &parsed));
+    assert(!ric_initial_mode_parse("auto", &parsed));
+
+    st->settings.opmode = RIC_AUTO;
+    st->settings.initial_mode = RIC_INITIAL_DEFAULT;
+    assert(ric_startup_target(&st->settings) == RIC_MODE_DAY);
+    st->settings.initial_mode = RIC_INITIAL_NIGHT;
+    assert(ric_startup_target(&st->settings) == RIC_MODE_NIGHT);
+    st->settings.opmode = RIC_FORCE_DAY;
+    assert(ric_startup_target(&st->settings) == RIC_MODE_DAY);
+    st->settings.initial_mode = RIC_INITIAL_DAY;
+    st->settings.opmode = RIC_FORCE_NIGHT;
+    assert(ric_startup_target(&st->settings) == RIC_MODE_NIGHT);
+
+    st->settings.opmode = RIC_AUTO;
+    st->settings.initial_mode = RIC_INITIAL_DEFAULT;
+    st->boot_initial_mode = RIC_INITIAL_DEFAULT;
+    st->settings.trigger = RIC_TRIGGER_PHOTO;
+    st->photo.phase = PHOTO_PHASE_INTERFERE;
+    int writes_before = writes;
+    int isp_sets_before = isp_sets;
+    initial_mode_request(st, "night", true);
+    assert(st->settings.initial_mode == RIC_INITIAL_NIGHT);
+    assert(st->boot_initial_mode == RIC_INITIAL_DEFAULT);
+    assert(st->photo.phase == PHOTO_PHASE_INTERFERE);
+    assert(writes == writes_before && isp_sets == isp_sets_before);
+    assert(strcmp(rss_config_get_str(st->cfg, "ircut", "initial_mode", ""), "night") == 0);
+
+    char response[4096];
+    assert(ric_get_settings(st, response, sizeof(response)) > 0);
+    cJSON *root = cJSON_Parse(response);
+    cJSON *startup = cJSON_GetObjectItemCaseSensitive(root, "startup");
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(startup, "supported")));
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(startup, "available")));
+    assert(strcmp(cJSON_GetObjectItemCaseSensitive(startup, "configured")->valuestring,
+                  "night") == 0);
+    assert(strcmp(cJSON_GetObjectItemCaseSensitive(startup, "boot_active")->valuestring,
+                  "default") == 0);
+    cJSON_Delete(root);
+
+    assert(rss_config_save(st->cfg, path) == 0);
+    rss_config_t *disk = rss_config_load(path);
+    assert(disk);
+    assert(strcmp(rss_config_get_str(disk, "ircut", "initial_mode", ""), "night") == 0);
+    rss_config_free(disk);
+
+    initial_mode_request(st, "auto", false);
+    assert(st->settings.initial_mode == RIC_INITIAL_NIGHT);
+    assert(st->photo.phase == PHOTO_PHASE_INTERFERE);
+    assert(writes == writes_before && isp_sets == isp_sets_before);
+
+    st->settings.schedule_enabled = false;
+    st->settings.sun_enabled = false;
+    st->settings.opmode = RIC_AUTO;
+    st->settings.initial_mode = RIC_INITIAL_NIGHT;
+    st->photo.calibrated = true;
+    st->photo.rgain_base = 321;
+    assert(ric_apply_startup(st, 12 * 60 * 60));
+    assert(st->current_mode == RIC_MODE_NIGHT);
+    assert(st->boot_initial_mode == RIC_INITIAL_NIGHT);
+    assert(st->photo.phase == PHOTO_PHASE_DAY_DETECT);
+    assert(st->photo.calibrated && st->photo.rgain_base == 321);
+
+    st->settings.opmode = RIC_FORCE_DAY;
+    assert(ric_apply_startup(st, 12 * 60 * 60));
+    assert(st->current_mode == RIC_MODE_DAY);
+    assert(st->photo.phase == PHOTO_PHASE_NIGHT_DETECT);
+
+    st->settings.opmode = RIC_AUTO;
+    st->settings.initial_mode = RIC_INITIAL_NIGHT;
+    st->settings.schedule_enabled = true;
+    st->settings.schedule_start_minute = 7 * 60;
+    st->settings.schedule_stop_minute = 19 * 60;
+    setenv("TZ", "UTC", 1);
+    tzset();
+    assert(ric_apply_startup(st, 12 * 60 * 60));
+    assert(st->current_mode == RIC_MODE_DAY);
+    assert(st->schedule_target_known && st->schedule_target == RIC_MODE_DAY);
+    st->settings.schedule_enabled = false;
+    st->settings.trigger = RIC_TRIGGER_LUMA;
+}
+
+static void test_timing(ric_state_t *st, const char *path)
+{
+    st->settings.trigger = RIC_TRIGGER_LUMA;
+    const char *invalid[] = {
+        "{\"cmd\":\"set-daynight-settings\",\"mode\":\"auto\",\"timing\":{\"sample_interval_ms\":49,\"transition_delay_s\":5}}",
+        "{\"cmd\":\"set-daynight-settings\",\"mode\":\"auto\",\"timing\":{\"sample_interval_ms\":10001,\"transition_delay_s\":5}}",
+        "{\"cmd\":\"set-daynight-settings\",\"mode\":\"auto\",\"timing\":{\"sample_interval_ms\":500,\"transition_delay_s\":0}}",
+        "{\"cmd\":\"set-daynight-settings\",\"mode\":\"auto\",\"timing\":{\"sample_interval_ms\":500.5,\"transition_delay_s\":5}}",
+        "{\"cmd\":\"set-daynight-settings\",\"mode\":\"auto\",\"timing\":{\"extra\":1}}",
+        "{\"cmd\":\"set-daynight-settings\",\"mode\":\"auto\",\"timing\":{\"sample_interval_ms\":500,\"extra\":1}}",
+        "{\"cmd\":\"set-daynight-settings\",\"mode\":\"auto\",\"timing\":{\"sample_interval_ms\":500,\"sample_interval_ms\":600}}",
+        "{\"cmd\":\"set-daynight-settings\",\"mode\":\"auto\",\"timing\":{\"sample_interval_ms\":500,\"transition_delay_s\":5,\"extra\":1}}",
+    };
+    int old_poll = st->settings.poll_interval_ms;
+    int old_delay = st->settings.hysteresis_sec;
+    for (size_t i = 0; i < sizeof(invalid) / sizeof(invalid[0]); ++i)
+        settings_request(st, invalid[i], false);
+    assert(st->settings.poll_interval_ms == old_poll &&
+           st->settings.hysteresis_sec == old_delay);
+
+    st->day_count = 3;
+    st->night_count = 4;
+    settings_request(st,
+        "{\"cmd\":\"set-daynight-settings\",\"mode\":\"auto\",\"timing\":{\"sample_interval_ms\":500,\"transition_delay_s\":7}}",
+        true);
+    assert(st->settings.poll_interval_ms == 500 && st->settings.hysteresis_sec == 7);
+    assert(st->day_count == 0 && st->night_count == 0);
+    assert(rss_config_get_int(st->cfg, "ircut", "poll_interval_ms", -1) == 500);
+    assert(rss_config_get_int(st->cfg, "ircut", "hysteresis_sec", -1) == 7);
+    char response[4096];
+    assert(ric_get_settings(st, response, sizeof(response)) > 0);
+    cJSON *root = cJSON_Parse(response);
+    cJSON *timing = cJSON_GetObjectItemCaseSensitive(root, "timing");
+    cJSON *values = cJSON_GetObjectItemCaseSensitive(timing, "values");
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(timing, "supported")));
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(timing, "available")));
+    assert(cJSON_GetObjectItemCaseSensitive(values, "sample_interval_ms")->valueint == 500);
+    assert(cJSON_GetObjectItemCaseSensitive(values, "transition_delay_s")->valueint == 7);
+    cJSON_Delete(root);
+    assert(rss_config_save(st->cfg, path) == 0);
+    rss_config_t *disk = rss_config_load(path);
+    assert(disk && rss_config_get_int(disk, "ircut", "poll_interval_ms", -1) == 500);
+    assert(rss_config_get_int(disk, "ircut", "hysteresis_sec", -1) == 7);
+    rss_config_free(disk);
+
+    st->settings.trigger = RIC_TRIGGER_PHOTO;
+    settings_request(st,
+        "{\"cmd\":\"set-daynight-settings\",\"mode\":\"auto\",\"timing\":{\"transition_delay_s\":8}}",
+        false);
+    settings_request(st,
+        "{\"cmd\":\"set-daynight-settings\",\"mode\":\"auto\",\"timing\":{\"sample_interval_ms\":100}}",
+        true);
