diff --git a/rmr/rmr_recorder_config.c b/rmr/rmr_recorder_config.c
new file mode 100644
index 0000000000000000000000000000000000000000..21cf48a122942e5b2ae0ff8f6bc1cf600b07aab7
--- /dev/null
+++ b/rmr/rmr_recorder_config.c
@@ -0,0 +1,59 @@
+#include "rmr.h"
+#include "rmr_sd.h"
+#include <string.h>
+
+int rmr_recorder_config(rmr_state_t *st, const char *request, char *response, int size)
+{
+	cJSON *root = cJSON_ParseWithOpts(request, NULL, true);
+	const cJSON *cmd = cJSON_GetObjectItemCaseSensitive(root, "cmd");
+	bool get = cJSON_IsString(cmd) && !strcmp(cmd->valuestring, "get-recorder-config");
+	bool set = cJSON_IsString(cmd) && !strcmp(cmd->valuestring, "set-recorder-config");
+	if (!st->managed || !cJSON_IsObject(root) || (!get && !set) ||
+	    cJSON_GetArraySize(root) != (set ? 2 : 1)) {
+		cJSON_Delete(root);
+		return rss_ctrl_resp_error(response, size, "invalid recorder policy request");
+	}
+	if (set) {
+		rmr_policy_t next;
+		if (rmr_policy_parse(cJSON_GetObjectItemCaseSensitive(root, "settings"), &next)) {
+			cJSON_Delete(root);
+			return rss_ctrl_resp_error(response, size, "invalid recorder policy");
+		}
+		if (st->stream_idx == 1 && next.autostart &&
+		    !rss_config_get_bool(st->cfg, "stream1", "enabled", true)) {
+			cJSON_Delete(root);
+			return rss_ctrl_resp_error(response, size,
+				"stream1 recorder autostart requires the configured substream");
+		}
+		/* No stop, restart, stream switch, or implicit start. Autostart is boot-only. */
+		rmr_policy_store(st->cfg, (unsigned)st->stream_idx, &next);
+		rmr_policy_t checked;
+		if (rmr_policy_load(st->cfg, (unsigned)st->stream_idx, &checked) != 0 ||
+		    checked.autostart != next.autostart || checked.cleanup_enabled != next.cleanup_enabled ||
+		    checked.duration != next.duration || checked.limit != next.limit ||
+		    checked.min_free_mb != next.min_free_mb || checked.check_interval != next.check_interval) {
+			cJSON_Delete(root);
+			return rss_ctrl_resp_error(response, size, "recorder cache readback failed");
+		}
+		st->policy = checked;
+		rmr_storage_set_policy(st->storage, &st->policy);
+
+	}
+	cJSON_Delete(root);
+	cJSON *reply = cJSON_CreateObject();
+	cJSON_AddStringToObject(reply, "status", "ok");
+	cJSON_AddStringToObject(reply, "persistence", "checked-config");
+	cJSON_AddItemToObject(reply, "settings", rmr_policy_json((unsigned)st->stream_idx, &st->policy));
+	cJSON_AddBoolToObject(reply, "boot_pending", st->boot_recording_pending);
+	uint64_t free_mb = 0;
+	bool mounted = false, cleanup_ok = false;
+	bool fresh = rmr_storage_observe(st->storage, &mounted, &free_mb, &cleanup_ok);
+	mounted = fresh && mounted;
+	cJSON_AddBoolToObject(reply, "cleanup_ok", cleanup_ok);
+	cJSON_AddBoolToObject(reply, "storage_available", mounted);
+	if (mounted)
+		cJSON_AddNumberToObject(reply, "free_mb", (double)free_mb);
+	else
+		cJSON_AddNullToObject(reply, "free_mb");
+	return rss_ctrl_resp_json(response, size, reply);
+}
diff --git a/rmr/rmr_sd.c b/rmr/rmr_sd.c
new file mode 100644
index 0000000000000000000000000000000000000000..7af156bacb7be282ce2b34ad1a8886f8c91c1c05
--- /dev/null
+++ b/rmr/rmr_sd.c
@@ -0,0 +1,509 @@
+#include "rmr_sd.h"
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#ifdef __linux__
+#include <sys/sysmacros.h>
+#endif
+#include <unistd.h>
+
+#ifndef RMR_SD_MOUNT
+#define RMR_SD_MOUNT "/mnt/mmcblk0p1"
+#endif
+#ifndef RMR_MOUNTINFO
+#define RMR_MOUNTINFO "/proc/self/mountinfo"
+#endif
+#define RMR_SD_DEVICE "/dev/mmcblk0p1"
+
+static bool writable_options(const char *options)
+{
+	return strncmp(options, "rw,", 3) == 0 || strcmp(options, "rw") == 0;
+}
+
+static int mounted_sd_type(bool *fat)
+{
+	struct stat device;
+	if (stat(RMR_SD_DEVICE, &device) != 0 || !S_ISBLK(device.st_mode))
+		return -1;
+	FILE *mounts = fopen(RMR_MOUNTINFO, "r");
+	if (!mounts)
+		return -1;
+	bool found = false;
+	if (fat)
+		*fat = false;
+	char line[4096];
+	while (fgets(line, sizeof(line), mounts)) {
+		unsigned id, parent, dev_major, dev_minor;
+		char root[256], target[256], options[256], type[32], source[256], super[256];
+		char *separator = strstr(line, " - ");
+		if (!separator || !strchr(line, '\n') ||
+		    sscanf(line, "%u %u %u:%u %255s %255s %255s", &id, &parent, &dev_major,
+			   &dev_minor, root, target, options) != 7 ||
+		    sscanf(separator + 3, "%31s %255s %255s", type, source, super) != 3)
+			continue;
+		if (strcmp(target, RMR_SD_MOUNT) != 0)
+			continue;
+		found = strcmp(root, "/") == 0 && strcmp(source, RMR_SD_DEVICE) == 0 &&
+			(strcmp(type, "vfat") == 0 || strcmp(type, "ext4") == 0 ||
+			 strcmp(type, "exfat") == 0) &&
+			writable_options(options) && writable_options(super) &&
+			dev_major == (unsigned)major(device.st_rdev) &&
+			dev_minor == (unsigned)minor(device.st_rdev);
+		if (fat)
+			*fat = found && strcmp(type, "vfat") == 0;
+		break;
+	}
+	fclose(mounts);
+	if (!found)
+		return -1;
+	int fd = open(RMR_SD_MOUNT, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+	struct stat mounted;
+	if (fd >= 0 && fstat(fd, &mounted) == 0 && mounted.st_dev == device.st_rdev)
+		return fd;
+	if (fd >= 0)
+		close(fd);
+	return -1;
+}
+
+static int mounted_sd(void)
+{
+	return mounted_sd_type(NULL);
+}
+
+static bool fat_directory(int directory)
+{
+	bool fat = false;
+	int root = mounted_sd_type(&fat);
+	if (root < 0)
+		return false;
+	struct stat a, b;
+	bool same = fstat(root, &a) == 0 && fstat(directory, &b) == 0 && a.st_dev == b.st_dev;
+	close(root);
+	return same && fat;
+}
+
+bool rmr_sd_available(void)
+{
+	int fd = mounted_sd();
+	if (fd < 0)
+		return false;
+	close(fd);
+	return true;
+}
+
+static int child_directory(int parent, const char *name)
+{
+	int fd = openat(parent, name, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+	if (fd < 0 && errno == ENOENT) {
+		if (mkdirat(parent, name, 0750) != 0 && errno != EEXIST)
+			return -1;
+		fd = openat(parent, name, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+	}
+	struct stat ancestor, child;
+	if (fd >= 0 && fstat(parent, &ancestor) == 0 && fstat(fd, &child) == 0 &&
+	    ancestor.st_dev == child.st_dev)
+		return fd;
+	if (fd >= 0)
+		close(fd);
+	return -1;
+}
+
+int rmr_sd_open_segment(unsigned channel, const char *stamp, char *path, int size)
+{
+	if (channel > 1 || !stamp || strlen(stamp) != 19 || size <= 0)
+		return -1;
+	for (unsigned i = 0; i < 19; ++i) {
+		char separator = i == 4 || i == 7 || i == 13 || i == 16 ? '-' : i == 10 ? '/' : 0;
+		if (separator ? stamp[i] != separator : stamp[i] < '0' || stamp[i] > '9')
+			return -1;
+	}
+	int root = mounted_sd();
+	if (root < 0)
+		return -1;
+	int base = child_directory(root, "raptor");
+	close(root);
+	if (base < 0)
+		return -1;
+	char stream[16];
+	snprintf(stream, sizeof(stream), "stream%u", channel);
+	int directory = child_directory(base, stream);
+	close(base);
+	if (directory < 0)
+		return -1;
+	char day[11];
+	memcpy(day, stamp, 10);
+	day[10] = 0;
+	int date = child_directory(directory, day);
+	close(directory);
+	if (date < 0)
+		return -1;
+	int file = -1;
+	for (unsigned attempt = 0; attempt < 1000; ++attempt) {
+		char name[32];
+		if (attempt)
+			snprintf(name, sizeof(name), "%s-%03u.mp4", stamp + 11, attempt);
+		else
+			snprintf(name, sizeof(name), "%s.mp4", stamp + 11);
+		int length = snprintf(path, (size_t)size, "%s/raptor/%s/%s/%s", RMR_SD_MOUNT,
+				      stream, day, name);
+		if (length < 0 || length >= size)
+			break;
+		file = openat(date, name, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC,
+			      0640);
+		if (file >= 0 || errno != EEXIST)
+			break;
+	}
+	close(date);
+	return file;
+}
+
+/* Retention only considers files sealed by our writer after successful close. */
+#include <dirent.h>
+#include <inttypes.h>
+#include <stdlib.h>
+#include <sys/statvfs.h>
+#ifdef __APPLE__
+#define MTIME_NSEC(s) ((s).st_mtimespec.tv_nsec)
+#else
+#define MTIME_NSEC(s) ((s).st_mtim.tv_nsec)
+#endif
+
+static bool marker_time_matches(bool fat, const struct stat *file, intmax_t seconds, long nanos)
+{
+	if ((intmax_t)file->st_mtime == seconds && MTIME_NSEC(*file) == nanos)
+		return true;
+	return fat && seconds >= 0 && file->st_mtime >= 0 && nanos == 0 && MTIME_NSEC(*file) == 0 &&
+		   ((intmax_t)file->st_mtime & ~(intmax_t)1) == (seconds & ~(intmax_t)1);
+}
+
+int rmr_sd_free_mb(uint64_t *result)
+{
+	int fd = mounted_sd();
+	if (fd < 0)
+		return -1;
+	struct statvfs value;
+	int rc = fstatvfs(fd, &value);
+	close(fd);
+	if (rc != 0 || !value.f_frsize)
+		return -1;
+	if ((uint64_t)value.f_bavail > UINT64_MAX / (uint64_t)value.f_frsize)
+		return -1;
+	*result = (uint64_t)value.f_bavail * (uint64_t)value.f_frsize / (1024 * 1024);
+	return 0;
+}
+
+static bool day_name(const char *name)
+{
+	if (strlen(name) != 10)
+		return false;
+	for (unsigned i = 0; i < 10; ++i) {
+		if (i == 4 || i == 7) {
+			if (name[i] != '-')
+				return false;
+		} else if (name[i] < '0' || name[i] > '9') {
+			return false;
+		}
+	}
+	return true;
+}
+
+static bool clip_name(const char *name)
+{
+	size_t length = strlen(name);
+	if ((length != 12 && length != 16) || strcmp(name + length - 4, ".mp4"))
+		return false;
+	for (size_t i = 0; i < length - 4; ++i) {
+		if (i == 2 || i == 5 || i == 8) {
+			if (name[i] != '-')
+				return false;
+		} else if (name[i] < '0' || name[i] > '9') {
+			return false;
+		}
+	}
+	return true;
+}
+
+static int existing_child(int parent, const char *name)
+{
+	int fd = openat(parent, name, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+	struct stat a, b;
+	if (fd >= 0 && !fstat(parent, &a) && !fstat(fd, &b) && a.st_dev == b.st_dev)
+		return fd;
+	if (fd >= 0)
+		close(fd);
+	return -1;
+}
+
+static int stream_directory(unsigned channel)
+{
+	if (channel > 1)
+		return -1;
+	int root = mounted_sd();
+	if (root < 0)
+		return -1;
+	int base = existing_child(root, "raptor");
+	close(root);
+	if (base < 0)
+		return -1;
+	char stream[16];
+	snprintf(stream, sizeof(stream), "stream%u", channel);
+	int fd = existing_child(base, stream);
+	close(base);
+	return fd;
+}
+
+static int clip_directory(unsigned channel, const char *path, char *name, size_t size)
+{
+	char prefix[320];
+	int length = snprintf(prefix, sizeof(prefix), "%s/raptor/stream%u/", RMR_SD_MOUNT, channel);
+	if (length < 0 || (size_t)length >= sizeof(prefix) || strncmp(path, prefix, (size_t)length))
+		return -1;
+	const char *relative = path + length;
+	if (strlen(relative) < 23 || relative[10] != '/' || !clip_name(relative + 11))
+		return -1;
+	char day[11];
+	memcpy(day, relative, 10);
+	day[10] = 0;
+	if (!day_name(day) || strlen(relative + 11) >= size)
+		return -1;
+	int stream = stream_directory(channel);
+	if (stream < 0)
+		return -1;
+	int directory = existing_child(stream, day);
+	close(stream);
+	strcpy(name, relative + 11);
+	return directory;
+}
+
+int rmr_sd_mark_closed(unsigned channel, const char *path, const struct stat *completed)
+{
+	char name[32], marker[48];
+	int directory = clip_directory(channel, path, name, sizeof(name));
+	if (directory < 0)
+		return -1;
+	struct stat current;
+	if (fstatat(directory, name, &current, AT_SYMLINK_NOFOLLOW) != 0 ||
+	    !S_ISREG(current.st_mode) || current.st_nlink != 1 ||
+	    current.st_dev != completed->st_dev || current.st_ino != completed->st_ino ||
+	    current.st_size != completed->st_size || current.st_mtime != completed->st_mtime ||
+	    MTIME_NSEC(current) != MTIME_NSEC(*completed)) {
+		close(directory);
+		return -1;
+	}
+	bool fat = fat_directory(directory);
+	snprintf(marker, sizeof(marker), "%s.rmr-owned", name);
+	int fd = openat(directory, marker, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0640);
+	close(directory);
+	if (fd < 0)
+		return -1;
+	intmax_t modified = (intmax_t)current.st_mtime;
+	if (fat && modified >= 0 && MTIME_NSEC(current) == 0)
+		modified &= ~(intmax_t)1;
+	char record[128];
+	int length = snprintf(record, sizeof(record), "RMR1 %u %ju %jd %ld\n", channel,
+			      (uintmax_t)current.st_size, modified, MTIME_NSEC(current));
+	bool ok = length > 0 && (size_t)length < sizeof(record) &&
+		  write(fd, record, (size_t)length) == length && fsync(fd) == 0;
+	if (close(fd) != 0)
+		ok = false;
+	return ok ? 0 : -1;
+}
+
+static bool owned_clip(int directory, unsigned channel, const char *name, struct stat *file)
+{
+	if (!clip_name(name))
+		return false;
+	char marker[48], record[128];
+	snprintf(marker, sizeof(marker), "%s.rmr-owned", name);
+	int fd = openat(directory, marker, O_RDONLY | O_NOFOLLOW | O_CLOEXEC | O_NONBLOCK);
+	if (fd < 0)
+		return false;
+	struct stat mark, parent;
+	bool ok = !fstat(fd, &mark) && !fstat(directory, &parent) &&
+		  S_ISREG(mark.st_mode) && mark.st_nlink == 1 && mark.st_dev == parent.st_dev &&
+		  mark.st_size > 0 && mark.st_size < (off_t)sizeof(record);
+	ssize_t length = ok ? read(fd, record, sizeof(record) - 1) : -1;
+	close(fd);
+	if (length <= 0 || length != mark.st_size)
+		return false;
+	record[length] = 0;
+	unsigned owner;
+	uintmax_t size;
+	intmax_t modified;
+	long nanos;
+	int consumed = 0;
+	if (sscanf(record, "RMR1 %u %ju %jd %ld\n%n", &owner, &size, &modified, &nanos,
+		   &consumed) != 4 || consumed != length || owner != channel)
+		return false;
+	return fstatat(directory, name, file, AT_SYMLINK_NOFOLLOW) == 0 &&
+	       S_ISREG(file->st_mode) && file->st_nlink == 1 && file->st_dev == parent.st_dev &&
+	       (uintmax_t)file->st_size == size &&
+	       (marker_time_matches(false, file, modified, nanos) ||
+		(fat_directory(directory) && marker_time_matches(true, file, modified, nanos)));
+}
+
+struct retained_clip { char day[11], name[32]; struct stat observed; };
+#define RMR_RETAINED_MAX 32
+#define RMR_DELETE_MAX 32
+
+static int oldest_first(const void *left, const void *right)
+{
+	const struct retained_clip *a = left, *b = right;
+	if (a->observed.st_mtime != b->observed.st_mtime)
+		return a->observed.st_mtime < b->observed.st_mtime ? -1 : 1;
+	int result = strcmp(a->day, b->day);
+	return result ? result : strcmp(a->name, b->name);
+}
+
+int rmr_sd_retention_step(unsigned channel, unsigned limit, uint64_t minimum_free_mb,
+                          rmr_sd_progress_fn progress, void *opaque)
+{
+	if (channel > 1 || limit < 1 || limit > 1000)
+		return -1;
+	uint64_t free_mb;
+	if (rmr_sd_free_mb(&free_mb) != 0)
+		return -1;
+	int stream = stream_directory(channel);
+	if (stream < 0)
+		return errno == ENOENT ? 0 : -1;
+	struct retained_clip *clips = calloc(RMR_RETAINED_MAX, sizeof(*clips));
+	int scan_fd = dup(stream);
+	DIR *days = scan_fd < 0 ? NULL : fdopendir(scan_fd);
+	if (!days && scan_fd >= 0)
+		close(scan_fd);
+	if (!clips || !days) {
+		free(clips);
+		if (days)
+			closedir(days);
+		close(stream);
+		return -1;
+	}
+	unsigned count = 0;
+	uint64_t total = 0;
+	bool complete = true;
+	struct dirent *entry;
+	while (true) {
+		errno = 0;
+		entry = readdir(days);
+		if (!entry) {
+			if (errno)
+				complete = false;
+			break;
+		}
+		if (progress && !progress(opaque)) {
+			complete = false;
+			break;
+		}
+		if (!day_name(entry->d_name))
+			continue;
+		int directory = existing_child(stream, entry->d_name);
+		DIR *files = directory < 0 ? NULL : fdopendir(directory);
+		if (!files) {
+			if (directory >= 0)
+				close(directory);
+			complete = false;
+			break;
+		}
+		struct dirent *file;
+		while (true) {
+			errno = 0;
+			file = readdir(files);
+			if (!file) {
+				if (errno)
+					complete = false;
+				break;
+			}
+			if (progress && !progress(opaque)) {
+				complete = false;
+				break;
+			}
+			struct stat observed;
+			if (!owned_clip(directory, channel, file->d_name, &observed))
+				continue;
+			if (total == UINT64_MAX) {
+				complete = false;
+				break;
+			}
+			++total;
+			struct retained_clip candidate = {.observed = observed};
+			strcpy(candidate.day, entry->d_name);
+			strcpy(candidate.name, file->d_name);
+			if (count < RMR_RETAINED_MAX) {
+				clips[count++] = candidate;
+			} else {
+				unsigned newest = 0;
+				for (unsigned i = 1; i < count; ++i) {
+					if (oldest_first(&clips[newest], &clips[i]) < 0)
+						newest = i;
+				}
+				if (oldest_first(&candidate, &clips[newest]) < 0)
+					clips[newest] = candidate;
+			}
+		}
+		closedir(files);
+		if (!complete)
+			break;
+	}
+	closedir(days);
+	int deleted = complete ? 0 : -1;
+	if (complete) {
+		qsort(clips, count, sizeof(*clips), oldest_first);
+		for (unsigned i = 0; i < count && deleted < RMR_DELETE_MAX; ++i) {
+			if (total - (unsigned)deleted <= limit && free_mb >= minimum_free_mb)
+				break;
+			if (progress && !progress(opaque)) {
+				deleted = -1;
+				break;
+			}
+			int directory = existing_child(stream, clips[i].day);
+			struct stat current;
+			if (directory < 0 || !owned_clip(directory, channel, clips[i].name, &current) ||
+			    current.st_dev != clips[i].observed.st_dev ||
+			    current.st_ino != clips[i].observed.st_ino ||
+			    current.st_size != clips[i].observed.st_size ||
+			    current.st_mtime != clips[i].observed.st_mtime ||
+			    MTIME_NSEC(current) != MTIME_NSEC(clips[i].observed)) {
+				if (directory >= 0)
+					close(directory);
+				deleted = -1;
+				break;
+			}
+			if (progress && !progress(opaque)) {
+				close(directory);
+				deleted = -1;
+				break;
+			}
+			if (unlinkat(directory, clips[i].name, 0) != 0) {
+				close(directory);
+				deleted = -1;
+				break;
+			}
+			char marker[48];
+			snprintf(marker, sizeof(marker), "%s.rmr-owned", clips[i].name);
+			(void)unlinkat(directory, marker, 0);
+			/* Remove only a day emptied by our own confirmed deletion. */
+			struct stat opened_day, named_day;
+			if (fstat(directory, &opened_day) == 0 &&
+			    fstatat(stream, clips[i].day, &named_day, AT_SYMLINK_NOFOLLOW) == 0 &&
+			    opened_day.st_dev == named_day.st_dev && opened_day.st_ino == named_day.st_ino)
+				(void)unlinkat(stream, clips[i].day, AT_REMOVEDIR);
+			close(directory);
+			++deleted;
+			if (rmr_sd_free_mb(&free_mb) != 0) {
+				deleted = -1;
+				break;
+			}
+		}
+	}
+	free(clips);
+	close(stream);
+	return deleted;
+}
+
+int rmr_sd_retention(unsigned channel, unsigned limit, uint64_t minimum_free_mb)
+{
+	return rmr_sd_retention_step(channel, limit, minimum_free_mb, NULL, NULL);
+}
