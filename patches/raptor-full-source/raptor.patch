diff --git a/rhd/rhd_media_route.h b/rhd/rhd_media_route.h
new file mode 100644
index 0000000000000000000000000000000000000000..b6dd79fd18b5e050a0930f93a255d36b0239f4f6
--- /dev/null
+++ b/rhd/rhd_media_route.h
@@ -0,0 +1,63 @@
+#ifndef RHD_MEDIA_ROUTE_H
+#define RHD_MEDIA_ROUTE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+
+/* Fixed local proxy contract. No decoding, prefix matches or channel fallback. */
+enum rhd_media_kind { RHD_MEDIA_NONE, RHD_MEDIA_SNAPSHOT, RHD_MEDIA_MJPEG };
+struct rhd_media_route { enum rhd_media_kind kind; int stream; unsigned fps; };
+
+static inline int rhd_media_route_parse(const char *path, struct rhd_media_route *out)
+{
+	const char *query = strchr(path, '?');
+	size_t len = query ? (size_t)(query - path) : strlen(path);
+	const char *key;
+	if ((len == 9 && !memcmp(path, "/snapshot", 9)) ||
+	    (len == 9 && !memcmp(path, "/snap.jpg", 9))) {
+		out->kind = RHD_MEDIA_SNAPSHOT;
+		key = !memcmp(path, "/snapshot", 9) ? "ch=" : "stream=";
+	} else if ((len == 5 && !memcmp(path, "/mjpg", 5)) ||
+		   (len == 6 && !memcmp(path, "/mjpeg", 6))) {
+		out->kind = RHD_MEDIA_MJPEG;
+		key = len == 5 ? "ch=" : "stream=";
+	} else {
+		return 0;
+	}
+	if (!query)
+		return -1;
+	query++;
+	size_t key_len = strlen(key);
+	if (strncmp(query, key, key_len))
+		return -1;
+	query += key_len;
+	if ((*query != '0' && *query != '1') || (query[1] && query[1] != '&'))
+		return -1;
+	out->stream = *query++ - '0';
+	out->fps = 0;
+	if (!*query)
+		return 1;
+	if (out->kind != RHD_MEDIA_MJPEG || strncmp(query, "&f=", 3))
+		return -1;
+	query += 3;
+	if (*query < '1' || *query > '9')
+		return -1;
+	unsigned fps = (unsigned)(*query++ - '0');
+	if (*query >= '0' && *query <= '9')
+		fps = fps * 10 + (unsigned)(*query++ - '0');
+	if (*query || fps > 30)
+		return -1;
+	out->fps = fps;
+	return 1;
+}
+
+/* Delivery cap only: never changes the shared JPEG encoder profile. */
+static inline bool rhd_media_frame_due(unsigned fps, int64_t now, int64_t *next)
+{
+	if (fps && now < *next)
+		return false;
+	*next = fps ? now + (1000 + (int64_t)fps - 1) / (int64_t)fps : now;
+	return true;
+}
+#endif
diff --git a/rhd/rhd_snapshot_policy.h b/rhd/rhd_snapshot_policy.h
new file mode 100644
index 0000000000000000000000000000000000000000..94d8280d2e39730bd0c122a286ed9912c822b70f
--- /dev/null
+++ b/rhd/rhd_snapshot_policy.h
@@ -0,0 +1,43 @@
+#ifndef RHD_SNAPSHOT_POLICY_H
+#define RHD_SNAPSHOT_POLICY_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "rhd.h"
+
+typedef enum {
+	RHD_SNAPSHOT_WAIT,
+	RHD_SNAPSHOT_FRAME,
+	RHD_SNAPSHOT_PRIVACY,
+	RHD_SNAPSHOT_PRIVACY_UNAVAILABLE,
+	RHD_SNAPSHOT_TIMEOUT,
+} rhd_snapshot_resolution_t;
+
+static inline rhd_snapshot_resolution_t
+rhd_snapshot_resolution(bool privacy, uint32_t privacy_jpeg_len, int read_result,
+			const uint8_t *frame, uint32_t frame_len, int64_t now, int64_t deadline)
+{
+	if (privacy)
+		return privacy_jpeg_len ? RHD_SNAPSHOT_PRIVACY :
+					  RHD_SNAPSHOT_PRIVACY_UNAVAILABLE;
+	if (read_result == 0 && frame && frame_len >= 2 && frame[0] == 0xFF &&
+	    frame[1] == 0xD8)
+		return RHD_SNAPSHOT_FRAME;
+	if (now >= deadline)
+		return RHD_SNAPSHOT_TIMEOUT;
+	return RHD_SNAPSHOT_WAIT;
+}
+
+static inline void rhd_snapshot_resolve(rhd_client_t *client)
+{
+	client->snap_pending = false;
+}
+
+static inline bool rhd_snapshot_has_ring_demand(const rhd_client_t *client)
+{
+	return client->snap_pending && client->snap_stream >= 0 &&
+	       client->snap_stream < RHD_MAX_JPEG;
+}
+
+#endif /* RHD_SNAPSHOT_POLICY_H */
