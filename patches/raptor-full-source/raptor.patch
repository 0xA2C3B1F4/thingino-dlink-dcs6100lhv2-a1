+static int stream_codec_command(rvd_state_t *st, const char *json, char *resp, int size)
+{
+	cJSON *root = cJSON_ParseWithOpts(json, NULL, true);
+	cJSON *cmd = cJSON_GetObjectItemCaseSensitive(root, "cmd");
+	cJSON *id = cJSON_GetObjectItemCaseSensitive(root, "stream_id");
+	cJSON *codec_value = cJSON_GetObjectItemCaseSensitive(root, "codec");
+	bool set = cJSON_IsString(cmd) && strcmp(cmd->valuestring, "set-stream-codec") == 0;
+	rss_codec_t requested = RSS_CODEC_H264;
+	bool codec_valid = cJSON_IsString(codec_value) &&
+		(strcmp(codec_value->valuestring, "h264") == 0 ||
+		 strcmp(codec_value->valuestring, "h265") == 0);
+	if (codec_valid && strcmp(codec_value->valuestring, "h265") == 0)
+		requested = RSS_CODEC_H265;
+	bool valid = cJSON_IsObject(root) && cJSON_IsString(cmd) &&
+		(set || strcmp(cmd->valuestring, "get-stream-codec") == 0) &&
+		cJSON_GetArraySize(root) == (set ? 3 : 2) && cJSON_IsNumber(id) &&
+		id->valuedouble == id->valueint && id->valueint >= 0 && id->valueint <= 1 &&
+		(!set || codec_valid);
+	if (!valid) {
+		cJSON_Delete(root);
+		return rss_ctrl_resp_error(resp, size, "invalid stream codec request");
+	}
+	int stream_id = id->valueint;
+	cJSON_Delete(root);
+
+	int index = stream_codec_owner(st, stream_id);
+	rvd_stream_t *s = index >= 0 ? &st->streams[index] : NULL;
+	const rss_hal_caps_t *caps = st->ops && st->ops->get_caps ?
+		st->ops->get_caps(st->hal_ctx) : NULL;
+	bool supported = s && caps && st->ops->enc_get_channel_attr;
+	bool h265 = supported && caps->has_h265;
+	bool available = supported && !s->codec_uncertain && !stream_restart_preflight(st, index) && s->enabled &&
+		atomic_load(&st->stream_active[index]);
+	rss_video_config_t live = {0};
+	if (available && !stream_codec_readback(st, s, &live))
+		available = false;
+
+	if (set) {
+		if (!available || (requested == RSS_CODEC_H265 && !h265))
+			return rss_ctrl_resp_error(resp, size, "stream codec unavailable");
+		if (live.codec != requested) {
+			s->enc_cfg.codec = requested;
+			if (do_stream_restart(st, index, resp, size) != RSS_OK) {
+				s->codec_uncertain = true;
+				return strlen(resp) > 0 ? (int)strlen(resp) : RSS_ERR;
+			}
+			if (!stream_codec_readback(st, s, &live) || live.codec != requested) {
+				s->codec_uncertain = true;
+				return rss_ctrl_resp_error(resp, size, "stream codec readback failed");
+			}
+		}
+		const char *name = stream_codec_name(requested);
+		rss_config_set_str(st->cfg, s->cfg_sect, "codec", name);
+		if (strcmp(rss_config_get_str(st->cfg, s->cfg_sect, "codec", ""), name) != 0)
+			return rss_ctrl_resp_error(resp, size, "stream codec cache update failed");
+		available = true;
+	}
+
+	cJSON *reply = cJSON_CreateObject();
+	cJSON_AddStringToObject(reply, "status", "ok");
+	cJSON_AddStringToObject(reply, "persistence", "checked-restart-codec");
+	cJSON_AddNumberToObject(reply, "stream_id", stream_id);
+	cJSON_AddBoolToObject(reply, "supported", supported);
+	cJSON_AddBoolToObject(reply, "available", available);
+	cJSON_AddBoolToObject(reply, "recovery_required", s && s->codec_uncertain);
+	cJSON *codecs = cJSON_AddArrayToObject(reply, "codecs");
+	if (supported) {
+		cJSON_AddItemToArray(codecs, cJSON_CreateString("h264"));
+		if (h265)
+			cJSON_AddItemToArray(codecs, cJSON_CreateString("h265"));
+	}
+	if (available) {
+		cJSON_AddStringToObject(reply, "codec", stream_codec_name(live.codec));
+		cJSON_AddNumberToObject(reply, "width", live.width);
+		cJSON_AddNumberToObject(reply, "height", live.height);
+	} else {
+		cJSON_AddNullToObject(reply, "codec");
+		cJSON_AddNullToObject(reply, "width");
+		cJSON_AddNullToObject(reply, "height");
+	}
+	return rss_ctrl_resp_json(resp, size, reply);
+}
