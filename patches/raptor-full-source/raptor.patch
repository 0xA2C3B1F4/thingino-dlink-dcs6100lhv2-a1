+static void test_poll_timer_ignores_early_wakeups(void)
+{
+    ric_poll_timer_t timer = {0};
+    assert(ric_poll_timer_due(&timer, 1000000, 1000));
+    assert(timer.next_us == 2000000);
+    for (int64_t now = 1100000; now < 2000000; now += 100000) {
+        assert(!ric_poll_timer_due(&timer, now, 1000));
+        assert(ric_poll_timer_wait_ms(&timer, now) == (2000000 - now) / 1000);
+    }
+    assert(ric_poll_timer_due(&timer, 1200000, 100));
+    assert(timer.next_us == 1300000);
+    assert(ric_poll_timer_due(&timer, 1900000, 100));
+    assert(timer.next_us == 2000000);
+    assert(!ric_poll_timer_due(&timer, 1950000, 100));
+    assert(ric_poll_timer_wait_ms(&timer, 1950000) == 50);
+}
