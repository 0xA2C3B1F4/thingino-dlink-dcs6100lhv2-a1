+		return RSS_OK;
+	if (st->stream_count < 2 || !st->ivs_group_created || !st->ivs_channel_created ||
+	    !st->ivs_registered || !st->ivs_bound || !st->ivs_algo_handle ||
+	    !st->ops || !st->ops->ivs_start || !st->ops->ivs_stop)
