@@ -0,0 +1,29 @@
+#ifndef RAPTOR_OSD_METADATA_SNAPSHOT_H
+#define RAPTOR_OSD_METADATA_SNAPSHOT_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define OSD_METADATA_JSON_MAX 2048
+#define OSD_METADATA_SEI_MAX 2112
+#define OSD_METADATA_MAX_AGE_US 3000000LL
+
+typedef struct {
+	uint32_t generation;
+	size_t json_len;
+	char json[OSD_METADATA_JSON_MAX + 1];
+} osd_metadata_snapshot_t;
+
+int osd_metadata_snapshot_write(const char *directory, unsigned stream,
+				uint32_t generation, int64_t updated_us, bool enabled,
+				const char *json, size_t json_len);
+int osd_metadata_snapshot_read(const char *directory, unsigned stream, int64_t now_us,
+			       int64_t max_age_us, osd_metadata_snapshot_t *snapshot);
+int osd_metadata_snapshot_read_sei(const char *directory, unsigned stream, int64_t now_us,
+				   int codec, int prefix, uint8_t *dst, size_t cap,
+				   uint32_t *generation);
+int osd_metadata_build_sei(uint8_t *dst, size_t cap, int codec, int prefix,
+			   const char *json, size_t json_len);
+
+#endif
diff --git a/osd_snapshot.h b/osd_snapshot.h
new file mode 100644
index 0000000000000000000000000000000000000000..546426671df9f2fff7b4a9fb501bec202f3753ab
--- /dev/null
+++ b/osd_snapshot.h
@@ -0,0 +1,17 @@
+#ifndef RAPTOR_OSD_SNAPSHOT_H
+#define RAPTOR_OSD_SNAPSHOT_H
+#include <stddef.h>
+#include <stdint.h>
+
+/* A bounded consistency checksum for the frozen producer snapshot, not a
+ * cryptographic authenticity check. The existing shared-memory ABI is unchanged. */
+static inline uint32_t osd_snapshot_hash(const uint8_t *bytes, size_t size)
+{
+    uint32_t hash = 2166136261u;
+    for (size_t i = 0; i < size; ++i) {
+        hash ^= bytes[i];
+        hash *= 16777619u;
+    }
+    return hash;
+}
+#endif
