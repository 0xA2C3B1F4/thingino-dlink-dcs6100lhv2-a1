+
+static inline bool ric_poll_timer_due(ric_poll_timer_t *timer, int64_t now_us,
+				      int interval_ms)
+{
+	if (timer->interval_ms != interval_ms) {
+		timer->interval_ms = interval_ms;
+		timer->next_us = now_us;
+	}
+	if (now_us < timer->next_us)
+		return false;
+	timer->next_us = now_us + (int64_t)interval_ms * 1000;
+	return true;
+}
+
+static inline int ric_poll_timer_wait_ms(const ric_poll_timer_t *timer, int64_t now_us)
+{
+	if (now_us >= timer->next_us)
+		return 0;
+	return (int)((timer->next_us - now_us + 999) / 1000);
+}
+
+static inline ric_poll_due_t ric_poll_due(ric_poll_timer_t *policy,
+					  ric_poll_timer_t *gain, int64_t now_us,
+					  int policy_interval_ms)
+{
+	return (ric_poll_due_t){
+		.policy = ric_poll_timer_due(policy, now_us, policy_interval_ms),
+		.gain = ric_poll_timer_due(gain, now_us, 1000),
+	};
+}
+
+static inline int ric_poll_wait_ms(const ric_poll_timer_t *policy,
+				   const ric_poll_timer_t *gain, int64_t now_us)
+{
+	int policy_wait = ric_poll_timer_wait_ms(policy, now_us);
+	int gain_wait = ric_poll_timer_wait_ms(gain, now_us);
+	return policy_wait < gain_wait ? policy_wait : gain_wait;
