+static void setup(void)
+{
+    semantic = 0;
+    target_fs = 0;
+    if (state.cfg)
+        rss_config_free(state.cfg);
+    memset(&state, 0, sizeof(state));
+    memset(&ops, 0, sizeof(ops));
+    state.cfg = rss_config_load(fixture);
+    assert(state.cfg);
+    state.config_path = "/fps-test.conf";
+    state.ops = &ops;
+    state.sensor_count = 1;
+    state.stream_count = 3;
+    state.jpeg_count = 1;
+    state.jpeg_streams[0] = jpeg;
+    ops.fs_get_fps = fs_get;
+    ops.enc_get_fps = enc_get;
+    ops.isp_get_sensor_fps = sensor_get;
+    ops.enc_get_channel_attr = enc_attr;
+    ops.fs_set_fps = fs_set;
+    ops.enc_set_fps = enc_set;
+    ops.fs_disable_channel = fs_disable;
+    ops.fs_enable_channel = fs_enable;
+    ops.enc_stop = enc_stop;
+    ops.enc_start = enc_start;
+    ops.ivs_stop = ivs_stop;
+    ops.ivs_start = ivs_start;
+    for (int i = 0; i < 3; i++) {
+        rvd_stream_t *s = &state.streams[i];
+        s->chn = i == target ? 9 : i == jpeg ? 12 : 3;
+        s->fs_chn = i == 0 ? 1 : 0;
+        s->sensor_idx = 0;
+        s->is_jpeg = i == jpeg;
+        s->enc_cfg.codec = s->is_jpeg ? RSS_CODEC_JPEG : RSS_CODEC_H264;
+        s->enc_cfg.width = 640;
+        s->enc_cfg.height = 360;
+        s->enc_cfg.fps_num = s->is_jpeg ? 1 : 20;
+        s->enc_cfg.fps_den = 1;
+        s->fs_cfg.fps_num = 20;
+        s->fs_cfg.fps_den = 1;
+        s->fs_cfg.width = 640;
+        s->fs_cfg.height = 360;
+        s->enabled = true;
+        s->fs_enabled = !s->is_jpeg;
+        state.enc_tids[i] = (pthread_t)(uintptr_t)(i == jpeg ? 11 : 10);
+        atomic_store(&state.stream_active[i], true);
+        strcpy(s->cfg_sect, i == target ? "stream0" : i == jpeg ? "jpeg" : "stream1");
+        s->ring = fps_test_ring(i, i == jpeg ? 100 : (uint32_t)i,
+                               s->enc_cfg.codec, s->enc_cfg.fps_num, 1);
+    }
+    state.ivs_fs_chn = 0;
+    state.ivs_chn = 4;
+    state.ivs_enabled = true;
+    state.ivs_group_created = true;
+    state.ivs_channel_created = true;
+    state.ivs_registered = true;
+    state.ivs_bound = true;
+    state.ivs_algo_handle = &interface_handle;
+    state.ivs_receiving = true;
+    state.ivs_tid = (pthread_t)(uintptr_t)7;
+    atomic_store(&state.ivs_active, true);
+    fs_rate = 20;
+    enc_rate = 20;
+    disk_rate = 20;
+    calls = 0;
+    fail_at = 0;
+    fs_sets = 0;
+    enc_sets = 0;
+    saves = 0;
+    starts = 0;
+    creates = 0;
+    deferred = false;
+    deferred_mode = 0;
+    fake_ns = 0;
+    pending_rate = 0;
+    attr_rate = 20;
+}
+static cJSON *command(uint32_t rate)
+{
+    char request[128], response[2048];
+    snprintf(request, sizeof(request), "{\"cmd\":\"set-stream-fps\",\"stream_id\":%d,\"fps\":%u}", semantic, rate);
+    assert(stream_fps_command(&state, request, response, sizeof(response)) > 0);
+    cJSON *r = cJSON_Parse(response);
+    assert(r);
+    return r;
+}
+int main(int argc, char **argv)
+{
+    assert(argc == 2);
+    fixture = argv[1];
+    setup();
+    /* A checked FPS save must not consume geometry that only the next full
+     * stack start may load. */
+    rss_config_set_int(state.cfg, "stream0", "width", 320);
+    rss_config_set_int(state.cfg, "stream0", "height", 180);
+    cJSON *r = command(15);
+    assert(strcmp(cJSON_GetObjectItem(r, "status")->valuestring, "ok") == 0);
+    assert(cJSON_IsTrue(cJSON_GetObjectItem(r, "live_applied")));
+    assert(cJSON_IsTrue(cJSON_GetObjectItem(r, "persisted")));
+    assert(fs_sets == 1 && enc_sets == 1 && saves == 1);
+    assert(state.streams[target].enc_cfg.fps_num == 15);
+    assert(state.streams[jpeg].enc_cfg.fps_num == 1);
+    assert(state.streams[jpeg].fs_cfg.fps_num == 15);
+    assert(state.streams[0].enc_cfg.fps_num == 20);
+    assert(state.streams[target].enc_cfg.width == 640 &&
+           state.streams[target].enc_cfg.height == 360);
+    assert(state.streams[target].fs_cfg.width == 640 &&
+           state.streams[target].fs_cfg.height == 360);
+    assert(rss_config_get_int(state.cfg, "stream0", "width", 0) == 320);
+    assert(rss_config_get_int(state.cfg, "stream0", "height", 0) == 180);
+    assert(atomic_load(&state.ivs_active));
+    cJSON_Delete(r);
+    int baseline = calls, mutation = 0, persistence = 0, monitoring = 0;
+    char baseline_events[1024][32];
+    memcpy(baseline_events, events, sizeof(events));
+    for (int i = 0; i < baseline; i++) {
+        if (!strcmp(events[i], "fs-set")) mutation = i + 1;
+        if (!strcmp(events[i], "config-set")) persistence = i + 1;
+        if (!strcmp(events[i], "ivs-start")) monitoring = i + 1;
+    }
+    assert(mutation && persistence > mutation && monitoring > persistence);
+    for (int fail = 1; fail <= baseline; fail++) {
+        setup();
+        fail_at = fail;
+        r = command(15);
+        if (strcmp(cJSON_GetObjectItem(r, "status")->valuestring, "error")) {
+            fprintf(stderr, "unexpected success at %d %s\n", fail, baseline_events[fail - 1]);
+            abort();
+        }
+        assert(fs_sets <= 1 && enc_sets <= 1);
+        assert(state.streams[jpeg].enc_cfg.fps_num == 1);
+        assert(state.streams[0].enc_cfg.fps_num == 20);
+        if (fail < mutation) {
+            assert(!fs_sets && !state.streams[target].fps_uncertain);
+            assert(cJSON_IsFalse(cJSON_GetObjectItem(r, "live_applied")));
+        } else if (fail < persistence) {
+            assert(state.streams[target].fps_uncertain);
+            assert(cJSON_IsNull(cJSON_GetObjectItem(r, "fps")));
+            int before = calls;
+            cJSON *retry = command(15);
+            assert(calls == before); /* No second RMW or getter recovery. */
+            assert(cJSON_IsTrue(cJSON_GetObjectItem(retry, "recovery_required")));
+            cJSON_Delete(retry);
+            assert(rvd_stream_start(&state, target) != RSS_OK);
+            assert(rvd_stream_start(&state, jpeg) != RSS_OK);
+        } else if (fail < monitoring) {
+            assert(!state.streams[target].fps_uncertain);
+            assert(state.streams[target].fps_persist_pending);
+            assert(cJSON_IsTrue(cJSON_GetObjectItem(r, "live_applied")));
+            assert(cJSON_IsNull(cJSON_GetObjectItem(r, "persisted")));
+            assert(!atomic_load(&state.ivs_active));
+            int setters = fs_sets + enc_sets;
+            fail_at = 0;
+            cJSON *retry = command(15);
+            assert(!strcmp(cJSON_GetObjectItem(retry, "status")->valuestring, "ok"));
+            assert(fs_sets + enc_sets == setters);
+            assert(!state.streams[target].fps_persist_pending);
+            cJSON_Delete(retry);
+        } else {
+            assert(cJSON_IsTrue(cJSON_GetObjectItem(r, "live_applied")));
+            assert(cJSON_IsTrue(cJSON_GetObjectItem(r, "persisted")));
+            assert(!state.streams[target].fps_uncertain);
+            assert(state.ivs_stream_paused);
+        }
+        cJSON_Delete(r);
+    }
+    setup();
+    r = command(20);
+    assert(!strcmp(cJSON_GetObjectItem(r, "status")->valuestring, "ok"));
+    assert(!fs_sets && !enc_sets && !saves && !creates);
+    cJSON_Delete(r);
+    /* Save failure followed by an explicit checked stop can still be saved. */
+    setup();
+    fail_at = persistence + 1;
+    r = command(15);
+    assert(state.streams[target].fps_persist_pending);
+    cJSON_Delete(r);
+    fail_at = 0;
+    assert(rvd_stream_stop(&state, jpeg) == RSS_OK);
+    assert(rvd_stream_stop(&state, target) == RSS_OK);
+    int previous_starts = starts;
+    r = command(15);
+    assert(!strcmp(cJSON_GetObjectItem(r, "status")->valuestring, "ok"));
+    assert(!state.streams[target].fps_persist_pending);
+    assert(!state.enc_tids[target] && !state.enc_tids[jpeg]);
+    assert(!atomic_load(&state.ivs_active));
+    assert(starts == previous_starts && fs_sets == 1 && enc_sets == 1);
+    cJSON_Delete(r);
+    for (int off = 0; off < 2; off++) {
+        setup();
+        if (off) state.ivs_fs_chn = 1; /* Unrelated monitoring stays active. */
+        else {
+            state.ivs_enabled = false;
+            state.ivs_receiving = false;
+            state.ivs_tid = 0;
+            atomic_store(&state.ivs_active, false);
+        }
+        r = command(15);
+        assert(!strcmp(cJSON_GetObjectItem(r, "status")->valuestring, "ok"));
+        assert(atomic_load(&state.ivs_active) == !!off);
+        for (int i = 0; i < calls; i++) assert(strncmp(events[i], "ivs-", 4));
+        cJSON_Delete(r);
+    }
+    for (int invalid = 0; invalid < 9; invalid++) {
+        setup();
+        switch (invalid) {
+        case 0: ops.fs_set_fps = NULL; break;
+        case 1: state.streams[target].sensor_idx = 1; break;
+        case 2: state.streams[target].enc_cfg.fps_den = 2; break;
+        case 3: state.streams[target].enc_cfg.codec = RSS_CODEC_JPEG; break;
+        case 4: state.streams[jpeg].enc_cfg.fps_num = 21; break;
+        case 5: state.streams[0].chn = state.streams[target].chn; break;
+        case 6: state.sensor_count = 0; break;
+        case 7: state.streams[target].fs_chn = 2; break;
+        case 8: state.jpeg_count = 0; break;
+        }
+        r = command(15);
+        assert(!strcmp(cJSON_GetObjectItem(r, "status")->valuestring, "error"));
+        assert(!fs_sets && !enc_sets && !saves && !creates);
+        cJSON_Delete(r);
+    }
+    for (int unknown = 0; unknown < 2; unknown++) {
+        setup();
+        char response[2048];
+        if (unknown) fail_at = 9; /* Disk load follows eight read-only checks. */
+        assert(stream_fps_command(&state, "{\"cmd\":\"get-stream-fps\",\"stream_id\":0}", response, sizeof(response)) > 0);
+        r = cJSON_Parse(response);
+        assert(r && !strcmp(cJSON_GetObjectItem(r, "status")->valuestring, "ok"));
+        assert(!fs_sets && !enc_sets && !saves && !creates);
+        assert(!strcmp(events[calls - 1], "disk-read"));
+        if (unknown) assert(cJSON_IsNull(cJSON_GetObjectItem(r, "persisted")));
+        else assert(cJSON_IsTrue(cJSON_GetObjectItem(r, "persisted")));
+        cJSON_Delete(r);
+    }
+    const char *aliases[] = {"stream-start", "stream-restart", "set-codec", "set-resolution", "set-jpeg-quality", "save", "osd-restart"};
+    for (int pending = 0; pending < 2; pending++) {
+        setup();
+        state.streams[target].fps_uncertain = !pending;
+        state.streams[target].fps_persist_pending = pending;
+        for (size_t i = 0; i < sizeof(aliases) / sizeof(aliases[0]); i++) {
+            char request[256], response[2048];
+            snprintf(request, sizeof(request), "{\"cmd\":\"%s\",\"channel\":%d}", aliases[i], target);
+            assert(handle_pipeline_cmd(aliases[i], request, &state, response, sizeof(response)) > 0);
+            r = cJSON_Parse(response);
+            assert(r && !strcmp(cJSON_GetObjectItem(r, "status")->valuestring, "error"));
+            cJSON_Delete(r);
+        }
+        assert(!calls);
+        char capture[2048];
+        assert(handle_pipeline_cmd("save", "{\"cmd\":\"save\",\"channel\":0,\"format\":\"jpeg\",\"file\":\"/forbidden\"}", &state, capture, sizeof(capture)) > 0);
+        r = cJSON_Parse(capture);
+        assert(r && !strcmp(cJSON_GetObjectItem(r, "status")->valuestring, "error"));
+        cJSON_Delete(r);
+        assert(rvd_ivs_set_enabled(&state, true) != RSS_OK);
+        assert(!calls);
+        char status[8192];
+        assert(rvd_media_status(&state, status, sizeof(status)) > 0);
+        r = cJSON_Parse(status);
+        assert(r);
+        cJSON *streams = cJSON_GetObjectItem(r, "streams");
+        assert(cJSON_IsNull(cJSON_GetObjectItem(cJSON_GetArrayItem(streams, target), "fps")));
+        assert(cJSON_IsNull(cJSON_GetObjectItem(cJSON_GetArrayItem(streams, jpeg), "fps")));
+        assert(cJSON_IsNumber(cJSON_GetObjectItem(cJSON_GetArrayItem(streams, 0), "fps")));
+        cJSON_Delete(r);
+    }
+    setup();
+    semantic = 1;
+    target_fs = 1;
+    state.streams[target].fs_chn = 1;
+    state.streams[jpeg].fs_chn = 1;
+    state.streams[0].fs_chn = 0;
+    state.ivs_fs_chn = 1;
+    strcpy(state.streams[target].cfg_sect, "stream1");
+    strcpy(state.streams[0].cfg_sect, "stream0");
+    state.streams[target].enc_cfg.codec = RSS_CODEC_H265;
+    state.streams[target].ring = fps_test_ring(target, target, RSS_CODEC_H265, 20, 1);
+    r = command(15);
+    assert(!strcmp(cJSON_GetObjectItem(r, "status")->valuestring, "ok"));
+    assert(cJSON_GetObjectItem(r, "stream_id")->valueint == 1);
+    assert(fs_sets == 1 && enc_sets == 1 && saves == 1);
+    assert(rss_config_get_int(state.cfg, "stream1", "fps", 0) == 15);
+    assert(rss_config_get_int(state.cfg, "stream0", "fps", 0) == 20);
+    assert(state.streams[jpeg].enc_cfg.fps_num == 1);
+    cJSON_Delete(r);
+    for (int sub = 0; sub < 2; sub++) {
+        for (int mode = 0; mode < 7; mode++) {
+            setup();
+            deferred = true;
+            deferred_mode = mode;
+            if (sub) {
+                semantic = target_fs = 1;
+                state.streams[target].fs_chn = state.streams[jpeg].fs_chn = 1;
+                state.streams[0].fs_chn = 0;
+                state.ivs_fs_chn = 1;
+                strcpy(state.streams[target].cfg_sect, "stream1");
+                strcpy(state.streams[0].cfg_sect, "stream0");
+                state.streams[target].enc_cfg.codec = RSS_CODEC_H265;
+                state.streams[target].ring = fps_test_ring(target, target, RSS_CODEC_H265, 20, 1);
+            }
+            r = command(15);
+            assert(fs_sets == 1 && enc_sets == 1);
+            if (mode == 0) {
+                assert(!strcmp(cJSON_GetObjectItem(r, "status")->valuestring, "ok"));
+                assert(fake_ns == 200000000 && saves == 1);
+                assert(enc_rate == 15 && attr_rate == 15);
+                uint32_t num, den;
+                assert(fps_real_get(state.streams[target].ring, &num, &den) == 0 && num == 15);
+                assert(!state.streams[target].fps_uncertain);
+            } else {
+                assert(!strcmp(cJSON_GetObjectItem(r, "status")->valuestring, "error"));
+                assert(cJSON_IsTrue(cJSON_GetObjectItem(r, "recovery_required")));
+                assert(cJSON_IsNull(cJSON_GetObjectItem(r, "fps")));
+                assert(cJSON_IsNull(cJSON_GetObjectItem(r, "live_applied")));
+                assert_uncommitted();
+                assert(!state.enc_tids[target] && !state.enc_tids[jpeg]);
+                assert(mode > 2 ? fake_ns == 100000000 : fake_ns == 1500000000);
+                int before = calls;
+                cJSON *retry = command(15);
+                assert(calls == before && fs_sets == 1 && enc_sets == 1);
+                cJSON_Delete(retry);
+            }
+            cJSON_Delete(r);
+        }
+    }
+    printf("Deferred dedicated/attribute FPS convergence, deadline, SDK error, FS/geometry/JPEG rejection and no early commit passed for main/H264 and sub/H265\n");
+    printf("Actual RVD FPS main/H264 and semantic sub/H265, %d failure boundaries, idempotence, alias gates and stopped persistence retry passed\n", baseline);
+    rss_config_free(state.cfg);
+    return 0;
+}
