+static int test_join(pthread_t thread, void **result)
+{
+    (void)result;
+    const char *name = thread == (pthread_t)(uintptr_t)7 ? "ivs-join" :
+        thread == (pthread_t)(uintptr_t)11 ? "jpeg-join" : "video-join";
+    return step(name) ? 11 : 0;
+}
+static int test_create(pthread_t *thread, const pthread_attr_t *attr,
+                       void *(*entry)(void *), void *arg)
+{
+    (void)attr;
+    creates++;
+    const char *name;
+    uintptr_t id;
+    if (entry == rvd_ivs_thread) {
+        assert(arg == &state);
+        name = "ivs-create";
+        id = 7;
+    } else {
+        assert(entry == rvd_encoder_thread);
+        int index = ((rvd_enc_thread_arg_t *)arg)->idx;
+        assert(index == target || index == jpeg);
+        name = index == target ? "video-create" : "jpeg-create";
+        id = index == target ? 10 : 11;
+    }
+    if (step(name)) {
+        *thread = (pthread_t)(uintptr_t)999;
+        return 11;
+    }
+    *thread = (pthread_t)id;
+    return 0;
+}
