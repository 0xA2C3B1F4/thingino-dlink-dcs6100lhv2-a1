+			srv->privacy, srv->privacy_jpeg_len, -EAGAIN, NULL, 0, now,
+			c->snap_deadline);
+		if (resolution == RHD_SNAPSHOT_PRIVACY ||
+		    resolution == RHD_SNAPSHOT_PRIVACY_UNAVAILABLE) {
+			rhd_snapshot_resolve(c);
+			if (resolution == RHD_SNAPSHOT_PRIVACY_UNAVAILABLE) {
+				http_error(c, "503 Service Unavailable", "Privacy image unavailable");
+				remove_client(srv, i);
