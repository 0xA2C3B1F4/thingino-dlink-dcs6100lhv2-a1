diff --git a/tests/test_ivs_lifecycle.c b/tests/test_ivs_lifecycle.c
new file mode 100644
index 0000000000000000000000000000000000000000..027553cc269016a8e44850741f661564cfad9c06
--- /dev/null
+++ b/tests/test_ivs_lifecycle.c
@@ -0,0 +1,423 @@
+/* Links the actual IVS and pipeline implementation against a recording HAL. */
+#include "rvd.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+static char events[8192];
+static volatile sig_atomic_t running = 1;
+int64_t rss_timestamp_us(void) { return 0; }
+static const char *fail_at;
+static const char *algorithm = "base_move";
+static int handle;
+static _Atomic int poll_calls;
+static _Atomic bool hold_poll, reader_acquired, release_reader;
+static _Atomic uint32_t reader_timeout = 20;
+static int event(const char *name)
+{
+	strcat(events, name);
+	strcat(events, " ");
+	return fail_at && strcmp(fail_at, name) == 0 ? -7 : 0;
+}
+#define CH_FN(name, label)                                                                         \
+	static int name(void *ctx, int ch)                                                         \
+	{                                                                                          \
+		(void)ctx;                                                                         \
+		(void)ch;                                                                          \
+		return event(label);                                                               \
+	}
+CH_FN(group_create, "group+")
+CH_FN(group_destroy, "group-")
+CH_FN(channel_destroy, "channel-")
+CH_FN(unregister_channel, "unregister")
+CH_FN(start, "start")
+CH_FN(stop, "stop")
+CH_FN(enc_stop, "encoder-stop")
+CH_FN(fs_disable, "fs-disable")
+CH_FN(enc_unregister, "encoder-unregister")
+CH_FN(enc_destroy, "encoder-destroy")
+CH_FN(enc_group_destroy, "encoder-group-")
+CH_FN(fs_destroy, "fs-destroy")
+
+static int channel_create(void *ctx, int ch, void *h)
+{
+	(void)ctx;
+	(void)ch;
+	assert(h == &handle);
+	return event("channel+");
+}
+static int register_channel(void *ctx, int grp, int ch)
+{
+	(void)ctx;
+	(void)grp;
+	(void)ch;
+	return event("register");
+}
+static int bind_channel(void *ctx, const rss_cell_t *a, const rss_cell_t *b)
+{
+	(void)ctx;
+	(void)a;
+	(void)b;
+	return event("bind");
+}
+static int unbind_channel(void *ctx, const rss_cell_t *a, const rss_cell_t *b)
+{
+	(void)ctx;
+	(void)a;
+	(void)b;
+	return event("unbind");
+}
+static void *interface_create(void *ctx, void *p)
+{
+	(void)ctx;
+	(void)p;
+	return event("interface+") ? NULL : &handle;
+}
+static int interface_destroy(void *ctx, void *p)
+{
+	(void)ctx;
+	assert(p == &handle);
+	return event("interface-");
+}
+static void *move_create(void *ctx, void *p)
+{
+	(void)ctx;
+	(void)p;
+	return event("move-interface+") ? NULL : &handle;
+}
+static int move_destroy(void *ctx, void *p)
+{
+	(void)ctx;
+	assert(p == &handle);
+	return event("move-interface-");
+}
+static int hal_deinit(void *ctx)
+{
+	(void)ctx;
+	return event("hal-deinit");
+}
+static int poll_result(void *ctx, int ch, uint32_t timeout_ms)
+{
+	(void)ctx;
+	(void)ch;
+	assert(timeout_ms == 1000);
+	atomic_fetch_add(&poll_calls, 1);
+	while (atomic_load(&hold_poll))
+		usleep(1000);
+	return RSS_ERR;
+}
+void rss_hal_destroy(rss_hal_ctx_t *ctx)
+{
+	(void)ctx;
+	event("hal-free");
+}
+void rss_ring_destroy(rss_ring_t *ring)
+{
+	(void)ring;
+	event("ring-");
+}
+void rvd_osd_deinit_stream(rvd_state_t *st, int idx)
+{
+	(void)st;
+	(void)idx;
+	event("osd-");
+}
+void rss_log(rss_log_level_t level, const char *file, int line, const char *fmt, ...)
+{
+	(void)level;
+	(void)file;
+	(void)line;
+	(void)fmt;
+}
+size_t rss_strlcpy(char *dst, const char *src, size_t size)
+{
+	size_t n = strlen(src);
+	if (size) {
+		size_t copy = n < size - 1 ? n : size - 1;
+		memcpy(dst, src, copy);
+		dst[copy] = 0;
+	}
+	return n;
+}
+const char *rss_config_get_str(rss_config_t *cfg, const char *s, const char *k, const char *d)
+{
+	(void)cfg;
+	(void)s;
+	return !strcmp(k, "algorithm") ? algorithm : d;
+}
+int rss_config_get_int(rss_config_t *cfg, const char *s, const char *k, int d)
+{
+	(void)cfg;
+	(void)s;
+	(void)k;
+	return d;
+}
+bool rss_config_get_bool(rss_config_t *cfg, const char *s, const char *k, bool d)
+{
+	(void)cfg;
+	(void)s;
+	(void)k;
+	return d;
+}
+
+static rss_hal_ops_t ops = {
+	.ivs_create_group = group_create,
+	.ivs_destroy_group = group_destroy,
+	.ivs_create_channel = channel_create,
+	.ivs_destroy_channel = channel_destroy,
+	.ivs_register_channel = register_channel,
+	.ivs_unregister_channel = unregister_channel,
+	.ivs_start = start,
+	.ivs_stop = stop,
+	.bind = bind_channel,
+	.unbind = unbind_channel,
+	.ivs_create_base_move_interface = interface_create,
+	.ivs_destroy_base_move_interface = interface_destroy,
+	.ivs_create_move_interface = move_create,
+	.ivs_destroy_move_interface = move_destroy,
+	.enc_stop = enc_stop,
+	.fs_disable_channel = fs_disable,
+	.enc_unregister_channel = enc_unregister,
+	.enc_destroy_channel = enc_destroy,
+	.enc_destroy_group = enc_group_destroy,
+	.fs_destroy_channel = fs_destroy,
+	.deinit = hal_deinit,
+};
+
+static void *bounded_reader(void *unused)
+{
+	(void)unused;
+	bool acquired = rvd_ivs_lock_sdk_read(atomic_load(&reader_timeout));
+	atomic_store(&reader_acquired, acquired);
+	if (acquired) {
+		while (!atomic_load(&release_reader))
+			usleep(1000);
+		rvd_ivs_unlock_sdk();
+	}
+	return NULL;
+}
+static rvd_state_t state(void)
+{
+	rvd_state_t st = {0};
+	st.ops = &ops;
+	st.running = &running;
+	st.stream_count = 2;
+	st.streams[1].enc_cfg.width = 640;
+	st.streams[1].enc_cfg.height = 360;
+	for (int i = 0; i < RVD_MAX_STREAMS; i++)
+		st.enc_shm_fd[i] = -1;
+	events[0] = 0;
+	fail_at = NULL;
+	algorithm = "base_move";
+	return st;
+}
+static void empty(rvd_state_t *st)
+{
+	assert(!st->ivs_active && !st->ivs_group_created && !st->ivs_channel_created);
+	assert(!st->ivs_registered && !st->ivs_receiving && !st->ivs_bound);
+	assert(!st->ivs_algo_handle && !st->ivs_lock_initialized);
+}
+int main(void)
+{
+	const char *failures[] = {"group+", "interface+", "register", "start", "bind"};
+	const char *expected[] = {
+		"group+ ",
+		"group+ interface+ group- ",
+		"group+ interface+ channel+ register channel- interface- group- ",
+		"group+ interface+ channel+ register start unregister channel- interface- group- ",
+		("group+ interface+ channel+ register start bind stop unregister channel- "
+		 "interface- group- "),
+	};
+	for (size_t i = 0; i < sizeof(failures) / sizeof(failures[0]); i++) {
+		rvd_state_t failed = state();
+		fail_at = failures[i];
+		int result = rvd_ivs_init(&failed);
+		if (result == 0)
+			result = rvd_ivs_start(&failed);
+		assert(result != 0);
+		empty(&failed);
+		assert(!strcmp(events, expected[i]));
+	}
+	rvd_state_t st = state();
+	assert(rvd_ivs_init(&st) == 0);
+	assert(!st.ivs_active);
+	fail_at = "channel+";
+	assert(rvd_ivs_start(&st) == -7);
+	empty(&st);
+	assert(!strcmp(events, "group+ interface+ channel+ interface- group- "));
+	size_t n = strlen(events);
+	assert(rvd_ivs_stop(&st) == 0);
+	assert(strlen(events) == n);
+
+	st = state();
+	assert(rvd_ivs_init(&st) == 0);
+	assert(rvd_ivs_start(&st) == 0);
+	assert(st.ivs_active);
+	events[0] = 0;
+	fail_at = "unregister";
+	assert(rvd_ivs_stop(&st) == -7);
+	assert(!strcmp(events, "stop unbind unregister "));
+	assert(st.ivs_registered && st.ivs_channel_created && st.ivs_group_created);
+	assert(st.ivs_algo_handle && !st.ivs_active && !st.ivs_receiving && !st.ivs_bound);
+	fail_at = NULL;
+	events[0] = 0;
+	assert(rvd_ivs_stop(&st) == 0);
+	empty(&st);
+	assert(!strcmp(events, "unregister channel- interface- group- "));
+
+	st = state();
+	assert(rvd_ivs_init(&st) == 0);
+	assert(rvd_ivs_start(&st) == 0);
+	pthread_mutex_init(&st.osd_lock, NULL);
+	st.hal_ctx = (rss_hal_ctx_t *)&handle;
+	st.streams[0].enabled = true;
+	st.streams[0].fs_enabled = true;
+	st.streams[0].ring = (rss_ring_t *)&handle;
+	events[0] = 0;
+	assert(rvd_pipeline_deinit(&st) == 0);
+	empty(&st);
+	assert(strstr(events, "stop unbind unregister channel- interface- group- ") == events);
+	assert(strstr(events, "group-") < strstr(events, "fs-disable"));
+	assert(strstr(events, "group-") < strstr(events, "encoder-stop"));
+	assert(strstr(events, "group-") < strstr(events, "encoder-destroy"));
+	assert(strstr(events, "group-") < strstr(events, "ring-"));
+
+	st = state();
+	assert(rvd_ivs_init(&st) == 0);
+	assert(rvd_ivs_start(&st) == 0);
+	events[0] = 0;
+	fail_at = "stop";
+	assert(rvd_pipeline_deinit(&st) == -7);
+	assert(!strcmp(events, "stop "));
+	assert(st.ivs_receiving && st.ivs_bound && st.ivs_group_created);
+	fail_at = NULL;
+	assert(rvd_ivs_stop(&st) == 0);
+	empty(&st);
+
+	st = state();
+	algorithm = "move";
+	assert(rvd_ivs_init(&st) == 0);
+	assert(rvd_ivs_start(&st) == 0);
+	assert(st.ivs_active && !st.ivs_base_move);
+	assert(!strcmp(events, "group+ move-interface+ channel+ register start bind "));
+	events[0] = 0;
+	assert(rvd_ivs_stop(&st) == 0);
+	empty(&st);
+	assert(!strcmp(events, "stop unbind unregister channel- move-interface- group- "));
+
+	const char *teardown[] = {"stop",     "unbind",	    "unregister",
+				  "channel-", "interface-", "group-"};
+	for (size_t failure = 0; failure < sizeof(teardown) / sizeof(teardown[0]); failure++) {
+		st = state();
+		assert(rvd_ivs_init(&st) == 0);
+		assert(rvd_ivs_start(&st) == 0);
+		events[0] = 0;
+		fail_at = teardown[failure];
+		assert(rvd_ivs_stop(&st) == -7);
+		char prefix[256] = "";
+		for (size_t i = 0; i <= failure; i++) {
+			strcat(prefix, teardown[i]);
+			strcat(prefix, " ");
+		}
+		assert(!strcmp(events, prefix));
+		assert(!st.ivs_active && st.ivs_lock_initialized && st.ivs_group_created);
+		assert(st.ivs_receiving == (failure == 0));
+		assert(st.ivs_bound == (failure <= 1));
+		assert(st.ivs_registered == (failure <= 2));
+		assert(st.ivs_channel_created == (failure <= 3));
+		assert((st.ivs_algo_handle != NULL) == (failure <= 4));
+		events[0] = 0;
+		fail_at = NULL;
+		assert(rvd_ivs_stop(&st) == 0);
+		empty(&st);
+		char suffix[256] = "";
+		for (size_t i = failure; i < sizeof(teardown) / sizeof(teardown[0]); i++) {
+			strcat(suffix, teardown[i]);
+			strcat(suffix, " ");
+		}
+		assert(!strcmp(events, suffix));
+	}
+	st = state();
+	algorithm = "move";
+	assert(rvd_ivs_set_enabled(&st, true) == 0);
+	assert(st.ivs_active && st.ivs_receiving && st.ivs_tid);
+	uint64_t previous_epoch = 0;
+	for (int i = 0; i < 25; i++) {
+		events[0] = 0;
+		assert(rvd_ivs_set_enabled(&st, true) == 0);
+		assert(!events[0]);
+		assert(rvd_ivs_set_enabled(&st, false) == 0);
+		assert(!st.ivs_active && !st.ivs_receiving && !st.ivs_tid);
+		/* Stop joined the worker, so this observes its completed start. */
+		assert(st.ivs_result_epoch > previous_epoch);
+		previous_epoch = st.ivs_result_epoch;
+		assert(st.ivs_group_created && st.ivs_channel_created && st.ivs_bound);
+		assert(!strcmp(events, "stop "));
+		assert(rvd_ivs_set_enabled(&st, false) == 0);
+		assert(!strcmp(events, "stop "));
+		assert(rvd_ivs_set_enabled(&st, true) == 0);
+		assert(!strcmp(events, "stop start "));
+	}
+	fail_at = "stop";
+	assert(rvd_ivs_set_enabled(&st, false) == -7);
+	assert(!st.ivs_active && st.ivs_receiving && !st.ivs_tid);
+	assert(rvd_ivs_set_enabled(&st, true) != 0);
+	fail_at = NULL;
+	assert(rvd_ivs_set_enabled(&st, false) == 0);
+	fail_at = "start";
+	assert(rvd_ivs_set_enabled(&st, true) == -7);
+	assert(!st.ivs_active && !st.ivs_receiving && !st.ivs_tid);
+	fail_at = NULL;
+	assert(rvd_ivs_set_enabled(&st, true) == 0);
+	assert(rvd_ivs_set_enabled(&st, false) == 0);
+	assert(rvd_ivs_stop(&st) == 0);
+	empty(&st);
+
+	st = state();
+	fail_at = "group+";
+	assert(rvd_ivs_set_enabled(&st, true) != 0);
+	empty(&st);
+
+	/* A wedged owner cannot hold a read-only control request indefinitely. */
+	pthread_t reader;
+	atomic_store(&reader_acquired, false);
+	atomic_store(&release_reader, true);
+	atomic_store(&reader_timeout, 20);
+	rvd_ivs_lock_sdk();
+	assert(pthread_create(&reader, NULL, bounded_reader, NULL) == 0);
+	assert(pthread_join(reader, NULL) == 0);
+	assert(!atomic_load(&reader_acquired));
+	rvd_ivs_unlock_sdk();
+
+	/* Once a control reader queues, an aggressive poller must hand it the SDK. */
+	st = state();
+	rss_hal_ops_t poll_ops = ops;
+	poll_ops.ivs_poll_result = poll_result;
+	st.ops = &poll_ops;
+	atomic_store(&poll_calls, 0);
+	atomic_store(&hold_poll, true);
+	atomic_store(&reader_acquired, false);
+	atomic_store(&release_reader, false);
+	atomic_store(&reader_timeout, RVD_IVS_READ_LOCK_TIMEOUT_MS);
+	atomic_store(&st.ivs_active, true);
+	pthread_t poller;
+	assert(pthread_create(&poller, NULL, rvd_ivs_thread, &st) == 0);
+	while (atomic_load(&poll_calls) == 0)
+		usleep(1000);
+	assert(pthread_create(&reader, NULL, bounded_reader, NULL) == 0);
+	for (int wait = 0; rvd_ivs_test_control_waiters() == 0 && wait < 200; ++wait)
+		usleep(1000);
+	assert(rvd_ivs_test_control_waiters() == 1);
+	atomic_store(&hold_poll, false);
+	for (int wait = 0; !atomic_load(&reader_acquired) && wait < 200; ++wait)
+		usleep(1000);
+	assert(atomic_load(&reader_acquired));
+	assert(atomic_load(&poll_calls) == 1);
+	atomic_store(&release_reader, true);
+	assert(pthread_join(reader, NULL) == 0);
+	atomic_store(&st.ivs_active, false);
+	assert(pthread_join(poller, NULL) == 0);
+	puts("IVS lifecycle tests passed");
+	return 0;
+}
