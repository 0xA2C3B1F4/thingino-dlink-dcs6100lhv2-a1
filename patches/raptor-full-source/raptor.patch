+static void test_schedule(ric_state_t *st)
+{
+    const int minutes[] = {0, 425, 1439};
+    const char *times[] = {"00:00", "07:05", "23:59"};
+    char response[8192];
+    int previous_start = st->settings.schedule_start_minute;
+    int previous_stop = st->settings.schedule_stop_minute;
+    for (size_t i = 0; i < sizeof(minutes) / sizeof(minutes[0]); ++i) {
+        st->settings.schedule_start_minute = minutes[i];
+        st->settings.schedule_stop_minute = minutes[i];
+        assert(ric_get_settings(st, response, sizeof(response)) > 0);
+        cJSON *reply = cJSON_Parse(response);
+        cJSON *schedule = cJSON_GetObjectItemCaseSensitive(reply, "schedule");
+        cJSON *values = cJSON_GetObjectItemCaseSensitive(schedule, "values");
+        assert(strcmp(cJSON_GetStringValue(cJSON_GetObjectItemCaseSensitive(
+            values, "start_at")), times[i]) == 0);
+        assert(strcmp(cJSON_GetStringValue(cJSON_GetObjectItemCaseSensitive(
+            values, "stop_at")), times[i]) == 0);
+        cJSON_Delete(reply);
+    }
+    for (int field = 0; field < 2; ++field) {
+        st->settings.schedule_start_minute = field == 0 ? -1 : 0;
+        st->settings.schedule_stop_minute = field == 1 ? 1440 : 0;
+        int writes_before = writes;
+        assert(ric_get_settings(st, response, sizeof(response)) > 0);
+        cJSON *reply = cJSON_Parse(response);
+        assert(strcmp(cJSON_GetStringValue(cJSON_GetObjectItemCaseSensitive(
+            reply, "status")), "error") == 0);
+        assert(writes == writes_before);
+        cJSON_Delete(reply);
+    }
+    st->settings.schedule_start_minute = previous_start;
+    st->settings.schedule_stop_minute = previous_stop;
+    int minute;
+    assert(ric_schedule_parse_time("07:05", &minute) && minute == 425);
+    assert(!ric_schedule_parse_time("7:05", &minute));
+    assert(!ric_schedule_parse_time("24:00", &minute));
+    assert(ric_schedule_day_at(420, 1140, 420));
+    assert(!ric_schedule_day_at(420, 1140, 1140));
+    assert(ric_schedule_day_at(1200, 360, 60));
+    assert(!ric_schedule_day_at(1200, 360, 600));
+    assert(ric_schedule_day_at(720, 720, 0));
+
+    set_policy(st, "auto", true);
+    st->settings.schedule_enabled = true;
+    st->settings.schedule_start_minute = 420;
+    st->settings.schedule_stop_minute = 1140;
+    assert(ric_schedule_apply_minute(st, 600));
+    assert(st->current_mode == RIC_MODE_DAY && st->schedule_application_ok);
+    assert(ric_schedule_apply_minute(st, 1200));
+    assert(st->current_mode == RIC_MODE_NIGHT);
+    assert(ric_schedule_apply_minute(st, 600));
+    assert(st->current_mode == RIC_MODE_DAY);
+
+    char *saved_tz = getenv("TZ") ? strdup(getenv("TZ")) : NULL;
+    st->settings.schedule_start_minute = 420;
+    st->settings.schedule_stop_minute = 540;
+    assert(setenv("TZ", "UTC0", 1) == 0);
+    tzset();
+    assert(ric_schedule_poll(st, 0));
+    assert(st->schedule_target == RIC_MODE_NIGHT && st->current_mode == RIC_MODE_NIGHT);
+    assert(setenv("TZ", "UTC-8", 1) == 0);
+    tzset();
+    assert(ric_schedule_poll(st, 0));
+    assert(st->schedule_target == RIC_MODE_DAY && st->current_mode == RIC_MODE_DAY);
+    assert(ric_schedule_poll(st, 12 * 60 * 60));
+    assert(st->schedule_target == RIC_MODE_NIGHT && st->current_mode == RIC_MODE_NIGHT);
+    if (saved_tz) {
+        assert(setenv("TZ", saved_tz, 1) == 0);
+        free(saved_tz);
+    } else {
+        assert(unsetenv("TZ") == 0);
+    }
+    tzset();
+
+    assert(!ric_schedule_poll(st, (time_t)-1));
+    char status_response[4096];
+    assert(ric_get_settings(st, status_response, sizeof(status_response)) > 0);
+    cJSON *status_root = cJSON_Parse(status_response);
+    cJSON *status_schedule = cJSON_GetObjectItemCaseSensitive(status_root, "schedule");
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(status_schedule, "active")));
+    assert(cJSON_IsNull(cJSON_GetObjectItemCaseSensitive(status_schedule, "target")));
+    assert(cJSON_IsFalse(cJSON_GetObjectItemCaseSensitive(status_schedule, "application_ok")));
+    cJSON_Delete(status_root);
+
+    set_policy(st, "night", true);
+    assert(ric_schedule_apply_minute(st, 600));
+    assert(st->current_mode == RIC_MODE_NIGHT && !st->schedule_target_known);
+
+    set_policy(st, "auto", true);
+    st->settings.schedule_start_minute = 1200;
+    st->settings.schedule_stop_minute = 360;
+    st->current_mode = RIC_MODE_NIGHT;
+    st->mode_confirmed = true;
+    assert(st->settings.opmode == RIC_AUTO && st->settings.schedule_enabled &&
+           !st->settings.sun_enabled);
+    fail_isp = true;
+    assert(!ric_schedule_apply_minute(st, 60));
+    assert(!st->schedule_application_ok && st->schedule_target_known);
+    fail_isp = false;
+    set_policy(st, "day", true);
+
+    st->settings.trigger = RIC_TRIGGER_GAIN;
+    st->settings.schedule_enabled = false;
+    rss_config_set_bool(st->cfg, "ircut", "schedule_enabled", false);
+    set_policy(st, "auto", true);
+    st->day_count = 3;
+    st->night_count = 4;
+    st->day_condition_since_us = 100;
+    st->night_condition_since_us = 200;
+    st->cooldown_remaining = 7;
+    settings_request(st,
+        "{\"cmd\":\"set-daynight-settings\",\"mode\":\"auto\",\"schedule\":{\"enabled\":true,\"start_at\":\"12:00\",\"stop_at\":\"12:00\"}}",
+        true);
+    assert(st->day_count == 0 && st->night_count == 0 &&
+           st->day_condition_since_us == 0 && st->night_condition_since_us == 0 &&
+           st->cooldown_remaining == 0);
+    st->night_condition_since_us = 300;
+    settings_request(st,
+        "{\"cmd\":\"set-daynight-settings\",\"mode\":\"auto\",\"schedule\":{\"enabled\":false,\"start_at\":\"12:00\",\"stop_at\":\"12:00\"}}",
+        true);
+    assert(st->night_condition_since_us == 0);
+
+    st->settings.schedule_enabled = true;
+    rss_config_set_bool(st->cfg, "ircut", "schedule_enabled", true);
+    set_policy(st, "night", true);
+    st->night_condition_since_us = 400;
+    st->schedule_target_known = true;
+    st->schedule_application_ok = true;
+    assert(ric_set_policy(st, RIC_AUTO));
+    assert(st->night_condition_since_us == 0 && !st->schedule_target_known &&
+           !st->schedule_application_ok);
+    assert(ric_get_settings(st, status_response, sizeof(status_response)) > 0);
+    status_root = cJSON_Parse(status_response);
+    status_schedule = cJSON_GetObjectItemCaseSensitive(status_root, "schedule");
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(status_schedule, "active")));
+    assert(cJSON_IsNull(cJSON_GetObjectItemCaseSensitive(status_schedule, "target")));
+    assert(cJSON_IsFalse(cJSON_GetObjectItemCaseSensitive(status_schedule, "application_ok")));
+    cJSON_Delete(status_root);
+    st->settings.trigger = RIC_TRIGGER_PHOTO;
+    set_policy(st, "day", true);
+    st->photo.calibrated = true;
+    st->photo.rgain_base = 123;
+    st->photo.phase = PHOTO_PHASE_INTERFERE;
+    st->settings.trigger = RIC_TRIGGER_PHOTO;
+    assert(ric_set_policy(st, RIC_AUTO));
+    assert(st->photo.phase == PHOTO_PHASE_NIGHT_DETECT);
+    assert(st->photo.calibrated && st->photo.rgain_base == 123);
+    st->settings.trigger = RIC_TRIGGER_GAIN;
+
+    settings_request(st,
+        "{\"cmd\":\"set-daynight-settings\",\"mode\":\"day\",\"schedule\":{\"enabled\":true,\"start_at\":\"12:00\",\"stop_at\":\"12:00\"}}",
+        true);
+    assert(st->settings.schedule_enabled && st->settings.schedule_start_minute == 720 &&
