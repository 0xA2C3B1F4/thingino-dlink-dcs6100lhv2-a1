@@ -0,0 +1,155 @@
+#include "rsd.h"
+#include <ctype.h>
+#include <string.h>
+#include <sys/socket.h>
+
+static bool credential_lookup(const char *username, char *out, size_t max, void *userdata)
+{
+    const rsd_credentials_t *credentials = userdata;
+    if (strcmp(username, credentials->username) != 0 || strlen(credentials->password) >= max)
+        return false;
+    rss_strlcpy(out, credentials->password, max);
+    return true;
+}
+
+Compy_Auth *rsd_auth_new(rsd_credentials_t *storage, const char *username, const char *password)
+{
+    if (!username || !password || !*username || !*password ||
+        strlen(username) >= sizeof(storage->username) || strlen(password) >= sizeof(storage->password))
+        return NULL;
+    rss_strlcpy(storage->username, username, sizeof(storage->username));
+    rss_strlcpy(storage->password, password, sizeof(storage->password));
+    return Compy_Auth_new("Raptor", credential_lookup, storage);
+}
+
+static bool endpoint_valid(const char *name, int id, rsd_server_t *srv)
+{
+    if (!*name || strlen(name) >= sizeof(srv->endpoints[0])) return false;
+    if (strcmp(name, id == 0 ? "stream0" : "stream1") == 0) return true;
+    for (const char *p = name; *p; ++p)
+        if (!((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z') ||
+              (*p >= '0' && *p <= '9') || *p == '-' || *p == '_' || *p == '.')) return false;
+    static const char *reserved[] = {"main", "sub", "jpeg", "jpeg_sub", "audio", "backchannel", ".", ".."};
+    for (size_t i = 0; i < sizeof(reserved) / sizeof(reserved[0]); ++i)
+        if (strcmp(name, reserved[i]) == 0) return false;
+    if (strncmp(name, "stream", 6) == 0 && name[6]) {
+        bool numeric = true;
+        for (const char *p = name + 6; *p; ++p) if (*p < '0' || *p > '9') numeric = false;
+        if (numeric) return false;
+    }
+    for (int i = 2; i < RSD_STREAM_COUNT; ++i)
+        if (*srv->endpoints[i] && strcmp(name, srv->endpoints[i]) == 0) return false;
+    return true;
+}
+
+static bool ini_text(const char *text, size_t min, size_t max)
+{
+    size_t size = strlen(text);
+    if (size < min || size > max || text[0] == ' ' || text[size - 1] == ' ') return false;
+    for (size_t i = 0; i < size; ++i)
+        if ((unsigned char)text[i] < 32 || (unsigned char)text[i] > 126 ||
+            (text[i] == '#' && i && text[i - 1] == ' ')) return false;
+    return true;
+}
+
+int rsd_access_status(rsd_server_t *srv, char *buf, int size)
+{
+    struct sockaddr_storage address;
+    socklen_t length = sizeof(address);
+    int listening = 0;
+    socklen_t option_length = sizeof(listening);
+    if (getsockname(srv->listen_fd, (struct sockaddr *)&address, &length) != 0 ||
+        getsockopt(srv->listen_fd, SOL_SOCKET, SO_ACCEPTCONN, &listening, &option_length) != 0 || !listening)
+        return rss_ctrl_resp_error(buf, size, "RTSP listener readback failed");
+    int port = address.ss_family == AF_INET ? ntohs(((struct sockaddr_in *)&address)->sin_port)
+        : address.ss_family == AF_INET6 ? ntohs(((struct sockaddr_in6 *)&address)->sin6_port) : -1;
+    if (port != srv->port) return rss_ctrl_resp_error(buf, size, "RTSP listener port mismatch");
+    cJSON *root = cJSON_CreateObject();
+    cJSON_AddStringToObject(root, "status", "ok");
+    cJSON_AddNumberToObject(root, "port", port);
+    cJSON_AddBoolToObject(root, "auth_enabled", srv->auth != NULL);
+    cJSON_AddStringToObject(root, "username", srv->credentials[srv->credential_slot].username);
+    cJSON_AddBoolToObject(root, "password_set", srv->auth != NULL && srv->credentials[srv->credential_slot].password[0]);
+    cJSON_AddStringToObject(root, "main", srv->endpoints[0][0] ? srv->endpoints[0] : "stream0");
+    cJSON_AddStringToObject(root, "sub", srv->endpoints[1][0] ? srv->endpoints[1] : "stream1");
+    cJSON_AddStringToObject(root, "mic", "audio");
+#ifdef COMPY_HAS_TLS
+    cJSON_AddBoolToObject(root, "tls", srv->tls_ctx != NULL);
+#else
+    cJSON_AddBoolToObject(root, "tls", false);
+#endif
+    return rss_ctrl_resp_json(buf, size, root);
+}
+
+int rsd_access_apply(rsd_server_t *srv, const char *request, char *buf, int size)
+{
+    cJSON *root = cJSON_Parse(request);
+    if (!cJSON_IsObject(root)) {
+        cJSON_Delete(root);
+        return rss_ctrl_resp_error(buf, size, "invalid access request");
+    }
+    const char *username = srv->credentials[srv->credential_slot].username;
+    const char *password = srv->credentials[srv->credential_slot].password;
+    const char *main = srv->endpoints[0][0] ? srv->endpoints[0] : "stream0";
+    const char *sub = srv->endpoints[1][0] ? srv->endpoints[1] : "stream1";
+    int port = srv->port;
+    bool valid = cJSON_GetArraySize(root) > 1;
+    cJSON *item;
+    cJSON_ArrayForEach(item, root) {
+        const char *key = item->string;
+        if (strcmp(key, "cmd") == 0) continue;
+        if (strcmp(key, "port") == 0) {
+            if (!cJSON_IsNumber(item) || item->valuedouble != item->valueint || item->valueint < 1 || item->valueint > 65535) valid = false;
+            else port = item->valueint;
+            continue;
+        }
+        if (!cJSON_IsString(item) || !item->valuestring) {
+            valid = false;
+            continue;
+        }
+        if (strcmp(key, "username") == 0) {
+            username = item->valuestring;
+            if (!ini_text(username, 1, 64) || strchr(username, ' ')) valid = false;
+        } else if (strcmp(key, "password") == 0) {
+            password = item->valuestring;
+            if (!ini_text(password, 10, 127)) valid = false;
+        } else if (strcmp(key, "main") == 0) main = item->valuestring;
+        else if (strcmp(key, "sub") == 0) sub = item->valuestring;
+        else valid = false;
+    }
+    if (!*username || !*password || !endpoint_valid(main, 0, srv) || !endpoint_valid(sub, 1, srv) || strcmp(main, sub) == 0)
+        valid = false;
+    if (!valid) {
+        cJSON_Delete(root);
+        return rss_ctrl_resp_error(buf, size, "invalid RTSP credentials, port or endpoints");
+    }
+    const char *main_alias = strcmp(main, "stream0") == 0 ? "" : main;
+    const char *sub_alias = strcmp(sub, "stream1") == 0 ? "" : sub;
+    int slot = 1 - srv->credential_slot;
+    Compy_Auth *auth = rsd_auth_new(&srv->credentials[slot], username, password);
+    if (!auth) {
+        memset(&srv->credentials[slot], 0, sizeof(srv->credentials[slot]));
+        cJSON_Delete(root);
+        return rss_ctrl_resp_error(buf, size, "RTSP authentication preparation failed");
+    }
+    if (rsd_access_activate(srv, port, auth, slot, main_alias, sub_alias) != 0) {
+        Compy_Auth_free(auth);
+        memset(&srv->credentials[slot], 0, sizeof(srv->credentials[slot]));
+        cJSON_Delete(root);
+        return rss_ctrl_resp_error(buf, size, "RTSP listener preparation failed");
+    }
+    /* Active state owns these values. Only cache exact successful values;
+     * Control performs config-save and independent disk readback separately. */
+    rss_config_set_str(srv->cfg, "rtsp", "username", srv->credentials[slot].username);
+    rss_config_set_str(srv->cfg, "rtsp", "password", srv->credentials[slot].password);
+    rss_config_set_int(srv->cfg, "rtsp", "port", port);
+    rss_config_set_str(srv->cfg, "rtsp", "endpoint_main", srv->endpoints[0]);
+    rss_config_set_str(srv->cfg, "rtsp", "endpoint_sub", srv->endpoints[1]);
+    bool cached = strcmp(rss_config_get_str(srv->cfg, "rtsp", "username", ""), srv->credentials[slot].username) == 0 &&
+        strcmp(rss_config_get_str(srv->cfg, "rtsp", "password", ""), srv->credentials[slot].password) == 0 &&
+        rss_config_get_int(srv->cfg, "rtsp", "port", 0) == port &&
+        strcmp(rss_config_get_str(srv->cfg, "rtsp", "endpoint_main", "!"), srv->endpoints[0]) == 0 &&
+        strcmp(rss_config_get_str(srv->cfg, "rtsp", "endpoint_sub", "!"), srv->endpoints[1]) == 0;
+    cJSON_Delete(root);
+    return cached ? rsd_access_status(srv, buf, size) : rss_ctrl_resp_error(buf, size, "RTSP running state changed but cache update failed");
+}
