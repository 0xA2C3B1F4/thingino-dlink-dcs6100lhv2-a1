+static void retry_failed_coil_release(ric_state_t *st, bool fail_lights)
+{
+    memset(pins, 0, sizeof(pins));
+    writes = 0;
+    fail_write = 5;
+    int pulses_before = pulses;
+    set_policy(st, "night", false);
+    assert(pulses == pulses_before + 1);
+    assert(pins[2] == 1);
+    assert(!st->mode_confirmed);
+
+    memset(zero_attempts, 0, sizeof(zero_attempts));
+    writes = 0;
+    isp_write_at = -1;
+    fail_write = fail_lights ? 3 : 0;
+    fail_isp = !fail_lights;
+    set_policy(st, fail_lights ? "day" : "night", false);
+    assert(zero_attempts[1] == 1);
+    assert(zero_attempts[2] == 1);
+    assert(pulses == pulses_before + 1);
+    assert(!st->mode_confirmed);
+    assert(strcmp(rss_config_get_str(st->cfg, "ircut", "mode", ""), "auto") == 0);
+    if (fail_lights) {
+        assert(writes == 3);
+        assert(isp_write_at == -1);
+    } else {
+        assert(writes == 2);
+        assert(isp_write_at == 2);
+    }
+    fail_write = 0;
+    fail_isp = false;
+}
