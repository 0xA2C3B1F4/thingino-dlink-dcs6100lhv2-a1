diff --git a/tests/test_fps_sdp.c b/tests/test_fps_sdp.c
new file mode 100644
index 0000000000000000000000000000000000000000..822930ae2a110e2379616e216ad15557d9ba2e1c
--- /dev/null
+++ b/tests/test_fps_sdp.c
@@ -0,0 +1,125 @@
+#include <assert.h>
+#include "../rsd/rsd_session.c"
+
+/* Actual DESCRIBE and Compy SDP serializer/string writer. Only the response
+ * boundary is captured; no RTSP server, socket or client thread is started. */
+struct Compy_Context {
+    char body[2048];
+    int responses;
+};
+static rss_ring_header_t audio_header;
+
+void compy_header(Compy_Context *ctx, CharSlice99 key, const char *restrict fmt, ...)
+{
+    (void)ctx;
+    (void)key;
+    (void)fmt;
+}
+
+void compy_body(Compy_Context *ctx, Compy_MessageBody body)
+{
+    assert(body.len < sizeof(ctx->body));
+    memcpy(ctx->body, body.ptr, body.len);
+    ctx->body[body.len] = 0;
+}
+
+ssize_t compy_respond_ok(Compy_Context *ctx)
+{
+    ctx->responses++;
+    return 0;
+}
+
+ssize_t compy_respond(Compy_Context *ctx, Compy_StatusCode code, const char *reason)
+{
+    (void)ctx;
+    (void)code;
+    (void)reason;
+    abort();
+}
+
+const rss_ring_header_t *rss_ring_get_header(rss_ring_t *ring)
+{
+    assert(ring == (rss_ring_t *)&audio_header);
+    return &audio_header;
+}
+
+static void contains(const char *sdp, const char *line)
+{
+    if (!strstr(sdp, line))
+        fprintf(stderr, "Missing SDP fragment: %s\nGenerated SDP:\n%s\n", line, sdp);
+    assert(strstr(sdp, line) != NULL);
+}
+
+int main(void)
+{
+    rsd_server_t srv = {0};
+    rsd_client_t client = {.srv = &srv, .fd = -1};
+    srv.has_audio = true;
+    srv.ring_audio = (rss_ring_t *)&audio_header;
+    strcpy(srv.session_name, "FPS test");
+    audio_header.fps_num = 16000;
+    audio_header.fps_den = 1;
+    audio_header.codec = RSD_CODEC_L16;
+    Compy_Request req = {0};
+    req.start_line.uri = CharSlice99_from_str("rtsp://localhost/main");
+    rsd_ring_ctx_t *rctx = &srv.video[0];
+    rctx->last_width = 1920;
+    rctx->last_height = 1080;
+    const char *maps[] = {"H264/90000", "H265/90000", "JPEG/90000", "JPEG/90000"};
+    for (uint32_t codec = 0; codec <= 3; codec++) {
+        for (int params = 0; params <= 1; params++) {
+            rctx->last_codec = codec;
+            memcpy(rctx->vps, "\x40\x01\x02\x03", 4);
+            memcpy(rctx->sps, "\x67\x64\x00\x28", 4);
+            memcpy(rctx->pps, "\x68\x01", 2);
+            rctx->vps_len = params ? 4 : 0;
+            rctx->sps_len = params ? 4 : 0;
+            rctx->pps_len = params ? 2 : 0;
+            Compy_Context ctx = {0};
+            rsd_client_t_describe(&client, &ctx, &req);
+            assert(ctx.responses == 1);
+            assert(strstr(ctx.body, "a=framerate:") == NULL);
+            contains(ctx.body, "m=video 0 RTP/AVP ");
+            contains(ctx.body, maps[codec]);
+            contains(ctx.body, "a=control:video\r\n");
+            contains(ctx.body, "a=control:*\r\n");
+            contains(ctx.body, "L16/16000/1\r\n");
+            contains(ctx.body, "a=control:audio\r\n");
+            if (codec == 0) {
+                contains(ctx.body, "packetization-mode=1;profile-level-id=640028");
+                if (params)
+                    contains(ctx.body, "sprop-parameter-sets=Z2QAKA==,aAE=");
+            }
+            if (codec == 1 && params)
+                contains(ctx.body, "sprop-vps=QAECAw==;sprop-sps=Z2QAKA==;sprop-pps=aAE=");
+        }
+    }
+    const struct {
+        uint32_t codec;
+        uint32_t rate;
+        const char *media;
+        const char *mapping;
+    } audio_cases[] = {
+        {RSD_CODEC_PCMU, 8000, "m=audio 0 RTP/AVP 0\r\n", NULL},
+        {RSD_CODEC_PCMA, 8000, "m=audio 0 RTP/AVP 8\r\n", NULL},
+        {RSD_CODEC_AAC, 44100, "m=audio 0 RTP/AVP 97\r\n", "mpeg4-generic/44100/1\r\n"},
+        {RSD_CODEC_OPUS, 48000, "m=audio 0 RTP/AVP 111\r\n", "opus/48000/2\r\n"},
+        {RSD_CODEC_L16, 16000, "m=audio 0 RTP/AVP 98\r\n", "L16/16000/1\r\n"},
+    };
+    for (size_t i = 0; i < sizeof(audio_cases) / sizeof(audio_cases[0]); i++) {
+        audio_header.codec = audio_cases[i].codec;
+        atomic_store(&audio_header.fps_num, audio_cases[i].rate);
+        Compy_Context ctx = {0};
+        rsd_client_t_describe(&client, &ctx, &req);
+        assert(ctx.responses == 1);
+        assert(strstr(ctx.body, "a=framerate:") == NULL);
+        contains(ctx.body, audio_cases[i].media);
+        if (audio_cases[i].mapping)
+            contains(ctx.body, audio_cases[i].mapping);
+        contains(ctx.body, "a=control:audio\r\n");
+        if (audio_cases[i].codec == RSD_CODEC_AAC)
+            contains(ctx.body, "mode=AAC-hbr;sizelength=13;indexlength=3;indexdeltalength=3;config=1208");
+    }
+    puts("Actual video and audio SDP branches passed");
+    return 0;
+}
