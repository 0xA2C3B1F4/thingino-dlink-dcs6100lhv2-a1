+TEST access_unit_marker_is_explicit(void) {
+    FragTestCtx ctx;
+    frag_setup(&ctx, 1200, 4096);
+
+    uint8_t payload[5] = {0x01, 0x02, 0x03, 0x04, 0x05};
+    Compy_NalUnit nalu = {
+        .header = Compy_NalHeader_H264(Compy_H264NalHeader_parse(0x65)),
+        .payload = U8Slice99_new(payload, sizeof payload),
+    };
+    Compy_RtpTimestamp timestamp = Compy_RtpTimestamp_Raw(90000);
+
+    ASSERT_EQ(
+        0,
+        Compy_NalTransport_send_packet_with_marker(
+            ctx.nal, timestamp, nalu, false));
+    ASSERT_EQ(
+        0,
+        Compy_NalTransport_send_packet_with_marker(
+            ctx.nal, timestamp, nalu, true));
+
+    TestPacketCapture cap;
+    capture_init(&cap);
+    capture_recv_all(&cap, ctx.fds[1]);
+    ASSERT_EQ(2, cap.count);
+    ASSERT_FALSE(packet_rtp_marker(&cap.packets[0]));
+    ASSERT(packet_rtp_marker(&cap.packets[1]));
+
+    frag_teardown(&ctx);
+    PASS();
+}
+
+TEST fragmented_nonfinal_nalu_has_no_marker(void) {
+    FragTestCtx ctx;
+    frag_setup(&ctx, 20, 20);
+
+    uint8_t payload[100] = {0};
+    Compy_NalUnit nalu = {
+        .header = Compy_NalHeader_H264(Compy_H264NalHeader_parse(0x65)),
+        .payload = U8Slice99_new(payload, sizeof payload),
+    };
+    ASSERT_EQ(
+        0,
+        Compy_NalTransport_send_packet_with_marker(
+            ctx.nal, Compy_RtpTimestamp_Raw(90000), nalu, false));
+
+    TestPacketCapture cap;
+    capture_init(&cap);
+    capture_recv_all(&cap, ctx.fds[1]);
+    ASSERT(cap.count >= 2);
+    for (int i = 0; i < cap.count; i++) {
+        ASSERT_FALSE(packet_rtp_marker(&cap.packets[i]));
+    }
+
+    frag_teardown(&ctx);
+    PASS();
+}
