+int rss_ring_check_video_fps(rss_ring_t *ring, uint32_t fps_num)
+{
+    if (!ring || !ring->header || !ring->is_producer)
+        return -EINVAL;
+    rss_ring_header_t *h = ring->header;
+    if (h->version != RSS_RING_VERSION)
+        return -EPROTO;
+    if (!atomic_is_lock_free(&h->fps_num))
+        return -ENOTSUP;
+    if (h->stream_id > 5 || h->codec > 1 || !h->width || !h->height || h->fps_den != 1)
+        return -ENOTSUP;
+    if (fps_num < 1 || fps_num > 30)
+        return -ERANGE;
+    return 0;
+}
+
+int rss_ring_set_video_fps(rss_ring_t *ring, uint32_t fps_num)
+{
+    int ret = rss_ring_check_video_fps(ring, fps_num);
+    if (ret != 0)
+        return ret;
+    /* No dependent data is published with this value. Denominator is immutable. */
+    atomic_store_explicit(&ring->header->fps_num, fps_num, memory_order_relaxed);
+    return 0;
+}
+
+int rss_ring_get_fps(rss_ring_t *ring, uint32_t *fps_num, uint32_t *fps_den)
+{
+    if (!ring || !ring->header || !fps_num || !fps_den || fps_num == fps_den)
+        return -EINVAL;
+    const rss_ring_header_t *h = ring->header;
+    if (h->version != RSS_RING_VERSION)
+        return -EPROTO;
+    if (!atomic_is_lock_free(&h->fps_num))
+        return -ENOTSUP;
+    uint32_t num = atomic_load_explicit(&h->fps_num, memory_order_relaxed);
+    uint32_t den = h->fps_den;
+    if (!num || !den)
+        return -ERANGE;
+    *fps_num = num;
+    *fps_den = den;
+    return 0;
+}
