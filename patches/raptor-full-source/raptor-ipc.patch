diff --git a/tests/test_fps.c b/tests/test_fps.c
new file mode 100644
index 0000000000000000000000000000000000000000..96fe439f3a954517afdddea8bdac4756ef46e177
--- /dev/null
+++ b/tests/test_fps.c
@@ -0,0 +1,164 @@
+#include <assert.h>
+#include <stdarg.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdbool.h>
+static bool force_non_lock_free;
+#undef atomic_is_lock_free
+#define atomic_is_lock_free(p) (!force_non_lock_free && __atomic_is_lock_free(sizeof(*(p)), (p)))
+
+/* No futex, mapping, device or SHM operation is needed by the actual metadata
+ * API. Compile the complete ring TU and fail if it reaches a syscall. */
+static long test_syscall(long number, ...)
+{
+    (void)number;
+    abort();
+}
+#define syscall test_syscall
+#ifndef SYS_futex
+#define SYS_futex 202
+#endif
+#include "../src/rss_ring.c"
+#undef syscall
+
+static rss_ring_header_t header;
+static rss_ring_t producer;
+static rss_ring_t consumer;
+
+static void reset(void)
+{
+    header = (rss_ring_header_t){0};
+    header.version = RSS_RING_VERSION;
+    producer = (rss_ring_t){.header = &header, .is_producer = true};
+    consumer = (rss_ring_t){.header = &header};
+    rss_ring_set_stream_info(&producer, 0, 0, 1920, 1080, 25, 1, 100, 40);
+}
+
+static void expect_rate(uint32_t num, uint32_t den)
+{
+    uint32_t n = 99;
+    uint32_t d = 99;
+    assert(rss_ring_get_fps(&consumer, &n, &d) == 0);
+    assert(n == num);
+    assert(d == den);
+}
+
+static void unchanged_failure(int result)
+{
+    unsigned char before[sizeof(header)];
+    memcpy(before, &header, sizeof(header));
+    assert(rss_ring_check_video_fps(&producer, 15) == result);
+    assert(memcmp(before, &header, sizeof(header)) == 0);
+    assert(rss_ring_set_video_fps(&producer, 15) == result);
+    assert(memcmp(before, &header, sizeof(header)) == 0);
+}
+
+static void *writer(void *unused)
+{
+    (void)unused;
+    for (unsigned i = 0; i < 100000; i++)
+        assert(rss_ring_set_video_fps(&producer, i % 30 + 1) == 0);
+    return NULL;
+}
+
+int main(void)
+{
+    reset();
+    assert(atomic_is_lock_free(&header.fps_num));
+    assert(sizeof(header) == 192);
+    unsigned char before[sizeof(header)];
+    memcpy(before, &header, sizeof(header));
+    for (uint32_t n = 1; n <= 30; n++) {
+        unsigned char snapshot[sizeof(header)];
+        memcpy(snapshot, &header, sizeof(header));
+        assert(rss_ring_check_video_fps(&producer, n) == 0);
+        assert(memcmp(snapshot, &header, sizeof(header)) == 0);
+        assert(rss_ring_set_video_fps(&producer, n) == 0);
+        expect_rate(n, 1);
+        /* All bytes outside the sole mutable atomic remain untouched.
+         * This byte comparison runs without concurrent accesses. */
+        size_t offset = offsetof(rss_ring_header_t, fps_num);
+        size_t end = offset + sizeof(header.fps_num);
+        assert(memcmp(before, &header, offset) == 0);
+        assert(memcmp(before + end, (unsigned char *)&header + end,
+                      sizeof(header) - end) == 0);
+    }
+    const uint32_t invalid[] = {0, 31, UINT32_MAX};
+    for (size_t i = 0; i < sizeof(invalid) / sizeof(invalid[0]); i++) {
+        memcpy(before, &header, sizeof(header));
+        assert(rss_ring_check_video_fps(&producer, invalid[i]) == -ERANGE);
+        assert(memcmp(before, &header, sizeof(header)) == 0);
+        assert(rss_ring_set_video_fps(&producer, invalid[i]) == -ERANGE);
+        assert(memcmp(before, &header, sizeof(header)) == 0);
+    }
+    assert(rss_ring_set_video_fps(NULL, 15) == -EINVAL);
+    assert(rss_ring_check_video_fps(NULL, 15) == -EINVAL);
+    assert(rss_ring_check_video_fps(&consumer, 15) == -EINVAL);
+    assert(rss_ring_set_video_fps(&consumer, 15) == -EINVAL);
+    expect_rate(30, 1);
+    producer.header = NULL;
+    unchanged_failure(-EINVAL);
+    producer.header = &header;
+    force_non_lock_free = true;
+    unchanged_failure(-ENOTSUP);
+    force_non_lock_free = false;
+    header.version--;
+    unchanged_failure(-EPROTO);
+    uint32_t n = 111;
+    uint32_t d = 222;
+    assert(rss_ring_get_fps(&consumer, &n, &d) == -EPROTO);
+    assert(n == 111 && d == 222);
+    reset();
+    header.width = 0;
+    unchanged_failure(-ENOTSUP);
+    reset();
+    header.height = 0;
+    unchanged_failure(-ENOTSUP);
+    reset();
+    header.codec = 2;
+    unchanged_failure(-ENOTSUP);
+    reset();
+    header.stream_id = 6;
+    unchanged_failure(-ENOTSUP);
+    reset();
+    header.stream_id = 5;
+    header.codec = 1;
+    assert(rss_ring_set_video_fps(&producer, 12) == 0);
+    expect_rate(12, 1);
+    reset();
+    rss_ring_set_stream_info(&producer, 1, 1, 1280, 720, 30000, 1001, 0, 0);
+    expect_rate(30000, 1001);
+    unchanged_failure(-ENOTSUP);
+    rss_ring_set_stream_info(&producer, 1, 0, 1280, 720, 1, 2, 0, 0);
+    expect_rate(1, 2);
+    unchanged_failure(-ENOTSUP);
+    rss_ring_set_stream_info(&producer, 0x10, 0, 0, 0, 48000, 1, 5, 0);
+    expect_rate(48000, 1);
+    unchanged_failure(-ENOTSUP);
+    assert(header.fps_num == 48000); /* Existing direct audio load semantics. */
+    assert(rss_ring_get_fps(NULL, &n, &d) == -EINVAL);
+    assert(rss_ring_get_fps(&consumer, NULL, &d) == -EINVAL);
+    assert(rss_ring_get_fps(&consumer, &n, NULL) == -EINVAL);
+    assert(rss_ring_get_fps(&consumer, &n, &n) == -EINVAL);
+    assert(n == 111 && d == 222);
+    header.fps_den = 0;
+    unchanged_failure(-ENOTSUP);
+    assert(rss_ring_get_fps(&consumer, &n, &d) == -ERANGE);
+    assert(n == 111 && d == 222);
+    header.fps_den = 1;
+    atomic_store(&header.fps_num, 0);
+    assert(rss_ring_get_fps(&consumer, &n, &d) == -ERANGE);
+    assert(n == 111 && d == 222);
+    reset();
+    pthread_t thread;
+    assert(pthread_create(&thread, NULL, writer, NULL) == 0);
+    for (unsigned i = 0; i < 100000; i++) {
+        assert(rss_ring_get_fps(&consumer, &n, &d) == 0);
+        assert(n >= 1 && n <= 30 && d == 1);
+    }
+    assert(pthread_join(thread, NULL) == 0);
+    puts("Actual IPC FPS setter/getter, layout and concurrent reads passed");
+    return 0;
+}
