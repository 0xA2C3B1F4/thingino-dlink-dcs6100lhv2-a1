+#include "hal_internal.h"
+#include <assert.h>
+#include <stdio.h>
+
+extern int hal_isp_set_wb(void *, const rss_wb_config_t *);
+extern int hal_isp_get_wb(void *, rss_wb_config_t *);
+
+static IMPISPWB hardware;
+static int set_result, get_result, set_calls, get_calls;
+
+int IMP_ISP_Tuning_SetWB(IMPISPWB *value)
+{
+    set_calls++;
+    if (set_result) return set_result;
+    hardware = *value;
+    return RSS_OK;
+}
+
+int IMP_ISP_Tuning_GetWB(IMPISPWB *value)
+{
+    get_calls++;
+    if (get_result) return get_result;
+    *value = hardware;
+    return RSS_OK;
+}
+
+int main(void)
+{
+    rss_wb_config_t requested = {.mode = RSS_WB_MANUAL, .r_gain = 300, .b_gain = 400};
+    assert(hal_isp_set_wb(NULL, &requested) == RSS_OK);
+    assert(set_calls == 1 && hardware.mode == ISP_CORE_WB_MODE_MANUAL &&
+           hardware.rgain == 300 && hardware.bgain == 400);
+    rss_wb_config_t observed = {0};
+    assert(hal_isp_get_wb(NULL, &observed) == RSS_OK);
+    assert(get_calls == 1 && observed.mode == RSS_WB_MANUAL &&
+           observed.r_gain == 300 && observed.b_gain == 400);
+    requested = (rss_wb_config_t){.mode = RSS_WB_DAYLIGHT, .r_gain = 128, .b_gain = 128};
+    assert(hal_isp_set_wb(NULL, &requested) == RSS_OK);
+    assert(hal_isp_get_wb(NULL, &observed) == RSS_OK && observed.mode == RSS_WB_DAYLIGHT);
+    set_result = -7;
+    assert(hal_isp_set_wb(NULL, &requested) == -7);
+    get_result = -8;
+    assert(hal_isp_get_wb(NULL, &observed) == -8);
+    assert(hal_isp_set_wb(NULL, NULL) == RSS_ERR_INVAL);
+    assert(hal_isp_get_wb(NULL, NULL) == RSS_ERR_INVAL);
+    puts("T31 grouped White Balance uses exact SetWB/GetWB values and errors");
+    return 0;
+}
