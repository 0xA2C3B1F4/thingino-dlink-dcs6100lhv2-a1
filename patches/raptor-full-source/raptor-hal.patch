+           before->pixFmt == after->pixFmt &&
+           before->crop.enable == after->crop.enable &&
+           before->crop.left == after->crop.left &&
+           before->crop.top == after->crop.top &&
+           before->crop.width == after->crop.width &&
+           before->crop.height == after->crop.height &&
