+/* Compare declared fields, including stored coordinates of disabled crops.
+ * Struct padding is not SDK state and must not participate in this check. */
+static bool hal_fs_same_non_rate_attr(const IMPFSChnAttr *before, const IMPFSChnAttr *after)
+{
+    return before->picWidth == after->picWidth &&
