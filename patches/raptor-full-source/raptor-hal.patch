+static ivs_owned_param_t ivs_owned_params[IVS_OWNED_PARAM_SLOTS];
+static pthread_mutex_t ivs_owned_params_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static bool ivs_own_param(void *handle, void *param)
+{
+    bool stored = false;
+    pthread_mutex_lock(&ivs_owned_params_lock);
+    for (int i = 0; i < IVS_OWNED_PARAM_SLOTS; i++) {
+        if (!ivs_owned_params[i].handle) {
+            ivs_owned_params[i].handle = handle;
+            ivs_owned_params[i].param = param;
+            stored = true;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&ivs_owned_params_lock);
+    return stored;
+}
+
+static void *ivs_take_param(void *handle)
+{
+    void *param = NULL;
+    pthread_mutex_lock(&ivs_owned_params_lock);
+    for (int i = 0; i < IVS_OWNED_PARAM_SLOTS; i++) {
+        if (ivs_owned_params[i].handle == handle) {
+            param = ivs_owned_params[i].param;
+            ivs_owned_params[i].handle = NULL;
+            ivs_owned_params[i].param = NULL;
+            break;
+        }
