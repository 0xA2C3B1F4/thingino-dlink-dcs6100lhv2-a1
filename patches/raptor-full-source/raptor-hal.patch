+           before->scaler.outheight == after->scaler.outheight &&
+           before->nrVBs == after->nrVBs &&
+           before->type == after->type &&
+           before->fcrop.enable == after->fcrop.enable &&
+           before->fcrop.left == after->fcrop.left &&
