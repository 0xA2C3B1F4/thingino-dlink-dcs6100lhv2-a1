+#include <assert.h>
+#include <errno.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "hal_internal.h"
+
+extern int hal_fs_get_nr_vbs(void *ctx, int chn, uint32_t *nr_vbs);
+
+static int sdk_result;
+static int sdk_nr_vbs;
+static int expected_channel;
+static int log_calls;
+
+static void log_error(int level, const char *file, int line, const char *fmt, ...)
+{
+    assert(level == HAL_LOG_LVL_ERR);
+    assert(file && line > 0 && fmt);
+    log_calls++;
+}
+
+rss_hal_log_func_t rss_hal_log_fn = log_error;
+
+int IMP_FrameSource_GetChnAttr(int channel, IMPFSChnAttr *attr)
+{
+    assert(channel == expected_channel);
+    assert(attr);
+    if (sdk_result)
+        return sdk_result;
+    memset(attr, 0, sizeof(*attr));
+    attr->nrVBs = sdk_nr_vbs;
+    return 0;
+}
+
+int main(void)
+{
+    expected_channel = 4;
+    uint32_t value = 99;
+
+    sdk_nr_vbs = 1;
+    assert(hal_fs_get_nr_vbs(NULL, expected_channel, &value) == 0);
+    assert(value == 1);
+
+    sdk_nr_vbs = 3;
+    assert(hal_fs_get_nr_vbs(NULL, expected_channel, &value) == 0);
+    assert(value == 3);
+
+    value = 77;
+    sdk_nr_vbs = 0;
+    assert(hal_fs_get_nr_vbs(NULL, expected_channel, &value) == -ERANGE);
+    assert(value == 77);
+    sdk_nr_vbs = -1;
+    assert(hal_fs_get_nr_vbs(NULL, expected_channel, &value) == -ERANGE);
+    assert(value == 77);
+
+    sdk_result = -17;
+    assert(hal_fs_get_nr_vbs(NULL, expected_channel, &value) == -17);
+    assert(value == 77);
+    assert(log_calls == 1);
+    sdk_result = 0;
+    assert(hal_fs_get_nr_vbs(NULL, expected_channel, NULL) == -EINVAL);
+
+    puts("T31 FrameSource nrVBs readback checks passed");
+    return 0;
+}
diff --git a/tests/test_fs_set_fps.c b/tests/test_fs_set_fps.c
new file mode 100644
index 0000000000000000000000000000000000000000..66c1cf20318ef0b41924ae57c6e5bc20cb8c1340
--- /dev/null
+++ b/tests/test_fs_set_fps.c
@@ -0,0 +1,296 @@
+#include "hal_internal.h"
+#include <assert.h>
+#include <limits.h>
+
+extern int hal_fs_set_fps(void *ctx, int chn, uint32_t num, uint32_t den);
+
+_Static_assert(_Generic(((IMPFSChnAttr *)0)->outFrmRateNum, int: 1, default: 0),
+               "T31 1.1.4 numerator is signed int");
+_Static_assert(_Generic(((IMPFSChnAttr *)0)->outFrmRateDen, int: 1, default: 0),
+               "T31 1.1.4 denominator is signed int");
+
+static IMPFSChnAttr original;
+static IMPFSChnAttr live;
+static int get_calls;
+static int set_calls;
+static int initial_error;
+static int set_error;
+static int final_error;
+static int changed_field;
+static bool partial_initial_get;
+static bool partial_final_get;
+static uint32_t expected_num;
+static uint32_t expected_den;
+static int expected_channel;
+
+static void log_error(int level, const char *file, int line, const char *fmt, ...)
+{
+    assert(level == HAL_LOG_LVL_ERR);
+    assert(file != NULL);
+    assert(line > 0);
+    assert(fmt != NULL);
+}
+
+rss_hal_log_func_t rss_hal_log_fn = log_error;
+
+static void assert_non_rate_equal(const IMPFSChnAttr *a, const IMPFSChnAttr *b)
+{
+    assert(a->picWidth == b->picWidth);
+    assert(a->picHeight == b->picHeight);
+    assert(a->pixFmt == b->pixFmt);
+    assert(a->crop.enable == b->crop.enable);
+    assert(a->crop.left == b->crop.left);
+    assert(a->crop.top == b->crop.top);
+    assert(a->crop.width == b->crop.width);
+    assert(a->crop.height == b->crop.height);
+    assert(a->scaler.enable == b->scaler.enable);
+    assert(a->scaler.outwidth == b->scaler.outwidth);
+    assert(a->scaler.outheight == b->scaler.outheight);
+    assert(a->nrVBs == b->nrVBs);
+    assert(a->type == b->type);
+    assert(a->fcrop.enable == b->fcrop.enable);
+    assert(a->fcrop.left == b->fcrop.left);
+    assert(a->fcrop.top == b->fcrop.top);
+    assert(a->fcrop.width == b->fcrop.width);
+    assert(a->fcrop.height == b->fcrop.height);
+}
+
+/* One independent readback mutation for every declared non-rate field. */
+static void mutate_field(IMPFSChnAttr *attr, int field)
+{
+    switch (field) {
+    case 0:
+        attr->picWidth++;
+        break;
+    case 1:
+        attr->picHeight++;
+        break;
+    case 2:
+        attr->pixFmt = PIX_FMT_YUYV422;
+        break;
+    case 3:
+        attr->crop.enable = !attr->crop.enable;
+        break;
+    case 4:
+        attr->crop.left++;
+        break;
+    case 5:
+        attr->crop.top++;
+        break;
+    case 6:
+        attr->crop.width++;
+        break;
+    case 7:
+        attr->crop.height++;
+        break;
+    case 8:
+        attr->scaler.enable = !attr->scaler.enable;
+        break;
+    case 9:
+        attr->scaler.outwidth++;
+        break;
+    case 10:
+        attr->scaler.outheight++;
+        break;
+    case 11:
+        attr->nrVBs++;
+        break;
+    case 12:
+        attr->type = FS_PHY_CHANNEL;
+        break;
+    case 13:
+        attr->fcrop.enable = !attr->fcrop.enable;
+        break;
+    case 14:
+        attr->fcrop.left++;
+        break;
+    case 15:
+        attr->fcrop.top++;
+        break;
+    case 16:
+        attr->fcrop.width++;
+        break;
+    case 17:
+        attr->fcrop.height++;
+        break;
+    case 18:
+        attr->outFrmRateNum++;
+        break;
+    case 19:
+        attr->outFrmRateDen++;
+        break;
+    case 20:
+        /* Equivalent normalized rate is not exact requested readback. */
+        attr->outFrmRateNum = 15;
+        attr->outFrmRateDen = 1;
+        break;
+    default:
+        assert(field == -1);
+    }
+}
+
+int IMP_FrameSource_GetChnAttr(int channel, IMPFSChnAttr *attr)
+{
+    assert(channel == expected_channel);
+    assert(attr != NULL);
+    IMPFSChnAttr zero = {0};
+    assert_non_rate_equal(attr, &zero);
+    assert(attr->outFrmRateNum == 0);
+    assert(attr->outFrmRateDen == 0);
+    get_calls++;
+    assert(get_calls <= 2);
+    if (get_calls == 1) {
+        assert(set_calls == 0);
+        if (partial_initial_get)
+            attr->outFrmRateNum = original.outFrmRateNum;
+        else
+            *attr = original;
+        return initial_error;
+    }
+    assert(set_calls == 1);
+    if (partial_final_get)
+        attr->outFrmRateNum = live.outFrmRateNum;
+    else
+        *attr = live;
+    mutate_field(attr, changed_field);
+    return final_error;
+}
+
+int IMP_FrameSource_SetChnAttr(int channel, const IMPFSChnAttr *attr)
+{
+    assert(channel == expected_channel);
+    assert(attr != NULL);
+    assert(get_calls == 1);
+    assert(set_calls == 0);
+    set_calls++;
+    assert_non_rate_equal(attr, &original);
+    assert(attr->outFrmRateNum == (int)expected_num);
+    assert(attr->outFrmRateDen == (int)expected_den);
+    /* Simulate application even when Set returns an error. No rollback is
+     * promised, and the implementation must not issue a corrective Set. */
+    live = *attr;
+    return set_error;
+}
+
+static void reset(void)
+{
+    original = (IMPFSChnAttr){
+        .picWidth = 1920,
+        .picHeight = 1080,
+        .pixFmt = PIX_FMT_NV12,
+        .crop = {.enable = 0, .left = 5, .top = 7, .width = 1900, .height = 1040},
+        .scaler = {.enable = 1, .outwidth = 1280, .outheight = 720},
+        .outFrmRateNum = 25,
+        .outFrmRateDen = 1,
+        .nrVBs = 6,
+        .type = FS_EXT_CHANNEL,
+        .fcrop = {.enable = 1, .left = 9, .top = 11, .width = 1260, .height = 700},
+    };
+    live = original;
+    get_calls = 0;
+    set_calls = 0;
+    initial_error = 0;
+    set_error = 0;
+    final_error = 0;
+    changed_field = -1;
+    partial_initial_get = false;
+    partial_final_get = false;
+    expected_num = 30;
+    expected_den = 2;
+    expected_channel = 7;
+}
+
+static int set_rate(uint32_t num, uint32_t den)
+{
+    const rss_hal_ops_t ops = {.fs_set_fps = hal_fs_set_fps};
+    expected_num = num;
+    expected_den = den;
+    return ops.fs_set_fps(NULL, expected_channel, num, den);
+}
+
+int main(void)
+{
+    const uint32_t ratios[][2] = {
+        {15, 1}, {30000, 1001}, {30, 2}, {1, INT_MAX}, {INT_MAX, 1}, {INT_MAX, INT_MAX},
+    };
+    for (size_t i = 0; i < sizeof(ratios) / sizeof(ratios[0]); i++) {
+        reset();
+        assert(set_rate(ratios[i][0], ratios[i][1]) == 0);
+        assert(get_calls == 2);
+        assert(set_calls == 1);
+        assert_non_rate_equal(&live, &original);
+        assert(live.outFrmRateNum == (int)ratios[i][0]);
+        assert(live.outFrmRateDen == (int)ratios[i][1]);
+    }
+    const uint32_t invalid[][2] = {
+        {0, 1}, {1, 0}, {0, 0}, {UINT32_MAX, 1}, {1, UINT32_MAX},
+        {(uint32_t)INT_MAX + 1, 1}, {1, (uint32_t)INT_MAX + 1},
+    };
+    for (size_t i = 0; i < sizeof(invalid) / sizeof(invalid[0]); i++) {
+        reset();
+        int expected = invalid[i][0] == 0 || invalid[i][1] == 0 ? -EINVAL : -ERANGE;
+        assert(set_rate(invalid[i][0], invalid[i][1]) == expected);
+        assert(get_calls == 0);
+        assert(set_calls == 0);
+    }
+    const int invalid_live[][2] = {{0, 1}, {-1, 1}, {25, 0}, {25, -1}, {INT_MIN, INT_MIN}};
+    for (size_t i = 0; i < sizeof(invalid_live) / sizeof(invalid_live[0]); i++) {
+        reset();
+        original.outFrmRateNum = invalid_live[i][0];
+        original.outFrmRateDen = invalid_live[i][1];
+        assert(set_rate(15, 1) == -ERANGE);
+        assert(get_calls == 1);
+        assert(set_calls == 0);
+    }
+    const int errors[] = {-42, 9};
+    for (size_t i = 0; i < sizeof(errors) / sizeof(errors[0]); i++) {
+        reset();
+        initial_error = errors[i];
+        assert(set_rate(15, 1) == errors[i]);
+        assert(get_calls == 1);
+        assert(set_calls == 0);
+        reset();
+        set_error = errors[i];
+        assert(set_rate(15, 1) == errors[i]);
+        assert(get_calls == 1);
+        assert(set_calls == 1);
+        assert(live.outFrmRateNum == 15);
+        reset();
+        final_error = errors[i];
+        assert(set_rate(15, 1) == errors[i]);
+        assert(get_calls == 2);
+        assert(set_calls == 1);
+        assert(live.outFrmRateNum == 15);
+    }
+    for (int field = 0; field <= 20; field++) {
+        reset();
+        changed_field = field;
+        assert(set_rate(30, 2) == -EIO);
+        assert(get_calls == 2);
+        assert(set_calls == 1);
+    }
+    reset();
+    partial_initial_get = true;
+    assert(set_rate(15, 1) == -ERANGE);
+    assert(get_calls == 1);
+    assert(set_calls == 0);
+    reset();
+    partial_final_get = true;
+    assert(set_rate(15, 1) == -EIO);
+    assert(get_calls == 2);
+    assert(set_calls == 1);
+    reset();
+    original.crop.enable = 1;
+    original.scaler.enable = 0;
+    original.fcrop.enable = 0;
+    assert(set_rate(25, 1) == 0);
+    assert_non_rate_equal(&live, &original);
+    reset();
+    expected_channel = -1;
+    initial_error = -22;
+    assert(set_rate(15, 1) == -22);
+    assert(get_calls == 1);
+    assert(set_calls == 0);
+    puts("FrameSource FPS live attribute preservation and failure checks passed");
+    return 0;
+}
diff --git a/tests/test_isp_antiflicker.c b/tests/test_isp_antiflicker.c
new file mode 100644
index 0000000000000000000000000000000000000000..e6b712638108107e51859c08b2881b7169a26b72
--- /dev/null
+++ b/tests/test_isp_antiflicker.c
@@ -0,0 +1,47 @@
+#include "hal_internal.h"
+#include <assert.h>
+#include <stdio.h>
+
+extern int hal_isp_set_antiflicker(void *, rss_antiflicker_t);
+extern int hal_isp_get_antiflicker(void *, rss_antiflicker_t *);
+
+static IMPISPAntiflickerAttr hardware;
+static int set_result, get_result, set_calls, get_calls;
+
+int IMP_ISP_Tuning_SetAntiFlickerAttr(IMPISPAntiflickerAttr value)
+{
+    set_calls++;
+    if (set_result) return set_result;
+    hardware = value;
+    return RSS_OK;
+}
+
+int IMP_ISP_Tuning_GetAntiFlickerAttr(IMPISPAntiflickerAttr *value)
+{
+    get_calls++;
+    if (get_result) return get_result;
+    *value = hardware;
+    return RSS_OK;
+}
+
+int main(void)
+{
+    rss_antiflicker_t observed = RSS_ANTIFLICKER_OFF;
+    for (int mode = RSS_ANTIFLICKER_OFF; mode <= RSS_ANTIFLICKER_60HZ; ++mode) {
+        assert(hal_isp_set_antiflicker(NULL, (rss_antiflicker_t)mode) == RSS_OK);
+        assert((int)hardware == mode);
+        assert(hal_isp_get_antiflicker(NULL, &observed) == RSS_OK);
+        assert((int)observed == mode);
+    }
+    assert(set_calls == 3 && get_calls == 3);
+    hardware = IMPISP_ANTIFLICKER_BUTT;
+    assert(hal_isp_get_antiflicker(NULL, &observed) == RSS_ERR);
+    get_result = -8;
+    assert(hal_isp_get_antiflicker(NULL, &observed) == -8);
+    get_result = 0;
+    set_result = -7;
+    assert(hal_isp_set_antiflicker(NULL, RSS_ANTIFLICKER_50HZ) == -7);
+    assert(hal_isp_get_antiflicker(NULL, NULL) == RSS_ERR_INVAL);
+    puts("T31 anti-flicker uses exact Off/50 Hz/60 Hz SDK setter and getter values");
+    return 0;
+}
diff --git a/tests/test_isp_flip.c b/tests/test_isp_flip.c
new file mode 100644
index 0000000000000000000000000000000000000000..d8c65e814ac7707e592de708c27e81582eeeedb6
--- /dev/null
+++ b/tests/test_isp_flip.c
@@ -0,0 +1,65 @@
+#include "hal_internal.h"
+#include <assert.h>
+
+extern int hal_isp_set_hflip(void *ctx, int enable);
+extern int hal_isp_set_vflip(void *ctx, int enable);
+extern int hal_isp_get_hvflip(void *ctx, int *horizontal, int *vertical);
+
+static int hardware;
+static int get_error, set_error, set_calls;
+
+int IMP_ISP_Tuning_GetHVFlip(IMPISPHVFLIP *value)
+{
+    *value = (IMPISPHVFLIP)hardware;
+    return get_error;
+}
+
+int IMP_ISP_Tuning_SetHVFLIP(IMPISPHVFLIP value)
+{
+    set_calls++;
+    if (set_error)
+        return set_error;
+    hardware = value;
+    return RSS_OK;
+}
+
+int main(void)
+{
+    rss_hal_ctx_t state = {0};
+    for (int initial = 0; initial < 4; initial++) {
+        for (int desired = 0; desired < 2; desired++) {
+            hardware = initial;
+            state.hflip_state[0] = !(initial & 1);
+            state.vflip_state[0] = !(initial & 2);
+            assert(hal_isp_set_hflip(&state, desired) == RSS_OK);
+            assert(hardware == ((initial & 2) | desired));
+            hardware = initial;
+            assert(hal_isp_set_vflip(&state, desired) == RSS_OK);
+            assert(hardware == ((initial & 1) | (desired << 1)));
+            int horizontal = -1, vertical = -1;
+            assert(hal_isp_get_hvflip(&state, &horizontal, &vertical) == RSS_OK);
+            assert(horizontal == (hardware & 1) && vertical == ((hardware >> 1) & 1));
+        }
+    }
+    state.hflip_state[0] = 0;
+    state.vflip_state[0] = 1;
+    hardware = 2;
+    get_error = -7;
+    int before = set_calls;
+    assert(hal_isp_set_hflip(&state, 1) == -7 && set_calls == before);
+    get_error = 0;
+    set_error = -8;
+    assert(hal_isp_set_hflip(&state, 1) == -8);
+    assert(state.hflip_state[0] == 0 && state.vflip_state[0] == 1);
+    set_error = 0;
+    hardware = 4;
+    before = set_calls;
+    assert(hal_isp_set_vflip(&state, 1) == RSS_ERR_NOTSUP && set_calls == before);
+    int horizontal = -1, vertical = -1;
+    assert(hal_isp_get_hvflip(&state, &horizontal, &vertical) == RSS_ERR_NOTSUP);
+    assert(horizontal == -1 && vertical == -1);
+    assert(hal_isp_set_hflip(NULL, 1) == RSS_ERR_INVAL);
+    assert(hal_isp_set_vflip(&state, 2) == RSS_ERR_INVAL);
+    puts("ISP flip preserves the observed opposite axis and rejects unknown state");
+    return 0;
+}
