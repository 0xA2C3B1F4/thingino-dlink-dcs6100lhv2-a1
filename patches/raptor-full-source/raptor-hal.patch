+int hal_fs_set_fps(void *ctx, int chn, uint32_t fps_num, uint32_t fps_den)
+{
+    (void)ctx;
+    if (fps_num == 0 || fps_den == 0)
+        return -EINVAL;
+    if (fps_num > INT_MAX || fps_den > INT_MAX)
+        return -ERANGE;
