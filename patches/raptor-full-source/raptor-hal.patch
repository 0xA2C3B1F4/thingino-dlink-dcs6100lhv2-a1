index 2833d06b036ca63d2d451dbae687195463dd22ca..6bf781cb6d27028e1262e40b119e6757b1ae403e 100644
--- a/include/raptor_hal.h
+++ b/include/raptor_hal.h
@@ -398,6 +398,8 @@ typedef struct {
     int samples_per_frame;
     int chn_count;                /* 1=mono, 2=stereo */
     int frame_depth;              /* usrFrmDepth [2..50] */
+    int ai_device;                /* IMP AI device selected by the board config */
+    bool ai_device_set;           /* false keeps the platform's legacy default */
     int ai_vol;                   /* [-30..120], 60=unity */
     int ai_gain;                  /* [0..31] */
     rss_audio_input_t input_type; /* AMIC or DMIC */
@@ -1202,6 +1204,19 @@ typedef struct rss_hal_ops {
     void *(*mem_pool_phys_to_virt)(void *ctx, uint32_t phys_addr);
     uint32_t (*mem_pool_virt_to_phys)(void *ctx, void *virt_addr);
 
+    /* T31: checked FrameSource output rate, exact positive numerator/denominator. */
+    int (*fs_get_fps)(void *ctx, int chn, uint32_t *fps_num, uint32_t *fps_den);
+
+    /* T31: SDK-owned FrameSource video buffer block count. */
+    int (*fs_get_nr_vbs)(void *ctx, int chn, uint32_t *nr_vbs);
+
+    /* T31 only: preserve live non-rate attributes and verify exact readback.
+     * Caller exclusively owns FS configuration, has stopped all shared-FS
+     * consumers and has confirmed successful FS disable. No lifecycle work
+     * or rollback is performed here; an error may follow a partial apply.
+     * Appending this op requires a matched HAL/consumer rebuild. */
+    int (*fs_set_fps)(void *ctx, int chn, uint32_t fps_num, uint32_t fps_den);
+
 } rss_hal_ops_t;
 
