+    IMPFSChnAttr before = {0};
+    int ret = IMP_FrameSource_GetChnAttr(chn, &before);
+    if (ret != 0) {
+        HAL_LOG_ERR("GetChnAttr(%d) before FPS set failed: %d", chn, ret);
+        return ret;
+    }
+    if (before.outFrmRateNum <= 0 || before.outFrmRateDen <= 0)
+        return -ERANGE;
+
+    IMPFSChnAttr desired = before;
+    desired.outFrmRateNum = (int)fps_num;
+    desired.outFrmRateDen = (int)fps_den;
+    ret = IMP_FrameSource_SetChnAttr(chn, &desired);
+    if (ret != 0) {
+        HAL_LOG_ERR("SetChnAttr(%d) for FPS failed: %d", chn, ret);
+        return ret;
+    }
+
+    IMPFSChnAttr after = {0};
+    ret = IMP_FrameSource_GetChnAttr(chn, &after);
+    if (ret != 0) {
+        HAL_LOG_ERR("GetChnAttr(%d) after FPS set failed: %d", chn, ret);
+        return ret;
+    }
+    if (after.outFrmRateNum != desired.outFrmRateNum ||
+        after.outFrmRateDen != desired.outFrmRateDen ||
+        !hal_fs_same_non_rate_attr(&before, &after)) {
+        HAL_LOG_ERR("GetChnAttr(%d) after FPS set mismatched", chn);
+        return -EIO;
+    }
+    return 0;
+}
