diff --git a/Makefile b/Makefile
index faca62a03951556edad3515df91996aee82b0fbe..8ef8bc8ad740c118166bb51aba4d9caf627c373d 100644
--- a/Makefile
+++ b/Makefile
@@ -12,6 +12,7 @@
 # Optional variables:
 #   INGENIC_HEADERS - Path to ingenic-headers repo (default: ../ingenic-headers)
 #   INGENIC_LIB     - Path to ingenic-lib repo (default: ../ingenic-lib)
+#   DLINK_OS02G10_IMP_1_1_4 - D-Link OS02G10 IQ and legacy IMP 1.1.4 ABI
 #   DEBUG           - Set to 1 for debug build
 #   V               - Set to 1 for verbose output
 
@@ -89,6 +90,18 @@ ifeq ($(PERSONDET),1)
 CFLAGS  += -DPERSONDET
 endif
 
+ifeq ($(DLINK_OS02G10_IMP_1_1_4),1)
+CFLAGS  += -DRAPTOR_HAL_DLINK_OS02G10_IMP_1_1_4
+# D-Link's video/OSD closure uses the later T31 ABI, but its IVS move
+# implementation has the 1.1.4 IMPFrameInfo layout.  T31 1.1.6 inserted
+# rotate_osdflag before IMP_IVS_MoveParam.roiRect, shifting every ROI and
+# triggering the vendor filter's bounds assertion.  Keep the proven general
+# HAL headers and select the matched legacy layout for IVS alone.
+DLINK_IVS_SDK_INCLUDE := $(INGENIC_HEADERS)/T31/1.1.4/zh
+src/hal_ivs.o: CFLAGS := $(filter-out -I$(SDK_INCLUDE) -I$(SDK_INCLUDE)/imp,$(CFLAGS)) \
+	-I$(DLINK_IVS_SDK_INCLUDE) -I$(DLINK_IVS_SDK_INCLUDE)/imp
+endif
+
 # Verbose
 ifeq ($(V),1)
 Q :=
