index 0000000000000000000000000000000000000000..d9c615f6bf287db2ed67565a33f448b55b8782de
--- /dev/null
+++ b/tests/test_encoder_readback.c
@@ -0,0 +1,95 @@
+#include "hal_internal.h"
+#include <assert.h>
+
+extern int hal_enc_get_channel_attr(void *ctx, int chn, rss_video_config_t *cfg);
+extern int hal_enc_get_gop_mode(void *ctx, int chn, rss_gop_mode_t *mode);
+
+static IMPEncoderCHNAttr sdk_attr;
+static int sdk_error;
+static int sdk_calls;
+static void log_error(int level, const char *file, int line, const char *format, ...)
+{
+    assert(level == HAL_LOG_LVL_ERR && file && line > 0 && format);
+}
+rss_hal_log_func_t rss_hal_log_fn = log_error;
+
+int IMP_Encoder_GetChnAttr(int channel, IMPEncoderCHNAttr *attr)
+{
+    assert(channel == 7);
+    sdk_calls++;
+    *attr = sdk_attr;
+    return sdk_error;
+}
+
+int IMP_Encoder_GetChnGopAttr(int channel, IMPEncoderGopAttr *attr)
+{
+    assert(channel == 7);
+    *attr = sdk_attr.gopAttr;
+    return sdk_error;
+}
+
+int main(void)
+{
+    const IMPEncoderProfile profiles[] = {
+        IMP_ENC_PROFILE_AVC_BASELINE, IMP_ENC_PROFILE_AVC_MAIN,
+        IMP_ENC_PROFILE_AVC_HIGH, IMP_ENC_PROFILE_HEVC_MAIN,
+        IMP_ENC_PROFILE_JPEG,
+    };
+    const rss_codec_t codecs[] = {
+        RSS_CODEC_H264, RSS_CODEC_H264, RSS_CODEC_H264,
+        RSS_CODEC_H265, RSS_CODEC_JPEG,
+    };
+    const int mapped_profiles[] = {0, 1, 2, 0, 0};
+    rss_video_config_t live;
+    sdk_attr.encAttr.uWidth = 1920;
+    sdk_attr.encAttr.uHeight = 1080;
+    sdk_attr.rcAttr.outFrmRate.frmRateNum = 15;
+    sdk_attr.rcAttr.outFrmRate.frmRateDen = 1;
+    sdk_attr.gopAttr.uGopLength = 30;
+    sdk_attr.gopAttr.uGopCtrlMode = IMP_ENC_GOP_CTRL_MODE_DEFAULT;
+    sdk_attr.rcAttr.attrRcMode.rcMode = IMP_ENC_RC_MODE_CBR;
+    sdk_attr.rcAttr.attrRcMode.attrCbr.uTargetBitRate = 2000;
+    for (size_t i = 0; i < sizeof(profiles) / sizeof(profiles[0]); i++) {
+        sdk_attr.encAttr.eProfile = profiles[i];
+        assert(hal_enc_get_channel_attr(NULL, 7, &live) == RSS_OK);
+        assert(live.codec == codecs[i] && live.profile == mapped_profiles[i]);
+        assert(live.width == 1920 && live.height == 1080);
+        assert(live.fps_num == 15 && live.fps_den == 1 && live.gop_length == 30);
+    }
+    sdk_attr.encAttr.eProfile = (IMPEncoderProfile)0x7fffffff;
+    assert(hal_enc_get_channel_attr(NULL, 7, &live) == RSS_ERR_NOTSUP);
+    sdk_attr.encAttr.eProfile = IMP_ENC_PROFILE_AVC_HIGH;
+    sdk_attr.rcAttr.attrRcMode.rcMode = IMP_ENC_RC_MODE_FIXQP;
+    sdk_attr.rcAttr.attrRcMode.attrFixQp.iInitialQP = 37;
+    assert(hal_enc_get_channel_attr(NULL, 7, &live) == RSS_OK);
+    assert(live.rc_mode == RSS_RC_FIXQP && live.init_qp == 37 && live.bitrate == 0);
+    sdk_attr.gopAttr.uGopCtrlMode = IMP_ENC_GOP_CTRL_MODE_PYRAMIDAL;
+    assert(hal_enc_get_channel_attr(NULL, 7, &live) == RSS_OK);
+    assert(live.gop_mode == RSS_GOP_PYRAMIDAL);
+    sdk_attr.gopAttr.uGopCtrlMode = IMP_ENC_GOP_CTRL_MODE_SMARTP;
+    assert(hal_enc_get_channel_attr(NULL, 7, &live) == RSS_OK);
+    assert(live.gop_mode == RSS_GOP_SMARTP);
+    sdk_attr.gopAttr.uGopCtrlMode = (IMPEncoderGopCtrlMode)0x7f;
+    assert(hal_enc_get_channel_attr(NULL, 7, &live) == RSS_ERR_NOTSUP);
+    rss_gop_mode_t gop_mode = RSS_GOP_DEFAULT;
+    assert(hal_enc_get_gop_mode(NULL, 7, &gop_mode) == RSS_ERR_NOTSUP);
+    sdk_attr.gopAttr.uGopCtrlMode = IMP_ENC_GOP_CTRL_MODE_DEFAULT;
+    assert(hal_enc_get_gop_mode(NULL, 7, &gop_mode) == RSS_OK);
+    assert(gop_mode == RSS_GOP_DEFAULT);
+    sdk_attr.gopAttr.uGopCtrlMode = IMP_ENC_GOP_CTRL_MODE_PYRAMIDAL;
+    assert(hal_enc_get_gop_mode(NULL, 7, &gop_mode) == RSS_OK);
+    assert(gop_mode == RSS_GOP_PYRAMIDAL);
+    sdk_attr.gopAttr.uGopCtrlMode = IMP_ENC_GOP_CTRL_MODE_SMARTP;
+    assert(hal_enc_get_gop_mode(NULL, 7, &gop_mode) == RSS_OK);
+    assert(gop_mode == RSS_GOP_SMARTP);
+    sdk_attr.gopAttr.uGopCtrlMode = IMP_ENC_GOP_CTRL_MODE_DEFAULT;
+    sdk_attr.rcAttr.attrRcMode.rcMode = 0x7fffffff;
+    assert(hal_enc_get_channel_attr(NULL, 7, &live) == RSS_ERR_NOTSUP);
+    sdk_error = -7;
+    assert(hal_enc_get_channel_attr(NULL, 7, &live) == -7);
+    int before = sdk_calls;
+    assert(hal_enc_get_channel_attr(NULL, 7, NULL) == RSS_ERR_INVAL);
+    assert(sdk_calls == before);
+    puts("Encoder profile and unknown SDK readback checks passed");
+    return 0;
+}
diff --git a/tests/test_fs_fps.c b/tests/test_fs_fps.c
new file mode 100644
index 0000000000000000000000000000000000000000..3983f329603842ed5954de8e9874c1a0c02f692b
--- /dev/null
+++ b/tests/test_fs_fps.c
@@ -0,0 +1,107 @@
+#include "hal_internal.h"
+#include <assert.h>
+#include <limits.h>
+
+extern int hal_fs_get_fps(void *ctx, int chn, uint32_t *num, uint32_t *den);
+
+_Static_assert(_Generic(((IMPFSChnAttr *)0)->outFrmRateNum, int: 1, default: 0),
+               "T31 1.1.4 numerator is signed int");
+_Static_assert(_Generic(((IMPFSChnAttr *)0)->outFrmRateDen, int: 1, default: 0),
+               "T31 1.1.4 denominator is signed int");
+
+static int sdk_num;
+static int sdk_den;
+static int sdk_error;
+static int sdk_calls;
+static int log_calls;
+static int expected_channel = 7;
+static bool partial_write;
+
+static void log_error(int level, const char *file, int line, const char *fmt, ...)
+{
+    assert(level == HAL_LOG_LVL_ERR);
+    assert(file != NULL);
+    assert(line > 0);
+    assert(fmt != NULL);
+    log_calls++;
+}
+
+rss_hal_log_func_t rss_hal_log_fn = log_error;
+
+int IMP_FrameSource_GetChnAttr(int channel, IMPFSChnAttr *attr)
+{
+    assert(channel == expected_channel);
+    assert(attr != NULL);
+    IMPFSChnAttr empty = {0};
+    assert(memcmp(attr, &empty, sizeof(empty)) == 0);
+    sdk_calls++;
+    attr->outFrmRateNum = sdk_num;
+    if (!partial_write)
+        attr->outFrmRateDen = sdk_den;
+    return sdk_error;
+}
+
+int main(void)
+{
+    const rss_hal_ops_t ops = {.fs_get_fps = hal_fs_get_fps};
+    const int ratios[][2] = {{15, 1}, {30000, 1001}, {30, 2}, {1, INT_MAX}, {INT_MAX, 1}};
+    for (size_t i = 0; i < sizeof(ratios) / sizeof(ratios[0]); i++) {
+        sdk_num = ratios[i][0];
+        sdk_den = ratios[i][1];
+        uint32_t num = 111;
+        uint32_t den = 222;
+        assert(ops.fs_get_fps(NULL, expected_channel, &num, &den) == 0);
+        assert(num == (uint32_t)sdk_num);
+        assert(den == (uint32_t)sdk_den);
+    }
+
+    const int invalid[][2] = {{0, 1}, {-1, 1}, {15, 0}, {15, -1}, {INT_MIN, INT_MIN}};
+    for (size_t i = 0; i < sizeof(invalid) / sizeof(invalid[0]); i++) {
+        sdk_num = invalid[i][0];
+        sdk_den = invalid[i][1];
+        uint32_t num = 111;
+        uint32_t den = 222;
+        assert(ops.fs_get_fps(NULL, expected_channel, &num, &den) == -ERANGE);
+        assert(num == 111);
+        assert(den == 222);
+    }
+
+    sdk_num = 15;
+    sdk_den = 1;
+    const int errors[] = {-42, 9};
+    for (size_t i = 0; i < sizeof(errors) / sizeof(errors[0]); i++) {
+        uint32_t num = 111;
+        uint32_t den = 222;
+        sdk_error = errors[i];
+        assert(ops.fs_get_fps(NULL, expected_channel, &num, &den) == sdk_error);
+        assert(num == 111);
+        assert(den == 222);
+    }
+    assert(log_calls == 2);
+    sdk_error = 0;
+
+    uint32_t num = 111;
+    uint32_t den = 222;
+    partial_write = true;
+    assert(ops.fs_get_fps(NULL, expected_channel, &num, &den) == -ERANGE);
+    assert(num == 111);
+    assert(den == 222);
+    partial_write = false;
+
+    int before = sdk_calls;
+    assert(ops.fs_get_fps(NULL, expected_channel, NULL, &den) == -EINVAL);
+    assert(ops.fs_get_fps(NULL, expected_channel, &num, NULL) == -EINVAL);
+    assert(ops.fs_get_fps(NULL, expected_channel, &num, &num) == -EINVAL);
+    assert(sdk_calls == before);
+    assert(num == 111);
+    assert(den == 222);
+
+    /* Channel validity belongs to the SDK; no guessed platform maximum. */
+    expected_channel = -1;
+    sdk_error = -22;
+    assert(ops.fs_get_fps(NULL, expected_channel, &num, &den) == -22);
+    assert(num == 111);
+    assert(den == 222);
+    puts("FrameSource FPS SDK mapping and failure checks passed");
+    return 0;
+}
diff --git a/tests/test_fs_nr_vbs.c b/tests/test_fs_nr_vbs.c
new file mode 100644
index 0000000000000000000000000000000000000000..a25d1d61a3787e64fc0306824a2f1282e1364ccf
