diff --git a/tests/test_audio_acquisition.c b/tests/test_audio_acquisition.c
new file mode 100644
index 0000000000000000000000000000000000000000..8ac80b98d3e9521706265ad49e59b4a3ea0547cc
--- /dev/null
+++ b/tests/test_audio_acquisition.c
@@ -0,0 +1,184 @@
+#include "hal_internal.h"
+#include <assert.h>
+
+extern int hal_audio_init(void *ctx, const rss_audio_config_t *cfg);
+extern int hal_audio_deinit(void *ctx);
+static void discard_log(int level, const char *file, int line, const char *format, ...)
+{
+    (void)level;
+    (void)file;
+    (void)line;
+    (void)format;
+}
+rss_hal_log_func_t rss_hal_log_fn = discard_log;
+
+static int fail_stage;
+static int disables;
+static int channel_disables;
+static int fail_disable;
+
+int IMP_AI_SetPubAttr(int dev, IMPAudioIOAttr *attr)
+{
+    assert(dev == 1 && attr->samplerate == 16000);
+    return fail_stage == 1 ? -1 : 0;
+}
+int IMP_AI_Enable(int dev)
+{
+    assert(dev == 1);
+    return fail_stage == 2 ? 11 : 0;
+}
+int IMP_AI_SetChnParam(int dev, int ch, IMPAudioIChnParam *attr)
+{
+    assert(dev == 1 && ch == 0 && attr->usrFrmDepth == 20);
+    return fail_stage == 3 ? -3 : 0;
+}
+int IMP_AI_EnableChn(int dev, int ch)
+{
+    assert(dev == 1 && ch == 0);
+    return fail_stage == 4 ? -4 : 0;
+}
+int IMP_AI_DisableChn(int dev, int ch)
+{
+    assert(dev == 1 && ch == 0);
+    channel_disables++;
+    return fail_disable == 1 ? -5 : 0;
+}
+int IMP_AI_Disable(int dev)
+{
+    assert(dev == 1);
+    disables++;
+    return fail_disable == 2 ? -6 : 0;
+}
+int IMP_AI_SetVol(int dev, int ch, int value)
+{
+    (void)dev;
+    (void)ch;
+    (void)value;
+    return 0;
+}
+int IMP_AI_SetGain(int dev, int ch, int value)
+{
+    (void)dev;
+    (void)ch;
+    (void)value;
+    return 0;
+}
+
+/* Link the real T31 dispatcher, but reject any unintended DMIC call. */
+int IMP_DMIC_SetUserInfo(int dev, int aec, int needed)
+{
+    (void)dev;
+    (void)aec;
+    (void)needed;
+    assert(false);
+    return -1;
+}
+int IMP_DMIC_SetPubAttr(int dev, IMPDmicAttr *attr)
+{
+    (void)dev;
+    (void)attr;
+    assert(false);
+    return -1;
+}
+int IMP_DMIC_Enable(int dev)
+{
+    (void)dev;
+    assert(false);
+    return -1;
+}
+int IMP_DMIC_Disable(int dev)
+{
+    (void)dev;
+    assert(false);
+    return -1;
+}
+int IMP_DMIC_EnableChn(int dev, int ch)
+{
+    (void)dev;
+    (void)ch;
+    assert(false);
+    return -1;
+}
+int IMP_DMIC_DisableChn(int dev, int ch)
+{
+    (void)dev;
+    (void)ch;
+    assert(false);
+    return -1;
+}
+int IMP_DMIC_SetChnParam(int dev, int ch, IMPDmicChnParam *attr)
+{
+    (void)dev;
+    (void)ch;
+    (void)attr;
+    assert(false);
+    return -1;
+}
+int IMP_DMIC_SetVol(int dev, int ch, int value)
+{
+    (void)dev;
+    (void)ch;
+    (void)value;
+    assert(false);
+    return -1;
+}
+int IMP_DMIC_SetGain(int dev, int ch, int value)
+{
+    (void)dev;
+    (void)ch;
+    (void)value;
+    assert(false);
+    return -1;
+}
+
+int main(void)
+{
+    const rss_audio_config_t cfg = {
+        .sample_rate = 16000,
+        .samples_per_frame = 320,
+        .frame_depth = 20,
+        .chn_count = 1,
+        .ai_device_set = true,
+        .ai_device = 1,
+        .input_type = RSS_AUDIO_INPUT_AMIC,
+    };
+    for (int stage = 1; stage <= 4; ++stage) {
+        rss_hal_ctx_t ctx = {0};
+        fail_stage = stage;
+        disables = channel_disables = 0;
+        assert(hal_audio_init(&ctx, &cfg) != 0);
+        int result = hal_audio_deinit(&ctx);
+        assert(channel_disables == 0);
+        assert(disables == (stage >= 3 ? 1 : 0));
+        if (stage == 2) {
+            assert(result != 0 && ctx.audio_ai_init_failed);
+            assert(hal_audio_init(&ctx, &cfg) == RSS_ERR_BUSY);
+            assert(disables == 0 && channel_disables == 0);
+        } else {
+            assert(result == 0);
+        }
+    }
+    fail_stage = 0;
+    rss_hal_ctx_t ctx = {0};
+    assert(hal_audio_init(&ctx, &cfg) == 0);
+    assert(ctx.audio_ai_device_enabled && ctx.audio_ai_channel_enabled);
+    rss_audio_config_t other = cfg;
+    other.ai_device = 0;
+    assert(hal_audio_init(&ctx, &other) == RSS_ERR_BUSY);
+    assert(ctx.audio_ai_device == 1);
+    disables = channel_disables = 0;
+    fail_disable = 1;
+    assert(hal_audio_deinit(&ctx) == -5);
+    assert(disables == 0 && ctx.audio_ai_channel_enabled);
+    fail_disable = 2;
+    assert(hal_audio_deinit(&ctx) == -6);
+    assert(!ctx.audio_ai_channel_enabled && ctx.audio_ai_device_enabled);
+    fail_disable = 0;
+    assert(hal_audio_deinit(&ctx) == 0);
+    assert(!ctx.audio_ai_channel_enabled && !ctx.audio_ai_device_enabled);
+    int before = disables + channel_disables;
+    assert(hal_audio_deinit(&ctx) == 0);
+    assert(disables + channel_disables == before);
+    puts("AMIC acquired-only cleanup and explicit failed-enable restart passed");
+    return 0;
+}
