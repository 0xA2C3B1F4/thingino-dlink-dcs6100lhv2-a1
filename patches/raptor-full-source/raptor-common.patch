diff --git a/tests/test-timezone-inventory.sh b/tests/test-timezone-inventory.sh
new file mode 100644
index 0000000000000000000000000000000000000000..8d4c8c3e6e972ee6a946fb2f3d6f03677f1c2cfd
--- /dev/null
+++ b/tests/test-timezone-inventory.sh
@@ -0,0 +1,22 @@
+#!/bin/sh
+# Run against the packaged full-stack profile, without a camera or SDK.
+set -eu
+: "${TMPDIR:?Set TMPDIR to a writable scratch directory}"
+test "$#" -eq 1
+profile=$1
+test -f "$profile"
+root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
+scratch=$(mktemp -d "$TMPDIR/raptor-timezone.XXXXXX")
+trap 'rm -r -- "$scratch"' EXIT HUP INT TERM
+case "$(uname -s)" in
+    Darwin) link_sections=-Wl,-dead_strip ;;
+    *) link_sections=-Wl,--gc-sections ;;
+esac
+"${CC:-cc}" -std=c11 -D_GNU_SOURCE -Wall -Wextra -Werror -pthread \
+    -ffunction-sections -fdata-sections "$link_sections" \
+    -include "$root/tests/native_clock_decl.h" \
+    -I"$root/include" -DRSS_TIMEZONE_RUN_DIR="\"$scratch\"" \
+    "$root/tests/test_timezone_inventory.c" "$root/src/rss_util.c" \
+    "$root/src/rss_config.c" "$root/src/rss_log.c" "$root/src/cJSON.c" \
+    -lm -o "$scratch/test-timezone-inventory"
+"$scratch/test-timezone-inventory" "$profile"
diff --git a/tests/test_config_failures.c b/tests/test_config_failures.c
new file mode 100644
index 0000000000000000000000000000000000000000..cbada8cac5a1d3ce36a92a4cc7fd565a3f6e9703
--- /dev/null
+++ b/tests/test_config_failures.c
@@ -0,0 +1,91 @@
+#include <assert.h>
+#include <stdbool.h>
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+static int fail_after = -1;
+static bool fail_read;
+static FILE *test_fopen(const char *path, const char *mode)
+{
+    if (fail_read && strcmp(mode, "r") == 0) { errno = EIO; return NULL; }
+    return fopen(path, mode);
+}
+static void *test_calloc(size_t count, size_t size)
+{
+    if (fail_after == 0) { errno = ENOMEM; return NULL; }
+    if (fail_after > 0) --fail_after;
+    return calloc(count, size);
+}
+#define calloc test_calloc
+#define fopen test_fopen
+#include "../src/rss_config.c"
+#undef calloc
+#undef fopen
+
+static void write_file(const char *path, const char *contents)
+{
+    FILE *file = fopen(path, "w");
+    assert(file && fputs(contents, file) >= 0 && fclose(file) == 0);
+}
+static void unchanged(const char *path, const char *contents)
+{
+    FILE *file = fopen(path, "r");
+    char data[256] = {0};
+    assert(file);
+    size_t n = fread(data, 1, sizeof(data) - 1, file);
+    assert(n == strlen(contents) && strcmp(data, contents) == 0);
+    fclose(file);
+}
+int main(int argc, char **argv)
+{
+    assert(argc == 2);
+    const char *path = argv[1];
+    const char *initial = "[audio]\nvolume = 70\n[rtsp]\nport = 9554\n";
+    write_file(path, initial);
+    rss_config_t *cfg = rss_config_load(path);
+    assert(cfg);
+    rss_config_set_int(cfg, "audio", "gain", 20);
+    /* Fail every load and merge allocation in turn. None may write a partial cache. */
+    for (int i = 0; i < 6; ++i) {
+        fail_after = i;
+        assert(rss_config_save(cfg, path) != 0);
+        fail_after = -1;
+        unchanged(path, initial);
+        assert(cfg->sections->next->entries->dirty);
+    }
+    fail_read = true;
+    assert(rss_config_save(cfg, path) != 0);
+    fail_read = false;
+    unchanged(path, initial);
+    /* Existing but unreadable-as-config input must not be replaced. */
+    const char *invalid = "[audio]\nvolume = 70\nmalformed configuration line\n[rtsp]\nport = 9554\n";
+    write_file(path, invalid);
+    assert(rss_config_save(cfg, path) != 0);
+    unchanged(path, invalid);
+    char response[1024];
+    assert(rss_config_readback_section(path, "audio", response, sizeof(response)) > 0);
+    assert(strstr(response, "\"status\":\"error\""));
+    write_file(path, initial);
+    assert(rss_config_save(cfg, path) == 0);
+    rss_config_t *disk = rss_config_load(path);
+    assert(disk && rss_config_get_int(disk, "audio", "gain", -1) == 20);
+    assert(rss_config_get_int(disk, "rtsp", "port", -1) == 9554);
+    rss_config_free(disk);
+    rss_config_set_int(cfg, "audio", "gain", 10);
+    /* Persistent readback reports disk 20, not the unsaved cache value 10. */
+    assert(rss_config_readback_section(path, "audio", response, sizeof(response)) > 0);
+    cJSON *json = cJSON_Parse(response);
+    cJSON *keys = cJSON_GetObjectItemCaseSensitive(json, "keys");
+    cJSON *gain = cJSON_GetObjectItemCaseSensitive(keys, "gain");
+    assert(cJSON_IsString(gain) && strcmp(gain->valuestring, "20") == 0);
+    cJSON_Delete(json);
+    rss_config_free(cfg);
+    unlink(path);
+    char lockpath[1024];
+    snprintf(lockpath, sizeof(lockpath), "%s.lock", path);
+    unlink(lockpath);
+    return 0;
+}
diff --git a/tests/test_config_lock.c b/tests/test_config_lock.c
new file mode 100644
index 0000000000000000000000000000000000000000..5d1610e9e799c86831fd40c5c07795b8d813a504
--- /dev/null
+++ b/tests/test_config_lock.c
@@ -0,0 +1,43 @@
+#include <assert.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/file.h>
+#include <unistd.h>
+#include "rss_common.h"
+
+int main(int argc, char **argv)
+{
+    assert(argc == 2);
+    const char *path = argv[1];
+    FILE *file = fopen(path, "w");
+    assert(file);
+    assert(fputs("[audio]\nvolume = 70\n[rtsp]\nport = 8554\n", file) >= 0);
+    assert(fclose(file) == 0);
+    rss_config_t *audio = rss_config_load(path);
+    rss_config_t *rtsp = rss_config_load(path);
+    assert(audio && rtsp);
+    rss_config_set_int(audio, "audio", "volume", 60);
+    rss_config_set_int(rtsp, "rtsp", "port", 9554);
+    char lockpath[1024];
+    snprintf(lockpath, sizeof(lockpath), "%s.lock", path);
+    int lock = open(lockpath, O_WRONLY | O_CREAT, 0600);
+    assert(lock >= 0 && flock(lock, LOCK_EX | LOCK_NB) == 0);
+    assert(rss_config_save(audio, path) != 0);
+    rss_config_t *disk = rss_config_load(path);
+    assert(disk && rss_config_get_int(disk, "audio", "volume", -1) == 70);
+    rss_config_free(disk);
+    assert(flock(lock, LOCK_UN) == 0);
+    close(lock);
+    assert(rss_config_save(audio, path) == 0);
+    assert(rss_config_save(rtsp, path) == 0);
+    disk = rss_config_load(path);
+    assert(disk && rss_config_get_int(disk, "audio", "volume", -1) == 60);
+    assert(rss_config_get_int(disk, "rtsp", "port", -1) == 9554);
+    rss_config_free(disk);
+    rss_config_free(audio);
+    rss_config_free(rtsp);
+    unlink(path);
+    unlink(lockpath);
+    return 0;
+}
