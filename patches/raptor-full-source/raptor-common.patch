diff --git a/tests/test_timezone_inventory.c b/tests/test_timezone_inventory.c
new file mode 100644
index 0000000000000000000000000000000000000000..a117eb9e0f38d3e8e4abb3b0a5d2045f46a3f760
--- /dev/null
+++ b/tests/test_timezone_inventory.c
@@ -0,0 +1,81 @@
+#include "rss_common.h"
+#include <assert.h>
+#include <stdlib.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+static cJSON *status(rss_config_t *config, bool success)
+{
+    char response[4096];
+    assert(rss_timezone_command("{\"cmd\":\"timezone-status\"}", config,
+                                response, sizeof(response)) > 0);
+    cJSON *root = cJSON_Parse(response);
+    assert(root);
+    const cJSON *result = cJSON_GetObjectItemCaseSensitive(root, "status");
+    assert(cJSON_IsString(result));
+    assert((strcmp(result->valuestring, "ok") == 0) == success);
+    return root;
+}
+
+static void inventory(rss_config_t *config, bool legacy_rod)
+{
+    const char *names[] = {"rvd", "rsd", "rhd", "rad", "ric", "rod",
+                           "rmr", "rmr0", "rmr1", "rwd"};
+    cJSON *root = status(config, true);
+    const cJSON *required = cJSON_GetObjectItemCaseSensitive(root, "required");
+    assert(cJSON_GetArraySize(required) == 10);
+    for (size_t i = 0; i < sizeof(names) / sizeof(names[0]); ++i) {
+        const cJSON *value = cJSON_GetObjectItemCaseSensitive(required, names[i]);
+        bool expected = strcmp(names[i], "rmr") != 0 &&
+                        (strcmp(names[i], "rod") != 0 || legacy_rod);
+        assert(cJSON_IsBool(value));
+        assert(cJSON_IsTrue(value) == expected);
+    }
+    cJSON_Delete(root);
+}
+
+int main(int argc, char **argv)
+{
+    assert(argc == 2);
+    rss_config_t *config = rss_config_load(argv[1]);
+    assert(config);
+    /* The real full-stack profile requires idle audio, both recorders and
+     * WebRTC even without sockets. Integrated OSD does not require ROD. */
+    assert(!rss_config_get_bool(config, "audio", "enabled", true));
+    assert(!rss_config_get_bool(config, "recording", "enabled", true));
+    inventory(config, false);
+
+    struct sockaddr_un address = {.sun_family = AF_UNIX};
+    assert(snprintf(address.sun_path, sizeof(address.sun_path),
+                    RSS_TIMEZONE_RUN_DIR "/rod.sock") < (int)sizeof(address.sun_path));
+    int fd = socket(AF_UNIX, SOCK_STREAM, 0);
+    assert(fd >= 0);
+    assert(bind(fd, (const struct sockaddr *)&address, sizeof(address)) == 0);
+    inventory(config, true);
+    assert(close(fd) == 0);
+    assert(unlink(address.sun_path) == 0);
+    inventory(config, false);
+
+    FILE *file = fopen(address.sun_path, "w");
+    assert(file && fclose(file) == 0);
+    cJSON_Delete(status(config, false));
+    assert(unlink(address.sun_path) == 0);
+
+    /* Legacy profiles keep their feature-based defaults. RVD cannot be
+     * excluded by an override, because it supplies the inventory itself. */
+    rss_config_set_bool(config, "timezone", "rvd", false);
+    inventory(config, false);
+    rss_config_t *legacy = rss_config_load("/dev/null");
+    assert(legacy);
+    cJSON *root = status(legacy, true);
+    const cJSON *required = cJSON_GetObjectItemCaseSensitive(root, "required");
+    assert(cJSON_IsTrue(cJSON_GetObjectItemCaseSensitive(required, "rod")));
+    assert(cJSON_IsFalse(cJSON_GetObjectItemCaseSensitive(required, "rmr0")));
+    assert(cJSON_IsFalse(cJSON_GetObjectItemCaseSensitive(required, "rmr1")));
+    cJSON_Delete(root);
+    rss_config_free(legacy);
+    rss_config_free(config);
+    puts("timezone owner inventory: pass");
+    return 0;
+}
