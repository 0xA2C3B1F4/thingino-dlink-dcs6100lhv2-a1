+        (prefix != RSS_SEI_PREFIX_NONE && prefix != RSS_SEI_PREFIX_ANNEXB &&
+         prefix != RSS_SEI_PREFIX_AVCC))
+        return -EINVAL;
+    if (data_len > (size_t)INT_MAX - 64)
