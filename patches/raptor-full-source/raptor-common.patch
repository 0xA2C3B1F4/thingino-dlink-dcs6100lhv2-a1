+    size_t prefix_len = prefix == RSS_SEI_PREFIX_NONE ? 0 : 4;
+    size_t header_len = codec == RSS_SEI_CODEC_H264 ? 1 : 2;
+    size_t total = prefix_len + header_len + measure.len;
