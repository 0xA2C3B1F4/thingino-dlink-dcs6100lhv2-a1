+size_t rss_format_localtime(char *buf, size_t size, const char *format, const time_t *value)
+{
+    if (!buf || !size || !format || !value)
+        return 0;
+    pthread_mutex_lock(&timezone_lock);
+    struct tm local;
+    size_t length = localtime_r(value, &local) ? strftime(buf, size, format, &local) : 0;
+    if (!length)
+        buf[0] = '\0';
+    pthread_mutex_unlock(&timezone_lock);
+    return length;
+}
+
+static bool timezone_rule(const char *rule)
+{
+    size_t length = rule ? strlen(rule) : 0;
+    if (!length || length > 256)
+        return false;
+    for (size_t i = 0; i < length; ++i) {
+        if ((unsigned char)rule[i] < 0x20 || (unsigned char)rule[i] > 0x7e)
+            return false;
+    }
+    return true;
+}
+
+static bool read_timezone(char value[258])
+{
+    int fd = open(RSS_TIMEZONE_FILE, O_RDONLY | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK);
+    if (fd < 0)
+        return false;
+    struct stat info;
+    bool valid = fstat(fd, &info) == 0 && S_ISREG(info.st_mode) && info.st_size > 0 && info.st_size <= 257;
+    ssize_t length = valid ? read(fd, value, 258) : -1;
+    if (close(fd) != 0)
+        valid = false;
+    if (!valid || length != info.st_size || length < 1 || length > 257)
+        return false;
+    if (value[length - 1] == '\n')
+        --length;
+    value[length] = '\0';
+    return strlen(value) == (size_t)length && timezone_rule(value);
+}
+
+static cJSON *timezone_participants(rss_config_t *cfg)
+{
+    static const struct { const char *daemon; const char *section; bool enabled; } services[] = {
+        {"rvd", NULL, true}, {"rsd", "rtsp", true}, {"rhd", "http", true},
+        {"rad", "audio", true}, {"ric", "ircut", true}, {"rod", "osd", true},
+        {"rmr", "recording", false}, {"rmr0", "recording0", false},
+        {"rmr1", "recording1", false}, {"rwd", "webrtc", false}
+    };
+    cJSON *result = cJSON_CreateObject();
+    for (size_t i = 0; i < sizeof(services) / sizeof(services[0]); ++i) {
+        char path[128];
+        snprintf(path, sizeof(path), RSS_TIMEZONE_RUN_DIR "/%s.sock", services[i].daemon);
+        struct stat info;
+        int exists = lstat(path, &info);
+        if ((exists == 0 && !S_ISSOCK(info.st_mode)) || (exists != 0 && errno != ENOENT)) {
+            cJSON_Delete(result);
+            return NULL;
+        }
+        bool default_required = !services[i].section ||
+            rss_config_get_bool(cfg, services[i].section, "enabled", services[i].enabled);
+        /* Owner lifetime is not the same as a feature's enabled state.
+         * A configured owner stays required when its socket disappears.
+         * A present socket cannot be hidden by a false configuration entry. */
+        bool enabled = exists == 0 || !services[i].section ||
+            rss_config_get_bool(cfg, "timezone", services[i].daemon, default_required);
+        cJSON_AddBoolToObject(result, services[i].daemon, enabled);
+    }
+    return result;
+}
+
+int rss_timezone_command(const char *json, rss_config_t *cfg, char *response, int size)
+{
+    cJSON *root = cJSON_ParseWithOpts(json, NULL, true);
+    const cJSON *cmd = cJSON_GetObjectItemCaseSensitive(root, "cmd");
+    if (!cJSON_IsString(cmd) || (strcmp(cmd->valuestring, "timezone-status") != 0 &&
+        strcmp(cmd->valuestring, "timezone-reload") != 0)) {
+        cJSON_Delete(root);
+        return -1;
+    }
+    bool reload = strcmp(cmd->valuestring, "timezone-reload") == 0;
+    const cJSON *expected = cJSON_GetObjectItemCaseSensitive(root, "expected_rule");
+    if (cJSON_GetArraySize(root) != (reload ? 2 : 1) ||
+        (reload && (!cJSON_IsString(expected) || !timezone_rule(expected->valuestring)))) {
+        cJSON_Delete(root);
+        return rss_ctrl_resp_error(response, size, "invalid timezone command");
+    }
+    if (reload) {
+        char file_rule[258];
+        pthread_mutex_lock(&timezone_lock);
+        bool ok = read_timezone(file_rule) && strcmp(file_rule, expected->valuestring) == 0;
+        const char *current = getenv("TZ");
+        if (ok && (!current || strcmp(current, file_rule) != 0))
+            ok = setenv("TZ", file_rule, 1) == 0;
+        if (ok)
+            tzset();
+        pthread_mutex_unlock(&timezone_lock);
+        if (!ok) {
+            cJSON_Delete(root);
+            return rss_ctrl_resp_error(response, size, "timezone file/reload failed");
+        }
+    }
+    cJSON_Delete(root);
+    cJSON *participants = timezone_participants(cfg);
+    if (!participants)
+        return rss_ctrl_resp_error(response, size, "timezone participant inventory unavailable");
+    root = cJSON_CreateObject();
+    cJSON_AddStringToObject(root, "status", "ok");
+    cJSON_AddStringToObject(root, "persistence", "checked-timezone");
+    cJSON_AddItemToObject(root, "required", participants);
+    pthread_mutex_lock(&timezone_lock);
+    const char *rule = getenv("TZ");
+    struct tm local;
+    const time_t january = 1768478400;
+    const time_t july = 1784116800;
+    char first[320], second[320];
+    bool available = timezone_rule(rule) && localtime_r(&january, &local) &&
+        strftime(first, sizeof(first), "%Y-%m-%dT%H:%M:%S%z %Z", &local) &&
+        localtime_r(&july, &local) && strftime(second, sizeof(second), "%Y-%m-%dT%H:%M:%S%z %Z", &local);
+    cJSON_AddBoolToObject(root, "available", available);
+    if (available) {
+        cJSON_AddStringToObject(root, "rule", rule);
+        cJSON_AddStringToObject(root, "january", first);
+        cJSON_AddStringToObject(root, "july", second);
+    } else {
+        cJSON_AddNullToObject(root, "rule");
+        cJSON_AddNullToObject(root, "january");
+        cJSON_AddNullToObject(root, "july");
+    }
+    pthread_mutex_unlock(&timezone_lock);
+    return rss_ctrl_resp_json(response, size, root);
+}
+
 int64_t rss_timestamp_us(void)
 {
     struct timespec ts;
@@ -57,9 +205,7 @@ char *rss_format_timestamp_fmt(char *buf, int buf_size, const char *fmt)
     struct timespec ts;
     clock_gettime(CLOCK_REALTIME, &ts);
 
-    struct tm tm;
-    localtime_r(&ts.tv_sec, &tm);
-    strftime(buf, (size_t)buf_size, fmt, &tm);
+    rss_format_localtime(buf, (size_t)buf_size, fmt, &ts.tv_sec);
     return buf;
 }
 
