+
+static int sei_user_data_rbsp(sei_rbsp_writer_t *writer, const uint8_t uuid[16],
+                              const uint8_t *data, size_t data_len)
+{
+    int ret = sei_rbsp_byte(writer, SEI_PAYLOAD_TYPE_UDU);
+    size_t payload_size = 16 + data_len;
+    for (size_t remaining = payload_size; ret == 0 && remaining >= 0xff; remaining -= 0xff)
+        ret = sei_rbsp_byte(writer, 0xff);
+    if (ret == 0)
+        ret = sei_rbsp_byte(writer, (uint8_t)(payload_size % 0xff));
+    for (size_t i = 0; ret == 0 && i < 16; i++)
+        ret = sei_rbsp_byte(writer, uuid[i]);
+    for (size_t i = 0; ret == 0 && i < data_len; i++)
+        ret = sei_rbsp_byte(writer, data[i]);
+    if (ret == 0)
+        ret = sei_rbsp_byte(writer, 0x80);
+    return ret;
+}
