+static bool uh_file_parse_range(const char *range, uint64_t size,
+				uint64_t *start, uint64_t *end)
+{
+	char *dash, *tail;
+	unsigned long long first, last;
+	char value[128];
+
+	if (!range || strncmp(range, "bytes=", 6) ||
+	    strlen(range + 6) >= sizeof(value) || strchr(range + 6, ','))
+		return false;
+	snprintf(value, sizeof(value), "%s", range + 6);
+	dash = strchr(value, '-');
+	if (!dash)
+		return false;
+	*dash++ = 0;
+	errno = 0;
+	if (!value[0]) {
+		last = strtoull(dash, &tail, 10);
+		if (errno || *tail || !last || !size)
+			return false;
+		if (last > size)
+			last = size;
+		*start = size - last;
+		*end = size - 1;
+		return true;
+	}
+	first = strtoull(value, &tail, 10);
+	if (errno || *tail || first >= size)
+		return false;
+	if (!dash[0]) {
+		last = size - 1;
+	} else {
+		errno = 0;
+		last = strtoull(dash, &tail, 10);
+		if (errno || *tail || last < first)
+			return false;
+		if (last >= size)
+			last = size - 1;
+	}
+	*start = first;
+	*end = last;
+	return true;
+}
+
+void uh_file_serve_absolute(struct client *cl, const char *path, bool download,
+			    const char *range)
+{
+	struct path_info pi = { 0 };
+	char resolved[PATH_MAX];
+	const char *name;
+	uint64_t range_start = 0, range_end = 0, content_length;
+	int fd;
+
+	if (!path || path[0] != '/' || !realpath(path, resolved) ||
+	    (strncmp(resolved, "/mnt/", 5) &&
+	     strncmp(resolved, "/media/", 7)) ||
+	    lstat(path, &pi.stat) || !S_ISREG(pi.stat.st_mode) ||
+	    S_ISLNK(pi.stat.st_mode)) {
+		uh_client_error(cl, 403, "Forbidden", NULL);
+		return;
+	}
+	fd = open(path, O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+	if (fd < 0 || fstat(fd, &pi.stat) || !S_ISREG(pi.stat.st_mode)) {
+		if (fd >= 0)
+			close(fd);
+		uh_client_error(cl, 404, "Not Found", NULL);
+		return;
+	}
+	pi.phys = resolved;
+	pi.name = resolved;
+	cl->request.disable_chunked = true;
+	cl->dispatch.no_cache = true;
+	if (download) {
+		name = strrchr(resolved, '/');
+		name = name && name[1] ? name + 1 : "download";
+		if (strpbrk(name, "\"\\\r\n")) {
+			close(fd);
+			uh_client_error(cl, 400, "Bad Request", NULL);
+			return;
+		}
+		blobmsg_add_string(&cl->hdr_response, "Content-Disposition",
+			snprintf(uh_buf, sizeof(uh_buf),
+				 "attachment; filename=\"%s\"", name) > 0 ?
+			uh_buf : "attachment");
+	}
+	if (!range) {
+		uh_file_data(cl, &pi, fd);
+		return;
+	}
+	if (!uh_file_parse_range(range, pi.stat.st_size, &range_start, &range_end) ||
+	    lseek(fd, range_start, SEEK_SET) < 0) {
+		close(fd);
+		uh_http_header(cl, 416, "Range Not Satisfiable");
+		ustream_printf(cl->us, "Content-Range: bytes */%" PRIu64 "\r\n"
+				       "Content-Length: 0\r\n\r\n",
+			       (uint64_t) pi.stat.st_size);
+		uh_request_done(cl);
+		return;
+	}
+	content_length = range_end - range_start + 1;
+	uh_http_header(cl, 206, "Partial Content");
+	uh_file_response_ok_hdrs(cl, &pi.stat);
+	ustream_printf(cl->us, "Accept-Ranges: bytes\r\n"
+			       "Content-Range: bytes %" PRIu64 "-%" PRIu64
+			       "/%" PRIu64 "\r\n"
+			       "Content-Type: %s\r\n"
+			       "Content-Length: %" PRIu64 "\r\n\r\n",
+		       range_start, range_end, (uint64_t) pi.stat.st_size,
+		       uh_file_mime_lookup(pi.name), content_length);
+	if (cl->request.method == UH_HTTP_MSG_HEAD) {
+		uh_request_done(cl);
+		close(fd);
+		return;
+	}
+	cl->dispatch.file.fd = fd;
+	cl->dispatch.file.remaining = content_length;
+	cl->dispatch.file.ranged = true;
+	cl->dispatch.write_cb = file_write_cb;
+	cl->dispatch.free = uh_file_free;
+	cl->dispatch.close_fds = uh_file_free;
+	file_write_cb(cl);
+}
