+		if (control_proxy_client_pending(cl) >= 4096) {
 			ustream_set_read_blocked(stream, true);
 			return;
 		}
@@ -485,7 +496,7 @@ static void control_proxy_client_write(struct client *cl)
 	struct ustream *backend = &proxy->backend.stream;
 
 	if (!proxy->initialized || proxy->finishing ||
-	    ustream_pending_data(cl->us, true) >= 4096)
