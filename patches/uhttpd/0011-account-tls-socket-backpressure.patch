diff --git a/control_proxy.c b/control_proxy.c
index a783deb..ca4f384 100644
--- a/control_proxy.c
+++ b/control_proxy.c
@@ -77,6 +77,17 @@ static bool control_proxy_whip_location(const char *value)
	return session[32] == 0;
 }
 
+static int control_proxy_client_pending(struct client *cl)
+{
+	int pending = ustream_pending_data(cl->us, true);
+
+#ifdef HAVE_TLS
+	if (cl->tls && cl->ssl.conn)
+		pending += ustream_pending_data(cl->ssl.conn, true);
+#endif
+	return pending;
+}
+
 static void control_proxy_schedule(struct client *cl, unsigned int action)
 {
 	struct dispatch_control_proxy *proxy = &cl->dispatch.control_proxy;
@@ -391,7 +402,7 @@ static void control_proxy_read(struct ustream *stream, int bytes)
 
 		if (!budget)
 			break;
