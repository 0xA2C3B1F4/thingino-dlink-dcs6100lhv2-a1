+static bool control_proxy_single_authorization(struct client *cl)
+{
+	struct blob_attr *cur;
+	unsigned int rem, count = 0;
+	blob_for_each_attr(cur, cl->hdr.head, rem)
+		if (!strcasecmp(blobmsg_name(cur), "authorization") && ++count > 1)
+			return false;
+	return true;
+}
