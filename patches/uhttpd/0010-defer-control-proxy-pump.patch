+static void control_proxy_deferred(struct uloop_timeout *timeout)
+{
+	struct dispatch_control_proxy *proxy =
+		container_of(timeout, struct dispatch_control_proxy, deferred);
+	struct client *cl = container_of(proxy, struct client,
+					 dispatch.control_proxy);
+	unsigned int action;
+
+	if (proxy->deferred_actions & CONTROL_DEFER_FINISH) {
+		proxy->deferred_actions = 0;
+		uh_request_done(cl);
+		return;
+	}
+	if (proxy->deferred_actions & CONTROL_DEFER_START_LOCAL_FILE) {
+		proxy->deferred_actions = 0;
+		if (!control_proxy_start_local_file(cl))
+			control_proxy_fail(cl, 502, "Bad Gateway", "bad_gateway");
+		return;
+	}
+	if (proxy->deferred_actions & CONTROL_DEFER_START_MEDIA) {
+		proxy->deferred_actions = 0;
+		if (!control_proxy_start_media(cl))
+			control_proxy_fail(cl, 502, "Bad Gateway", "bad_gateway");
+		return;
+	}
+
+	action = proxy->deferred_actions & CONTROL_DEFER_POST_DATA ?
+		CONTROL_DEFER_POST_DATA : CONTROL_DEFER_PUMP;
+	proxy->deferred_actions &= ~action;
+	if (action == CONTROL_DEFER_POST_DATA) {
+		if (proxy->initialized && !proxy->finishing) {
+			cl->dispatch.data_blocked = false;
+			client_poll_post_data(cl);
+		}
+	} else if (proxy->initialized && !proxy->finishing) {
+		control_proxy_read(&proxy->backend.stream, 0);
+	}
+	if (proxy->deferred_actions && !proxy->deferred.pending)
+		uloop_timeout_set(&proxy->deferred, 1);
+}
