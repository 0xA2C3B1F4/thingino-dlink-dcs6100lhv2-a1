+static void control_proxy_flush_request_body(struct dispatch_control_proxy *proxy)
+{
+	while (proxy->request_body_sent < proxy->request_body_used &&
+	       ustream_pending_data(&proxy->backend.stream, true) <
+	       CONTROL_PROXY_WRITE_BUFFER) {
+		size_t remaining = proxy->request_body_used - proxy->request_body_sent;
+		int count = remaining > INT_MAX ? INT_MAX : (int) remaining;
+		int accepted = ustream_write(&proxy->backend.stream,
+			proxy->request_body + proxy->request_body_sent, count, true);
+
+		if (accepted <= 0 || (size_t) accepted > remaining)
+			return;
+		proxy->request_body_sent += accepted;
+	}
+}
