diff --git a/control_proxy.c b/control_proxy.c
--- a/control_proxy.c
+++ b/control_proxy.c
@@ -23,6 +23,7 @@
 #define CONTROL_ONVIF_PORT 1999
 #define CONTROL_PROXY_TIMEOUT_MS 4000
 #define CONTROL_PROXY_MAX_BODY 4096
+#define CONTROL_PROXY_MAX_WHIP_SDP_BODY (15 * 1024)
 #define CONTROL_ONVIF_MAX_BODY (16 * 1024)
 #define CONTROL_PROXY_MAX_RESPONSE (2 * 1024 * 1024)
 #define CONTROL_PROXY_WRITE_BUFFER 8192
@@ -1109,7 +1110,7 @@ static void control_proxy_request(struct client *cl, char *url,
 {
	struct dispatch_control_proxy *proxy = &cl->dispatch.control_proxy;
 	const char *host, *origin;
-	bool media, onvif, onvif_snapshot;
+	bool media, onvif, onvif_snapshot, whip_post;
 	(void) pi;
 
 	memset(proxy, 0, sizeof(*proxy));
@@ -1120,6 +1121,9 @@ static void control_proxy_request(struct client *cl, char *url,
 	onvif = !strncmp(url, "/onvif/", 7);
