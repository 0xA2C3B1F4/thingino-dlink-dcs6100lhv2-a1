+	    CONTROL_ONVIF_MAX_BODY : whip_post ?
+	    CONTROL_PROXY_MAX_WHIP_SDP_BODY : CONTROL_PROXY_MAX_BODY)) {
 		control_proxy_fail(cl, 413, "Payload Too Large", "payload_too_large");
 		return;
 	}
