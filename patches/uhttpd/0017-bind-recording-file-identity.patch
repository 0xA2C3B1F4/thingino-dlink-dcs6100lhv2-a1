diff --git a/recording_file.h b/recording_file.h
new file mode 100644
--- /dev/null
+++ b/recording_file.h
@@ -0,0 +1,78 @@
+/* Bind an authorized recording to the descriptor used by the file streamer. */
+#ifndef THINGINO_RECORDING_FILE_H
+#define THINGINO_RECORDING_FILE_H
+#include <fcntl.h>
+#include <inttypes.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#define RECORDING_IDENTITY_MAX 160
+#ifdef __APPLE__
+#define RECORDING_NSEC(st) ((st).st_mtimespec.tv_nsec)
+#else
+#define RECORDING_NSEC(st) ((st).st_mtim.tv_nsec)
+#endif
+
+static bool recording_file_matches(int fd, const char *expected)
+{
+    struct stat st;
+    char actual[RECORDING_IDENTITY_MAX];
+    if (!expected || !expected[0] || fstat(fd, &st) || !S_ISREG(st.st_mode) || st.st_nlink != 1)
+        return false;
+    int n = snprintf(actual, sizeof(actual), "v1 %ju %ju %ju %jd %ld",
+                     (uintmax_t)st.st_dev, (uintmax_t)st.st_ino, (uintmax_t)st.st_size,
+                     (intmax_t)st.st_mtime, RECORDING_NSEC(st));
+    return n > 0 && (size_t)n < sizeof(actual) && !strcmp(actual, expected);
+}
+
+/* Every component is opened relative to a held directory; no symlink is followed. */
+static int recording_file_open_at(int root, const char *relative, const char *expected)
+{
+    char path[513], *part, *next, *save;
+    if (!relative || !relative[0] || relative[0] == '/' || strlen(relative) >= sizeof(path) ||
+        relative[strlen(relative)-1] == '/' || strstr(relative, "//"))
+        return -1;
+    snprintf(path, sizeof(path), "%s", relative);
+    int parent = fcntl(root, F_DUPFD_CLOEXEC, 0);
+    if (parent < 0)
+        return -1;
+    for (part = strtok_r(path, "/", &save); part; part = next) {
+        next = strtok_r(NULL, "/", &save);
+        if (!strcmp(part, ".") || !strcmp(part, "..")) {
+            close(parent);
+            return -1;
+        }
+        int flags = O_RDONLY | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK;
+        if (next)
+            flags |= O_DIRECTORY;
+        int fd = openat(parent, part, flags);
+        close(parent);
+        if (fd < 0)
+            return -1;
+        if (!next) {
+            if (recording_file_matches(fd, expected))
+                return fd;
+            close(fd);
+            return -1;
+        }
+        parent = fd;
+    }
+    close(parent);
+    return -1;
+}
+
+static int recording_file_open(const char *path, const char *expected)
+{
+    if (!path || path[0] != '/' || (strncmp(path, "/mnt/", 5) && strncmp(path, "/media/", 7)))
+        return -1;
+    int root = open("/", O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+    if (root < 0)
+        return -1;
+    int fd = recording_file_open_at(root, path + 1, expected);
+    close(root);
+    return fd;
+}
+#endif
