+
+static bool control_proxy_tls(struct client *cl)
+{
+#ifdef HAVE_TLS
+	return cl->tls;
+#else
+	(void) cl;
+	return false;
+#endif
+}
+
+static bool control_proxy_valid_port(const char *value)
+{
+	char *end;
+	long port;
+
+	if (!value || !*value)
+		return false;
+	errno = 0;
+	port = strtol(value, &end, 10);
+	return !errno && !*end && port >= 1 && port <= 65535;
+}
+
+static bool control_proxy_valid_dns_name(char *name)
+{
+	char *cursor, *label;
+	size_t length;
+
+	length = strlen(name);
+	if (length && name[length - 1] == '.')
+		name[--length] = 0;
+	if (!length || length > 253)
+		return false;
+	label = name;
+	for (cursor = name; ; cursor++) {
+		if (*cursor && *cursor != '.')
+			continue;
+		if (cursor == label || cursor - label > 63 ||
+		    !isalnum((unsigned char) label[0]) ||
+		    !isalnum((unsigned char) cursor[-1]))
+			return false;
+		for (char *value = label; value < cursor; value++) {
+			if (!isalnum((unsigned char) *value) && *value != '-')
+				return false;
+		}
+		if (!*cursor)
+			break;
+		label = cursor + 1;
+	}
+	return true;
+}
+
+bool control_proxy_host_allowed(const char *value)
+{
+	struct in_addr ipv4;
+	struct in6_addr ipv6;
+	const char *close, *colon;
+	char host[256];
+	size_t length;
+
+	if (!value || !*value || strlen(value) >= sizeof(host))
+		return false;
+	if (value[0] == '[') {
+		close = strchr(value, ']');
+		if (!close || close == value + 1 ||
+		    (close[1] && (close[1] != ':' ||
+		     !control_proxy_valid_port(close + 2))))
+			return false;
+		length = close - value - 1;
+		memcpy(host, value + 1, length);
+		host[length] = 0;
+		return inet_pton(AF_INET6, host, &ipv6) == 1;
+	}
+	colon = strrchr(value, ':');
+	if (colon) {
+		if (strchr(value, ':') != colon ||
+		    !control_proxy_valid_port(colon + 1))
+			return false;
+		length = colon - value;
+	} else {
+		length = strlen(value);
+	}
+	if (!length || length >= sizeof(host))
+		return false;
+	memcpy(host, value, length);
+	host[length] = 0;
+	if (inet_pton(AF_INET, host, &ipv4) == 1)
+		return true;
+	if (!control_proxy_valid_dns_name(host))
+		return false;
+	length = strlen(host);
+	return !strchr(host, '.') ||
+	       (length > 6 && !strcasecmp(host + length - 6, ".local")) ||
+	       (length > 10 && !strcasecmp(host + length - 10, ".home.arpa"));
+}
+
+static bool control_proxy_origin_matches(const char *origin, const char *host,
+					 bool tls)
+{
+	const char *scheme = tls ? "https://" : "http://";
+	size_t length = strlen(scheme);
+
+	return !origin || (!strncasecmp(origin, scheme, length) &&
+			   origin[length] && !strcasecmp(origin + length, host));
 }
 
