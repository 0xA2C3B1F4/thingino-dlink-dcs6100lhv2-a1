diff --git a/file.c b/file.c
--- a/file.c
+++ b/file.c
@@ -635,6 +635,43 @@ static bool uh_file_is_html(const char *name)
 
+static const char *uh_file_request_header(struct client *cl, const char *name)
+{
+	struct blob_attr *cur;
+	int rem;
+
+	blob_for_each_attr(cur, cl->hdr.head, rem) {
+		if (!strcasecmp(blobmsg_name(cur), name))
+			return blobmsg_get_string(cur);
+	}
+	return NULL;
+}
+
 static void uh_file_data(struct client *cl, struct path_info *pi, int fd)
 {
+	bool tls = false;
+	const char *host;
+
+#ifdef HAVE_TLS
+	tls = cl->tls;
+#endif
+	if (!tls) {
+		close(fd);
+		cl->request.disable_chunked = true;
+		host = uh_file_request_header(cl, "host");
+		if (!control_proxy_host_allowed(host)) {
+			uh_http_header(cl, 421, "Misdirected Request");
+			ustream_printf(cl->us, "Content-Length: 0\r\n\r\n");
+		} else {
+			uh_http_header(cl, 308, "Permanent Redirect");
+			ustream_printf(cl->us,
+				"Location: https://%s/\r\nContent-Length: 0\r\n\r\n",
+				host);
+		}
+		uh_request_done(cl);
+		return;
+	}
+	blobmsg_add_string(&cl->hdr_response, "Strict-Transport-Security",
+		"max-age=31536000");
+
