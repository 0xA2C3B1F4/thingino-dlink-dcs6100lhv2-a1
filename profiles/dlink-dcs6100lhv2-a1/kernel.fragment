# Stage-1 and RAM-test support. The final build adds a generated second
# fragment that overrides the stock command line with the signed final layout.
CONFIG_BLK_DEV_INITRD=y
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_COUNT=1
CONFIG_BLK_DEV_RAM_SIZE=8192

CONFIG_ZRAM=y
CONFIG_ZRAM_LZ4_COMPRESS=y
# CONFIG_ZRAM_DEBUG is not set

CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BLOCK_MINORS=8
CONFIG_MMC_BLOCK_BOUNCE=y
CONFIG_JZMMC_V12=m
CONFIG_JZMMC_V12_SDMA=y
CONFIG_JZMMC_V12_MMC0=y
CONFIG_JZMMC_V12_MMC0_PB_4BIT=y
CONFIG_MMC0_MAX_FREQ=24000000

# Installer networking is deliberately IPv4-only.
# CONFIG_IPV6 is not set
