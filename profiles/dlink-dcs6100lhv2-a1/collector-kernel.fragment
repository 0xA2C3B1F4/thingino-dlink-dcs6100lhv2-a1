# Read-only RAM collector kernel contract. This is not the final NOR kernel.
CONFIG_BINFMT_ELF=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_COUNT=1
CONFIG_BLK_DEV_RAM_SIZE=8192
# CONFIG_CMDLINE_BOOL is not set
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FAT_FS=y
CONFIG_JFFS2_FS=y
CONFIG_JZMMC_V12=m
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MODULES=y
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_CMDLINE_PARTS=y
CONFIG_MTD_JZ_SFC=y
CONFIG_MTD_JZ_SFC_NOR=y
# Ingenic's T31 platform glue always references the core netlink symbols.
# Keep only that in-kernel substrate; the collector has no IP stack, network
# devices, wireless stack, network modules, or network-capable user space.
CONFIG_NET=y
# CONFIG_INET is not set
# CONFIG_NETDEVICES is not set
# CONFIG_WIRELESS is not set
CONFIG_NLS_UTF8=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_VFAT_FS=y
