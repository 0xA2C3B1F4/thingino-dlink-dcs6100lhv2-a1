# Permanent dual-stack RTL8188FU mtd2 recovery/bootstrap kernel.
CONFIG_BINFMT_ELF=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_COUNT=1
CONFIG_BLK_DEV_RAM_SIZE=16384
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="console=ttyS1,115200n8 mem=42M@0x0 rmem=22M@0x2a00000 init=/sbin/init root=/dev/mtdblock2 rootfstype=squashfs ro panic=10 mtdparts=jz_sfc:256k(boot)ro,1792k(kernel)ro,4608k(rootfs)ro,7936k(userdata),1536k(userdata2)ro,256k(userdata3)ro"
CONFIG_CMDLINE_OVERRIDE=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FAT_FS=y
CONFIG_GPIO_SYSFS=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_JFFS2_FS=y
CONFIG_JZMMC_V12=m
CONFIG_JZMMC_V12_MMC0=y
CONFIG_JZMMC_V12_MMC0_PB_4BIT=y
CONFIG_MAC80211=y
CONFIG_MMC=y
CONFIG_MMC0_MAX_FREQ=24000000
CONFIG_MMC_BLOCK=y
CONFIG_MODULES=y
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_CMDLINE_PARTS=y
CONFIG_MTD_JZ_SFC=y
CONFIG_MTD_JZ_SFC_NOR=y
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_NLS_UTF8=y
CONFIG_PACKET=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_UNIX=y
CONFIG_USB=y
CONFIG_USB_DWC2_HOST_ONLY=y
CONFIG_USB_JZ_DWC2=y
CONFIG_VFAT_FS=y
CONFIG_WIRELESS=y
