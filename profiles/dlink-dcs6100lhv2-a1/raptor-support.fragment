# Full Raptor is compiled separately against this support-only base.
BR2_PACKAGE_THINGINO_STREAMER_NONE=y
# BR2_PACKAGE_THINGINO_STREAMER_PRUDYNT is not set
# BR2_PACKAGE_THINGINO_STREAMER_RAPTOR is not set
# BR2_PACKAGE_PRUDYNT_T is not set
BR2_PACKAGE_INGENIC_LIB=y
BR2_PACKAGE_INGENIC_LIB_LIBIMP=y
BR2_PACKAGE_INGENIC_SYSTEM_LIBS_NEO=y
BR2_PACKAGE_INGENIC_SYSTEM_LIBS_NEO_LIBALOG=y
BR2_PACKAGE_INGENIC_SYSTEM_LIBS_NEO_LIBSYSUTILS=y
BR2_PACKAGE_LIBAUDIOPROCESS_NEO=y
# None of the full Raptor daemons or retained services needs the C++ runtime.
# BR2_THINGINO_LIBSTDCPP is not set
BR2_PACKAGE_THINGINO_JCT=y
BR2_PACKAGE_THINGINO_ONVIF=y
# This package owns the model-specific S06ircut startup script.
BR2_PACKAGE_THINGINO_DAYNIGHTD=y
# BR2_PACKAGE_THINGINO_DAYNIGHTD_AUTOSTART is not set
