#!/bin/sh
# Volatile runtime-candidate supervisor. It never writes MTD or persistent config.
set -eu

PATH=/bin:/sbin:/usr/bin:/usr/sbin${PATH:+:$PATH}
export PATH
umask 077

ROOT=${PRUDYNT_RWD_ROOT:-/run/raptor-rwd}
PRUDYNT=$ROOT/usr/bin/prudynt
RWD=$ROOT/usr/bin/rwd
UHTTPD=$ROOT/usr/bin/uhttpd
CONTROL=$ROOT/usr/sbin/thingino-controld
CONTROL_INIT=$ROOT/S95thingino-control
CONF=$ROOT/etc/raptor.conf
RUNTIME_CONF=$ROOT/etc/raptor-runtime.conf
RWD_PID=/run/rwd.pid
PRUDYNT_PID=/run/prudynt.pid
READY=/run/prudynt-dlink-media.ready
RING=/dev/shm/rss_ring_main
WEBUI_MARKER=/run/raptor-rwd-webui.mounted
UI_BIN_MARKER=/run/raptor-rwd-ui-binaries.mounted
UHTTPD_TARGET=/usr/bin/uhttpd
CONTROL_TARGET=/usr/sbin/thingino-controld
EVENT_LOG=$ROOT/supervisor.log

event() {
	printf '%s\n' "$1" >>"$EVENT_LOG"
}

mounted_on() {
	awk -v target="$1" '$2 == target { found = 1 } END { exit !found }' /proc/mounts
}

cmdline_has() {
	for token in $(cat /proc/cmdline); do
		[ "$token" = "$1" ] && return 0
	done
	return 1
}

alive() {
	[ -r "$1" ] && kill -0 "$(cat "$1")" 2>/dev/null
}

rwd_ready() {
	alive "$RWD_PID" &&
		netstat -lnt 2>/dev/null |
		awk '$4 ~ /:8554$/ { if ($4 == "127.0.0.1:8554") loopback = 1; else unsafe = 1 } END { exit !(loopback && !unsafe) }' &&
		netstat -lnu 2>/dev/null | awk '$4 ~ /:8443$/ { found = 1 } END { exit !found }'
}

stop_rwd() {
	if alive "$RWD_PID"; then
		start-stop-daemon -K -p "$RWD_PID" -x "$RWD" 2>/dev/null || true
	fi
	i=0
	while alive "$RWD_PID" && [ "$i" -lt 30 ]; do
		usleep 100000
		i=$((i + 1))
	done
	rm -f "$RWD_PID"
}

stop_candidate_ui() {
	if [ -x "$CONTROL_INIT" ]; then
		"$CONTROL_INIT" stop >/dev/null 2>&1 || true
	fi
	/etc/init.d/S60uhttpd stop >/dev/null 2>&1 || true
}

unmount_candidate_ui() {
	if [ -e "$UI_BIN_MARKER" ]; then
		mounted_on "$CONTROL_TARGET" && umount "$CONTROL_TARGET"
		mounted_on "$UHTTPD_TARGET" && umount "$UHTTPD_TARGET"
		rm -f "$UI_BIN_MARKER"
	fi
}

restore_stock_ui() {
	/etc/init.d/S60uhttpd start >/dev/null 2>&1 || true
	/etc/init.d/S95thingino-control start >/dev/null 2>&1 || true
}

start_runtime() {
	cmdline_has 'mem=42M@0x0'
	cmdline_has 'rmem=22M@0x2a00000'
	awk '$2 == "/run" && $3 == "tmpfs" { found = 1 } END { exit !found }' /proc/mounts
	[ "$(cat "$READY" 2>/dev/null || true)" = 1080p-started ]
	[ -x /etc/init.d/S31prudynt ]
	for active in /run/prudynt/mp4ctl-ch*.active; do
		[ ! -e "$active" ] || {
			echo "recorder is active" >&2
			return 1
		}
	done
	[ -x "$PRUDYNT" ] && [ -x "$RWD" ] && [ -x "$UHTTPD" ] &&
		[ -x "$CONTROL" ] && [ -x "$CONTROL_INIT" ] && [ -r "$CONF" ] || {
		echo "incomplete Prudynt-rwd artifact under $ROOT" >&2
		return 1
	}
	[ ! -e "$WEBUI_MARKER" ] && [ ! -e "$UI_BIN_MARKER" ] || {
		echo "candidate WebUI or binary bind mount is already active" >&2
		return 1
	}
	[ -r "$ROOT/var/www/index.html" ] || {
		echo "candidate WebUI is missing under $ROOT/var/www" >&2
		return 1
	}
	! mounted_on /var/www || {
		echo "another /var/www mount is already active" >&2
		return 1
	}
	! mounted_on "$UHTTPD_TARGET" && ! mounted_on "$CONTROL_TARGET" || {
		echo "another WebUI service binary mount is already active" >&2
		return 1
	}
	[ ! -e "$RWD_PID" ] && [ -z "$(pidof rwd 2>/dev/null || true)" ] || {
		echo "another rwd instance is already active" >&2
		return 1
	}
	stock_stopped=no
	stock_ui_stopped=no
	webui_mounted=no
	ui_binaries_mounted=no
	complete=no
	cleanup_start() {
		code=$?
		trap - 0 1 2 15
		event "cleanup code=$code complete=$complete stock_stopped=$stock_stopped stock_ui_stopped=$stock_ui_stopped webui_mounted=$webui_mounted ui_binaries_mounted=$ui_binaries_mounted"
		if [ "$complete" != yes ]; then
			set +e
			stop_rwd
			if [ "$stock_ui_stopped" = yes ]; then
				stop_candidate_ui
			fi
			if alive "$PRUDYNT_PID"; then
				start-stop-daemon -K -p "$PRUDYNT_PID" -x "$PRUDYNT" >/dev/null 2>&1
			fi
			rm -f "$PRUDYNT_PID" "$RING"
			if [ "$ui_binaries_mounted" = yes ]; then
				unmount_candidate_ui
			fi
			if [ "$webui_mounted" = yes ] && mounted_on /var/www; then
				umount /var/www
			fi
			rm -f "$WEBUI_MARKER"
			if [ "$stock_stopped" = yes ]; then
				/etc/init.d/S31prudynt start >/dev/null 2>&1
				/etc/init.d/S32prudyntwd start >/dev/null 2>&1 || true
			fi
			if [ "$stock_ui_stopped" = yes ]; then
				restore_stock_ui
			fi
			set -e
		fi
		exit "$code"
	}
	event start-begin
	trap cleanup_start 0 1 2 15
	mount --bind "$ROOT/var/www" /var/www || return 1
	: > "$WEBUI_MARKER"
	webui_mounted=yes
	stock_ui_stopped=yes
	/etc/init.d/S95thingino-control stop || return 1
	/etc/init.d/S60uhttpd stop || return 1
	: > "$UI_BIN_MARKER"
	ui_binaries_mounted=yes
	mount --bind "$UHTTPD" "$UHTTPD_TARGET" || return 1
	mount --bind "$CONTROL" "$CONTROL_TARGET" || return 1
	/etc/init.d/S60uhttpd start || return 1
	"$CONTROL_INIT" start || return 1
	event candidate-ui-started

	/etc/init.d/S32prudyntwd stop >/dev/null 2>&1 || true
	/etc/init.d/S31prudynt stop || return 1
	stock_stopped=yes
	event stock-stopped
	rm -f "$READY" "$RING"

	LD_LIBRARY_PATH="$ROOT/usr/lib:/usr/lib" PRUDYNT_RAPTOR_RING=1 \
		start-stop-daemon -S -b -m -p "$PRUDYNT_PID" -x "$PRUDYNT"

	i=0
	while [ "$i" -lt 150 ]; do
		grep -qx '1080p-started' "$READY" 2>/dev/null && [ -e "$RING" ] && break
		alive "$PRUDYNT_PID" || break
		usleep 100000
		i=$((i + 1))
	done
	if ! grep -qx '1080p-started' "$READY" 2>/dev/null || [ ! -e "$RING" ]; then
		event candidate-not-ready
		echo "Prudynt candidate did not reach media-ready with the main ring" >&2
		return 1
	fi

	local_ip=$(ip -4 -o addr show scope global 2>/dev/null |
		awk '{ split($4, address, "/"); print address[1]; exit }')
	[ -n "$local_ip" ] || return 1
	awk -v ip="$local_ip" '{ print; if ($0 == "[webrtc]") print "local_ip = " ip }' \
		"$CONF" >"$RUNTIME_CONF"
	chmod 0600 "$RUNTIME_CONF"
	LD_LIBRARY_PATH="$ROOT/usr/lib:/usr/lib" \
		nohup "$RWD" -f -c "$RUNTIME_CONF" >"$ROOT/rwd.log" 2>&1 &
	echo $! >"$RWD_PID"
	i=0
	while [ "$i" -lt 50 ]; do
		rwd_ready && break
		alive "$RWD_PID" || break
		usleep 100000
		i=$((i + 1))
	done
	if ! rwd_ready; then
		event rwd-not-ready
		echo "rwd failed; Prudynt remains available with RTSP, snapshot, and MJPEG" >&2
		rm -f "$RWD_PID"
		return 1
	fi
	complete=yes
	event start-complete
	trap - 0 1 2 15
}

stop_runtime() {
	event stop-begin
	# Consumer and its DTLS/SRTP clients must leave before the ring owner.
	stop_rwd
	stop_candidate_ui
	if alive "$PRUDYNT_PID"; then
		start-stop-daemon -K -p "$PRUDYNT_PID" -x "$PRUDYNT" 2>/dev/null || true
	fi
	i=0
	while alive "$PRUDYNT_PID" && [ "$i" -lt 50 ]; do
		usleep 100000
		i=$((i + 1))
	done
	rm -f "$PRUDYNT_PID"
	unmount_candidate_ui
	if [ -e "$WEBUI_MARKER" ] && mounted_on /var/www; then
		umount /var/www || return 1
	fi
	rm -f "$WEBUI_MARKER" "$RING"
	/etc/init.d/S31prudynt start
	/etc/init.d/S32prudyntwd start >/dev/null 2>&1 || true
	restore_stock_ui
	event stop-complete
}

case "${1:-}" in
	start) start_runtime ;;
	stop) stop_runtime ;;
	restart) stop_runtime && start_runtime ;;
	*) echo "Usage: $0 {start|stop|restart}" >&2; exit 2 ;;
esac
